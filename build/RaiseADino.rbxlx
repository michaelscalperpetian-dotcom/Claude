      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- Types that cross the client/server boundary (saved profile, state snapshot)
-- live here so both sides agree by construction.

export type DinoRecord = {
	id: string,
	species: string,
	mutation: string?,
	bornAt: number, -- unix seconds; stage is computed from age
	lastLaidAt: number,
	name: string?, -- nickname, already through Roblox's text filter
	golden: boolean?, -- fused from 3 of its species; earns Config.GOLDEN_MULTIPLIER x
}

-- "shop": species rolled at hatch from the egg's odds
-- "laid": laid by one of your dinos; species is fixed, mutation rolled at hatch
-- "starter"/"gift": tutorial eggs with a fixed result (not purchasable)
export type EggKind = "shop" | "laid" | "starter" | "gift"

export type IncubatorEgg = {
	id: string,
	kind: EggKind,
	eggType: string?, -- shop eggs
	species: string?, -- laid/starter/gift eggs
	mutation: string?, -- gift eggs
	placedAt: number,
	hatchAt: number,
}

export type TrayEgg = {
	id: string,
	species: string,
	laidAt: number,
}

export type Profile = {
	version: number,
	coins: number,
	pendingCoins: number,
	totalEarned: number,
	nextId: number,
	dinos: { DinoRecord },
	incubators: { [string]: IncubatorEgg }, -- keyed "1".."5" (string keys save cleanly)
	tray: { TrayEgg },
	dex: { [string]: { [string]: boolean } }, -- species -> mutation ("Normal" or id) -> true
	upgrades: { slots: number, incubators: number },
	boosts: { luckUntil: number, coinsUntil: number },
	instantHatchTokens: number,
	streak: { count: number, lastDay: number },
	club: { lastClaimDay: number },
	tutorial: number,
	starterPackBought: boolean,
	shop: { restock: number, bought: { [string]: number } },
	likes: number,
	stats: { hatched: number, stolen: number, eggsLost: number, sold: number },
	receipts: { string },
	firstJoin: number,
	lastSeen: number,
	quests: QuestState,
	dexClaimed: { [string]: boolean }, -- Dex milestone (species count) -> claimed
	codes: { [string]: boolean }, -- redeemed codes
	settings: Settings,
	buddy: string?, -- id of the dino following the player around
	nicknames: { [string]: string }, -- dino id -> name as typed (server only, re-filtered on join)
	rebirths: number,
	fruit: { [string]: number }, -- basket: FruitData kind -> count
	liked: { day: number, owners: { [string]: boolean } }, -- nests liked today (by owner UserId)
}

-- Today's quest progress; reset when the UTC day changes.
export type QuestState = {
	day: number,
	progress: { [string]: number },
	claimed: { [string]: boolean },
	bonusClaimed: boolean,
}

export type Settings = { music: boolean, sfx: boolean }

-- Everything the client needs to draw its own HUD. Sent on change.
export type Snapshot = {
	coins: number,
	pendingCoins: number,
	incomePerSecond: number,
	multiplier: number,
	dinos: { DinoRecord },
	incubators: { [string]: IncubatorEgg },
	tray: { TrayEgg },
	dex: { [string]: { [string]: boolean } },
	upgrades: { slots: number, incubators: number },
	boosts: { luckUntil: number, coinsUntil: number },
	instantHatchTokens: number,
	streak: { count: number, lastDay: number },
	clubClaimDay: number,
	tutorial: number,
	starterPackBought: boolean,
	shopBought: { restock: number, bought: { [string]: number } },
	likes: number,
	passes: { [string]: boolean },
	subscribed: boolean,
	restricted: boolean, -- paid random items restricted for this player (PolicyService)
	plotIndex: number,
	maxSlots: number,
	maxIncubators: number,
	lockUntil: number,
	lockCooldownUntil: number,
	shieldUntil: number,
	friendsHere: number,
	isDev: boolean,
	raidsEnabled: boolean,
	riding: string?,
	carrying: boolean,
	quests: QuestState,
	dexClaimed: { [string]: boolean },
	settings: Settings,
	buddy: string?,
	rebirths: number,
	fruit: { [string]: number },
}

-- Tutorial steps (server is authoritative; client only renders hints).
export type TutorialStep = number

return nil
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="25">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Clock</string>
            <string name="Source"><![CDATA[--!strict
-- One clock for everything. Uses the server's Unix time (synced to clients), so
-- timers, day/night and storms line up on every screen.
--
-- `cycleNow()` adds a debug offset (set by the cheat panel in Studio) so you can
-- skip to night or a storm while testing. Saved timestamps always use `now()`.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Clock = {}

Clock.OFFSET_ATTRIBUTE = "DebugCycleOffset"

function Clock.now(): number
	return workspace:GetServerTimeNow()
end

function Clock.cycleNow(): number
	local offset = ReplicatedStorage:GetAttribute(Clock.OFFSET_ATTRIBUTE)
	if typeof(offset) == "number" then
		return Clock.now() + offset
	end
	return Clock.now()
end

return Clock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Cycle</string>
            <string name="Source"><![CDATA[--!strict
-- Day/night, storms and egg-shop restocks. Everything is computed from the
-- current time with a deterministic RNG, so every server and every client
-- agrees on "is it night?", "what storm is on?" and "what's in stock?"
-- without sending a single network message.

local Config = require(script.Parent.Parent.Config)
local EggData = require(script.Parent.Parent.Data.EggData)
local MutationData = require(script.Parent.Parent.Data.MutationData)
local Rng = require(script.Parent.Rng)

local Cycle = {}

export type DayNight = {
	isNight: boolean,
	secondsLeft: number, -- until the phase flips
	phaseFraction: number, -- 0..1 through the current phase
	cycleIndex: number,
}

export type StormState = {
	active: boolean,
	kind: MutationData.StormKind?, -- nil during a mega storm
	mega: boolean,
	secondsLeft: number, -- until it ends (if active) or starts (if not)
	nextKind: MutationData.StormKind?, -- the kind of the next regular storm
	slot: number,
}

local SECONDS_PER_DAY = 86400
local SECONDS_PER_WEEK = 7 * SECONDS_PER_DAY
-- 1970-01-01 was a Thursday; with Sunday = 0 that's weekday 4.
local EPOCH_WEEKDAY = 4

function Cycle.dayNight(now: number): DayNight
	local length = Config.DAY_SECONDS + Config.NIGHT_SECONDS
	local cycleIndex = math.floor(now / length)
	local position = now - cycleIndex * length
	if position < Config.DAY_SECONDS then
		return {
			isNight = false,
			secondsLeft = Config.DAY_SECONDS - position,
			phaseFraction = position / Config.DAY_SECONDS,
			cycleIndex = cycleIndex,
		}
	end
	local intoNight = position - Config.DAY_SECONDS
	return {
		isNight = true,
		secondsLeft = Config.NIGHT_SECONDS - intoNight,
		phaseFraction = intoNight / Config.NIGHT_SECONDS,
		cycleIndex = cycleIndex,
	}
end

local function stormKindForSlot(slot: number): MutationData.StormKind
	local total = 0
	for _, s in MutationData.STORMS do
		total += s.weight
	end
	local r = Rng.new(Rng.hash(slot, 7919)).next() * total
	local acc = 0
	for _, s in MutationData.STORMS do
		acc += s.weight
		if r < acc then
			return s.kind
		end
	end
	return MutationData.STORMS[#MutationData.STORMS].kind
end

-- Start time of the most recent weekly mega storm at or before `now`.
local function lastMegaStart(now: number): number
	local days = math.floor(now / SECONDS_PER_DAY)
	local weekday = (days + EPOCH_WEEKDAY) % 7
	local daysBack = (weekday - Config.MEGA_STORM_WEEKDAY) % 7
	local start = (days - daysBack) * SECONDS_PER_DAY + Config.MEGA_STORM_HOUR_UTC * 3600
	if start > now then
		start -= SECONDS_PER_WEEK
	end
	return start
end

function Cycle.megaStorm(now: number): (boolean, number)
	local start = lastMegaStart(now)
	local elapsed = now - start
	if elapsed < Config.MEGA_STORM_DURATION then
		return true, Config.MEGA_STORM_DURATION - elapsed
	end
	return false, start + SECONDS_PER_WEEK - now
end

function Cycle.storm(now: number): StormState
	local megaActive, megaSeconds = Cycle.megaStorm(now)
	local slot = math.floor(now / Config.STORM_INTERVAL)
	local offset = now - slot * Config.STORM_INTERVAL
	if megaActive then
		return {
			active = true,
			kind = nil,
			mega = true,
			secondsLeft = megaSeconds,
			nextKind = stormKindForSlot(slot + 1),
			slot = slot,
		}
	end
	if offset < Config.STORM_DURATION then
		return {
			active = true,
			kind = stormKindForSlot(slot),
			mega = false,
			secondsLeft = Config.STORM_DURATION - offset,
			nextKind = stormKindForSlot(slot + 1),
			slot = slot,
		}
	end
	return {
		active = false,
		kind = nil,
		mega = false,
		secondsLeft = Config.STORM_INTERVAL - offset,
		nextKind = stormKindForSlot(slot + 1),
		slot = slot,
	}
end

export type Restock = {
	index: number,
	secondsLeft: number,
	stock: { [string]: number },
}

function Cycle.restock(now: number): Restock
	local index = math.floor(now / Config.RESTOCK_SECONDS)
	local stock: { [string]: number } = {}
	for _, egg in EggData.LIST do
		local rng = Rng.new(Rng.hash(index, egg.order * 104729))
		local count = 0
		if rng.next() < egg.stock.chance then
			count = rng.int(egg.stock.min, egg.stock.max)
		end
		stock[egg.id] = count
	end
	return {
		index = index,
		secondsLeft = (index + 1) * Config.RESTOCK_SECONDS - now,
		stock = stock,
	}
end

-- Whole UTC days since 1970, used for daily rewards.
function Cycle.dayNumber(now: number): number
	return math.floor(now / SECONDS_PER_DAY)
end

return Cycle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
-- Coin math shared by server (authoritative) and client (display only).

local Config = require(script.Parent.Parent.Config)
local Growth = require(script.Parent.Growth)

local Economy = {}

export type MultiplierInput = {
	doubleCoins: boolean,
	vip: boolean,
	club: boolean,
	adBoost: boolean,
	friends: number,
	rebirths: number?,
}

-- Additive bonuses (friends, club) stack together, then multiplicative boosts apply.
function Economy.coinMultiplier(input: MultiplierInput): number
	local friendBonus =
		math.min(input.friends * Config.FRIEND_BOOST_PER_FRIEND, Config.FRIEND_BOOST_MAX)
	local additive = 1 + friendBonus + (if input.club then Config.CLUB_COIN_BONUS else 0)
	local multiplier = additive
	if input.doubleCoins then
		multiplier *= Config.DOUBLE_COINS_MULTIPLIER
	end
	if input.adBoost then
		multiplier *= Config.AD_BOOST_MULTIPLIER
	end
	if input.vip then
		multiplier *= Config.VIP_COIN_MULTIPLIER
	end
	return multiplier * Economy.rebirthMultiplier(input.rebirths or 0)
end

-- Permanent coin boost from rebirths.
function Economy.rebirthMultiplier(rebirths: number): number
	return 1 + rebirths * Config.REBIRTH_BONUS
end

-- Coins needed for the next rebirth after `rebirths` of them.
function Economy.rebirthCost(rebirths: number): number
	return math.floor(Config.REBIRTH_BASE_COST * Config.REBIRTH_COST_GROWTH ^ rebirths)
end

-- Coins from selling a dino.
function Economy.dinoValue(baseIncome: number, stage: number, mutationMultiplier: number): number
	return math.floor(baseIncome * 300 * Growth.SELL[math.clamp(stage, 1, 4)] * mutationMultiplier)
end

-- Extra income/value multiplier for Golden dinos.
function Economy.goldenMultiplier(golden: boolean?): number
	return if golden then Config.GOLDEN_MULTIPLIER else 1
end

-- Coins it costs to fuse three dinos of a species into a Golden one.
function Economy.goldenFee(baseIncome: number): number
	return math.max(100, math.floor(baseIncome * Config.GOLDEN_FEE_SECONDS))
end

-- Coins from selling a laid egg from your tray.
function Economy.trayEggValue(baseIncome: number): number
	return math.max(1, math.floor(baseIncome * 120))
end

-- Coins earned while offline (reduced rate, capped).
function Economy.offlineCoins(incomePerSecond: number, secondsAway: number): number
	local seconds = math.clamp(secondsAway, 0, Config.OFFLINE_EARNINGS_CAP_SECONDS)
	return math.floor(incomePerSecond * seconds * Config.OFFLINE_EARNINGS_RATE)
end

-- "X minutes of your income, or the minimum" rewards (coin packs, streaks, club).
function Economy.incomeReward(incomePerSecond: number, minutes: number, minimum: number): number
	return math.max(minimum, math.floor(incomePerSecond * minutes * 60))
end

-- Cost of the next upgrade level, or nil when maxed. `owned` = levels already bought.
function Economy.nextUpgradeCost(costs: { number }, owned: number): number?
	return costs[owned + 1]
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">EggOdds</string>
            <string name="Source"><![CDATA[--!strict
-- The single source for "what are the odds for this egg right now". The server
-- rolls with these tables and the client's Odds panel displays these tables,
-- so the shown odds are always the real odds.

local Config = require(script.Parent.Parent.Config)
local DinoData = require(script.Parent.Parent.Data.DinoData)
local EggData = require(script.Parent.Parent.Data.EggData)
local MutationData = require(script.Parent.Parent.Data.MutationData)
local Cycle = require(script.Parent.Cycle)
local Odds = require(script.Parent.Odds)

local EggOdds = {}

local RARE_ORDER = DinoData.rarityInfo("Rare").order

-- Species chances (basis points, summing to exactly 10000) for an egg type.
function EggOdds.species(eggId: string, luckActive: boolean): { Odds.Chance }
	local egg = EggData.get(eggId)
	if not egg then
		return {}
	end
	local multiplier = if luckActive then Config.LUCK_MULTIPLIER else 1
	return Odds.chances(egg.odds, DinoData.rarityOrder, multiplier, RARE_ORDER)
end

-- Mutation chances for a hatch at `cycleTime` (storms change them).
function EggOdds.mutations(cycleTime: number): { MutationData.MutationChance }
	local storm = Cycle.storm(cycleTime)
	local kind: MutationData.StormKind? = if storm.active then storm.kind else nil
	return MutationData.hatchChances(kind, storm.active and storm.mega)
end

return EggOdds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
-- Number and time formatting for UI text.

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi" }

-- 950 -> "950", 12345 -> "12.3K", 4500000 -> "4.5M"
function Format.number(n: number): string
	if n ~= n then
		return "0"
	end
	local negative = n < 0
	local value = math.abs(n)
	if value < 1000 then
		local whole = if value >= 100 or value == math.floor(value)
			then string.format("%d", math.floor(value))
			else string.format("%.1f", value)
		return (if negative then "-" else "") .. whole
	end
	local index = 1
	while value >= 1000 and index < #SUFFIXES do
		value /= 1000
		index += 1
	end
	local text
	if value >= 100 then
		text = string.format("%d", math.floor(value))
	else
		text = string.format("%.1f", math.floor(value * 10) / 10)
		text = string.gsub(text, "%.0$", "")
	end
	return (if negative then "-" else "") .. text .. SUFFIXES[index]
end

-- 75 -> "1:15", 3725 -> "1:02:05"
function Format.time(seconds: number): string
	local s = math.max(0, math.ceil(seconds))
	local h = math.floor(s / 3600)
	local m = math.floor((s % 3600) / 60)
	local sec = s % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, sec)
	end
	return string.format("%d:%02d", m, sec)
end

-- 45 -> "45s", 300 -> "5m", 5400 -> "1h 30m"
function Format.duration(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	if s < 60 then
		return `{s}s`
	elseif s < 3600 then
		local m = math.floor(s / 60)
		local rest = s % 60
		return if rest > 0 then `{m}m {rest}s` else `{m}m`
	end
	local h = math.floor(s / 3600)
	local m = math.floor((s % 3600) / 60)
	return if m > 0 then `{h}h {m}m` else `{h}h`
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Frames</string>
            <string name="Source"><![CDATA[--!strict
-- Robust ways to orient a part along a direction. CFrame.lookAt is undefined
-- when the direction is straight up or down (it can produce NaN rotations),
-- which broke vertical legs, so every "point this along that" goes through here.

local Frames = {}

local X_AXIS = Vector3.new(1, 0, 0)
local Y_AXIS = Vector3.new(0, 1, 0)
local Z_AXIS = Vector3.new(0, 0, 1)

-- CFrame at `center` whose local X axis points along `direction`
-- (Roblox cylinders run along X).
function Frames.alongX(center: Vector3, direction: Vector3): CFrame
	local x = direction.Unit
	local reference = if math.abs(x.Y) > 0.99 then Z_AXIS else Y_AXIS
	local z = x:Cross(reference).Unit
	local y = z:Cross(x).Unit
	return CFrame.fromMatrix(center, x, y, z)
end

-- CFrame at `center` whose local Z axis points along `direction`
-- (stretched spheres and blocks use Z as their long axis).
function Frames.alongZ(center: Vector3, direction: Vector3): CFrame
	local z = direction.Unit
	local reference = if math.abs(z.Y) > 0.99 then X_AXIS else Y_AXIS
	local x = reference:Cross(z).Unit
	local y = z:Cross(x).Unit
	return CFrame.fromMatrix(center, x, y, z)
end

-- Facing a point on the horizontal plane (the usual "look at" for characters).
function Frames.facing(position: Vector3, target: Vector3): CFrame
	local flat = Vector3.new(target.X - position.X, 0, target.Z - position.Z)
	if flat.Magnitude < 1e-4 then
		return CFrame.new(position)
	end
	return CFrame.lookAt(position, position + flat)
end

return Frames
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Growth</string>
            <string name="Source"><![CDATA[--!strict
-- Dino growth stages. Growth is pure time math from the dino's birth time, so it
-- keeps going while the player is offline and costs nothing to simulate.
-- Pure: runs under Lune.

local Growth = {}

export type Stage = "Baby" | "Juvenile" | "Adult" | "Giant"

Growth.STAGES = { "Baby", "Juvenile", "Adult", "Giant" } :: { Stage }
Growth.BABY = 1
Growth.JUVENILE = 2
Growth.ADULT = 3
Growth.GIANT = 4

-- Per-stage multipliers (index = stage).
Growth.INCOME = { 0.25, 0.5, 1, 2 }
Growth.SIZE = { 0.5, 0.72, 1, 1.45 }
-- Babies sell for very little, so buying cheap eggs and selling the babies
-- straight away never makes coins (it did at 0.3: a 50-coin egg sold for 180+).
Growth.SELL = { 0.02, 0.6, 1, 2 }

-- thresholds = ages (seconds) to reach Juvenile, Adult, Giant.
function Growth.stageIndex(ageSeconds: number, thresholds: { number }): number
	local stage = 1
	for i, t in thresholds do
		if ageSeconds >= t then
			stage = i + 1
		end
	end
	return stage
end

-- Returns stage, fraction of the way to the next stage (1 at Giant), and seconds left.
function Growth.progress(ageSeconds: number, thresholds: { number }): (number, number, number)
	local stage = Growth.stageIndex(ageSeconds, thresholds)
	if stage >= #thresholds + 1 then
		return stage, 1, 0
	end
	local startAge = if stage == 1 then 0 else thresholds[stage - 1]
	local endAge = thresholds[stage]
	local span = endAge - startAge
	local fraction = if span > 0 then (ageSeconds - startAge) / span else 1
	return stage, math.clamp(fraction, 0, 1), math.max(0, endAge - ageSeconds)
end

function Growth.stageName(stage: number): Stage
	return Growth.STAGES[math.clamp(stage, 1, 4)]
end

-- Age a dino born at `bornAt` needs so that it is exactly `stage` now.
function Growth.bornAtForStage(now: number, stage: number, thresholds: { number }): number
	if stage <= 1 then
		return now
	end
	return now - thresholds[math.min(stage - 1, #thresholds)]
end

function Growth.income(baseIncome: number, stage: number, mutationMultiplier: number): number
	return baseIncome * Growth.INCOME[math.clamp(stage, 1, 4)] * mutationMultiplier
end

-- Time a dino of this stage needs between laid eggs, or nil if it doesn't lay.
function Growth.layInterval(stage: number, adultInterval: number, giantInterval: number): number?
	if stage >= Growth.GIANT then
		return giantInterval
	elseif stage == Growth.ADULT then
		return adultInterval
	end
	return nil
end

-- How many eggs a dino lays right now (at most `room`) and its new lastLaidAt.
-- Works for offline catch-up too: a full tray drops the backlog instead of
-- piling up eggs forever.
function Growth.laysDue(
	bornAt: number,
	lastLaidAt: number,
	thresholds: { number },
	now: number,
	adultInterval: number,
	giantInterval: number,
	room: number
): (number, number)
	local stage = Growth.stageIndex(now - bornAt, thresholds)
	local interval = Growth.layInterval(stage, adultInterval, giantInterval)
	if interval == nil then
		return 0, lastLaidAt
	end
	local adultAt = bornAt + thresholds[Growth.ADULT - 1]
	local last = math.max(lastLaidAt, adultAt)
	local due = math.floor((now - last) / interval)
	if due <= 0 then
		return 0, last
	end
	local laid = math.min(due, math.max(room, 0))
	if laid < due then
		return laid, now
	end
	return laid, last + laid * interval
end

return Growth
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Odds</string>
            <string name="Source"><![CDATA[--!strict
-- Egg odds math. The same function produces both the odds shown in the
-- "Odds" panel and the table the server rolls against, so displayed odds are
-- always the real odds (Roblox paid random item policy). Pure: runs under Lune.

local Odds = {}

export type Entry = { species: string, weight: number }
export type Chance = { species: string, bp: number }

Odds.TOTAL_BP = 10000

-- Scale weights to integers that sum to exactly TOTAL_BP using the largest
-- remainder method, so the percentages always add up to exactly 100%.
local function normalize(species: { string }, weights: { number }): { Chance }
	local sum = 0
	for _, w in weights do
		sum += w
	end
	local result: { Chance } = {}
	if sum <= 0 then
		return result
	end

	local floors: { number } = {}
	local remainders: { { index: number, frac: number } } = {}
	local assigned = 0
	for i, w in weights do
		local exact = w * Odds.TOTAL_BP / sum
		local f = math.floor(exact)
		floors[i] = f
		assigned += f
		table.insert(remainders, { index = i, frac = exact - f })
	end

	table.sort(remainders, function(a, b)
		if a.frac == b.frac then
			return a.index < b.index
		end
		return a.frac > b.frac
	end)

	local leftover = Odds.TOTAL_BP - assigned
	for i = 1, leftover do
		local r = remainders[((i - 1) % #remainders) + 1]
		floors[r.index] += 1
	end

	for i, name in species do
		table.insert(result, { species = name, bp = floors[i] })
	end
	return result
end

-- luckMultiplier multiplies the weight of every species whose rarity order is
-- >= luckMinRarity. Pass 1 for no luck.
function Odds.chances(
	entries: { Entry },
	rarityOf: (string) -> number,
	luckMultiplier: number,
	luckMinRarity: number
): { Chance }
	local names: { string } = {}
	local weights: { number } = {}
	for i, e in entries do
		names[i] = e.species
		local w = e.weight
		if luckMultiplier ~= 1 and rarityOf(e.species) >= luckMinRarity then
			w *= luckMultiplier
		end
		weights[i] = w
	end
	return normalize(names, weights)
end

-- r must be in [0, 1). Returns the species whose bp range contains r.
function Odds.roll(chances: { Chance }, r: number): string
	-- (the tiny nudge stops 0.1415 * 10000 = 1414.9999... landing one bp early)
	local target =
		math.min(math.floor(math.clamp(r, 0, 1) * Odds.TOTAL_BP + 1e-6), Odds.TOTAL_BP - 1)
	local cumulative = 0
	for _, c in chances do
		cumulative += c.bp
		if target < cumulative then
			return c.species
		end
	end
	return chances[#chances].species
end

-- Generic weighted pick over keys with bp values (used for mutations).
-- `none` is returned when r lands outside every listed bp range.
function Odds.pick<T>(entries: { { key: T, bp: number } }, r: number): T?
	-- (the tiny nudge stops 0.1415 * 10000 = 1414.9999... landing one bp early)
	local target =
		math.min(math.floor(math.clamp(r, 0, 1) * Odds.TOTAL_BP + 1e-6), Odds.TOTAL_BP - 1)
	local cumulative = 0
	for _, e in entries do
		cumulative += e.bp
		if target < cumulative then
			return e.key
		end
	end
	return nil
end

-- "12.5%", "0.1%", "45%"
function Odds.format(bp: number): string
	local percent = bp / 100
	if percent == math.floor(percent) then
		return string.format("%d%%", percent)
	end
	local s = string.format("%.2f", percent)
	s = string.gsub(s, "0+$", "")
	s = string.gsub(s, "%.$", "")
	return s .. "%"
end

return Odds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Rng</string>
            <string name="Source"><![CDATA[--!strict
-- Deterministic pseudo-random numbers (mulberry32). Used for things every
-- server and client must agree on without talking to each other, like which
-- storm is coming and what the egg shop has in stock. Pure: runs under Lune too.

local Rng = {}

local TWO_32 = 4294967296

local function imul(a: number, b: number): number
	local ah = bit32.rshift(a, 16)
	local al = bit32.band(a, 0xFFFF)
	local bh = bit32.rshift(b, 16)
	local bl = bit32.band(b, 0xFFFF)
	local high = bit32.band(ah * bl + al * bh, 0xFFFF)
	return (al * bl + high * 65536) % TWO_32
end

export type Generator = {
	next: () -> number,
	int: (min: number, max: number) -> number,
}

-- Mix two integers into a 32-bit seed.
function Rng.hash(a: number, b: number): number
	local h = (math.floor(a) % TWO_32 + imul(math.floor(b) % TWO_32, 0x9E3779B1)) % TWO_32
	h = bit32.bxor(h, bit32.rshift(h, 16))
	h = imul(h, 0x85EBCA6B)
	h = bit32.bxor(h, bit32.rshift(h, 13))
	h = imul(h, 0xC2B2AE35)
	h = bit32.bxor(h, bit32.rshift(h, 16))
	return h
end

function Rng.new(seed: number): Generator
	local state = math.floor(seed) % TWO_32

	local function nextFloat(): number
		state = (state + 0x6D2B79F5) % TWO_32
		local t = state
		t = imul(bit32.bxor(t, bit32.rshift(t, 15)), bit32.bor(t, 1))
		t = bit32.bxor(t, (t + imul(bit32.bxor(t, bit32.rshift(t, 7)), bit32.bor(t, 61))) % TWO_32)
		return bit32.bxor(t, bit32.rshift(t, 14)) / TWO_32
	end

	local function int(min: number, max: number): number
		return min + math.floor(nextFloat() * (max - min + 1))
	end

	return {
		next = nextFloat,
		int = int,
	}
end

return Rng
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
-- Minimal signal for module-to-module events (no Instances, no yielding).

export type Connection = { disconnect: () -> () }

export type Signal<T...> = {
	connect: (self: Signal<T...>, fn: (T...) -> ()) -> Connection,
	fire: (self: Signal<T...>, T...) -> (),
}

local Signal = {}

function Signal.new<T...>(): Signal<T...>
	local handlers: { (T...) -> () } = {}

	local self = {}

	function self.connect(_: any, fn: (T...) -> ()): Connection
		table.insert(handlers, fn)
		return {
			disconnect = function()
				local index = table.find(handlers, fn)
				if index then
					table.remove(handlers, index)
				end
			end,
		}
	end

	function self.fire(_: any, ...: T...)
		for _, fn in table.clone(handlers) do
			task.spawn(fn, ...)
		end
	end

	return (self :: any) :: Signal<T...>
end

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Streak</string>
            <string name="Source"><![CDATA[--!strict
-- 7-day login streak. Claim once per UTC day; missing a day restarts at day 1.

local Streak = {}

export type Reward = {
	kind: "coins" | "luck" | "coinBoost" | "dino",
	minutes: number?, -- coins: minutes of income
	minimum: number?, -- coins: minimum amount
	seconds: number?, -- boosts
	species: string?, -- dino
	label: string,
	emoji: string,
}

Streak.REWARDS = {
	{ kind = "coins", minutes = 10, minimum = 250, label = "Coins", emoji = "💰" },
	{ kind = "coins", minutes = 20, minimum = 1000, label = "More coins", emoji = "💰" },
	{ kind = "luck", seconds = 900, label = "15 min Luck", emoji = "🍀" },
	{ kind = "coins", minutes = 45, minimum = 5000, label = "Coin pile", emoji = "💰" },
	{ kind = "coinBoost", seconds = 1800, label = "30 min 2x Coins", emoji = "⚡" },
	{ kind = "coins", minutes = 90, minimum = 20000, label = "Coin mountain", emoji = "💰" },
	{ kind = "dino", species = "Brachiosaurus", label = "Baby Brachiosaurus!", emoji = "🦕" },
} :: { Reward }

export type State = { count: number, lastDay: number }

-- Returns whether the player can claim today and which day (1-7) they'd claim.
function Streak.status(state: State, today: number): (boolean, number)
	if state.lastDay == today then
		return false, state.count
	end
	if state.lastDay == today - 1 then
		return true, (state.count % #Streak.REWARDS) + 1
	end
	return true, 1
end

return Streak
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="37">
        <Properties>
          <string name="Name">Visual</string>
        </Properties>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">DinoModel</string>
            <string name="Source"><![CDATA[--!strict
-- Builds a chunky, cartoon dinosaur out of simple parts from the species' body
-- plan. No uploaded meshes needed, so the game works out of the box; swap in
-- real models later by replacing build().
--
-- Model space: origin on the ground under the body, facing -Z (LookVector).

local CollectionService = game:GetService("CollectionService")

local DinoData = require(script.Parent.Parent.Data.DinoData)
local MutationData = require(script.Parent.Parent.Data.MutationData)
local Frames = require(script.Parent.Parent.Util.Frames)
local Growth = require(script.Parent.Parent.Util.Growth)

local DinoModel = {}

export type Mode = "Static" | "World" | "Mount"

DinoModel.BASE_UNIT = 1.4
DinoModel.RAINBOW_TAG = "RainbowPart"
DinoModel.TAG = "Dino"

local IVORY = Color3.fromRGB(240, 235, 215)
local EYE_WHITE = Color3.fromRGB(255, 255, 255)
local PUPIL = Color3.fromRGB(28, 24, 40)
local MOUTH = Color3.fromRGB(70, 35, 45)
local CHEEK = Color3.fromRGB(255, 150, 175)
local GOLD = {
	main = Color3.fromRGB(255, 196, 46),
	belly = Color3.fromRGB(255, 236, 150),
	accent = Color3.fromRGB(214, 128, 24),
}

local function rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

type Role = "main" | "belly" | "accent" | "detail"

type Builder = {
	model: Model,
	root: BasePart,
	scale: number,
	colors: { main: Color3, belly: Color3, accent: Color3 },
	parts: { { part: BasePart, role: Role } },
}

local function newPart(b: Builder, name: string, role: Role, color: Color3): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Anchored = true
	p.CastShadow = role ~= "detail"
	p.Parent = b.model
	table.insert(b.parts, { part = p :: BasePart, role = role })
	return p
end

-- Ellipsoid of `size` (unit space) at `cf` (unit space).
local function ellipsoid(
	b: Builder,
	name: string,
	role: Role,
	color: Color3,
	size: Vector3,
	cf: CFrame
): Part
	local p = newPart(b, name, role, color)
	p.Size = size * b.scale
	p.CFrame = cf.Rotation + cf.Position * b.scale
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

-- Cylinder from `a` to `b` (unit space).
local function cylinder(
	bld: Builder,
	name: string,
	role: Role,
	color: Color3,
	a: Vector3,
	z: Vector3,
	thickness: number
): Part
	local p = newPart(bld, name, role, color)
	p.Shape = Enum.PartType.Cylinder
	local length = (z - a).Magnitude
	p.Size = Vector3.new(length, thickness, thickness) * bld.scale
	local mid = (a + z) / 2
	local cf = Frames.alongX(mid, z - a)
	p.CFrame = cf.Rotation + cf.Position * bld.scale
	return p
end

local function along(center: Vector3, direction: Vector3): CFrame
	return Frames.alongZ(center, direction)
end

local function addParticles(target: BasePart, color: Color3, scale: number, rate: number)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Rate = rate
	emitter.Lifetime = NumberRange.new(0.8, 1.6)
	emitter.Speed = NumberRange.new(0.5, 1.5)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35 * scale),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Parent = target
end

-- Signature details per mutation so each one reads at a glance, not just as
-- a recolour: glowing cracks (Lava), ice crystals (Frost), stars (Cosmic).
local DETAIL_SPOTS = {
	{ 0.35, -0.22 },
	{ -0.5, -0.05 },
	{ 0.15, 0.15 },
	{ -0.2, 0.3 },
	{ 0.9, 0.05 },
	{ -1, -0.25 },
	{ 0.6, 0.32 },
}

local function addMutationDetails(b: Builder, body: BasePart, mutation: string)
	local center = body.CFrame.Position / b.scale
	local size = body.Size / b.scale
	for i, spot in DETAIL_SPOTS do
		local a, bb, c = size.X / 2, size.Y / 2, size.Z / 2
		local ring = math.sqrt(math.max(0, 1 - (2 * spot[2]) ^ 2))
		local p = Vector3.new(
			math.sin(spot[1]) * a * ring,
			math.cos(spot[1]) * bb * ring,
			spot[2] * size.Z
		)
		local normal = Vector3.new(p.X / (a * a), p.Y / (bb * bb), p.Z / (c * c)).Unit
		local at = center + p
		if mutation == "Lava" and i <= 5 then
			local crack = ellipsoid(
				b,
				"LavaCrack",
				"detail",
				Color3.fromRGB(255, 150, 40),
				Vector3.new(size.X * 0.06, size.X * 0.32, size.Y * 0.06),
				along(at, normal) * CFrame.Angles(0, 0, i * 0.9)
			)
			crack.Material = Enum.Material.Neon
		elseif mutation == "Frost" and i <= 5 then
			local up = (normal + Vector3.new(0, 1.2, 0)).Unit
			local crystal = ellipsoid(
				b,
				"IceCrystal",
				"detail",
				Color3.fromRGB(200, 240, 255),
				Vector3.new(size.Y * 0.12, size.Y * 0.12, size.Y * 0.5),
				along(at + up * size.Y * 0.12, up)
			)
			crystal.Material = Enum.Material.Ice
		elseif mutation == "Cosmic" then
			local star = ellipsoid(
				b,
				"Star",
				"detail",
				Color3.fromRGB(255, 250, 220),
				Vector3.new(size.Y * 0.09, size.Y * 0.09, size.Y * 0.09),
				CFrame.new(at + normal * size.Y * 0.02)
			)
			star.Material = Enum.Material.Neon
		end
	end
end

local function applyMutation(b: Builder, mutation: string?)
	if mutation == nil then
		return
	end
	local body = b.model:FindFirstChild("Body")
	for _, entry in b.parts do
		local p = entry.part
		if entry.role == "detail" then
			continue
		end
		if mutation == "Glossy" then
			p.Reflectance = 0.3
			p.Color = p.Color:Lerp(Color3.new(1, 1, 1), 0.15)
		elseif mutation == "Lava" then
			if entry.role == "main" then
				p.Color = Color3.fromRGB(60, 22, 18)
			elseif entry.role == "belly" and p.Name ~= "Belly" then
				-- only the belly glows; a glowing chin reads as a duck bill
				p.Color = Color3.fromRGB(150, 52, 24)
			elseif entry.role == "belly" then
				p.Color = Color3.fromRGB(255, 120, 30)
				p.Material = Enum.Material.Neon
			else
				p.Color = Color3.fromRGB(255, 80, 20)
				p.Material = Enum.Material.Neon
			end
		elseif mutation == "Frost" then
			if entry.role == "main" then
				p.Color = Color3.fromRGB(170, 220, 255)
				p.Material = Enum.Material.Ice
			elseif entry.role == "belly" then
				p.Color = Color3.fromRGB(240, 250, 255)
			else
				p.Color = Color3.fromRGB(110, 180, 255)
				p.Material = Enum.Material.Glass
			end
		elseif mutation == "Cosmic" then
			if entry.role == "main" then
				p.Color = Color3.fromRGB(55, 30, 110)
			elseif entry.role == "belly" and p.Name ~= "Belly" then
				p.Color = Color3.fromRGB(110, 70, 190)
			elseif entry.role == "belly" then
				p.Color = Color3.fromRGB(150, 90, 255)
				p.Material = Enum.Material.Neon
			else
				p.Color = Color3.fromRGB(255, 255, 255)
				p.Material = Enum.Material.Neon
			end
		elseif mutation == "Rainbow" then
			p.Reflectance = 0.1
			if entry.role == "main" or entry.role == "accent" then
				CollectionService:AddTag(p, DinoModel.RAINBOW_TAG)
			end
		end
	end
	if body and body:IsA("BasePart") then
		addMutationDetails(b, body, mutation)
		local m = MutationData.get(mutation)
		if m and mutation ~= "Glossy" then
			addParticles(body, rgb(m.color), b.scale, 6)
		elseif mutation == "Glossy" then
			addParticles(body, Color3.fromRGB(255, 255, 220), b.scale, 2)
		end
	end
end

-- Golden dinos wear a little crown and sparkle.
local function addGoldenDetails(b: Builder)
	local head = b.model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		local top = head.CFrame.Position / b.scale + Vector3.new(0, head.Size.Y / b.scale * 0.42, 0)
		local width = math.min(head.Size.X, head.Size.Z) / b.scale * 0.55
		local band = cylinder(
			b,
			"Crown",
			"detail",
			GOLD.main,
			top,
			top + Vector3.new(0, width * 0.32, 0),
			width
		)
		band.Reflectance = 0.25
		for i = 0, 2 do
			local angle = math.rad(-90 + i * 90)
			local spot = top
				+ Vector3.new(
					math.cos(angle) * width * 0.36,
					width * 0.42,
					math.sin(angle) * width * 0.36
				)
			local jewel = ellipsoid(
				b,
				"CrownTip",
				"detail",
				if i == 1 then Color3.fromRGB(255, 80, 110) else GOLD.belly,
				Vector3.new(width * 0.26, width * 0.26, width * 0.26),
				CFrame.new(spot)
			)
			jewel.Reflectance = 0.2
		end
	end
	local body = b.model:FindFirstChild("Body")
	if body and body:IsA("BasePart") then
		addParticles(body, Color3.fromRGB(255, 220, 90), b.scale, 4)
	end
end

local function ball(
	b: Builder,
	name: string,
	role: Role,
	color: Color3,
	diameter: number,
	position: Vector3
): Part
	return ellipsoid(
		b,
		name,
		role,
		color,
		Vector3.new(diameter, diameter, diameter),
		CFrame.new(position)
	)
end

local function darker(c: Color3, amount: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), amount)
end

local function lighter(c: Color3, amount: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), amount)
end

-- Point on an axis-aligned ellipsoid's surface (`around` = angle from the top
-- toward +X, `k` = -0.5..0.5 along the length) plus the outward normal there.
local function onSurface(
	center: Vector3,
	size: Vector3,
	around: number,
	k: number
): (Vector3, Vector3)
	local a, bb, c = size.X / 2, size.Y / 2, size.Z / 2
	local ring = math.sqrt(math.max(0, 1 - (2 * k) ^ 2))
	local p = Vector3.new(math.sin(around) * a * ring, math.cos(around) * bb * ring, k * size.Z)
	local normal = Vector3.new(p.X / (a * a), p.Y / (bb * bb), p.Z / (c * c))
	if normal.Magnitude < 1e-6 then
		normal = Vector3.new(0, 1, 0)
	end
	return center + p, normal.Unit
end

type Head = { center: Vector3, size: Vector3, muzzle: Vector3, muzzleSize: Vector3 }

local function buildHead(b: Builder, stage: number, center: Vector3, size: Vector3): Head
	local c = b.colors
	local hw, hh, hl = size.X, size.Y, size.Z
	local baby = stage == Growth.BABY
	ellipsoid(b, "Head", "main", c.main, size, CFrame.new(center))

	-- rounded muzzle in the body colour, lighter chin underneath, smile line between
	local muzzleSize = Vector3.new(hw * 0.84, hh * 0.64, hl * 0.62)
	local muzzle = center + Vector3.new(0, -hh * 0.14, -hl * 0.36)
	ellipsoid(b, "Muzzle", "main", c.main, muzzleSize, CFrame.new(muzzle))
	ellipsoid(
		b,
		"Chin",
		"belly",
		c.belly,
		Vector3.new(hw * 0.74, hh * 0.42, hl * 0.6),
		CFrame.new(muzzle + Vector3.new(0, -hh * 0.15, hl * 0.02))
	)
	ellipsoid(
		b,
		"Mouth",
		"detail",
		MOUTH,
		Vector3.new(hw * 0.86, hh * 0.05, hl * 0.64),
		CFrame.new(muzzle + Vector3.new(0, -hh * 0.08, -hl * 0.01))
	)
	for _, side in { -1, 1 } do
		ball(
			b,
			"Nostril",
			"detail",
			darker(c.main, 0.45),
			hh * 0.08,
			muzzle + Vector3.new(side * hw * 0.15, hh * 0.24, -hl * 0.27)
		)
	end

	-- big shiny eyes and blush cheeks
	local e = hh * (if baby then 0.5 else 0.42)
	for _, side in { -1, 1 } do
		local eye = center + Vector3.new(side * hw * 0.33, hh * 0.2, -hl * 0.2)
		ellipsoid(
			b,
			"Eye",
			"detail",
			EYE_WHITE,
			Vector3.new(e * 0.85, e, e * 0.85),
			CFrame.new(eye)
		)
		ellipsoid(
			b,
			"Pupil",
			"detail",
			PUPIL,
			Vector3.new(e * 0.6, e * 0.72, e * 0.6),
			CFrame.new(eye + Vector3.new(side * e * 0.2, -e * 0.02, -e * 0.2))
		)
		ball(
			b,
			"Shine",
			"detail",
			EYE_WHITE,
			e * 0.22,
			eye + Vector3.new(side * e * 0.33, e * 0.2, -e * 0.32)
		)
		ellipsoid(
			b,
			"Cheek",
			"detail",
			CHEEK,
			Vector3.new(e * 0.75, e * 0.38, e * 0.62),
			CFrame.new(center + Vector3.new(side * hw * 0.36, -hh * 0.1, -hl * 0.34))
		)
	end
	return { center = center, size = size, muzzle = muzzle, muzzleSize = muzzleSize }
end

local function buildBody(b: Builder, species: DinoData.Species, stage: number)
	local plan = species.plan
	local c = b.colors
	local bw, bh, bl = plan.body[1], plan.body[2], plan.body[3]
	local legH = plan.legHeight
	local lt = plan.legThickness
	local tailLength = plan.tailLength
	local tt = plan.tailThickness
	local neckLength = plan.neckLength
	local feet = darker(c.main, 0.22)

	-- Cartoon proportions: rounder heads for everyone, and young dinos get
	-- bigger heads and eyes with shorter legs and tails.
	local headScale = 1.15
	local headLength = 1
	if stage == Growth.BABY then
		headScale, headLength = 1.55, 1.3
		legH *= 0.8
		tailLength *= 0.75
		neckLength *= 0.8
	elseif stage == Growth.JUVENILE then
		headScale, headLength = 1.3, 1.12
		legH *= 0.92
		tailLength *= 0.9
	end
	local headSize =
		Vector3.new(plan.head[1] * headScale, plan.head[2] * headScale, plan.head[3] * headLength)
	local hw, hh, hl = headSize.X, headSize.Y, headSize.Z

	local bodyCenter = Vector3.new(0, legH + bh * 0.42, 0)
	local bodySize = Vector3.new(bw, bh, bl)
	ellipsoid(b, "Body", "main", c.main, bodySize, CFrame.new(bodyCenter))
	ellipsoid(
		b,
		"Belly",
		"belly",
		c.belly,
		Vector3.new(bw * 0.84, bh * 0.72, bl * 0.82),
		CFrame.new(bodyCenter + Vector3.new(0, -bh * 0.17, -bl * 0.05))
	)

	-- Legs: round feet with ivory claws
	if plan.kind == "biped" or plan.kind == "flyer" then
		for _, side in { -1, 1 } do
			local x = side * bw * 0.3
			local z = bl * 0.1
			if plan.kind == "biped" then
				ellipsoid(
					b,
					"Thigh",
					"main",
					c.main,
					Vector3.new(lt * 1.5, legH * 0.78, lt * 1.9),
					CFrame.new(x, legH * 0.74, z - lt * 0.05)
				)
			end
			cylinder(
				b,
				"Shin",
				"main",
				c.main,
				Vector3.new(x, legH * 0.58, z + lt * 0.05),
				Vector3.new(x, lt * 0.35, z),
				lt * 0.95
			)
			ellipsoid(
				b,
				"Foot",
				"main",
				feet,
				Vector3.new(lt * 1.45, lt * 0.62, lt * 2.1),
				CFrame.new(x, lt * 0.31, z - lt * 0.5)
			)
			for i = -1, 1 do
				ball(
					b,
					"Claw",
					"detail",
					IVORY,
					lt * 0.36,
					Vector3.new(x + i * lt * 0.42, lt * 0.2, z - lt * 1.45)
				)
			end
		end
	elseif plan.kind == "quad" then
		for _, side in { -1, 1 } do
			for _, front in { -1, 1 } do
				local x = side * bw * 0.32
				local z = front * bl * 0.27
				ellipsoid(
					b,
					"Leg",
					"main",
					c.main,
					Vector3.new(lt * 1.35, legH * 0.8 + bh * 0.3, lt * 1.4),
					CFrame.new(x, legH * 0.75 + bh * 0.1, z)
				)
				cylinder(
					b,
					"Shin",
					"main",
					c.main,
					Vector3.new(x, legH * 0.62, z),
					Vector3.new(x, lt * 0.3, z),
					lt * 1.05
				)
				ellipsoid(
					b,
					"Foot",
					"main",
					feet,
					Vector3.new(lt * 1.38, lt * 0.56, lt * 1.45),
					CFrame.new(x, lt * 0.28, z - lt * 0.06)
				)
				for i = -1, 1 do
					ball(
						b,
						"Nail",
						"detail",
						IVORY,
						lt * 0.3,
						Vector3.new(x + i * lt * 0.38, lt * 0.18, z - lt * 0.66)
					)
				end
			end
		end
	end

	-- Little arms with round hands
	if plan.arms then
		local ta = math.max(lt * 0.48, 0.18)
		for _, side in { -1, 1 } do
			local shoulder = bodyCenter + Vector3.new(side * bw * 0.36, -bh * 0.02, -bl * 0.3)
			local hand = shoulder + Vector3.new(side * 0.06, -bh * 0.3, -bl * 0.1)
			ellipsoid(
				b,
				"Arm",
				"main",
				c.main,
				Vector3.new(ta, ta, (hand - shoulder).Magnitude + ta),
				along((shoulder + hand) / 2, hand - shoulder)
			)
			ball(b, "Hand", "main", c.main, ta * 1.25, hand)
		end
	end

	-- Neck + head
	local headCenter: Vector3
	if neckLength > 0.05 then
		local angle = math.rad(plan.neckAngle)
		local dir = Vector3.new(0, math.sin(angle), -math.cos(angle))
		local neckStart = bodyCenter + Vector3.new(0, bh * 0.2, -bl * 0.36)
		local neckEnd = neckStart + dir * neckLength
		ellipsoid(
			b,
			"Neck",
			"main",
			c.main,
			Vector3.new(plan.neckThickness, plan.neckThickness, neckLength + plan.neckThickness),
			along((neckStart + neckEnd) / 2, dir)
		)
		headCenter = neckEnd + Vector3.new(0, hh * 0.12, -hl * 0.28)
	else
		headCenter = bodyCenter + Vector3.new(0, bh * 0.2, -(bl * 0.48 + hl * 0.3))
	end
	local head = buildHead(b, stage, headCenter, headSize)

	-- Tail: three tapering segments curling up a little at the tip
	local segments = {
		{ length = 0.42, thick = 1, dir = Vector3.new(0, -0.12, 1) },
		{ length = 0.34, thick = 0.68, dir = Vector3.new(0, 0.02, 1) },
		{ length = 0.3, thick = 0.42, dir = Vector3.new(0, 0.2, 1) },
	}
	local cursor = bodyCenter + Vector3.new(0, bh * 0.04, bl * 0.36)
	local lastDir = Vector3.new(0, 0, 1)
	local lastLength = 0
	for i, seg in segments do
		local dir = seg.dir.Unit
		local length = tailLength * seg.length
		local thick = tt * seg.thick
		ellipsoid(
			b,
			if i == 1 then "Tail" else "TailTip",
			"main",
			c.main,
			Vector3.new(thick, thick * 0.9, length * 1.2),
			along(cursor + dir * length * 0.5, dir)
		)
		cursor += dir * length * 0.85
		lastDir = dir
		lastLength = length
	end
	local tailEnd = cursor

	-- Species features
	local accentLight = lighter(c.accent, 0.35)
	for _, feature in plan.features do
		if feature == "stripes" then
			-- bands across the back only (not wrapped round the belly)
			for _, k in { -0.24, -0.02, 0.2 } do
				local ring = math.sqrt(math.max(0, 1 - (2 * k) ^ 2))
				ellipsoid(
					b,
					"Stripe",
					"accent",
					c.accent,
					Vector3.new(bw * 0.86 * ring, bh * 0.26, bl * 0.11),
					CFrame.new(bodyCenter + Vector3.new(0, bh * 0.42 * ring - bh * 0.06, k * bl))
				)
			end
		elseif feature == "spots" then
			local spots = {
				{ 0.5, -0.15 },
				{ -0.6, 0.05 },
				{ 0.15, 0.22 },
				{ -0.25, -0.28 },
				{ 0.85, 0.15 },
				{ -0.9, -0.12 },
			}
			for _, spot in spots do
				local p, normal = onSurface(bodyCenter, bodySize, spot[1], spot[2])
				ellipsoid(
					b,
					"Spot",
					"accent",
					c.accent,
					Vector3.new(bw * 0.22, bw * 0.2, bh * 0.08),
					along(p, normal)
				)
			end
		elseif feature == "plates" then
			for i = 1, 6 do
				local k = -0.3 + (i - 1) * 0.12
				local ring = math.sqrt(math.max(0, 1 - (2 * k) ^ 2))
				local height = bh * 0.62 * (1 - math.abs(k + 0.02) * 1.3)
				local x = if i % 2 == 0 then bw * 0.05 else -bw * 0.05
				ellipsoid(
					b,
					"Plate",
					"accent",
					c.accent,
					Vector3.new(bw * 0.09, height, height * 0.8),
					CFrame.new(
						bodyCenter + Vector3.new(x, bh * 0.44 * ring + height * 0.28, k * bl)
					)
				)
			end
		elseif feature == "spikes" then
			for _, side in { -1, 1 } do
				for _, back in { 0.15, 0.55 } do
					local base = tailEnd - lastDir * lastLength * back
					local dir = Vector3.new(side * 1, 0.7, 0.25).Unit
					ellipsoid(
						b,
						"Spike",
						"detail",
						IVORY,
						Vector3.new(tt * 0.22, tt * 0.22, tt * 1.1),
						along(base + dir * tt * 0.4, dir)
					)
				end
			end
		elseif feature == "club" then
			ellipsoid(
				b,
				"Club",
				"accent",
				c.accent,
				Vector3.new(tt * 1.9, tt * 1.3, tt * 1.6),
				CFrame.new(tailEnd)
			)
			for _, side in { -1, 1 } do
				ball(
					b,
					"Knob",
					"accent",
					accentLight,
					tt * 0.7,
					tailEnd + Vector3.new(side * tt * 0.85, tt * 0.1, 0)
				)
			end
		elseif feature == "armor" then
			for row = -1, 1 do
				for i = 0, 3 do
					local k = -0.27 + i * 0.18
					local around = row * 0.55
					local p, normal = onSurface(bodyCenter, bodySize, around, k)
					ellipsoid(
						b,
						"Scute",
						"accent",
						c.accent,
						Vector3.new(bw * 0.17, bw * 0.17, bh * 0.16),
						along(p, normal)
					)
				end
			end
			for _, side in { -1, 1 } do
				for i = 0, 2 do
					local k = -0.22 + i * 0.22
					local p = onSurface(bodyCenter, bodySize, side * 1.45, k)
					local dir = Vector3.new(side, 0.15, 0).Unit
					ellipsoid(
						b,
						"Spike",
						"detail",
						IVORY,
						Vector3.new(bh * 0.14, bh * 0.14, bh * 0.42),
						along(p + dir * bh * 0.12, dir)
					)
				end
			end
		elseif feature == "frill" then
			-- fan behind the head: body-coloured rim, accent centre, knobbly edge
			local frillSize = Vector3.new(hw * 1.95, hh * 1.65, hh * 0.18)
			local frill = CFrame.new(headCenter + Vector3.new(0, hh * 0.5, hl * 0.36))
				* CFrame.Angles(math.rad(40), 0, 0)
			ellipsoid(b, "Frill", "main", darker(c.main, 0.08), frillSize, frill)
			ellipsoid(
				b,
				"FrillInner",
				"accent",
				c.accent,
				Vector3.new(frillSize.X * 0.66, frillSize.Y * 0.6, frillSize.Z * 1.08),
				frill * CFrame.new(0, -frillSize.Y * 0.06, 0)
			)
			for i = 0, 6 do
				local phi = math.rad(15 + i * 25)
				local p = frill
					* Vector3.new(
						math.cos(phi) * frillSize.X * 0.47,
						math.sin(phi) * frillSize.Y * 0.47,
						0
					)
				ball(b, "FrillKnob", "accent", accentLight, hh * 0.26, p)
			end
		elseif feature == "horns" then
			for _, side in { -1, 1 } do
				local base = headCenter + Vector3.new(side * hw * 0.24, hh * 0.38, -hl * 0.04)
				local dir = Vector3.new(side * 0.12, 0.6, -0.8).Unit
				local length = hh * 1.15
				ellipsoid(
					b,
					"Horn",
					"detail",
					IVORY,
					Vector3.new(hh * 0.22, hh * 0.22, length),
					along(base + dir * length * 0.42, dir)
				)
			end
			local nose = head.muzzle
				+ Vector3.new(0, head.muzzleSize.Y * 0.42, -head.muzzleSize.Z * 0.22)
			local dir = Vector3.new(0, 0.85, -0.5).Unit
			ellipsoid(
				b,
				"Horn",
				"detail",
				IVORY,
				Vector3.new(hh * 0.2, hh * 0.2, hh * 0.55),
				along(nose + dir * hh * 0.18, dir)
			)
		elseif feature == "crest" then
			local dir = Vector3.new(0, 0.5, 1).Unit
			ellipsoid(
				b,
				"Crest",
				"accent",
				c.accent,
				Vector3.new(hw * 0.32, hw * 0.32, hl * 1.5),
				along(headCenter + Vector3.new(0, hh * 0.55, hl * 0.45), dir)
			)
		elseif feature == "dome" then
			local dome = headCenter + Vector3.new(0, hh * 0.36, hl * 0.06)
			ellipsoid(
				b,
				"Dome",
				"accent",
				c.accent,
				Vector3.new(hw * 1.08, hh * 0.82, hl * 0.84),
				CFrame.new(dome)
			)
			for i = 0, 6 do
				local a = math.rad(-90 + i * 30)
				ball(
					b,
					"Knob",
					"accent",
					darker(c.accent, 0.15),
					hh * 0.16,
					dome + Vector3.new(math.sin(a) * hw * 0.5, -hh * 0.18, math.cos(a) * hl * 0.4)
				)
			end
		elseif feature == "doubleCrest" then
			for _, side in { -1, 1 } do
				ellipsoid(
					b,
					"Crest",
					"accent",
					c.accent,
					Vector3.new(hw * 0.1, hh * 0.8, hl * 0.95),
					CFrame.new(headCenter + Vector3.new(side * hw * 0.18, hh * 0.55, -hl * 0.02))
						* CFrame.Angles(0, 0, math.rad(side * -8))
				)
			end
		elseif feature == "wings" then
			-- half-raised wings with a bony leading edge
			for _, side in { -1, 1 } do
				local shoulder = bodyCenter + Vector3.new(side * bw * 0.4, bh * 0.22, -bl * 0.05)
				local inner = shoulder + Vector3.new(side * bl * 0.55, bl * 0.22, bl * 0.05)
				ellipsoid(
					b,
					"Wing",
					"accent",
					c.accent,
					Vector3.new(bl * 1.2, 0.12, bl * 1.0),
					CFrame.new(inner) * CFrame.Angles(0, 0, math.rad(side * 22))
				)
				local outer = shoulder + Vector3.new(side * bl * 1.35, bl * 0.62, -bl * 0.06)
				ellipsoid(
					b,
					"Wing",
					"accent",
					c.accent,
					Vector3.new(bl * 0.95, 0.1, bl * 0.58),
					CFrame.new(outer) * CFrame.Angles(0, math.rad(side * 14), math.rad(side * 32))
				)
				local tip = shoulder + Vector3.new(side * bl * 1.8, bl * 0.9, -bl * 0.28)
				cylinder(
					b,
					"WingBone",
					"main",
					c.main,
					shoulder + Vector3.new(0, 0.05, -bl * 0.2),
					tip,
					0.16
				)
			end
		elseif feature == "beakCrest" then
			ellipsoid(
				b,
				"BeakCrest",
				"accent",
				c.accent,
				Vector3.new(hw * 0.25, hh * 0.8, hl * 0.9),
				along(headCenter + Vector3.new(0, hh * 0.35, hl * 0.6), Vector3.new(0, 0.5, 1))
			)
		elseif feature == "flippers" then
			for _, side in { -1, 1 } do
				for _, front in { -1, 1 } do
					ellipsoid(
						b,
						"Flipper",
						"accent",
						c.accent,
						Vector3.new(bw * 0.9, 0.15, bw * 0.45),
						CFrame.new(
							bodyCenter + Vector3.new(side * bw * 0.6, -bh * 0.3, front * bl * 0.28)
						)
							* CFrame.Angles(0, math.rad(front * side * 20), math.rad(side * -10))
					)
				end
			end
		elseif feature == "tailFin" then
			-- crescent fin: a tall upper lobe and a short, shallow lower one
			-- (kept above the ground since swimmers lie low)
			local lobes = {
				{ dir = Vector3.new(0, 0.75, 0.65).Unit, length = tt * 1.9, offset = tt * 0.75 },
				{ dir = Vector3.new(0, -0.4, 0.9).Unit, length = tt * 1.3, offset = tt * 0.6 },
			}
			for _, lobe in lobes do
				ellipsoid(
					b,
					"TailFin",
					"accent",
					c.accent,
					Vector3.new(0.14, tt * 0.7, lobe.length),
					along(tailEnd + lobe.dir * lobe.offset, lobe.dir)
				)
			end
		elseif feature == "teeth" then
			for _, side in { -1, 1 } do
				for _, step in { 0.18, 0.32 } do
					ellipsoid(
						b,
						"Tooth",
						"detail",
						IVORY,
						Vector3.new(hw * 0.08, hh * 0.15, hw * 0.08),
						CFrame.new(
							head.muzzle
								+ Vector3.new(
									side * hw * step,
									-hh * 0.18,
									-hl * (0.22 - step * 0.3)
								)
						)
					)
				end
			end
		elseif feature == "sail" then
			local heights = { 0.7, 1.15, 1.4, 1.2, 0.8 }
			for i, height in heights do
				local k = -0.24 + (i - 1) * 0.12
				local h = bh * height
				ellipsoid(
					b,
					"Sail",
					"accent",
					if i % 2 == 0 then c.accent else darker(c.accent, 0.1),
					Vector3.new(0.14, h, bl * 0.2),
					CFrame.new(bodyCenter + Vector3.new(0, bh * 0.36 + h * 0.36, k * bl))
				)
			end
		end
	end
end

-- Studs per body-plan unit. Species sizes are softened (big species stay
-- big without a giant T-Rex swallowing the whole nest).
function DinoModel.scaleFor(species: DinoData.Species, stage: number): number
	return species.scale ^ 0.75 * Growth.SIZE[math.clamp(stage, 1, 4)] * DinoModel.BASE_UNIT
end

-- Builds a dino model. `stage` is 1-4 (Baby..Giant); `golden` paints it gold
-- with a crown (mutations still apply on top).
--   Static: every part anchored (UI previews)
--   World: root anchored, everything else welded to it (move the root to move the dino)
--   Mount: nothing anchored, welded to the root; caller welds the root to a character
function DinoModel.build(
	speciesId: string,
	stage: number,
	mutation: string?,
	mode: Mode,
	golden: boolean?
): Model
	local species = DinoData.get(speciesId)
	assert(species, `unknown species {speciesId}`)
	stage = math.clamp(stage, 1, 4)
	local scale = DinoModel.scaleFor(species, stage)

	local model = Instance.new("Model")
	model.Name = species.name

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.Size = Vector3.new(species.plan.body[1], 0.2, species.plan.body[3]) * scale
	root.CFrame = CFrame.new(0, 0.1, 0)
	root.Parent = model
	model.PrimaryPart = root

	local b: Builder = {
		model = model,
		root = root,
		scale = scale,
		colors = if golden
			then { main = GOLD.main, belly = GOLD.belly, accent = GOLD.accent }
			else {
				main = rgb(species.colors.main),
				belly = rgb(species.colors.belly),
				accent = rgb(species.colors.accent),
			},
		parts = {},
	}

	buildBody(b, species, stage)
	applyMutation(b, mutation)
	if golden then
		addGoldenDetails(b)
		model:SetAttribute("Golden", true)
	end

	-- Prompt anchor at chest height
	local top = 0
	for _, entry in b.parts do
		local p = entry.part
		top = math.max(top, p.CFrame.Position.Y + p.Size.Y / 2)
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "PromptAttachment"
	attachment.CFrame = CFrame.new(0, top * 0.55, 0)
	attachment.Parent = root
	local labelAttachment = Instance.new("Attachment")
	labelAttachment.Name = "LabelAttachment"
	labelAttachment.CFrame = CFrame.new(0, top + 1, 0)
	labelAttachment.Parent = root
	model:SetAttribute("Height", top)

	if mode ~= "Static" then
		for _, entry in b.parts do
			local p = entry.part
			p.Massless = true
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = p
			weld.Parent = p
			p.Anchored = false
		end
		root.Anchored = mode == "World"
		root.Massless = mode == "Mount"
	end

	return model
end

return DinoModel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">EggModel</string>
            <string name="Source"><![CDATA[--!strict
-- Builds spotted eggs from simple parts. Same model-space rules as DinoModel:
-- origin on the ground, root part named "Root".

local DinoData = require(script.Parent.Parent.Data.DinoData)
local EggData = require(script.Parent.Parent.Data.EggData)
local Frames = require(script.Parent.Parent.Util.Frames)

local EggModel = {}

export type Look = {
	main: Color3,
	spots: Color3,
	material: Enum.Material,
	glow: boolean,
}

local function rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

local GIFT_LOOK: Look = {
	main = Color3.fromRGB(255, 205, 60),
	spots = Color3.fromRGB(255, 255, 255),
	material = Enum.Material.SmoothPlastic,
	glow = true,
}

function EggModel.lookForShopEgg(eggTypeId: string): Look
	local egg = EggData.get(eggTypeId)
	assert(egg, `unknown egg {eggTypeId}`)
	local material = Enum.Material.SmoothPlastic
	if egg.material == "Glass" then
		material = Enum.Material.Glass
	elseif egg.material == "Neon" then
		material = Enum.Material.Neon
	end
	return {
		main = rgb(egg.colors.main),
		spots = rgb(egg.colors.spots),
		material = material,
		glow = egg.id == "Volcano" or egg.id == "Crystal",
	}
end

function EggModel.lookForSpecies(speciesId: string): Look
	local species = DinoData.get(speciesId)
	assert(species, `unknown species {speciesId}`)
	return {
		main = rgb(species.colors.belly),
		spots = rgb(species.colors.main),
		material = Enum.Material.SmoothPlastic,
		glow = false,
	}
end

function EggModel.giftLook(): Look
	return GIFT_LOOK
end

-- `size` is the egg height in studs. Root is anchored; other parts are welded
-- to it unless `static` is true (then everything is anchored).
function EggModel.build(look: Look, size: number, static: boolean?): Model
	local model = Instance.new("Model")
	model.Name = "Egg"

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.Size = Vector3.new(size * 0.6, 0.1, size * 0.6)
	root.CFrame = CFrame.new(0, 0.05, 0)
	root.Parent = model
	model.PrimaryPart = root

	local parts: { BasePart } = {}

	local function make(name: string, color: Color3, partSize: Vector3, position: Vector3): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Color = color
		p.Material = look.material
		p.Size = partSize
		p.CFrame = CFrame.new(position)
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
		p.Parent = model
		table.insert(parts, p)
		return p
	end

	-- Egg silhouette: a squashed base under a taller, slightly narrower cap.
	-- The two ellipsoids are tangent (solved numerically), so the shell reads
	-- as one smooth egg that is widest a little below the middle.
	local a, b = size * 0.38, size * 0.5 -- radii (width, height)
	local shells = {
		make("Shell", look.main, Vector3.new(a * 2, b * 1.68, a * 2), Vector3.new(0, b * 0.84, 0)),
		make(
			"ShellTop",
			look.main,
			Vector3.new(a * 1.986, b * 2.18, a * 1.986),
			Vector3.new(0, b * 0.91, 0)
		),
	}
	if look.material == Enum.Material.Glass then
		for _, shell in shells do
			shell.Transparency = 0.25
		end
		local core = make("Core", look.spots, Vector3.new(a, b, a), Vector3.new(0, b, 0))
		core.Material = Enum.Material.Neon
	end

	-- Shell radius at a height (the larger of the two shapes there).
	local function radiusAt(y: number): number
		local function r(cy: number, ry: number, rx: number): number
			local t = (y - cy) / ry
			return if math.abs(t) >= 1 then 0 else rx * math.sqrt(1 - t * t)
		end
		return math.max(r(b * 0.84, b * 0.84, a), r(b * 0.91, b * 1.09, a * 0.993))
	end

	-- Painted spots at fixed spots on the shell (deterministic look).
	local spots = {
		{ 0.4, 0.62, 0.22 },
		{ 1.9, 0.75, 0.16 },
		{ 3.1, 0.45, 0.24 },
		{ 4.3, 0.68, 0.15 },
		{ 5.4, 0.36, 0.2 },
		{ 2.6, 0.24, 0.17 },
		{ 0.9, 0.22, 0.14 },
		{ 5.0, 0.86, 0.12 },
	}
	for _, spot in spots do
		local theta, height, spotSize = spot[1], spot[2] * b * 2, spot[3] * size
		local r = radiusAt(height)
		local outward = Vector3.new(math.cos(theta), 0, math.sin(theta))
		local slope = (radiusAt(height - 0.05) - radiusAt(height + 0.05)) / 0.1
		local normal = (outward + Vector3.new(0, slope, 0)).Unit
		local position = outward * r + Vector3.new(0, height, 0)
		local p =
			make("Spot", look.spots, Vector3.new(spotSize, spotSize, spotSize * 0.22), position)
		p.CFrame = Frames.alongZ(position - normal * spotSize * 0.04, normal)
		if look.glow then
			p.Material = Enum.Material.Neon
		end
	end

	if not static then
		for _, p in parts do
			p.Massless = true
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = p
			weld.Parent = p
			p.Anchored = false
		end
	end

	return model
end

return EggModel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Studs</string>
            <string name="Source"><![CDATA[--!strict
-- The stud look (Config.STUD_STYLE). The place ships with the SquareStuds
-- MaterialVariant in MaterialService set as the SmoothPlastic override, so
-- every face of every SmoothPlastic part (world, plots, dinos, eggs) shows
-- square studs once its images are added (see README). Any other style turns
-- that override off; "classic" then gets round studs from Build's surfaces.

local MaterialService = game:GetService("MaterialService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Studs = {}

Studs.VARIANT = "SquareStuds"

-- Runs on the server and on every client.
function Studs.apply()
	local name = if Config.STUD_STYLE == "square" then Studs.VARIANT else ""
	if name ~= "" and not MaterialService:FindFirstChild(name) then
		warn(`[Studs] MaterialService.{name} is missing, so parts stay smooth.`)
		return
	end
	local ok, err = pcall(function()
		MaterialService:SetBaseMaterialOverride(Enum.Material.SmoothPlastic, name)
	end)
	if not ok then
		warn(`[Studs] could not set the SmoothPlastic override: {err}`)
	end
end

return Studs
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="41">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="42">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Raise a Dino server entry point. Two-phase bootstrap: init() every system,
-- then start() every system (see docs: roblox-architecture).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Studs = require(ReplicatedStorage.Shared.Visual.Studs)

-- Remotes must exist before any system registers handlers in init().
Net.serverInit()
Studs.apply()

local Systems = script:WaitForChild("Systems")

type System = {
	init: (() -> ())?,
	start: (() -> ())?,
}

local loaded: { [string]: System } = {}
local order: { string } = {}
for _, child in Systems:GetChildren() do
	if child:IsA("ModuleScript") then
		loaded[child.Name] = require(child) :: any
		table.insert(order, child.Name)
	end
end
table.sort(order)

for _, name in order do
	local system = loaded[name]
	if system.init then
		system.init()
	end
end

for _, name in order do
	local system = loaded[name]
	if system.start then
		task.spawn(system.start)
	end
end

print("[RaiseADino] server started")
]]></string>
      </Properties>
      <Item class="Folder" referent="43">
