        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">TutorialData</string>
            <string name="Source"><![CDATA[--!strict
-- First-session tutorial. The server decides the step; the client shows the
-- hint and an arrow toward the target. Designed so a new player hatches a dino
-- in under 30 seconds and gets a rare one before 2 minutes.

export type Target = "Incubator" | "Pad" | "Shop" | "Thief" | "Lock" | "None"

export type Step = {
	text: string,
	target: Target,
	funnelName: string,
}

local TutorialData = {
	DONE = 99,
	STEPS = {
		{
			text = "Tap your glowing egg to warm it up! 🔥",
			target = "Incubator",
			funnelName = "WarmStarterEgg",
		},
		{
			text = "Your first dino! Step on the gold pad to collect coins 💰",
			target = "Pad",
			funnelName = "CollectCoins",
		},
		{
			text = "Head to the Egg Shop in the middle of the island and buy an egg 🥚",
			target = "Shop",
			funnelName = "BuyFirstEgg",
		},
		{
			text = "A shiny Gift Egg appeared at your nest! Go hatch it ✨",
			target = "Incubator",
			funnelName = "HatchGiftEgg",
		},
		{
			text = "Night raid practice! Tap the sneaky raptor to chase it off 🦖",
			target = "Thief",
			funnelName = "RaidPractice",
		},
		{
			text = "At night, lock your gate 🔒 to keep thieves out. Your dinos grow even while you're away!",
			target = "Lock",
			funnelName = "LockGate",
		},
	} :: { Step },
	STARTER_SPECIES = "Raptor",
	GIFT_SPECIES = "Parasaur",
	GIFT_MUTATION = "Glossy",
}

return TutorialData
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- Every remote in the game, created by the server in one folder from one list.
-- Server handlers go through a per-player, per-remote rate limit before running.
-- Arguments from clients are hostile until validated (see server systems).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

export type ClientEvent =
	"Ready"
	| "BuyEgg"
	| "HatchEgg"
	| "WarmEgg"
	| "IncubateTrayEgg"
	| "SellTrayEgg"
	| "SellDino"
	| "BuyUpgrade"
	| "LockGate"
	| "ClaimStreak"
	| "ClaimClub"
	| "PromptPurchase"
	| "Ride"
	| "Roar"
	| "TutorialAction"
	| "WatchAd"
	| "Cheat"

export type ServerEvent = "State" | "Notify" | "Effect"

local CLIENT_EVENTS: { ClientEvent } = {
	"Ready",
	"BuyEgg",
	"HatchEgg",
	"WarmEgg",
	"IncubateTrayEgg",
	"SellTrayEgg",
	"SellDino",
	"BuyUpgrade",
	"LockGate",
	"ClaimStreak",
	"ClaimClub",
	"PromptPurchase",
	"Ride",
	"Roar",
	"TutorialAction",
	"WatchAd",
	"Cheat",
}

local SERVER_EVENTS: { ServerEvent } = { "State", "Notify", "Effect" }

local FOLDER_NAME = "Remotes"

local Net = {}

local remotes: { [string]: RemoteEvent } = {}

-- Token bucket per player per remote.
type Bucket = { tokens: number, last: number }
local buckets: { [Player]: { [string]: Bucket } } = {}

local function allow(player: Player, key: string, ratePerSecond: number, burst: number): boolean
	local now = os.clock()
	local playerBuckets = buckets[player]
	if not playerBuckets then
		playerBuckets = {}
		buckets[player] = playerBuckets
	end
	local b = playerBuckets[key]
	if not b then
		b = { tokens = burst, last = now }
		playerBuckets[key] = b
	end
	b.tokens = math.min(burst, b.tokens + (now - b.last) * ratePerSecond)
	b.last = now
	if b.tokens < 1 then
		return false
	end
	b.tokens -= 1
	return true
end

-- Server: create every remote. Called once by the server entry point.
function Net.serverInit()
	assert(RunService:IsServer(), "Net.serverInit is server-only")
	local folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	for _, name in CLIENT_EVENTS do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		remotes[name] = remote
	end
	for _, name in SERVER_EVENTS do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		remotes[name] = remote
	end
	folder.Parent = ReplicatedStorage
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

local function getRemote(name: string): RemoteEvent
	local cached = remotes[name]
	if cached then
		return cached
	end
	local folder = ReplicatedStorage:WaitForChild(FOLDER_NAME)
	local remote = folder:WaitForChild(name)
	assert(remote:IsA("RemoteEvent"), `{name} is not a RemoteEvent`)
	remotes[name] = remote
	return remote
end

-- Server: handle a client event. Requests over the rate limit are dropped silently.
function Net.on(
	name: ClientEvent,
	ratePerSecond: number,
	burst: number,
	handler: (Player, ...unknown) -> ()
)
	getRemote(name).OnServerEvent:Connect(function(player: Player, ...: unknown)
		if not allow(player, name, ratePerSecond, burst) then
			return
		end
		handler(player, ...)
	end)
end

function Net.fire(player: Player, name: ServerEvent, ...: any)
	getRemote(name):FireClient(player, ...)
end

function Net.fireAll(name: ServerEvent, ...: any)
	getRemote(name):FireAllClients(...)
end

-- Client: send a request to the server.
function Net.send(name: ClientEvent, ...: any)
	getRemote(name):FireServer(...)
end

-- Client: listen to a server event.
function Net.listen(name: ServerEvent, handler: (...any) -> ())
	getRemote(name).OnClientEvent:Connect(handler)
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Palette</string>
          <string name="Source"><![CDATA[--!strict
-- The game's colours in one place, so the world and the UI share one cartoon
-- look: a limited, saturated palette with 2-3 shades per material (light top,
-- base, dark edge) instead of many unrelated colours.

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local Palette = {
	-- World materials (light, base, dark)
	grassLight = rgb(155, 227, 110),
	grass = rgb(123, 211, 90),
	grassDark = rgb(93, 183, 74),
	grassDeep = rgb(74, 158, 60),
	leafLight = rgb(126, 214, 92),
	leaf = rgb(88, 186, 74),
	leafDark = rgb(60, 150, 70),
	pine = rgb(62, 155, 90),
	pineDark = rgb(45, 125, 78),
	sandLight = rgb(250, 228, 160),
	sand = rgb(242, 214, 138),
	sandDark = rgb(226, 190, 110),
	path = rgb(236, 200, 134),
	pathEdge = rgb(214, 172, 108),
	dirt = rgb(201, 139, 85),
	dirtDark = rgb(168, 107, 62),
	water = rgb(79, 195, 247),
	waterDeep = rgb(46, 155, 219),
	shallows = rgb(118, 220, 236),
	foam = rgb(250, 254, 255),
	woodLight = rgb(205, 145, 92),
	wood = rgb(181, 122, 74),
	woodDark = rgb(142, 90, 52),
	stoneLight = rgb(214, 210, 224),
	stone = rgb(185, 180, 199),
	stoneDark = rgb(150, 144, 168),
	plaza = rgb(222, 196, 160),
	plazaDark = rgb(196, 166, 128),
	rockLava = rgb(132, 104, 98),
	rockLavaDark = rgb(96, 74, 76),
	lava = rgb(255, 122, 26),
	lavaHot = rgb(255, 196, 74),
	cream = rgb(255, 246, 225),
	white = rgb(255, 255, 255),
	lampGlow = rgb(255, 224, 138),

	-- Accents (one per nest, also used by UI)
	red = rgb(255, 93, 93),
	orange = rgb(255, 159, 67),
	yellow = rgb(255, 217, 61),
	blue = rgb(93, 173, 236),
	purple = rgb(168, 139, 235),
	pink = rgb(255, 143, 199),
	mint = rgb(110, 231, 183),
	teal = rgb(72, 201, 196),
}

-- Nest accent colours, in plot order.
Palette.NEST_ACCENTS = {
	Palette.red,
	Palette.orange,
	Palette.yellow,
	Palette.mint,
	Palette.blue,
	Palette.purple,
	Palette.pink,
	Palette.teal,
}

Palette.FLOWERS = {
	Palette.pink,
	Palette.yellow,
	Palette.purple,
	Palette.white,
	Palette.red,
	Palette.orange,
}

return Palette
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Tags</string>
          <string name="Source"><![CDATA[--!strict
-- CollectionService tags shared by the server (which tags things) and the
-- client (which animates them).

return {
	-- Lights the client switches on at night (lamps, lanterns).
	NIGHT_LIGHT = "NightLight",
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- Types that cross the client/server boundary (saved profile, state snapshot)
-- live here so both sides agree by construction.

export type DinoRecord = {
	id: string,
	species: string,
	mutation: string?,
	bornAt: number, -- unix seconds; stage is computed from age
	lastLaidAt: number,
}

-- "shop": species rolled at hatch from the egg's odds
-- "laid": laid by one of your dinos; species is fixed, mutation rolled at hatch
-- "starter"/"gift": tutorial eggs with a fixed result (not purchasable)
export type EggKind = "shop" | "laid" | "starter" | "gift"

export type IncubatorEgg = {
	id: string,
	kind: EggKind,
	eggType: string?, -- shop eggs
	species: string?, -- laid/starter/gift eggs
	mutation: string?, -- gift eggs
	placedAt: number,
	hatchAt: number,
}

export type TrayEgg = {
	id: string,
	species: string,
	laidAt: number,
}

export type Profile = {
	version: number,
	coins: number,
	pendingCoins: number,
	totalEarned: number,
	nextId: number,
	dinos: { DinoRecord },
	incubators: { [string]: IncubatorEgg }, -- keyed "1".."5" (string keys save cleanly)
	tray: { TrayEgg },
	dex: { [string]: { [string]: boolean } }, -- species -> mutation ("Normal" or id) -> true
	upgrades: { slots: number, incubators: number },
	boosts: { luckUntil: number, coinsUntil: number },
	instantHatchTokens: number,
	streak: { count: number, lastDay: number },
	club: { lastClaimDay: number },
	tutorial: number,
	starterPackBought: boolean,
	shop: { restock: number, bought: { [string]: number } },
	likes: number,
	stats: { hatched: number, stolen: number, eggsLost: number, sold: number },
	receipts: { string },
	firstJoin: number,
	lastSeen: number,
}

-- Everything the client needs to draw its own HUD. Sent on change.
export type Snapshot = {
	coins: number,
	pendingCoins: number,
	incomePerSecond: number,
	multiplier: number,
	dinos: { DinoRecord },
	incubators: { [string]: IncubatorEgg },
	tray: { TrayEgg },
	dex: { [string]: { [string]: boolean } },
	upgrades: { slots: number, incubators: number },
	boosts: { luckUntil: number, coinsUntil: number },
	instantHatchTokens: number,
	streak: { count: number, lastDay: number },
	clubClaimDay: number,
	tutorial: number,
	starterPackBought: boolean,
	shopBought: { restock: number, bought: { [string]: number } },
	likes: number,
	passes: { [string]: boolean },
	subscribed: boolean,
	restricted: boolean, -- paid random items restricted for this player (PolicyService)
	plotIndex: number,
	maxSlots: number,
	maxIncubators: number,
	lockUntil: number,
	lockCooldownUntil: number,
	shieldUntil: number,
	friendsHere: number,
	isDev: boolean,
	raidsEnabled: boolean,
	riding: string?,
	carrying: boolean,
}

-- Tutorial steps (server is authoritative; client only renders hints).
export type TutorialStep = number

return nil
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="20">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Clock</string>
            <string name="Source"><![CDATA[--!strict
-- One clock for everything. Uses the server's Unix time (synced to clients), so
-- timers, day/night and storms line up on every screen.
--
-- `cycleNow()` adds a debug offset (set by the cheat panel in Studio) so you can
-- skip to night or a storm while testing. Saved timestamps always use `now()`.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Clock = {}

Clock.OFFSET_ATTRIBUTE = "DebugCycleOffset"

function Clock.now(): number
	return workspace:GetServerTimeNow()
end

function Clock.cycleNow(): number
	local offset = ReplicatedStorage:GetAttribute(Clock.OFFSET_ATTRIBUTE)
	if typeof(offset) == "number" then
		return Clock.now() + offset
	end
	return Clock.now()
end

return Clock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Cycle</string>
            <string name="Source"><![CDATA[--!strict
-- Day/night, storms and egg-shop restocks. Everything is computed from the
-- current time with a deterministic RNG, so every server and every client
-- agrees on "is it night?", "what storm is on?" and "what's in stock?"
-- without sending a single network message.

local Config = require(script.Parent.Parent.Config)
local EggData = require(script.Parent.Parent.Data.EggData)
local MutationData = require(script.Parent.Parent.Data.MutationData)
local Rng = require(script.Parent.Rng)

local Cycle = {}

export type DayNight = {
	isNight: boolean,
	secondsLeft: number, -- until the phase flips
	phaseFraction: number, -- 0..1 through the current phase
	cycleIndex: number,
}

export type StormState = {
	active: boolean,
	kind: MutationData.StormKind?, -- nil during a mega storm
	mega: boolean,
	secondsLeft: number, -- until it ends (if active) or starts (if not)
	nextKind: MutationData.StormKind?, -- the kind of the next regular storm
	slot: number,
}

local SECONDS_PER_DAY = 86400
local SECONDS_PER_WEEK = 7 * SECONDS_PER_DAY
-- 1970-01-01 was a Thursday; with Sunday = 0 that's weekday 4.
local EPOCH_WEEKDAY = 4

function Cycle.dayNight(now: number): DayNight
	local length = Config.DAY_SECONDS + Config.NIGHT_SECONDS
	local cycleIndex = math.floor(now / length)
	local position = now - cycleIndex * length
	if position < Config.DAY_SECONDS then
		return {
			isNight = false,
			secondsLeft = Config.DAY_SECONDS - position,
			phaseFraction = position / Config.DAY_SECONDS,
			cycleIndex = cycleIndex,
		}
	end
	local intoNight = position - Config.DAY_SECONDS
	return {
		isNight = true,
		secondsLeft = Config.NIGHT_SECONDS - intoNight,
		phaseFraction = intoNight / Config.NIGHT_SECONDS,
		cycleIndex = cycleIndex,
	}
end

local function stormKindForSlot(slot: number): MutationData.StormKind
	local total = 0
	for _, s in MutationData.STORMS do
		total += s.weight
	end
	local r = Rng.new(Rng.hash(slot, 7919)).next() * total
	local acc = 0
	for _, s in MutationData.STORMS do
		acc += s.weight
		if r < acc then
			return s.kind
		end
	end
	return MutationData.STORMS[#MutationData.STORMS].kind
end

-- Start time of the most recent weekly mega storm at or before `now`.
local function lastMegaStart(now: number): number
	local days = math.floor(now / SECONDS_PER_DAY)
	local weekday = (days + EPOCH_WEEKDAY) % 7
	local daysBack = (weekday - Config.MEGA_STORM_WEEKDAY) % 7
	local start = (days - daysBack) * SECONDS_PER_DAY + Config.MEGA_STORM_HOUR_UTC * 3600
	if start > now then
		start -= SECONDS_PER_WEEK
	end
	return start
end

function Cycle.megaStorm(now: number): (boolean, number)
	local start = lastMegaStart(now)
	local elapsed = now - start
	if elapsed < Config.MEGA_STORM_DURATION then
		return true, Config.MEGA_STORM_DURATION - elapsed
	end
	return false, start + SECONDS_PER_WEEK - now
end

function Cycle.storm(now: number): StormState
	local megaActive, megaSeconds = Cycle.megaStorm(now)
	local slot = math.floor(now / Config.STORM_INTERVAL)
	local offset = now - slot * Config.STORM_INTERVAL
	if megaActive then
		return {
			active = true,
			kind = nil,
			mega = true,
			secondsLeft = megaSeconds,
			nextKind = stormKindForSlot(slot + 1),
			slot = slot,
		}
	end
	if offset < Config.STORM_DURATION then
		return {
			active = true,
			kind = stormKindForSlot(slot),
			mega = false,
			secondsLeft = Config.STORM_DURATION - offset,
			nextKind = stormKindForSlot(slot + 1),
			slot = slot,
		}
	end
	return {
		active = false,
		kind = nil,
		mega = false,
		secondsLeft = Config.STORM_INTERVAL - offset,
		nextKind = stormKindForSlot(slot + 1),
		slot = slot,
	}
end

export type Restock = {
	index: number,
	secondsLeft: number,
	stock: { [string]: number },
}

function Cycle.restock(now: number): Restock
	local index = math.floor(now / Config.RESTOCK_SECONDS)
	local stock: { [string]: number } = {}
	for _, egg in EggData.LIST do
		local rng = Rng.new(Rng.hash(index, egg.order * 104729))
		local count = 0
		if rng.next() < egg.stock.chance then
			count = rng.int(egg.stock.min, egg.stock.max)
		end
		stock[egg.id] = count
	end
	return {
		index = index,
		secondsLeft = (index + 1) * Config.RESTOCK_SECONDS - now,
		stock = stock,
	}
end

-- Whole UTC days since 1970, used for daily rewards.
function Cycle.dayNumber(now: number): number
	return math.floor(now / SECONDS_PER_DAY)
end

return Cycle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
-- Coin math shared by server (authoritative) and client (display only).

local Config = require(script.Parent.Parent.Config)
local Growth = require(script.Parent.Growth)

local Economy = {}

export type MultiplierInput = {
	doubleCoins: boolean,
	vip: boolean,
	club: boolean,
	adBoost: boolean,
	friends: number,
}

-- Additive bonuses (friends, club) stack together, then multiplicative boosts apply.
function Economy.coinMultiplier(input: MultiplierInput): number
	local friendBonus =
		math.min(input.friends * Config.FRIEND_BOOST_PER_FRIEND, Config.FRIEND_BOOST_MAX)
	local additive = 1 + friendBonus + (if input.club then Config.CLUB_COIN_BONUS else 0)
	local multiplier = additive
	if input.doubleCoins then
		multiplier *= Config.DOUBLE_COINS_MULTIPLIER
	end
	if input.adBoost then
		multiplier *= Config.AD_BOOST_MULTIPLIER
	end
	if input.vip then
		multiplier *= Config.VIP_COIN_MULTIPLIER
	end
	return multiplier
end

-- Coins from selling a dino.
function Economy.dinoValue(baseIncome: number, stage: number, mutationMultiplier: number): number
	return math.floor(baseIncome * 300 * Growth.SELL[math.clamp(stage, 1, 4)] * mutationMultiplier)
end

-- Coins from selling a laid egg from your tray.
function Economy.trayEggValue(baseIncome: number): number
	return math.max(1, math.floor(baseIncome * 120))
end

-- Coins earned while offline (reduced rate, capped).
function Economy.offlineCoins(incomePerSecond: number, secondsAway: number): number
	local seconds = math.clamp(secondsAway, 0, Config.OFFLINE_EARNINGS_CAP_SECONDS)
	return math.floor(incomePerSecond * seconds * Config.OFFLINE_EARNINGS_RATE)
end

-- "X minutes of your income, or the minimum" rewards (coin packs, streaks, club).
function Economy.incomeReward(incomePerSecond: number, minutes: number, minimum: number): number
	return math.max(minimum, math.floor(incomePerSecond * minutes * 60))
end

-- Cost of the next upgrade level, or nil when maxed. `owned` = levels already bought.
function Economy.nextUpgradeCost(costs: { number }, owned: number): number?
	return costs[owned + 1]
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">EggOdds</string>
            <string name="Source"><![CDATA[--!strict
-- The single source for "what are the odds for this egg right now". The server
-- rolls with these tables and the client's Odds panel displays these tables,
-- so the shown odds are always the real odds.

local Config = require(script.Parent.Parent.Config)
local DinoData = require(script.Parent.Parent.Data.DinoData)
local EggData = require(script.Parent.Parent.Data.EggData)
local MutationData = require(script.Parent.Parent.Data.MutationData)
local Cycle = require(script.Parent.Cycle)
local Odds = require(script.Parent.Odds)

local EggOdds = {}

local RARE_ORDER = DinoData.rarityInfo("Rare").order

-- Species chances (basis points, summing to exactly 10000) for an egg type.
function EggOdds.species(eggId: string, luckActive: boolean): { Odds.Chance }
	local egg = EggData.get(eggId)
	if not egg then
		return {}
	end
	local multiplier = if luckActive then Config.LUCK_MULTIPLIER else 1
	return Odds.chances(egg.odds, DinoData.rarityOrder, multiplier, RARE_ORDER)
end

-- Mutation chances for a hatch at `cycleTime` (storms change them).
function EggOdds.mutations(cycleTime: number): { MutationData.MutationChance }
	local storm = Cycle.storm(cycleTime)
	local kind: MutationData.StormKind? = if storm.active then storm.kind else nil
	return MutationData.hatchChances(kind, storm.active and storm.mega)
end

return EggOdds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
-- Number and time formatting for UI text.

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi" }

-- 950 -> "950", 12345 -> "12.3K", 4500000 -> "4.5M"
function Format.number(n: number): string
	if n ~= n then
		return "0"
	end
	local negative = n < 0
	local value = math.abs(n)
	if value < 1000 then
		local whole = if value >= 100 or value == math.floor(value)
			then string.format("%d", math.floor(value))
			else string.format("%.1f", value)
		return (if negative then "-" else "") .. whole
	end
	local index = 1
	while value >= 1000 and index < #SUFFIXES do
		value /= 1000
		index += 1
	end
	local text
	if value >= 100 then
		text = string.format("%d", math.floor(value))
	else
		text = string.format("%.1f", math.floor(value * 10) / 10)
		text = string.gsub(text, "%.0$", "")
	end
	return (if negative then "-" else "") .. text .. SUFFIXES[index]
end

-- 75 -> "1:15", 3725 -> "1:02:05"
function Format.time(seconds: number): string
	local s = math.max(0, math.ceil(seconds))
	local h = math.floor(s / 3600)
	local m = math.floor((s % 3600) / 60)
	local sec = s % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, sec)
	end
	return string.format("%d:%02d", m, sec)
end

-- 45 -> "45s", 300 -> "5m", 5400 -> "1h 30m"
function Format.duration(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	if s < 60 then
		return `{s}s`
	elseif s < 3600 then
		local m = math.floor(s / 60)
		local rest = s % 60
		return if rest > 0 then `{m}m {rest}s` else `{m}m`
	end
	local h = math.floor(s / 3600)
	local m = math.floor((s % 3600) / 60)
	return if m > 0 then `{h}h {m}m` else `{h}h`
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Frames</string>
            <string name="Source"><![CDATA[--!strict
-- Robust ways to orient a part along a direction. CFrame.lookAt is undefined
-- when the direction is straight up or down (it can produce NaN rotations),
-- which broke vertical legs, so every "point this along that" goes through here.

local Frames = {}

local X_AXIS = Vector3.new(1, 0, 0)
local Y_AXIS = Vector3.new(0, 1, 0)
local Z_AXIS = Vector3.new(0, 0, 1)

-- CFrame at `center` whose local X axis points along `direction`
-- (Roblox cylinders run along X).
function Frames.alongX(center: Vector3, direction: Vector3): CFrame
	local x = direction.Unit
	local reference = if math.abs(x.Y) > 0.99 then Z_AXIS else Y_AXIS
	local z = x:Cross(reference).Unit
	local y = z:Cross(x).Unit
	return CFrame.fromMatrix(center, x, y, z)
end

-- CFrame at `center` whose local Z axis points along `direction`
-- (stretched spheres and blocks use Z as their long axis).
function Frames.alongZ(center: Vector3, direction: Vector3): CFrame
	local z = direction.Unit
	local reference = if math.abs(z.Y) > 0.99 then X_AXIS else Y_AXIS
	local x = reference:Cross(z).Unit
	local y = z:Cross(x).Unit
	return CFrame.fromMatrix(center, x, y, z)
end

-- Facing a point on the horizontal plane (the usual "look at" for characters).
function Frames.facing(position: Vector3, target: Vector3): CFrame
	local flat = Vector3.new(target.X - position.X, 0, target.Z - position.Z)
	if flat.Magnitude < 1e-4 then
		return CFrame.new(position)
	end
	return CFrame.lookAt(position, position + flat)
end

return Frames
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Growth</string>
            <string name="Source"><![CDATA[--!strict
-- Dino growth stages. Growth is pure time math from the dino's birth time, so it
-- keeps going while the player is offline and costs nothing to simulate.
-- Pure: runs under Lune.

local Growth = {}

export type Stage = "Baby" | "Juvenile" | "Adult" | "Giant"

Growth.STAGES = { "Baby", "Juvenile", "Adult", "Giant" } :: { Stage }
Growth.BABY = 1
Growth.JUVENILE = 2
Growth.ADULT = 3
Growth.GIANT = 4

-- Per-stage multipliers (index = stage).
Growth.INCOME = { 0.25, 0.5, 1, 2 }
Growth.SIZE = { 0.45, 0.7, 1, 1.6 }
Growth.SELL = { 0.3, 0.6, 1, 2 }

-- thresholds = ages (seconds) to reach Juvenile, Adult, Giant.
function Growth.stageIndex(ageSeconds: number, thresholds: { number }): number
	local stage = 1
	for i, t in thresholds do
		if ageSeconds >= t then
			stage = i + 1
		end
	end
	return stage
end

-- Returns stage, fraction of the way to the next stage (1 at Giant), and seconds left.
function Growth.progress(ageSeconds: number, thresholds: { number }): (number, number, number)
	local stage = Growth.stageIndex(ageSeconds, thresholds)
	if stage >= #thresholds + 1 then
		return stage, 1, 0
	end
	local startAge = if stage == 1 then 0 else thresholds[stage - 1]
	local endAge = thresholds[stage]
	local span = endAge - startAge
	local fraction = if span > 0 then (ageSeconds - startAge) / span else 1
	return stage, math.clamp(fraction, 0, 1), math.max(0, endAge - ageSeconds)
end

function Growth.stageName(stage: number): Stage
	return Growth.STAGES[math.clamp(stage, 1, 4)]
end

-- Age a dino born at `bornAt` needs so that it is exactly `stage` now.
function Growth.bornAtForStage(now: number, stage: number, thresholds: { number }): number
	if stage <= 1 then
		return now
	end
	return now - thresholds[math.min(stage - 1, #thresholds)]
end

function Growth.income(baseIncome: number, stage: number, mutationMultiplier: number): number
	return baseIncome * Growth.INCOME[math.clamp(stage, 1, 4)] * mutationMultiplier
end

-- Time a dino of this stage needs between laid eggs, or nil if it doesn't lay.
function Growth.layInterval(stage: number, adultInterval: number, giantInterval: number): number?
	if stage >= Growth.GIANT then
		return giantInterval
	elseif stage == Growth.ADULT then
		return adultInterval
	end
	return nil
end

-- How many eggs a dino lays right now (at most `room`) and its new lastLaidAt.
-- Works for offline catch-up too: a full tray drops the backlog instead of
-- piling up eggs forever.
function Growth.laysDue(
	bornAt: number,
	lastLaidAt: number,
	thresholds: { number },
	now: number,
	adultInterval: number,
	giantInterval: number,
	room: number
): (number, number)
	local stage = Growth.stageIndex(now - bornAt, thresholds)
	local interval = Growth.layInterval(stage, adultInterval, giantInterval)
	if interval == nil then
		return 0, lastLaidAt
	end
	local adultAt = bornAt + thresholds[Growth.ADULT - 1]
	local last = math.max(lastLaidAt, adultAt)
	local due = math.floor((now - last) / interval)
	if due <= 0 then
		return 0, last
	end
	local laid = math.min(due, math.max(room, 0))
	if laid < due then
		return laid, now
	end
	return laid, last + laid * interval
end

return Growth
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Odds</string>
            <string name="Source"><![CDATA[--!strict
-- Egg odds math. The same function produces both the odds shown in the
-- "Odds" panel and the table the server rolls against, so displayed odds are
-- always the real odds (Roblox paid random item policy). Pure: runs under Lune.

local Odds = {}

export type Entry = { species: string, weight: number }
export type Chance = { species: string, bp: number }

Odds.TOTAL_BP = 10000

-- Scale weights to integers that sum to exactly TOTAL_BP using the largest
-- remainder method, so the percentages always add up to exactly 100%.
local function normalize(species: { string }, weights: { number }): { Chance }
	local sum = 0
	for _, w in weights do
		sum += w
	end
	local result: { Chance } = {}
	if sum <= 0 then
		return result
	end

	local floors: { number } = {}
	local remainders: { { index: number, frac: number } } = {}
	local assigned = 0
	for i, w in weights do
		local exact = w * Odds.TOTAL_BP / sum
		local f = math.floor(exact)
		floors[i] = f
		assigned += f
		table.insert(remainders, { index = i, frac = exact - f })
	end

	table.sort(remainders, function(a, b)
		if a.frac == b.frac then
			return a.index < b.index
		end
		return a.frac > b.frac
	end)

	local leftover = Odds.TOTAL_BP - assigned
	for i = 1, leftover do
		local r = remainders[((i - 1) % #remainders) + 1]
		floors[r.index] += 1
	end

	for i, name in species do
		table.insert(result, { species = name, bp = floors[i] })
	end
	return result
end

-- luckMultiplier multiplies the weight of every species whose rarity order is
-- >= luckMinRarity. Pass 1 for no luck.
function Odds.chances(
	entries: { Entry },
	rarityOf: (string) -> number,
	luckMultiplier: number,
	luckMinRarity: number
): { Chance }
	local names: { string } = {}
	local weights: { number } = {}
	for i, e in entries do
		names[i] = e.species
		local w = e.weight
		if luckMultiplier ~= 1 and rarityOf(e.species) >= luckMinRarity then
			w *= luckMultiplier
		end
		weights[i] = w
	end
	return normalize(names, weights)
end

-- r must be in [0, 1). Returns the species whose bp range contains r.
function Odds.roll(chances: { Chance }, r: number): string
	local target = math.floor(math.clamp(r, 0, 0.99999999) * Odds.TOTAL_BP)
	local cumulative = 0
	for _, c in chances do
		cumulative += c.bp
		if target < cumulative then
			return c.species
		end
	end
	return chances[#chances].species
end

-- Generic weighted pick over keys with bp values (used for mutations).
-- `none` is returned when r lands outside every listed bp range.
function Odds.pick<T>(entries: { { key: T, bp: number } }, r: number): T?
	local target = math.floor(math.clamp(r, 0, 0.99999999) * Odds.TOTAL_BP)
	local cumulative = 0
	for _, e in entries do
		cumulative += e.bp
		if target < cumulative then
			return e.key
		end
	end
	return nil
end

-- "12.5%", "0.1%", "45%"
function Odds.format(bp: number): string
	local percent = bp / 100
	if percent == math.floor(percent) then
		return string.format("%d%%", percent)
	end
	local s = string.format("%.2f", percent)
	s = string.gsub(s, "0+$", "")
	s = string.gsub(s, "%.$", "")
	return s .. "%"
end

return Odds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Rng</string>
            <string name="Source"><![CDATA[--!strict
-- Deterministic pseudo-random numbers (mulberry32). Used for things every
-- server and client must agree on without talking to each other, like which
-- storm is coming and what the egg shop has in stock. Pure: runs under Lune too.

local Rng = {}

local TWO_32 = 4294967296

local function imul(a: number, b: number): number
	local ah = bit32.rshift(a, 16)
	local al = bit32.band(a, 0xFFFF)
	local bh = bit32.rshift(b, 16)
	local bl = bit32.band(b, 0xFFFF)
	local high = bit32.band(ah * bl + al * bh, 0xFFFF)
	return (al * bl + high * 65536) % TWO_32
end

export type Generator = {
	next: () -> number,
	int: (min: number, max: number) -> number,
}

-- Mix two integers into a 32-bit seed.
function Rng.hash(a: number, b: number): number
	local h = (math.floor(a) % TWO_32 + imul(math.floor(b) % TWO_32, 0x9E3779B1)) % TWO_32
	h = bit32.bxor(h, bit32.rshift(h, 16))
	h = imul(h, 0x85EBCA6B)
	h = bit32.bxor(h, bit32.rshift(h, 13))
	h = imul(h, 0xC2B2AE35)
	h = bit32.bxor(h, bit32.rshift(h, 16))
	return h
end

function Rng.new(seed: number): Generator
	local state = math.floor(seed) % TWO_32

	local function nextFloat(): number
		state = (state + 0x6D2B79F5) % TWO_32
		local t = state
		t = imul(bit32.bxor(t, bit32.rshift(t, 15)), bit32.bor(t, 1))
		t = bit32.bxor(t, (t + imul(bit32.bxor(t, bit32.rshift(t, 7)), bit32.bor(t, 61))) % TWO_32)
		return bit32.bxor(t, bit32.rshift(t, 14)) / TWO_32
	end

	local function int(min: number, max: number): number
		return min + math.floor(nextFloat() * (max - min + 1))
	end

	return {
		next = nextFloat,
		int = int,
	}
end

return Rng
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
-- Minimal signal for module-to-module events (no Instances, no yielding).

export type Connection = { disconnect: () -> () }

export type Signal<T...> = {
	connect: (self: Signal<T...>, fn: (T...) -> ()) -> Connection,
	fire: (self: Signal<T...>, T...) -> (),
}

local Signal = {}

function Signal.new<T...>(): Signal<T...>
	local handlers: { (T...) -> () } = {}

	local self = {}

	function self.connect(_: any, fn: (T...) -> ()): Connection
		table.insert(handlers, fn)
		return {
			disconnect = function()
				local index = table.find(handlers, fn)
				if index then
					table.remove(handlers, index)
				end
			end,
		}
	end

	function self.fire(_: any, ...: T...)
		for _, fn in table.clone(handlers) do
			task.spawn(fn, ...)
		end
	end

	return (self :: any) :: Signal<T...>
end

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Streak</string>
            <string name="Source"><![CDATA[--!strict
-- 7-day login streak. Claim once per UTC day; missing a day restarts at day 1.

local Streak = {}

export type Reward = {
	kind: "coins" | "luck" | "coinBoost" | "dino",
	minutes: number?, -- coins: minutes of income
	minimum: number?, -- coins: minimum amount
	seconds: number?, -- boosts
	species: string?, -- dino
	label: string,
	emoji: string,
}

Streak.REWARDS = {
	{ kind = "coins", minutes = 10, minimum = 250, label = "Coins", emoji = "💰" },
	{ kind = "coins", minutes = 20, minimum = 1000, label = "More coins", emoji = "💰" },
	{ kind = "luck", seconds = 900, label = "15 min Luck", emoji = "🍀" },
	{ kind = "coins", minutes = 45, minimum = 5000, label = "Coin pile", emoji = "💰" },
	{ kind = "coinBoost", seconds = 1800, label = "30 min 2x Coins", emoji = "⚡" },
	{ kind = "coins", minutes = 90, minimum = 20000, label = "Coin mountain", emoji = "💰" },
	{ kind = "dino", species = "Brachiosaurus", label = "Baby Brachiosaurus!", emoji = "🦕" },
} :: { Reward }

export type State = { count: number, lastDay: number }

-- Returns whether the player can claim today and which day (1-7) they'd claim.
function Streak.status(state: State, today: number): (boolean, number)
	if state.lastDay == today then
		return false, state.count
	end
	if state.lastDay == today - 1 then
		return true, (state.count % #Streak.REWARDS) + 1
	end
	return true, 1
end

return Streak
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="32">
        <Properties>
          <string name="Name">Visual</string>
        </Properties>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">DinoModel</string>
            <string name="Source"><![CDATA[--!strict
-- Builds a chunky, cartoon dinosaur out of simple parts from the species' body
-- plan. No uploaded meshes needed, so the game works out of the box; swap in
-- real models later by replacing build().
--
-- Model space: origin on the ground under the body, facing -Z (LookVector).

local CollectionService = game:GetService("CollectionService")

local DinoData = require(script.Parent.Parent.Data.DinoData)
local MutationData = require(script.Parent.Parent.Data.MutationData)
local Frames = require(script.Parent.Parent.Util.Frames)
local Growth = require(script.Parent.Parent.Util.Growth)

local DinoModel = {}

export type Mode = "Static" | "World" | "Mount"

DinoModel.BASE_UNIT = 1.4
DinoModel.RAINBOW_TAG = "RainbowPart"
DinoModel.TAG = "Dino"

local IVORY = Color3.fromRGB(240, 235, 215)
local EYE_WHITE = Color3.fromRGB(255, 255, 255)
local PUPIL = Color3.fromRGB(25, 25, 30)
local MOUTH = Color3.fromRGB(70, 35, 35)

local function rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

type Role = "main" | "belly" | "accent" | "detail"

type Builder = {
	model: Model,
	root: BasePart,
	scale: number,
	colors: { main: Color3, belly: Color3, accent: Color3 },
	parts: { { part: BasePart, role: Role } },
}

local function newPart(b: Builder, name: string, role: Role, color: Color3): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Anchored = true
	p.CastShadow = role ~= "detail"
	p.Parent = b.model
	table.insert(b.parts, { part = p :: BasePart, role = role })
	return p
end

-- Ellipsoid of `size` (unit space) at `cf` (unit space).
local function ellipsoid(
	b: Builder,
	name: string,
	role: Role,
	color: Color3,
	size: Vector3,
	cf: CFrame
): Part
	local p = newPart(b, name, role, color)
	p.Size = size * b.scale
	p.CFrame = cf.Rotation + cf.Position * b.scale
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local function block(
	b: Builder,
	name: string,
	role: Role,
	color: Color3,
	size: Vector3,
	cf: CFrame
): Part
	local p = newPart(b, name, role, color)
	p.Size = size * b.scale
	p.CFrame = cf.Rotation + cf.Position * b.scale
	return p
end

-- Cylinder from `a` to `b` (unit space).
local function cylinder(
	bld: Builder,
	name: string,
	role: Role,
	color: Color3,
	a: Vector3,
	z: Vector3,
	thickness: number
): Part
	local p = newPart(bld, name, role, color)
	p.Shape = Enum.PartType.Cylinder
	local length = (z - a).Magnitude
	p.Size = Vector3.new(length, thickness, thickness) * bld.scale
	local mid = (a + z) / 2
	local cf = Frames.alongX(mid, z - a)
	p.CFrame = cf.Rotation + cf.Position * bld.scale
	return p
end

local function along(center: Vector3, direction: Vector3): CFrame
	return Frames.alongZ(center, direction)
end

local function addParticles(target: BasePart, color: Color3, scale: number, rate: number)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Rate = rate
	emitter.Lifetime = NumberRange.new(0.8, 1.6)
	emitter.Speed = NumberRange.new(0.5, 1.5)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35 * scale),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Parent = target
end

local function applyMutation(b: Builder, mutation: string?)
	if mutation == nil then
		return
	end
	local body = b.model:FindFirstChild("Body")
	for _, entry in b.parts do
		local p = entry.part
		if entry.role == "detail" then
			continue
		end
		if mutation == "Glossy" then
			p.Reflectance = 0.3
			p.Color = p.Color:Lerp(Color3.new(1, 1, 1), 0.15)
		elseif mutation == "Lava" then
			if entry.role == "main" then
				p.Color = Color3.fromRGB(60, 22, 18)
			elseif entry.role == "belly" then
				p.Color = Color3.fromRGB(255, 120, 30)
				p.Material = Enum.Material.Neon
			else
				p.Color = Color3.fromRGB(255, 80, 20)
				p.Material = Enum.Material.Neon
			end
		elseif mutation == "Frost" then
			if entry.role == "main" then
				p.Color = Color3.fromRGB(170, 220, 255)
				p.Material = Enum.Material.Ice
			elseif entry.role == "belly" then
				p.Color = Color3.fromRGB(240, 250, 255)
			else
				p.Color = Color3.fromRGB(110, 180, 255)
				p.Material = Enum.Material.Glass
			end
		elseif mutation == "Cosmic" then
			if entry.role == "main" then
				p.Color = Color3.fromRGB(55, 30, 110)
			elseif entry.role == "belly" then
				p.Color = Color3.fromRGB(150, 90, 255)
				p.Material = Enum.Material.Neon
			else
				p.Color = Color3.fromRGB(255, 255, 255)
				p.Material = Enum.Material.Neon
			end
		elseif mutation == "Rainbow" then
			p.Reflectance = 0.1
			if entry.role == "main" or entry.role == "accent" then
				CollectionService:AddTag(p, DinoModel.RAINBOW_TAG)
			end
		end
	end
	if body and body:IsA("BasePart") then
		local m = MutationData.get(mutation)
		if m and mutation ~= "Glossy" then
			addParticles(body, rgb(m.color), b.scale, 6)
		elseif mutation == "Glossy" then
			addParticles(body, Color3.fromRGB(255, 255, 220), b.scale, 2)
		end
	end
end

local function buildBody(b: Builder, species: DinoData.Species, stage: number)
	local plan = species.plan
	local c = b.colors
	local bw, bh, bl = plan.body[1], plan.body[2], plan.body[3]
	local hw, hh, hl = plan.head[1], plan.head[2], plan.head[3]
	local legH = plan.legHeight
	local lt = plan.legThickness
	local tailLength = plan.tailLength
	local tt = plan.tailThickness
	local neckLength = plan.neckLength

	-- Babies: bigger heads, shorter legs and tails = cuter.
	if stage == Growth.BABY then
		hw, hh, hl = hw * 1.35, hh * 1.35, hl * 1.25
		legH *= 0.85
		tailLength *= 0.8
		neckLength *= 0.85
	end

	local bodyCenter = Vector3.new(0, legH + bh * 0.42, 0)

	-- Body + belly
	ellipsoid(b, "Body", "main", c.main, Vector3.new(bw, bh, bl), CFrame.new(bodyCenter))
	ellipsoid(
		b,
		"Belly",
		"belly",
		c.belly,
		Vector3.new(bw * 0.86, bh * 0.72, bl * 0.86),
		CFrame.new(bodyCenter + Vector3.new(0, -bh * 0.16, 0))
	)

	-- Legs
	if plan.kind == "biped" or plan.kind == "flyer" then
		for _, side in { -1, 1 } do
			local x = side * bw * 0.32
			if plan.kind == "biped" then
				ellipsoid(
					b,
					"Thigh",
					"main",
					c.main,
					Vector3.new(lt * 1.3, legH * 0.8, lt * 1.7),
					CFrame.new(x, legH * 0.68, bl * 0.1)
				)
			end
			cylinder(
				b,
				"Shin",
				"main",
				c.main,
				Vector3.new(x, legH * 0.62, bl * 0.16),
				Vector3.new(x, 0.1, bl * 0.18),
				lt
			)
			block(
				b,
				"Foot",
				"accent",
				c.accent,
				Vector3.new(lt * 1.25, math.max(lt * 0.4, 0.15), lt * 1.9),
				CFrame.new(x, math.max(lt * 0.2, 0.08), bl * 0.18 - lt * 0.45)
			)
		end
	elseif plan.kind == "quad" then
		for _, side in { -1, 1 } do
			for _, front in { -1, 1 } do
				local x = side * bw * 0.33
				local z = front * bl * 0.3
				cylinder(
					b,
					"Leg",
					"main",
					c.main,
					Vector3.new(x, legH + bh * 0.25, z),
					Vector3.new(x, 0.1, z),
					lt
				)
				cylinder(
					b,
					"Toe",
					"accent",
					c.accent,
					Vector3.new(x, 0.25, z),
					Vector3.new(x, 0, z),
					lt * 1.15
				)
			end
		end
	end

	-- Little arms
	if plan.arms then
		for _, side in { -1, 1 } do
			local shoulder = bodyCenter + Vector3.new(side * bw * 0.4, -bh * 0.05, -bl * 0.3)
			local hand = shoulder + Vector3.new(side * 0.05, -legH * 0.35, -legH * 0.18)
			cylinder(b, "Arm", "main", c.main, shoulder, hand, math.max(lt * 0.45, 0.15))
		end
	end

	-- Neck + head placement
	local headCenter: Vector3
	if neckLength > 0.05 then
		local angle = math.rad(plan.neckAngle)
		local dir = Vector3.new(0, math.sin(angle), -math.cos(angle))
		local neckStart = bodyCenter + Vector3.new(0, bh * 0.2, -bl * 0.38)
		local neckEnd = neckStart + dir * neckLength
		local mid = (neckStart + neckEnd) / 2
		ellipsoid(
			b,
			"Neck",
			"main",
			c.main,
			Vector3.new(plan.neckThickness, plan.neckThickness, neckLength + plan.neckThickness),
			along(mid, dir)
		)
		headCenter = neckEnd + Vector3.new(0, hh * 0.15, -hl * 0.3)
	else
		headCenter = bodyCenter + Vector3.new(0, bh * 0.2, -(bl * 0.5 + hl * 0.3))
	end

	-- Head
	ellipsoid(b, "Head", "main", c.main, Vector3.new(hw, hh, hl), CFrame.new(headCenter))
	ellipsoid(
		b,
		"Snout",
		"belly",
		c.belly,
		Vector3.new(hw * 0.78, hh * 0.55, hl * 0.6),
		CFrame.new(headCenter + Vector3.new(0, -hh * 0.18, -hl * 0.36))
	)
	block(
		b,
		"Mouth",
		"detail",
		MOUTH,
		Vector3.new(hw * 0.6, 0.05, hl * 0.4),
		CFrame.new(headCenter + Vector3.new(0, -hh * 0.3, -hl * 0.42))
	)
	for _, side in { -1, 1 } do
		local eyeSize = hh * 0.36
		local eye = ellipsoid(
			b,
			"Eye",
			"detail",
			EYE_WHITE,
			Vector3.new(eyeSize, eyeSize, eyeSize),
			CFrame.new(headCenter + Vector3.new(side * hw * 0.36, hh * 0.16, -hl * 0.12))
		)
		eye.Material = Enum.Material.SmoothPlastic
		local pupilSize = hh * 0.2
		ellipsoid(
			b,
			"Pupil",
			"detail",
			PUPIL,
			Vector3.new(pupilSize, pupilSize, pupilSize),
			CFrame.new(headCenter + Vector3.new(side * hw * 0.46, hh * 0.18, -hl * 0.18))
		)
	end

	-- Tail (two tapering segments)
	local tailStart = bodyCenter + Vector3.new(0, 0, bl * 0.38)
	local dir1 = Vector3.new(0, -0.12, 1).Unit
	local len1 = tailLength * 0.55
	ellipsoid(
		b,
		"Tail",
		"main",
		c.main,
		Vector3.new(tt, tt * 0.9, len1),
		along(tailStart + dir1 * len1 * 0.45, dir1)
	)
	local seg2Start = tailStart + dir1 * len1 * 0.85
	local dir2 = Vector3.new(0, 0.05, 1).Unit
	local len2 = tailLength * 0.5
	ellipsoid(
		b,
		"TailTip",
		"main",
		c.main,
		Vector3.new(tt * 0.55, tt * 0.5, len2),
		along(seg2Start + dir2 * len2 * 0.45, dir2)
	)
	local tailEnd = seg2Start + dir2 * len2 * 0.9

	-- Species features
	for _, feature in plan.features do
		if feature == "stripes" then
			for _, k in { -0.18, 0.04, 0.24 } do
				local shrink = math.sqrt(math.max(0, 1 - (2 * k) ^ 2)) * 1.03
				ellipsoid(
					b,
					"Stripe",
					"accent",
					c.accent,
					Vector3.new(bw * shrink, bh * shrink, bl * 0.09),
					CFrame.new(bodyCenter + Vector3.new(0, 0, k * bl))
				)
			end
		elseif feature == "plates" then
			for i = 1, 5 do
				local k = -0.32 + (i - 1) * 0.16
				local top = bh * 0.5 * math.sqrt(math.max(0, 1 - (2 * k) ^ 2))
				local p = bh * 0.5 * (1 - math.abs(k) * 1.1)
				block(
					b,
					"Plate",
					"accent",
					c.accent,
					Vector3.new(0.14, p, p),
					CFrame.new(bodyCenter + Vector3.new(0, top + p * 0.15, k * bl))
						* CFrame.Angles(math.rad(45), 0, 0)
				)
			end
		elseif feature == "spikes" then
			for _, side in { -1, 1 } do
				for _, offset in { 0, 0.35 } do
					local base = tailEnd - dir2 * len2 * offset
					cylinder(
						b,
						"Spike",
						"accent",
						IVORY,
						base,
						base + Vector3.new(side * tt * 1.1, tt * 0.7, 0),
						tt * 0.18
					)
				end
			end
		elseif feature == "club" then
			ellipsoid(
				b,
				"Club",
				"accent",
				c.accent,
				Vector3.new(tt * 1.7, tt * 1.2, tt * 1.5),
				CFrame.new(tailEnd)
			)
		elseif feature == "frill" then
			local frill = block(
				b,
				"Frill",
				"accent",
				c.accent,
				Vector3.new(0.15, hh * 2.3, hh * 2.3),
				CFrame.new(headCenter + Vector3.new(0, hh * 0.45, hl * 0.35))
					* CFrame.Angles(math.rad(-20), math.rad(90), 0)
			)
			frill.Shape = Enum.PartType.Cylinder
		elseif feature == "horns" then
			for _, side in { -1, 1 } do
				local base = headCenter + Vector3.new(side * hw * 0.28, hh * 0.38, -hl * 0.1)
				cylinder(
					b,
					"Horn",
					"detail",
					IVORY,
					base,
					base + Vector3.new(0, 0.55, -0.75) * hh,
					hh * 0.17
				)
			end
			local noseBase = headCenter + Vector3.new(0, hh * 0.15, -hl * 0.5)
			cylinder(
				b,
				"Horn",
				"detail",
				IVORY,
				noseBase,
				noseBase + Vector3.new(0, 0.45, -0.25) * hh,
				hh * 0.14
			)
		elseif feature == "crest" then
			local dir = Vector3.new(0, 0.45, 1)
			ellipsoid(
				b,
				"Crest",
				"accent",
				c.accent,
				Vector3.new(hw * 0.3, hw * 0.3, hl * 1.4),
				along(headCenter + Vector3.new(0, hh * 0.55, hl * 0.5), dir)
			)
		elseif feature == "dome" then
			ellipsoid(
				b,
				"Dome",
				"accent",
				c.accent,
				Vector3.new(hw * 1.05, hh * 0.78, hl * 0.78),
				CFrame.new(headCenter + Vector3.new(0, hh * 0.38, hl * 0.05))
			)
		elseif feature == "doubleCrest" then
			for _, side in { -1, 1 } do
				ellipsoid(
					b,
					"Crest",
					"accent",
					c.accent,
					Vector3.new(0.08, hh * 0.65, hl * 0.85),
					CFrame.new(headCenter + Vector3.new(side * hw * 0.18, hh * 0.5, -hl * 0.05))
				)
			end
		elseif feature == "wings" then
			local span = bl * 2.2
			for _, side in { -1, 1 } do
				ellipsoid(
					b,
					"Wing",
					"accent",
					c.accent,
					Vector3.new(span, 0.12, bl * 0.9),
					CFrame.new(
						bodyCenter + Vector3.new(side * (bw * 0.45 + span * 0.45), bh * 0.15, 0)
					) * CFrame.Angles(0, 0, math.rad(side * 12))
				)
			end
		elseif feature == "beakCrest" then
			ellipsoid(
				b,
				"BeakCrest",
				"accent",
				c.accent,
				Vector3.new(hw * 0.25, hh * 0.8, hl * 0.9),
				along(headCenter + Vector3.new(0, hh * 0.35, hl * 0.6), Vector3.new(0, 0.5, 1))
			)
		elseif feature == "flippers" then
			for _, side in { -1, 1 } do
				for _, front in { -1, 1 } do
					ellipsoid(
						b,
						"Flipper",
						"accent",
						c.accent,
						Vector3.new(bw * 0.9, 0.15, bw * 0.45),
						CFrame.new(
							bodyCenter + Vector3.new(side * bw * 0.6, -bh * 0.3, front * bl * 0.28)
						)
							* CFrame.Angles(0, math.rad(front * side * 20), math.rad(side * -10))
					)
				end
			end
		elseif feature == "tailFin" then
			ellipsoid(
				b,
				"TailFin",
				"accent",
				c.accent,
				Vector3.new(0.12, tt * 2.2, tt * 1.6),
				CFrame.new(tailEnd + Vector3.new(0, tt * 0.2, 0))
			)
		elseif feature == "teeth" then
			for i = 1, 5 do
				local x = (-0.3 + (i - 1) * 0.15) * hw
				block(
					b,
					"Tooth",
					"detail",
					IVORY,
					Vector3.new(hw * 0.08, hh * 0.14, hw * 0.08),
					CFrame.new(headCenter + Vector3.new(x, -hh * 0.36, -hl * 0.6))
				)
			end
		elseif feature == "sail" then
			local sailH = bh * 1.4
			ellipsoid(
				b,
				"Sail",
				"accent",
				c.accent,
				Vector3.new(0.12, sailH, bl * 0.75),
				CFrame.new(bodyCenter + Vector3.new(0, bh * 0.45 + sailH * 0.25, 0))
			)
		end
	end
end

-- Builds a dino model. `stage` is 1-4 (Baby..Giant).
--   Static: every part anchored (UI previews)
--   World: root anchored, everything else welded to it (move the root to move the dino)
--   Mount: nothing anchored, welded to the root; caller welds the root to a character
function DinoModel.build(speciesId: string, stage: number, mutation: string?, mode: Mode): Model
	local species = DinoData.get(speciesId)
	assert(species, `unknown species {speciesId}`)
	stage = math.clamp(stage, 1, 4)
	local scale = species.scale * Growth.SIZE[stage] * DinoModel.BASE_UNIT

	local model = Instance.new("Model")
	model.Name = species.name

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.Size = Vector3.new(species.plan.body[1], 0.2, species.plan.body[3]) * scale
	root.CFrame = CFrame.new(0, 0.1, 0)
	root.Parent = model
	model.PrimaryPart = root

	local b: Builder = {
		model = model,
		root = root,
		scale = scale,
		colors = {
			main = rgb(species.colors.main),
			belly = rgb(species.colors.belly),
			accent = rgb(species.colors.accent),
		},
		parts = {},
	}

	buildBody(b, species, stage)
	applyMutation(b, mutation)

	-- Prompt anchor at chest height
	local top = 0
	for _, entry in b.parts do
		local p = entry.part
		top = math.max(top, p.CFrame.Position.Y + p.Size.Y / 2)
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "PromptAttachment"
	attachment.CFrame = CFrame.new(0, top * 0.55, 0)
	attachment.Parent = root
	local labelAttachment = Instance.new("Attachment")
	labelAttachment.Name = "LabelAttachment"
	labelAttachment.CFrame = CFrame.new(0, top + 1, 0)
	labelAttachment.Parent = root
	model:SetAttribute("Height", top)

	if mode ~= "Static" then
		for _, entry in b.parts do
			local p = entry.part
			p.Massless = true
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = p
			weld.Parent = p
			p.Anchored = false
		end
		root.Anchored = mode == "World"
		root.Massless = mode == "Mount"
	end

	return model
end

return DinoModel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">EggModel</string>
            <string name="Source"><![CDATA[--!strict
-- Builds spotted eggs from simple parts. Same model-space rules as DinoModel:
-- origin on the ground, root part named "Root".

local DinoData = require(script.Parent.Parent.Data.DinoData)
local EggData = require(script.Parent.Parent.Data.EggData)

local EggModel = {}

export type Look = {
	main: Color3,
	spots: Color3,
	material: Enum.Material,
	glow: boolean,
}

local function rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

local GIFT_LOOK: Look = {
	main = Color3.fromRGB(255, 205, 60),
	spots = Color3.fromRGB(255, 255, 255),
	material = Enum.Material.SmoothPlastic,
	glow = true,
}

function EggModel.lookForShopEgg(eggTypeId: string): Look
	local egg = EggData.get(eggTypeId)
	assert(egg, `unknown egg {eggTypeId}`)
	local material = Enum.Material.SmoothPlastic
	if egg.material == "Glass" then
		material = Enum.Material.Glass
	elseif egg.material == "Neon" then
		material = Enum.Material.Neon
	end
	return {
		main = rgb(egg.colors.main),
		spots = rgb(egg.colors.spots),
		material = material,
		glow = egg.id == "Volcano" or egg.id == "Crystal",
	}
end

function EggModel.lookForSpecies(speciesId: string): Look
	local species = DinoData.get(speciesId)
	assert(species, `unknown species {speciesId}`)
	return {
		main = rgb(species.colors.belly),
		spots = rgb(species.colors.main),
		material = Enum.Material.SmoothPlastic,
		glow = false,
	}
end

function EggModel.giftLook(): Look
	return GIFT_LOOK
end

-- `size` is the egg height in studs. Root is anchored; other parts are welded
-- to it unless `static` is true (then everything is anchored).
function EggModel.build(look: Look, size: number, static: boolean?): Model
	local model = Instance.new("Model")
	model.Name = "Egg"

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.Size = Vector3.new(size * 0.6, 0.1, size * 0.6)
	root.CFrame = CFrame.new(0, 0.05, 0)
	root.Parent = model
	model.PrimaryPart = root

	local parts: { BasePart } = {}

	local function make(name: string, color: Color3, partSize: Vector3, position: Vector3): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Color = color
		p.Material = look.material
		p.Size = partSize
		p.CFrame = CFrame.new(position)
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
		p.Parent = model
		table.insert(parts, p)
		return p
	end

	local a, b = size * 0.38, size * 0.5 -- radii (width, height)
	local center = Vector3.new(0, b, 0)
	local shell = make("Shell", look.main, Vector3.new(a * 2, b * 2, a * 2), center)
	if look.material == Enum.Material.Glass then
		shell.Transparency = 0.25
		local core = make("Core", look.spots, Vector3.new(a, b, a), center)
		core.Material = Enum.Material.Neon
	end

	-- Spots on the shell surface at fixed angles (deterministic look).
	local spotAngles = {
		{ 0.4, 1.0 },
		{ 1.9, 0.7 },
		{ 3.1, 1.3 },
		{ 4.3, 0.9 },
		{ 5.4, 1.6 },
		{ 2.6, 2.1 },
		{ 0.9, 2.3 },
	}
	for _, angles in spotAngles do
		local theta, phi = angles[1], angles[2]
		local position = center
			+ Vector3.new(
				a * math.cos(theta) * math.sin(phi),
				b * math.cos(phi),
				a * math.sin(theta) * math.sin(phi)
			)
		local spotSize = size * 0.16
		local spot = make("Spot", look.spots, Vector3.new(spotSize, spotSize, spotSize), position)
		if look.glow then
			spot.Material = Enum.Material.Neon
		end
	end

	if not static then
		for _, p in parts do
			p.Massless = true
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = p
			weld.Parent = p
			p.Anchored = false
		end
	end

	return model
end

return EggModel
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="35">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="36">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Raise a Dino server entry point. Two-phase bootstrap: init() every system,
-- then start() every system (see docs: roblox-architecture).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

-- Remotes must exist before any system registers handlers in init().
Net.serverInit()

local Systems = script:WaitForChild("Systems")

type System = {
	init: (() -> ())?,
	start: (() -> ())?,
}

local loaded: { [string]: System } = {}
local order: { string } = {}
for _, child in Systems:GetChildren() do
	if child:IsA("ModuleScript") then
		loaded[child.Name] = require(child) :: any
		table.insert(order, child.Name)
	end
end
table.sort(order)

for _, name in order do
	local system = loaded[name]
	if system.init then
		system.init()
	end
end

for _, name in order do
	local system = loaded[name]
	if system.start then
		task.spawn(system.start)
	end
end

print("[RaiseADino] server started")
]]></string>
      </Properties>
      <Item class="Folder" referent="37">
        <Properties>
          <string name="Name">Lib</string>
        </Properties>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Build</string>
            <string name="Source"><![CDATA[--!strict
-- Part-building helpers for the generated world. Every part is anchored and
-- smooth. Purely decorative parts can skip touch/query work (`decor`) and small
-- ones can skip shadows, which keeps a part-built island cheap on phones.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Frames = require(ReplicatedStorage.Shared.Util.Frames)

local Build = {}

export type Options = {
	name: string?,
	material: Enum.Material?,
	transparency: number?,
	reflectance: number?,
	collide: boolean?, -- default true
	shadow: boolean?, -- default true
	decor: boolean?, -- no Touched events or raycasts
}

local function finish(p: BasePart, color: Color3, parent: Instance, options: Options?): ()
	p.Anchored = true
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if options then
		if options.name then
			p.Name = options.name
		end
		if options.material then
			p.Material = options.material
		end
		if options.transparency then
			p.Transparency = options.transparency
		end
		if options.reflectance then
			p.Reflectance = options.reflectance
		end
		if options.collide == false then
			p.CanCollide = false
		end
		if options.shadow == false then
			p.CastShadow = false
		end
		if options.decor then
			p.CanTouch = false
			p.CanQuery = false
		end
	end
	p.Parent = parent
end

function Build.block(
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	parent: Instance,
	options: Options?
): Part
	local p = Instance.new("Part")
	p.Name = "Block"
	p.Size = size
	p.CFrame = cframe
	finish(p, color, parent, options)
	return p
end

-- Wedge: the slope rises toward -Z (front), full height at the back (+Z).
function Build.wedge(
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	parent: Instance,
	options: Options?
): WedgePart
	local p = Instance.new("WedgePart")
	p.Name = "Wedge"
	p.Size = size
	p.CFrame = cframe
	finish(p, color, parent, options)
	return p
end

function Build.ball(
	diameter: number,
	position: Vector3,
	color: Color3,
	parent: Instance,
	options: Options?
): Part
	local p = Instance.new("Part")
	p.Name = "Ball"
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(diameter, diameter, diameter)
	p.CFrame = CFrame.new(position)
	finish(p, color, parent, options)
	return p
end

-- Stretched sphere (a sphere mesh fills the part's box).
function Build.ellipsoid(
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	parent: Instance,
	options: Options?
): Part
	local p = Instance.new("Part")
	p.Name = "Ellipsoid"
	p.Size = size
	p.CFrame = cframe
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	finish(p, color, parent, options)
	return p
end

-- Upright cylinder centred on `cframe` (Roblox cylinders run along X, so this
-- turns X onto the frame's Y axis).
function Build.disc(
	diameter: number,
	height: number,
	cframe: CFrame,
	color: Color3,
	parent: Instance,
	options: Options?
): Part
	local p = Instance.new("Part")
	p.Name = "Disc"
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(height, diameter, diameter)
	p.CFrame = cframe * CFrame.Angles(0, 0, math.rad(90))
	finish(p, color, parent, options)
	return p
end

-- Cylinder from point a to point b.
function Build.rod(
	a: Vector3,
	b: Vector3,
	diameter: number,
	color: Color3,
	parent: Instance,
	options: Options?
): Part
	local p = Instance.new("Part")
	p.Name = "Rod"
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new((b - a).Magnitude, diameter, diameter)
	p.CFrame = Frames.alongX((a + b) / 2, b - a)
	finish(p, color, parent, options)
	return p
end

-- Flat-topped bar from a to b (its up side stays as close to world-up as it can).
function Build.beam(
	a: Vector3,
	b: Vector3,
	width: number,
	thickness: number,
	color: Color3,
	parent: Instance,
	options: Options?
): Part
	local p = Instance.new("Part")
	p.Name = "Beam"
	p.Size = Vector3.new(width, thickness, (b - a).Magnitude)
	p.CFrame = Frames.alongZ((a + b) / 2, b - a)
	finish(p, color, parent, options)
	return p
end

-- Flat ring of blocks around `center` (an upright frame), e.g. a circular path.
function Build.ring(
	center: CFrame,
	radius: number,
	width: number,
	height: number,
	segments: number,
	color: Color3,
	parent: Instance,
	options: Options?
): { Part }
	local parts = {}
	local step = 2 * math.pi / segments
	-- Segment length covering the outer edge so neighbours meet without gaps.
	local length = 2 * (radius + width / 2) * math.tan(step / 2) + 0.05
	for i = 0, segments - 1 do
		local angle = i * step
		local cf = center * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -radius)
		table.insert(
			parts,
			Build.block(Vector3.new(length, height, width), cf, color, parent, options)
		)
	end
	return parts
end

-- Ground position on a circle (angle 0 points along +Z, matching the plots).
function Build.polar(angle: number, radius: number, y: number?): Vector3
	return Vector3.new(math.sin(angle) * radius, y or 0, math.cos(angle) * radius)
end

function Build.model(name: string, parent: Instance?): Model
	local m = Instance.new("Model")
	m.Name = name
	if parent then
		m.Parent = parent
	end
	return m
end

return Build
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Island</string>
            <string name="Source"><![CDATA[--!strict
-- Builds the island scenery: layered coastline (grass, beach, foam, shallows),
-- paths, the central plaza with the egg-shop tent, the volcano, scattered
-- cartoon props, palms, clouds and little islands on the horizon.
-- Nests (plots) are built by World; this module only needs to know where they
-- are so props stay out of them.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local EggData = require(ReplicatedStorage.Shared.Data.EggData)
local EggModel = require(ReplicatedStorage.Shared.Visual.EggModel)
local DinoModel = require(ReplicatedStorage.Shared.Visual.DinoModel)
local Palette = require(ReplicatedStorage.Shared.Palette)
local Rng = require(ReplicatedStorage.Shared.Util.Rng)
local Build = require(script.Parent.Build)
local Props = require(script.Parent.Props)

local Island = {}

local TAU = 2 * math.pi
local PLOT_ANGLE = TAU / Config.PLOT_COUNT
local HALF = Config.PLOT_SIZE / 2

Island.LAND_RADIUS = 184
Island.PLAZA_RADIUS = 40
Island.RING_PATH_RADIUS = 86
Island.GATE_RADIUS = Config.PLOT_RING_RADIUS - HALF
Island.VOLCANO_ANGLE = PLOT_ANGLE / 2
Island.VOLCANO_POSITION = Build.polar(PLOT_ANGLE / 2, 205)
Island.VOLCANO_RADIUS = 46
Island.SHOP_RADIUS = 15

local GROUND = { decor = true }
local FLAT = { decor = true, shadow = false }

type Land = { center: Vector3, radius: number }

-- ===== Coastline =====

local function lands(): { Land }
	local list: { Land } = { { center = Vector3.zero, radius = Island.LAND_RADIUS } }
	local gen = Rng.new(7)
	-- Uneven bumps (a few big peninsulas, some small coves) keep the coast
	-- from looking like a stamped flower.
	local bumps = 13
	for i = 0, bumps - 1 do
		local angle = i * (TAU / bumps) + (gen.next() - 0.5) * 0.32
		local big = gen.next() < 0.3
		local radius = if big then 44 + gen.next() * 16 else 20 + gen.next() * 18
		local distance = Island.LAND_RADIUS - radius * 0.3 + (gen.next() - 0.3) * 16
		table.insert(list, { center = Build.polar(angle, distance), radius = radius })
	end
	-- the volcano needs solid ground under it
	table.insert(list, { center = Island.VOLCANO_POSITION, radius = Island.VOLCANO_RADIUS + 12 })
	return list
end

-- Layers from the water up; each land disc is drawn in every layer so the
-- coastline keeps its bumps. Higher layers always win, so overlaps never fight.
local LAYERS = {
	{ name = "DeepShallows", grow = 70, top = -1.98, thick = 0.2, color = Palette.water },
	{ name = "Shallows", grow = 30, top = -1.9, thick = 0.2, color = Palette.shallows },
	{ name = "Foam", grow = 13, top = -1.8, thick = 0.2, color = Palette.foam },
	{ name = "Beach", grow = 10, top = -0.9, thick = 2, color = Palette.sand },
	{ name = "GrassLip", grow = 1.6, top = -0.3, thick = 6, color = Palette.grassDark },
	{ name = "Grass", grow = 0, top = 0, thick = 6, color = Palette.grass },
}

local function buildCoast(map: Instance, landList: { Land }, extraGrow: number?)
	local folder = Instance.new("Folder")
	folder.Name = "Coast"
	for _, layer in LAYERS do
		for _, land in landList do
			local diameter = 2 * (land.radius + layer.grow + (extraGrow or 0))
			Build.disc(
				diameter,
				layer.thick,
				CFrame.new(land.center.X, layer.top - layer.thick / 2, land.center.Z),
				layer.color,
				folder,
				{ name = layer.name, decor = true, shadow = layer.thick > 1 }
			)
		end
	end
	folder.Parent = map
end

local function buildOcean(map: Instance)
	Build.block(
		Vector3.new(4000, 2, 4000),
		CFrame.new(0, -3.05, 0),
		Palette.waterDeep,
		map,
		{ name = "Ocean", decor = true, shadow = false, reflectance = 0.06 }
	)
end

-- ===== Paths =====

local function buildPaths(map: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "Paths"
	local inner = Island.PLAZA_RADIUS - 4
	local outer = Island.GATE_RADIUS + 1
	for i = 0, Config.PLOT_COUNT - 1 do
		local angle = i * PLOT_ANGLE
		local a = Build.polar(angle, inner)
		local b = Build.polar(angle, outer)
		Build.beam(
			a + Vector3.new(0, -0.09, 0),
			b + Vector3.new(0, -0.09, 0),
			12.5,
			0.3,
			Palette.pathEdge,
			folder,
			FLAT
		)
		Build.beam(
			a + Vector3.new(0, -0.03, 0),
			b + Vector3.new(0, -0.03, 0),
			10,
			0.3,
			Palette.path,
			folder,
			FLAT
		)
	end
	local center = CFrame.new(0, -0.09, 0)
	Build.ring(center, Island.RING_PATH_RADIUS, 11, 0.3, 64, Palette.pathEdge, folder, FLAT)
	Build.ring(
		center + Vector3.new(0, 0.06, 0),
		Island.RING_PATH_RADIUS,
		8.5,
		0.3,
		64,
		Palette.path,
		folder,
		FLAT
	)
	folder.Parent = map
end

-- A trail of dino footprints from the plaza toward the volcano.
local function buildFootprints(map: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "Footprints"
	local angle = Island.VOLCANO_ANGLE
	local outward = Build.polar(angle, 1)
	local side = Vector3.new(outward.Z, 0, -outward.X)
	local facing = angle + math.pi
	local step = 0
	for r = Island.PLAZA_RADIUS + 6, 150, 5.5 do
		if math.abs(r - Island.RING_PATH_RADIUS) > 8 then
			local offset = if step % 2 == 0 then 1.4 else -1.4
			local p = Build.polar(angle, r, 0.06) + side * offset
			Props.footprint(p, facing, 1, Palette.grassDeep, folder)
		end
		step += 1
	end
	folder.Parent = map
end

-- ===== Plaza + egg shop =====

local function stripedPillar(a: Vector3, b: Vector3, parent: Instance)
	local stripes = 6
	for i = 0, stripes - 1 do
		local p0 = a:Lerp(b, i / stripes)
		local p1 = a:Lerp(b, (i + 1) / stripes)
		Build.rod(p0, p1, 1.3, if i % 2 == 0 then Palette.red else Palette.white, parent)
	end
end

-- Candy-striped tent roof: a cone of alternating wedges with a scalloped rim.
local function tent(center: Vector3, radius: number, height: number, parent: Instance)
	local segments = 16
	local width = 2 * radius * math.sin(math.pi / segments) + 0.4
	for i = 0, segments - 1 do
		local angle = i * (TAU / segments)
		local cf = CFrame.new(center)
			* CFrame.Angles(0, angle, 0)
			* CFrame.new(0, height / 2, -radius / 2)
		Build.wedge(
			Vector3.new(width, height, radius),
			cf,
			if i % 2 == 0 then Palette.red else Palette.white,
			parent,
			{ name = "Roof" }
		)
		local rim = Build.polar(angle + math.pi, radius - 0.3, center.Y - 0.2)
		Build.ball(2.3, rim, if i % 2 == 0 then Palette.white else Palette.red, parent, FLAT)
	end
end

local function buildHub(map: Instance)
	local hub = Build.model("Hub", map)
	local plazaTop = 0.3
	Build.disc(
		Island.PLAZA_RADIUS * 2,
		1,
		CFrame.new(0, plazaTop - 0.5, 0),
		Palette.plaza,
		hub,
		{ name = "Plaza" }
	)
	Build.ring(CFrame.new(0, plazaTop - 0.02, 0), 26, 2.2, 0.1, 48, Palette.plazaDark, hub, FLAT)
	Build.ring(CFrame.new(0, plazaTop - 0.02, 0), 18.5, 1.4, 0.1, 40, Palette.plazaDark, hub, FLAT)
	Build.ring(
		CFrame.new(0, plazaTop + 0.1, 0),
		Island.PLAZA_RADIUS,
		1.4,
		0.8,
		64,
		Palette.stone,
		hub,
		FLAT
	)

	-- planters and lamps between the paths
	local gen = Rng.new(11)
	for i = 0, Config.PLOT_COUNT - 1 do
		local angle = (i + 0.5) * PLOT_ANGLE
		local planter = Build.polar(angle, 31, plazaTop)
		Build.disc(
			7.5,
			1.6,
			CFrame.new(planter + Vector3.new(0, 0.8, 0)),
			Palette.stone,
			hub,
			GROUND
		)
		Build.disc(
			6.4,
			0.3,
			CFrame.new(planter + Vector3.new(0, 1.55, 0)),
			Palette.dirtDark,
			hub,
			FLAT
		)
		Props.flowers(planter + Vector3.new(0, 1.6, 0), 1.15, gen, hub)
		Props.lamp(Build.polar(angle, 37.5, plazaTop), 1, hub)
	end

	-- the shop: stone base, round counter, striped pillars, candy tent
	local baseTop = plazaTop + 1
	Build.disc(
		25,
		1,
		CFrame.new(0, baseTop - 0.5, 0),
		Palette.stoneLight,
		hub,
		{ name = "ShopBase" }
	)
	local counterTop = baseTop + 3.6
	Build.disc(18, 3, CFrame.new(0, baseTop + 1.5, 0), Palette.wood, hub, { name = "Counter" })
	Build.disc(18.4, 0.8, CFrame.new(0, baseTop + 1.7, 0), Palette.red, hub, FLAT)
	Build.disc(
		19.6,
		0.6,
		CFrame.new(0, counterTop - 0.3, 0),
		Palette.woodLight,
		hub,
		{ name = "CounterTop" }
	)
	for i, egg in EggData.LIST do
		local angle = math.rad(45) + (i - 1) * (TAU / #EggData.LIST)
		local model = EggModel.build(EggModel.lookForShopEgg(egg.id), 2.8, true)
		model.Name = egg.id .. "Display"
		model:PivotTo(CFrame.new(Build.polar(angle, 6.6, counterTop)))
		model.Parent = hub
	end
	local rimY = counterTop + 9.5
	for i = 0, 3 do
		local angle = i * (TAU / 4)
		local foot = Build.polar(angle, 8.6, counterTop)
		stripedPillar(foot, foot + Vector3.new(0, rimY + 3 - counterTop, 0), hub)
	end
	tent(Vector3.new(0, rimY, 0), Island.SHOP_RADIUS, 9, hub)
	-- a giant spotted egg crowns the tent, with a baby dino on top
	Build.disc(6.4, 1.4, CFrame.new(0, rimY + 8.2, 0), Palette.yellow, hub, { decor = true })
	local eggCenter = Vector3.new(0, rimY + 9 + 3.2, 0)
	Build.ellipsoid(
		Vector3.new(6.4, 8, 6.4),
		CFrame.new(eggCenter),
		Palette.cream,
		hub,
		{ name = "BigEgg" }
	)
	for i = 1, 6 do
		local a = i * 1.05
		local e = math.rad(if i % 2 == 0 then 10 else -25)
		local p = eggCenter
			+ Vector3.new(
				math.cos(e) * math.sin(a) * 3.15,
				math.sin(e) * 4,
				math.cos(e) * math.cos(a) * 3.15
			)
		Build.ball(
			1.3,
			p,
			if i % 3 == 0 then Palette.purple elseif i % 3 == 1 then Palette.mint else Palette.orange,
			hub,
			FLAT
		)
	end
	local baby = DinoModel.build("Raptor", 3, nil, "Static")
	baby.Name = "ShopMascot"
	baby:PivotTo(CFrame.new(eggCenter + Vector3.new(0, 3.2, 0)) * CFrame.Angles(0, math.pi, 0))
	baby.Parent = hub

	-- invisible prompt target in the middle of the counter
	local promptPart =
		Build.block(Vector3.new(4, 4, 4), CFrame.new(0, counterTop - 1.5, 0), Palette.white, hub, {
			name = "ShopPrompt",
			transparency = 1,
			collide = false,
		})
	return hub, promptPart
end

-- ===== Volcano =====

-- Low-poly volcano: three frustum bands of wedge facets (gentle foot, steep
-- cone, steeper top) give a concave cartoon profile. Facets alternate between
-- two shades, lava runs straight down facet centre lines.
local VOLCANO_BANDS = {
	{
		r0 = 46,
		r1 = 31,
		y0 = 0,
		y1 = 11,
		light = Color3.fromRGB(150, 118, 104),
		dark = Color3.fromRGB(136, 106, 96),
	},
	{
		r0 = 31,
		r1 = 18,
		y0 = 11,
		y1 = 34,
		light = Color3.fromRGB(132, 102, 98),
		dark = Color3.fromRGB(118, 92, 90),
	},
	{
		r0 = 18,
		r1 = 13,
		y0 = 34,
		y1 = 46,
		light = Color3.fromRGB(112, 86, 88),
		dark = Color3.fromRGB(98, 76, 80),
	},
}
local VOLCANO_FACETS = 24

local function volcanoRadiusAt(y: number): number
	for _, band in VOLCANO_BANDS do
		if y <= band.y1 then
			local t = math.clamp((y - band.y0) / (band.y1 - band.y0), 0, 1)
			return band.r0 + (band.r1 - band.r0) * t
		end
	end
	return VOLCANO_BANDS[#VOLCANO_BANDS].r1
end

local function buildVolcano(map: Instance)
	local volcano = Build.model("Volcano", map)
	local base = Island.VOLCANO_POSITION
	local bottom = -1.2
	local step = TAU / VOLCANO_FACETS
	for b, band in VOLCANO_BANDS do
		local h = band.y1 - band.y0
		local depth = band.r0 - band.r1
		local width = 2 * band.r0 * math.sin(step / 2) + 0.35
		for i = 0, VOLCANO_FACETS - 1 do
			-- offset odd bands by half a facet so seams don't line up
			local angle = (i + (b % 2) * 0.5) * step
			local cf = CFrame.new(base.X, bottom + band.y0, base.Z)
				* CFrame.Angles(0, angle, 0)
				* CFrame.new(0, h / 2, -(band.r1 + depth / 2))
			Build.wedge(
				Vector3.new(width, h, depth),
				cf,
				if i % 2 == 0 then band.light else band.dark,
				volcano,
				{
					name = "Rock",
					decor = true,
				}
			)
		end
		Build.disc(
			band.r1 * 2 + 0.6,
			h,
			CFrame.new(base.X, bottom + band.y0 + h / 2, base.Z),
			band.dark,
			volcano,
			{
				name = "Core",
				decor = true,
				shadow = false,
			}
		)
	end
	local top = bottom + VOLCANO_BANDS[#VOLCANO_BANDS].y1
	local rim = VOLCANO_BANDS[#VOLCANO_BANDS].r1
	for i = 0, 13 do
		local angle = i * (TAU / 14)
		Build.ellipsoid(
			Vector3.new(6, 3.2, 4.6),
			CFrame.new(base + Build.polar(angle, rim - 0.6, top + 0.4)) * CFrame.Angles(0, angle, 0),
			Color3.fromRGB(84, 64, 70),
			volcano,
			GROUND
		)
	end
	local pool =
		Build.disc(rim * 2 - 3, 0.6, CFrame.new(base.X, top + 0.1, base.Z), Palette.lava, volcano, {
			name = "Lava",
			material = Enum.Material.Neon,
			decor = true,
			shadow = false,
		})
	Build.disc(rim, 0.6, CFrame.new(base.X, top + 0.25, base.Z), Palette.lavaHot, volcano, {
		material = Enum.Material.Neon,
		decor = true,
		shadow = false,
	})
	local glow = Instance.new("PointLight")
	glow.Color = Palette.lava
	glow.Range = 60
	glow.Brightness = 2
	glow.Parent = pool
	local smoke = Instance.new("ParticleEmitter")
	smoke.Color = ColorSequence.new(Color3.fromRGB(120, 112, 120))
	smoke.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 5),
		NumberSequenceKeypoint.new(1, 14),
	})
	smoke.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 1),
	})
	smoke.Lifetime = NumberRange.new(5, 8)
	smoke.Speed = NumberRange.new(5, 8)
	smoke.Rate = 5
	smoke.Rotation = NumberRange.new(0, 360)
	smoke.RotSpeed = NumberRange.new(-20, 20)
	smoke.SpreadAngle = Vector2.new(12, 12)
	smoke.Parent = pool

	-- lava flows down the island-facing side (facets sit within 1% of the
	-- band radius, so a small lift keeps the flows on the surface)
	local lavaOptions =
		{ material = Enum.Material.Neon, decor = true, shadow = false, collide = false }
	local inward = math.atan2(-base.X, -base.Z)
	local facing = math.floor(inward / step + 0.5)
	for _, k in { -2, 1, 3 } do
		local angle = (facing + k + 0.5) * step
		local stopAt = if k == 1 then 0 else 9
		local points: { Vector3 } = {}
		for y = VOLCANO_BANDS[#VOLCANO_BANDS].y1 - 0.5, stopAt, -3.5 do
			table.insert(points, base + Build.polar(angle, volcanoRadiusAt(y) + 0.6, bottom + y))
		end
		for i = 1, #points - 1 do
			local t = i / #points
			Build.beam(
				points[i],
				points[i + 1],
				2.2 + t * 2.4,
				0.8,
				Palette.lava,
				volcano,
				lavaOptions
			)
		end
		local last = points[#points]
		Build.ellipsoid(
			Vector3.new(8, 1.2, 8),
			CFrame.new(last),
			Palette.lava,
			volcano,
			lavaOptions
		)
		Build.ellipsoid(
			Vector3.new(4, 1.4, 4),
			CFrame.new(last + Vector3.new(0, 0.1, 0)),
			Palette.lavaHot,
			volcano,
			lavaOptions
		)
	end
	local gen = Rng.new(5)
	for i = 0, 11 do
		local angle = i * (TAU / 12) + gen.next() * 0.3
		Props.rock(
			base + Build.polar(angle, Island.VOLCANO_RADIUS + 1.5, 0),
			1.7 + gen.next() * 1.2,
			gen,
			volcano
		)
	end
end

-- ===== Scattered props =====

local function insidePlot(position: Vector3, margin: number): boolean
	for i = 0, Config.PLOT_COUNT - 1 do
		local angle = i * PLOT_ANGLE
		local center = Build.polar(angle, Config.PLOT_RING_RADIUS)
		local offset = position - center
		-- plot axes: local Z points away from the hub
		local z = offset.X * math.sin(angle) + offset.Z * math.cos(angle)
		local x = offset.X * math.cos(angle) - offset.Z * math.sin(angle)
		if math.abs(x) < HALF + margin and math.abs(z) < HALF + margin then
			return true
		end
	end
	return false
end

local function nearPath(position: Vector3, margin: number): boolean
	local r = position.Magnitude
	if r < Island.PLAZA_RADIUS + margin then
		return true
	end
	if math.abs(r - Island.RING_PATH_RADIUS) < 6.5 + margin then
		return true
	end
	if r < Island.GATE_RADIUS + 14 then
		local angle = math.atan2(position.X, position.Z)
		for i = 0, Config.PLOT_COUNT - 1 do
			local diff = (angle - i * PLOT_ANGLE + math.pi) % TAU - math.pi
			if math.abs(math.sin(diff) * r) < 7.5 + margin and math.cos(diff) > 0 then
				return true
			end
		end
	end
	return false
end

local function onLand(position: Vector3, landList: { Land }, inset: number): boolean
	for _, land in landList do
		local flat = Vector3.new(position.X - land.center.X, 0, position.Z - land.center.Z)
		if flat.Magnitude < land.radius - inset then
			return true
		end
	end
	return false
end

type Spot = { position: Vector3, radius: number }

local function scatter(map: Instance, landList: { Land })
	local folder = Instance.new("Folder")
	folder.Name = "Decorations"
	local gen = Rng.new(2024)
	local taken: { Spot } = {}
	local function free(position: Vector3, radius: number): boolean
		if not onLand(position, landList, radius + 3) then
			return false
		end
		if insidePlot(position, radius + 4) or nearPath(position, radius) then
			return false
		end
		local volcano = Vector3.new(
			position.X - Island.VOLCANO_POSITION.X,
			0,
			position.Z - Island.VOLCANO_POSITION.Z
		)
		if volcano.Magnitude < Island.VOLCANO_RADIUS + radius + 6 then
			return false
		end
		for _, spot in taken do
			if (spot.position - position).Magnitude < spot.radius + radius then
				return false
			end
		end
		return true
	end
	local function place(
		count: number,
		radius: number,
		minR: number,
		maxR: number,
		build: (Vector3) -> ()
	)
		local placed = 0
		local tries = 0
		while placed < count and tries < count * 60 do
			tries += 1
			local angle = gen.next() * TAU
			local r = minR + (maxR - minR) * math.sqrt(gen.next())
			local p = Build.polar(angle, r)
			if free(p, radius) then
				table.insert(taken, { position = p, radius = radius })
				build(p)
				placed += 1
			end
		end
	end

	-- landmarks first: decorative egg nests and ponds in open meadows
	for _, spot in { Build.polar(PLOT_ANGLE * 4.5, 62), Build.polar(PLOT_ANGLE * 6.5, 150) } do
		if free(spot, 6) then
			table.insert(taken, { position = spot, radius = 6 })
			Props.eggNest(spot, 1.2, gen, folder)
		end
	end
	place(2, 10, 60, 175, function(p)
		Props.pond(p, 1 + gen.next() * 0.3, gen, folder)
	end)
	local reach = Island.LAND_RADIUS + 45 -- peninsulas reach past the main disc
	place(40, 5, 50, reach, function(p)
		Props.tree(p, 0.9 + gen.next() * 0.45, gen, folder)
	end)
	place(22, 4, 115, reach, function(p)
		Props.pine(p, 0.9 + gen.next() * 0.4, gen, folder)
	end)
	place(30, 3, 45, reach, function(p)
		Props.fern(p, 0.9 + gen.next() * 0.5, gen, folder)
	end)
	place(36, 3, 45, reach, function(p)
		Props.bush(p, 0.8 + gen.next() * 0.5, gen, folder)
	end)
	place(24, 2.5, 45, reach, function(p)
		Props.flowers(p, 1 + gen.next() * 0.3, gen, folder)
	end)
	place(18, 3, 60, reach, function(p)
		Props.rock(p, 0.8 + gen.next() * 0.8, gen, folder)
	end)
	place(14, 2.5, 50, reach, function(p)
		Props.mushroom(p, 0.9 + gen.next() * 0.9, gen, folder)
	end)

	-- palms ring the beach
	for i, land in landList do
		if i > 1 and i < #landList then
			local outward = Vector3.new(land.center.X, 0, land.center.Z).Unit
			local p = land.center + outward * (land.radius - 3)
			p = Vector3.new(p.X, 0, p.Z)
			if free(p, 3) then
				table.insert(taken, { position = p, radius = 3 })
				Props.palm(p, 1 + gen.next() * 0.3, gen, folder)
			end
		end
	end
	place(14, 3, 170, reach, function(p)
		Props.palm(p, 0.95 + gen.next() * 0.3, gen, folder)
	end)

	-- path lamps where the ring path meets each spoke
	for i = 0, Config.PLOT_COUNT - 1 do
		local angle = i * PLOT_ANGLE
		local center = Build.polar(angle, Island.RING_PATH_RADIUS)
		local outward = Build.polar(angle, 1)
		local side = Vector3.new(outward.Z, 0, -outward.X)
		Props.lamp(center + side * 9.5 + outward * 7, 0.9, folder)
	end
	folder.Parent = map
end

-- ===== Sky and horizon =====

local function buildSky(map: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "Sky"
	local gen = Rng.new(99)
	for i = 0, 13 do
		local angle = i * (TAU / 14) + gen.next() * 0.3
		local r = 150 + gen.next() * 300
		Props.cloud(
			Build.polar(angle, r, 100 + gen.next() * 45),
			0.8 + gen.next() * 0.7,
			gen,
			folder
		)
	end
	folder.Parent = map
end

local function buildIslets(map: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "Islets"
	local gen = Rng.new(31)
	local spots = { { 0.6, 470 }, { 1.9, 560 }, { 3.0, 430 }, { 4.2, 600 }, { 5.3, 500 } }
	for _, spot in spots do
		local center = Build.polar(spot[1], spot[2])
		local radius = 16 + gen.next() * 14
		local land = { { center = center, radius = radius } }
		buildCoast(folder, land)
		Props.palm(center + Vector3.new(radius * 0.2, 0, -radius * 0.1), 1.2, gen, folder)
		Props.palm(center + Vector3.new(-radius * 0.35, 0, radius * 0.25), 1, gen, folder)
		Props.bush(center + Vector3.new(radius * 0.3, 0, radius * 0.35), 1, gen, folder)
	end
	folder.Parent = map
end

-- Builds everything and returns the shop's prompt part.
function Island.build(map: Instance): BasePart
	local landList = lands()
	buildOcean(map)
	buildCoast(map, landList)
	buildPaths(map)
	buildFootprints(map)
	local _, shopPrompt = buildHub(map)
	buildVolcano(map)
	scatter(map, landList)
	buildSky(map)
	buildIslets(map)
	return shopPrompt
end

return Island
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Notify</string>
            <string name="Source"><![CDATA[--!strict
-- Toasts and one-shot visual effects sent to clients.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

export type Style = "info" | "good" | "bad" | "rare" | "event"

local Notify = {}

function Notify.send(player: Player, text: string, style: Style?)
	Net.fire(player, "Notify", text, style or "info")
end

function Notify.all(text: string, style: Style?)
	Net.fireAll("Notify", text, style or "info")
end

-- Effects: "Hatch", "Roar", "Mutate", "Reward", "Stolen", "Caught", "Collect", "Dex"
function Notify.effect(player: Player, kind: string, data: { [string]: any })
	Net.fire(player, "Effect", kind, data)
end

function Notify.effectAll(kind: string, data: { [string]: any })
	Net.fireAll("Effect", kind, data)
end

return Notify
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Props</string>
            <string name="Source"><![CDATA[--!strict
-- Cartoon props built from parts: chunky rounded shapes, 2-3 shades per
-- material and a few pointy accents. Each builder takes a ground position, a
-- size multiplier and a random generator (so layouts are repeatable).

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Frames = require(ReplicatedStorage.Shared.Util.Frames)
local Palette = require(ReplicatedStorage.Shared.Palette)
local Rng = require(ReplicatedStorage.Shared.Util.Rng)
local Tags = require(ReplicatedStorage.Shared.Tags)
local Build = require(script.Parent.Build)

local Props = {}

-- Lights tagged with this are switched on at night by the client.
Props.NIGHT_LIGHT_TAG = Tags.NIGHT_LIGHT

type Gen = Rng.Generator

local LEAF = { decor = true, collide = false }
local SMALL = { decor = true, collide = false, shadow = false }

local function between(gen: Gen, a: number, b: number): number
	return a + (b - a) * gen.next()
end

local function pick<T>(gen: Gen, list: { T }): T
	return list[gen.int(1, #list)]
end

local function horizontal(angle: number): Vector3
	return Vector3.new(math.sin(angle), 0, math.cos(angle))
end

-- Leafy round tree: a short tapered trunk under a cluster of soft blobs.
function Props.tree(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Tree", parent)
	local h = between(gen, 7.5, 9.5) * s
	local lean = horizontal(gen.next() * math.pi * 2) * between(gen, 0.3, 1.2) * s
	local mid = base + Vector3.new(0, h * 0.5, 0) + lean * 0.3
	local top = base + Vector3.new(0, h, 0) + lean
	Build.ellipsoid(Vector3.new(3.4, 1.4, 3.4) * s, CFrame.new(base), Palette.woodDark, m, LEAF)
	Build.rod(base - Vector3.new(0, 0.5, 0), mid, 2.1 * s, Palette.wood, m, { name = "Trunk" })
	Build.rod(mid, top, 1.6 * s, Palette.wood, m, { name = "Trunk" })

	local yaw = CFrame.Angles(0, gen.next() * math.pi * 2, 0)
	local c = top + Vector3.new(0, 1.6 * s, 0)
	local function blob(size: Vector3, offset: Vector3, color: Color3)
		Build.ellipsoid(
			size * s,
			CFrame.new(c + yaw:VectorToWorldSpace(offset * s)),
			color,
			m,
			LEAF
		)
	end
	blob(Vector3.new(10.5, 8.5, 10.5), Vector3.zero, Palette.leaf)
	blob(Vector3.new(7, 6, 7), Vector3.new(4.2, -1.4, 1.2), Palette.leafDark)
	blob(Vector3.new(6.5, 5.5, 6.5), Vector3.new(-3.8, -1, -2), Palette.leafDark)
	blob(Vector3.new(6.5, 5.2, 6.5), Vector3.new(0.8, 3.3, -0.6), Palette.leafLight)
	if gen.next() < 0.3 then
		-- a few fruits
		for i = 1, 3 do
			local a = i * 2.1 + gen.next()
			local p = c
				+ Vector3.new(math.sin(a) * 4.6, between(gen, -2.2, 0.5), math.cos(a) * 4.6) * s
			Build.ball(
				0.9 * s,
				p,
				if gen.next() < 0.5 then Palette.red else Palette.orange,
				m,
				SMALL
			)
		end
	end
	return m
end

-- Fluffy cartoon pine: stacked blobs that shrink toward the top.
function Props.pine(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Pine", parent)
	Build.rod(
		base - Vector3.new(0, 0.5, 0),
		base + Vector3.new(0, 4 * s, 0),
		1.5 * s,
		Palette.woodDark,
		m
	)
	local tiers = { { 9, 5, 4.6 }, { 7.2, 4.6, 7.6 }, { 5.4, 4.2, 10.3 }, { 3.2, 3.4, 12.6 } }
	-- each tier drifts a little so no two pines look stamped
	local drift = horizontal(gen.next() * math.pi * 2) * 0.35 * s
	for i, t in tiers do
		local color = if i % 2 == 1 then Palette.pine else Palette.pineDark
		if i == #tiers then
			color = Palette.leaf
		end
		Build.ellipsoid(
			Vector3.new(t[1], t[2], t[1]) * s,
			CFrame.new(base + Vector3.new(0, t[3] * s, 0) + drift * (i - 1)),
			color,
			m,
			LEAF
		)
	end
	return m
end

-- Palm with a curved, banded trunk and drooping fronds.
function Props.palm(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Palm", parent)
	local lean = horizontal(gen.next() * math.pi * 2)
	local bend = between(gen, 3, 6.5) * s
	local segments = 6
	local length = between(gen, 2.4, 2.9) * s
	local previous = base - Vector3.new(0, 0.6, 0)
	for i = 1, segments do
		local t = i / segments
		local point = base + Vector3.new(0, i * length, 0) + lean * bend * t * t
		local color = if i % 2 == 0 then Palette.woodLight else Palette.wood
		Build.rod(previous, point, (1.9 - 0.5 * t) * s, color, m, { name = "Trunk" })
		previous = point
	end
	local crown = previous
	Build.ball(1.9 * s, crown, Palette.leafDark, m, LEAF)
	local fronds = 7
	local spin = gen.next() * math.pi * 2
	for i = 1, fronds do
		local a = spin + i * (2 * math.pi / fronds)
		local droop = math.rad(between(gen, 14, 30))
		local dir = horizontal(a) * math.cos(droop) - Vector3.new(0, math.sin(droop), 0)
		local center = crown + dir * 3.8 * s + Vector3.new(0, 0.3 * s, 0)
		Build.ellipsoid(
			Vector3.new(2.6, 0.35, 8.4) * s,
			Frames.alongZ(center, dir),
			if i % 2 == 0 then Palette.leaf else Palette.leafLight,
			m,
			LEAF
		)
	end
	for i = 1, 3 do
		local a = spin + i * 2.1
		Build.ball(
			1.15 * s,
			crown + Vector3.new(math.sin(a) * 0.9, -1.1, math.cos(a) * 0.9) * s,
			Palette.woodDark,
			m,
			SMALL
		)
	end
	return m
end

-- Prehistoric fern: a fountain of long leaves.
function Props.fern(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Fern", parent)
	local leaves = 7
	local spin = gen.next() * math.pi * 2
	for i = 1, leaves do
		local a = spin + i * (2 * math.pi / leaves)
		local rise = math.rad(between(gen, 30, 48))
		local dir = horizontal(a) * math.cos(rise) + Vector3.new(0, math.sin(rise), 0)
		Build.ellipsoid(
			Vector3.new(1.5, 0.3, 6) * s,
			Frames.alongZ(base + dir * 2.7 * s + Vector3.new(0, 0.2, 0), dir),
			if i % 2 == 0 then Palette.leafDark else Palette.leaf,
			m,
			SMALL
		)
	end
	Build.ball(1.4 * s, base + Vector3.new(0, 0.4 * s, 0), Palette.leafDark, m, SMALL)
	return m
end

function Props.bush(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Bush", parent)
	local yaw = CFrame.Angles(0, gen.next() * math.pi * 2, 0)
	local function blob(size: Vector3, offset: Vector3, color: Color3)
		Build.ellipsoid(
			size * s,
			CFrame.new(base + yaw:VectorToWorldSpace(offset * s)),
			color,
			m,
			LEAF
		)
	end
	blob(Vector3.new(5, 4, 5), Vector3.new(0, 1.5, 0), Palette.leaf)
	blob(Vector3.new(3.6, 3, 3.6), Vector3.new(2.3, 1, 0.8), Palette.leafDark)
	blob(Vector3.new(3.4, 2.8, 3.4), Vector3.new(-2.1, 0.9, -0.9), Palette.leafDark)
	blob(Vector3.new(3, 2.6, 3), Vector3.new(0.4, 2.8, -0.3), Palette.leafLight)
	if gen.next() < 0.45 then
		local berry = if gen.next() < 0.5 then Palette.pink else Palette.red
		for i = 1, 4 do
			local a = i * 1.7 + gen.next()
			local p = base
				+ yaw:VectorToWorldSpace(
					Vector3.new(math.sin(a) * 2.4, 1.6 + math.cos(a * 3) * 0.8, math.cos(a) * 2.4)
						* s
				)
			Build.ball(0.6 * s, p, berry, m, SMALL)
		end
	end
	return m
end

function Props.flowers(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Flowers", parent)
	Build.ellipsoid(Vector3.new(4.4, 0.7, 4.4) * s, CFrame.new(base), Palette.grassDeep, m, SMALL)
	local color = pick(gen, Palette.FLOWERS)
	for i = 1, 5 do
		local a = i * 1.26 + gen.next() * 0.5
		local r = between(gen, 0.4, 1.7) * s
		local foot = base + Vector3.new(math.sin(a) * r, 0, math.cos(a) * r)
		local height = between(gen, 0.9, 1.5) * s
		local head = foot + Vector3.new(0, height, 0)
		Build.rod(foot, head, 0.18 * s, Palette.grassDeep, m, SMALL)
		local petals = if gen.next() < 0.75 then color else pick(gen, Palette.FLOWERS)
		Build.ellipsoid(Vector3.new(1.2, 0.45, 1.2) * s, CFrame.new(head), petals, m, SMALL)
		local middle = if petals == Palette.yellow then Palette.orange else Palette.yellow
		Build.ball(0.45 * s, head + Vector3.new(0, 0.18 * s, 0), middle, m, SMALL)
	end
	return m
end

function Props.rock(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Rock", parent)
	local yaw = CFrame.Angles(0, gen.next() * math.pi * 2, 0)
	Build.ellipsoid(
		Vector3.new(4.4, 2.8, 3.6) * s,
		CFrame.new(base + Vector3.new(0, 0.7 * s, 0)) * yaw,
		Palette.stone,
		m,
		{ decor = true }
	)
	Build.ellipsoid(
		Vector3.new(2.6, 2, 2.4) * s,
		CFrame.new(base + yaw:VectorToWorldSpace(Vector3.new(2, 0.4, 0.9) * s)) * yaw,
		Palette.stoneDark,
		m,
		{ decor = true, collide = false }
	)
	Build.ellipsoid(
		Vector3.new(2.6, 1, 2.2) * s,
		CFrame.new(base + Vector3.new(-0.3, 1.8, -0.2) * s) * yaw,
		Palette.stoneLight,
		m,
		SMALL
	)
	return m
end

local CAP_COLORS = { Palette.red, Palette.purple, Palette.orange, Palette.pink }

function Props.mushroom(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Mushroom", parent)
	local height = between(gen, 2, 2.8) * s
	local top = base + Vector3.new(0, height, 0)
	Build.rod(base - Vector3.new(0, 0.3, 0), top, 1.1 * s, Palette.cream, m, { decor = true })
	local cap = Vector3.new(3.6, 2, 3.6) * s
	local center = top + Vector3.new(0, 0.2 * s, 0)
	Build.ellipsoid(cap, CFrame.new(center), pick(gen, CAP_COLORS), m, { decor = true })
	local spin = gen.next() * math.pi * 2
	for i = 1, 4 do
		local a = spin + i * (math.pi / 2)
		local e = math.rad(if i % 2 == 0 then 35 else 60)
		local p = center
			+ Vector3.new(
				math.cos(e) * math.sin(a) * cap.X / 2,
				math.sin(e) * cap.Y / 2,
				math.cos(e) * math.cos(a) * cap.Z / 2
			)
		Build.ellipsoid(Vector3.new(0.9, 0.35, 0.9) * s, CFrame.new(p), Palette.white, m, SMALL)
	end
	return m
end

-- Street lamp; its light switches on at night (see NIGHT_LIGHT_TAG).
function Props.lamp(base: Vector3, s: number, parent: Instance, glow: Color3?): Model
	local m = Build.model("Lamp", parent)
	local dark = Color3.fromRGB(88, 76, 104)
	Build.disc(1.8 * s, 0.8 * s, CFrame.new(base + Vector3.new(0, 0.4 * s, 0)), dark, m)
	local top = base + Vector3.new(0, 8.5 * s, 0)
	Build.rod(base, top, 0.55 * s, dark, m)
	local bulb =
		Build.ball(1.7 * s, top + Vector3.new(0, 0.9 * s, 0), glow or Palette.lampGlow, m, {
			name = "Bulb",
			material = Enum.Material.Neon,
			decor = true,
			shadow = false,
		})
	Build.disc(
		2.6 * s,
		0.5 * s,
		CFrame.new(top + Vector3.new(0, 2 * s, 0)),
		dark,
		m,
		{ decor = true }
	)
	Build.ball(0.7 * s, top + Vector3.new(0, 2.5 * s, 0), dark, m, SMALL)
	local light = Instance.new("PointLight")
	light.Color = glow or Palette.lampGlow
	light.Range = 22 * s
	light.Brightness = 1.6
	light.Shadows = false
	light.Enabled = false
	light.Parent = bulb
	CollectionService:AddTag(light, Props.NIGHT_LIGHT_TAG)
	return m
end

function Props.cloud(center: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Cloud", parent)
	local options = { decor = true, collide = false, shadow = false }
	local yaw = CFrame.Angles(0, gen.next() * math.pi * 2, 0)
	local puffs = {
		{ Vector3.new(26, 13, 18), Vector3.new(0, 0, 0) },
		{ Vector3.new(18, 12, 15), Vector3.new(-12, -1.5, 2) },
		{ Vector3.new(17, 11, 14), Vector3.new(12, -2, -1) },
		{ Vector3.new(15, 12, 13), Vector3.new(3, 4.5, 1) },
		{ Vector3.new(30, 6, 20), Vector3.new(0, -4, 0) },
	}
	for _, puff in puffs do
		Build.ellipsoid(
			puff[1] * s,
			CFrame.new(center + yaw:VectorToWorldSpace(puff[2] * s)) * yaw,
			Palette.white,
			m,
			options
		)
	end
	return m
end

-- Little pond with a stone rim, lily pads and reeds.
function Props.pond(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Pond", parent)
	local radius = 6.5 * s
	Build.disc(
		radius * 2 + 0.6,
		0.4,
		CFrame.new(base + Vector3.new(0, -0.05, 0)),
		Palette.sandDark,
		m,
		{
			decor = true,
			shadow = false,
		}
	)
	Build.disc(
		radius * 2 - 0.6,
		0.4,
		CFrame.new(base + Vector3.new(0, 0.02, 0)),
		Palette.water,
		m,
		{
			name = "Water",
			decor = true,
			shadow = false,
		}
	)
	Build.disc(
		radius * 1.2,
		0.4,
		CFrame.new(base + Vector3.new(0, 0.05, 0)),
		Palette.waterDeep,
		m,
		{
			decor = true,
			shadow = false,
		}
	)
	local stones = 14
	for i = 0, stones - 1 do
		local a = i * (2 * math.pi / stones) + gen.next() * 0.2
		local size = Vector3.new(
			between(gen, 1.8, 2.6),
			between(gen, 0.9, 1.4),
			between(gen, 1.4, 2)
		) * s
		Build.ellipsoid(
			size,
			CFrame.new(base + Vector3.new(math.sin(a) * radius, 0.25 * s, math.cos(a) * radius))
				* CFrame.Angles(0, a, 0),
			if i % 3 == 0 then Palette.stoneDark else Palette.stone,
			m,
			SMALL
		)
	end
	for i = 1, 3 do
		local a = i * 2.2 + gen.next()
		local r = between(gen, 1.5, radius - 2.2)
		local pad = base + Vector3.new(math.sin(a) * r, 0.3, math.cos(a) * r)
		Build.disc(1.9 * s, 0.12, CFrame.new(pad), Palette.leaf, m, SMALL)
		if i == 1 then
			Build.ball(0.7 * s, pad + Vector3.new(0, 0.3, 0), Palette.pink, m, SMALL)
		end
	end
	local reedAngle = gen.next() * math.pi * 2
	for i = 0, 3 do
		local a = reedAngle + i * 0.22
		local foot = base
			+ Vector3.new(math.sin(a) * (radius - 0.8), 0, math.cos(a) * (radius - 0.8))
		local height = between(gen, 2.6, 3.6) * s
		Build.rod(foot, foot + Vector3.new(0, height, 0), 0.22 * s, Palette.leafDark, m, SMALL)
		Build.ellipsoid(
			Vector3.new(0.5, 1.3, 0.5) * s,
			CFrame.new(foot + Vector3.new(0, height, 0)),
			Palette.woodDark,
			m,
			SMALL
		)
	end
	return m
end

-- Three-toed dino footprint pressed into a path.
function Props.footprint(
	position: Vector3,
	facing: number,
	s: number,
	color: Color3,
	parent: Instance
)
	local frame = CFrame.new(position) * CFrame.Angles(0, facing, 0)
	local options = { decor = true, collide = false, shadow = false }
	Build.ellipsoid(Vector3.new(1.7, 0.1, 2) * s, frame, color, parent, options)
	for i = -1, 1 do
		local toe = frame * CFrame.Angles(0, -i * math.rad(28), 0) * CFrame.new(0, 0, -1.9 * s)
		Build.ellipsoid(Vector3.new(0.6, 0.1, 1.6) * s, toe, color, parent, options)
	end
end

-- A twig nest holding big spotted eggs (landmark decoration).
function Props.eggNest(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("EggNest", parent)
	for i = 0, 9 do
		local a = i * (2 * math.pi / 10)
		local cf = CFrame.new(base + Vector3.new(math.sin(a) * 4.4, 0.8, math.cos(a) * 4.4) * s)
			* CFrame.Angles(0, a + math.pi / 2, 0)
		Build.ellipsoid(
			Vector3.new(1.6, 1.6, 3.6) * s,
			cf,
			if i % 2 == 0 then Palette.woodDark else Palette.wood,
			m,
			{
				decor = true,
			}
		)
	end
	Build.disc(
		8.6 * s,
		0.6 * s,
		CFrame.new(base + Vector3.new(0, 0.3 * s, 0)),
		Palette.sandDark,
		m,
		SMALL
	)
	local eggs = {
		{ offset = Vector3.new(-1.4, 0, -0.6), shell = Palette.mint, spots = Palette.teal },
		{ offset = Vector3.new(1.5, 0, -0.9), shell = Palette.cream, spots = Palette.orange },
		{ offset = Vector3.new(0, 0, 1.6), shell = Palette.purple, spots = Palette.pink },
	}
	for _, egg in eggs do
		local size = Vector3.new(2.6, 3.4, 2.6) * s
		local center = base + egg.offset * s + Vector3.new(0, size.Y / 2 + 0.2 * s, 0)
		Build.ellipsoid(
			size,
			CFrame.new(center)
				* CFrame.Angles(math.rad(between(gen, -12, 12)), 0, math.rad(between(gen, -12, 12))),
			egg.shell,
			m,
			{
				decor = true,
			}
		)
		for k = 1, 3 do
			local a = k * 2.2 + gen.next()
			local p = center
				+ Vector3.new(
					math.sin(a) * size.X * 0.47,
					between(gen, -0.6, 0.9) * s,
					math.cos(a) * size.Z * 0.47
				)
			Build.ellipsoid(Vector3.new(0.8, 0.8, 0.8) * s, CFrame.new(p), egg.spots, m, SMALL)
		end
	end
	return m
end

return Props
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Stats</string>
            <string name="Source"><![CDATA[--!strict
-- Derived numbers every system agrees on: slots, multipliers, income, boosts.
-- Reads profile + session; never mutates anything.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local DinoData = require(ReplicatedStorage.Shared.Data.DinoData)
local MutationData = require(ReplicatedStorage.Shared.Data.MutationData)
local Economy = require(ReplicatedStorage.Shared.Util.Economy)
local Growth = require(ReplicatedStorage.Shared.Util.Growth)
local Types = require(ReplicatedStorage.Shared.Types)
local Sessions = require(script.Parent.Parent.Systems.Sessions)

type Profile = Types.Profile
type Session = Sessions.Session

local Stats = {}

function Stats.hasPass(session: Session, key: string): boolean
	return session.passes[key] == true or session.fakePasses[key] == true
end

function Stats.maxSlots(profile: Profile, session: Session): number
	local extra = if Stats.hasPass(session, "ExtraSlots") then Config.PASS_EXTRA_SLOTS else 0
	return Config.BASE_DINO_SLOTS + profile.upgrades.slots + extra
end

function Stats.maxIncubators(profile: Profile): number
	return math.min(Config.BASE_INCUBATORS + profile.upgrades.incubators, Config.MAX_INCUBATORS)
end

function Stats.friendsHere(session: Session): number
	local count = 0
	for userId in session.friendIds do
		if Players:GetPlayerByUserId(userId) then
			count += 1
		end
	end
	return count
end

function Stats.multiplier(profile: Profile, session: Session, now: number): number
	return Economy.coinMultiplier({
		doubleCoins = Stats.hasPass(session, "DoubleCoins"),
		vip = Stats.hasPass(session, "VIP"),
		club = session.subscribed,
		adBoost = profile.boosts.coinsUntil > now,
		friends = Stats.friendsHere(session),
	})
end

function Stats.dinoStage(dino: Types.DinoRecord, now: number): number
	local species = DinoData.get(dino.species)
	if not species then
		return 1
	end
	return Growth.stageIndex(now - dino.bornAt, species.growth)
end

-- Base coins/second for one dino (before player multipliers).
function Stats.dinoIncome(dino: Types.DinoRecord, now: number): number
	local species = DinoData.get(dino.species)
	if not species then
		return 0
	end
	local stage = Growth.stageIndex(now - dino.bornAt, species.growth)
	return Growth.income(species.income, stage, MutationData.multiplier(dino.mutation))
end

function Stats.incomePerSecond(profile: Profile, session: Session, now: number): number
	local total = 0
	for _, dino in profile.dinos do
		total += Stats.dinoIncome(dino, now)
	end
	return total * Stats.multiplier(profile, session, now)
end

function Stats.luckActive(profile: Profile, now: number): boolean
	return profile.boosts.luckUntil > now
end

function Stats.shieldUntil(profile: Profile): number
	return profile.firstJoin + Config.NEW_PLAYER_SHIELD_SECONDS
end

function Stats.hatchSpeed(session: Session): number
	return if Stats.hasPass(session, "FastHatch") then Config.FAST_HATCH_MULTIPLIER else 1
end

function Stats.raidsEnabled(): boolean
	if Config.RAIDS_IN_PRIVATE_SERVERS then
		return true
	end
	return game.PrivateServerId == ""
end

function Stats.isDev(player: Player): boolean
	if RunService:IsStudio() then
		return true
	end
	return table.find(Config.DEV_USER_IDS, player.UserId) ~= nil
end

return Stats
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="43">
        <Properties>
          <string name="Name">Systems</string>
        </Properties>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Analytics</string>
            <string name="Source"><![CDATA[--!strict
-- Thin wrapper around AnalyticsService. Every call is pcall'd: analytics must
-- never break gameplay. Results show up in Creator Hub > Analytics.

local AnalyticsService = game:GetService("AnalyticsService")

local Analytics = {}

export type Transaction =
	"Gameplay"
	| "Shop"
	| "IAP"
	| "Onboarding"
	| "TimedReward"
	| "ContextualPurchase"

local TRANSACTIONS: { [Transaction]: Enum.AnalyticsEconomyTransactionType } = {
	Gameplay = Enum.AnalyticsEconomyTransactionType.Gameplay,
	Shop = Enum.AnalyticsEconomyTransactionType.Shop,
	IAP = Enum.AnalyticsEconomyTransactionType.IAP,
	Onboarding = Enum.AnalyticsEconomyTransactionType.Onboarding,
	TimedReward = Enum.AnalyticsEconomyTransactionType.TimedReward,
	ContextualPurchase = Enum.AnalyticsEconomyTransactionType.ContextualPurchase,
}

-- Onboarding funnel: log each step once, in order (1, 2, 3...).
function Analytics.funnel(player: Player, step: number, name: string)
	local ok, err = pcall(function()
		AnalyticsService:LogOnboardingFunnelStepEvent(player, step, name)
	end)
	if not ok then
		warn(`[Analytics] funnel {step} failed: {err}`)
	end
end

function Analytics.economy(
	player: Player,
	flow: "Source" | "Sink",
	amount: number,
	endingBalance: number,
	transaction: Transaction,
	sku: string?
)
	local rounded = math.floor(amount)
	if rounded <= 0 then
		return
	end
	local flowType = if flow == "Source"
		then Enum.AnalyticsEconomyFlowType.Source
		else Enum.AnalyticsEconomyFlowType.Sink
	pcall(function()
		AnalyticsService:LogEconomyEvent(
			player,
			flowType,
			"Coins",
			rounded,
			math.floor(endingBalance),
			TRANSACTIONS[transaction].Name,
			sku
		)
	end)
end

function Analytics.event(player: Player, name: string, value: number?)
	pcall(function()
		AnalyticsService:LogCustomEvent(player, name, value)
	end)
end

return Analytics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Cheats</string>
            <string name="Source"><![CDATA[--!strict
-- QA commands for testing in Studio (everyone) or live servers (only UserIds in
-- Config.DEV_USER_IDS). The gate is checked here on the server for every
-- command; hiding the panel on the client is just cosmetic. Commands go
-- through the same system APIs real gameplay uses.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Config = require(ReplicatedStorage.Shared.Config)
local Cycle = require(ReplicatedStorage.Shared.Util.Cycle)
local DinoData = require(ReplicatedStorage.Shared.Data.DinoData)
local Growth = require(ReplicatedStorage.Shared.Util.Growth)
local Net = require(ReplicatedStorage.Shared.Net)
local Coins = require(script.Parent.Coins)
local Data = require(script.Parent.Data)
local Monetization = require(script.Parent.Monetization)
local Nest = require(script.Parent.Nest)
local Plots = require(script.Parent.Plots)
local Progress = require(script.Parent.Progress)
local Sessions = require(script.Parent.Sessions)
local State = require(script.Parent.State)
local Notify = require(script.Parent.Parent.Lib.Notify)
local Stats = require(script.Parent.Parent.Lib.Stats)

local Cheats = {}

local function offset(): number
	local value = ReplicatedStorage:GetAttribute(Clock.OFFSET_ATTRIBUTE)
	return if typeof(value) == "number" then value else 0
end

local function shiftCycle(seconds: number)
	ReplicatedStorage:SetAttribute(Clock.OFFSET_ATTRIBUTE, offset() + seconds)
end

local commands: { [string]: (Player, string?) -> string } = {
	coins = function(player)
		Coins.add(player, 1000000, "Gameplay", "Cheat")
		return "+1M coins"
	end,
	grow = function(player)
		local profile = Data.get(player)
		if not profile then
			return "no profile"
		end
		local now = Clock.now()
		for _, dino in profile.dinos do
			local species = DinoData.get(dino.species)
			if species then
				local stage = Growth.stageIndex(now - dino.bornAt, species.growth)
				dino.bornAt = Growth.bornAtForStage(now, math.min(stage + 1, 4), species.growth)
			end
		end
		Plots.syncDinos(player)
		State.markDirty(player)
		return "dinos grew one stage"
	end,
	hatch = function(player)
		local profile = Data.get(player)
		if not profile then
			return "no profile"
		end
		local now = Clock.now()
		for slot in profile.incubators do
			Nest.setHatchAt(player, slot, now)
		end
		return "all eggs ready"
	end,
	lay = function(player)
		local profile = Data.get(player)
		if not profile then
			return "no profile"
		end
		for _, dino in profile.dinos do
			Nest.addTrayEgg(player, dino.species)
		end
		return "laid eggs"
	end,
	night = function()
		local dn = Cycle.dayNight(Clock.cycleNow())
		if not dn.isNight then
			shiftCycle(dn.secondsLeft + 0.5)
		end
		return "it's night"
	end,
	day = function()
		local dn = Cycle.dayNight(Clock.cycleNow())
		if dn.isNight then
			shiftCycle(dn.secondsLeft + 0.5)
		end
		return "it's day"
	end,
	storm = function()
		local storm = Cycle.storm(Clock.cycleNow())
		if not storm.active then
			shiftCycle(storm.secondsLeft + 0.5)
		end
		return "storm started"
	end,
	mega = function()
		local active, seconds = Cycle.megaStorm(Clock.cycleNow())
		if not active then
			shiftCycle(seconds + 0.5)
		end
		return "mega storm started"
	end,
	resettime = function()
		ReplicatedStorage:SetAttribute(Clock.OFFSET_ATTRIBUTE, 0)
		return "clock back to normal"
	end,
	luck = function(player)
		local profile = Data.get(player)
		if profile then
			profile.boosts.luckUntil = Clock.now() + 900
			State.markDirty(player)
		end
		return "luck for 15 min"
	end,
	pass = function(player, arg)
		if not arg then
			return "which pass?"
		end
		Monetization.toggleFakePass(player, arg)
		local session = Sessions.get(player)
		local on = session ~= nil and session.fakePasses[arg] == true
		return `pass {arg} {if on then "ON" else "OFF"}`
	end,
	trex = function(player)
		return if Nest.addDino(player, "TRex", nil, Growth.ADULT)
			then "adult T-Rex added"
			else "nest full"
	end,
	noshield = function(player)
		local profile = Data.get(player)
		if profile then
			profile.firstJoin = Clock.now() - Config.NEW_PLAYER_SHIELD_SECONDS - 60
			Plots.updateSign(player)
			State.markDirty(player)
		end
		return "new-player shield removed (your nest can be raided now)"
	end,
	skiptutorial = function(player)
		local profile = Data.get(player)
		if profile then
			profile.tutorial = 99
			State.markDirty(player)
		end
		return "tutorial skipped"
	end,
	reset = function(player)
		local profile = Data.reset(player)
		if not profile then
			return "no profile"
		end
		Plots.renderAll(player)
		Progress.onJoin(player)
		State.markDirty(player)
		return "profile reset"
	end,
}

function Cheats.init()
	Net.on("Cheat", 4, 6, function(player: Player, command: unknown, arg: unknown)
		if not Stats.isDev(player) then
			return
		end
		if typeof(command) ~= "string" then
			return
		end
		local fn = commands[command]
		if not fn then
			return
		end
		local result = fn(player, if typeof(arg) == "string" then arg else nil)
		Notify.send(player, "🛠 " .. result, "info")
	end)
end

return Cheats
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Coins</string>
            <string name="Source"><![CDATA[--!strict
-- The only code that changes a player's coins. Logs sources and sinks to
-- analytics and keeps the leaderboard in sync.

local Analytics = require(script.Parent.Analytics)
local Data = require(script.Parent.Data)
local State = require(script.Parent.State)

local Coins = {}

local function updateLeaderstats(player: Player, coins: number)
	local stats = player:FindFirstChild("leaderstats")
	local value = stats and stats:FindFirstChild("Coins")
	if value and value:IsA("NumberValue") then
		value.Value = math.floor(coins)
	end
end

function Coins.setupLeaderstats(player: Player)
	local profile = Data.get(player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local coins = Instance.new("NumberValue")
	coins.Name = "Coins"
	coins.Value = if profile then math.floor(profile.coins) else 0
	coins.Parent = stats
	local dex = Instance.new("IntValue")
	dex.Name = "Dex"
	dex.Value = 0
	dex.Parent = stats
	stats.Parent = player
end

function Coins.setDexCount(player: Player, count: number)
	local stats = player:FindFirstChild("leaderstats")
	local value = stats and stats:FindFirstChild("Dex")
	if value and value:IsA("IntValue") then
		value.Value = count
	end
end

function Coins.add(
	player: Player,
	amount: number,
	transaction: Analytics.Transaction,
	sku: string?
): number
	local profile = Data.get(player)
	if not profile or amount ~= amount or amount <= 0 or amount == math.huge then
		return 0
	end
	local whole = math.floor(amount)
	profile.coins += whole
	profile.totalEarned += whole
	Analytics.economy(player, "Source", whole, profile.coins, transaction, sku)
	updateLeaderstats(player, profile.coins)
	State.markDirty(player)
	return whole
end

function Coins.spend(
	player: Player,
	amount: number,
	transaction: Analytics.Transaction,
	sku: string?
): boolean
	local profile = Data.get(player)
	if not profile or amount ~= amount or amount < 0 or amount == math.huge then
		return false
	end
	if profile.coins < amount then
		return false
	end
	profile.coins -= amount
	Analytics.economy(player, "Sink", amount, profile.coins, transaction, sku)
	updateLeaderstats(player, profile.coins)
	State.markDirty(player)
	return true
end

-- Income piles up on the coin pad until the player walks over it
-- (or goes straight to their wallet with the Auto-Collect pass).
function Coins.accrue(player: Player, amount: number, autoCollect: boolean)
	local profile = Data.get(player)
	if not profile or amount <= 0 then
		return
	end
	if autoCollect then
		profile.coins += amount
		profile.totalEarned += amount
		updateLeaderstats(player, profile.coins)
	else
		profile.pendingCoins += amount
	end
	State.markDirty(player)
end

function Coins.collect(player: Player): number
	local profile = Data.get(player)
	if not profile then
		return 0
	end
	local amount = math.floor(profile.pendingCoins)
	if amount <= 0 then
		return 0
	end
	profile.pendingCoins -= amount
	return Coins.add(player, amount, "Gameplay", "CoinPad")
end

return Coins
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Data</string>
            <string name="Source"><![CDATA[--!strict
-- Player profiles: load, autosave, release. Follows docs/roblox-datastores:
--   * UpdateAsync only (never Get+Set), with retry + backoff
--   * session locking so two servers can never both own a profile (no dupes)
--   * save on autosave, on leave, and on server shutdown (BindToClose)
--   * a failed load kicks the player instead of handing them an empty profile
--
-- In Studio without "Enable Studio Access to API Services", DataStores are not
-- available; profiles then live in memory only and a warning is printed.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Config = require(ReplicatedStorage.Shared.Config)
local Types = require(ReplicatedStorage.Shared.Types)

type Profile = Types.Profile

local Data = {}

local STORE_NAME = "RaiseADino_Profiles_v1"
local CURRENT_VERSION = 1
local MAX_RECEIPTS = 100

type Lock = { jobId: string, time: number }
type Stored = { profile: Profile, lock: Lock? }

local store: DataStore? = nil
local mock = false

local profiles: { [Player]: Profile } = {}
local saving: { [Player]: boolean } = {}
local nextAutosave: { [Player]: number } = {}

local function defaultProfile(now: number): Profile
	return {
		version = CURRENT_VERSION,
		coins = Config.STARTING_COINS,
		pendingCoins = 0,
		totalEarned = 0,
		nextId = 1,
		dinos = {},
		incubators = {},
		tray = {},
		dex = {},
		upgrades = { slots = 0, incubators = 0 },
		boosts = { luckUntil = 0, coinsUntil = 0 },
		instantHatchTokens = 0,
		streak = { count = 0, lastDay = 0 },
		club = { lastClaimDay = 0 },
		tutorial = 0,
		starterPackBought = false,
		shop = { restock = 0, bought = {} },
		likes = 0,
		stats = { hatched = 0, stolen = 0, eggsLost = 0, sold = 0 },
		receipts = {},
		firstJoin = now,
		lastSeen = now,
	}
end

local function deepCopy<T>(value: T): T
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value :: any do
		copy[k] = deepCopy(v)
	end
	return copy :: any
end

local function isArray(t: { [any]: any }): boolean
	return #t > 0 or next(t) == nil
end

-- Fill in any fields added to the default profile since this one was saved.
local function reconcile(target: { [any]: any }, template: { [any]: any })
	for key, value in template do
		if target[key] == nil then
			target[key] = deepCopy(value)
		elseif type(value) == "table" and type(target[key]) == "table" and not isArray(value) then
			reconcile(target[key], value)
		end
	end
end

-- Version migrations: MIGRATIONS[n] upgrades a version-n profile to n+1.
local MIGRATIONS: { [number]: (any) -> any } = {}

local function migrate(profile: any): Profile
	local version = if type(profile.version) == "number" then profile.version else 1
	while version < CURRENT_VERSION do
		local step = MIGRATIONS[version]
		if not step then
			error(`missing migration from v{version}`)
		end
		profile = step(profile)
		version += 1
		profile.version = version
	end
	reconcile(profile, defaultProfile(Clock.now()))
	return profile
end

local function keyFor(player: Player): string
	return `u_{player.UserId}`
end

local function withRetry(attempts: number, fn: () -> ()): (boolean, string?)
	local delaySeconds = 1
	local lastError: string? = nil
	for attempt = 1, attempts do
		local result = table.pack(pcall(fn))
		if result[1] then
			return true, nil
		end
		local err = result[2]
		lastError = tostring(err)
		warn(`[Data] attempt {attempt}/{attempts} failed: {err}`)
		if attempt < attempts then
			task.wait(delaySeconds)
			delaySeconds = math.min(delaySeconds * 2, 16)
		end
	end
	return false, lastError
end

function Data.isMock(): boolean
	return mock
end

-- Loads and session-locks a profile. Yields. Returns nil if it can't be loaded
-- safely (the caller kicks the player).
function Data.load(player: Player): Profile?
	if mock then
		local profile = defaultProfile(Clock.now())
		profiles[player] = profile
		nextAutosave[player] = os.clock() + Config.AUTOSAVE_INTERVAL
		return profile
	end
	local ds = store :: DataStore
	local key = keyFor(player)

	for _ = 1, 5 do
		local loaded: Profile? = nil
		local lockedElsewhere = false
		local ok = withRetry(3, function()
			ds:UpdateAsync(key, function(stored: any): any
				loaded = nil
				lockedElsewhere = false
				local now = Clock.now()
				if type(stored) == "table" and type(stored.lock) == "table" then
					local lock = stored.lock :: Lock
					if
						lock.jobId ~= game.JobId
						and now - lock.time < Config.SESSION_LOCK_STALE_SECONDS
					then
						lockedElsewhere = true
						return nil -- abort: another server still owns this profile
					end
				end
				local profile: Profile
				if type(stored) == "table" and type(stored.profile) == "table" then
					profile = migrate(stored.profile)
				else
					profile = defaultProfile(now)
				end
				loaded = profile
				local result: Stored =
					{ profile = profile, lock = { jobId = game.JobId, time = now } }
				return result
			end)
		end)
		if not ok then
			return nil
		end
		if loaded then
			profiles[player] = loaded
			nextAutosave[player] = os.clock() + Config.AUTOSAVE_INTERVAL
			return loaded
		end
		if lockedElsewhere then
			-- The other server is probably mid-save after the player hopped servers.
			task.wait(4)
		end
		if player.Parent == nil then
			return nil
		end
	end
	return nil
end

function Data.get(player: Player): Profile?
	return profiles[player]
end

local function save(player: Player, release: boolean): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	if mock then
		return true
	end
	-- One write per key at a time.
	while saving[player] do
		task.wait(0.2)
	end
	saving[player] = true
	profile.lastSeen = Clock.now()
	local ds = store :: DataStore
	local lostLock = false
	local ok = withRetry(if release then 5 else 3, function()
		ds:UpdateAsync(keyFor(player), function(stored: any): any
			lostLock = false
			local now = Clock.now()
			if type(stored) == "table" and type(stored.lock) == "table" then
				local lock = stored.lock :: Lock
				if
					lock.jobId ~= game.JobId
					and now - lock.time < Config.SESSION_LOCK_STALE_SECONDS
				then
					lostLock = true
					return nil
				end
			end
			local result: Stored = {
				profile = profile,
				lock = if release then nil else { jobId = game.JobId, time = now },
			}
			return result
		end)
	end)
	saving[player] = nil
	if lostLock then
		warn(`[Data] {player.Name}'s profile is locked by another server; not saving`)
		return false
	end
	return ok
end

-- Save immediately (used after Robux purchases). Returns true on success.
function Data.saveNow(player: Player): boolean
	return save(player, false)
end

-- Final save + release the session lock, then forget the profile.
function Data.release(player: Player)
	if not profiles[player] then
		return
	end
	save(player, true)
	profiles[player] = nil
	nextAutosave[player] = nil
end

-- QA: replace a profile with a brand-new one (keeps the purchase ledger).
function Data.reset(player: Player): Profile?
	local old = profiles[player]
	if not old then
		return nil
	end
	local fresh = defaultProfile(Clock.now())
	fresh.receipts = old.receipts
	profiles[player] = fresh
	return fresh
end

-- Remember a processed Robux purchase so it is never granted twice.
function Data.hasReceipt(profile: Profile, purchaseId: string): boolean
	return table.find(profile.receipts, purchaseId) ~= nil
end

function Data.addReceipt(profile: Profile, purchaseId: string)
	table.insert(profile.receipts, purchaseId)
	while #profile.receipts > MAX_RECEIPTS do
		table.remove(profile.receipts, 1)
	end
end

function Data.init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	end
	if RunService:IsStudio() then
		local usable = ok
			and pcall(function()
				(result :: DataStore):GetAsync("studio_probe")
			end)
		if not usable then
			mock = true
			warn(
				"[Data] DataStores aren't available in this Studio session, so progress won't save.\n"
					.. "To test saving: publish the game, then Game Settings > Security > "
					.. "Enable Studio Access to API Services."
			)
		end
	elseif not ok then
		error("[Data] could not open DataStore: " .. tostring(result))
	end
end

function Data.start()
	-- Autosave, staggered per player.
	task.spawn(function()
		while true do
			task.wait(5)
			local now = os.clock()
			for player, due in nextAutosave do
				if now >= due and player.Parent ~= nil then
					nextAutosave[player] = now + Config.AUTOSAVE_INTERVAL
					task.spawn(save, player, false)
				end
			end
		end
	end)

	game:BindToClose(function()
		if mock then
			return
		end
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				save(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		-- Lifecycle calls Data.release after other systems clean up; this is the
		-- safety net in case a player leaves before Lifecycle finished loading them.
		task.delay(10, function()
			if profiles[player] and player.Parent == nil then
				Data.release(player)
			end
		end)
	end)
end

return Data
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Dinos</string>
            <string name="Source"><![CDATA[--!strict
-- Living dinos: growth (re-rendering as they grow), coin income onto the pad,
-- egg laying, offline earnings, selling, and riding (game pass).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Config = require(ReplicatedStorage.Shared.Config)
local DinoData = require(ReplicatedStorage.Shared.Data.DinoData)
local DinoModel = require(ReplicatedStorage.Shared.Visual.DinoModel)
local Economy = require(ReplicatedStorage.Shared.Util.Economy)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Growth = require(ReplicatedStorage.Shared.Util.Growth)
local MutationData = require(ReplicatedStorage.Shared.Data.MutationData)
local Net = require(ReplicatedStorage.Shared.Net)
local Coins = require(script.Parent.Coins)
local Data = require(script.Parent.Data)
local Nest = require(script.Parent.Nest)
local Plots = require(script.Parent.Plots)
local Progress = require(script.Parent.Progress)
local Sessions = require(script.Parent.Sessions)
local State = require(script.Parent.State)
local World = require(script.Parent.World)
local Notify = require(script.Parent.Parent.Lib.Notify)
local Stats = require(script.Parent.Parent.Lib.Stats)

local Dinos = {}

local lastCollect: { [Player]: number } = {}

-- ===== Riding =====

function Dinos.dismount(player: Player)
	local session = Sessions.get(player)
	if not session then
		return
	end
	if session.mount then
		session.mount:Destroy()
		session.mount = nil
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		if session.originalHipHeight then
			humanoid.HipHeight = session.originalHipHeight
		end
		if session.carry == nil then
			humanoid.WalkSpeed = Config.NORMAL_WALKSPEED
		end
	end
	session.originalHipHeight = nil
	if session.riding then
		session.riding = nil
		State.markDirty(player)
	end
end

local function ride(player: Player, dinoId: string)
	local session = Sessions.get(player)
	local profile = Data.get(player)
	if not session or not profile or not session.ready then
		return
	end
	if not Stats.hasPass(session, "RideDinos") then
		Notify.send(player, "Get the 🦖 Ride Your Dinos pass to ride!", "info")
		return
	end
	if session.carry then
		Notify.send(player, "You can't ride while carrying an egg!", "bad")
		return
	end
	local dino = Nest.findDino(profile, dinoId)
	if not dino then
		return
	end
	local stage = Stats.dinoStage(dino, Clock.now())
	if stage < Growth.JUVENILE then
		Notify.send(player, "This baby is too small to ride. Let it grow first!", "info")
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not humanoid or not root or not root:IsA("BasePart") then
		return
	end
	Dinos.dismount(player)

	local mount = DinoModel.build(dino.species, stage, dino.mutation, "Mount")
	mount.Name = "Mount"
	local height = mount:GetAttribute("Height")
	local saddle = if typeof(height) == "number" then height * 0.55 else 3
	session.originalHipHeight = humanoid.HipHeight
	local newHip = humanoid.HipHeight + saddle
	humanoid.HipHeight = newHip

	local mountRoot = mount.PrimaryPart :: BasePart
	local weld = Instance.new("Weld")
	weld.Part0 = root
	weld.Part1 = mountRoot
	weld.C0 = CFrame.new(0, -(root.Size.Y / 2 + newHip), 0)
	weld.Parent = mountRoot
	mount.Parent = character

	humanoid.WalkSpeed = Config.RIDE_WALKSPEED
	session.mount = mount
	session.riding = dinoId
	State.markDirty(player)
end

-- ===== Selling =====

local function sellDino(player: Player, dinoId: string)
	local profile = Data.get(player)
	local session = Sessions.get(player)
	if not profile or not session or not session.ready then
		return
	end
	local dino = Nest.findDino(profile, dinoId)
	local species = dino and DinoData.get(dino.species)
	if not dino or not species then
		return
	end
	if session.riding == dinoId then
		Dinos.dismount(player)
	end
	local stage = Stats.dinoStage(dino, Clock.now())
	local value = Economy.dinoValue(species.income, stage, MutationData.multiplier(dino.mutation))
	Nest.removeDino(player, dinoId)
	profile.stats.sold += 1
	local amount = Coins.add(player, value, "Gameplay", "SellDino")
	Notify.send(player, `Sold {species.name} for 💰 {Format.number(amount)}`, "good")
end

-- ===== Income, growth, laying =====

local function layEggs(player: Player)
	local profile = Data.get(player)
	if not profile then
		return
	end
	local now = Clock.now()
	local laidNames: { string } = {}
	for _, dino in profile.dinos do
		local species = DinoData.get(dino.species)
		if not species then
			continue
		end
		local room = Nest.trayRoom(profile)
		local laid, newLast = Growth.laysDue(
			dino.bornAt,
			dino.lastLaidAt,
			species.growth,
			now,
			Config.LAY_INTERVAL_ADULT,
			Config.LAY_INTERVAL_GIANT,
			room
		)
		dino.lastLaidAt = newLast
		for _ = 1, laid do
			if Nest.addTrayEgg(player, dino.species) then
				table.insert(laidNames, species.name)
			end
		end
	end
	if #laidNames == 1 then
		Notify.send(player, `🥚 Your {laidNames[1]} laid an egg!`, "good")
	elseif #laidNames > 1 then
		Notify.send(player, `🥚 Your dinos laid {#laidNames} eggs!`, "good")
	end
end

-- Coins earned while away go onto the pad so returning players get a big pile.
function Dinos.applyOffline(player: Player)
	local profile = Data.get(player)
	local session = Sessions.get(player)
	if not profile or not session then
		return
	end
	local now = Clock.now()
	local away = now - profile.lastSeen
	if away < 60 then
		return
	end
	local income = Stats.incomePerSecond(profile, session, now)
	local earned = Economy.offlineCoins(income, away)
	if earned > 0 then
		profile.pendingCoins += earned
		task.delay(4, function()
			Notify.send(
				player,
				`While you were away your dinos made 💰 {Format.number(earned)}! Grab it from your coin pad.`,
				"good"
			)
		end)
	end
	layEggs(player)
end

local function tick(dt: number, withLaying: boolean)
	local now = Clock.now()
	for _, session in Sessions.ready() do
		local player = session.player
		local profile = Data.get(player)
		if not profile then
			continue
		end
		local income = Stats.incomePerSecond(profile, session, now)
		Coins.accrue(player, income * dt, Stats.hasPass(session, "AutoCollect"))
		Plots.updatePad(player, profile.pendingCoins)
		Plots.syncDinos(player)
		if withLaying then
			layEggs(player)
		end
	end
end

local function hookCoinPads()
	for _, plot in World.plots do
		plot.pad.Touched:Connect(function(hit: BasePart)
			local character = hit:FindFirstAncestorOfClass("Model")
			local player = character and Players:GetPlayerFromCharacter(character)
			if not player or Plots.ownerOf(plot.index) ~= player then
				return
			end
			local now = os.clock()
			if lastCollect[player] and now - lastCollect[player] < 0.5 then
				return
			end
			lastCollect[player] = now
			local amount = Coins.collect(player)
			if amount > 0 then
				Plots.updatePad(player, 0)
				Notify.effect(player, "Collect", { amount = amount })
			end
			-- Advance the tutorial even if the pad was nearly empty.
			Progress.event(player, "collect")
		end)
	end
end

-- One income/growth/laying pass (start() runs this every second; tests call it).
function Dinos.step(dt: number)
	tick(dt, true)
end

function Dinos.init()
	Net.on("SellDino", 3, 5, function(player: Player, dinoId: unknown)
		if typeof(dinoId) == "string" and #dinoId <= 20 then
			sellDino(player, dinoId)
		end
	end)
	Net.on("Ride", 1, 3, function(player: Player, dinoId: unknown)
		if dinoId == nil then
			Dinos.dismount(player)
		elseif typeof(dinoId) == "string" and #dinoId <= 20 then
			ride(player, dinoId)
		end
	end)
	Sessions.Leaving:connect(function(player: Player)
		lastCollect[player] = nil
	end)
end

function Dinos.start()
	hookCoinPads()
	local ticks = 0
	while true do
		local dt = task.wait(1)
		ticks += 1
		tick(dt, ticks % 5 == 0)
	end
end

return Dinos
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Eggs</string>
            <string name="Source"><![CDATA[--!strict
-- Buying eggs, warming and hatching them, and the laid-egg tray (incubate/sell).
-- Hatch results are rolled here, on the server, from the same odds tables the
-- client shows in the Odds panel.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Config = require(ReplicatedStorage.Shared.Config)
local Cycle = require(ReplicatedStorage.Shared.Util.Cycle)
local DinoData = require(ReplicatedStorage.Shared.Data.DinoData)
local Economy = require(ReplicatedStorage.Shared.Util.Economy)
local EggData = require(ReplicatedStorage.Shared.Data.EggData)
local EggOdds = require(ReplicatedStorage.Shared.Util.EggOdds)
local Net = require(ReplicatedStorage.Shared.Net)
local Odds = require(ReplicatedStorage.Shared.Util.Odds)
local Types = require(ReplicatedStorage.Shared.Types)
local Analytics = require(script.Parent.Analytics)
local Coins = require(script.Parent.Coins)
local Data = require(script.Parent.Data)
local Nest = require(script.Parent.Nest)
local Plots = require(script.Parent.Plots)
local Progress = require(script.Parent.Progress)
local Prompts = require(script.Parent.Prompts)
local Sessions = require(script.Parent.Sessions)
local State = require(script.Parent.State)
local Notify = require(script.Parent.Parent.Lib.Notify)
local Stats = require(script.Parent.Parent.Lib.Stats)

local Eggs = {}

local rng = Random.new()

-- Warm taps: token bucket so tapping can at most double hatch speed.
local warmBudget: { [Player]: { tokens: number, last: number } } = {}

local function validSlot(value: unknown): string?
	if typeof(value) ~= "string" then
		return nil
	end
	local n = tonumber(value)
	if not n or n ~= math.floor(n) or n < 1 or n > Config.MAX_INCUBATORS then
		return nil
	end
	return value
end

local function validId(value: unknown): string?
	if typeof(value) ~= "string" or #value > 20 then
		return nil
	end
	return value
end

-- ===== Buying =====

local function buyEgg(player: Player, eggId: unknown)
	if typeof(eggId) ~= "string" then
		return
	end
	local eggType = EggData.get(eggId)
	local profile = Data.get(player)
	local session = Sessions.get(player)
	if not eggType or not profile or not session or not session.ready then
		return
	end
	local now = Clock.now()
	local restock = Cycle.restock(Clock.cycleNow())
	if profile.shop.restock ~= restock.index then
		profile.shop = { restock = restock.index, bought = {} }
	end
	local bought = profile.shop.bought[eggId] or 0
	if bought >= (restock.stock[eggId] or 0) then
		Notify.send(player, "Sold out! The shop restocks soon.", "bad")
		return
	end
	if Nest.freeIncubator(player) == nil then
		Notify.send(player, "All your incubators are full! Hatch an egg first.", "bad")
		return
	end
	if not Coins.spend(player, eggType.price, "Shop", eggId) then
		Notify.send(player, "Not enough coins yet!", "bad")
		return
	end
	profile.shop.bought[eggId] = bought + 1
	Nest.placeEgg(player, {
		id = Nest.newId(profile),
		kind = "shop",
		eggType = eggId,
		placedAt = now,
		hatchAt = now + eggType.hatchSeconds / Stats.hatchSpeed(session),
	})
	Notify.send(player, `🥚 {eggType.name} is warming in your nest!`, "good")
	Progress.event(player, "buy_egg")
	State.markDirty(player)
end

-- ===== Hatching =====

local function rollMutation(): string?
	return Odds.pick(EggOdds.mutations(Clock.cycleNow()), rng:NextNumber())
end

local function resultFor(egg: Types.IncubatorEgg, profile: Types.Profile): (string?, string?)
	if egg.kind == "shop" then
		if not egg.eggType or not EggData.get(egg.eggType) then
			return nil, nil
		end
		local luck = Stats.luckActive(profile, Clock.now())
		local species = Odds.roll(EggOdds.species(egg.eggType, luck), rng:NextNumber())
		return species, rollMutation()
	elseif egg.kind == "laid" then
		return egg.species, rollMutation()
	elseif egg.kind == "gift" then
		return egg.species, egg.mutation
	end
	return egg.species, nil -- starter
end

function Eggs.hatch(player: Player, slot: string)
	local profile = Data.get(player)
	local session = Sessions.get(player)
	if not profile or not session or not session.ready then
		return
	end
	local egg = profile.incubators[slot]
	if not egg or egg.hatchAt > Clock.now() then
		return
	end
	if not Nest.hasFreeSlot(player) then
		Notify.send(player, "Your nest is full! Sell a dino or get more space.", "bad")
		return
	end
	local species, mutation = resultFor(egg, profile)
	if not species or not DinoData.get(species) then
		return
	end
	Nest.removeEgg(player, slot)
	local dino = Nest.addDino(player, species, mutation)
	if not dino then
		-- Shouldn't happen (slot checked above), but never lose the egg.
		profile.incubators[slot] = egg
		Plots.syncIncubators(player)
		return
	end
	profile.stats.hatched += 1
	local data = DinoData.get(species) :: DinoData.Species
	Notify.effect(player, "Hatch", { species = species, mutation = mutation, dinoId = dino.id })
	Analytics.event(player, "Hatch" .. data.rarity)
	if egg.kind == "starter" then
		Progress.event(player, "hatch_starter")
	elseif egg.kind == "gift" then
		Progress.event(player, "hatch_gift")
	else
		Progress.event(player, "hatch")
	end
	if data.rarity == "Legendary" or data.rarity == "Secret" then
		Notify.all(`🌟 {player.DisplayName} just hatched a {data.rarity} {data.name}!`, "rare")
	end
	State.markDirty(player)
end

function Eggs.warm(player: Player, slot: string)
	local profile = Data.get(player)
	local egg = profile and profile.incubators[slot]
	if not egg then
		return
	end
	local now = Clock.now()
	if egg.hatchAt <= now then
		return
	end
	local budget = warmBudget[player]
	local clock = os.clock()
	if not budget then
		budget = { tokens = Config.WARM_TAP_RATE, last = clock }
		warmBudget[player] = budget
	end
	budget.tokens =
		math.min(Config.WARM_TAP_RATE, budget.tokens + (clock - budget.last) * Config.WARM_TAP_RATE)
	budget.last = clock
	if budget.tokens < 1 then
		return
	end
	budget.tokens -= 1
	Nest.setHatchAt(player, slot, math.max(now, egg.hatchAt - Config.WARM_TAP_SECONDS))
end

-- Instantly finish an egg (Robux purchase or token). Returns true if it applied.
function Eggs.finishNow(player: Player, slot: string?): boolean
	local profile = Data.get(player)
	if not profile then
		return false
	end
	local now = Clock.now()
	local target = slot and profile.incubators[slot]
	if not target or target.hatchAt <= now then
		-- fall back to the egg closest to hatching
		target = nil
		slot = nil
		for key, egg in profile.incubators do
			if egg.hatchAt > now and (target == nil or egg.hatchAt < target.hatchAt) then
				target = egg
				slot = key
			end
		end
	end
	if not target or not slot then
		return false
	end
	Nest.setHatchAt(player, slot, now)
	Notify.send(player, "⚡ Your egg is ready to hatch!", "good")
	return true
end

-- ===== Tray =====

local function incubateTrayEgg(player: Player, eggId: string)
	local profile = Data.get(player)
	local session = Sessions.get(player)
	if not profile or not session or Plots.isTrayEggHidden(player, eggId) then
		return
	end
	local trayEgg = Nest.findTrayEgg(profile, eggId)
	if not trayEgg then
		return
	end
	local species = DinoData.get(trayEgg.species)
	if not species then
		return
	end
	if Nest.freeIncubator(player) == nil then
		Notify.send(player, "All your incubators are full!", "bad")
		return
	end
	Nest.removeTrayEgg(player, eggId)
	local now = Clock.now()
	Nest.placeEgg(player, {
		id = Nest.newId(profile),
		kind = "laid",
		species = trayEgg.species,
		placedAt = now,
		hatchAt = now + species.layHatchSeconds / Stats.hatchSpeed(session),
	})
end

local function sellTrayEgg(player: Player, eggId: string)
	local profile = Data.get(player)
	if not profile or Plots.isTrayEggHidden(player, eggId) then
		return
	end
	local trayEgg = Nest.findTrayEgg(profile, eggId)
	local species = trayEgg and DinoData.get(trayEgg.species)
	if not trayEgg or not species then
		return
	end
	Nest.removeTrayEgg(player, eggId)
	local amount = Coins.add(player, Economy.trayEggValue(species.income), "Gameplay", "SellEgg")
	Notify.send(player, `Sold a {species.name} egg for 💰 {amount}`, "good")
end

-- Friends standing near your incubators warm your eggs (2x speed).
local function friendWarmTick()
	local now = Clock.now()
	for _, session in Sessions.ready() do
		local profile = Data.get(session.player)
		if not profile or next(session.friendIds) == nil then
			continue
		end
		for slot, egg in profile.incubators do
			if egg.hatchAt <= now then
				continue
			end
			local position = Plots.incubatorPosition(session.player, slot)
			if not position then
				continue
			end
			for userId in session.friendIds do
				local friend = Players:GetPlayerByUserId(userId)
				local character = friend and friend.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if
					root
					and root:IsA("BasePart")
					and (root.CFrame.Position - position).Magnitude <= Config.FRIEND_WARM_RANGE
				then
					egg.hatchAt = math.max(now, egg.hatchAt - 1)
					Plots.syncIncubators(session.player)
					Plots.flagFriendWarm(session.player, slot)
					State.markDirty(session.player)
					break
				end
			end
		end
	end
end

local function ownerCheck(player: Player, prompt: ProximityPrompt): boolean
	return Prompts.ownerId(prompt) == player.UserId
end

function Eggs.init()
	Net.on("BuyEgg", 4, 6, function(player: Player, eggId: unknown)
		buyEgg(player, eggId)
	end)
	Net.on("HatchEgg", 4, 6, function(player: Player, slot: unknown)
		local key = validSlot(slot)
		if key then
			Eggs.hatch(player, key)
		end
	end)
	Net.on("WarmEgg", 8, 8, function(player: Player, slot: unknown)
		local key = validSlot(slot)
		if key then
			Eggs.warm(player, key)
		end
	end)
	Net.on("IncubateTrayEgg", 3, 5, function(player: Player, eggId: unknown)
		local id = validId(eggId)
		if id then
			incubateTrayEgg(player, id)
		end
	end)
	Net.on("SellTrayEgg", 3, 5, function(player: Player, eggId: unknown)
		local id = validId(eggId)
		if id then
			sellTrayEgg(player, id)
		end
	end)

	Prompts.register("IncubatorTap", function(player: Player, prompt: ProximityPrompt)
		local slot = Prompts.key(prompt)
		if not ownerCheck(player, prompt) or not slot then
			return
		end
		local profile = Data.get(player)
		local egg = profile and profile.incubators[slot]
		if not egg then
			return
		end
		if egg.hatchAt <= Clock.now() then
			Eggs.hatch(player, slot)
		else
			Eggs.warm(player, slot)
		end
	end)
	Prompts.register("TrayIncubate", function(player: Player, prompt: ProximityPrompt)
		local id = Prompts.key(prompt)
		if ownerCheck(player, prompt) and id then
			incubateTrayEgg(player, id)
		end
	end)
	Prompts.register("TraySell", function(player: Player, prompt: ProximityPrompt)
		local id = Prompts.key(prompt)
		if ownerCheck(player, prompt) and id then
			sellTrayEgg(player, id)
		end
	end)

	Sessions.Leaving:connect(function(player: Player)
		warmBudget[player] = nil
	end)
end

function Eggs.start()
	while true do
		task.wait(1)
		friendWarmTick()
	end
end

return Eggs
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Lifecycle</string>
            <string name="Source"><![CDATA[--!strict
-- Join and leave, in the right order:
--   join:  session -> load save -> claim a nest -> offline progress -> draw nest
--          -> spawn character -> ready -> tutorial/streak
--   leave: stop raids/riding -> free the nest -> final save + release lock

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Coins = require(script.Parent.Coins)
local Data = require(script.Parent.Data)
local Dinos = require(script.Parent.Dinos)
local Monetization = require(script.Parent.Monetization)
local Plots = require(script.Parent.Plots)
local Progress = require(script.Parent.Progress)
local Raids = require(script.Parent.Raids)
local Sessions = require(script.Parent.Sessions)
local Social = require(script.Parent.Social)
local State = require(script.Parent.State)
local World = require(script.Parent.World)

local Lifecycle = {}

local function onCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid or not humanoid:IsA("Humanoid") then
		return
	end
	humanoid.WalkSpeed = Config.NORMAL_WALKSPEED
	local session = Sessions.get(player)
	if session then
		session.mount = nil
		session.riding = nil
		session.originalHipHeight = nil
		State.markDirty(player)
	end
	task.defer(Social.decorateCharacter, player)
	humanoid.Died:Connect(function()
		Dinos.dismount(player)
		task.delay(3, function()
			if player.Parent ~= nil and Sessions.get(player) then
				player:LoadCharacterAsync()
			end
		end)
	end)
end

local function onJoin(player: Player)
	local session = Sessions.create(player)

	local profile = Data.load(player)
	if player.Parent == nil then
		Data.release(player)
		Sessions.remove(player)
		return
	end
	if not profile then
		Sessions.remove(player)
		player:Kick("We couldn't load your dinos right now. Please rejoin in a moment!")
		return
	end

	local index = Plots.assign(player)
	if not index then
		Data.release(player)
		Sessions.remove(player)
		player:Kick("This island is full! Please join another server.")
		return
	end

	Dinos.applyOffline(player)
	Plots.renderAll(player)
	Coins.setupLeaderstats(player)
	task.spawn(Monetization.onJoin, player)
	task.spawn(Social.onJoin, player)

	local plot = World.getPlot(index)
	if plot then
		player.RespawnLocation = plot.spawn
	end
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	player:LoadCharacterAsync()

	session.ready = true
	Sessions.Ready:fire(player)
	Progress.onJoin(player)
	State.markDirty(player)
end

local function onLeave(player: Player)
	local session = Sessions.get(player)
	if not session then
		return
	end
	local wasReady = session.ready
	session.ready = false
	Sessions.Leaving:fire(player)
	if wasReady then
		Raids.onLeave(player)
		Dinos.dismount(player)
		Social.onLeave(player)
		Plots.release(player)
	end
	Data.release(player)
	Sessions.remove(player)
end

function Lifecycle.init()
	Players.CharacterAutoLoads = false
end

function Lifecycle.start()
	Players.PlayerAdded:Connect(onJoin)
	Players.PlayerRemoving:Connect(onLeave)
	for _, player in Players:GetPlayers() do
		task.spawn(onJoin, player)
	end
end

return Lifecycle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Monetization</string>
            <string name="Source"><![CDATA[--!strict
-- Game passes, developer products, the Dino Club subscription and rewarded
-- video ads. Purchases are granted in ProcessReceipt, which is idempotent: a
-- purchase ID is recorded in the player's save and never granted twice, and we
-- only tell Roblox "granted" after the save succeeds.
--
-- Policy: players for whom PolicyService says paid random items are restricted
-- can't buy coins or luck (both feed the random egg hatches); they earn coins
-- by playing instead. See docs/game-plan.md section 2.5.

local AdService = game:GetService("AdService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Util.Economy)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Net = require(ReplicatedStorage.Shared.Net)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Analytics = require(script.Parent.Analytics)
local Coins = require(script.Parent.Coins)
local Data = require(script.Parent.Data)
local Eggs = require(script.Parent.Eggs)
local Prompts = require(script.Parent.Prompts)
local Raids = require(script.Parent.Raids)
local Sessions = require(script.Parent.Sessions)
local State = require(script.Parent.State)
local Notify = require(script.Parent.Parent.Lib.Notify)
local Stats = require(script.Parent.Parent.Lib.Stats)

local Monetization = {}

-- (player) fired when passes or subscription status change.
Monetization.PassesChanged = Signal.new() :: Signal.Signal<Player>

-- Products that feed random egg results; hidden from restricted players.
local RANDOM_FEEDING: { [string]: boolean } = {
	StarterPack = true,
	CoinsSmall = true,
	CoinsMedium = true,
	CoinsLarge = true,
	CoinsHuge = true,
	CoinsMega = true,
	LuckyPotion = true,
}

-- Products a client may ask to buy (AdCoinBoost only comes from ads).
local SELLABLE: { [string]: boolean } = {
	StarterPack = true,
	CoinsSmall = true,
	CoinsMedium = true,
	CoinsLarge = true,
	CoinsHuge = true,
	CoinsMega = true,
	LuckyPotion = true,
	SuperLock = true,
}

local passKeyById: { [number]: string } = {}
local productKeyById: { [number]: string } = {}

local function productId(key: string): number
	return (Config.PRODUCT_IDS :: { [string]: number })[key] or 0
end

local function passId(key: string): number
	return (Config.GAME_PASS_IDS :: { [string]: number })[key] or 0
end

-- ===== Granting =====

local function grantProduct(player: Player, key: string)
	local profile = Data.get(player)
	local session = Sessions.get(player)
	assert(profile and session, "profile not loaded")
	local now = Clock.now()

	local pack = (Config.COIN_PACKS :: { [string]: { minutes: number, minimum: number } })[key]
	if pack then
		local income = Stats.incomePerSecond(profile, session, now)
		local amount = Economy.incomeReward(income, pack.minutes, pack.minimum)
		Coins.add(player, amount, "IAP", key)
		Notify.send(player, `💰 +{Format.number(amount)} coins! Thank you!`, "good")
	elseif key == "StarterPack" then
		profile.starterPackBought = true
		Coins.add(player, Config.STARTER_PACK.coins, "IAP", key)
		profile.boosts.luckUntil = math.max(profile.boosts.luckUntil, now)
			+ Config.STARTER_PACK.luckSeconds
		Notify.send(player, "🎁 Starter Pack: coins + 30 minutes of Luck!", "good")
	elseif
		key == "InstantHatchSmall"
		or key == "InstantHatchMedium"
		or key == "InstantHatchLarge"
	then
		local slot = session.pendingInstantHatch
		session.pendingInstantHatch = nil
		if not Eggs.finishNow(player, slot) then
			profile.instantHatchTokens += 1
			Notify.send(player, "⚡ Saved an Instant Hatch for your next egg!", "good")
		end
	elseif key == "LuckyPotion" then
		profile.boosts.luckUntil = math.max(profile.boosts.luckUntil, now)
			+ Config.LUCK_POTION_SECONDS
		Notify.send(player, "🍀 Lucky Potion active! Rare dinos are twice as likely.", "good")
	elseif key == "SuperLock" then
		Raids.superLock(player)
		Notify.send(player, "🔒 Super Lock! Your nest is sealed for 5 minutes.", "good")
	elseif key == "AdCoinBoost" then
		profile.boosts.coinsUntil = math.max(profile.boosts.coinsUntil, now)
			+ Config.AD_BOOST_SECONDS
		Notify.send(player, "⚡ 2x Coins for 10 minutes! Thanks for watching.", "good")
	else
		error(`unknown product {key}`)
	end
	State.markDirty(player)
end

local function processReceipt(receiptInfo: { [string]: any }): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local profile = Data.get(player)
	local session = Sessions.get(player)
	if not profile or not session or not session.ready then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receiptInfo.PurchaseId)
	if Data.hasReceipt(profile, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local key = productKeyById[receiptInfo.ProductId]
	if not key then
		warn(`[Monetization] unknown product id {receiptInfo.ProductId}`)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local granted = table.pack(pcall(grantProduct, player, key))
	if not granted[1] then
		warn(`[Monetization] grant {key} failed: {granted[2]}`)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	Data.addReceipt(profile, purchaseId)
	Analytics.event(player, "Purchase" .. key, receiptInfo.CurrencySpent)
	if Data.saveNow(player) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	-- Granted in memory and recorded; Roblox will retry and the receipt check
	-- above prevents a second grant.
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

-- ===== Prompting =====

local function instantHatchProduct(secondsLeft: number): string
	if secondsLeft <= Config.INSTANT_HATCH_SMALL_MAX_SECONDS then
		return "InstantHatchSmall"
	elseif secondsLeft <= Config.INSTANT_HATCH_MEDIUM_MAX_SECONDS then
		return "InstantHatchMedium"
	end
	return "InstantHatchLarge"
end

function Monetization.promptInstantHatch(player: Player, slot: string)
	local profile = Data.get(player)
	local session = Sessions.get(player)
	if not profile or not session then
		return
	end
	local egg = profile.incubators[slot]
	local now = Clock.now()
	if not egg or egg.hatchAt <= now then
		return
	end
	if profile.instantHatchTokens > 0 then
		profile.instantHatchTokens -= 1
		Eggs.finishNow(player, slot)
		State.markDirty(player)
		return
	end
	local key = instantHatchProduct(egg.hatchAt - now)
	local id = productId(key)
	if id == 0 then
		Notify.send(player, "Instant Hatch isn't set up yet (add product IDs in Config).", "info")
		return
	end
	session.pendingInstantHatch = slot
	MarketplaceService:PromptProductPurchase(player, id)
end

local function promptPurchase(player: Player, kind: unknown, key: unknown, context: unknown)
	local session = Sessions.get(player)
	local profile = Data.get(player)
	if not session or not profile or not session.ready then
		return
	end
	if typeof(kind) ~= "string" or typeof(key) ~= "string" then
		return
	end
	if kind == "pass" then
		local id = passId(key)
		if id == 0 then
			Notify.send(player, "This pass isn't set up yet (add its ID in Config).", "info")
			return
		end
		if not Stats.hasPass(session, key) then
			MarketplaceService:PromptGamePassPurchase(player, id)
		end
	elseif kind == "product" then
		if key == "InstantHatch" then
			if typeof(context) == "string" and tonumber(context) then
				Monetization.promptInstantHatch(player, context)
			end
			return
		end
		if not SELLABLE[key] then
			return
		end
		if session.restricted and RANDOM_FEEDING[key] then
			return
		end
		if key == "StarterPack" and profile.starterPackBought then
			return
		end
		local id = productId(key)
		if id == 0 then
			Notify.send(player, "This item isn't set up yet (add its ID in Config).", "info")
			return
		end
		MarketplaceService:PromptProductPurchase(player, id)
	elseif kind == "subscription" then
		if Config.SUBSCRIPTION_ID ~= "" and not session.subscribed then
			MarketplaceService:PromptSubscriptionPurchase(player, Config.SUBSCRIPTION_ID)
		end
	end
end

-- ===== Ownership checks =====

local function refreshSubscription(player: Player)
	local session = Sessions.get(player)
	if not session or Config.SUBSCRIPTION_ID == "" then
		return
	end
	local ok, status = pcall(function()
		return MarketplaceService:GetUserSubscriptionStatusAsync(player, Config.SUBSCRIPTION_ID)
	end)
	if ok and type(status) == "table" then
		session.subscribed = status.IsSubscribed == true
		Monetization.PassesChanged:fire(player)
		State.markDirty(player)
	end
end

-- Called by Lifecycle when a player joins (yields; run in its own thread).
function Monetization.onJoin(player: Player)
	local session = Sessions.get(player)
	if not session then
		return
	end
	for key, id in Config.GAME_PASS_IDS :: { [string]: number } do
		if id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
			end)
			if ok and owns then
				session.passes[key] = true
			end
		end
	end
	local ok, policy = pcall(function()
		return PolicyService:GetPolicyInfoForPlayerAsync(player)
	end)
	if ok and type(policy) == "table" then
		session.restricted = policy.ArePaidRandomItemsRestricted == true
		session.tradingAllowed = policy.IsPaidItemTradingAllowed == true
	else
		-- Unknown policy: be safe in live games, permissive while testing in Studio.
		session.restricted = not RunService:IsStudio()
	end
	refreshSubscription(player)
	Monetization.PassesChanged:fire(player)
	State.markDirty(player)
end

-- QA: toggle a pass without buying it (Studio / dev allowlist only; checked by Cheats).
function Monetization.toggleFakePass(player: Player, key: string)
	local session = Sessions.get(player)
	if not session or (Config.GAME_PASS_IDS :: { [string]: number })[key] == nil then
		return
	end
	if session.fakePasses[key] then
		session.fakePasses[key] = nil
	else
		session.fakePasses[key] = true
	end
	Monetization.PassesChanged:fire(player)
	State.markDirty(player)
end

local function watchAd(player: Player)
	local session = Sessions.get(player)
	local id = productId("AdCoinBoost")
	if not session or id == 0 then
		return
	end
	local ok, result = pcall(function()
		local reward = AdService:CreateAdRewardFromDevProductId(id)
		return AdService:ShowRewardedVideoAdAsync(player, reward)
	end)
	if not ok then
		Notify.send(player, "No video available right now. Try again later!", "info")
	elseif result ~= Enum.ShowAdResult.ShowCompleted then
		Notify.send(player, "Watch the whole video to get the reward.", "info")
	end
	-- The reward itself arrives through ProcessReceipt (AdCoinBoost).
end

function Monetization.init()
	for key, id in Config.GAME_PASS_IDS :: { [string]: number } do
		if id ~= 0 then
			passKeyById[id] = key
		end
	end
	for key, id in Config.PRODUCT_IDS :: { [string]: number } do
		if id ~= 0 then
			productKeyById[id] = key
		end
	end

	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(
		function(player: Player, id: number, purchased: boolean)
			local key = passKeyById[id]
			local session = Sessions.get(player)
			if purchased and key and session then
				session.passes[key] = true
				Analytics.event(player, "Pass" .. key)
				Notify.send(player, "🎉 Thanks for your support! Your pass is active.", "good")
				Monetization.PassesChanged:fire(player)
				State.markDirty(player)
			end
		end
	)

	MarketplaceService.PromptSubscriptionPurchaseFinished:Connect(function(player: Player)
		refreshSubscription(player)
	end)
	Players.UserSubscriptionStatusChanged:Connect(function(player: Player)
		refreshSubscription(player)
	end)

	Net.on("PromptPurchase", 2, 4, promptPurchase)
	Net.on("WatchAd", 1 / 15, 1, function(player: Player)
		watchAd(player)
	end)

	Prompts.register("InstantHatch", function(player: Player, prompt: ProximityPrompt)
		local slot = Prompts.key(prompt)
		if slot and Prompts.ownerId(prompt) == player.UserId then
			Monetization.promptInstantHatch(player, slot)
		end
	end)
end

return Monetization
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Nest</string>
            <string name="Source"><![CDATA[--!strict
-- Operations on a player's nest: dinos, incubators and the laid-egg tray.
-- Every change re-renders the plot and marks the HUD dirty. Higher-level
-- systems (Eggs, Raids, Progress...) build on these.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Config = require(ReplicatedStorage.Shared.Config)
local DinoData = require(ReplicatedStorage.Shared.Data.DinoData)
local Growth = require(ReplicatedStorage.Shared.Util.Growth)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Types = require(ReplicatedStorage.Shared.Types)
local Data = require(script.Parent.Data)
local Plots = require(script.Parent.Plots)
local Sessions = require(script.Parent.Sessions)
local State = require(script.Parent.State)
local Stats = require(script.Parent.Parent.Lib.Stats)

local Nest = {}

-- (player, dino) fired whenever a dino is added or changes mutation; Progress
-- uses it to fill in the Dino-Dex.
Nest.DinoChanged = Signal.new() :: Signal.Signal<Player, Types.DinoRecord>

function Nest.newId(profile: Types.Profile): string
	local id = tostring(profile.nextId)
	profile.nextId += 1
	return id
end

function Nest.findDino(profile: Types.Profile, id: string): (Types.DinoRecord?, number?)
	for index, dino in profile.dinos do
		if dino.id == id then
			return dino, index
		end
	end
	return nil, nil
end

function Nest.hasFreeSlot(player: Player): boolean
	local profile = Data.get(player)
	local session = Sessions.get(player)
	if not profile or not session then
		return false
	end
	return #profile.dinos < Stats.maxSlots(profile, session)
end

-- Adds a dino at the given stage (default Baby). Returns nil if the nest is full.
function Nest.addDino(
	player: Player,
	species: string,
	mutation: string?,
	stage: number?
): Types.DinoRecord?
	local profile = Data.get(player)
	local data = DinoData.get(species)
	if not profile or not data or not Nest.hasFreeSlot(player) then
		return nil
	end
	local now = Clock.now()
	local dino: Types.DinoRecord = {
		id = Nest.newId(profile),
		species = species,
		mutation = mutation,
		bornAt = Growth.bornAtForStage(now, stage or Growth.BABY, data.growth),
		lastLaidAt = 0,
	}
	table.insert(profile.dinos, dino)
	Plots.syncDinos(player)
	State.markDirty(player)
	Nest.DinoChanged:fire(player, dino)
	return dino
end

function Nest.removeDino(player: Player, id: string): Types.DinoRecord?
	local profile = Data.get(player)
	if not profile then
		return nil
	end
	local dino, index = Nest.findDino(profile, id)
	if not dino or not index then
		return nil
	end
	table.remove(profile.dinos, index)
	Plots.syncDinos(player)
	State.markDirty(player)
	return dino
end

function Nest.setMutation(player: Player, id: string, mutation: string)
	local profile = Data.get(player)
	if not profile then
		return
	end
	local dino = Nest.findDino(profile, id)
	if not dino then
		return
	end
	dino.mutation = mutation
	Plots.syncDinos(player)
	State.markDirty(player)
	Nest.DinoChanged:fire(player, dino)
end

-- ===== Incubators =====

function Nest.freeIncubator(player: Player): string?
	local profile = Data.get(player)
	if not profile then
		return nil
	end
	for slot = 1, Stats.maxIncubators(profile) do
		local key = tostring(slot)
		if profile.incubators[key] == nil then
			return key
		end
	end
	return nil
end

-- Puts an egg into a free incubator. Returns the slot, or nil if all are full.
function Nest.placeEgg(player: Player, egg: Types.IncubatorEgg): string?
	local profile = Data.get(player)
	local slot = Nest.freeIncubator(player)
	if not profile or not slot then
		return nil
	end
	profile.incubators[slot] = egg
	Plots.syncIncubators(player)
	State.markDirty(player)
	return slot
end

function Nest.removeEgg(player: Player, slot: string): Types.IncubatorEgg?
	local profile = Data.get(player)
	if not profile then
		return nil
	end
	local egg = profile.incubators[slot]
	if not egg then
		return nil
	end
	profile.incubators[slot] = nil
	Plots.syncIncubators(player)
	State.markDirty(player)
	return egg
end

function Nest.setHatchAt(player: Player, slot: string, hatchAt: number)
	local profile = Data.get(player)
	local egg = profile and profile.incubators[slot]
	if not egg then
		return
	end
	egg.hatchAt = hatchAt
	Plots.syncIncubators(player)
	State.markDirty(player)
end

-- ===== Tray =====

function Nest.findTrayEgg(profile: Types.Profile, id: string): (Types.TrayEgg?, number?)
	for index, egg in profile.tray do
		if egg.id == id then
			return egg, index
		end
	end
	return nil, nil
end

function Nest.trayRoom(profile: Types.Profile): number
	return Config.TRAY_CAPACITY - #profile.tray
end

function Nest.addTrayEgg(player: Player, species: string): Types.TrayEgg?
	local profile = Data.get(player)
	if not profile or Nest.trayRoom(profile) <= 0 then
		return nil
	end
	local egg: Types.TrayEgg = { id = Nest.newId(profile), species = species, laidAt = Clock.now() }
	table.insert(profile.tray, egg)
	Plots.syncTray(player)
	State.markDirty(player)
	return egg
end

function Nest.removeTrayEgg(player: Player, id: string): Types.TrayEgg?
	local profile = Data.get(player)
	if not profile then
		return nil
	end
	local egg, index = Nest.findTrayEgg(profile, id)
	if not egg or not index then
		return nil
	end
	table.remove(profile.tray, index)
	Plots.syncTray(player)
	State.markDirty(player)
	return egg
end

return Nest
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Plots</string>
            <string name="Source"><![CDATA[--!strict
-- Gives each player a nest (plot) and draws their dinos, incubator eggs and
-- laid eggs into the world from their profile. Rendering is diff-based: a
-- model is only rebuilt when that dino's stage or mutation changes.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Config = require(ReplicatedStorage.Shared.Config)
local DinoData = require(ReplicatedStorage.Shared.Data.DinoData)
local DinoModel = require(ReplicatedStorage.Shared.Visual.DinoModel)
local EggData = require(ReplicatedStorage.Shared.Data.EggData)
local EggModel = require(ReplicatedStorage.Shared.Visual.EggModel)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Growth = require(ReplicatedStorage.Shared.Util.Growth)
local MutationData = require(ReplicatedStorage.Shared.Data.MutationData)
local Types = require(ReplicatedStorage.Shared.Types)
local Data = require(script.Parent.Data)
local Prompts = require(script.Parent.Prompts)
local Sessions = require(script.Parent.Sessions)
local World = require(script.Parent.World)
local Stats = require(script.Parent.Parent.Lib.Stats)

local Plots = {}

Plots.EGG_TAG = "IncubatorEgg"

type DinoRender = { model: Model, stage: number, mutation: string, home: number }
type EggRender = { id: string, model: Model }

type Render = {
	dinos: { [string]: DinoRender },
	eggs: { [string]: EggRender }, -- by incubator slot ("1".."5")
	tray: { [string]: Model }, -- by tray egg id
	hiddenTray: { [string]: boolean },
}

local renders: { [Player]: Render } = {}
local owners: { [number]: Player } = {} -- plot index -> player

local function plotFor(player: Player): World.PlotInfo?
	local session = Sessions.get(player)
	if not session or session.plotIndex == 0 then
		return nil
	end
	return World.getPlot(session.plotIndex)
end

function Plots.ownerOf(index: number): Player?
	return owners[index]
end

-- Claim the first free plot. Returns its index or nil when the server is full.
function Plots.assign(player: Player): number?
	local session = Sessions.get(player)
	if not session then
		return nil
	end
	for index = 1, Config.PLOT_COUNT do
		if not owners[index] then
			owners[index] = player
			session.plotIndex = index
			renders[player] = { dinos = {}, eggs = {}, tray = {}, hiddenTray = {} }
			local plot = World.getPlot(index)
			if plot then
				plot.model:SetAttribute("OwnerId", player.UserId)
			end
			Plots.updateSign(player)
			return index
		end
	end
	return nil
end

local function clearFolder(folder: Instance)
	for _, child in folder:GetChildren() do
		child:Destroy()
	end
end

function Plots.release(player: Player)
	local session = Sessions.get(player)
	if not session or session.plotIndex == 0 then
		return
	end
	local index = session.plotIndex
	local plot = World.getPlot(index)
	if plot then
		clearFolder(plot.dinoFolder)
		clearFolder(plot.eggFolder)
		clearFolder(plot.trayFolder)
		plot.model:SetAttribute("OwnerId", 0)
		plot.model:SetAttribute("LockedUntil", 0)
		plot.model:SetAttribute("ShieldUntil", 0)
		World.setSign(plot, "Empty Nest", "Waiting for a new owner")
		plot.padLabel.Text = "💰 0"
		for _, wall in plot.barrier do
			wall.Transparency = 1
		end
		for slot = 1, Config.MAX_INCUBATORS do
			plot.incubatorLocks[slot].Enabled = false
			plot.incubatorRings[slot].Transparency = 0
		end
	end
	owners[index] = nil
	renders[player] = nil
	session.plotIndex = 0
end

function Plots.updateSign(player: Player)
	local plot = plotFor(player)
	local profile = Data.get(player)
	if not plot then
		return
	end
	local likes = if profile then profile.likes else 0
	local shielded = profile ~= nil and Stats.shieldUntil(profile) > Clock.now()
	local info = `❤ {Format.number(likes)} likes`
		.. (if shielded then "  🛡 New Nest Shield" else "")
	World.setSign(plot, `{player.DisplayName}'s Nest`, info)
	if profile then
		plot.model:SetAttribute("ShieldUntil", Stats.shieldUntil(profile))
	end
end

function Plots.updatePad(player: Player, amount: number)
	local plot = plotFor(player)
	if plot then
		plot.padLabel.Text = "💰 " .. Format.number(math.floor(amount))
	end
end

function Plots.setBarrier(player: Player, lockedUntil: number)
	local plot = plotFor(player)
	if not plot then
		return
	end
	plot.model:SetAttribute("LockedUntil", lockedUntil)
	local locked = lockedUntil > Clock.now()
	for _, wall in plot.barrier do
		wall.Transparency = if locked then 0.35 else 1
	end
end

-- ===== Dinos =====

local function labelFor(dino: Types.DinoRecord, stage: number): string
	local species = DinoData.get(dino.species)
	local name = if species then species.name else dino.species
	local mutation = MutationData.get(dino.mutation)
	local prefix = if mutation then mutation.emoji .. " " .. mutation.name .. " " else ""
	return `{prefix}{name} • {Growth.stageName(stage)}`
end

local function buildDino(
	player: Player,
	plot: World.PlotInfo,
	dino: Types.DinoRecord,
	stage: number,
	home: number
): Model
	local model = DinoModel.build(dino.species, stage, dino.mutation, "World")
	model.Name = "Dino_" .. dino.id
	model:SetAttribute("DinoId", dino.id)
	model:SetAttribute("OwnerId", player.UserId)
	model:SetAttribute("Species", dino.species)
	model:SetAttribute("Stage", stage)
	local spot = plot.homeSpots[math.clamp(home, 1, #plot.homeSpots)]
	model:SetAttribute("Home", spot)
	model:PivotTo(spot)

	local root = model.PrimaryPart :: BasePart
	local promptAttachment = root:FindFirstChild("PromptAttachment")
	local height = model:GetAttribute("Height")
	local reach = 8 + (if typeof(height) == "number" then height * 0.6 else 0)
	Prompts.create(promptAttachment or root, {
		action = "OpenUI",
		openUI = "Dino",
		text = "View",
		objectText = (DinoData.get(dino.species) :: DinoData.Species).name,
		audience = "Owner",
		ownerId = player.UserId,
		key = dino.id,
		distance = reach,
	})

	local labelAttachment = root:FindFirstChild("LabelAttachment")
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.fromOffset(170, 30)
	gui.MaxDistance = 40
	gui.LightInfluence = 0
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.TextColor3 = Color3.new(1, 1, 1)
	text.TextStrokeTransparency = 0.3
	text.Text = labelFor(dino, stage)
	text.Parent = gui
	gui.Parent = labelAttachment or root

	CollectionService:AddTag(model, DinoModel.TAG)
	model.Parent = plot.dinoFolder
	return model
end

function Plots.syncDinos(player: Player)
	local plot = plotFor(player)
	local profile = Data.get(player)
	local render = renders[player]
	if not plot or not profile or not render then
		return
	end
	local now = Clock.now()
	local seen: { [string]: boolean } = {}
	for home, dino in profile.dinos do
		seen[dino.id] = true
		local stage = Stats.dinoStage(dino, now)
		local mutation = dino.mutation or ""
		local existing: DinoRender? = render.dinos[dino.id]
		if existing and (existing.stage ~= stage or existing.mutation ~= mutation) then
			existing.model:Destroy()
			existing = nil
		end
		if not existing then
			local model = buildDino(player, plot, dino, stage, home)
			render.dinos[dino.id] =
				{ model = model, stage = stage, mutation = mutation, home = home }
		elseif existing.home ~= home then
			local spot = plot.homeSpots[math.clamp(home, 1, #plot.homeSpots)]
			existing.model:SetAttribute("Home", spot)
			existing.model:PivotTo(spot)
			existing.home = home
		end
	end
	for id, entry in render.dinos do
		if not seen[id] then
			entry.model:Destroy()
			render.dinos[id] = nil
		end
	end
end

function Plots.dinoModel(player: Player, dinoId: string): Model?
	local render = renders[player]
	local entry = render and render.dinos[dinoId]
	return if entry then entry.model else nil
end

-- ===== Incubators =====

local function eggLook(egg: Types.IncubatorEgg): EggModel.Look
	if egg.kind == "shop" and egg.eggType and EggData.get(egg.eggType) then
		return EggModel.lookForShopEgg(egg.eggType)
	elseif egg.kind == "gift" then
		return EggModel.giftLook()
	elseif egg.species and DinoData.get(egg.species) then
		return EggModel.lookForSpecies(egg.species)
	end
	return EggModel.giftLook()
end

local function eggTitle(egg: Types.IncubatorEgg): string
	if egg.kind == "shop" and egg.eggType then
		local data = EggData.get(egg.eggType)
		return if data then data.name else "Egg"
	elseif egg.kind == "gift" then
		return "Gift Egg"
	elseif egg.kind == "starter" then
		return "Starter Egg"
	end
	local species = egg.species and DinoData.get(egg.species)
	return if species then species.name .. " Egg" else "Egg"
end

local function buildIncubatorEgg(
	player: Player,
	plot: World.PlotInfo,
	slot: string,
	egg: Types.IncubatorEgg
): Model
	local pedestal = plot.incubators[tonumber(slot) :: number]
	local model = EggModel.build(eggLook(egg), 3.4)
	model.Name = "IncubatorEgg" .. slot
	model:SetAttribute("EggId", egg.id)
	model:SetAttribute("Slot", slot)
	model:SetAttribute("OwnerId", player.UserId)
	model:SetAttribute("HatchAt", egg.hatchAt)
	model:SetAttribute("Title", eggTitle(egg))
	model:PivotTo(
		CFrame.new(pedestal.CFrame.Position + Vector3.new(0, pedestal.Size.X / 2 + 0.1, 0))
	)

	local root = model.PrimaryPart :: BasePart
	local promptAttachment = Instance.new("Attachment")
	promptAttachment.Position = Vector3.new(0, 1.8, 0)
	promptAttachment.Parent = root
	Prompts.create(promptAttachment, {
		action = "IncubatorTap",
		text = "Warm",
		objectText = eggTitle(egg),
		audience = "Owner",
		ownerId = player.UserId,
		key = slot,
		distance = 10,
	})
	Prompts.create(promptAttachment, {
		action = "InstantHatch",
		text = "⚡ Instant Hatch",
		audience = "Owner",
		ownerId = player.UserId,
		key = slot,
		keyCode = Enum.KeyCode.F,
		distance = 10,
		hideInTutorial = true,
	})

	local gui = Instance.new("BillboardGui")
	gui.Name = "Timer"
	gui.Size = UDim2.fromOffset(150, 46)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 5.2, 0)
	gui.MaxDistance = 60
	gui.LightInfluence = 0
	local text = Instance.new("TextLabel")
	text.Name = "Text"
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.TextColor3 = Color3.new(1, 1, 1)
	text.TextStrokeTransparency = 0.2
	text.Text = ""
	text.Parent = gui
	gui.Parent = root

	CollectionService:AddTag(model, Plots.EGG_TAG)
	model.Parent = plot.eggFolder
	return model
end

function Plots.syncIncubators(player: Player)
	local plot = plotFor(player)
	local profile = Data.get(player)
	local render = renders[player]
	if not plot or not profile or not render then
		return
	end
	local maxIncubators = Stats.maxIncubators(profile)
	for slot = 1, Config.MAX_INCUBATORS do
		local unlocked = slot <= maxIncubators
		plot.incubatorLocks[slot].Enabled = not unlocked
		plot.incubatorRings[slot].Transparency = if unlocked then 0 else 0.8
		local key = tostring(slot)
		local egg = profile.incubators[key]
		local existing: EggRender? = render.eggs[key]
		if existing and (not egg or existing.id ~= egg.id) then
			existing.model:Destroy()
			render.eggs[key] = nil
			existing = nil
		end
		if egg and not existing then
			render.eggs[key] = { id = egg.id, model = buildIncubatorEgg(player, plot, key, egg) }
		elseif egg and existing then
			existing.model:SetAttribute("HatchAt", egg.hatchAt)
		end
	end
end

function Plots.incubatorPosition(player: Player, slot: string): Vector3?
	local plot = plotFor(player)
	local index = tonumber(slot)
	if not plot or not index or not plot.incubators[index] then
		return nil
	end
	return plot.incubators[index].CFrame.Position
end

-- Brief sparkle flag the client shows when a friend is warming the egg.
function Plots.flagFriendWarm(player: Player, slot: string)
	local render = renders[player]
	local entry = render and render.eggs[slot]
	if entry then
		entry.model:SetAttribute("FriendWarmAt", Clock.now())
	end
end

-- ===== Laid-egg tray =====

local function buildTrayEgg(
	player: Player,
	plot: World.PlotInfo,
	egg: Types.TrayEgg,
	spot: number
): Model
	local model = EggModel.build(EggModel.lookForSpecies(egg.species), 2.2)
	model.Name = "TrayEgg_" .. egg.id
	model:SetAttribute("EggId", egg.id)
	model:SetAttribute("OwnerId", player.UserId)
	model:SetAttribute("Species", egg.species)
	model:PivotTo(plot.traySpots[math.clamp(spot, 1, #plot.traySpots)])
	local root = model.PrimaryPart :: BasePart
	local attachment = Instance.new("Attachment")
	attachment.Position = Vector3.new(0, 1.2, 0)
	attachment.Parent = root
	local species = DinoData.get(egg.species)
	local name = if species then species.name .. " Egg" else "Egg"
	Prompts.create(attachment, {
		action = "TrayIncubate",
		text = "Incubate",
		objectText = name,
		audience = "Owner",
		ownerId = player.UserId,
		plotIndex = plot.index,
		key = egg.id,
		distance = 8,
	})
	Prompts.create(attachment, {
		action = "TraySell",
		text = "Sell",
		objectText = name,
		audience = "Owner",
		ownerId = player.UserId,
		plotIndex = plot.index,
		key = egg.id,
		keyCode = Enum.KeyCode.F,
		distance = 8,
	})
	Prompts.create(attachment, {
		action = "Steal",
		text = "Steal!",
		objectText = name,
		audience = "Others",
		ownerId = player.UserId,
		plotIndex = plot.index,
		key = egg.id,
		hold = Config.STEAL_HOLD_SECONDS,
		distance = 8,
		nightOnly = true,
	})
	model.Parent = plot.trayFolder
	return model
end

function Plots.syncTray(player: Player)
	local plot = plotFor(player)
	local profile = Data.get(player)
	local render = renders[player]
	if not plot or not profile or not render then
		return
	end
	local seen: { [string]: boolean } = {}
	for spot, egg in profile.tray do
		if render.hiddenTray[egg.id] then
			continue
		end
		seen[egg.id] = true
		local existing = render.tray[egg.id]
		if not existing then
			render.tray[egg.id] = buildTrayEgg(player, plot, egg, spot)
		else
			existing:PivotTo(plot.traySpots[math.clamp(spot, 1, #plot.traySpots)])
		end
	end
	for id, model in render.tray do
		if not seen[id] then
			model:Destroy()
			render.tray[id] = nil
		end
	end
end

-- Hide a tray egg while a thief is carrying it (it stays in the owner's
-- profile until the thief actually gets home with it).
function Plots.setTrayEggHidden(player: Player, eggId: string, hidden: boolean)
	local render = renders[player]
	if not render then
		return
	end
	if hidden then
		render.hiddenTray[eggId] = true
	else
		render.hiddenTray[eggId] = nil
	end
	Plots.syncTray(player)
end

function Plots.isTrayEggHidden(player: Player, eggId: string): boolean
	local render = renders[player]
	if not render then
		return false
	end
	return render.hiddenTray[eggId] == true
end

function Plots.trayPosition(player: Player): Vector3?
	local plot = plotFor(player)
	if not plot then
		return nil
	end
	return plot.traySpots[1].Position
end

function Plots.renderAll(player: Player)
	Plots.syncDinos(player)
	Plots.syncIncubators(player)
	Plots.syncTray(player)
	Plots.updateSign(player)
	local session = Sessions.get(player)
	if session then
		Plots.setBarrier(player, session.lockUntil)
	end
end

return Plots
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">Progress</string>
            <string name="Source"><![CDATA[--!strict
-- Tutorial steps (with onboarding funnel analytics), the Dino-Dex, the 7-day
-- login streak and the Dino Club daily reward.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Config = require(ReplicatedStorage.Shared.Config)
local Cycle = require(ReplicatedStorage.Shared.Util.Cycle)
local DinoData = require(ReplicatedStorage.Shared.Data.DinoData)
local Economy = require(ReplicatedStorage.Shared.Util.Economy)
local Net = require(ReplicatedStorage.Shared.Net)
local Streak = require(ReplicatedStorage.Shared.Util.Streak)
local TutorialData = require(ReplicatedStorage.Shared.Data.TutorialData)
local Types = require(ReplicatedStorage.Shared.Types)
local Analytics = require(script.Parent.Analytics)
local Coins = require(script.Parent.Coins)
local Data = require(script.Parent.Data)
local Nest = require(script.Parent.Nest)
local Sessions = require(script.Parent.Sessions)
local State = require(script.Parent.State)
local Notify = require(script.Parent.Parent.Lib.Notify)
local Stats = require(script.Parent.Parent.Lib.Stats)

local Progress = {}

-- ===== Tutorial =====

local function setStep(player: Player, profile: Types.Profile, step: number)
	profile.tutorial = step
	if step == TutorialData.DONE then
		Analytics.funnel(player, #TutorialData.STEPS + 1, "Completed")
	else
		local info = TutorialData.STEPS[step]
		if info then
			Analytics.funnel(player, step, info.funnelName)
		end
	end
	State.markDirty(player)
end

local function hasEggOfKind(profile: Types.Profile, kind: Types.EggKind): boolean
	for _, egg in profile.incubators do
		if egg.kind == kind then
			return true
		end
	end
	return false
end

local function giveStarterEgg(player: Player, profile: Types.Profile)
	local now = Clock.now()
	Nest.placeEgg(player, {
		id = Nest.newId(profile),
		kind = "starter",
		species = TutorialData.STARTER_SPECIES,
		placedAt = now,
		hatchAt = now + Config.STARTER_EGG_SECONDS,
	})
end

local function ensureGift(player: Player, profile: Types.Profile)
	if profile.tutorial ~= 4 or hasEggOfKind(profile, "gift") then
		return
	end
	local now = Clock.now()
	local slot = Nest.placeEgg(player, {
		id = Nest.newId(profile),
		kind = "gift",
		species = TutorialData.GIFT_SPECIES,
		mutation = TutorialData.GIFT_MUTATION,
		placedAt = now,
		hatchAt = now + Config.GIFT_EGG_SECONDS,
	})
	if slot then
		Notify.send(player, "🎁 A shiny Gift Egg appeared in your nest!", "rare")
	end
end

-- Tutorial events: "hatch_starter", "collect", "buy_egg", "hatch_gift", "hatch",
-- "chased", "finish".
function Progress.event(player: Player, name: string)
	local profile = Data.get(player)
	if not profile or profile.tutorial == TutorialData.DONE or profile.tutorial == 0 then
		return
	end
	local step = profile.tutorial
	if name == "hatch_starter" and step == 1 then
		setStep(player, profile, 2)
	elseif name == "collect" and step == 2 then
		setStep(player, profile, 3)
	elseif name == "buy_egg" and step >= 1 and step <= 3 then
		setStep(player, profile, 4)
		ensureGift(player, profile)
	elseif name == "hatch_gift" and step == 4 then
		setStep(player, profile, 5)
	elseif name == "hatch" and step == 4 then
		ensureGift(player, profile)
	elseif name == "chased" and step == 5 then
		setStep(player, profile, 6)
	elseif name == "finish" and step == 6 then
		setStep(player, profile, TutorialData.DONE)
		Notify.send(
			player,
			"🎉 You're a real dino keeper now! Come back tomorrow for streak rewards.",
			"good"
		)
	end
end

-- ===== Dino-Dex =====

local function dexCount(profile: Types.Profile): number
	local count = 0
	for _ in profile.dex do
		count += 1
	end
	return count
end

local function recordDex(player: Player, dino: Types.DinoRecord)
	local profile = Data.get(player)
	if not profile then
		return
	end
	local entry = profile.dex[dino.species]
	local isNewSpecies = entry == nil
	if not entry then
		entry = {}
		profile.dex[dino.species] = entry
	end
	local key = dino.mutation or "Normal"
	if entry[key] then
		return
	end
	entry[key] = true
	Coins.setDexCount(player, dexCount(profile))
	State.markDirty(player)
	local species = DinoData.get(dino.species)
	if isNewSpecies and species then
		Notify.effect(player, "Dex", { species = dino.species })
	end
end

-- ===== Streak + club =====

local function grantStreakReward(
	player: Player,
	profile: Types.Profile,
	reward: Streak.Reward
): string
	local session = Sessions.get(player)
	local now = Clock.now()
	if reward.kind == "coins" and session then
		local income = Stats.incomePerSecond(profile, session, now)
		local amount = Economy.incomeReward(income, reward.minutes or 10, reward.minimum or 100)
		Coins.add(player, amount, "TimedReward", "Streak")
		return `💰 {amount} coins`
	elseif reward.kind == "luck" then
		profile.boosts.luckUntil = math.max(profile.boosts.luckUntil, now) + (reward.seconds or 900)
		return "🍀 Luck boost"
	elseif reward.kind == "coinBoost" then
		profile.boosts.coinsUntil = math.max(profile.boosts.coinsUntil, now)
			+ (reward.seconds or 1800)
		return "⚡ 2x Coins boost"
	elseif reward.kind == "dino" and reward.species then
		local dino = Nest.addDino(player, reward.species)
		if dino then
			return "🦕 A new baby dino"
		end
		Coins.add(player, 25000, "TimedReward", "StreakFallback")
		return "💰 25000 coins (your nest was full)"
	end
	return "a reward"
end

local function claimStreak(player: Player)
	local profile = Data.get(player)
	if not profile then
		return
	end
	local today = Cycle.dayNumber(Clock.now())
	local canClaim, day = Streak.status(profile.streak, today)
	if not canClaim then
		return
	end
	local reward = Streak.REWARDS[day]
	profile.streak = { count = day, lastDay = today }
	local what = grantStreakReward(player, profile, reward)
	Analytics.event(player, "StreakDay" .. day)
	Notify.send(player, `Day {day} reward: {what}!`, "good")
	Notify.effect(player, "Reward", { day = day })
	State.markDirty(player)
end

local function claimClub(player: Player)
	local profile = Data.get(player)
	local session = Sessions.get(player)
	if not profile or not session or not session.subscribed then
		return
	end
	local today = Cycle.dayNumber(Clock.now())
	if profile.club.lastClaimDay == today then
		return
	end
	profile.club.lastClaimDay = today
	local income = Stats.incomePerSecond(profile, session, Clock.now())
	local amount = Economy.incomeReward(
		income,
		Config.CLUB_DAILY_COINS.minutes,
		Config.CLUB_DAILY_COINS.minimum
	)
	Coins.add(player, amount, "TimedReward", "DinoClub")
	Notify.send(player, `🦖 Dino Club daily gift: {amount} coins!`, "good")
	State.markDirty(player)
end

-- Called by Lifecycle once the player's nest is ready.
function Progress.onJoin(player: Player)
	local profile = Data.get(player)
	if not profile then
		return
	end
	Coins.setDexCount(player, dexCount(profile))
	if profile.tutorial == 0 then
		giveStarterEgg(player, profile)
		setStep(player, profile, 1)
	elseif
		profile.tutorial == 1
		and not hasEggOfKind(profile, "starter")
		and #profile.dinos == 0
	then
		giveStarterEgg(player, profile)
	elseif profile.tutorial == 4 then
		ensureGift(player, profile)
	end
	local canClaim = Streak.status(profile.streak, Cycle.dayNumber(Clock.now()))
	if canClaim and profile.tutorial == TutorialData.DONE then
		Notify.send(player, "🎁 Your daily streak reward is ready!", "good")
	end
end

function Progress.init()
	Nest.DinoChanged:connect(recordDex)
	Net.on("ClaimStreak", 1, 2, function(player: Player)
		claimStreak(player)
	end)
	Net.on("ClaimClub", 1, 2, function(player: Player)
		claimClub(player)
	end)
	Net.on("TutorialAction", 2, 4, function(player: Player, action: unknown)
		if action == "ChasedThief" then
			Progress.event(player, "chased")
		elseif action == "Finish" then
			Progress.event(player, "finish")
		end
	end)
end

return Progress
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">Prompts</string>
            <string name="Source"><![CDATA[--!strict
-- One place that creates ProximityPrompts and routes their triggers to the
-- system that owns each action. Prompts carry attributes the client uses to
-- decide who sees them (owner only, visitors only, night only...). The client
-- only hides/shows; every handler re-validates on the server.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Prompts = {}

Prompts.TAG = "GamePrompt"

export type Audience = "Owner" | "Others" | "All"

export type Options = {
	action: string, -- handler name, or "OpenUI" for client-only prompts
	text: string,
	objectText: string?,
	audience: Audience,
	ownerId: number?,
	plotIndex: number?,
	key: string?, -- id of the thing this prompt acts on (egg id, incubator slot...)
	hold: number?,
	keyCode: Enum.KeyCode?,
	distance: number?,
	nightOnly: boolean?,
	hideInTutorial: boolean?,
	openUI: string?,
}

type Handler = (player: Player, prompt: ProximityPrompt) -> ()

local handlers: { [string]: Handler } = {}
local lastTrigger: { [Player]: { [string]: number } } = {}

function Prompts.register(action: string, handler: Handler)
	assert(handlers[action] == nil, `prompt action {action} registered twice`)
	handlers[action] = handler
end

function Prompts.create(parent: Instance, options: Options): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = options.text
	prompt.ObjectText = options.objectText or ""
	prompt.HoldDuration = options.hold or 0
	prompt.KeyboardKeyCode = options.keyCode or Enum.KeyCode.E
	prompt.MaxActivationDistance = options.distance or 10
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("Action", options.action)
	prompt:SetAttribute("Audience", options.audience)
	if options.ownerId then
		prompt:SetAttribute("OwnerId", options.ownerId)
	end
	if options.plotIndex then
		prompt:SetAttribute("PlotIndex", options.plotIndex)
	end
	if options.key then
		prompt:SetAttribute("Key", options.key)
	end
	if options.nightOnly then
		prompt:SetAttribute("NightOnly", true)
	end
	if options.hideInTutorial then
		prompt:SetAttribute("HideInTutorial", true)
	end
	if options.openUI then
		prompt:SetAttribute("OpenUI", options.openUI)
	end
	CollectionService:AddTag(prompt, Prompts.TAG)
	prompt.Parent = parent
	return prompt
end

function Prompts.key(prompt: ProximityPrompt): string?
	local key = prompt:GetAttribute("Key")
	return if typeof(key) == "string" then key else nil
end

function Prompts.ownerId(prompt: ProximityPrompt): number?
	local id = prompt:GetAttribute("OwnerId")
	return if typeof(id) == "number" then id else nil
end

function Prompts.init()
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, player: Player)
		local action = prompt:GetAttribute("Action")
		if typeof(action) ~= "string" then
			return
		end
		local handler = handlers[action]
		if not handler then
			return
		end
		-- Light rate limit: max 8 triggers per second per action.
		local now = os.clock()
		local perPlayer = lastTrigger[player]
		if not perPlayer then
			perPlayer = {}
			lastTrigger[player] = perPlayer
		end
		local last = perPlayer[action]
		if last and now - last < 0.125 then
			return
		end
		perPlayer[action] = now
		handler(player, prompt)
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastTrigger[player] = nil
	end)
end

return Prompts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">Raids</string>
            <string name="Source"><![CDATA[--!strict
-- Night raids. At night, visitors can steal eggs from another player's tray and
-- carry them home. Kid-friendly rules:
--   * only laid eggs can be stolen, never dinos you raised
--   * every nest has a free gate lock (with cooldown) and a first-day shield
--   * the owner can tag the thief to get the egg back; guard dinos roar thieves away
--   * the egg stays in the owner's save until the thief reaches home, so a
--     disconnect can never duplicate or delete an egg
--   * raids are off in private servers (configurable)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Config = require(ReplicatedStorage.Shared.Config)
local Cycle = require(ReplicatedStorage.Shared.Util.Cycle)
local DinoData = require(ReplicatedStorage.Shared.Data.DinoData)
local Economy = require(ReplicatedStorage.Shared.Util.Economy)
local EggModel = require(ReplicatedStorage.Shared.Visual.EggModel)
local Growth = require(ReplicatedStorage.Shared.Util.Growth)
local Net = require(ReplicatedStorage.Shared.Net)
local Analytics = require(script.Parent.Analytics)
local Coins = require(script.Parent.Coins)
local Data = require(script.Parent.Data)
local Dinos = require(script.Parent.Dinos)
local Nest = require(script.Parent.Nest)
local Plots = require(script.Parent.Plots)
local Prompts = require(script.Parent.Prompts)
local Sessions = require(script.Parent.Sessions)
local State = require(script.Parent.State)
local World = require(script.Parent.World)
local Notify = require(script.Parent.Parent.Lib.Notify)
local Stats = require(script.Parent.Parent.Lib.Stats)

local Raids = {}

local rng = Random.new()
local carriedEggs: { [string]: Player } = {} -- "ownerUserId:eggId" -> thief

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function humanoidOf(player: Player): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function isNight(): boolean
	return Cycle.dayNight(Clock.cycleNow()).isNight
end

local function carryKey(owner: Player, eggId: string): string
	return `{owner.UserId}:{eggId}`
end

function Raids.isProtected(owner: Player): boolean
	local session = Sessions.get(owner)
	local profile = Data.get(owner)
	if not session or not profile then
		return true
	end
	local now = Clock.now()
	return session.lockUntil > now or Stats.shieldUntil(profile) > now
end

local function stun(player: Player)
	local session = Sessions.get(player)
	local humanoid = humanoidOf(player)
	if not session or not humanoid then
		return
	end
	session.stunnedUntil = Clock.now() + Config.STUN_SECONDS
	humanoid.WalkSpeed = 0
	humanoid.JumpHeight = 0
	task.delay(Config.STUN_SECONDS, function()
		local s = Sessions.get(player)
		local h = humanoidOf(player)
		if s and h and Clock.now() >= s.stunnedUntil then
			h.WalkSpeed = if s.carry then Config.CARRY_WALKSPEED else Config.NORMAL_WALKSPEED
			h.JumpHeight = 7.2
		end
	end)
end

-- End a carry. success = thief made it home.
local function endCarry(thief: Player, success: boolean, reason: string?)
	local session = Sessions.get(thief)
	local carry = session and session.carry
	if not session or not carry then
		return
	end
	session.carry = nil
	local victim = carry.victim
	carriedEggs[carryKey(victim, carry.eggId)] = nil
	if carry.model then
		carry.model:Destroy()
	end
	local humanoid = humanoidOf(thief)
	if humanoid and Clock.now() >= session.stunnedUntil then
		humanoid.WalkSpeed = Config.NORMAL_WALKSPEED
	end
	local victimSession = Sessions.get(victim)
	local species = DinoData.get(carry.species)
	local name = if species then species.name else "dino"

	if success and victimSession and victimSession.ready then
		local victimProfile = Data.get(victim)
		local thiefProfile = Data.get(thief)
		local removed = Nest.removeTrayEgg(victim, carry.eggId)
		Plots.setTrayEggHidden(victim, carry.eggId, false)
		if removed and thiefProfile and victimProfile then
			victimProfile.stats.eggsLost += 1
			thiefProfile.stats.stolen += 1
			if not Nest.addTrayEgg(thief, removed.species) then
				local value = if species then Economy.trayEggValue(species.income) else 10
				Coins.add(thief, value, "Gameplay", "StolenEggSold")
			end
			Notify.send(thief, `🥚 You stole a {name} egg! Sneaky!`, "rare")
			Notify.send(
				victim,
				`😱 {thief.DisplayName} stole your {name} egg! Lock your gate at night!`,
				"bad"
			)
			Notify.effectAll(
				"Stolen",
				{ thief = thief.UserId, victim = victim.UserId, species = carry.species }
			)
			Analytics.event(thief, "StoleEgg")
		end
	else
		if victimSession then
			Plots.setTrayEggHidden(victim, carry.eggId, false)
		end
		if reason == "caught" then
			Notify.send(thief, "🫣 Caught! The egg went back home.", "bad")
			Notify.send(
				victim,
				`🛡 You caught {thief.DisplayName} and saved your {name} egg!`,
				"good"
			)
			Notify.effectAll("Caught", { thief = thief.UserId, victim = victim.UserId })
		elseif reason == "roar" then
			Notify.send(thief, "🦖 ROAR! The guard dinos made you drop the egg!", "bad")
		elseif reason == "morning" then
			Notify.send(thief, "☀️ The sun came up and the egg rolled home.", "info")
		end
	end
	State.markDirty(thief)
	if victimSession then
		State.markDirty(victim)
	end
end

local function steal(thief: Player, prompt: ProximityPrompt)
	local ownerId = Prompts.ownerId(prompt)
	local eggId = Prompts.key(prompt)
	if not ownerId or not eggId or ownerId == thief.UserId then
		return
	end
	local owner = Players:GetPlayerByUserId(ownerId)
	local thiefSession = Sessions.get(thief)
	if not owner or not thiefSession or not thiefSession.ready then
		return
	end
	local ownerSession = Sessions.get(owner)
	local ownerProfile = Data.get(owner)
	if not ownerSession or not ownerSession.ready or not ownerProfile then
		return
	end
	if not Stats.raidsEnabled() or not isNight() then
		return
	end
	if Raids.isProtected(owner) then
		Notify.send(thief, "This nest is protected right now!", "bad")
		return
	end
	if thiefSession.carry or Clock.now() < thiefSession.stunnedUntil then
		return
	end
	if carriedEggs[carryKey(owner, eggId)] then
		return
	end
	local egg = Nest.findTrayEgg(ownerProfile, eggId)
	local root = rootOf(thief)
	local trayPosition = Plots.trayPosition(owner)
	if
		not egg
		or not root
		or not trayPosition
		or (root.CFrame.Position - trayPosition).Magnitude > 16
	then
		return
	end

	Dinos.dismount(thief)
	local head = thief.Character and thief.Character:FindFirstChild("Head")
	local model: Model? = nil
	if head and head:IsA("BasePart") then
		local carried = EggModel.build(EggModel.lookForSpecies(egg.species), 2.2)
		carried.Name = "CarriedEgg"
		local carriedRoot = carried.PrimaryPart :: BasePart
		carriedRoot.Anchored = false
		carriedRoot.Massless = true
		for _, d in carried:GetDescendants() do
			if d:IsA("BasePart") then
				d.Massless = true
				d.CanCollide = false
			end
		end
		carried:PivotTo(head.CFrame * CFrame.new(0, head.Size.Y / 2 + 0.2, 0))
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = head
		weld.Part1 = carriedRoot
		weld.Parent = carriedRoot
		carried.Parent = thief.Character
		model = carried
	end

	thiefSession.carry = {
		victim = owner,
		eggId = eggId,
		species = egg.species,
		model = model,
		startedAt = Clock.now(),
	}
	carriedEggs[carryKey(owner, eggId)] = thief
	Plots.setTrayEggHidden(owner, eggId, true)
	local humanoid = humanoidOf(thief)
	if humanoid then
		humanoid.WalkSpeed = Config.CARRY_WALKSPEED
	end
	Notify.send(thief, "🏃 Run back to your nest with the egg!", "event")
	Notify.send(
		owner,
		`🚨 {thief.DisplayName} is stealing your egg! Tag them to get it back!`,
		"bad"
	)
	State.markDirty(thief)
	State.markDirty(owner)
end

local function carryTick()
	local night = isNight()
	for _, session in Sessions.ready() do
		local carry = session.carry
		if not carry then
			continue
		end
		local thief = session.player
		local root = rootOf(thief)
		local victimSession = Sessions.get(carry.victim)
		if not root or not victimSession or not victimSession.ready then
			endCarry(thief, false, nil)
		elseif not night then
			endCarry(thief, false, "morning")
		else
			local victimRoot = rootOf(carry.victim)
			if
				victimRoot
				and (victimRoot.CFrame.Position - root.CFrame.Position).Magnitude
					<= Config.TAG_RANGE
			then
				endCarry(thief, false, "caught")
				stun(thief)
			elseif World.isInside(session.plotIndex, root.CFrame.Position) then
				endCarry(thief, true, nil)
			end
		end
	end
end

-- Grown dinos guard the nest at night.
local function guardTick()
	if not isNight() then
		return
	end
	local now = Clock.now()
	for _, ownerSession in Sessions.ready() do
		local owner = ownerSession.player
		local profile = Data.get(owner)
		if not profile then
			continue
		end
		local power = 0
		local strongest: string? = nil
		local strongestStage = 0
		for _, dino in profile.dinos do
			local stage = Stats.dinoStage(dino, now)
			if stage >= Growth.ADULT then
				power += if stage >= Growth.GIANT then 2 else 1
				if stage > strongestStage then
					strongestStage = stage
					strongest = dino.id
				end
			end
		end
		if power == 0 then
			continue
		end
		local chance = math.min(Config.GUARD_MAX_CHANCE, power * Config.GUARD_CHANCE_PER_POWER)
		for _, visitor in Sessions.ready() do
			if visitor.player == owner or now < visitor.stunnedUntil then
				continue
			end
			local root = rootOf(visitor.player)
			if not root or not World.isInside(ownerSession.plotIndex, root.CFrame.Position) then
				continue
			end
			if rng:NextNumber() < chance then
				stun(visitor.player)
				local model = strongest and Plots.dinoModel(owner, strongest)
				local position = if model then model:GetPivot().Position else root.CFrame.Position
				Notify.effectAll("Roar", { position = position, big = true })
				if visitor.carry and visitor.carry.victim == owner then
					endCarry(visitor.player, false, "roar")
				else
					Notify.send(visitor.player, "🦖 ROAR! The guard dinos scared you!", "bad")
				end
			end
		end
	end
end

-- Locked nests push visitors back out of the gate.
local function lockTick()
	local now = Clock.now()
	for _, ownerSession in Sessions.ready() do
		if ownerSession.lockUntil <= now then
			continue
		end
		for _, visitor in Sessions.ready() do
			if visitor.player == ownerSession.player then
				continue
			end
			local root = rootOf(visitor.player)
			if root and World.isInside(ownerSession.plotIndex, root.CFrame.Position, 1) then
				local character = visitor.player.Character
				if character then
					character:PivotTo(World.outsideGate(ownerSession.plotIndex))
				end
			end
		end
	end
end

local function lockGate(player: Player)
	local session = Sessions.get(player)
	if not session or not session.ready then
		return
	end
	local now = Clock.now()
	if now < session.lockCooldownUntil then
		return
	end
	session.lockUntil = math.max(session.lockUntil, now + Config.GATE_LOCK_SECONDS)
	session.lockCooldownUntil = now + Config.GATE_LOCK_SECONDS + Config.GATE_COOLDOWN_SECONDS
	Plots.setBarrier(player, session.lockUntil)
	Notify.send(player, "🔒 Gate locked! Nobody can get in for a minute.", "good")
	State.markDirty(player)
	task.delay(Config.GATE_LOCK_SECONDS + 0.1, function()
		if Sessions.get(player) then
			Plots.setBarrier(player, session.lockUntil)
		end
	end)
end

-- Robux "Super Lock": extends the lock without touching the free cooldown.
function Raids.superLock(player: Player)
	local session = Sessions.get(player)
	if not session then
		return
	end
	local now = Clock.now()
	session.lockUntil = math.max(session.lockUntil, now) + Config.SUPER_LOCK_SECONDS
	Plots.setBarrier(player, session.lockUntil)
	State.markDirty(player)
	task.delay(session.lockUntil - now + 0.1, function()
		if Sessions.get(player) then
			Plots.setBarrier(player, session.lockUntil)
		end
	end)
end

-- Called by Lifecycle before a player's data is released.
function Raids.onLeave(player: Player)
	local session = Sessions.get(player)
	if session and session.carry then
		endCarry(player, false, nil)
	end
	for _, other in Sessions.ready() do
		if other.carry and other.carry.victim == player then
			endCarry(other.player, false, nil)
		end
	end
end

-- One pass of the carry and lock checks. The start() loops call these on
-- timers; tests call this directly.
function Raids.step()
	carryTick()
	lockTick()
end

function Raids.init()
	Prompts.register("Steal", steal)
	Net.on("LockGate", 1, 2, function(player: Player)
		lockGate(player)
	end)
	ReplicatedStorage:SetAttribute("RaidsEnabled", Stats.raidsEnabled())
end

function Raids.start()
	task.spawn(function()
		while true do
			task.wait(0.2)
			carryTick()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.25)
			lockTick()
		end
	end)
	while true do
		task.wait(Config.GUARD_TICK)
		guardTick()
	end
end

return Raids
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Sessions</string>
            <string name="Source"><![CDATA[--!strict
-- Runtime (not saved) state for each player in this server. Systems read and
-- write their own fields here; the saved profile lives in Data.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Signal = require(ReplicatedStorage.Shared.Util.Signal)

export type Carry = {
	victim: Player,
	eggId: string,
	species: string,
	model: Model?,
	startedAt: number,
}

export type Session = {
	player: Player,
	ready: boolean,
	plotIndex: number,
	passes: { [string]: boolean },
	fakePasses: { [string]: boolean }, -- Studio/QA only
	subscribed: boolean,
	restricted: boolean, -- PolicyService: paid random items restricted
	tradingAllowed: boolean,
	friendIds: { [number]: boolean }, -- friends currently in this server
	lockUntil: number,
	lockCooldownUntil: number,
	pendingInstantHatch: string?,
	carry: Carry?,
	stunnedUntil: number,
	riding: string?,
	mount: Model?,
	originalHipHeight: number?,
	liked: { [number]: boolean },
	lastAdAt: number,
}

local Sessions = {}

Sessions.Ready = Signal.new() :: Signal.Signal<Player>
Sessions.Leaving = Signal.new() :: Signal.Signal<Player>

local sessions: { [Player]: Session } = {}

function Sessions.create(player: Player): Session
	local session: Session = {
		player = player,
		ready = false,
		plotIndex = 0,
		passes = {},
		fakePasses = {},
		subscribed = false,
		restricted = true, -- safe default until PolicyService answers
		tradingAllowed = false,
		friendIds = {},
		lockUntil = 0,
		lockCooldownUntil = 0,
		pendingInstantHatch = nil,
		carry = nil,
		stunnedUntil = 0,
		riding = nil,
		mount = nil,
		originalHipHeight = nil,
		liked = {},
		lastAdAt = 0,
	}
	sessions[player] = session
	return session
end

function Sessions.get(player: Player): Session?
	return sessions[player]
end

-- Only sessions that finished loading (profile + plot ready).
function Sessions.ready(): { Session }
	local list: { Session } = {}
	for _, s in sessions do
		if s.ready then
			table.insert(list, s)
		end
	end
	return list
end

function Sessions.remove(player: Player)
	sessions[player] = nil
end

return Sessions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">Social</string>
            <string name="Source"><![CDATA[--!strict
-- Friends (coin boost + egg warming), nest likes, the Roar emote and the VIP tag.
-- All social features work without text chat, since many young players have
-- chat turned off.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Data = require(script.Parent.Data)
local Monetization = require(script.Parent.Monetization)
local Plots = require(script.Parent.Plots)
local Prompts = require(script.Parent.Prompts)
local Sessions = require(script.Parent.Sessions)
local State = require(script.Parent.State)
local World = require(script.Parent.World)
local Notify = require(script.Parent.Parent.Lib.Notify)
local Stats = require(script.Parent.Parent.Lib.Stats)

local Social = {}

-- Finds which players already here are friends with the new player.
function Social.onJoin(player: Player)
	local session = Sessions.get(player)
	if not session then
		return
	end
	for _, other in Players:GetPlayers() do
		if other == player then
			continue
		end
		local ok, isFriend = pcall(function()
			return player:IsFriendsWithAsync(other.UserId)
		end)
		if ok and isFriend then
			session.friendIds[other.UserId] = true
			local otherSession = Sessions.get(other)
			if otherSession then
				otherSession.friendIds[player.UserId] = true
				State.markDirty(other)
				Notify.send(
					other,
					`👋 Your friend {player.DisplayName} joined! Friends boost coins and warm eggs.`,
					"good"
				)
			end
		end
	end
	State.markDirty(player)
end

function Social.onLeave(player: Player)
	for _, session in Sessions.ready() do
		if session.friendIds[player.UserId] then
			session.friendIds[player.UserId] = nil
			State.markDirty(session.player)
		end
	end
end

-- Name tag over VIPs (and the plot sign shows likes for everyone).
function Social.decorateCharacter(player: Player)
	local session = Sessions.get(player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not session or not head then
		return
	end
	local existing = head:FindFirstChild("VipTag")
	if existing then
		existing:Destroy()
	end
	if not Stats.hasPass(session, "VIP") then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "VipTag"
	gui.Size = UDim2.fromOffset(110, 30)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.MaxDistance = 60
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = "⭐ VIP"
	label.TextColor3 = Color3.fromRGB(255, 215, 60)
	label.TextStrokeTransparency = 0.2
	label.Parent = gui
	gui.Parent = head
end

local function like(player: Player, prompt: ProximityPrompt)
	local ownerId = prompt:GetAttribute("OwnerId")
	local plotIndex = prompt:GetAttribute("PlotIndex")
	local session = Sessions.get(player)
	if typeof(plotIndex) ~= "number" or not session then
		return
	end
	local owner = Plots.ownerOf(plotIndex)
	if
		not owner
		or owner == player
		or (typeof(ownerId) == "number" and ownerId ~= owner.UserId)
	then
		return
	end
	if session.liked[owner.UserId] then
		Notify.send(player, "You already liked this nest today ❤", "info")
		return
	end
	local profile = Data.get(owner)
	if not profile then
		return
	end
	session.liked[owner.UserId] = true
	profile.likes += 1
	Plots.updateSign(owner)
	State.markDirty(owner)
	Notify.send(owner, `❤ {player.DisplayName} liked your nest!`, "good")
	Notify.send(player, "❤ Liked!", "good")
end

local function roar(player: Player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	local session = Sessions.get(player)
	Notify.effectAll("Roar", {
		position = root.CFrame.Position,
		userId = player.UserId,
		big = session ~= nil and session.riding ~= nil,
	})
end

function Social.init()
	Prompts.register("Like", like)
	Net.on("Roar", 0.5, 1, function(player: Player)
		roar(player)
	end)
	Monetization.PassesChanged:connect(function(player: Player)
		Social.decorateCharacter(player)
	end)
end

function Social.start()
	-- A "Like" prompt on every nest sign, shown to visitors only. (World builds
	-- the plots during init, so this waits for start.)
	for _, plot in World.plots do
		Prompts.create(plot.signPart, {
			action = "Like",
			text = "Like ❤",
			objectText = "Nest",
			audience = "Others",
			plotIndex = plot.index,
			distance = 18,
		})
	end
end

return Social
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!strict
-- Sends each player a snapshot of their own state whenever it changes
-- (batched, at most 5 times per second), plus a full snapshot when their
-- client says it's ready. Clients render; they never compute anything that matters.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Net = require(ReplicatedStorage.Shared.Net)
local Types = require(ReplicatedStorage.Shared.Types)
local Data = require(script.Parent.Data)
local Sessions = require(script.Parent.Sessions)
local Stats = require(script.Parent.Parent.Lib.Stats)

local State = {}

local dirty: { [Player]: boolean } = {}
local clientReady: { [Player]: boolean } = {}

function State.markDirty(player: Player)
	dirty[player] = true
end

function State.snapshot(player: Player): Types.Snapshot?
	local profile = Data.get(player)
	local session = Sessions.get(player)
	if not profile or not session then
		return nil
	end
	local now = Clock.now()
	local passes: { [string]: boolean } = {}
	for key in session.passes do
		passes[key] = true
	end
	for key in session.fakePasses do
		passes[key] = true
	end
	return {
		coins = profile.coins,
		pendingCoins = profile.pendingCoins,
		incomePerSecond = Stats.incomePerSecond(profile, session, now),
		multiplier = Stats.multiplier(profile, session, now),
		dinos = profile.dinos,
		incubators = profile.incubators,
		tray = profile.tray,
		dex = profile.dex,
		upgrades = profile.upgrades,
		boosts = profile.boosts,
		instantHatchTokens = profile.instantHatchTokens,
		streak = profile.streak,
		clubClaimDay = profile.club.lastClaimDay,
		tutorial = profile.tutorial,
		starterPackBought = profile.starterPackBought,
		shopBought = profile.shop,
		likes = profile.likes,
		passes = passes,
		subscribed = session.subscribed,
		restricted = session.restricted,
		plotIndex = session.plotIndex,
		maxSlots = Stats.maxSlots(profile, session),
		maxIncubators = Stats.maxIncubators(profile),
		lockUntil = session.lockUntil,
		lockCooldownUntil = session.lockCooldownUntil,
		shieldUntil = Stats.shieldUntil(profile),
		friendsHere = Stats.friendsHere(session),
		isDev = Stats.isDev(player),
		raidsEnabled = Stats.raidsEnabled(),
		riding = session.riding,
		carrying = session.carry ~= nil,
	}
end

local function send(player: Player)
	local snapshot = State.snapshot(player)
	if snapshot then
		Net.fire(player, "State", snapshot)
	end
end

function State.init()
	Net.on("Ready", 1, 3, function(player: Player)
		clientReady[player] = true
		send(player)
	end)
	Sessions.Leaving:connect(function(player: Player)
		dirty[player] = nil
		clientReady[player] = nil
	end)
end

function State.start()
	while true do
		task.wait(0.2)
		for player in dirty do
			dirty[player] = nil
			if clientReady[player] and player.Parent ~= nil then
				send(player)
			end
		end
	end
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">Upgrades</string>
            <string name="Source"><![CDATA[--!strict
-- Permanent nest upgrades bought with coins (the long-term coin sink):
-- more dino slots and more incubators.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Util.Economy)
local Net = require(ReplicatedStorage.Shared.Net)
local Coins = require(script.Parent.Coins)
local Data = require(script.Parent.Data)
local Plots = require(script.Parent.Plots)
local Sessions = require(script.Parent.Sessions)
local State = require(script.Parent.State)
local Notify = require(script.Parent.Parent.Lib.Notify)

local Upgrades = {}

local function buy(player: Player, kind: unknown)
	local profile = Data.get(player)
	local session = Sessions.get(player)
	if not profile or not session or not session.ready then
		return
	end
	if kind == "slots" then
		local cost = Economy.nextUpgradeCost(Config.SLOT_UPGRADE_COSTS, profile.upgrades.slots)
		if not cost then
			return
		end
		if not Coins.spend(player, cost, "Shop", "SlotUpgrade") then
			Notify.send(player, "Not enough coins yet!", "bad")
			return
		end
		profile.upgrades.slots += 1
		Notify.send(player, "🦖 Your nest has room for another dino!", "good")
	elseif kind == "incubators" then
		local cost =
			Economy.nextUpgradeCost(Config.INCUBATOR_UPGRADE_COSTS, profile.upgrades.incubators)
		if not cost then
			return
		end
		if not Coins.spend(player, cost, "Shop", "IncubatorUpgrade") then
			Notify.send(player, "Not enough coins yet!", "bad")
			return
		end
		profile.upgrades.incubators += 1
		Plots.syncIncubators(player)
		Notify.send(player, "🥚 New incubator unlocked!", "good")
	else
		return
	end
	State.markDirty(player)
end

function Upgrades.init()
	Net.on("BuyUpgrade", 2, 3, buy)
end

return Upgrades
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">Weather</string>
            <string name="Source"><![CDATA[--!strict
-- Storms. While a storm is on, every online player's unmutated dinos have a
-- chance each tick to catch that storm's mutation. Storm timing is
-- deterministic (Cycle), so this system only announces and applies effects.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Config = require(ReplicatedStorage.Shared.Config)
local Cycle = require(ReplicatedStorage.Shared.Util.Cycle)
local DinoData = require(ReplicatedStorage.Shared.Data.DinoData)
local MutationData = require(ReplicatedStorage.Shared.Data.MutationData)
local Data = require(script.Parent.Data)
local Nest = require(script.Parent.Nest)
local Plots = require(script.Parent.Plots)
local Sessions = require(script.Parent.Sessions)
local Notify = require(script.Parent.Parent.Lib.Notify)

local Weather = {}

local rng = Random.new()

local function stormTick(storm: Cycle.StormState)
	local mutation = MutationData.stormGives(storm.kind, storm.mega)
	if not mutation then
		return
	end
	local chanceBp = MutationData.stormTickBp(storm.mega)
	local info = MutationData.get(mutation)
	for _, session in Sessions.ready() do
		local player = session.player
		local profile = Data.get(player)
		if not profile then
			continue
		end
		for _, dino in profile.dinos do
			if dino.mutation == nil and rng:NextInteger(0, 9999) < chanceBp then
				Nest.setMutation(player, dino.id, mutation)
				local species = DinoData.get(dino.species)
				local name = if species then species.name else "dino"
				Notify.send(
					player,
					`{info and info.emoji or "✨"} Your {name} turned {mutation}!`,
					"rare"
				)
				local model = Plots.dinoModel(player, dino.id)
				if model then
					Notify.effect(
						player,
						"Mutate",
						{ position = model:GetPivot().Position, mutation = mutation }
					)
				end
			end
		end
	end
end

function Weather.start()
	local wasActive = false
	local wasMega = false
	local lastTick = 0
	while true do
		task.wait(1)
		local now = Clock.cycleNow()
		local storm = Cycle.storm(now)
		if storm.active and (not wasActive or storm.mega ~= wasMega) then
			if storm.mega then
				Notify.all(
					`{MutationData.MEGA_STORM_EMOJI} {MutationData.MEGA_STORM_NAME}! Rainbow dinos are possible right now!`,
					"event"
				)
			elseif storm.kind then
				local info = MutationData.stormInfo(storm.kind)
				Notify.all(
					`{info.emoji} A {info.name} is here! Dinos can turn {storm.kind}!`,
					"event"
				)
			end
			lastTick = now
		elseif not storm.active and wasActive then
			Notify.all("🌤 The storm has passed.", "info")
		end
		wasActive = storm.active
		wasMega = storm.mega
		if storm.active and now - lastTick >= Config.STORM_TICK then
			lastTick = now
			stormTick(storm)
		end
	end
end

return Weather
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[--!strict
-- Builds the world at server start: the island scenery (Lib/Island) and 8
-- player nests (plots). Everything is generated in code so the place works
-- with no hand-built map; decorate freely in Studio (anything you add to
-- Workspace yourself is left alone).
--
-- Plot space: origin at the plot's center on the ground, -Z faces the hub.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Palette = require(ReplicatedStorage.Shared.Palette)
local Rng = require(ReplicatedStorage.Shared.Util.Rng)
local Build = require(script.Parent.Parent.Lib.Build)
local Island = require(script.Parent.Parent.Lib.Island)
local Props = require(script.Parent.Parent.Lib.Props)
local Prompts = require(script.Parent.Prompts)

local World = {}

export type PlotInfo = {
	index: number,
	model: Model,
	cframe: CFrame,
	floorTop: number,
	accent: Color3,
	incubators: { BasePart }, -- pedestal tops, index = slot
	incubatorLocks: { BillboardGui },
	incubatorRings: { BasePart },
	traySpots: { CFrame },
	pad: BasePart,
	padLabel: TextLabel,
	signName: TextLabel,
	signInfo: TextLabel,
	signPart: BasePart,
	ownerTag: TextLabel,
	barrier: { BasePart },
	spawn: SpawnLocation,
	homeSpots: { CFrame },
	dinoFolder: Folder,
	eggFolder: Folder,
	trayFolder: Folder,
}

local HALF = Config.PLOT_SIZE / 2
local FLOOR_TOP = 1
local GATE_GAP = 11

local GOLD = Color3.fromRGB(255, 205, 60)
local GOLD_DARK = Color3.fromRGB(226, 156, 38)

World.plots = {} :: { PlotInfo }

local function billboard(
	parent: Instance,
	name: string,
	size: UDim2,
	offset: Vector3,
	maxDistance: number
): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Name = name
	gui.Size = size
	gui.StudsOffsetWorldSpace = offset
	gui.AlwaysOnTop = false
	gui.MaxDistance = maxDistance
	gui.LightInfluence = 0
	gui.Parent = parent
	return gui
end

local function label(
	parent: Instance,
	name: string,
	text: string,
	size: UDim2,
	position: UDim2,
	color: Color3?
): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.Size = size
	l.Position = position
	l.Text = text
	l.TextScaled = true
	l.Font = Enum.Font.FredokaOne
	l.TextColor3 = color or Color3.new(1, 1, 1)
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(43, 33, 64)
	stroke.Thickness = 2.5
	stroke.Parent = l
	l.Parent = parent
	return l
end

-- ===== Nest pieces =====

-- Chunky wooden fence along a side of the plot; posts get the nest's colour.
local function fenceSegment(model: Model, cf: CFrame, a: Vector3, b: Vector3, accent: Color3)
	local length = (b - a).Magnitude
	local direction = (b - a).Unit
	local posts = math.max(1, math.floor(length / 8 + 0.5))
	for i = 0, posts do
		local p = a + direction * (length * i / posts)
		Build.block(
			Vector3.new(1.4, 4.4, 1.4),
			cf * CFrame.new(p + Vector3.new(0, FLOOR_TOP + 2.2, 0)),
			Palette.wood,
			model,
			{ name = "Post" }
		)
		Build.ball(
			1.9,
			(cf * CFrame.new(p + Vector3.new(0, FLOOR_TOP + 4.6, 0))).Position,
			accent,
			model,
			{
				name = "PostCap",
				decor = true,
				shadow = false,
			}
		)
	end
	for _, height in { 1.7, 3.3 } do
		local lift = Vector3.new(0, FLOOR_TOP + height, 0)
		Build.beam(
			(cf * CFrame.new(a + lift)).Position,
			(cf * CFrame.new(b + lift)).Position,
			0.5,
			0.75,
			Palette.woodLight,
			model,
			{
				name = "Rail",
			}
		)
	end
end

-- Lantern hanging from a bracket on the outside of a gate pillar.
local function lantern(model: Model, position: Vector3, outward: Vector3, accent: Color3)
	local tip = position + outward * 2.6
	Build.beam(position, tip, 0.45, 0.45, Palette.woodDark, model, { decor = true, shadow = false })
	local options = { decor = true, shadow = false, collide = false }
	Build.rod(tip, tip - Vector3.new(0, 0.6, 0), 0.15, Palette.woodDark, model, options)
	Build.disc(1.6, 0.35, CFrame.new(tip - Vector3.new(0, 0.75, 0)), accent, model, options)
	local bulb = Build.ball(1.25, tip - Vector3.new(0, 1.5, 0), Palette.lampGlow, model, {
		name = "Lantern",
		material = Enum.Material.Neon,
		decor = true,
		shadow = false,
		collide = false,
	})
	local light = Instance.new("PointLight")
	light.Color = Palette.lampGlow
	light.Range = 16
	light.Brightness = 1.4
	light.Shadows = false
	light.Enabled = false
	light.Parent = bulb
	CollectionService:AddTag(light, Props.NIGHT_LIGHT_TAG)
end

local function buildGate(model: Model, cf: CFrame, accent: Color3)
	local top = FLOOR_TOP + 11
	for _, side in { -1, 1 } do
		local foot = (cf * CFrame.new(side * GATE_GAP, FLOOR_TOP - 0.5, -HALF)).Position
		local head = (cf * CFrame.new(side * GATE_GAP, top, -HALF)).Position
		Build.rod(foot, head, 2.6, Palette.woodDark, model, { name = "GatePillar" })
		Build.disc(
			3.1,
			0.7,
			CFrame.new(head - Vector3.new(0, 1.4, 0)),
			accent,
			model,
			{ decor = true }
		)
		Build.ball(
			3.4,
			head + Vector3.new(0, 0.9, 0),
			accent,
			model,
			{ name = "GateCap", decor = true }
		)
		local outward = cf:VectorToWorldSpace(Vector3.new(0, 0, -1))
		lantern(
			model,
			(cf * CFrame.new(side * GATE_GAP, FLOOR_TOP + 7.5, -HALF)).Position,
			outward,
			accent
		)
	end
	-- log arch between the pillars
	local left = (cf * CFrame.new(-GATE_GAP, top - 0.6, -HALF)).Position
	local right = (cf * CFrame.new(GATE_GAP, top - 0.6, -HALF)).Position
	Build.rod(left, right, 1.6, Palette.woodLight, model, { name = "GateArch", decor = true })
	-- ramp up onto the raised nest floor
	Build.wedge(
		Vector3.new(GATE_GAP * 2, FLOOR_TOP, 3),
		cf * CFrame.new(0, FLOOR_TOP / 2, -HALF - 1.5),
		Palette.path,
		model,
		{ name = "Ramp" }
	)
end

-- Name board beside the gate (outside the fence, facing the paths).
local function buildSign(model: Model, cf: CFrame, accent: Color3): (BasePart, TextLabel, TextLabel)
	local center = cf * CFrame.new(-GATE_GAP - 10.5, 5.6, -HALF - 3.2)
	for _, x in { -4.6, 4.6 } do
		local foot = (center * CFrame.new(x, -5.6, 0)).Position
		Build.rod(
			foot,
			foot + Vector3.new(0, 3.5, 0),
			0.9,
			Palette.woodDark,
			model,
			{ decor = true }
		)
	end
	local board =
		Build.block(Vector3.new(13, 6, 0.8), center, Palette.wood, model, { name = "Sign" })
	Build.block(
		Vector3.new(13.8, 1, 1.1),
		center * CFrame.new(0, 3.3, 0),
		accent,
		model,
		{ decor = true }
	)
	Build.block(
		Vector3.new(12, 5, 0.2),
		center * CFrame.new(0, -0.2, 0),
		Palette.woodLight,
		model,
		{
			decor = true,
			shadow = false,
		}
	)
	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Front
	surface.LightInfluence = 0
	surface.PixelsPerStud = 40
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.Parent = board
	local signName = label(
		surface,
		"OwnerName",
		"Empty Nest",
		UDim2.fromScale(0.9, 0.5),
		UDim2.fromScale(0.05, 0.1)
	)
	local signInfo = label(
		surface,
		"Info",
		"Walk in to claim!",
		UDim2.fromScale(0.9, 0.3),
		UDim2.fromScale(0.05, 0.62),
		Color3.fromRGB(255, 236, 170)
	)
	local inside = surface:Clone()
	inside.Face = Enum.NormalId.Back
	inside.Parent = board
	return board, signName, signInfo
end

-- Floating name over the gate so friends can find each other's nests.
local function buildOwnerTag(model: Model, cf: CFrame): TextLabel
	local anchor = Build.block(
		Vector3.new(1, 1, 1),
		cf * CFrame.new(0, FLOOR_TOP + 14.5, -HALF),
		Palette.white,
		model,
		{
			name = "OwnerTagAnchor",
			transparency = 1,
			collide = false,
			decor = true,
		}
	)
	local gui = billboard(anchor, "OwnerTag", UDim2.fromOffset(260, 46), Vector3.zero, 220)
	return label(gui, "Name", "Empty Nest", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0))
end

local function buildIncubator(
	model: Model,
	base: CFrame,
	slot: number,
	accent: Color3
): (BasePart, BillboardGui, BasePart)
	Build.disc(6.4, 0.6, base * CFrame.new(0, 0.3, 0), Palette.stoneDark, model, { decor = true })
	local pedestal = Build.disc(
		5.2,
		2,
		base * CFrame.new(0, 1, 0),
		Palette.stone,
		model,
		{ name = "Incubator" .. slot }
	)
	pedestal:SetAttribute("Slot", slot)
	Build.disc(
		5.5,
		0.5,
		base * CFrame.new(0, 1.2, 0),
		accent,
		model,
		{ decor = true, shadow = false }
	)
	-- straw nest around the egg spot
	for i = 0, 7 do
		local a = i * (2 * math.pi / 8)
		local cf = base
			* CFrame.new(math.sin(a) * 2.25, 2.2, math.cos(a) * 2.25)
			* CFrame.Angles(0, a + math.pi / 2, 0)
		Build.ellipsoid(
			Vector3.new(1, 0.9, 2.3),
			cf,
			if i % 2 == 0 then Palette.sandDark else Palette.woodLight,
			model,
			{
				decor = true,
				shadow = false,
				collide = false,
			}
		)
	end
	local ring = Build.disc(6, 0.3, base * CFrame.new(0, 2.1, 0), Palette.orange, model, {
		name = "HeatRing" .. slot,
		material = Enum.Material.Neon,
		collide = false,
		decor = true,
		shadow = false,
	})
	local lock = billboard(pedestal, "Lock", UDim2.fromOffset(140, 56), Vector3.new(0, 3.5, 0), 60)
	label(lock, "Text", "🔒 Upgrade", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0))
	lock.Enabled = false
	return pedestal, lock, ring
end

local function buildTray(model: Model, center: CFrame): { CFrame }
	Build.disc(
		9.2,
		0.4,
		center * CFrame.new(0, 0.2, 0),
		Palette.sandLight,
		model,
		{ name = "Tray", decor = true }
	)
	for i = 0, 9 do
		local a = i * math.rad(36)
		local cf = center
			* CFrame.new(math.cos(a) * 4.3, 0.55, math.sin(a) * 4.3)
			* CFrame.Angles(0, -a, 0)
		Build.ellipsoid(
			Vector3.new(1.5, 1.1, 2.8),
			cf,
			if i % 2 == 0 then Palette.woodDark else Palette.wood,
			model,
			{
				name = "Twig",
				decor = true,
			}
		)
	end
	local spots: { CFrame } = {}
	for i = 0, Config.TRAY_CAPACITY - 1 do
		local a = i * (2 * math.pi / Config.TRAY_CAPACITY)
		table.insert(spots, center * CFrame.new(math.cos(a) * 2.4, 0.4, math.sin(a) * 2.4))
	end
	local labelPart =
		Build.block(Vector3.new(1, 1, 1), center * CFrame.new(0, 1, 0), Palette.white, model, {
			name = "TrayLabel",
			transparency = 1,
			collide = false,
			decor = true,
		})
	local gui = billboard(labelPart, "Label", UDim2.fromOffset(160, 40), Vector3.new(0, 4, 0), 60)
	label(gui, "Text", "🥚 Laid Eggs", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0))
	return spots
end

local function buildCoinPad(model: Model, center: CFrame): (BasePart, TextLabel)
	Build.disc(9.4, 0.4, center * CFrame.new(0, 0.2, 0), GOLD_DARK, model, { decor = true })
	local pad = Build.disc(8, 0.5, center * CFrame.new(0, 0.35, 0), GOLD, model, {
		name = "CoinPad",
		reflectance = 0.2,
	})
	-- a little stack of coins beside the pad
	for i = 0, 2 do
		Build.disc(
			2,
			0.45,
			center * CFrame.new(4.8, 0.25 + i * 0.5, 2.4),
			if i % 2 == 0 then GOLD else GOLD_DARK,
			model,
			{
				decor = true,
				shadow = false,
			}
		)
	end
	local gui = billboard(pad, "Coins", UDim2.fromOffset(180, 60), Vector3.new(0, 4, 0), 80)
	local padLabel = label(
		gui,
		"Amount",
		"💰 0",
		UDim2.fromScale(1, 1),
		UDim2.fromScale(0, 0),
		Color3.fromRGB(255, 230, 120)
	)
	return pad, padLabel
end

local function buildPlot(index: number, plotsFolder: Folder): PlotInfo
	local angle = (index - 1) * (2 * math.pi / Config.PLOT_COUNT)
	local position = Build.polar(angle, Config.PLOT_RING_RADIUS)
	local cf = CFrame.lookAt(position, Vector3.new(0, 0, 0))
	local accent = Palette.NEST_ACCENTS[(index - 1) % #Palette.NEST_ACCENTS + 1]

	local model = Instance.new("Model")
	model.Name = "Plot" .. index
	model:SetAttribute("PlotIndex", index)
	model:SetAttribute("OwnerId", 0)
	model:SetAttribute("LockedUntil", 0)
	model:SetAttribute("ShieldUntil", 0)

	-- raised garden-bed floor in a wooden frame
	Build.block(
		Vector3.new(Config.PLOT_SIZE + 2.4, 1.4, Config.PLOT_SIZE + 2.4),
		cf * CFrame.new(0, 0, 0),
		Palette.wood,
		model,
		{
			name = "Frame",
			decor = true,
		}
	)
	Build.block(
		Vector3.new(Config.PLOT_SIZE, 1, Config.PLOT_SIZE),
		cf * CFrame.new(0, FLOOR_TOP - 0.5, 0),
		Palette.grassLight,
		model,
		{
			name = "Floor",
		}
	)

	local gate = GATE_GAP
	fenceSegment(model, cf, Vector3.new(-HALF, 0, HALF), Vector3.new(HALF, 0, HALF), accent)
	fenceSegment(model, cf, Vector3.new(-HALF, 0, -HALF), Vector3.new(-HALF, 0, HALF), accent)
	fenceSegment(model, cf, Vector3.new(HALF, 0, -HALF), Vector3.new(HALF, 0, HALF), accent)
	fenceSegment(
		model,
		cf,
		Vector3.new(-HALF, 0, -HALF),
		Vector3.new(-gate - 1.3, 0, -HALF),
		accent
	)
	fenceSegment(model, cf, Vector3.new(gate + 1.3, 0, -HALF), Vector3.new(HALF, 0, -HALF), accent)
	buildGate(model, cf, accent)
	local signPart, signName, signInfo = buildSign(model, cf, accent)
	local ownerTag = buildOwnerTag(model, cf)

	-- incubators along the back
	local incubators: { BasePart } = {}
	local incubatorLocks: { BillboardGui } = {}
	local incubatorRings: { BasePart } = {}
	for slot = 1, Config.MAX_INCUBATORS do
		local x = -24 + (slot - 1) * 12
		local pedestal, lock, ring =
			buildIncubator(model, cf * CFrame.new(x, FLOOR_TOP, 24), slot, accent)
		incubators[slot] = pedestal
		incubatorLocks[slot] = lock
		incubatorRings[slot] = ring
	end

	local traySpots = buildTray(model, cf * CFrame.new(18, FLOOR_TOP, -22))
	local pad, padLabel = buildCoinPad(model, cf * CFrame.new(-18, FLOOR_TOP, -22))

	-- greenery in the corners (clear of the dinos' wander area)
	local gen = Rng.new(index * 17)
	for _, corner in { Vector3.new(-28.5, 0, 28.8), Vector3.new(28.5, 0, 28.8) } do
		Props.fern(
			(cf * CFrame.new(corner + Vector3.new(0, FLOOR_TOP, 0))).Position,
			0.75,
			gen,
			model
		)
	end
	for _, corner in { Vector3.new(-28.6, 0, -28.6), Vector3.new(28.6, 0, -28.6) } do
		Props.flowers(
			(cf * CFrame.new(corner + Vector3.new(0, FLOOR_TOP, 0))).Position,
			0.8,
			gen,
			model
		)
	end

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(6, 1, 6)
	spawn.CFrame = cf * CFrame.new(0, FLOOR_TOP - 0.4, -22)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Enabled = true
	spawn.Parent = model
	for _, child in spawn:GetChildren() do
		if child:IsA("Decal") then
			child:Destroy()
		end
	end

	-- Lock barrier (shown while the gate is locked)
	local barrier: { BasePart } = {}
	local wallHeight = 16
	local walls = {
		{ Vector3.new(Config.PLOT_SIZE, wallHeight, 0.6), Vector3.new(0, 0, -HALF - 0.4) },
		{ Vector3.new(Config.PLOT_SIZE, wallHeight, 0.6), Vector3.new(0, 0, HALF + 0.4) },
		{ Vector3.new(0.6, wallHeight, Config.PLOT_SIZE), Vector3.new(-HALF - 0.4, 0, 0) },
		{ Vector3.new(0.6, wallHeight, Config.PLOT_SIZE), Vector3.new(HALF + 0.4, 0, 0) },
	}
	for _, wall in walls do
		local p = Build.block(
			wall[1],
			cf * CFrame.new(wall[2] + Vector3.new(0, FLOOR_TOP + wallHeight / 2, 0)),
			Palette.red,
			model,
			{
				name = "Barrier",
				material = Enum.Material.ForceField,
				transparency = 1,
				collide = false,
				decor = true,
			}
		)
		table.insert(barrier, p)
	end

	-- Where dinos live (4 x 4 grid)
	local homeSpots: { CFrame } = {}
	for _, z in { -12, -3, 6, 15 } do
		for _, x in { -21, -7, 7, 21 } do
			table.insert(homeSpots, cf * CFrame.new(x, FLOOR_TOP, z))
		end
	end

	local dinoFolder = Instance.new("Folder")
	dinoFolder.Name = "Dinos"
	dinoFolder.Parent = model
	local eggFolder = Instance.new("Folder")
	eggFolder.Name = "Eggs"
	eggFolder.Parent = model
	local trayFolder = Instance.new("Folder")
	trayFolder.Name = "Tray"
	trayFolder.Parent = model

	model.Parent = plotsFolder

	return {
		index = index,
		model = model,
		cframe = cf,
		floorTop = FLOOR_TOP,
		accent = accent,
		incubators = incubators,
		incubatorLocks = incubatorLocks,
		incubatorRings = incubatorRings,
		traySpots = traySpots,
		pad = pad,
		padLabel = padLabel,
		signName = signName,
		signInfo = signInfo,
		signPart = signPart,
		ownerTag = ownerTag,
		barrier = barrier,
		spawn = spawn,
		homeSpots = homeSpots,
		dinoFolder = dinoFolder,
		eggFolder = eggFolder,
		trayFolder = trayFolder,
	}
end

-- ===== Shop =====

local function setUpShop(promptPart: BasePart)
	Prompts.create(promptPart, {
		action = "OpenUI",
		openUI = "Shop",
		text = "Egg Shop",
		objectText = "🥚",
		audience = "All",
		distance = 16,
	})
	local gui = billboard(
		promptPart,
		"ShopBillboard",
		UDim2.fromOffset(260, 110),
		Vector3.new(0, 30, 0),
		250
	)
	label(
		gui,
		"Title",
		"🥚 EGG SHOP",
		UDim2.fromScale(1, 0.6),
		UDim2.fromScale(0, 0),
		Color3.fromRGB(255, 230, 120)
	)
	label(gui, "Restock", "New stock in 5:00", UDim2.fromScale(1, 0.4), UDim2.fromScale(0, 0.6))
end

-- ===== API =====

function World.getPlot(index: number): PlotInfo?
	return World.plots[index]
end

-- Is a world position inside a plot (with optional margin in studs)?
function World.isInside(index: number, position: Vector3, margin: number?): boolean
	local plot = World.plots[index]
	if not plot then
		return false
	end
	local m = margin or 0
	local localPos = plot.cframe:PointToObjectSpace(position)
	return math.abs(localPos.X) <= HALF + m
		and math.abs(localPos.Z) <= HALF + m
		and localPos.Y > -6
		and localPos.Y < 80
end

-- Just outside a plot's gate, facing the hub.
function World.outsideGate(index: number): CFrame
	local plot = World.plots[index]
	return plot.cframe * CFrame.new(0, FLOOR_TOP + 3, -HALF - 10)
end

-- Set the owner text on the sign (both faces) and the floating name tag.
function World.setSign(plot: PlotInfo, name: string, info: string)
	for _, surface in plot.signPart:GetChildren() do
		if surface:IsA("SurfaceGui") then
			local n = surface:FindFirstChild("OwnerName")
			local i = surface:FindFirstChild("Info")
			if n and n:IsA("TextLabel") then
				n.Text = name
			end
			if i and i:IsA("TextLabel") then
				i.Text = info
			end
		end
	end
	plot.ownerTag.Text = name
end

function World.init()
	-- The edit-mode "Press Play" sign isn't needed once the game runs.
	local sign = Workspace:FindFirstChild("PressPlay")
	if sign then
		sign:Destroy()
	end

	local map = Instance.new("Folder")
	map.Name = "Map"
	local shopPrompt = Island.build(map)
	setUpShop(shopPrompt)
	map.Parent = Workspace

	local plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = Workspace
	for i = 1, Config.PLOT_COUNT do
		World.plots[i] = buildPlot(i, plotsFolder)
	end
end

return World
]]></string>
          </Properties>
