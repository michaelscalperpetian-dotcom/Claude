        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">FruitData</string>
            <string name="Source"><![CDATA[--!strict
-- Fruit you pick up under the fruit trees and feed to dinos to grow them faster.

export type Kind = "apple" | "golden"

export type Fruit = {
	kind: Kind,
	name: string,
	emoji: string,
	color: { number },
	grows: number, -- seconds of growth one fruit gives
	cap: number, -- how many fit in your basket
}

local FRUITS: { [string]: Fruit } = {
	apple = {
		kind = "apple",
		name = "Dino Apple",
		emoji = "🍎",
		color = { 235, 60, 60 },
		grows = 300,
		cap = 20,
	},
	golden = {
		kind = "golden",
		name = "Golden Apple",
		emoji = "🌟",
		color = { 255, 200, 50 },
		grows = 1800,
		cap = 5,
	},
}

local FruitData = {
	FRUITS = FRUITS,
	-- feeding uses apples first, then golden apples
	ORDER = { "apple", "golden" } :: { Kind },
	RESPAWN_SECONDS = 60,
	GOLDEN_CHANCE = 0.08,
	PICK_DISTANCE = 12,
}

function FruitData.get(kind: string): Fruit?
	return FRUITS[kind]
end

-- Which fruit a feed would use, given what's in the basket.
function FruitData.nextToFeed(basket: { [string]: number }): Kind?
	for _, kind in FruitData.ORDER do
		if (basket[kind] or 0) > 0 then
			return kind :: Kind
		end
	end
	return nil
end

return FruitData
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">MutationData</string>
            <string name="Source"><![CDATA[--!strict
-- Mutations multiply a dino's income and change how it looks. Storms boost the
-- chance of one mutation for everyone in the game at the same time.

export type MutationId = "Glossy" | "Lava" | "Frost" | "Cosmic" | "Rainbow"

export type Mutation = {
	id: MutationId,
	name: string,
	multiplier: number,
	emoji: string,
	color: { number },
}

export type StormKind = "Lava" | "Frost" | "Cosmic"

export type Storm = {
	kind: StormKind,
	name: string,
	emoji: string,
	weight: number,
}

local MUTATIONS: { [string]: Mutation } = {
	Glossy = {
		id = "Glossy",
		name = "Glossy",
		multiplier = 1.5,
		emoji = "✨",
		color = { 255, 250, 210 },
	},
	Lava = { id = "Lava", name = "Lava", multiplier = 3, emoji = "🌋", color = { 255, 110, 30 } },
	Frost = {
		id = "Frost",
		name = "Frost",
		multiplier = 3,
		emoji = "❄️",
		color = { 170, 225, 255 },
	},
	Cosmic = {
		id = "Cosmic",
		name = "Cosmic",
		multiplier = 5,
		emoji = "🌌",
		color = { 150, 90, 255 },
	},
	Rainbow = {
		id = "Rainbow",
		name = "Rainbow",
		multiplier = 8,
		emoji = "🌈",
		color = { 255, 120, 200 },
	},
}

local STORMS: { Storm } = {
	{ kind = "Lava", name = "Lava Storm", emoji = "🌋", weight = 40 },
	{ kind = "Frost", name = "Blizzard", emoji = "❄️", weight = 40 },
	{ kind = "Cosmic", name = "Meteor Shower", emoji = "🌠", weight = 20 },
}

local MutationData = {
	MUTATIONS = MUTATIONS,
	ORDER = { "Glossy", "Lava", "Frost", "Cosmic", "Rainbow" } :: { MutationId },
	STORMS = STORMS,
	MEGA_STORM_NAME = "Rainbow Mega Storm",
	MEGA_STORM_EMOJI = "🌈",

	-- Hatch mutation chances in basis points (1 bp = 0.01%).
	BASE_GLOSSY_BP = 200,
	STORM_MUTATION_BP = 1000,
	MEGA_RAINBOW_BP = 1500,
	MEGA_COSMIC_BP = 500,
	MEGA_GLOSSY_BP = 600,

	-- While a storm is active, each unmutated dino gets this chance per storm tick.
	STORM_DINO_MUTATE_BP = 150,
	MEGA_STORM_MULTIPLIER = 3,
}

export type MutationChance = { key: MutationId, bp: number }

-- Chances for a dino hatching right now. `stormKind` is the active storm (or nil).
function MutationData.hatchChances(stormKind: StormKind?, mega: boolean): { MutationChance }
	if mega then
		return {
			{ key = "Rainbow", bp = MutationData.MEGA_RAINBOW_BP },
			{ key = "Cosmic", bp = MutationData.MEGA_COSMIC_BP },
			{ key = "Glossy", bp = MutationData.MEGA_GLOSSY_BP },
		}
	elseif stormKind then
		return {
			{ key = stormKind :: MutationId, bp = MutationData.STORM_MUTATION_BP },
			{ key = "Glossy", bp = MutationData.BASE_GLOSSY_BP },
		}
	end
	return { { key = "Glossy", bp = MutationData.BASE_GLOSSY_BP } }
end

-- Which mutation a storm gives to dinos already living in nests.
function MutationData.stormGives(stormKind: StormKind?, mega: boolean): MutationId?
	if mega then
		return "Rainbow"
	end
	return stormKind
end

function MutationData.stormTickBp(mega: boolean): number
	return MutationData.STORM_DINO_MUTATE_BP
		* (if mega then MutationData.MEGA_STORM_MULTIPLIER else 1)
end

function MutationData.stormInfo(kind: StormKind): Storm
	for _, s in STORMS do
		if s.kind == kind then
			return s
		end
	end
	return STORMS[1]
end

function MutationData.get(id: string?): Mutation?
	if id == nil then
		return nil
	end
	return MUTATIONS[id]
end

function MutationData.multiplier(id: string?): number
	local m = MutationData.get(id)
	return if m then m.multiplier else 1
end

return MutationData
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">QuestData</string>
            <string name="Source"><![CDATA[--!strict
-- Daily quests: three a day, the same for everyone (picked from the date), so
-- friends can do them together. Progress comes from normal play, and every
-- quest can be finished alone. Pure data + logic: runs under Lune too.

local Rng = require(script.Parent.Parent.Util.Rng)
local Streak = require(script.Parent.Parent.Util.Streak)

export type Quest = {
	id: string,
	event: string, -- gameplay event that advances it
	goal: number,
	text: string,
	emoji: string,
	reward: Streak.Reward,
}

local POOL: { Quest } = {
	{
		id = "feed",
		event = "feed",
		goal = 3,
		text = "Feed your dinos 3 fruits",
		emoji = "🍎",
		reward = { kind = "coins", minutes = 10, minimum = 400, label = "Coins", emoji = "💰" },
	},
	{
		id = "hatch",
		event = "hatch",
		goal = 3,
		text = "Hatch 3 eggs",
		emoji = "🐣",
		reward = { kind = "coins", minutes = 15, minimum = 500, label = "Coins", emoji = "💰" },
	},
	{
		id = "buy",
		event = "buy_egg",
		goal = 4,
		text = "Buy 4 eggs at the Egg Shop",
		emoji = "🥚",
		reward = { kind = "coins", minutes = 12, minimum = 400, label = "Coins", emoji = "💰" },
	},
	{
		id = "collect",
		event = "collect",
		goal = 5,
		text = "Collect coins from your pad 5 times",
		emoji = "💰",
		reward = { kind = "luck", seconds = 600, label = "10 min Luck", emoji = "🍀" },
	},
	{
		id = "roar",
		event = "roar",
		goal = 5,
		text = "Roar 5 times",
		emoji = "🦖",
		reward = { kind = "coins", minutes = 8, minimum = 300, label = "Coins", emoji = "💰" },
	},
	{
		id = "laid",
		event = "incubate_tray",
		goal = 1,
		text = "Incubate an egg your dino laid",
		emoji = "🧺",
		reward = { kind = "coinBoost", seconds = 600, label = "10 min 2x Coins", emoji = "⚡" },
	},
	{
		id = "sell",
		event = "sell_tray",
		goal = 2,
		text = "Sell 2 laid eggs",
		emoji = "🏷",
		reward = { kind = "coins", minutes = 12, minimum = 400, label = "Coins", emoji = "💰" },
	},
}

local BY_ID: { [string]: Quest } = {}
for _, quest in POOL do
	BY_ID[quest.id] = quest
end

local QuestData = {
	POOL = POOL,
	PER_DAY = 3,
	-- extra prize for finishing all of today's quests
	ALL_DONE_REWARD = { kind = "luck", seconds = 1800, label = "30 min Luck", emoji = "🍀" } :: Streak.Reward,
}

function QuestData.get(id: string): Quest?
	return BY_ID[id]
end

-- Today's quests (same list for every player on the same UTC day).
function QuestData.forDay(day: number): { Quest }
	local gen = Rng.new(Rng.hash(day, 0x5157))
	local remaining = table.clone(POOL)
	local picked: { Quest } = {}
	for _ = 1, math.min(QuestData.PER_DAY, #remaining) do
		local index = gen.int(1, #remaining)
		table.insert(picked, table.remove(remaining, index) :: Quest)
	end
	return picked
end

return QuestData
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">StoreData</string>
            <string name="Source"><![CDATA[--!strict
