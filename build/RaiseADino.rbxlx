        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">DexRewards</string>
            <string name="Source"><![CDATA[--!strict
-- Prizes for filling the Dino-Dex: discover enough different species and a
-- milestone unlocks. The last one is for finding every species.

local DinoData = require(script.Parent.DinoData)
local Streak = require(script.Parent.Parent.Util.Streak)

export type Milestone = { count: number, reward: Streak.Reward }

local DexRewards = {
	MILESTONES = {
		{
			count = 3,
			reward = {
				kind = "coins",
				minutes = 20,
				minimum = 2000,
				label = "Coin bag",
				emoji = "💰",
			},
		},
		{
			count = 6,
			reward = { kind = "luck", seconds = 1800, label = "30 min Luck", emoji = "🍀" },
		},
		{
			count = 9,
			reward = {
				kind = "coinBoost",
				seconds = 3600,
				label = "1 hour 2x Coins",
				emoji = "⚡",
			},
		},
		{
			count = #DinoData.LIST,
			reward = {
				kind = "coins",
				minutes = 240,
				minimum = 500000,
				label = "Treasure",
				emoji = "👑",
			},
		},
	} :: { Milestone },
}

function DexRewards.discovered(dex: { [string]: { [string]: boolean } }): number
	local count = 0
	for species in dex do
		if DinoData.get(species) then
			count += 1
		end
	end
	return count
end

return DexRewards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">DinoData</string>
            <string name="Source"><![CDATA[--!strict
-- Every dinosaur species in the game. Adding a dino = one entry here (plus a
-- line in an egg's odds table). Colors and sizes are plain numbers so the Lune
-- unit tests can load this file without Roblox datatypes.

export type Rarity = "Common" | "Uncommon" | "Rare" | "Epic" | "Legendary" | "Secret"

export type Feature =
	"plates"
	| "frill"
	| "horns"
	| "club"
	| "sail"
	| "crest"
	| "dome"
	| "doubleCrest"
	| "wings"
	| "flippers"
	| "teeth"
	| "stripes"
	| "spikes"
	| "beakCrest"
	| "tailFin"
	| "spots"
	| "armor"

export type BodyKind = "biped" | "quad" | "flyer" | "swimmer"

export type BodyPlan = {
	kind: BodyKind,
	body: { number }, -- width, height, length (studs at scale 1)
	legHeight: number,
	legThickness: number,
	head: { number }, -- width, height, length
	neckLength: number,
	neckAngle: number, -- degrees above horizontal
	neckThickness: number,
	tailLength: number,
	tailThickness: number,
	arms: boolean,
	features: { Feature },
}

export type Rgb = { number }

export type Species = {
	id: string,
	name: string,
	rarity: Rarity,
	income: number, -- coins per second at Adult stage with no mutation
	growth: { number }, -- age (seconds) to become Juvenile, Adult, Giant
	layHatchSeconds: number, -- hatch time for eggs this dino lays
	scale: number, -- adult size multiplier
	colors: { main: Rgb, belly: Rgb, accent: Rgb },
	plan: BodyPlan,
	blurb: string,
}

export type RarityInfo = {
	order: number,
	color: Rgb,
	growth: { number },
	layHatchSeconds: number,
}

local RARITIES: { [Rarity]: RarityInfo } = {
	Common = {
		order = 1,
		color = { 190, 190, 190 },
		growth = { 300, 1800, 14400 },
		layHatchSeconds = 60,
	},
	Uncommon = {
		order = 2,
		color = { 110, 200, 110 },
		growth = { 480, 2700, 21600 },
		layHatchSeconds = 120,
	},
	Rare = {
		order = 3,
		color = { 80, 150, 255 },
		growth = { 600, 3600, 28800 },
		layHatchSeconds = 240,
	},
	Epic = {
		order = 4,
		color = { 180, 90, 255 },
		growth = { 900, 5400, 43200 },
		layHatchSeconds = 480,
	},
	Legendary = {
		order = 5,
		color = { 255, 185, 40 },
		growth = { 1200, 7200, 57600 },
		layHatchSeconds = 900,
	},
	Secret = {
		order = 6,
		color = { 255, 70, 120 },
		growth = { 1800, 10800, 86400 },
		layHatchSeconds = 1800,
	},
}

type SpeciesInput = {
	id: string,
	name: string,
	rarity: Rarity,
	income: number,
	scale: number,
	colors: { main: Rgb, belly: Rgb, accent: Rgb },
	plan: BodyPlan,
	blurb: string,
}

local function species(input: SpeciesInput): Species
	local rarity = RARITIES[input.rarity]
	return {
		id = input.id,
		name = input.name,
		rarity = input.rarity,
		income = input.income,
		growth = rarity.growth,
		layHatchSeconds = rarity.layHatchSeconds,
		scale = input.scale,
		colors = input.colors,
		plan = input.plan,
		blurb = input.blurb,
	}
end

local LIST: { Species } = {
	species({
		id = "Raptor",
		name = "Raptor",
		rarity = "Common",
		income = 2,
		scale = 1,
		colors = { main = { 120, 170, 90 }, belly = { 230, 220, 170 }, accent = { 70, 110, 60 } },
		plan = {
			kind = "biped",
			body = { 1.4, 1.4, 2.6 },
			legHeight = 1.4,
			legThickness = 0.45,
			head = { 0.9, 0.8, 1.3 },
			neckLength = 0.6,
			neckAngle = 35,
			neckThickness = 0.6,
			tailLength = 3,
			tailThickness = 0.7,
			arms = true,
			features = { "stripes" },
		},
		blurb = "Fast, clever and always hungry.",
	}),
	species({
		id = "Gallimimus",
		name = "Gallimimus",
		rarity = "Common",
		income = 3,
		scale = 1,
		colors = { main = { 220, 180, 110 }, belly = { 245, 230, 200 }, accent = { 170, 120, 70 } },
		plan = {
			kind = "biped",
			body = { 1.3, 1.3, 2.3 },
			legHeight = 2,
			legThickness = 0.4,
			head = { 0.6, 0.6, 0.9 },
			neckLength = 1.4,
			neckAngle = 55,
			neckThickness = 0.45,
			tailLength = 2.6,
			tailThickness = 0.6,
			arms = true,
			features = { "spots" },
		},
		blurb = "The speediest runner on the island.",
	}),
	species({
		id = "Pachy",
		name = "Pachycephalosaurus",
		rarity = "Common",
		income = 4,
		scale = 1.05,
		colors = { main = { 160, 120, 200 }, belly = { 230, 210, 240 }, accent = { 240, 200, 90 } },
		plan = {
			kind = "biped",
			body = { 1.6, 1.5, 2.4 },
			legHeight = 1.3,
			legThickness = 0.55,
			head = { 1, 1, 1.1 },
			neckLength = 0.5,
			neckAngle = 30,
			neckThickness = 0.7,
			tailLength = 2.4,
			tailThickness = 0.8,
			arms = true,
			features = { "dome" },
		},
		blurb = "Has a super hard head. Do not play bonk with it.",
	}),
	species({
		id = "Compy",
		name = "Compsognathus",
		rarity = "Common",
		income = 5,
		scale = 0.85,
		colors = { main = { 150, 200, 120 }, belly = { 240, 240, 200 }, accent = { 90, 140, 70 } },
		plan = {
			kind = "biped",
			body = { 1.1, 1.1, 2 },
			legHeight = 1.2,
			legThickness = 0.35,
			head = { 0.75, 0.7, 1.1 },
			neckLength = 0.7,
			neckAngle = 45,
