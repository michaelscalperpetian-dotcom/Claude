      <Item class="LocalScript" referent="65">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
-- Raise a Dino client entry point. Same two-phase bootstrap as the server.

local Controllers = script:WaitForChild("Controllers")

type Controller = {
	init: (() -> ())?,
	start: (() -> ())?,
}

local loaded: { [string]: Controller } = {}
local order: { string } = {}
for _, child in Controllers:GetChildren() do
	if child:IsA("ModuleScript") then
		loaded[child.Name] = require(child) :: any
		table.insert(order, child.Name)
	end
end
table.sort(order)

for _, name in order do
	local controller = loaded[name]
	if controller.init then
		controller.init()
	end
end

for _, name in order do
	local controller = loaded[name]
	if controller.start then
		task.spawn(controller.start)
	end
end

print("[RaiseADino] client started")
]]></string>
        </Properties>
        <Item class="Folder" referent="66">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">ClientState</string>
              <string name="Source"><![CDATA[--!strict
-- Holds the latest snapshot of this player's state from the server and tells
-- other controllers when it changes. The client never computes anything that
-- matters; it just draws this.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Cycle = require(ReplicatedStorage.Shared.Util.Cycle)
local Net = require(ReplicatedStorage.Shared.Net)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Types = require(ReplicatedStorage.Shared.Types)

local ClientState = {}

ClientState.changed = Signal.new() :: Signal.Signal<Types.Snapshot>

local current: Types.Snapshot? = nil

function ClientState.get(): Types.Snapshot?
	return current
end

-- The player's own plot model (nil until assigned).
function ClientState.myPlot(): Model?
	local snapshot = current
	if not snapshot or snapshot.plotIndex == 0 then
		return nil
	end
	local plots = Workspace:FindFirstChild("Plots")
	local plot = plots and plots:FindFirstChild("Plot" .. snapshot.plotIndex)
	if plot and plot:IsA("Model") then
		return plot
	end
	return nil
end

function ClientState.isNight(): boolean
	return Cycle.dayNight(Clock.cycleNow()).isNight
end

function ClientState.tutorialActive(): boolean
	local snapshot = current
	return snapshot ~= nil and snapshot.tutorial ~= 99
end

function ClientState.localPlayer(): Player
	return Players.LocalPlayer
end

function ClientState.init()
	Net.listen("State", function(snapshot: Types.Snapshot)
		current = snapshot
		ClientState.changed:fire(snapshot)
	end)
end

function ClientState.start()
	Net.send("Ready")
end

return ClientState
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">DevPanel</string>
              <string name="Source"><![CDATA[--!strict
-- QA cheat panel. Only appears when the server says you're a developer
-- (always in Studio). The server checks permission on every command too.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local StoreData = require(ReplicatedStorage.Shared.Data.StoreData)
local Types = require(ReplicatedStorage.Shared.Types)
local ClientState = require(script.Parent.ClientState)
local Panels = require(script.Parent.Parent.Lib.Panels)
local UI = require(script.Parent.Parent.Lib.UI)

local DevPanel = {}

local toggle: TextButton

local COMMANDS = {
	{ "coins", "+1M coins" },
	{ "grow", "Grow dinos" },
	{ "hatch", "Eggs ready" },
	{ "lay", "Lay eggs" },
	{ "night", "Make night" },
	{ "day", "Make day" },
	{ "storm", "Start storm" },
	{ "mega", "Mega storm" },
	{ "resettime", "Normal time" },
	{ "luck", "Luck 15m" },
	{ "trex", "Add T-Rex" },
	{ "noshield", "Remove shield" },
	{ "skiptutorial", "Skip tutorial" },
	{ "reset", "Reset save" },
}

function DevPanel.init()
	local _, content =
		Panels.window("Dev", "🛠 Test Tools (Studio only)", Vector2.new(760, 500), UI.Theme.grey)
	local grid = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		Parent = content,
	}, {
		UI.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(170, 54),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	}) :: ScrollingFrame
	for order, entry in COMMANDS do
		UI.button({
			text = entry[2],
			size = UDim2.fromOffset(170, 54),
			color = if entry[1] == "reset" then UI.Theme.red else UI.Theme.blue,
			order = order,
			maxTextSize = 22,
			parent = grid,
			onClick = function()
				Net.send("Cheat", entry[1])
			end,
		})
	end
	for order, pass in StoreData.PASSES do
		UI.button({
			text = "Pass: " .. pass.name,
			size = UDim2.fromOffset(170, 54),
			color = UI.Theme.purple,
			order = 100 + order,
			maxTextSize = 18,
			parent = grid,
			onClick = function()
				Net.send("Cheat", "pass", pass.key)
			end,
		})
	end

	local screen = UI.screen("DevToggle", 4)
	toggle = UI.button({
		text = "🛠",
		size = UDim2.fromOffset(56, 56),
		position = UDim2.new(0, 12, 0, 60),
		color = UI.Theme.grey,
		parent = screen,
		onClick = function()
			Panels.toggle("Dev")
		end,
	})
	toggle.Visible = false
	ClientState.changed:connect(function(snapshot: Types.Snapshot)
		toggle.Visible = snapshot.isDev
	end)
end

return DevPanel
]]></string>
            </Properties>
