		},
		blurb = "Tiny, zippy and always underfoot.",
	}),
	species({
		id = "Parasaur",
		name = "Parasaurolophus",
		rarity = "Uncommon",
		income = 10,
		scale = 1.3,
		colors = { main = { 230, 140, 90 }, belly = { 250, 220, 180 }, accent = { 200, 70, 60 } },
		plan = {
			kind = "biped",
			body = { 1.8, 1.7, 3 },
			legHeight = 1.6,
			legThickness = 0.6,
			head = { 0.9, 0.9, 1.4 },
			neckLength = 1,
			neckAngle = 45,
			neckThickness = 0.7,
			tailLength = 3,
			tailThickness = 0.9,
			arms = true,
			features = { "crest" },
		},
		blurb = "Toots through its crest like a trumpet.",
	}),
	species({
		id = "Dilophosaurus",
		name = "Dilophosaurus",
		rarity = "Uncommon",
		income = 12,
		scale = 1.15,
		colors = { main = { 90, 170, 190 }, belly = { 220, 240, 230 }, accent = { 230, 90, 110 } },
		plan = {
			kind = "biped",
			body = { 1.5, 1.4, 2.7 },
			legHeight = 1.5,
			legThickness = 0.5,
			head = { 0.85, 0.8, 1.3 },
			neckLength = 0.8,
			neckAngle = 40,
			neckThickness = 0.6,
			tailLength = 3,
			tailThickness = 0.75,
			arms = true,
			features = { "doubleCrest", "stripes" },
		},
		blurb = "Two fancy crests and a big attitude.",
	}),
	species({
		id = "Stegosaurus",
		name = "Stegosaurus",
		rarity = "Uncommon",
		income = 15,
		scale = 1.4,
		colors = { main = { 120, 160, 120 }, belly = { 220, 220, 180 }, accent = { 220, 120, 80 } },
		plan = {
			kind = "quad",
			body = { 2, 1.9, 3.4 },
			legHeight = 1.2,
			legThickness = 0.7,
			head = { 0.7, 0.6, 1 },
			neckLength = 0.7,
			neckAngle = 5,
			neckThickness = 0.7,
			tailLength = 2.8,
			tailThickness = 1,
			arms = false,
			features = { "plates", "spikes" },
		},
		blurb = "Plates on its back, spikes on its tail.",
	}),
	species({
		id = "Iguanodon",
		name = "Iguanodon",
		rarity = "Uncommon",
		income = 18,
		scale = 1.45,
		colors = { main = { 130, 170, 150 }, belly = { 225, 235, 215 }, accent = { 90, 120, 100 } },
		plan = {
			kind = "biped",
			body = { 2, 1.9, 3.2 },
			legHeight = 1.7,
			legThickness = 0.75,
			head = { 1, 0.9, 1.5 },
			neckLength = 0.8,
			neckAngle = 35,
			neckThickness = 0.8,
			tailLength = 3.2,
			tailThickness = 1,
			arms = true,
			features = { "spots" },
		},
		blurb = "Gives the best thumbs-up on the island.",
	}),
	species({
		id = "Triceratops",
		name = "Triceratops",
		rarity = "Rare",
		income = 45,
		scale = 1.6,
		colors = { main = { 110, 140, 200 }, belly = { 220, 225, 240 }, accent = { 240, 190, 90 } },
		plan = {
			kind = "quad",
			body = { 2.4, 2, 3.4 },
			legHeight = 1.2,
			legThickness = 0.85,
			head = { 1.3, 1.2, 1.6 },
			neckLength = 0.4,
			neckAngle = 10,
			neckThickness = 1,
			tailLength = 2.2,
			tailThickness = 1,
			arms = false,
			features = { "frill", "horns" },
		},
		blurb = "Three horns, one giant frill, zero fear.",
	}),
	species({
		id = "Ankylosaurus",
		name = "Ankylosaurus",
		rarity = "Rare",
