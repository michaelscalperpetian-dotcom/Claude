local BY_ID: { [string]: Species } = {}
for _, s in LIST do
	BY_ID[s.id] = s
end

local DinoData = {
	LIST = LIST,
	BY_ID = BY_ID,
	RARITIES = RARITIES,
	RARITY_ORDER = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Secret" } :: { Rarity },
}

function DinoData.get(id: string): Species?
	return BY_ID[id]
end

function DinoData.rarityInfo(rarity: Rarity): RarityInfo
	return RARITIES[rarity]
end

function DinoData.rarityOrder(id: string): number
	local s = BY_ID[id]
	if not s then
		return 0
	end
	return RARITIES[s.rarity].order
end

return DinoData
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">EggData</string>
            <string name="Source"><![CDATA[--!strict
-- Shop eggs. Odds are stored as integer basis points (1 bp = 0.01%) that sum to
-- exactly 10000 for every egg. The odds shown to players and the odds used when
-- hatching both come from these tables, so they can never disagree.
-- (Roblox paid random item policy: show every outcome with real % odds.)

export type OddsEntry = { species: string, weight: number }

export type EggType = {
	id: string,
	name: string,
	order: number,
	price: number,
	hatchSeconds: number,
	colors: { main: { number }, spots: { number } },
	material: "SmoothPlastic" | "Neon" | "Glass",
	odds: { OddsEntry },
	stock: { chance: number, min: number, max: number },
}

local LIST: { EggType } = {
	{
		id = "Jungle",
		name = "Jungle Egg",
		order = 1,
		price = 50,
		hatchSeconds = 30,
		colors = { main = { 140, 200, 100 }, spots = { 60, 120, 50 } },
		material = "SmoothPlastic",
		odds = {
			{ species = "Raptor", weight = 4500 },
			{ species = "Gallimimus", weight = 3000 },
			{ species = "Pachy", weight = 2000 },
			{ species = "Parasaur", weight = 380 },
			{ species = "Dilophosaurus", weight = 120 },
		},
		stock = { chance = 1, min = 3, max = 6 },
	},
	{
		id = "Swamp",
		name = "Swamp Egg",
		order = 2,
		price = 600,
		hatchSeconds = 90,
		colors = { main = { 90, 150, 140 }, spots = { 120, 90, 60 } },
		material = "SmoothPlastic",
		odds = {
			{ species = "Gallimimus", weight = 1500 },
			{ species = "Pachy", weight = 1500 },
			{ species = "Parasaur", weight = 2600 },
			{ species = "Dilophosaurus", weight = 2000 },
			{ species = "Stegosaurus", weight = 1600 },
			{ species = "Triceratops", weight = 600 },
			{ species = "Ankylosaurus", weight = 200 },
		},
		stock = { chance = 0.85, min = 1, max = 4 },
	},
	{
		id = "Volcano",
		name = "Volcano Egg",
		order = 3,
		price = 7500,
		hatchSeconds = 300,
		colors = { main = { 90, 30, 30 }, spots = { 255, 120, 30 } },
		material = "SmoothPlastic",
		odds = {
			{ species = "Stegosaurus", weight = 2000 },
			{ species = "Triceratops", weight = 2500 },
			{ species = "Ankylosaurus", weight = 2300 },
			{ species = "Pteranodon", weight = 2000 },
			{ species = "Brachiosaurus", weight = 800 },
			{ species = "Spinosaurus", weight = 350 },
			{ species = "TRex", weight = 50 },
		},
		stock = { chance = 0.5, min = 1, max = 2 },
	},
	{
		id = "Crystal",
		name = "Crystal Egg",
		order = 4,
		price = 90000,
		hatchSeconds = 900,
		colors = { main = { 160, 220, 255 }, spots = { 255, 255, 255 } },
		material = "Glass",
		odds = {
			{ species = "Triceratops", weight = 1000 },
			{ species = "Ankylosaurus", weight = 1500 },
			{ species = "Pteranodon", weight = 2500 },
			{ species = "Brachiosaurus", weight = 2500 },
			{ species = "Spinosaurus", weight = 1800 },
			{ species = "TRex", weight = 690 },
			{ species = "Mosasaurus", weight = 10 },
		},
		stock = { chance = 0.15, min = 1, max = 1 },
	},
}

local BY_ID: { [string]: EggType } = {}
for _, egg in LIST do
	BY_ID[egg.id] = egg
end

local EggData = {
	LIST = LIST,
	BY_ID = BY_ID,
	TOTAL_BP = 10000,
}

function EggData.get(id: string): EggType?
	return BY_ID[id]
end

return EggData
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">MutationData</string>
            <string name="Source"><![CDATA[--!strict
-- Mutations multiply a dino's income and change how it looks. Storms boost the
-- chance of one mutation for everyone in the game at the same time.

export type MutationId = "Glossy" | "Lava" | "Frost" | "Cosmic" | "Rainbow"

export type Mutation = {
	id: MutationId,
	name: string,
	multiplier: number,
	emoji: string,
	color: { number },
}

export type StormKind = "Lava" | "Frost" | "Cosmic"

export type Storm = {
	kind: StormKind,
	name: string,
	emoji: string,
	weight: number,
}

local MUTATIONS: { [string]: Mutation } = {
	Glossy = {
		id = "Glossy",
		name = "Glossy",
		multiplier = 1.5,
		emoji = "✨",
		color = { 255, 250, 210 },
	},
	Lava = { id = "Lava", name = "Lava", multiplier = 3, emoji = "🌋", color = { 255, 110, 30 } },
	Frost = {
		id = "Frost",
		name = "Frost",
		multiplier = 3,
		emoji = "❄️",
		color = { 170, 225, 255 },
	},
	Cosmic = {
		id = "Cosmic",
		name = "Cosmic",
		multiplier = 5,
		emoji = "🌌",
		color = { 150, 90, 255 },
	},
	Rainbow = {
		id = "Rainbow",
		name = "Rainbow",
		multiplier = 8,
		emoji = "🌈",
		color = { 255, 120, 200 },
	},
}

local STORMS: { Storm } = {
	{ kind = "Lava", name = "Lava Storm", emoji = "🌋", weight = 40 },
	{ kind = "Frost", name = "Blizzard", emoji = "❄️", weight = 40 },
	{ kind = "Cosmic", name = "Meteor Shower", emoji = "🌠", weight = 20 },
}

local MutationData = {
	MUTATIONS = MUTATIONS,
	ORDER = { "Glossy", "Lava", "Frost", "Cosmic", "Rainbow" } :: { MutationId },
	STORMS = STORMS,
	MEGA_STORM_NAME = "Rainbow Mega Storm",
	MEGA_STORM_EMOJI = "🌈",

	-- Hatch mutation chances in basis points (1 bp = 0.01%).
	BASE_GLOSSY_BP = 200,
	STORM_MUTATION_BP = 1000,
	MEGA_RAINBOW_BP = 1500,
	MEGA_COSMIC_BP = 500,
	MEGA_GLOSSY_BP = 600,

	-- While a storm is active, each unmutated dino gets this chance per storm tick.
	STORM_DINO_MUTATE_BP = 150,
	MEGA_STORM_MULTIPLIER = 3,
}

export type MutationChance = { key: MutationId, bp: number }

-- Chances for a dino hatching right now. `stormKind` is the active storm (or nil).
function MutationData.hatchChances(stormKind: StormKind?, mega: boolean): { MutationChance }
	if mega then
		return {
			{ key = "Rainbow", bp = MutationData.MEGA_RAINBOW_BP },
			{ key = "Cosmic", bp = MutationData.MEGA_COSMIC_BP },
			{ key = "Glossy", bp = MutationData.MEGA_GLOSSY_BP },
		}
	elseif stormKind then
		return {
			{ key = stormKind :: MutationId, bp = MutationData.STORM_MUTATION_BP },
			{ key = "Glossy", bp = MutationData.BASE_GLOSSY_BP },
		}
	end
	return { { key = "Glossy", bp = MutationData.BASE_GLOSSY_BP } }
end

-- Which mutation a storm gives to dinos already living in nests.
function MutationData.stormGives(stormKind: StormKind?, mega: boolean): MutationId?
	if mega then
		return "Rainbow"
	end
	return stormKind
end

function MutationData.stormTickBp(mega: boolean): number
	return MutationData.STORM_DINO_MUTATE_BP
		* (if mega then MutationData.MEGA_STORM_MULTIPLIER else 1)
end

function MutationData.stormInfo(kind: StormKind): Storm
	for _, s in STORMS do
		if s.kind == kind then
			return s
		end
	end
	return STORMS[1]
end

function MutationData.get(id: string?): Mutation?
	if id == nil then
		return nil
	end
	return MUTATIONS[id]
end

function MutationData.multiplier(id: string?): number
	local m = MutationData.get(id)
	return if m then m.multiplier else 1
end

return MutationData
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">StoreData</string>
            <string name="Source"><![CDATA[--!strict
