  <Item class="StarterPlayer" referent="80">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="81">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="82">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
-- Raise a Dino client entry point. Same two-phase bootstrap as the server.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Studs = require(ReplicatedStorage.Shared.Visual.Studs)

Studs.apply()

local Controllers = script:WaitForChild("Controllers")

type Controller = {
	init: (() -> ())?,
	start: (() -> ())?,
}

local loaded: { [string]: Controller } = {}
local order: { string } = {}
for _, child in Controllers:GetChildren() do
	if child:IsA("ModuleScript") then
		-- One broken controller must not stop the others from loading.
		local ok, result = pcall(require, child)
		if ok then
			loaded[child.Name] = result :: any
			table.insert(order, child.Name)
		else
			warn(`[RaiseADino] {child.Name} failed to load: {result}`)
		end
	end
end
table.sort(order)

for _, name in order do
	local init = loaded[name].init
	if init then
		local ok, err = pcall(function()
			init()
		end)
		if not ok then
			warn(`[RaiseADino] {name}.init failed: {err}`)
		end
	end
end

for _, name in order do
	local controller = loaded[name]
	if controller.start then
		task.spawn(controller.start)
	end
end

print("[RaiseADino] client started")
]]></string>
        </Properties>
        <Item class="Folder" referent="83">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">Audio</string>
              <string name="Source"><![CDATA[--!strict
-- Sound effects and music. Effects use the sounds that ship with every Roblox
-- client (rbxasset://sounds/...), so they always load and need no uploads;
-- pitch and layering turn a few clips into distinct cues. Music plays the
-- tracks listed in Config.MUSIC_TRACKS, if any. Both obey the Settings switches.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage.Shared.Config)
local Types = require(ReplicatedStorage.Shared.Types)
local ClientState = require(script.Parent.ClientState)
local Effects = require(script.Parent.Effects)
local SettingsUI = require(script.Parent.SettingsUI)
local Toasts = require(script.Parent.Toasts)
local UI = require(script.Parent.Parent.Lib.UI)

local Audio = {}

-- Built-in client sounds (content/sounds in the Roblox install).
local CLIPS: { [string]: string } = {
	tick = "rbxasset://sounds/volume_slider.ogg",
	whoosh = "rbxasset://sounds/action_jump.mp3",
	thud = "rbxasset://sounds/action_jump_land.mp3",
	boom = "rbxasset://sounds/impact_explosion_03.mp3",
	wind = "rbxasset://sounds/action_falling.ogg",
	splash = "rbxasset://sounds/impact_water.mp3",
}

-- A cue is one or more clips: { clip, speed, volume, delay }.
type Note = { clip: string, speed: number, volume: number, delay: number? }

local CUES: { [string]: { Note } } = {
	click = { { clip = "tick", speed = 1.15, volume = 0.5 } },
	open = { { clip = "whoosh", speed = 1.6, volume = 0.3 } },
	coins = {
		{ clip = "tick", speed = 1.5, volume = 0.55 },
		{ clip = "tick", speed = 1.75, volume = 0.55, delay = 0.07 },
		{ clip = "tick", speed = 2.0, volume = 0.6, delay = 0.14 },
	},
	good = {
		{ clip = "tick", speed = 1.3, volume = 0.45 },
		{ clip = "tick", speed = 1.65, volume = 0.45, delay = 0.08 },
	},
	bad = {
		{ clip = "tick", speed = 0.7, volume = 0.5 },
		{ clip = "tick", speed = 0.55, volume = 0.5, delay = 0.1 },
	},
	rare = {
		{ clip = "tick", speed = 1.4, volume = 0.5 },
		{ clip = "tick", speed = 1.7, volume = 0.5, delay = 0.08 },
		{ clip = "tick", speed = 2.1, volume = 0.55, delay = 0.16 },
	},
	event = { { clip = "wind", speed = 1.1, volume = 0.35 } },
	crack = { { clip = "thud", speed = 1.8, volume = 0.6 } },
	pop = {
		{ clip = "boom", speed = 1.5, volume = 0.3 },
		{ clip = "tick", speed = 1.9, volume = 0.5, delay = 0.05 },
	},
	big = { { clip = "boom", speed = 0.95, volume = 0.4, delay = 0.08 } },
}

local templates: { [string]: Sound } = {}
local sfxGroup: SoundGroup
local musicGroup: SoundGroup
local music: Sound? = nil

local function enabled(key: string): boolean
	return SettingsUI.get(key)
end

local function playNote(note: Note)
	local template = templates[note.clip]
	if not template then
		return
	end
	local sound = template:Clone()
	sound.PlaybackSpeed = note.speed
	sound.Volume = note.volume
	sound.Parent = sfxGroup
	sound:Play()
	task.delay(4, function()
		sound:Destroy()
	end)
end

function Audio.play(cue: string)
	if not enabled("sfx") then
		return
	end
	local notes = CUES[cue]
	if not notes then
		return
	end
	for _, note in notes do
		if note.delay then
			task.delay(note.delay, playNote, note)
		else
			playNote(note)
		end
	end
end

-- ===== Music =====

local function nextTrack(): number?
	local tracks = Config.MUSIC_TRACKS
	if #tracks == 0 then
		return nil
	end
	return tracks[math.random(1, #tracks)]
end

local function updateMusic()
	local on = enabled("music") and #Config.MUSIC_TRACKS > 0
	if on and not music then
		local id = nextTrack()
		if not id then
			return
		end
		local sound = Instance.new("Sound")
		sound.Name = "Music"
		sound.SoundId = "rbxassetid://" .. id
		sound.Volume = 0.3
		sound.Parent = musicGroup
		sound.Ended:Connect(function()
			local following = nextTrack()
			if following and music == sound then
				sound.SoundId = "rbxassetid://" .. following
				sound:Play()
			end
		end)
		sound:Play()
		music = sound
	elseif not on and music then
		music:Destroy()
		music = nil
	end
end

function Audio.init()
	sfxGroup = Instance.new("SoundGroup")
	sfxGroup.Name = "SFX"
	sfxGroup.Volume = 0.8
	sfxGroup.Parent = SoundService
	musicGroup = Instance.new("SoundGroup")
	musicGroup.Name = "Music"
	musicGroup.Volume = 0.6
	musicGroup.Parent = SoundService
	for name, id in CLIPS do
		local sound = Instance.new("Sound")
		sound.Name = name
		sound.SoundId = id
		sound.Parent = sfxGroup
		templates[name] = sound
	end

	UI.onClick = function()
		Audio.play("click")
	end
	UI.onOpen = function()
		Audio.play("open")
	end
	Toasts.onShow = function(style: string)
		if style == "good" or style == "bad" or style == "rare" or style == "event" then
			Audio.play(style)
		end
	end
	Effects.onCrack = function()
		Audio.play("crack")
	end
	Effects.onCoins = function()
		Audio.play("coins")
	end
	Effects.onReveal = function(rarity: string)
		Audio.play("pop")
		if rarity == "Epic" or rarity == "Legendary" or rarity == "Secret" then
			Audio.play("big")
		end
	end
	SettingsUI.changed = function(key: string, _on: boolean)
		if key == "music" then
			updateMusic()
		end
	end
end

function Audio.start()
	-- Saved settings arrive with the state snapshots; follow the music
	-- setting whenever it changes (including the first snapshot).
	local lastMusic: boolean? = nil
	ClientState.changed:connect(function(_: Types.Snapshot)
		local musicOn = SettingsUI.get("music")
		if musicOn ~= lastMusic then
			lastMusic = musicOn
			updateMusic()
		end
	end)
end

return Audio
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">Buddies</string>
              <string name="Source"><![CDATA[--!strict
-- Buddy dinos: a small copy of a player's chosen dino that hops along behind
-- them. The server sets a "Buddy" attribute on each Player
-- ("species|mutation|stage"); every client draws everyone's buddy locally so
-- the movement is smooth.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local DinoModel = require(ReplicatedStorage.Shared.Visual.DinoModel)
local Growth = require(ReplicatedStorage.Shared.Util.Growth)

local Buddies = {}

local ATTRIBUTE = "Buddy"
local MAX_STAGE = Growth.JUVENILE -- buddies stay pet-sized
local SIDE_OFFSET = 3.5
local BACK_OFFSET = 4.5
local FAR = 160 -- buddies further from the camera than this aren't animated
local GROUND_EVERY = 3 -- frames between ground checks

type Follower = {
	look: string,
	model: Model,
	root: BasePart,
	position: Vector3,
	facing: Vector3,
	phase: number,
	ground: number?, -- last ground height under the target spot
	frame: number, -- staggers ground checks between buddies
}

local followers: { [Player]: Follower } = {}
local folder: Folder
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function remove(player: Player)
	local follower = followers[player]
	if follower then
		follower.model:Destroy()
		followers[player] = nil
	end
end

local function build(player: Player, look: string)
	remove(player)
	local species, mutation, stageText, goldenText =
		string.match(look, "^([^|]+)|([^|]*)|(%d+)|?(%a*)$")
	if not species then
		return
	end
	local stage = math.min(tonumber(stageText) or 1, MAX_STAGE)
	local ok, model = pcall(function()
		return DinoModel.build(
			species,
			stage,
			if mutation == "" then nil else mutation,
			"World",
			goldenText == "g"
		)
	end)
	if not ok then
		return
	end
	model.Name = "Buddy_" .. player.Name
	local root = model.PrimaryPart :: BasePart
	model.Parent = folder
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	local start = if hrp and hrp:IsA("BasePart")
		then hrp.CFrame.Position - Vector3.new(0, 3, 0)
		else Vector3.zero
	followers[player] = {
		look = look,
		model = model,
		root = root,
		position = start,
		facing = Vector3.new(0, 0, -1),
		phase = math.random() * 10,
		ground = nil,
		frame = math.random(0, GROUND_EVERY - 1),
	}
end

local function sync(player: Player)
	local look = player:GetAttribute(ATTRIBUTE)
	if typeof(look) ~= "string" or look == "" then
		remove(player)
		return
	end
	local existing = followers[player]
	if not existing or existing.look ~= look then
		build(player, look)
	end
end

local function watch(player: Player)
	sync(player)
	player:GetAttributeChangedSignal(ATTRIBUTE):Connect(function()
		sync(player)
	end)
end

local function groundBelow(position: Vector3, ignore: { Instance }): number?
	rayParams.FilterDescendantsInstances = ignore
	local hit =
		Workspace:Raycast(position + Vector3.new(0, 6, 0), Vector3.new(0, -20, 0), rayParams)
	return if hit then hit.Position.Y else nil
end

local ignore: { Instance } = {}

local function step(dt: number)
	local camera = Workspace.CurrentCamera
	local eye = if camera then camera.CFrame.Position else nil
	for player, follower in followers do
		local character = player.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if not character or not hrp or not hrp:IsA("BasePart") then
			continue
		end
		local rootCf = hrp.CFrame
		if eye and (rootCf.Position - eye).Magnitude > FAR then
			continue -- out of sight; it snaps back into place when it's near again
		end
		local look = rootCf.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude < 1e-3 then
			flat = Vector3.new(0, 0, -1)
		end
		flat = flat.Unit
		local right = Vector3.new(-flat.Z, 0, flat.X)
		local target = rootCf.Position - flat * BACK_OFFSET + right * SIDE_OFFSET
		follower.frame += 1
		if follower.ground == nil or follower.frame % GROUND_EVERY == 0 then
			ignore[1] = character
			ignore[2] = folder
			follower.ground = groundBelow(target, ignore)
		end
		local ground = follower.ground or (rootCf.Position.Y - 3)
		target = Vector3.new(target.X, ground, target.Z)

		local before = follower.position
		if (target - before).Magnitude > 40 then
			follower.position = target -- teleported: snap
		else
			local alpha = 1 - math.exp(-dt * 7)
			follower.position = before:Lerp(target, alpha)
		end
		local moved = follower.position - before
		local speed = moved.Magnitude / math.max(dt, 1e-3)
		local moving = Vector3.new(moved.X, 0, moved.Z)
		if speed > 1 and moving.Magnitude > 1e-4 then
			follower.facing = follower.facing:Lerp(moving.Unit, math.min(1, dt * 10))
		else
			follower.facing = follower.facing:Lerp(flat, math.min(1, dt * 3))
		end
		-- cartoon hop while walking, gentle breathing while idle
		follower.phase += dt * (if speed > 1 then 11 else 2)
		local hop = if speed > 1
			then math.abs(math.sin(follower.phase)) * 0.7
			else math.sin(follower.phase) * 0.05
		local facing = if follower.facing.Magnitude > 1e-3 then follower.facing.Unit else flat
		local position = follower.position + Vector3.new(0, hop + 0.1, 0)
		follower.root.CFrame = CFrame.lookAt(position, position + facing)
	end
end

function Buddies.init()
	folder = Instance.new("Folder")
	folder.Name = "Buddies"
	folder.Parent = Workspace
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(remove)
end

function Buddies.start()
	RunService.RenderStepped:Connect(step)
end

return Buddies
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">ClientState</string>
              <string name="Source"><![CDATA[--!strict
-- Holds the latest snapshot of this player's state from the server and tells
-- other controllers when it changes. The client never computes anything that
-- matters; it just draws this.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Cycle = require(ReplicatedStorage.Shared.Util.Cycle)
local Net = require(ReplicatedStorage.Shared.Net)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Types = require(ReplicatedStorage.Shared.Types)

local ClientState = {}

ClientState.changed = Signal.new() :: Signal.Signal<Types.Snapshot>

local current: Types.Snapshot? = nil

function ClientState.get(): Types.Snapshot?
	return current
end

-- The player's own plot model (nil until assigned).
function ClientState.myPlot(): Model?
	local snapshot = current
	if not snapshot or snapshot.plotIndex == 0 then
		return nil
	end
	local plots = Workspace:FindFirstChild("Plots")
	local plot = plots and plots:FindFirstChild("Plot" .. snapshot.plotIndex)
	if plot and plot:IsA("Model") then
		return plot
	end
	return nil
end

function ClientState.isNight(): boolean
	return Cycle.dayNight(Clock.cycleNow()).isNight
end

function ClientState.tutorialActive(): boolean
	local snapshot = current
	return snapshot ~= nil and snapshot.tutorial ~= 99
end

function ClientState.localPlayer(): Player
	return Players.LocalPlayer
end

function ClientState.init()
	Net.listen("State", function(snapshot: Types.Snapshot)
		current = snapshot
		ClientState.changed:fire(snapshot)
	end)
end

function ClientState.start()
	Net.send("Ready")
end

return ClientState
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">DevPanel</string>
              <string name="Source"><![CDATA[--!strict
-- QA cheat panel. Only appears when the server says you're a developer
-- (always in Studio). The server checks permission on every command too.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local StoreData = require(ReplicatedStorage.Shared.Data.StoreData)
local Types = require(ReplicatedStorage.Shared.Types)
local ClientState = require(script.Parent.ClientState)
local Panels = require(script.Parent.Parent.Lib.Panels)
local UI = require(script.Parent.Parent.Lib.UI)

local DevPanel = {}

local toggle: UI.Button

local COMMANDS = {
	{ "coins", "+1M coins" },
	{ "grow", "Grow dinos" },
	{ "hatch", "Eggs ready" },
	{ "lay", "Lay eggs" },
	{ "night", "Make night" },
	{ "day", "Make day" },
	{ "storm", "Start storm" },
	{ "mega", "Mega storm" },
	{ "resettime", "Normal time" },
	{ "luck", "Luck 15m" },
	{ "trex", "Add T-Rex" },
	{ "raptors", "Add 3 Raptors" },
	{ "noshield", "Remove shield" },
	{ "skiptutorial", "Skip tutorial" },
	{ "reset", "Reset save" },
}

function DevPanel.init()
	local _, content =
		Panels.window("Dev", "🛠 Test Tools", Vector2.new(820, 480), UI.Theme.inkSoft)
	local grid = UI.new("ScrollingFrame", {
		Name = "Grid",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		BorderSizePixel = 0,
		Parent = content,
	}, {
		UI.grid(Vector2.new(170, 54), 12),
		UI.padding(4, 6),
	}) :: ScrollingFrame
	for order, entry in COMMANDS do
		local confirm = UI.confirm()
		local button: UI.Button
		button = UI.button({
			text = entry[2],
			size = UDim2.fromOffset(170, 54),
			color = if entry[1] == "reset" then UI.Theme.red else UI.Theme.blue,
			order = order,
			maxTextSize = 22,
			parent = grid,
			onClick = function()
				-- wiping the save needs a second tap
				if entry[1] == "reset" and not UI.confirmTap(confirm) then
					UI.setButton(button, { text = "Sure? Tap again" })
					task.delay(UI.CONFIRM_WINDOW, function()
						UI.setButton(button, { text = entry[2] })
					end)
					return
				end
				Net.send("Cheat", entry[1])
			end,
		})
	end
	for order, pass in StoreData.PASSES do
		UI.button({
			text = "Pass: " .. pass.name,
			size = UDim2.fromOffset(170, 54),
			color = UI.Theme.purple,
			order = 100 + order,
			maxTextSize = 18,
			parent = grid,
			onClick = function()
				Net.send("Cheat", "pass", pass.key)
			end,
		})
	end

	local screen = UI.screen("DevToggle", 4)
	toggle = UI.button({
		name = "DevToggle",
		text = "🛠",
		size = UDim2.fromOffset(52, 52),
		position = UDim2.fromOffset(16, 12),
		color = UI.Theme.inkSoft,
		radius = 16,
		parent = screen,
		onClick = function()
			Panels.toggle("Dev")
		end,
	})
	toggle.root.Visible = false
	ClientState.changed:connect(function(snapshot: Types.Snapshot)
		toggle.root.Visible = snapshot.isDev
	end)
end

return DevPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="88">
            <Properties>
              <string name="Name">DexUI</string>
              <string name="Source"><![CDATA[--!strict
-- Dino-Dex: every species, silhouetted until discovered, with the mutations
-- you've found for each. Completion is a big reason to keep hatching.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DexRewards = require(ReplicatedStorage.Shared.Data.DexRewards)
local DinoData = require(ReplicatedStorage.Shared.Data.DinoData)
local DinoModel = require(ReplicatedStorage.Shared.Visual.DinoModel)
local MutationData = require(ReplicatedStorage.Shared.Data.MutationData)
local Types = require(ReplicatedStorage.Shared.Types)
local Net = require(ReplicatedStorage.Shared.Net)
local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)
local Panels = require(script.Parent.Parent.Lib.Panels)
local UI = require(script.Parent.Parent.Lib.UI)

local DexUI = {}

type Card = {
	species: DinoData.Species,
	frame: Frame,
	stage: Frame,
	viewport: ViewportFrame?, -- built the first time the Dex opens
	name: TextLabel,
	badges: { [string]: Frame },
	discovered: boolean?,
}

local cards: { Card } = {}
local progress: UI.Bar
local prizes: { { count: number, emoji: string, button: UI.Button } } = {}

local function setSilhouette(viewport: ViewportFrame, silhouette: boolean)
	viewport.ImageColor3 = if silhouette then Color3.fromRGB(40, 32, 60) else Color3.new(1, 1, 1)
	viewport.ImageTransparency = if silhouette then 0.25 else 0
end

local function refresh(snapshot: Types.Snapshot)
	local found = 0
	for _, card in cards do
		local entry = snapshot.dex[card.species.id]
		local discovered = entry ~= nil
		if discovered then
			found += 1
		end
		if card.discovered ~= discovered then
			card.discovered = discovered
			local viewport = card.viewport
			if viewport then
				setSilhouette(viewport, not discovered)
			end
			card.name.Text = if discovered then card.species.name else "???"
		end
		for mutation, badge in card.badges do
			local has = entry ~= nil and entry[mutation] == true
			badge.BackgroundTransparency = if has then 0 else 0.7
			local icon = badge:FindFirstChildOfClass("TextLabel")
			if icon then
				icon.TextTransparency = if has then 0 else 0.65
			end
		end
	end
	UI.setBar(progress, found / #cards, `{found} / {#cards} dinos found`)
	for _, prize in prizes do
		if snapshot.dexClaimed[tostring(prize.count)] == true then
			UI.setButton(prize.button, { text = "✓", enabled = false })
		elseif found >= prize.count then
			UI.setButton(
				prize.button,
				{ text = `Claim {prize.emoji}`, enabled = true, color = UI.Theme.green }
			)
		else
			UI.setButton(
				prize.button,
				{ text = `{prize.count} {prize.emoji}`, enabled = true, color = UI.Theme.inkSoft }
			)
		end
	end
end

-- Any Dex prize ready to claim? (drives the menu badge)
function DexUI.claimable(snapshot: Types.Snapshot): boolean
	local found = DexRewards.discovered(snapshot.dex)
	for _, milestone in DexRewards.MILESTONES do
		if found >= milestone.count and not snapshot.dexClaimed[tostring(milestone.count)] then
			return true
		end
	end
	return false
end

local function buildCard(grid: Instance, index: number, species: DinoData.Species): Card
	local rarityColor = UI.rgb(DinoData.rarityInfo(species.rarity).color)
	local frame = UI.card({
		name = species.id,
		size = UDim2.fromScale(1, 1),
		order = index,
		radius = 16,
		edge = rarityColor,
		parent = grid,
	})
	local stage = UI.new("Frame", {
		Name = "Stage",
		Size = UDim2.new(1, -12, 0, 104),
		Position = UDim2.fromOffset(6, 6),
		BackgroundColor3 = UI.lighten(rarityColor, 0.72),
		Parent = frame,
	}, { UI.corner(12), UI.shade(0.9) }) :: Frame
	local name = UI.body({
		text = "???",
		size = UDim2.new(1, -10, 0, 24),
		position = UDim2.fromOffset(5, 114),
		font = UI.Font,
		maxTextSize = 20,
		parent = frame,
	})
	UI.body({
		text = species.rarity,
		size = UDim2.new(1, -10, 0, 18),
		position = UDim2.fromOffset(5, 138),
		color = UI.darken(rarityColor, 0.15),
		font = UI.HeavyFont,
		maxTextSize = 15,
		parent = frame,
	})
	local badgeRow = UI.new("Frame", {
		Name = "Mutations",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -10, 0, 24),
		Position = UDim2.fromOffset(5, 160),
		Parent = frame,
	}, {
		UI.list(
			Enum.FillDirection.Horizontal,
			2,
			Enum.HorizontalAlignment.Center,
			Enum.VerticalAlignment.Center
		),
	}) :: Frame
	local badges: { [string]: Frame } = {}
	for order, mutationId in MutationData.ORDER do
		local info = MutationData.get(mutationId)
		if info then
			local badge = UI.new("Frame", {
				Name = mutationId,
				Size = UDim2.fromOffset(21, 21),
				BackgroundColor3 = UI.lighten(UI.rgb(info.color), 0.4),
				LayoutOrder = order,
				Parent = badgeRow,
			}, { UI.round() }) :: Frame
			UI.text({
				text = info.emoji,
				size = UDim2.fromScale(0.8, 0.8),
				position = UDim2.fromScale(0.5, 0.5),
				anchor = Vector2.new(0.5, 0.5),
				maxTextSize = 16,
				noOutline = true,
				parent = badge,
			})
			badges[mutationId] = badge
		end
	end
	do
		local badge = UI.new("Frame", {
			Name = "Golden",
			Size = UDim2.fromOffset(21, 21),
			BackgroundColor3 = UI.lighten(UI.Theme.gold, 0.3),
			LayoutOrder = #MutationData.ORDER + 1,
			Parent = badgeRow,
		}, { UI.round() }) :: Frame
		UI.text({
			text = "⭐",
			size = UDim2.fromScale(0.8, 0.8),
			position = UDim2.fromScale(0.5, 0.5),
			anchor = Vector2.new(0.5, 0.5),
			maxTextSize = 16,
			noOutline = true,
			parent = badge,
		})
		badges.Golden = badge
	end
	return {
		species = species,
		frame = frame,
		stage = stage,
		viewport = nil,
		name = name,
		badges = badges,
		discovered = nil,
	}
end

function DexUI.init()
	local _, content = Panels.window("Dex", "📖 Dino-Dex", Vector2.new(880, 500), UI.Theme.pink)
	local header = UI.new("Frame", {
		Name = "Header",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 40),
		Parent = content,
	}) :: Frame
	progress = UI.bar({
		size = UDim2.new(0.42, 0, 0, 30),
		position = UDim2.fromOffset(0, 4),
		color = UI.Theme.pink,
		parent = header,
	})
	local prizeRow = UI.new("Frame", {
		Name = "Prizes",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0.56, 0, 0, 40),
		Parent = header,
	}, {
		UI.list(
			Enum.FillDirection.Horizontal,
			8,
			Enum.HorizontalAlignment.Right,
			Enum.VerticalAlignment.Center
		),
	}) :: Frame
	for i, milestone in DexRewards.MILESTONES do
		local count = milestone.count
		local button = UI.button({
			name = "Prize" .. count,
			text = `{count} {milestone.reward.emoji}`,
			size = UDim2.fromOffset(104, 36),
			color = UI.Theme.inkSoft,
			order = i,
			depth = 4,
			radius = 12,
			maxTextSize = 20,
			parent = prizeRow,
			onClick = function()
				Net.send("ClaimDex", count)
			end,
		})
		table.insert(prizes, { count = count, emoji = milestone.reward.emoji, button = button })
	end
	local grid = UI.new("ScrollingFrame", {
		Name = "Grid",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 50),
		Size = UDim2.new(1, 0, 1, -50),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		BorderSizePixel = 0,
		Parent = content,
	}, {
		UI.grid(Vector2.new(152, 192), 12),
		UI.padding(4, 6),
	}) :: ScrollingFrame

	for index, species in DinoData.LIST do
		table.insert(cards, buildCard(grid, index, species))
	end

	ClientState.changed:connect(function(snapshot: Types.Snapshot)
		if Panels.isOpen("Dex") then
			refresh(snapshot)
		end
	end)
	table.insert(Hud.badgeRefreshers, function(snapshot: Types.Snapshot)
		local item = Hud.menu.Dex
		if item then
			item.badge.Visible = DexUI.claimable(snapshot)
		end
	end)
	Panels.onOpen("Dex", function()
		-- 3D previews are built on first open, not at startup (cheaper on phones)
		for _, card in cards do
			if not card.viewport then
				local viewport = UI.viewport(
					DinoModel.build(card.species.id, 3, nil, "Static"),
					UDim2.fromScale(1, 1),
					card.stage,
					30
				)
				setSilhouette(viewport, card.discovered ~= true)
				card.viewport = viewport
			end
		end
		local snapshot = ClientState.get()
		if snapshot then
			refresh(snapshot)
		end
	end)
end

return DexUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="89">
            <Properties>
              <string name="Name">DinoPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Info card for one of your dinos (opened from its "View" prompt): its name
-- (tap ✏️ to rename), growth progress, income, mutation, Make Golden (fuse 3
-- of a species), Feed (fruit from the fruit trees), and Sell / Ride / Buddy.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Config = require(ReplicatedStorage.Shared.Config)
local DinoData = require(ReplicatedStorage.Shared.Data.DinoData)
local DinoModel = require(ReplicatedStorage.Shared.Visual.DinoModel)
local Economy = require(ReplicatedStorage.Shared.Util.Economy)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local FruitData = require(ReplicatedStorage.Shared.Data.FruitData)
local Growth = require(ReplicatedStorage.Shared.Util.Growth)
local MutationData = require(ReplicatedStorage.Shared.Data.MutationData)
local Net = require(ReplicatedStorage.Shared.Net)
local Types = require(ReplicatedStorage.Shared.Types)
local ClientState = require(script.Parent.ClientState)
local Toasts = require(script.Parent.Toasts)
local Panels = require(script.Parent.Parent.Lib.Panels)
local UI = require(script.Parent.Parent.Lib.UI)

local DinoPanel = {}

local currentId: string? = nil
local shownKey = ""
local showcase: Frame
local previewHolder: Frame
local nameLabel: TextLabel
local nameBox: TextBox
local renameButton: UI.Button
local rarityChip: UI.Chip
local stageChip: UI.Chip
local mutationChip: UI.Chip
local goldenChip: UI.Chip
local growthLabel: TextLabel
local growthBar: UI.Bar
local incomeLabel: TextLabel
local extraLabel: TextLabel
local sellButton: UI.Button
local rideButton: UI.Button
local buddyButton: UI.Button
local goldenButton: UI.Button
local feedButton: UI.Button
local sellConfirm = UI.confirm()
local goldenConfirm = UI.confirm()

local function findDino(snapshot: Types.Snapshot, id: string): Types.DinoRecord?
	for _, dino in snapshot.dinos do
		if dino.id == id then
			return dino
		end
	end
	return nil
end

-- Non-golden dinos of this species you own (the ones a fuse can use).
local function fuseCount(snapshot: Types.Snapshot, speciesId: string): number
	local count = 0
	for _, dino in snapshot.dinos do
		if dino.species == speciesId and not dino.golden then
			count += 1
		end
	end
	return count
end

local function refresh()
	local snapshot = ClientState.get()
	local id = currentId
	if not snapshot or not id then
		return
	end
	local dino = findDino(snapshot, id)
	local species = dino and DinoData.get(dino.species)
	if not dino or not species then
		Panels.close()
		return
	end
	local now = Clock.now()
	local stage, fraction, secondsLeft = Growth.progress(now - dino.bornAt, species.growth)
	local mutation = MutationData.get(dino.mutation)
	local rarityColor = UI.rgb(DinoData.rarityInfo(species.rarity).color)

	local golden = dino.golden == true
	local key = `{dino.id}:{stage}:{dino.mutation or ""}:{golden}`
	if key ~= shownKey then
		shownKey = key
		for _, child in previewHolder:GetChildren() do
			child:Destroy()
		end
		UI.viewport(
			DinoModel.build(dino.species, stage, dino.mutation, "Static", golden),
			UDim2.fromScale(1, 1),
			previewHolder,
			30
		)
		showcase.BackgroundColor3 = UI.lighten(
			if golden then UI.Theme.gold elseif mutation then UI.rgb(mutation.color) else rarityColor,
			0.65
		)
	end

	Panels.setTitle("Dino", `🦖 {species.name}`)
	nameLabel.Text = dino.name or species.name
	rarityChip.label.Text = species.rarity
	UI.setChipColor(rarityChip, rarityColor)
	stageChip.label.Text = Growth.stageName(stage)
	mutationChip.root.Visible = mutation ~= nil
	if mutation then
		mutationChip.label.Text = `{mutation.emoji} {mutation.name} x{mutation.multiplier}`
		UI.setChipColor(mutationChip, UI.rgb(mutation.color))
	end
	goldenChip.root.Visible = golden
	if stage >= Growth.GIANT then
		growthLabel.Text = "Fully grown GIANT! 🏆"
		UI.setBar(growthBar, 1, "MAX")
	else
		growthLabel.Text =
			`Grows into a {Growth.stageName(stage + 1)} in {Format.time(secondsLeft)}`
		UI.setBar(growthBar, fraction, `{math.floor(fraction * 100)}%`)
	end
	local multiplier = MutationData.multiplier(dino.mutation) * Economy.goldenMultiplier(golden)
	local income = Growth.income(species.income, stage, multiplier) * snapshot.multiplier
	incomeLabel.Text = `+{Format.number(income)} / sec`
	local lays = Growth.layInterval(stage, Config.LAY_INTERVAL_ADULT, Config.LAY_INTERVAL_GIANT)
	extraLabel.Text = if lays
		then `🥚 Lays an egg every {Format.duration(lays)}\n🛡 Guards your nest at night`
		else "🍼 Too young to lay eggs or guard the nest yet"

	local value = Economy.dinoValue(species.income, stage, multiplier)
	if UI.isArmed(sellConfirm) then
		UI.setButton(sellButton, { text = "Sure? Tap again!", color = UI.Theme.red })
	else
		UI.setButton(
			sellButton,
			{ text = "Sell 💰" .. Format.number(value), color = UI.Theme.orange }
		)
	end

	if snapshot.riding == dino.id then
		UI.setButton(rideButton, { text = "⬇ Get off", color = UI.Theme.grey, enabled = true })
	elseif not snapshot.passes.RideDinos then
		UI.setButton(
			rideButton,
			{ text = "🦖 Ride (pass)", color = UI.Theme.blue, enabled = true }
		)
	elseif stage < Growth.JUVENILE then
		UI.setButton(rideButton, { text = "Too small", color = UI.Theme.blue, enabled = false })
	else
		UI.setButton(rideButton, { text = "🦖 Ride!", color = UI.Theme.blue, enabled = true })
	end

	if golden then
		UI.setButton(
			goldenButton,
			{ text = "⭐ Golden ✓", color = UI.Theme.gold, enabled = false }
		)
	else
		local count = fuseCount(snapshot, dino.species)
		if count < 3 then
			UI.setButton(
				goldenButton,
				{ text = `⭐ Golden ({count}/3)`, color = UI.Theme.orange, enabled = true }
			)
		elseif UI.isArmed(goldenConfirm) then
			UI.setButton(
				goldenButton,
				{ text = "Fuse 3? Tap again!", color = UI.Theme.red, enabled = true }
			)
		else
			UI.setButton(goldenButton, {
				text = `⭐ Make Golden 💰{Format.number(Economy.goldenFee(species.income))}`,
				color = UI.Theme.gold,
				enabled = true,
			})
		end
	end

	local fruitKind = FruitData.nextToFeed(snapshot.fruit)
	if stage >= Growth.GIANT then
		UI.setButton(
			feedButton,
			{ text = "🏆 Fully grown", color = UI.Theme.red, enabled = false }
		)
	elseif fruitKind then
		local info = FruitData.FRUITS[fruitKind]
		UI.setButton(feedButton, {
			text = `{info.emoji} Feed ({snapshot.fruit[fruitKind]})`,
			color = UI.Theme.red,
			enabled = true,
		})
	else
		UI.setButton(feedButton, { text = "🍎 No fruit", color = UI.Theme.red, enabled = true })
	end

	local isBuddy = snapshot.buddy == dino.id
	UI.setButton(
		buddyButton,
		{ text = if isBuddy then "💗 Buddy ✓" else "💗 Buddy", enabled = true }
	)
end

local function stopRenaming()
	nameBox.Visible = false
	nameLabel.Visible = true
	renameButton.root.Visible = true
end

local function startRenaming()
	local snapshot = ClientState.get()
	local dino = if snapshot and currentId then findDino(snapshot, currentId) else nil
	if not dino then
		return
	end
	nameBox.Text = dino.name or ""
	nameLabel.Visible = false
	renameButton.root.Visible = false
	nameBox.Visible = true
	nameBox:CaptureFocus()
end

function DinoPanel.open(dinoId: string)
	stopRenaming()
	currentId = dinoId
	shownKey = ""
	UI.disarm(sellConfirm)
	UI.disarm(goldenConfirm)
	refresh()
	Panels.open("Dino")
end

function DinoPanel.init()
	local _, content =
		Panels.window("Dino", "🦖 Your Dino", Vector2.new(820, 540), UI.Theme.green)
	showcase = UI.new("Frame", {
		Name = "Showcase",
		Size = UDim2.new(0, 300, 1, 0),
		BackgroundColor3 = UI.Theme.panelDark,
		Parent = content,
	}, { UI.corner(22), UI.stroke(UI.Theme.cardEdge, 3), UI.shade(0.86) }) :: Frame
	previewHolder = UI.new("Frame", {
		Name = "Preview",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -16, 1, -16),
		Position = UDim2.fromOffset(8, 8),
		Parent = showcase,
	}) :: Frame

	local right = UI.new("Frame", {
		Name = "Info",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(320, 0),
		Size = UDim2.new(1, -320, 1, 0),
		Parent = content,
	}) :: Frame
	nameLabel = UI.body({
		text = "",
		size = UDim2.new(1, -60, 0, 44),
		font = UI.Font,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 38,
		parent = right,
	})
	nameBox = UI.new("TextBox", {
		Name = "NameBox",
		Text = "",
		PlaceholderText = "Give your dino a name!",
		ClearTextOnFocus = false,
		Visible = false,
		Size = UDim2.new(1, -6, 0, 46),
		BackgroundColor3 = UI.Theme.white,
		TextColor3 = UI.Theme.ink,
		PlaceholderColor3 = UI.Theme.grey,
		Font = UI.Font,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 3,
		Parent = right,
	}, {
		UI.corner(14),
		UI.stroke(UI.Theme.ink, 3),
		UI.padding(14, 8),
		UI.new("UITextSizeConstraint", { MaxTextSize = 28 }),
	}) :: TextBox
	nameBox.FocusLost:Connect(function()
		local id = currentId
		local snapshot = ClientState.get()
		local dino = if snapshot and id then findDino(snapshot, id) else nil
		stopRenaming()
		if id and dino and nameBox.Text ~= (dino.name or "") then
			Net.send("RenameDino", id, nameBox.Text)
		end
	end)
	renameButton = UI.button({
		name = "Rename",
		text = "✏️",
		size = UDim2.fromOffset(50, 44),
		position = UDim2.new(1, -6, 0, 0),
		anchor = Vector2.new(1, 0),
		color = UI.Theme.purple,
		radius = 12,
		depth = 4,
		maxTextSize = 24,
		parent = right,
		onClick = startRenaming,
	})
	local tags = UI.new("Frame", {
		Name = "Tags",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 32),
		Position = UDim2.fromOffset(0, 50),
		Parent = right,
	}, { UI.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left) }) :: Frame
	rarityChip = UI.chip({
		text = "",
		size = UDim2.fromOffset(110, 32),
		order = 1,
		maxTextSize = 18,
		parent = tags,
	})
	stageChip = UI.chip({
		text = "",
		size = UDim2.fromOffset(100, 32),
		color = UI.Theme.teal,
		order = 2,
		maxTextSize = 18,
		parent = tags,
	})
	mutationChip = UI.chip({
		text = "",
		size = UDim2.fromOffset(150, 32),
		order = 3,
		maxTextSize = 18,
		parent = tags,
	})
	goldenChip = UI.chip({
		text = `⭐ x{Economy.goldenMultiplier(true)}`,
		size = UDim2.fromOffset(78, 32),
		color = UI.Theme.gold,
		order = 4,
		maxTextSize = 18,
		parent = tags,
	})

	growthLabel = UI.body({
		text = "",
		size = UDim2.new(1, 0, 0, 24),
		position = UDim2.fromOffset(0, 96),
		align = Enum.TextXAlignment.Left,
		maxTextSize = 19,
		parent = right,
	})
	growthBar = UI.bar({
		size = UDim2.new(1, -6, 0, 28),
		position = UDim2.fromOffset(0, 124),
		color = UI.Theme.green,
		parent = right,
	})

	local stats = UI.card({
		name = "Stats",
		size = UDim2.new(1, -6, 0, 118),
		position = UDim2.fromOffset(0, 166),
		radius = 16,
		parent = right,
	})
	local coin = UI.coin(44, stats)
	coin.Position = UDim2.fromOffset(14, 12)
	incomeLabel = UI.body({
		text = "",
		size = UDim2.new(1, -80, 0, 40),
		position = UDim2.fromOffset(68, 14),
		color = UI.Theme.money,
		font = UI.Font,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 32,
		parent = stats,
	})
	extraLabel = UI.body({
		text = "",
		size = UDim2.new(1, -28, 0, 50),
		position = UDim2.fromOffset(14, 62),
		color = UI.Theme.inkSoft,
		align = Enum.TextXAlignment.Left,
		valign = Enum.TextYAlignment.Top,
		maxTextSize = 17,
		parent = stats,
	})

	-- Care row: Make Golden (and Feed)
	local care = UI.new("Frame", {
		Name = "Care",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -6, 0, 60),
		Position = UDim2.new(0, 0, 1, -134),
		Parent = right,
	}, { UI.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left) }) :: Frame
	goldenButton = UI.button({
		name = "Golden",
		text = "⭐ Golden",
		size = UDim2.new(0.55, -5, 0, 58),
		color = UI.Theme.gold,
		order = 1,
		maxTextSize = 22,
		parent = care,
		onClick = function()
			local id = currentId
			local snapshot = ClientState.get()
			local dino = if snapshot and id then findDino(snapshot, id) else nil
			local species = if dino then DinoData.get(dino.species) else nil
			if not snapshot or not dino or not species or dino.golden then
				return
			end
			if fuseCount(snapshot, dino.species) < 3 then
				Toasts.show(
					`Collect 3 {species.name}s, then fuse them into one ⭐ Golden dino that earns {Economy.goldenMultiplier(
						true
					)}x!`,
					"info"
				)
			elseif UI.confirmTap(goldenConfirm) then
				Net.send("FuseGolden", dino.id)
			else
				refresh()
			end
		end,
	})

	feedButton = UI.button({
		name = "Feed",
		text = "🍎 Feed",
		size = UDim2.new(0.45, -5, 0, 58),
		color = UI.Theme.red,
		order = 2,
		maxTextSize = 22,
		parent = care,
		onClick = function()
			local id = currentId
			local snapshot = ClientState.get()
			if not id or not snapshot then
				return
			end
			if FruitData.nextToFeed(snapshot.fruit) then
				Net.send("FeedDino", id)
			else
				Toasts.show(
					"Pick up fruit under the 🍎 fruit trees, then feed it here to grow your dino faster!",
					"info"
				)
			end
		end,
	})

	local buttons = UI.new("Frame", {
		Name = "Buttons",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -6, 0, 60),
		Position = UDim2.new(0, 0, 1, -66),
		Parent = right,
	}, { UI.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left) }) :: Frame
	sellButton = UI.button({
		name = "Sell",
		text = "Sell",
		size = UDim2.new(0.36, -7, 0, 58),
		color = UI.Theme.orange,
		order = 1,
		maxTextSize = 22,
		parent = buttons,
		onClick = function()
			local id = currentId
			if not id then
				return
			end
			if UI.confirmTap(sellConfirm) then
				Net.send("SellDino", id)
			else
				refresh()
			end
		end,
	})
	rideButton = UI.button({
		name = "Ride",
		text = "Ride",
		size = UDim2.new(0.34, -7, 0, 58),
		color = UI.Theme.blue,
		order = 2,
		maxTextSize = 22,
		parent = buttons,
		onClick = function()
			local id = currentId
			local snapshot = ClientState.get()
			if not id or not snapshot then
				return
			end
			if snapshot.riding == id then
				Net.send("Ride", nil)
			elseif not snapshot.passes.RideDinos then
				Net.send("PromptPurchase", "pass", "RideDinos")
			else
				Net.send("Ride", id)
				Panels.close()
			end
		end,
	})
	buddyButton = UI.button({
		name = "Buddy",
		text = "💗 Buddy",
		size = UDim2.new(0.3, -6, 0, 58),
		color = UI.Theme.pink,
		order = 3,
		maxTextSize = 22,
		parent = buttons,
		onClick = function()
			local id = currentId
			local snapshot = ClientState.get()
			if not id or not snapshot then
				return
			end
			Net.send("SetBuddy", if snapshot.buddy == id then nil else id)
		end,
	})

	ClientState.changed:connect(function(_: Types.Snapshot)
		if Panels.isOpen("Dino") then
			refresh()
		end
	end)
end

function DinoPanel.start()
	while true do
		task.wait(0.5)
		if Panels.isOpen("Dino") then
			refresh()
		end
	end
end

return DinoPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="90">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--!strict
-- One-shot moments: the hatch reveal (egg wobble and cracks, flash, spinning
-- rays, big reveal), coins flying into the counter, roars with screen shake,
-- mutation sparkles and confetti.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local DinoData = require(ReplicatedStorage.Shared.Data.DinoData)
local DinoModel = require(ReplicatedStorage.Shared.Visual.DinoModel)
local Economy = require(ReplicatedStorage.Shared.Util.Economy)
local FruitData = require(ReplicatedStorage.Shared.Data.FruitData)
local EggModel = require(ReplicatedStorage.Shared.Visual.EggModel)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local MutationData = require(ReplicatedStorage.Shared.Data.MutationData)
local Net = require(ReplicatedStorage.Shared.Net)
local Hud = require(script.Parent.Hud)
local Toasts = require(script.Parent.Toasts)
local UI = require(script.Parent.Parent.Lib.UI)

local Effects = {}

-- Sound hooks (set by the audio controller).
Effects.onReveal = function(_rarity: string) end
Effects.onCrack = function() end
Effects.onCoins = function() end

type Reveal = { species: string, mutation: string?, new: boolean, golden: boolean? }

local screen: ScreenGui
local revealQueue: { Reveal } = {}
local revealing = false

-- ===== Confetti =====

local CONFETTI_COLORS = {
	Color3.fromRGB(255, 90, 95),
	Color3.fromRGB(255, 201, 60),
	Color3.fromRGB(85, 209, 110),
	Color3.fromRGB(74, 168, 255),
	Color3.fromRGB(155, 107, 255),
	Color3.fromRGB(255, 120, 190),
}

local function confetti(amount: number)
	local rng = Random.new()
	for _ = 1, amount do
		local piece = UI.new("Frame", {
			Name = "Confetti",
			Size = UDim2.fromOffset(rng:NextInteger(8, 16), rng:NextInteger(10, 22)),
			Position = UDim2.new(rng:NextNumber(0, 1), 0, -0.05, 0),
			BackgroundColor3 = CONFETTI_COLORS[rng:NextInteger(1, #CONFETTI_COLORS)],
			Rotation = rng:NextInteger(0, 360),
			ZIndex = 20,
			Parent = screen,
		}, { UI.corner(3) }) :: Frame
		local duration = rng:NextNumber(1.6, 2.8)
		TweenService
			:Create(
				piece,
				TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{
					Position = UDim2.new(
						piece.Position.X.Scale + rng:NextNumber(-0.15, 0.15),
						0,
						1.1,
						0
					),
					Rotation = piece.Rotation + rng:NextInteger(-360, 360),
				}
			)
			:Play()
		task.delay(duration, function()
			piece:Destroy()
		end)
	end
end

-- ===== Camera shake =====

local function shake(intensity: number, duration: number)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local elapsed = 0
	local connection: RBXScriptConnection
	connection = RunService.RenderStepped:Connect(function(dt)
		elapsed += dt
		if elapsed >= duration then
			connection:Disconnect()
			return
		end
		local falloff = 1 - elapsed / duration
		local offset = Vector3.new(math.random() - 0.5, math.random() - 0.5, 0)
			* intensity
			* falloff
		camera.CFrame = camera.CFrame * CFrame.new(offset)
	end)
end

-- ===== Hatch reveal =====

local RAYS = 8

-- Soft light beams behind the reveal: long bars through the centre whose
-- sides fade out, spun slowly, over a layered glow.
local function rays(parent: Instance, color: Color3): { Frame }
	for i, size in { 420, 300, 190 } do
		UI.new("Frame", {
			Name = "Glow",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.44),
			Size = UDim2.fromOffset(size, size),
			BackgroundColor3 = UI.lighten(color, 0.2 + i * 0.15),
			BackgroundTransparency = 0.82 - i * 0.08,
			ZIndex = 11,
			Parent = parent,
		}, { UI.round() })
	end
	local list = {}
	for i = 0, RAYS - 1 do
		local ray = UI.new("Frame", {
			Name = "Ray",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.44),
			Size = UDim2.fromOffset(110, 1800),
			BackgroundColor3 = UI.lighten(color, 0.25),
			BackgroundTransparency = if i % 2 == 0 then 0.45 else 0.62,
			Rotation = i * (180 / RAYS),
			ZIndex = 11,
			Parent = parent,
		}, {
			UI.new("UIGradient", {
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.5, 0),
					NumberSequenceKeypoint.new(1, 1),
				}),
			}),
		}) :: Frame
		table.insert(list, ray)
	end
	return list
end

-- Zig-zag crack drawn over the egg, revealed one segment at a time.
local CRACK = {
	{ 0.24, 0.5, 0.36, 0.43 },
	{ 0.36, 0.43, 0.46, 0.53 },
	{ 0.46, 0.53, 0.57, 0.44 },
	{ 0.57, 0.44, 0.67, 0.53 },
	{ 0.67, 0.53, 0.77, 0.46 },
}

local function crackSegment(parent: Instance, segment: { number }): Frame
	local x0, y0, x1, y1 = segment[1], segment[2], segment[3], segment[4]
	local size = 260
	local dx, dy = (x1 - x0) * size, (y1 - y0) * size
	return UI.new("Frame", {
		Name = "Crack",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale((x0 + x1) / 2, (y0 + y1) / 2),
		Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + 4, 6),
		Rotation = math.deg(math.atan2(dy, dx)),
		BackgroundColor3 = UI.Theme.ink,
		ZIndex = 14,
		Parent = parent,
	}, { UI.round() }) :: Frame
end

local function reveal(item: Reveal)
	local data = DinoData.get(item.species)
	if not data then
		return
	end
	local rarity = DinoData.rarityInfo(data.rarity)
	local rarityColor = UI.rgb(rarity.color)
	local m = MutationData.get(item.mutation)

	local overlay = UI.new("Frame", {
		Name = "Overlay",
		Size = UDim2.fromScale(4, 4),
		Position = UDim2.fromScale(-1.5, -1.5),
		BackgroundColor3 = Color3.fromRGB(20, 14, 34),
		BackgroundTransparency = 1,
		ZIndex = 10,
		Parent = screen,
	}) :: Frame
	TweenService:Create(overlay, TweenInfo.new(0.25), { BackgroundTransparency = 0.3 }):Play()
	-- The reveal (460 px stage, chips and "Tap to continue" below it, 554 px
	-- in all) shrinks to fit short landscape phones and stays centred.
	local canvasHeight = UI.canvasSize().Y
	local fit = math.min(1, (canvasHeight - 24) / 554)
	local stage = UI.new("Frame", {
		Name = "Reveal",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, canvasHeight / 2 - 47 * fit),
		Size = UDim2.fromOffset(460, 460),
		BackgroundTransparency = 1,
		ZIndex = 11,
		Parent = screen,
	}, { UI.new("UIScale", { Scale = fit }) }) :: Frame

	-- 1. The egg drops in and wobbles harder and harder, then cracks
	local eggHolder = UI.new("Frame", {
		Name = "Egg",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(260, 260),
		BackgroundTransparency = 1,
		ZIndex = 12,
		Parent = stage,
	}) :: Frame
	local eggViewport = UI.viewport(
		EggModel.build(EggModel.giftLook(), 3, true),
		UDim2.fromScale(1, 1),
		eggHolder,
		0
	)
	eggViewport.ZIndex = 12
	UI.pop(eggHolder, 0.4)
	local cracks = 0
	for i = 1, 14 do
		eggHolder.Rotation = (if i % 2 == 0 then 1 else -1) * (3 + i * 1.3)
		if i % 3 == 0 and cracks < #CRACK then
			cracks += 1
			crackSegment(eggHolder, CRACK[cracks])
			Effects.onCrack()
		end
		task.wait(0.075)
	end
	for k = cracks + 1, #CRACK do
		crackSegment(eggHolder, CRACK[k])
	end
	task.wait(0.12)
	eggHolder:Destroy()

	-- 2. Flash + rays
	local flash = UI.new("Frame", {
		Name = "Flash",
		Size = UDim2.fromScale(4, 4),
		Position = UDim2.fromScale(-1.5, -1.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 18,
		Parent = screen,
	}) :: Frame
	TweenService:Create(flash, TweenInfo.new(0.45), { BackgroundTransparency = 1 }):Play()
	task.delay(0.45, function()
		flash:Destroy()
	end)
	local rayList = rays(stage, if m then UI.rgb(m.color) else rarityColor)

	-- 3. The dino pops out
	local dinoViewport = UI.viewport(
		DinoModel.build(item.species, 3, item.mutation, "Static", item.golden),
		UDim2.fromOffset(340, 340),
		stage,
		25
	)
	dinoViewport.AnchorPoint = Vector2.new(0.5, 0.5)
	dinoViewport.Position = UDim2.fromScale(0.5, 0.44)
	dinoViewport.ZIndex = 13
	UI.pop(dinoViewport, 0.3)
	Effects.onReveal(data.rarity)

	local ribbon = UI.new("Frame", {
		Name = "Ribbon",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, -64),
		Size = UDim2.fromOffset(500, 72),
		BackgroundColor3 = rarityColor,
		ZIndex = 14,
		Parent = stage,
	}, { UI.corner(20), UI.stroke(UI.darken(rarityColor, 0.5), 4), UI.shade(0.82) }) :: Frame
	UI.text({
		name = "Title",
		text = (if item.golden then "⭐ GOLDEN " else "") .. (if m
			then m.emoji .. " " .. m.name .. " "
			else "") .. data.name .. "!",
		size = UDim2.new(1, -30, 1, -14),
		position = UDim2.fromOffset(15, 7),
		maxTextSize = 46,
		outlineThickness = 3,
		zIndex = 15,
		parent = ribbon,
	})
	local tags = UI.new("Frame", {
		Name = "Tags",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 16),
		Size = UDim2.fromOffset(500, 36),
		ZIndex = 14,
		Parent = stage,
	}, { UI.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center) }) :: Frame
	local rarityChip = UI.chip({
		text = data.rarity:upper(),
		size = UDim2.fromOffset(170, 36),
		color = UI.darken(rarityColor, 0.1),
		order = 1,
		maxTextSize = 22,
		parent = tags,
	})
	rarityChip.root.ZIndex = 15
	if m then
		local chip = UI.chip({
			text = `x{m.multiplier} coins`,
			size = UDim2.fromOffset(150, 36),
			color = UI.rgb(m.color),
			order = 2,
			maxTextSize = 22,
			parent = tags,
		})
		chip.root.ZIndex = 15
	end
	if item.golden then
		local chip = UI.chip({
			text = `⭐ x{Economy.goldenMultiplier(true)} coins`,
			size = UDim2.fromOffset(160, 36),
			color = UI.Theme.gold,
			order = 3,
			maxTextSize = 22,
			parent = tags,
		})
		chip.root.ZIndex = 15
	end
	if item.new then
		local newBadge = UI.chip({
			name = "New",
			text = "NEW!",
			size = UDim2.fromOffset(110, 44),
			position = UDim2.new(1, -40, 0, 30),
			anchor = Vector2.new(1, 0),
			color = UI.Theme.red,
			maxTextSize = 30,
			parent = stage,
		})
		newBadge.root.ZIndex = 16
		newBadge.root.Rotation = 12
		UI.pop(newBadge.root, 0.2)
	end
	UI.pop(ribbon, 0.5)
	local hint = UI.text({
		name = "Hint",
		text = "Tap to continue",
		size = UDim2.fromOffset(300, 30),
		position = UDim2.new(0.5, 0, 1, 64),
		anchor = Vector2.new(0.5, 0),
		maxTextSize = 22,
		zIndex = 15,
		parent = stage,
	})
	hint.TextTransparency = 1
	local hintPulse = TweenService:Create(
		hint,
		TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, 0.8),
		{ TextTransparency = 0.2 }
	)
	hintPulse:Play()

	if rarity.order >= DinoData.rarityInfo("Rare").order or m then
		confetti(if rarity.order >= DinoData.rarityInfo("Legendary").order then 120 else 60)
	end
	if rarity.order >= DinoData.rarityInfo("Epic").order then
		shake(0.6, 0.6)
	end

	-- spin the rays and the dino while the reveal is on screen
	local started = os.clock()
	local spin = RunService.RenderStepped:Connect(function(dt: number)
		for i, ray in rayList do
			ray.Rotation = (i - 1) * (180 / RAYS) + (os.clock() - started) * 18
		end
		local model = dinoViewport:FindFirstChildOfClass("Model")
		if model then
			model:PivotTo(model:GetPivot() * CFrame.Angles(0, dt * 0.6, 0))
		end
	end)

	local done = false
	local closeButton = UI.new("TextButton", {
		Name = "Continue",
		Size = UDim2.fromScale(4, 4),
		Position = UDim2.fromScale(-1.5, -1.5),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 19,
		Parent = screen,
	}) :: TextButton
	closeButton.Activated:Connect(function()
		if os.clock() - started > 0.8 then
			done = true
		end
	end)
	while not done and os.clock() - started < 4 do
		task.wait(0.1)
	end
	spin:Disconnect()
	closeButton:Destroy()
	overlay:Destroy()
	hintPulse:Cancel()
	stage:Destroy()
end

local function processQueue()
	if revealing then
		return
	end
	revealing = true
	while #revealQueue > 0 do
		reveal(table.remove(revealQueue, 1) :: Reveal)
	end
	revealing = false
end

-- ===== World-space popups =====

local function worldText(position: Vector3, text: string, color: Color3, size: number)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.CFrame = CFrame.new(position)
	anchor.Parent = Workspace.CurrentCamera or Workspace
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(size * 6, size * 2)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 4, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Parent = anchor
	local label = UI.text({
		text = text,
		size = UDim2.fromScale(1, 1),
		color = color,
		maxTextSize = size,
		outlineThickness = 3,
		parent = gui,
	})
	TweenService:Create(gui, TweenInfo.new(1.4), { StudsOffsetWorldSpace = Vector3.new(0, 10, 0) })
		:Play()
	TweenService
		:Create(label, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			TextTransparency = 1,
		})
		:Play()
	task.delay(1.5, function()
		anchor:Destroy()
	end)
end

local function burst(position: Vector3, color: Color3)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
	anchor.Parent = Workspace.CurrentCamera or Workspace
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Speed = NumberRange.new(8, 16)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Lifetime = NumberRange.new(0.6, 1.2)
	emitter.Size = NumberSequence.new(0.8, 0)
	emitter.Rate = 0
	emitter.Parent = anchor
	emitter:Emit(40)
	task.delay(1.5, function()
		anchor:Destroy()
	end)
end

-- ===== Coins flying into the counter =====

local function designScale(): number
	local uiScale = screen:FindFirstChildOfClass("UIScale")
	return if uiScale then uiScale.Scale else 1
end

local function coinsFly(amount: number, from: Vector3?)
	local scale = designScale()
	local target = Hud.coinTarget() / scale
	local start = target + Vector2.new(0, 260)
	local camera = Workspace.CurrentCamera
	if from and camera then
		local point, onScreen = camera:WorldToViewportPoint(from)
		if onScreen then
			start = Vector2.new(point.X, point.Y - UI.topInset()) / scale
		end
	end
	local rng = Random.new()
	local count = math.clamp(math.floor(math.log10(math.max(amount, 1)) * 2) + 3, 4, 12)
	for i = 1, count do
		local coin = UI.coin(34, screen)
		coin.AnchorPoint = Vector2.new(0.5, 0.5)
		coin.ZIndex = 6
		local spread = Vector2.new(rng:NextNumber(-60, 60), rng:NextNumber(-40, 40))
		coin.Position = UDim2.fromOffset(start.X, start.Y)
		local delayTime = (i - 1) * 0.04
		task.delay(delayTime, function()
			local burstTween = TweenService:Create(
				coin,
				TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{
					Position = UDim2.fromOffset(start.X + spread.X, start.Y + spread.Y),
				}
			)
			burstTween:Play()
			burstTween.Completed:Wait()
			local fly = TweenService:Create(
				coin,
				TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{
					Position = UDim2.fromOffset(target.X, target.Y),
					Size = UDim2.fromOffset(22, 22),
				}
			)
			fly:Play()
			fly.Completed:Wait()
			coin:Destroy()
		end)
	end
	task.delay(0.75 + count * 0.04, function()
		Effects.onCoins()
		UI.pop(Hud.coinPill(), 1.12)
	end)
	local label = UI.text({
		text = "+" .. Format.number(amount),
		size = UDim2.fromOffset(240, 46),
		position = UDim2.fromOffset(target.X, target.Y + 64),
		anchor = Vector2.new(0.5, 0.5),
		color = UI.Theme.coin,
		maxTextSize = 38,
		outlineThickness = 3,
		zIndex = 7,
		parent = screen,
	})
	TweenService:Create(label, TweenInfo.new(1.2, Enum.EasingStyle.Quad), {
		Position = UDim2.fromOffset(target.X, target.Y + 40),
		TextTransparency = 1,
	}):Play()
	task.delay(1.3, function()
		label:Destroy()
	end)
end

local function onEffect(kind: string, data: { [string]: any })
	if kind == "Hatch" then
		if typeof(data.species) == "string" then
			table.insert(revealQueue, {
				species = data.species,
				mutation = if typeof(data.mutation) == "string" then data.mutation else nil,
				new = data.new == true,
			})
			task.spawn(processQueue)
		end
	elseif kind == "Golden" then
		if typeof(data.species) == "string" then
			table.insert(revealQueue, {
				species = data.species,
				mutation = if typeof(data.mutation) == "string" then data.mutation else nil,
				new = false,
				golden = true,
			})
			task.spawn(processQueue)
		end
	elseif kind == "Fruit" then
		local info = if typeof(data.kind) == "string" then FruitData.get(data.kind) else nil
		if info and typeof(data.position) == "Vector3" then
			worldText(data.position, `+1 {info.emoji} ({data.count or 1})`, UI.rgb(info.color), 28)
		end
	elseif kind == "Feed" then
		if typeof(data.position) == "Vector3" then
			burst(data.position, UI.Theme.pink)
			worldText(data.position, "Yum! 💕", UI.Theme.pink, 34)
		end
	elseif kind == "Roar" then
		if typeof(data.position) == "Vector3" then
			worldText(data.position, "ROAR!", UI.Theme.orange, if data.big then 48 else 34)
			local character = Players.LocalPlayer.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if
				root
				and root:IsA("BasePart")
				and (root.CFrame.Position - data.position).Magnitude < 45
			then
				shake(if data.big then 0.5 else 0.25, 0.4)
			end
		end
	elseif kind == "Collect" then
		if typeof(data.amount) == "number" then
			coinsFly(data.amount, if typeof(data.position) == "Vector3" then data.position else nil)
		end
	elseif kind == "Mutate" then
		if typeof(data.position) == "Vector3" then
			local m = MutationData.get(data.mutation)
			burst(data.position, if m then UI.rgb(m.color) else Color3.new(1, 1, 1))
		end
	elseif kind == "Dex" then
		local species = if typeof(data.species) == "string" then DinoData.get(data.species) else nil
		if species then
			Toasts.show(`📖 New Dex entry: {species.name}!`, "rare")
		end
	elseif kind == "Reward" then
		confetti(70)
	elseif kind == "Caught" then
		if data.victim == Players.LocalPlayer.UserId then
			confetti(40)
		end
	end
end

-- Plays a reveal directly (used by previews and tests).
function Effects.reveal(species: string, mutation: string?, new: boolean?)
	table.insert(revealQueue, { species = species, mutation = mutation, new = new == true })
	task.spawn(processQueue)
end

function Effects.init()
	screen = UI.screen("Effects", 30)
	Net.listen("Effect", onEffect)
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="91">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- The always-on HUD:
--   * top centre: coin counter with income, day/night + storm chips, boosts
--   * left: menu buttons (2 columns), kept above the mobile thumbstick
--   * bottom centre: action buttons, clear of the thumbstick and jump button

local AdService = game:GetService("AdService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")
local TweenService = game:GetService("TweenService")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Config = require(ReplicatedStorage.Shared.Config)
local Cycle = require(ReplicatedStorage.Shared.Util.Cycle)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local MutationData = require(ReplicatedStorage.Shared.Data.MutationData)
local Net = require(ReplicatedStorage.Shared.Net)
local Streak = require(ReplicatedStorage.Shared.Util.Streak)
local Types = require(ReplicatedStorage.Shared.Types)
local ClientState = require(script.Parent.ClientState)
local Panels = require(script.Parent.Parent.Lib.Panels)
local UI = require(script.Parent.Parent.Lib.UI)

local Hud = {}

local screen: ScreenGui
local coinsPill: Frame
local coinsLabel: TextLabel
local incomeLabel: TextLabel
local cycleChip: UI.Chip
local stormChip: UI.Chip
local boostRow: Frame
local lockButton: UI.Button
local adButton: UI.Button
local dismountButton: UI.Button
local coinValue: NumberValue

local adAvailable = false

-- Buttons other controllers poke (tutorial highlights, tests).
Hud.buttons = {} :: { [string]: UI.Button }
Hud.menu = {} :: { [string]: UI.MenuButton }
-- Other controllers can add badge logic for their menu buttons.
Hud.badgeRefreshers = {} :: { (Types.Snapshot) -> () }

-- ===== Coins =====

local function buildCoins()
	coinsPill = UI.new("Frame", {
		Name = "Coins",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(310, 58),
		BackgroundColor3 = UI.Theme.hud,
		BackgroundTransparency = 0.18,
		Parent = screen,
	}, { UI.round(), UI.stroke(UI.Theme.ink, 3) }) :: Frame
	local coin = UI.coin(52, coinsPill)
	coin.Position = UDim2.new(0, -6, 0.5, 0)
	coin.AnchorPoint = Vector2.new(0, 0.5)
	coinsLabel = UI.text({
		name = "Amount",
		text = "0",
		size = UDim2.new(1, -150, 0, 42),
		position = UDim2.new(0, 56, 0.5, 0),
		anchor = Vector2.new(0, 0.5),
		align = Enum.TextXAlignment.Left,
		maxTextSize = 36,
		outlineThickness = 3,
		parent = coinsPill,
	})
	local income = UI.new("Frame", {
		Name = "Income",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(92, 36),
		BackgroundColor3 = UI.Theme.green,
		Parent = coinsPill,
	}, { UI.round(), UI.stroke(UI.darken(UI.Theme.green, 0.45), 2.5), UI.shade(0.84) }) :: Frame
	incomeLabel = UI.text({
		text = "+0/s",
		size = UDim2.new(1, -12, 1, -8),
		position = UDim2.fromOffset(6, 4),
		maxTextSize = 22,
		outline = UI.darken(UI.Theme.green, 0.6),
		parent = income,
	})
end

-- ===== Timers and boosts =====

local boostChips: { [string]: UI.Chip } = {}

local function boostChip(
	id: string,
	text: string,
	color: Color3,
	order: number,
	seen: { [string]: boolean }
)
	seen[id] = true
	local existing = boostChips[id]
	if existing then
		existing.label.Text = text
		return
	end
	local chip = UI.chip({
		name = id,
		text = text,
		size = UDim2.fromOffset(150, 34),
		color = color,
		order = order,
		maxTextSize = 19,
		parent = boostRow,
	})
	boostChips[id] = chip
	UI.pop(chip.root)
end

local function refreshBoosts(snapshot: Types.Snapshot, now: number)
	local seen: { [string]: boolean } = {}
	if snapshot.boosts.luckUntil > now then
		boostChip(
			"Luck",
			"🍀 Luck " .. Format.time(snapshot.boosts.luckUntil - now),
			UI.Theme.green,
			1,
			seen
		)
	end
	if snapshot.boosts.coinsUntil > now then
		boostChip(
			"Coins",
			"⚡ 2x " .. Format.time(snapshot.boosts.coinsUntil - now),
			UI.Theme.orange,
			2,
			seen
		)
	end
	if snapshot.lockUntil > now then
		boostChip("Lock", "🔒 " .. Format.time(snapshot.lockUntil - now), UI.Theme.red, 3, seen)
	end
	if snapshot.shieldUntil > now then
		boostChip(
			"Shield",
			"🛡 " .. Format.duration(snapshot.shieldUntil - now),
			UI.Theme.blue,
			4,
			seen
		)
	end
	if snapshot.friendsHere > 0 then
		local bonus =
			math.min(snapshot.friendsHere * Config.FRIEND_BOOST_PER_FRIEND, Config.FRIEND_BOOST_MAX)
		boostChip("Friends", `👥 +{math.floor(bonus * 100 + 0.5)}%`, UI.Theme.purple, 5, seen)
	end
	if snapshot.multiplier > 1.01 then
		boostChip(
			"Multiplier",
			`💰 x{string.format("%.1f", snapshot.multiplier)}`,
			UI.Theme.teal,
			6,
			seen
		)
	end
	for id, chip in boostChips do
		if not seen[id] then
			chip.root:Destroy()
			boostChips[id] = nil
		end
	end
end

local function refreshTimers()
	local snapshot = ClientState.get()
	coinsLabel.Text = Format.number(math.floor(coinValue.Value))
	local cycleNow = Clock.cycleNow()
	local now = Clock.now()

	local dn = Cycle.dayNight(cycleNow)
	local raids = ReplicatedStorage:GetAttribute("RaidsEnabled") ~= false
	if dn.isNight then
		cycleChip.label.Text = `🌙 Night {Format.time(dn.secondsLeft)}`
			.. (if raids then " • Raids!" else "")
		UI.setChipColor(cycleChip, UI.Theme.night)
	else
		cycleChip.label.Text = `☀️ Day {Format.time(dn.secondsLeft)}`
		UI.setChipColor(cycleChip, UI.Theme.day)
	end

	local storm = Cycle.storm(cycleNow)
	if storm.active then
		stormChip.root.Visible = true
		if storm.mega then
			stormChip.label.Text =
				`{MutationData.MEGA_STORM_EMOJI} Mega Storm {Format.time(storm.secondsLeft)}`
			UI.setChipColor(stormChip, UI.Theme.purple)
		elseif storm.kind then
			local info = MutationData.stormInfo(storm.kind)
			stormChip.label.Text = `{info.emoji} {info.name} {Format.time(storm.secondsLeft)}`
			UI.setChipColor(stormChip, UI.Theme.orange)
		end
	else
		local nextInfo = if storm.nextKind then MutationData.stormInfo(storm.nextKind) else nil
		stormChip.root.Visible = nextInfo ~= nil
		if nextInfo then
			stormChip.label.Text = `Next {nextInfo.emoji} in {Format.time(storm.secondsLeft)}`
			UI.setChipColor(stormChip, UI.Theme.hud)
		end
	end

	if not snapshot then
		return
	end
	refreshBoosts(snapshot, now)

	if snapshot.lockUntil > now then
		UI.setButton(
			lockButton,
			{ text = "🔒 " .. Format.time(snapshot.lockUntil - now), enabled = false }
		)
	elseif snapshot.lockCooldownUntil > now then
		UI.setButton(
			lockButton,
			{ text = "⏳ " .. Format.time(snapshot.lockCooldownUntil - now), enabled = false }
		)
	else
		UI.setButton(lockButton, {
			text = "🔒 Lock",
			enabled = true,
			color = if dn.isNight then UI.Theme.red else UI.Theme.night,
		})
	end

	local rewards = Hud.menu.Rewards
	if rewards then
		rewards.badge.Visible = (Streak.status(snapshot.streak, Cycle.dayNumber(now)))
	end
	adButton.root.Visible = adAvailable and snapshot.tutorial == 99
	dismountButton.root.Visible = snapshot.riding ~= nil
	for _, refresh in Hud.badgeRefreshers do
		refresh(snapshot)
	end
end

local function onState(snapshot: Types.Snapshot)
	TweenService
		:Create(coinValue, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Value = snapshot.coins })
		:Play()
	incomeLabel.Text = "+" .. Format.number(snapshot.incomePerSecond) .. "/s"
end

local function checkAds()
	if Config.PRODUCT_IDS.AdCoinBoost == 0 then
		adAvailable = false
		return
	end
	local ok, result = pcall(function()
		return AdService:GetAdAvailabilityNowAsync(Enum.AdFormat.RewardedVideo)
	end)
	adAvailable = ok
		and type(result) == "table"
		and result.AdAvailabilityResult == Enum.AdAvailabilityResult.IsAvailable
end

local function invite()
	local player = Players.LocalPlayer
	local ok, canInvite = pcall(function()
		return SocialService:CanSendGameInviteAsync(player)
	end)
	if ok and canInvite then
		pcall(function()
			SocialService:PromptGameInvite(player)
		end)
	end
end

-- Screen position of the coin counter (for flying-coin effects).
function Hud.coinTarget(): Vector2
	return coinsPill.AbsolutePosition + coinsPill.AbsoluteSize / 2
end

function Hud.coinPill(): Frame
	return coinsPill
end

-- ===== Menu =====

local MENU = {
	{ name = "Shop", icon = "🥚", caption = "Eggs", color = UI.Theme.green },
	{ name = "Store", icon = "💎", caption = "Store", color = UI.Theme.blue },
	{ name = "Rewards", icon = "🎁", caption = "Daily", color = UI.Theme.orange },
	{ name = "Quests", icon = "📜", caption = "Quests", color = UI.Theme.purple },
	{ name = "Dex", icon = "📖", caption = "Dex", color = UI.Theme.pink },
	{ name = "Rebirth", icon = "⭐", caption = "Rebirth", color = UI.Theme.gold },
	{ name = "Settings", icon = "⚙️", caption = "Settings", color = UI.Theme.teal },
}

local function buildMenu()
	local menu = UI.new("Frame", {
		Name = "Menu",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.5, 0),
		Size = UDim2.fromOffset(70 * 2 + 18, 4 * 70 + 3 * 34),
		Parent = screen,
	}, {
		UI.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(70, 70),
			CellPadding = UDim2.fromOffset(18, 34),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	}) :: Frame
	for order, entry in MENU do
		local item = UI.menuButton({
			icon = entry.icon,
			caption = entry.caption,
			color = entry.color,
			order = order,
			parent = menu,
			onClick = function()
				Panels.toggle(entry.name)
			end,
		})
		item.button.root.Name = entry.name
		Hud.menu[entry.name] = item
	end
end

-- Hide menu buttons whose window doesn't exist (e.g. a feature turned off).
local function syncMenu()
	for name, item in Hud.menu do
		item.button.root.Visible = Panels.has(name)
	end
end

-- ===== Actions =====

local function buildActions()
	local actions = UI.new("Frame", {
		Name = "Actions",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.fromOffset(700, 60),
		Parent = screen,
	}, {
		UI.list(
			Enum.FillDirection.Horizontal,
			12,
			Enum.HorizontalAlignment.Center,
			Enum.VerticalAlignment.Center
		),
	}) :: Frame
	local function action(
		name: string,
		text: string,
		color: Color3,
		order: number,
		onClick: () -> ()
	): UI.Button
		local button = UI.button({
			name = name,
			text = text,
			size = UDim2.fromOffset(138, 56),
			color = color,
			order = order,
			maxTextSize = 26,
			parent = actions,
			onClick = onClick,
		})
		Hud.buttons[name] = button
		return button
	end
	lockButton = action("Lock", "🔒 Lock", UI.Theme.night, 1, function()
		Net.send("LockGate")
	end)
	action("Roar", "🦖 Roar", UI.Theme.orange, 2, function()
		Net.send("Roar")
	end)
	action("Invite", "📣 Invite", UI.Theme.blue, 3, invite)
	adButton = action("Ad", "▶ Free 2x", UI.Theme.purple, 4, function()
		Net.send("WatchAd")
	end)
	adButton.root.Visible = false
	task.spawn(pcall, function()
		AdService:RegisterAdOpportunityAsync(adButton.face)
	end)
	dismountButton = action("Dismount", "⬇ Get off", UI.Theme.grey, 5, function()
		Net.send("Ride", nil)
	end)
	dismountButton.root.Visible = false
end

function Hud.init()
	screen = UI.screen("HUD", 1)

	coinValue = Instance.new("NumberValue")
	coinValue.Changed:Connect(function(value: number)
		coinsLabel.Text = Format.number(math.floor(value))
	end)

	buildCoins()
	local timers = UI.new("Frame", {
		Name = "Timers",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 76),
		Size = UDim2.fromOffset(640, 36),
		Parent = screen,
	}, { UI.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center) }) :: Frame
	cycleChip = UI.chip({
		name = "Cycle",
		text = "☀️ Day",
		size = UDim2.fromOffset(210, 36),
		color = UI.Theme.day,
		order = 1,
		maxTextSize = 21,
		parent = timers,
	})
	stormChip = UI.chip({
		name = "Storm",
		text = "",
		size = UDim2.fromOffset(250, 36),
		color = UI.Theme.hud,
		order = 2,
		maxTextSize = 21,
		parent = timers,
	})
	stormChip.root.Visible = false
	-- up to 4 chips per row (wraps instead of running into the menu on phones)
	boostRow = UI.new("Frame", {
		Name = "Boosts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 122),
		Size = UDim2.fromOffset(4 * 150 + 3 * 8, 2 * 34 + 8),
		Parent = screen,
	}, {
		UI.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(150, 34),
			CellPadding = UDim2.fromOffset(8, 8),
			FillDirectionMaxCells = 4,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	}) :: Frame

	buildMenu()
	buildActions()

	ClientState.changed:connect(onState)
end

function Hud.start()
	syncMenu()
	task.spawn(function()
		while true do
			checkAds()
			task.wait(45)
		end
	end)
	while true do
		refreshTimers()
		task.wait(0.25)
	end
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="92">
            <Properties>
              <string name="Name">PromptVisibility</string>
              <string name="Source"><![CDATA[--!strict
-- Shows each ProximityPrompt only to the players it's for (owner vs visitors,
-- night-only steal prompts, tutorial gating) and opens UI for client-only
-- prompts. Purely cosmetic: the server re-checks everything on trigger.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local ClientState = require(script.Parent.ClientState)
local DinoPanel = require(script.Parent.DinoPanel)
local ShopUI = require(script.Parent.ShopUI)

local PromptVisibility = {}

local TAG = "GamePrompt"

local function plotModel(index: number): Model?
	local plots = Workspace:FindFirstChild("Plots")
	local plot = plots and plots:FindFirstChild("Plot" .. index)
	if plot and plot:IsA("Model") then
		return plot
	end
	return nil
end

local function numberAttribute(instance: Instance, name: string): number
	local value = instance:GetAttribute(name)
	return if typeof(value) == "number" then value else 0
end

local function shouldShow(prompt: ProximityPrompt): boolean
	local me = Players.LocalPlayer.UserId
	local snapshot = ClientState.get()
	local audience = prompt:GetAttribute("Audience")
	local plotIndex = numberAttribute(prompt, "PlotIndex")
	local plot = if plotIndex > 0 then plotModel(plotIndex) else nil
	local ownerId = numberAttribute(prompt, "OwnerId")
	if ownerId == 0 and plot then
		ownerId = numberAttribute(plot, "OwnerId")
	end

	if audience == "Owner" and ownerId ~= me then
		return false
	elseif audience == "Others" and (ownerId == me or ownerId == 0) then
		return false
	end

	if prompt:GetAttribute("HideInTutorial") and ClientState.tutorialActive() then
		return false
	end

	if prompt:GetAttribute("NightOnly") then
		if not ClientState.isNight() or ReplicatedStorage:GetAttribute("RaidsEnabled") == false then
			return false
		end
		if snapshot and snapshot.carrying then
			return false
		end
		if plot then
			local now = Clock.now()
			if
				numberAttribute(plot, "LockedUntil") > now
				or numberAttribute(plot, "ShieldUntil") > now
			then
				return false
			end
		end
	end
	return true
end

local function update(prompt: ProximityPrompt)
	local show = shouldShow(prompt)
	if prompt.Enabled ~= show then
		prompt.Enabled = show
	end
end

function PromptVisibility.init()
	CollectionService:GetInstanceAddedSignal(TAG):Connect(function(instance)
		if instance:IsA("ProximityPrompt") then
			update(instance)
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt)
		local openUI = prompt:GetAttribute("OpenUI")
		if openUI == "Shop" then
			ShopUI.open()
		elseif openUI == "Dino" then
			local key = prompt:GetAttribute("Key")
			if typeof(key) == "string" then
				DinoPanel.open(key)
			end
		end
	end)
end

function PromptVisibility.start()
	while true do
		for _, instance in CollectionService:GetTagged(TAG) do
			if instance:IsA("ProximityPrompt") then
				update(instance)
			end
		end
		task.wait(0.3)
	end
end

return PromptVisibility
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="93">
            <Properties>
              <string name="Name">QuestsUI</string>
              <string name="Source"><![CDATA[--!strict
-- Daily quests window: today's three quests with progress bars and prizes,
-- plus a bonus for finishing them all. The menu button shows a badge when
-- something is ready to claim.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Cycle = require(ReplicatedStorage.Shared.Util.Cycle)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Net = require(ReplicatedStorage.Shared.Net)
local QuestData = require(ReplicatedStorage.Shared.Data.QuestData)
local Types = require(ReplicatedStorage.Shared.Types)
local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)
local Panels = require(script.Parent.Parent.Lib.Panels)
local UI = require(script.Parent.Parent.Lib.UI)

local QuestsUI = {}

type Row = {
	frame: Frame,
	icon: TextLabel,
	title: TextLabel,
	bar: UI.Bar,
	reward: TextLabel,
	button: UI.Button,
	questId: string?,
}

local rows: { Row } = {}
local resetChip: UI.Chip
local bonusButton: UI.Button
local bonusLabel: TextLabel

type Status = { quest: QuestData.Quest, progress: number, claimed: boolean }

-- Today's quests with this player's progress.
local function statuses(snapshot: Types.Snapshot): ({ Status }, boolean)
	local day = Cycle.dayNumber(Clock.now())
	local state = snapshot.quests
	local current = state.day == day
	local list: { Status } = {}
	for _, quest in QuestData.forDay(day) do
		table.insert(list, {
			quest = quest,
			progress = if current then state.progress[quest.id] or 0 else 0,
			claimed = current and state.claimed[quest.id] == true,
		})
	end
	return list, current and state.bonusClaimed
end

-- Is anything ready to claim? (drives the menu badge)
function QuestsUI.claimable(snapshot: Types.Snapshot): boolean
	if snapshot.tutorial ~= 99 then
		return false
	end
	local list, bonusClaimed = statuses(snapshot)
	local allClaimed = true
	for _, status in list do
		if not status.claimed then
			allClaimed = false
			if status.progress >= status.quest.goal then
				return true
			end
		end
	end
	return allClaimed and not bonusClaimed
end

local function refresh(snapshot: Types.Snapshot)
	local list, bonusClaimed = statuses(snapshot)
	local allClaimed = true
	for i, row in rows do
		local status = list[i]
		row.frame.Visible = status ~= nil
		if status then
			local quest = status.quest
			row.questId = quest.id
			row.icon.Text = quest.emoji
			row.title.Text = quest.text
			row.reward.Text = `{quest.reward.emoji} {quest.reward.label}`
			UI.setBar(row.bar, status.progress / quest.goal, `{status.progress} / {quest.goal}`)
			if status.claimed then
				UI.setButton(row.button, { text = "Done ✓", enabled = false })
			elseif status.progress >= quest.goal then
				UI.setButton(row.button, { text = "Claim!", enabled = true })
			else
				UI.setButton(row.button, { text = "Go!", enabled = false })
				allClaimed = false
			end
			if not status.claimed then
				allClaimed = false
			end
		end
	end
	local bonus = QuestData.ALL_DONE_REWARD
	bonusLabel.Text = `🏆 Finish all of today's quests: {bonus.emoji} {bonus.label}`
	if bonusClaimed then
		UI.setButton(bonusButton, { text = "Done ✓", enabled = false })
	else
		UI.setButton(
			bonusButton,
			{ text = if allClaimed then "Claim!" else "Bonus", enabled = allClaimed }
		)
	end
end

local function buildRow(parent: Instance, order: number): Row
	local frame = UI.card({
		name = "Quest" .. order,
		size = UDim2.new(1, -8, 0, 92),
		order = order,
		radius = 18,
		parent = parent,
	})
	local bubble = UI.new("Frame", {
		Name = "Icon",
		Size = UDim2.fromOffset(66, 66),
		Position = UDim2.new(0, 14, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = UI.lighten(UI.Theme.purple, 0.65),
		Parent = frame,
	}, { UI.round(), UI.stroke(UI.Theme.purple, 3) }) :: Frame
	local icon = UI.text({
		text = "",
		size = UDim2.fromScale(0.68, 0.68),
		position = UDim2.fromScale(0.5, 0.5),
		anchor = Vector2.new(0.5, 0.5),
		maxTextSize = 40,
		noOutline = true,
		parent = bubble,
	})
	local title = UI.body({
		text = "",
		size = UDim2.new(1, -290, 0, 28),
		position = UDim2.fromOffset(94, 12),
		font = UI.Font,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 23,
		parent = frame,
	})
	local bar = UI.bar({
		size = UDim2.new(1, -440, 0, 24),
		position = UDim2.fromOffset(94, 52),
		color = UI.Theme.purple,
		parent = frame,
	})
	local reward = UI.body({
		text = "",
		size = UDim2.fromOffset(150, 24),
		position = UDim2.new(1, -330, 0, 52),
		color = UI.Theme.money,
		font = UI.HeavyFont,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 17,
		parent = frame,
	})
	local row: Row
	local button = UI.button({
		name = "Claim",
		text = "Go!",
		size = UDim2.fromOffset(150, 56),
		position = UDim2.new(1, -16, 0.5, -2),
		anchor = Vector2.new(1, 0.5),
		color = UI.Theme.green,
		parent = frame,
		onClick = function()
			if row.questId then
				Net.send("ClaimQuest", row.questId)
			end
		end,
	})
	row = {
		frame = frame,
		icon = icon,
		title = title,
		bar = bar,
		reward = reward,
		button = button,
		questId = nil,
	}
	return row
end

function QuestsUI.init()
	local _, content =
		Panels.window("Quests", "📜 Daily Quests", Vector2.new(820, 512), UI.Theme.purple)
	UI.body({
		text = "New quests every day. Finish them for prizes!",
		size = UDim2.new(1, -270, 0, 32),
		position = UDim2.fromOffset(0, 2),
		font = UI.Font,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 22,
		parent = content,
	})
	resetChip = UI.chip({
		name = "Reset",
		text = "",
		size = UDim2.fromOffset(240, 36),
		position = UDim2.new(1, 0, 0, 0),
		anchor = Vector2.new(1, 0),
		color = UI.Theme.purple,
		maxTextSize = 19,
		parent = content,
	})
	local list = UI.new("Frame", {
		Name = "List",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 48),
		Size = UDim2.new(1, 0, 0, 3 * 92 + 2 * 10),
		Parent = content,
	}, { UI.list(Enum.FillDirection.Vertical, 10) }) :: Frame
	for i = 1, QuestData.PER_DAY do
		table.insert(rows, buildRow(list, i))
	end
	local bonus = UI.card({
		name = "Bonus",
		size = UDim2.new(1, -8, 0, 62),
		position = UDim2.new(0, 4, 1, -64),
		color = Color3.fromRGB(255, 240, 196),
		edge = UI.Theme.gold,
		radius = 18,
		parent = content,
	})
	bonusLabel = UI.body({
		text = "",
		size = UDim2.new(1, -200, 0, 30),
		position = UDim2.new(0, 18, 0.5, 0),
		anchor = Vector2.new(0, 0.5),
		font = UI.Font,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 22,
		parent = bonus,
	})
	bonusButton = UI.button({
		name = "Claim",
		text = "Bonus",
		size = UDim2.fromOffset(150, 46),
		position = UDim2.new(1, -16, 0.5, -2),
		anchor = Vector2.new(1, 0.5),
		color = UI.Theme.orange,
		parent = bonus,
		onClick = function()
			Net.send("ClaimQuest", "bonus")
		end,
	})

	table.insert(Hud.badgeRefreshers, function(snapshot: Types.Snapshot)
		local item = Hud.menu.Quests
		if item then
			item.badge.Visible = QuestsUI.claimable(snapshot)
		end
	end)
	ClientState.changed:connect(function(snapshot: Types.Snapshot)
		if Panels.isOpen("Quests") then
			refresh(snapshot)
		end
	end)
	Panels.onOpen("Quests", function()
		local snapshot = ClientState.get()
		if snapshot then
			refresh(snapshot)
		end
	end)
end

function QuestsUI.start()
	while true do
		local now = Clock.now()
		local day = Cycle.dayNumber(now)
		resetChip.label.Text = `🔄 New quests in {Format.time((day + 1) * 86400 - now)}`
		task.wait(1)
	end
end

return QuestsUI
]]></string>
