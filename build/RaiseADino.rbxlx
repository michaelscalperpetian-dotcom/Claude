          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">DexUI</string>
              <string name="Source"><![CDATA[--!strict
-- Dino-Dex: every species, silhouetted until discovered, with the mutations
-- you've found for each. Completion is a big reason to keep hatching.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DinoData = require(ReplicatedStorage.Shared.Data.DinoData)
local DinoModel = require(ReplicatedStorage.Shared.Visual.DinoModel)
local MutationData = require(ReplicatedStorage.Shared.Data.MutationData)
local Types = require(ReplicatedStorage.Shared.Types)
local ClientState = require(script.Parent.ClientState)
local Panels = require(script.Parent.Parent.Lib.Panels)
local UI = require(script.Parent.Parent.Lib.UI)

local DexUI = {}

type Card = {
	species: DinoData.Species,
	frame: Frame,
	viewport: ViewportFrame,
	name: TextLabel,
	badges: { [string]: TextLabel },
	discovered: boolean?,
}

local cards: { Card } = {}
local header: TextLabel

local function setSilhouette(viewport: ViewportFrame, silhouette: boolean)
	viewport.ImageColor3 = if silhouette then Color3.new(0, 0, 0) else Color3.new(1, 1, 1)
	viewport.ImageTransparency = if silhouette then 0.35 else 0
end

local function refresh(snapshot: Types.Snapshot)
	local found = 0
	for _, card in cards do
		local entry = snapshot.dex[card.species.id]
		local discovered = entry ~= nil
		if discovered then
			found += 1
		end
		if card.discovered ~= discovered then
			card.discovered = discovered
			setSilhouette(card.viewport, not discovered)
			card.name.Text = if discovered then card.species.name else "???"
		end
		for mutation, badge in card.badges do
			local has = entry ~= nil and entry[mutation] == true
			badge.TextTransparency = if has then 0 else 0.75
		end
	end
	header.Text = `Discovered {found} / {#cards} dinos. Find every mutation too!`
end

function DexUI.init()
	local _, content = Panels.window("Dex", "📖 Dino-Dex", Vector2.new(840, 540), UI.Theme.purple)
	header = UI.text({
		text = "",
		size = UDim2.new(1, 0, 0, 34),
		color = UI.Theme.ink,
		stroke = false,
		maxTextSize = 24,
		parent = content,
	})
	local grid = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(1, 0, 1, -40),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		Parent = content,
	}, {
		UI.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(150, 190),
			CellPadding = UDim2.fromOffset(10, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	}) :: ScrollingFrame

	for index, species in DinoData.LIST do
		local frame = UI.new("Frame", {
			Name = species.id,
			BackgroundColor3 = UI.Theme.panelDark,
			LayoutOrder = index,
			Parent = grid,
		}, {
			UI.corner(14),
			UI.stroke(UI.rgb(DinoData.rarityInfo(species.rarity).color), 4),
		}) :: Frame
		local viewport = UI.viewport(
			DinoModel.build(species.id, 3, nil, "Static"),
			UDim2.new(1, -10, 0, 110),
			frame
		)
		viewport.Position = UDim2.fromOffset(5, 4)
		local name = UI.text({
			text = "???",
			size = UDim2.new(1, -8, 0, 26),
			position = UDim2.fromOffset(4, 114),
			color = UI.Theme.ink,
			stroke = false,
			maxTextSize = 20,
			parent = frame,
		})
		UI.text({
			text = species.rarity,
			size = UDim2.new(1, -8, 0, 18),
			position = UDim2.fromOffset(4, 138),
			color = UI.rgb(DinoData.rarityInfo(species.rarity).color),
			maxTextSize = 16,
			parent = frame,
		})
		local badgeRow = UI.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -8, 0, 26),
			Position = UDim2.fromOffset(4, 158),
			Parent = frame,
		}, { UI.list(Enum.FillDirection.Horizontal, 2) }) :: Frame
		local badges: { [string]: TextLabel } = {}
		for order, mutationId in MutationData.ORDER do
			local info = MutationData.get(mutationId)
			if info then
				badges[mutationId] = UI.text({
					text = info.emoji,
					size = UDim2.fromOffset(24, 24),
					maxTextSize = 20,
					order = order,
					stroke = false,
					parent = badgeRow,
				})
			end
		end
		local card: Card = {
			species = species,
			frame = frame,
			viewport = viewport,
			name = name,
			badges = badges,
			discovered = nil,
		}
		setSilhouette(viewport, true)
		table.insert(cards, card)
	end

	ClientState.changed:connect(refresh)
	Panels.onOpen("Dex", function()
		local snapshot = ClientState.get()
		if snapshot then
			refresh(snapshot)
		end
	end)
end

return DexUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">DinoPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Info card for one of your dinos (opened from its "View" prompt): growth
-- progress, income, mutation, and Sell / Ride buttons.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Config = require(ReplicatedStorage.Shared.Config)
local DinoData = require(ReplicatedStorage.Shared.Data.DinoData)
local DinoModel = require(ReplicatedStorage.Shared.Visual.DinoModel)
local Economy = require(ReplicatedStorage.Shared.Util.Economy)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Growth = require(ReplicatedStorage.Shared.Util.Growth)
local MutationData = require(ReplicatedStorage.Shared.Data.MutationData)
local Net = require(ReplicatedStorage.Shared.Net)
local Types = require(ReplicatedStorage.Shared.Types)
local ClientState = require(script.Parent.ClientState)
local Panels = require(script.Parent.Parent.Lib.Panels)
local UI = require(script.Parent.Parent.Lib.UI)

local DinoPanel = {}

local currentId: string? = nil
local shownKey = ""
local previewHolder: Frame
local nameLabel: TextLabel
local rarityLabel: TextLabel
local growthLabel: TextLabel
local barFill: Frame
local incomeLabel: TextLabel
local extraLabel: TextLabel
local sellButton: TextButton
local rideButton: TextButton
local sellArmedUntil = 0

local function findDino(snapshot: Types.Snapshot, id: string): Types.DinoRecord?
	for _, dino in snapshot.dinos do
		if dino.id == id then
			return dino
		end
	end
	return nil
end

local function refresh()
	local snapshot = ClientState.get()
	local id = currentId
	if not snapshot or not id then
		return
	end
	local dino = findDino(snapshot, id)
	local species = dino and DinoData.get(dino.species)
	if not dino or not species then
		Panels.close()
		return
	end
	local now = Clock.now()
	local stage, fraction, secondsLeft = Growth.progress(now - dino.bornAt, species.growth)
	local mutation = MutationData.get(dino.mutation)

	local key = `{dino.id}:{stage}:{dino.mutation or ""}`
	if key ~= shownKey then
		shownKey = key
		for _, child in previewHolder:GetChildren() do
			child:Destroy()
		end
		UI.viewport(
			DinoModel.build(dino.species, stage, dino.mutation, "Static"),
			UDim2.fromScale(1, 1),
			previewHolder,
			30
		)
	end

	nameLabel.Text = (if mutation then mutation.emoji .. " " .. mutation.name .. " " else "")
		.. species.name
	rarityLabel.Text = `{species.rarity} • {Growth.stageName(stage)}`
	rarityLabel.TextColor3 = UI.rgb(DinoData.rarityInfo(species.rarity).color)
	if stage >= Growth.GIANT then
		growthLabel.Text = "Fully grown GIANT! 🏆"
		barFill.Size = UDim2.fromScale(1, 1)
	else
		growthLabel.Text = `Grows into {Growth.stageName(stage + 1)} in {Format.time(secondsLeft)}`
		barFill.Size = UDim2.fromScale(math.clamp(fraction, 0.02, 1), 1)
	end
	local income = Growth.income(species.income, stage, MutationData.multiplier(dino.mutation))
		* snapshot.multiplier
	incomeLabel.Text = `💰 +{Format.number(income)} coins/sec`
	local lays = Growth.layInterval(stage, Config.LAY_INTERVAL_ADULT, Config.LAY_INTERVAL_GIANT)
	extraLabel.Text = if lays
		then `🥚 Lays an egg every {Format.duration(lays)} • guards your nest at night`
		else "🍼 Too young to lay eggs or guard the nest yet"

	local value = Economy.dinoValue(species.income, stage, MutationData.multiplier(dino.mutation))
	if now < sellArmedUntil then
		sellButton.Text = "Tap again to sell!"
		sellButton.BackgroundColor3 = UI.Theme.red
	else
		sellButton.Text = "Sell 💰 " .. Format.number(value)
		sellButton.BackgroundColor3 = UI.Theme.orange
	end

	if snapshot.riding == dino.id then
		rideButton.Text = "⬇ Get off"
		UI.setEnabled(rideButton, true, UI.Theme.grey)
	elseif not snapshot.passes.RideDinos then
		rideButton.Text = "🦖 Ride (pass)"
		UI.setEnabled(rideButton, true, UI.Theme.blue)
	elseif stage < Growth.JUVENILE then
		rideButton.Text = "Too small to ride"
		UI.setEnabled(rideButton, false, UI.Theme.blue)
	else
		rideButton.Text = "🦖 Ride!"
		UI.setEnabled(rideButton, true, UI.Theme.blue)
	end
end

function DinoPanel.open(dinoId: string)
	currentId = dinoId
	shownKey = ""
	sellArmedUntil = 0
	refresh()
	Panels.open("Dino")
end

function DinoPanel.init()
	local _, content =
		Panels.window("Dino", "🦖 Your Dino", Vector2.new(720, 420), UI.Theme.green)
	previewHolder = UI.new("Frame", {
		BackgroundColor3 = UI.Theme.panelDark,
		Size = UDim2.fromOffset(260, 260),
		Parent = content,
	}, { UI.corner(16) }) :: Frame
	local right = UI.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(276, 0),
		Size = UDim2.new(1, -276, 1, 0),
		Parent = content,
	}) :: Frame
	nameLabel = UI.text({
		text = "",
		size = UDim2.new(1, 0, 0, 44),
		color = UI.Theme.ink,
		stroke = false,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 34,
		parent = right,
	})
	rarityLabel = UI.text({
		text = "",
		size = UDim2.new(1, 0, 0, 30),
		position = UDim2.fromOffset(0, 46),
		align = Enum.TextXAlignment.Left,
		maxTextSize = 24,
		parent = right,
	})
	growthLabel = UI.text({
		text = "",
		size = UDim2.new(1, 0, 0, 26),
		position = UDim2.fromOffset(0, 84),
		color = UI.Theme.ink,
		stroke = false,
		font = UI.BodyFont,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 20,
		parent = right,
	})
	local bar = UI.new("Frame", {
		BackgroundColor3 = UI.Theme.panelDark,
		Size = UDim2.new(1, -10, 0, 22),
		Position = UDim2.fromOffset(0, 114),
		Parent = right,
	}, { UI.corner(11), UI.stroke(UI.Theme.ink, 2) }) :: Frame
	barFill = UI.new("Frame", {
		BackgroundColor3 = UI.Theme.green,
		Size = UDim2.fromScale(0.1, 1),
		Parent = bar,
	}, { UI.corner(11) }) :: Frame
	incomeLabel = UI.text({
		text = "",
		size = UDim2.new(1, 0, 0, 30),
		position = UDim2.fromOffset(0, 146),
		color = Color3.fromRGB(190, 130, 0),
		stroke = false,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 24,
		parent = right,
	})
	extraLabel = UI.text({
		text = "",
		size = UDim2.new(1, 0, 0, 44),
		position = UDim2.fromOffset(0, 180),
		color = UI.Theme.ink,
		stroke = false,
		font = UI.BodyFont,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 18,
		parent = right,
	})
	sellButton = UI.button({
		text = "Sell",
		size = UDim2.new(0.48, 0, 0, 58),
		position = UDim2.fromOffset(0, 250),
		color = UI.Theme.orange,
		parent = right,
		onClick = function()
			local id = currentId
			if not id then
				return
			end
			if Clock.now() < sellArmedUntil then
				sellArmedUntil = 0
				Net.send("SellDino", id)
			else
				sellArmedUntil = Clock.now() + 3
				refresh()
			end
		end,
	})
	rideButton = UI.button({
		text = "Ride",
		size = UDim2.new(0.48, 0, 0, 58),
		position = UDim2.new(1, -10, 0, 250),
		anchor = Vector2.new(1, 0),
		color = UI.Theme.blue,
		parent = right,
		onClick = function()
			local id = currentId
			local snapshot = ClientState.get()
			if not id or not snapshot then
				return
			end
			if snapshot.riding == id then
				Net.send("Ride", nil)
			elseif not snapshot.passes.RideDinos then
				Net.send("PromptPurchase", "pass", "RideDinos")
			else
				Net.send("Ride", id)
				Panels.close()
			end
		end,
	})

	ClientState.changed:connect(function(_: Types.Snapshot)
		if Panels.isOpen("Dino") then
			refresh()
		end
	end)
end

function DinoPanel.start()
	while true do
		task.wait(0.5)
		if Panels.isOpen("Dino") then
			refresh()
		end
	end
end

return DinoPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--!strict
-- One-shot moments: the hatch reveal (anticipation shake, flash, big reveal),
-- roars with screen shake, coin pops, mutation sparkles and confetti.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local DinoData = require(ReplicatedStorage.Shared.Data.DinoData)
local DinoModel = require(ReplicatedStorage.Shared.Visual.DinoModel)
local EggModel = require(ReplicatedStorage.Shared.Visual.EggModel)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local MutationData = require(ReplicatedStorage.Shared.Data.MutationData)
local Net = require(ReplicatedStorage.Shared.Net)
local Hud = require(script.Parent.Hud)
local Toasts = require(script.Parent.Toasts)
local UI = require(script.Parent.Parent.Lib.UI)

local Effects = {}

local screen: ScreenGui
local revealQueue: { { species: string, mutation: string? } } = {}
local revealing = false

-- ===== Confetti =====

local CONFETTI_COLORS = {
	Color3.fromRGB(255, 90, 90),
	Color3.fromRGB(255, 210, 60),
	Color3.fromRGB(90, 220, 120),
	Color3.fromRGB(80, 170, 255),
	Color3.fromRGB(200, 120, 255),
}

local function confetti(amount: number)
	local rng = Random.new()
	for _ = 1, amount do
		local piece = UI.new("Frame", {
			Size = UDim2.fromOffset(rng:NextInteger(8, 16), rng:NextInteger(10, 20)),
			Position = UDim2.new(rng:NextNumber(0, 1), 0, -0.05, 0),
			BackgroundColor3 = CONFETTI_COLORS[rng:NextInteger(1, #CONFETTI_COLORS)],
			Rotation = rng:NextInteger(0, 360),
			ZIndex = 20,
			Parent = screen,
		}) :: Frame
		local duration = rng:NextNumber(1.6, 2.8)
		TweenService
			:Create(
				piece,
				TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{
					Position = UDim2.new(
						piece.Position.X.Scale + rng:NextNumber(-0.15, 0.15),
						0,
						1.1,
						0
					),
					Rotation = piece.Rotation + rng:NextInteger(-360, 360),
				}
			)
			:Play()
		task.delay(duration, function()
			piece:Destroy()
		end)
	end
end

-- ===== Camera shake =====

local function shake(intensity: number, duration: number)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local elapsed = 0
	local connection: RBXScriptConnection
	connection = RunService.RenderStepped:Connect(function(dt)
		elapsed += dt
		if elapsed >= duration then
			connection:Disconnect()
			return
		end
		local falloff = 1 - elapsed / duration
		local offset = Vector3.new(math.random() - 0.5, math.random() - 0.5, 0)
			* intensity
			* falloff
		camera.CFrame = camera.CFrame * CFrame.new(offset)
	end)
end

-- ===== Hatch reveal =====

local function reveal(species: string, mutation: string?)
	local data = DinoData.get(species)
	if not data then
		return
	end
	local rarity = DinoData.rarityInfo(data.rarity)
	local overlay = UI.new("Frame", {
		Size = UDim2.fromScale(4, 4),
		Position = UDim2.fromScale(-1.5, -1.5),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		ZIndex = 10,
		Parent = screen,
	}) :: Frame
	local stage = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.48),
		Size = UDim2.fromOffset(420, 420),
		BackgroundTransparency = 1,
		ZIndex = 11,
		Parent = screen,
	}) :: Frame

	-- 1. Anticipation: the egg shakes harder and harder
	local eggViewport =
		UI.viewport(EggModel.build(EggModel.giftLook(), 3, true), UDim2.fromOffset(260, 260), stage)
	eggViewport.AnchorPoint = Vector2.new(0.5, 0.5)
	eggViewport.Position = UDim2.fromScale(0.5, 0.5)
	eggViewport.ZIndex = 12
	for i = 1, 10 do
		eggViewport.Rotation = (if i % 2 == 0 then 1 else -1) * (4 + i * 1.5)
		task.wait(0.07)
	end
	eggViewport:Destroy()

	-- 2. Flash
	local flash = UI.new("Frame", {
		Size = UDim2.fromScale(4, 4),
		Position = UDim2.fromScale(-1.5, -1.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0,
		ZIndex = 15,
		Parent = screen,
	}) :: Frame
	TweenService:Create(flash, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
	task.delay(0.5, function()
		flash:Destroy()
	end)

	-- 3. Reveal
	local dinoViewport = UI.viewport(
		DinoModel.build(species, 3, mutation, "Static"),
		UDim2.fromOffset(320, 320),
		stage,
		25
	)
	dinoViewport.AnchorPoint = Vector2.new(0.5, 0.5)
	dinoViewport.Position = UDim2.fromScale(0.5, 0.42)
	dinoViewport.ZIndex = 12
	UI.pop(dinoViewport)
	local m = MutationData.get(mutation)
	local title = UI.text({
		text = (if m then m.emoji .. " " .. m.name .. " " else "") .. data.name .. "!",
		size = UDim2.fromOffset(520, 56),
		position = UDim2.new(0.5, 0, 1, -40),
		anchor = Vector2.new(0.5, 0),
		maxTextSize = 48,
		parent = stage,
	})
	title.ZIndex = 13
	local rarityLabel = UI.text({
		text = data.rarity:upper(),
		size = UDim2.fromOffset(320, 40),
		position = UDim2.new(0.5, 0, 1, 18),
		anchor = Vector2.new(0.5, 0),
		color = UI.rgb(rarity.color),
		maxTextSize = 36,
		parent = stage,
	})
	rarityLabel.ZIndex = 13
	UI.pop(title)

	if rarity.order >= DinoData.rarityInfo("Rare").order or m then
		confetti(if rarity.order >= DinoData.rarityInfo("Legendary").order then 120 else 60)
	end
	if rarity.order >= DinoData.rarityInfo("Epic").order then
		shake(0.6, 0.6)
	end

	-- spin the preview a little while it's on screen
	local started = os.clock()
	local spin = RunService.RenderStepped:Connect(function()
		local model = dinoViewport:FindFirstChildOfClass("Model")
		if model then
			model:PivotTo(model:GetPivot() * CFrame.Angles(0, math.rad(0.6), 0))
		end
	end)

	local done = false
	local closeButton = UI.new("TextButton", {
		Size = UDim2.fromScale(4, 4),
		Position = UDim2.fromScale(-1.5, -1.5),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 16,
		Parent = screen,
	}) :: TextButton
	closeButton.Activated:Connect(function()
		if os.clock() - started > 0.8 then
			done = true
		end
	end)
	while not done and os.clock() - started < 3.5 do
		task.wait(0.1)
	end
	spin:Disconnect()
	closeButton:Destroy()
	overlay:Destroy()
	stage:Destroy()
end

local function processQueue()
	if revealing then
		return
	end
	revealing = true
	while #revealQueue > 0 do
		local item = table.remove(revealQueue, 1) :: { species: string, mutation: string? }
		reveal(item.species, item.mutation)
	end
	revealing = false
end

-- ===== World-space popups =====

local function worldText(position: Vector3, text: string, color: Color3, size: number)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.CFrame = CFrame.new(position)
	anchor.Parent = Workspace.CurrentCamera or Workspace
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(size * 6, size * 2)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 4, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Parent = anchor
	local label = UI.text({
		text = text,
		size = UDim2.fromScale(1, 1),
		color = color,
		maxTextSize = size,
		parent = gui,
	})
	TweenService:Create(gui, TweenInfo.new(1.4), { StudsOffsetWorldSpace = Vector3.new(0, 10, 0) })
		:Play()
	TweenService
		:Create(label, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			TextTransparency = 1,
			TextStrokeTransparency = 1,
		})
		:Play()
	task.delay(1.5, function()
		anchor:Destroy()
	end)
end

local function burst(position: Vector3, color: Color3)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
	anchor.Parent = Workspace.CurrentCamera or Workspace
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Speed = NumberRange.new(8, 16)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Lifetime = NumberRange.new(0.6, 1.2)
	emitter.Size = NumberSequence.new(0.8, 0)
	emitter.Rate = 0
	emitter.Parent = anchor
	emitter:Emit(40)
	task.delay(1.5, function()
		anchor:Destroy()
	end)
end

local function coinPop(amount: number)
	-- Offsets inside a UIScale'd screen are in unscaled pixels.
	local uiScale = screen:FindFirstChildOfClass("UIScale")
	local target = Hud.coinTarget() / (if uiScale then uiScale.Scale else 1)
	local label = UI.text({
		text = "+💰 " .. Format.number(amount),
		size = UDim2.fromOffset(240, 50),
		position = UDim2.fromOffset(target.X, target.Y + 80),
		anchor = Vector2.new(0.5, 0.5),
		color = UI.Theme.gold,
		maxTextSize = 40,
		parent = screen,
	})
	label.ZIndex = 5
	TweenService:Create(label, TweenInfo.new(0.9, Enum.EasingStyle.Quad), {
		Position = UDim2.fromOffset(target.X, target.Y + 20),
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()
	task.delay(1, function()
		label:Destroy()
	end)
end

local function onEffect(kind: string, data: { [string]: any })
	if kind == "Hatch" then
		if typeof(data.species) == "string" then
			table.insert(revealQueue, { species = data.species, mutation = data.mutation })
			task.spawn(processQueue)
		end
	elseif kind == "Roar" then
		if typeof(data.position) == "Vector3" then
			worldText(
				data.position,
				"ROAR!",
				Color3.fromRGB(255, 120, 60),
				if data.big then 48 else 34
			)
			local character = Players.LocalPlayer.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") and (root.Position - data.position).Magnitude < 45 then
				shake(if data.big then 0.5 else 0.25, 0.4)
			end
		end
	elseif kind == "Collect" then
		if typeof(data.amount) == "number" then
			coinPop(data.amount)
		end
	elseif kind == "Mutate" then
		if typeof(data.position) == "Vector3" then
			local m = MutationData.get(data.mutation)
			burst(data.position, if m then UI.rgb(m.color) else Color3.new(1, 1, 1))
		end
	elseif kind == "Dex" then
		local species = if typeof(data.species) == "string" then DinoData.get(data.species) else nil
		if species then
			Toasts.show(`📖 New Dex entry: {species.name}!`, "rare")
		end
	elseif kind == "Reward" then
		confetti(70)
	elseif kind == "Caught" then
		if data.victim == Players.LocalPlayer.UserId then
			confetti(40)
		end
	end
end

function Effects.init()
	screen = UI.screen("Effects", 30)
	Net.listen("Effect", onEffect)
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- The always-on HUD: coins, day/night + storm timers, active boosts, menu
-- buttons (right side) and action buttons (bottom row, clear of the mobile
-- thumbstick and jump button).

local AdService = game:GetService("AdService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")
local TweenService = game:GetService("TweenService")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Config = require(ReplicatedStorage.Shared.Config)
local Cycle = require(ReplicatedStorage.Shared.Util.Cycle)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local MutationData = require(ReplicatedStorage.Shared.Data.MutationData)
local Net = require(ReplicatedStorage.Shared.Net)
local Streak = require(ReplicatedStorage.Shared.Util.Streak)
local Types = require(ReplicatedStorage.Shared.Types)
local ClientState = require(script.Parent.ClientState)
local Panels = require(script.Parent.Parent.Lib.Panels)
local UI = require(script.Parent.Parent.Lib.UI)

local Hud = {}

local screen: ScreenGui
local coinsLabel: TextLabel
local incomeLabel: TextLabel
local coinsPill: Frame
local cycleLabel: TextLabel
local cyclePill: Frame
local stormPill: Frame
local stormLabel: TextLabel
local boostList: Frame
local rewardsBadge: TextLabel
local lockButton: TextButton
local adButton: TextButton
local dismountButton: TextButton
local coinValue: NumberValue

local adAvailable = false

Hud.buttons = {} :: { [string]: TextButton }

local function pill(
	name: string,
	size: Vector2,
	position: UDim2,
	anchor: Vector2,
	color: Color3
): Frame
	return UI.new("Frame", {
		Name = name,
		Size = UDim2.fromOffset(size.X, size.Y),
		Position = position,
		AnchorPoint = anchor,
		BackgroundColor3 = color,
		BackgroundTransparency = 0.1,
		Parent = screen,
	}, {
		UI.corner(math.floor(size.Y / 2)),
		UI.stroke(UI.Theme.ink, 3),
	}) :: Frame
end

local function menuButton(
	name: string,
	emoji: string,
	label: string,
	color: Color3,
	order: number,
	onClick: () -> ()
): TextButton
	local button = UI.button({
		text = emoji,
		size = UDim2.fromOffset(78, 78),
		color = color,
		order = order,
		maxTextSize = 40,
		onClick = onClick,
	})
	button.Name = name
	UI.text({
		text = label,
		size = UDim2.new(1, 8, 0, 22),
		position = UDim2.new(0.5, 0, 1, 2),
		anchor = Vector2.new(0.5, 0),
		maxTextSize = 18,
		parent = button,
	})
	Hud.buttons[name] = button
	return button
end

local boostPills: { [string]: { frame: Frame, label: TextLabel } } = {}

local function boostPill(
	id: string,
	text: string,
	color: Color3,
	order: number,
	seen: { [string]: boolean }
)
	seen[id] = true
	local existing = boostPills[id]
	if existing then
		existing.label.Text = text
		return
	end
	local frame = UI.new("Frame", {
		Name = id,
		Size = UDim2.fromOffset(210, 40),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.1,
		LayoutOrder = order,
		Parent = boostList,
	}, { UI.corner(20), UI.stroke(UI.Theme.ink, 2) }) :: Frame
	local label = UI.text({
		text = text,
		size = UDim2.new(1, -16, 1, -8),
		position = UDim2.fromOffset(8, 4),
		maxTextSize = 22,
		parent = frame,
	})
	boostPills[id] = { frame = frame, label = label }
	UI.pop(frame)
end

local function refreshBoosts(snapshot: Types.Snapshot, now: number)
	local seen: { [string]: boolean } = {}
	if snapshot.boosts.luckUntil > now then
		boostPill(
			"Luck",
			"🍀 Luck " .. Format.time(snapshot.boosts.luckUntil - now),
			UI.Theme.green,
			1,
			seen
		)
	end
	if snapshot.boosts.coinsUntil > now then
		boostPill(
			"Coins",
			"⚡ 2x Coins " .. Format.time(snapshot.boosts.coinsUntil - now),
			UI.Theme.orange,
			2,
			seen
		)
	end
	if snapshot.lockUntil > now then
		boostPill(
			"Lock",
			"🔒 Locked " .. Format.time(snapshot.lockUntil - now),
			UI.Theme.red,
			3,
			seen
		)
	end
	if snapshot.shieldUntil > now then
		boostPill(
			"Shield",
			"🛡 Shield " .. Format.duration(snapshot.shieldUntil - now),
			UI.Theme.blue,
			4,
			seen
		)
	end
	if snapshot.friendsHere > 0 then
		local bonus =
			math.min(snapshot.friendsHere * Config.FRIEND_BOOST_PER_FRIEND, Config.FRIEND_BOOST_MAX)
		boostPill(
			"Friends",
			`👥 Friends +{math.floor(bonus * 100 + 0.5)}%`,
			UI.Theme.purple,
			5,
			seen
		)
	end
	if snapshot.multiplier > 1.01 then
		boostPill(
			"Multiplier",
			`💰 x{string.format("%.1f", snapshot.multiplier)} coins`,
			UI.Theme.hud,
			6,
			seen
		)
	end
	for id, entry in boostPills do
		if not seen[id] then
			entry.frame:Destroy()
			boostPills[id] = nil
		end
	end
end

local function refreshTimers()
	local snapshot = ClientState.get()
	local cycleNow = Clock.cycleNow()
	local now = Clock.now()

	local dn = Cycle.dayNight(cycleNow)
	local raids = ReplicatedStorage:GetAttribute("RaidsEnabled") ~= false
	if dn.isNight then
		cycleLabel.Text = `🌙 Night {Format.time(dn.secondsLeft)}`
			.. (if raids then " • Raids on!" else "")
		cyclePill.BackgroundColor3 = UI.Theme.night
	else
		cycleLabel.Text = `☀️ Day {Format.time(dn.secondsLeft)}`
		cyclePill.BackgroundColor3 = UI.Theme.hud
	end

	local storm = Cycle.storm(cycleNow)
	if storm.active then
		stormPill.Visible = true
		if storm.mega then
			stormLabel.Text = `{MutationData.MEGA_STORM_EMOJI} Rainbow Mega Storm {Format.time(
				storm.secondsLeft
			)}`
			stormPill.BackgroundColor3 = UI.Theme.purple
		elseif storm.kind then
			local info = MutationData.stormInfo(storm.kind)
			stormLabel.Text = `{info.emoji} {info.name} {Format.time(storm.secondsLeft)}`
			stormPill.BackgroundColor3 = UI.Theme.orange
		end
	else
		stormPill.Visible = true
		local nextInfo = if storm.nextKind then MutationData.stormInfo(storm.nextKind) else nil
		stormLabel.Text = if nextInfo
			then `Next: {nextInfo.emoji} {nextInfo.name} in {Format.time(storm.secondsLeft)}`
			else ""
		stormPill.BackgroundColor3 = UI.Theme.hud
	end

	if not snapshot then
		return
	end
	refreshBoosts(snapshot, now)

	if snapshot.lockUntil > now then
		lockButton.Text = "🔒 " .. Format.time(snapshot.lockUntil - now)
		UI.setEnabled(lockButton, false, UI.Theme.red)
	elseif snapshot.lockCooldownUntil > now then
		lockButton.Text = "⏳ " .. Format.time(snapshot.lockCooldownUntil - now)
		UI.setEnabled(lockButton, false, UI.Theme.red)
	else
		lockButton.Text = "🔒 Lock"
		UI.setEnabled(lockButton, true, if dn.isNight then UI.Theme.red else UI.Theme.hud)
	end

	local canClaim = Streak.status(snapshot.streak, Cycle.dayNumber(now))
	rewardsBadge.Visible = canClaim
	adButton.Visible = adAvailable and snapshot.tutorial == 99
	dismountButton.Visible = snapshot.riding ~= nil
end

local function onState(snapshot: Types.Snapshot)
	TweenService
		:Create(coinValue, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Value = snapshot.coins })
		:Play()
	incomeLabel.Text = "+" .. Format.number(snapshot.incomePerSecond) .. "/s"
end

local function checkAds()
	if Config.PRODUCT_IDS.AdCoinBoost == 0 then
		adAvailable = false
		return
	end
	local ok, result = pcall(function()
		return AdService:GetAdAvailabilityNowAsync(Enum.AdFormat.RewardedVideo)
	end)
	adAvailable = ok
		and type(result) == "table"
		and result.AdAvailabilityResult == Enum.AdAvailabilityResult.IsAvailable
end

local function invite()
	local player = Players.LocalPlayer
	local ok, canInvite = pcall(function()
		return SocialService:CanSendGameInviteAsync(player)
	end)
	if ok and canInvite then
		pcall(function()
			SocialService:PromptGameInvite(player)
		end)
	end
end

-- Screen position of the coin counter (for flying-coin effects).
function Hud.coinTarget(): Vector2
	return coinsPill.AbsolutePosition + coinsPill.AbsoluteSize / 2
end

function Hud.init()
	screen = UI.screen("HUD", 1)

	coinValue = Instance.new("NumberValue")
	coinValue.Changed:Connect(function(value: number)
		coinsLabel.Text = "💰 " .. Format.number(math.floor(value))
	end)

	coinsPill = pill(
		"Coins",
		Vector2.new(300, 60),
		UDim2.new(0.5, 0, 0, 8),
		Vector2.new(0.5, 0),
		UI.Theme.hud
	)
	coinsLabel = UI.text({
		text = "💰 0",
		size = UDim2.new(0.68, 0, 1, -10),
		position = UDim2.fromOffset(12, 5),
		color = UI.Theme.gold,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 36,
		parent = coinsPill,
	})
	incomeLabel = UI.text({
		text = "+0/s",
		size = UDim2.new(0.3, -10, 0.6, 0),
		position = UDim2.new(1, -10, 0.5, 0),
		anchor = Vector2.new(1, 0.5),
		color = UI.Theme.green,
		align = Enum.TextXAlignment.Right,
		maxTextSize = 24,
		parent = coinsPill,
	})

	cyclePill = pill(
		"Cycle",
		Vector2.new(300, 40),
		UDim2.new(0.5, 0, 0, 74),
		Vector2.new(0.5, 0),
		UI.Theme.hud
	)
	cycleLabel = UI.text({
		text = "☀️ Day",
		size = UDim2.new(1, -20, 1, -8),
		position = UDim2.fromOffset(10, 4),
		maxTextSize = 24,
		parent = cyclePill,
	})
	stormPill = pill(
		"Storm",
		Vector2.new(360, 34),
		UDim2.new(0.5, 0, 0, 120),
		Vector2.new(0.5, 0),
		UI.Theme.hud
	)
	stormLabel = UI.text({
		text = "",
		size = UDim2.new(1, -20, 1, -6),
		position = UDim2.fromOffset(10, 3),
		maxTextSize = 20,
		parent = stormPill,
	})

	boostList = UI.new("Frame", {
		Name = "Boosts",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0.32, 0),
		Size = UDim2.fromOffset(210, 280),
		Parent = screen,
	}, { UI.list(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Left) }) :: Frame

	-- Menu buttons (right side)
	local menu = UI.new("Frame", {
		Name = "Menu",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.46, 0),
		Size = UDim2.fromOffset(84, 430),
		Parent = screen,
	}, {
		UI.list(
			Enum.FillDirection.Vertical,
			26,
			Enum.HorizontalAlignment.Center,
			Enum.VerticalAlignment.Center
		),
	}) :: Frame
	menuButton("Shop", "🥚", "Eggs", UI.Theme.green, 1, function()
		Panels.toggle("Shop")
	end).Parent =
		menu
	menuButton("Store", "💎", "Store", UI.Theme.blue, 2, function()
		Panels.toggle("Store")
	end).Parent =
		menu
	local rewards = menuButton("Rewards", "🎁", "Rewards", UI.Theme.orange, 3, function()
		Panels.toggle("Rewards")
	end)
	rewards.Parent = menu
	rewardsBadge = UI.text({
		text = "!",
		size = UDim2.fromOffset(28, 28),
		position = UDim2.new(1, 4, 0, -6),
		anchor = Vector2.new(1, 0),
		color = UI.Theme.white,
		maxTextSize = 24,
		parent = rewards,
	})
	rewardsBadge.BackgroundTransparency = 0
	rewardsBadge.BackgroundColor3 = UI.Theme.red
	UI.corner(14).Parent = rewardsBadge
	menuButton("Dex", "📖", "Dex", UI.Theme.purple, 4, function()
		Panels.toggle("Dex")
	end).Parent =
		menu

	-- Action row (bottom center)
	local actions = UI.new("Frame", {
		Name = "Actions",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(640, 64),
		Parent = screen,
	}, {
		UI.list(
			Enum.FillDirection.Horizontal,
			10,
			Enum.HorizontalAlignment.Center,
			Enum.VerticalAlignment.Center
		),
	}) :: Frame
	lockButton = UI.button({
		text = "🔒 Lock",
		size = UDim2.fromOffset(150, 58),
		color = UI.Theme.hud,
		order = 1,
		parent = actions,
		onClick = function()
			Net.send("LockGate")
		end,
	})
	Hud.buttons.Lock = lockButton
	Hud.buttons.Roar = UI.button({
		text = "🦖 Roar",
		size = UDim2.fromOffset(130, 58),
		color = UI.Theme.orange,
		order = 2,
		parent = actions,
		onClick = function()
			Net.send("Roar")
		end,
	})
	Hud.buttons.Invite = UI.button({
		text = "📣 Invite",
		size = UDim2.fromOffset(130, 58),
		color = UI.Theme.blue,
		order = 3,
		parent = actions,
		onClick = invite,
	})
	adButton = UI.button({
		text = "▶ Free 2x",
		size = UDim2.fromOffset(140, 58),
		color = UI.Theme.purple,
		order = 4,
		parent = actions,
		onClick = function()
			Net.send("WatchAd")
		end,
	})
	adButton.Visible = false
	task.spawn(pcall, function()
		AdService:RegisterAdOpportunityAsync(adButton)
	end)
	dismountButton = UI.button({
		text = "⬇ Get off",
		size = UDim2.fromOffset(140, 58),
		color = UI.Theme.grey,
		order = 5,
		parent = actions,
		onClick = function()
			Net.send("Ride", nil)
		end,
	})
	dismountButton.Visible = false

	ClientState.changed:connect(onState)
end

function Hud.start()
	task.spawn(function()
		while true do
			checkAds()
			task.wait(45)
		end
	end)
	while true do
		refreshTimers()
		task.wait(0.25)
	end
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">PromptVisibility</string>
              <string name="Source"><![CDATA[--!strict
-- Shows each ProximityPrompt only to the players it's for (owner vs visitors,
-- night-only steal prompts, tutorial gating) and opens UI for client-only
-- prompts. Purely cosmetic: the server re-checks everything on trigger.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local ClientState = require(script.Parent.ClientState)
local DinoPanel = require(script.Parent.DinoPanel)
local ShopUI = require(script.Parent.ShopUI)

local PromptVisibility = {}

local TAG = "GamePrompt"

local function plotModel(index: number): Model?
	local plots = Workspace:FindFirstChild("Plots")
	local plot = plots and plots:FindFirstChild("Plot" .. index)
	if plot and plot:IsA("Model") then
		return plot
	end
	return nil
end

local function numberAttribute(instance: Instance, name: string): number
	local value = instance:GetAttribute(name)
	return if typeof(value) == "number" then value else 0
end

local function shouldShow(prompt: ProximityPrompt): boolean
	local me = Players.LocalPlayer.UserId
	local snapshot = ClientState.get()
	local audience = prompt:GetAttribute("Audience")
	local plotIndex = numberAttribute(prompt, "PlotIndex")
	local plot = if plotIndex > 0 then plotModel(plotIndex) else nil
	local ownerId = numberAttribute(prompt, "OwnerId")
	if ownerId == 0 and plot then
		ownerId = numberAttribute(plot, "OwnerId")
	end

	if audience == "Owner" and ownerId ~= me then
		return false
	elseif audience == "Others" and (ownerId == me or ownerId == 0) then
		return false
	end

	if prompt:GetAttribute("HideInTutorial") and ClientState.tutorialActive() then
		return false
	end

	if prompt:GetAttribute("NightOnly") then
		if not ClientState.isNight() or ReplicatedStorage:GetAttribute("RaidsEnabled") == false then
			return false
		end
		if snapshot and snapshot.carrying then
			return false
		end
		if plot then
			local now = Clock.now()
			if
				numberAttribute(plot, "LockedUntil") > now
				or numberAttribute(plot, "ShieldUntil") > now
			then
				return false
			end
		end
	end
	return true
end

local function update(prompt: ProximityPrompt)
	local show = shouldShow(prompt)
	if prompt.Enabled ~= show then
		prompt.Enabled = show
	end
end

function PromptVisibility.init()
	CollectionService:GetInstanceAddedSignal(TAG):Connect(function(instance)
		if instance:IsA("ProximityPrompt") then
			update(instance)
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt)
		local openUI = prompt:GetAttribute("OpenUI")
		if openUI == "Shop" then
			ShopUI.open()
		elseif openUI == "Dino" then
			local key = prompt:GetAttribute("Key")
			if typeof(key) == "string" then
				DinoPanel.open(key)
			end
		end
	end)
end

function PromptVisibility.start()
	while true do
		for _, instance in CollectionService:GetTagged(TAG) do
			if instance:IsA("ProximityPrompt") then
				update(instance)
			end
		end
		task.wait(0.3)
	end
end

return PromptVisibility
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">RewardsUI</string>
              <string name="Source"><![CDATA[--!strict
-- Daily rewards: the 7-day streak calendar plus the Dino Club daily gift.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Config = require(ReplicatedStorage.Shared.Config)
local Cycle = require(ReplicatedStorage.Shared.Util.Cycle)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Net = require(ReplicatedStorage.Shared.Net)
local Streak = require(ReplicatedStorage.Shared.Util.Streak)
local Types = require(ReplicatedStorage.Shared.Types)
local ClientState = require(script.Parent.ClientState)
local Panels = require(script.Parent.Parent.Lib.Panels)
local UI = require(script.Parent.Parent.Lib.UI)

local RewardsUI = {}

type Tile = { frame: Frame, status: TextLabel, stroke: UIStroke }

local tiles: { Tile } = {}
local claimButton: TextButton
local nextLabel: TextLabel
local clubButton: TextButton

local function refresh(snapshot: Types.Snapshot)
	local now = Clock.now()
	local today = Cycle.dayNumber(now)
	local canClaim, day = Streak.status(snapshot.streak, today)
	local claimedThrough = if canClaim then day - 1 else day
	for index, tile in tiles do
		if index <= claimedThrough then
			tile.status.Text = "✓"
			tile.frame.BackgroundColor3 = Color3.fromRGB(200, 235, 200)
			tile.stroke.Color = UI.Theme.green
		elseif canClaim and index == day then
			tile.status.Text = "TODAY"
			tile.frame.BackgroundColor3 = Color3.fromRGB(255, 236, 170)
			tile.stroke.Color = UI.Theme.orange
		else
			tile.status.Text = ""
			tile.frame.BackgroundColor3 = UI.Theme.panelDark
			tile.stroke.Color = UI.Theme.ink
		end
	end
	if canClaim then
		claimButton.Text = `🎁 Claim day {day}!`
		UI.setEnabled(claimButton, true, UI.Theme.green)
		nextLabel.Text = "Come back every day. Miss a day and the streak restarts."
	else
		claimButton.Text = "Claimed today ✓"
		UI.setEnabled(claimButton, false, UI.Theme.green)
		local secondsToMidnight = (today + 1) * 86400 - now
		nextLabel.Text = `Next reward in {Format.time(secondsToMidnight)}`
	end
	local configured = Config.SUBSCRIPTION_ID ~= ""
	clubButton.Visible = configured
	if snapshot.subscribed then
		local claimed = snapshot.clubClaimDay == today
		clubButton.Text = if claimed
			then "🦖 Club gift claimed ✓"
			else "🦖 Claim Dino Club gift"
		UI.setEnabled(clubButton, not claimed, UI.Theme.purple)
	else
		clubButton.Text = "🦖 Join Dino Club for a daily gift"
		UI.setEnabled(clubButton, true, UI.Theme.purple)
	end
end

function RewardsUI.init()
	local _, content =
		Panels.window("Rewards", "🎁 Daily Rewards", Vector2.new(820, 470), UI.Theme.orange)
	local row = UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 200),
		Parent = content,
	}, {
		UI.list(
			Enum.FillDirection.Horizontal,
			8,
			Enum.HorizontalAlignment.Center,
			Enum.VerticalAlignment.Center
		),
	}) :: Frame
	for day, reward in Streak.REWARDS do
		local stroke = UI.stroke(UI.Theme.ink, 3) :: UIStroke
		local frame = UI.new("Frame", {
			Size = UDim2.fromOffset(104, 180),
			BackgroundColor3 = UI.Theme.panelDark,
			LayoutOrder = day,
			Parent = row,
		}, { UI.corner(14), stroke }) :: Frame
		UI.text({
			text = `Day {day}`,
			size = UDim2.new(1, -8, 0, 28),
			position = UDim2.fromOffset(4, 6),
			color = UI.Theme.ink,
			stroke = false,
			maxTextSize = 22,
			parent = frame,
		})
		UI.text({
			text = reward.emoji,
			size = UDim2.new(1, -8, 0, 52),
			position = UDim2.fromOffset(4, 36),
			maxTextSize = 44,
			parent = frame,
		})
		UI.text({
			text = reward.label,
			size = UDim2.new(1, -8, 0, 44),
			position = UDim2.fromOffset(4, 92),
			color = UI.Theme.ink,
			stroke = false,
			font = UI.BodyFont,
			maxTextSize = 16,
			parent = frame,
		})
		local status = UI.text({
			text = "",
			size = UDim2.new(1, -8, 0, 30),
			position = UDim2.fromOffset(4, 142),
			color = UI.Theme.green,
			maxTextSize = 22,
			parent = frame,
		})
		table.insert(tiles, { frame = frame, status = status, stroke = stroke })
	end
	claimButton = UI.button({
		text = "",
		size = UDim2.fromOffset(320, 60),
		position = UDim2.new(0.5, 0, 0, 214),
		anchor = Vector2.new(0.5, 0),
		color = UI.Theme.green,
		parent = content,
		onClick = function()
			Net.send("ClaimStreak")
		end,
	})
	nextLabel = UI.text({
		text = "",
		size = UDim2.new(1, 0, 0, 28),
		position = UDim2.fromOffset(0, 280),
		color = UI.Theme.ink,
		stroke = false,
		font = UI.BodyFont,
		maxTextSize = 18,
		parent = content,
	})
	clubButton = UI.button({
		text = "",
		size = UDim2.fromOffset(420, 54),
		position = UDim2.new(0.5, 0, 0, 318),
		anchor = Vector2.new(0.5, 0),
		color = UI.Theme.purple,
		parent = content,
		onClick = function()
			local snapshot = ClientState.get()
			if snapshot and snapshot.subscribed then
				Net.send("ClaimClub")
			else
				Net.send("PromptPurchase", "subscription", "DinoClub")
			end
		end,
	})

	ClientState.changed:connect(function(snapshot: Types.Snapshot)
		if Panels.isOpen("Rewards") then
			refresh(snapshot)
		end
	end)
	Panels.onOpen("Rewards", function()
		local snapshot = ClientState.get()
		if snapshot then
			refresh(snapshot)
		end
	end)
end

function RewardsUI.start()
	while true do
		task.wait(1)
		local snapshot = ClientState.get()
		if snapshot and Panels.isOpen("Rewards") then
			refresh(snapshot)
		end
	end
end

return RewardsUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">ShopUI</string>
              <string name="Source"><![CDATA[--!strict
-- Egg Shop: buy eggs (limited stock that restocks every 5 minutes), view each
-- egg's real odds, and buy permanent nest upgrades with coins.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Config = require(ReplicatedStorage.Shared.Config)
local Cycle = require(ReplicatedStorage.Shared.Util.Cycle)
local DinoData = require(ReplicatedStorage.Shared.Data.DinoData)
local Economy = require(ReplicatedStorage.Shared.Util.Economy)
local EggData = require(ReplicatedStorage.Shared.Data.EggData)
local EggModel = require(ReplicatedStorage.Shared.Visual.EggModel)
local EggOdds = require(ReplicatedStorage.Shared.Util.EggOdds)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local MutationData = require(ReplicatedStorage.Shared.Data.MutationData)
local Net = require(ReplicatedStorage.Shared.Net)
local Odds = require(ReplicatedStorage.Shared.Util.Odds)
local Types = require(ReplicatedStorage.Shared.Types)
local ClientState = require(script.Parent.ClientState)
local Panels = require(script.Parent.Parent.Lib.Panels)
local UI = require(script.Parent.Parent.Lib.UI)

local ShopUI = {}

type Card = {
	egg: EggData.EggType,
	price: TextLabel,
	stock: TextLabel,
	buy: TextButton,
}

local cards: { Card } = {}
local restockLabel: TextLabel
local luckLabel: TextLabel
local eggsPage: GuiObject
local upgradesPage: GuiObject
local slotRow: { info: TextLabel, button: TextButton }
local incubatorRow: { info: TextLabel, button: TextButton }

local oddsTitle: TextLabel
local oddsList: ScrollingFrame
local oddsEgg: string? = nil

-- ===== Odds window =====

local function rarityColor(speciesId: string): Color3
	local species = DinoData.get(speciesId)
	if not species then
		return UI.Theme.grey
	end
	return UI.rgb(DinoData.rarityInfo(species.rarity).color)
end

local function oddsRow(order: number, left: string, right: string, color: Color3)
	local row = UI.new("Frame", {
		Size = UDim2.new(1, -12, 0, 40),
		BackgroundColor3 = UI.Theme.panelDark,
		LayoutOrder = order,
		Parent = oddsList,
	}, { UI.corner(10) }) :: Frame
	UI.new("Frame", {
		Size = UDim2.fromOffset(12, 28),
		Position = UDim2.fromOffset(8, 6),
		BackgroundColor3 = color,
		Parent = row,
	}, { UI.corner(6) })
	UI.text({
		text = left,
		size = UDim2.new(0.7, -30, 1, -8),
		position = UDim2.fromOffset(28, 4),
		color = UI.Theme.ink,
		stroke = false,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 22,
		parent = row,
	})
	UI.text({
		text = right,
		size = UDim2.new(0.3, -12, 1, -8),
		position = UDim2.new(1, -10, 0, 4),
		anchor = Vector2.new(1, 0),
		color = UI.Theme.ink,
		stroke = false,
		align = Enum.TextXAlignment.Right,
		maxTextSize = 22,
		parent = row,
	})
end

local function renderOdds()
	local eggId = oddsEgg
	local egg = eggId and EggData.get(eggId)
	if not egg then
		return
	end
	for _, child in oddsList:GetChildren() do
		if child:IsA("Frame") or child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	local snapshot = ClientState.get()
	local luck = snapshot ~= nil and snapshot.boosts.luckUntil > Clock.now()
	oddsTitle.Text = if luck
		then `{egg.name}: chance of each dino (🍀 your Luck boost is included)`
		else `{egg.name}: chance of each dino`

	local order = 0
	for _, chance in EggOdds.species(egg.id, luck) do
		order += 1
		local species = DinoData.get(chance.species)
		local name = if species then `{species.name} ({species.rarity})` else chance.species
		oddsRow(order, name, Odds.format(chance.bp), rarityColor(chance.species))
	end

	order += 1
	UI.text({
		text = "Mutation chance for each hatch right now:",
		size = UDim2.new(1, -12, 0, 34),
		color = UI.Theme.ink,
		stroke = false,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 22,
		order = order,
		parent = oddsList,
	})
	local mutationTotal = 0
	for _, m in EggOdds.mutations(Clock.cycleNow()) do
		order += 1
		mutationTotal += m.bp
		local info = MutationData.get(m.key)
		local label = if info then `{info.emoji} {info.name} (x{info.multiplier} coins)` else m.key
		oddsRow(order, label, Odds.format(m.bp), if info then UI.rgb(info.color) else UI.Theme.grey)
	end
	order += 1
	oddsRow(order, "No mutation", Odds.format(Odds.TOTAL_BP - mutationTotal), UI.Theme.grey)
	order += 1
	UI.text({
		text = "Odds are exact and add up to 100%. Storms change mutation chances.",
		size = UDim2.new(1, -12, 0, 30),
		color = UI.Theme.ink,
		stroke = false,
		font = UI.BodyFont,
		maxTextSize = 16,
		order = order,
		parent = oddsList,
	})
end

function ShopUI.showOdds(eggId: string)
	oddsEgg = eggId
	renderOdds()
	Panels.open("Odds")
end

-- ===== Shop window =====

local function buildCard(parent: Instance, egg: EggData.EggType): Card
	local card = UI.new("Frame", {
		Name = egg.id,
		Size = UDim2.fromOffset(182, 344),
		BackgroundColor3 = UI.Theme.panelDark,
		LayoutOrder = egg.order,
		Parent = parent,
	}, { UI.corner(16), UI.stroke(UI.Theme.ink, 3) }) :: Frame
	local preview = EggModel.build(EggModel.lookForShopEgg(egg.id), 3, true)
	local viewport = UI.viewport(preview, UDim2.fromOffset(120, 120), card)
	viewport.Position = UDim2.new(0.5, 0, 0, 6)
	viewport.AnchorPoint = Vector2.new(0.5, 0)
	UI.text({
		text = egg.name,
		size = UDim2.new(1, -12, 0, 30),
		position = UDim2.fromOffset(6, 128),
		color = UI.Theme.ink,
		stroke = false,
		maxTextSize = 24,
		parent = card,
	})
	local price = UI.text({
		text = "💰 " .. Format.number(egg.price),
		size = UDim2.new(1, -12, 0, 26),
		position = UDim2.fromOffset(6, 158),
		color = Color3.fromRGB(190, 130, 0),
		stroke = false,
		maxTextSize = 22,
		parent = card,
	})
	UI.text({
		text = "⏱ " .. Format.duration(egg.hatchSeconds),
		size = UDim2.new(1, -12, 0, 22),
		position = UDim2.fromOffset(6, 184),
		color = UI.Theme.ink,
		stroke = false,
		font = UI.BodyFont,
		maxTextSize = 18,
		parent = card,
	})
	local stock = UI.text({
		text = "",
		size = UDim2.new(1, -12, 0, 22),
		position = UDim2.fromOffset(6, 206),
		color = UI.Theme.ink,
		stroke = false,
		font = UI.BodyFont,
		maxTextSize = 18,
		parent = card,
	})
	local buy = UI.button({
		text = "Buy",
		size = UDim2.new(1, -20, 0, 48),
		position = UDim2.fromOffset(10, 234),
		color = UI.Theme.green,
		parent = card,
		onClick = function()
			Net.send("BuyEgg", egg.id)
		end,
	})
	UI.button({
		text = "📊 Odds",
		size = UDim2.new(1, -20, 0, 40),
		position = UDim2.fromOffset(10, 290),
		color = UI.Theme.blue,
		maxTextSize = 22,
		parent = card,
		onClick = function()
			ShopUI.showOdds(egg.id)
		end,
	})
	return { egg = egg, price = price, stock = stock, buy = buy }
end

local function upgradeRow(
	parent: Instance,
	order: number,
	title: string,
	onClick: () -> ()
): { info: TextLabel, button: TextButton }
	local row = UI.new("Frame", {
		Size = UDim2.new(1, -10, 0, 90),
		BackgroundColor3 = UI.Theme.panelDark,
		LayoutOrder = order,
		Parent = parent,
	}, { UI.corner(14), UI.stroke(UI.Theme.ink, 2) }) :: Frame
	UI.text({
		text = title,
		size = UDim2.new(0.62, 0, 0, 40),
		position = UDim2.fromOffset(14, 6),
		color = UI.Theme.ink,
		stroke = false,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 28,
		parent = row,
	})
	local info = UI.text({
		text = "",
		size = UDim2.new(0.62, 0, 0, 30),
		position = UDim2.fromOffset(14, 48),
		color = UI.Theme.ink,
		stroke = false,
		font = UI.BodyFont,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 20,
		parent = row,
	})
	local button = UI.button({
		text = "",
		size = UDim2.new(0.34, 0, 0, 60),
		position = UDim2.new(1, -12, 0.5, 0),
		anchor = Vector2.new(1, 0.5),
		color = UI.Theme.green,
		parent = row,
		onClick = onClick,
	})
	return { info = info, button = button }
end

local function refresh()
	local snapshot = ClientState.get()
	local restock = Cycle.restock(Clock.cycleNow())
	restockLabel.Text = "🔄 New stock in " .. Format.time(restock.secondsLeft)
	if not snapshot then
		return
	end
	local now = Clock.now()
	luckLabel.Text = if snapshot.boosts.luckUntil > now
		then "🍀 Luck active: rare dinos are 2x as likely!"
		else ""
	local bought = if snapshot.shopBought.restock == restock.index
		then snapshot.shopBought.bought
		else {}
	for _, card in cards do
		local left = (restock.stock[card.egg.id] or 0) - (bought[card.egg.id] or 0)
		card.stock.Text = if left > 0 then `In stock: {left}` else "Sold out!"
		card.stock.TextColor3 = if left > 0 then UI.Theme.ink else UI.Theme.red
		local affordable = snapshot.coins >= card.egg.price
		UI.setEnabled(card.buy, left > 0 and affordable, UI.Theme.green)
		card.buy.Text = if left <= 0 then "Sold out" elseif affordable then "Buy" else "Need coins"
	end

	local slotCost = Economy.nextUpgradeCost(Config.SLOT_UPGRADE_COSTS, snapshot.upgrades.slots)
	slotRow.info.Text = `Your nest holds {snapshot.maxSlots} dinos ({#snapshot.dinos} now)`
	if slotCost then
		slotRow.button.Text = "💰 " .. Format.number(slotCost)
		UI.setEnabled(slotRow.button, snapshot.coins >= slotCost, UI.Theme.green)
	else
		slotRow.button.Text = "MAX"
		UI.setEnabled(slotRow.button, false, UI.Theme.green)
	end
	local incubatorCost =
		Economy.nextUpgradeCost(Config.INCUBATOR_UPGRADE_COSTS, snapshot.upgrades.incubators)
	incubatorRow.info.Text = `You have {snapshot.maxIncubators} incubators`
	if incubatorCost then
		incubatorRow.button.Text = "💰 " .. Format.number(incubatorCost)
		UI.setEnabled(incubatorRow.button, snapshot.coins >= incubatorCost, UI.Theme.green)
	else
		incubatorRow.button.Text = "MAX"
		UI.setEnabled(incubatorRow.button, false, UI.Theme.green)
	end
end

local function showPage(page: string)
	eggsPage.Visible = page == "Eggs"
	upgradesPage.Visible = page == "Upgrades"
end

local function updateShopBillboard()
	local map = Workspace:FindFirstChild("Map")
	local hub = map and map:FindFirstChild("Hub")
	local promptPart = hub and hub:FindFirstChild("ShopPrompt")
	local gui = promptPart and promptPart:FindFirstChild("ShopBillboard")
	local label = gui and gui:FindFirstChild("Restock")
	if label and label:IsA("TextLabel") then
		label.Text = "New stock in " .. Format.time(Cycle.restock(Clock.cycleNow()).secondsLeft)
	end
end

function ShopUI.open()
	Panels.open("Shop")
end

function ShopUI.init()
	local _, content = Panels.window("Shop", "🥚 Egg Shop", Vector2.new(820, 520), UI.Theme.green)

	local tabs = UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 46),
		Parent = content,
	}, { UI.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left) }) :: Frame
	UI.button({
		text = "🥚 Eggs",
		size = UDim2.fromOffset(150, 42),
		color = UI.Theme.orange,
		order = 1,
		parent = tabs,
		onClick = function()
			showPage("Eggs")
		end,
	})
	UI.button({
		text = "🏗 Upgrades",
		size = UDim2.fromOffset(170, 42),
		color = UI.Theme.blue,
		order = 2,
		parent = tabs,
		onClick = function()
			showPage("Upgrades")
		end,
	})
	restockLabel = UI.text({
		text = "",
		size = UDim2.new(0, 260, 0, 34),
		position = UDim2.new(1, 0, 0, 4),
		anchor = Vector2.new(1, 0),
		color = UI.Theme.ink,
		stroke = false,
		align = Enum.TextXAlignment.Right,
		maxTextSize = 22,
		parent = content,
	})

	eggsPage = UI.new("ScrollingFrame", {
		Name = "Eggs",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 1, -84),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 6,
		Parent = content,
	}, {
		UI.list(
			Enum.FillDirection.Horizontal,
			12,
			Enum.HorizontalAlignment.Left,
			Enum.VerticalAlignment.Center
		),
	}) :: ScrollingFrame
	for _, egg in EggData.LIST do
		table.insert(cards, buildCard(eggsPage, egg))
	end
	luckLabel = UI.text({
		text = "",
		size = UDim2.new(1, 0, 0, 26),
		position = UDim2.new(0, 0, 1, -26),
		color = Color3.fromRGB(40, 140, 60),
		stroke = false,
		maxTextSize = 20,
		parent = content,
	})

	upgradesPage = UI.new("Frame", {
		Name = "Upgrades",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 60),
		Size = UDim2.new(1, 0, 1, -60),
		Visible = false,
		Parent = content,
	}, { UI.list(Enum.FillDirection.Vertical, 12) }) :: Frame
	slotRow = upgradeRow(upgradesPage, 1, "🦖 +1 Dino Slot", function()
		Net.send("BuyUpgrade", "slots")
	end)
	incubatorRow = upgradeRow(upgradesPage, 2, "🥚 +1 Incubator", function()
		Net.send("BuyUpgrade", "incubators")
	end)

	-- Odds window
	local _, oddsContent =
		Panels.window("Odds", "📊 Egg Odds", Vector2.new(620, 520), UI.Theme.blue)
	oddsTitle = UI.text({
		text = "",
		size = UDim2.new(1, -110, 0, 40),
		position = UDim2.fromOffset(110, 0),
		color = UI.Theme.ink,
		stroke = false,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 22,
		parent = oddsContent,
	})
	UI.button({
		text = "← Back",
		size = UDim2.fromOffset(100, 40),
		color = UI.Theme.orange,
		parent = oddsContent,
		onClick = function()
			Panels.open("Shop")
		end,
	})
	oddsList = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 48),
		Size = UDim2.new(1, 0, 1, -48),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		Parent = oddsContent,
	}, { UI.list(Enum.FillDirection.Vertical, 6) }) :: ScrollingFrame

	Panels.onOpen("Shop", refresh)
	ClientState.changed:connect(function(_: Types.Snapshot)
		if Panels.isOpen("Shop") then
			refresh()
		elseif Panels.isOpen("Odds") then
			renderOdds()
		end
	end)
end

function ShopUI.start()
	while true do
		task.wait(0.5)
		updateShopBillboard()
		if Panels.isOpen("Shop") then
			refresh()
		end
	end
end

return ShopUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">StoreUI</string>
              <string name="Source"><![CDATA[--!strict
-- Robux store: game passes, boosts, coin packs, the one-time Starter Pack and
-- the Dino Club subscription. Prices come live from Roblox. Items that feed
-- random egg results are hidden for players PolicyService restricts.

local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local StoreData = require(ReplicatedStorage.Shared.Data.StoreData)
local Types = require(ReplicatedStorage.Shared.Types)
local ClientState = require(script.Parent.ClientState)
local Panels = require(script.Parent.Parent.Lib.Panels)
local UI = require(script.Parent.Parent.Lib.UI)

local StoreUI = {}

type Card = {
	item: StoreData.Item,
	frame: Frame,
	button: TextButton,
}

local list: ScrollingFrame
local cards: { Card } = {}
local clubCard: Frame
local clubButton: TextButton
local prices: { [string]: number } = {}

local function idFor(item: StoreData.Item): number
	if item.kind == "pass" then
		return (Config.GAME_PASS_IDS :: { [string]: number })[item.key] or 0
	end
	return (Config.PRODUCT_IDS :: { [string]: number })[item.key] or 0
end

local function fetchPrice(item: StoreData.Item)
	local id = idFor(item)
	if id == 0 or prices[item.key] then
		return
	end
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfoAsync(
				id,
				if item.kind == "pass" then Enum.InfoType.GamePass else Enum.InfoType.Product
			)
		end)
		if ok and type(info) == "table" and type(info.PriceInRobux) == "number" then
			prices[item.key] = info.PriceInRobux
			StoreUI.refresh()
		end
	end)
end

local function sectionTitle(text: string, order: number)
	UI.text({
		text = text,
		size = UDim2.new(1, -12, 0, 36),
		color = UI.Theme.ink,
		stroke = false,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 26,
		order = order,
		parent = list,
	})
end

local function buildCard(item: StoreData.Item, order: number, highlight: boolean?): Card
	local frame = UI.new("Frame", {
		Name = item.key,
		Size = UDim2.new(1, -12, 0, 86),
		BackgroundColor3 = if highlight then Color3.fromRGB(255, 236, 170) else UI.Theme.panelDark,
		LayoutOrder = order,
		Parent = list,
	}, {
		UI.corner(14),
		UI.stroke(if highlight then UI.Theme.orange else UI.Theme.ink, if highlight then 4 else 2),
	}) :: Frame
	UI.text({
		text = item.emoji,
		size = UDim2.fromOffset(64, 64),
		position = UDim2.fromOffset(10, 11),
		maxTextSize = 48,
		parent = frame,
	})
	UI.text({
		text = item.name,
		size = UDim2.new(0.6, -80, 0, 34),
		position = UDim2.fromOffset(84, 8),
		color = UI.Theme.ink,
		stroke = false,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 26,
		parent = frame,
	})
	UI.text({
		text = item.description,
		size = UDim2.new(0.62, -80, 0, 34),
		position = UDim2.fromOffset(84, 44),
		color = UI.Theme.ink,
		stroke = false,
		font = UI.BodyFont,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 18,
		parent = frame,
	})
	local button = UI.button({
		text = "",
		size = UDim2.new(0.3, 0, 0, 56),
		position = UDim2.new(1, -12, 0.5, 0),
		anchor = Vector2.new(1, 0.5),
		color = UI.Theme.green,
		parent = frame,
		onClick = function()
			Net.send("PromptPurchase", item.kind, item.key)
		end,
	})
	return { item = item, frame = frame, button = button }
end

function StoreUI.refresh()
	local snapshot = ClientState.get()
	if not snapshot then
		return
	end
	for _, card in cards do
		local item = card.item
		local id = idFor(item)
		local hiddenByPolicy = item.feedsRandom == true and snapshot.restricted
		local hiddenStarter = item.key == "StarterPack" and snapshot.starterPackBought
		local notSetUp = id == 0 and not snapshot.isDev
		card.frame.Visible = not hiddenByPolicy and not hiddenStarter and not notSetUp
		if item.kind == "pass" and snapshot.passes[item.key] then
			card.button.Text = "Owned ✓"
			UI.setEnabled(card.button, false, UI.Theme.green)
		elseif id == 0 then
			card.button.Text = "Set ID in Config"
			UI.setEnabled(card.button, false, UI.Theme.green)
		else
			local price = prices[item.key]
			card.button.Text = if price then `R$ {price}` else "Buy"
			UI.setEnabled(card.button, true, UI.Theme.green)
		end
	end
	local clubConfigured = Config.SUBSCRIPTION_ID ~= ""
	clubCard.Visible = clubConfigured or snapshot.isDev
	if snapshot.subscribed then
		clubButton.Text = "Member ✓"
		UI.setEnabled(clubButton, false, UI.Theme.purple)
	elseif not clubConfigured then
		clubButton.Text = "Set ID in Config"
		UI.setEnabled(clubButton, false, UI.Theme.purple)
	else
		clubButton.Text = "Join"
		UI.setEnabled(clubButton, true, UI.Theme.purple)
	end
end

function StoreUI.init()
	local _, content = Panels.window("Store", "💎 Store", Vector2.new(760, 540), UI.Theme.blue)
	list = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		Parent = content,
	}, { UI.list(Enum.FillDirection.Vertical, 8) }) :: ScrollingFrame

	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	table.insert(cards, buildCard(StoreData.STARTER_PACK, nextOrder(), true))

	sectionTitle("Game Passes (forever)", nextOrder())
	for _, item in StoreData.PASSES do
		table.insert(cards, buildCard(item, nextOrder()))
	end

	sectionTitle("Dino Club (monthly)", nextOrder())
	clubCard = UI.new("Frame", {
		Size = UDim2.new(1, -12, 0, 86),
		BackgroundColor3 = Color3.fromRGB(235, 220, 255),
		LayoutOrder = nextOrder(),
		Parent = list,
	}, { UI.corner(14), UI.stroke(UI.Theme.purple, 3) }) :: Frame
	UI.text({
		text = "🦖",
		size = UDim2.fromOffset(64, 64),
		position = UDim2.fromOffset(10, 11),
		maxTextSize = 48,
		parent = clubCard,
	})
	UI.text({
		text = "Dino Club: +10% coins + a daily coin gift",
		size = UDim2.new(0.62, -80, 0, 60),
		position = UDim2.fromOffset(84, 12),
		color = UI.Theme.ink,
		stroke = false,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 22,
		parent = clubCard,
	})
	clubButton = UI.button({
		text = "Join",
		size = UDim2.new(0.3, 0, 0, 56),
		position = UDim2.new(1, -12, 0.5, 0),
		anchor = Vector2.new(1, 0.5),
		color = UI.Theme.purple,
		parent = clubCard,
		onClick = function()
			Net.send("PromptPurchase", "subscription", "DinoClub")
		end,
	})

	sectionTitle("Boosts & Coins", nextOrder())
	for _, item in StoreData.PRODUCTS do
		table.insert(cards, buildCard(item, nextOrder()))
	end

	UI.text({
		text = "Purchases support the game. Ask a grown-up before buying!",
		size = UDim2.new(1, -12, 0, 28),
		color = UI.Theme.ink,
		stroke = false,
		font = UI.BodyFont,
		maxTextSize = 16,
		order = nextOrder(),
		parent = list,
	})

	Panels.onOpen("Store", function()
		for _, card in cards do
			fetchPrice(card.item)
		end
		StoreUI.refresh()
	end)
	ClientState.changed:connect(function(_: Types.Snapshot)
		if Panels.isOpen("Store") then
			StoreUI.refresh()
		end
	end)
end

function StoreUI.open()
	Panels.open("Store")
end

return StoreUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">Toasts</string>
              <string name="Source"><![CDATA[--!strict
-- Little message pop-ups in the top-right corner. Server messages arrive via
-- the "Notify" remote; other controllers can call Toasts.show directly.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Net = require(ReplicatedStorage.Shared.Net)
local UI = require(script.Parent.Parent.Lib.UI)

local Toasts = {}

local MAX_TOASTS = 4
local LIFETIME = 4.5

local COLORS: { [string]: Color3 } = {
	info = Color3.fromRGB(45, 50, 70),
	good = Color3.fromRGB(40, 140, 70),
	bad = Color3.fromRGB(190, 60, 60),
	rare = Color3.fromRGB(150, 80, 230),
	event = Color3.fromRGB(230, 120, 30),
}

local container: Frame? = nil
local order = 0

function Toasts.show(text: string, style: string?)
	local holder = container
	if not holder then
		return
	end
	order += 1
	local toast = UI.new("Frame", {
		Size = UDim2.fromOffset(340, 56),
		BackgroundColor3 = COLORS[style or "info"] or COLORS.info,
		BackgroundTransparency = 0.05,
		LayoutOrder = -order,
		Parent = holder,
	}, {
		UI.corner(14),
		UI.stroke(UI.Theme.ink, 2),
	}) :: Frame
	local label = UI.text({
		text = text,
		size = UDim2.new(1, -16, 1, -8),
		position = UDim2.fromOffset(8, 4),
		align = Enum.TextXAlignment.Left,
		maxTextSize = 22,
		parent = toast,
	})
	UI.pop(toast)

	local toasts = {}
	for _, child in holder:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i = MAX_TOASTS + 1, #toasts do
		toasts[i]:Destroy()
	end

	task.delay(LIFETIME, function()
		if toast.Parent then
			TweenService:Create(toast, UI.SMOOTH, { BackgroundTransparency = 1 }):Play()
			TweenService
				:Create(label, UI.SMOOTH, { TextTransparency = 1, TextStrokeTransparency = 1 })
				:Play()
			task.wait(0.4)
			toast:Destroy()
		end
	end)
end

function Toasts.init()
	local screen = UI.screen("Toasts", 20)
	container = UI.new("Frame", {
		Name = "Container",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(340, 300),
		Parent = screen,
	}, {
		UI.list(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Right),
	})
	Net.listen("Notify", function(text: string, style: string?)
		if typeof(text) == "string" then
			Toasts.show(text, style)
		end
	end)
end

return Toasts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[--!strict
-- First-session tutorial on the client: a hint banner, a glowing beam from the
-- player to the next thing to do, and the "sneaky raptor" raid practice.
-- The server decides the step (and logs the onboarding funnel).

local ExperienceNotificationService = game:GetService("ExperienceNotificationService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local DinoModel = require(ReplicatedStorage.Shared.Visual.DinoModel)
local Net = require(ReplicatedStorage.Shared.Net)
local TutorialData = require(ReplicatedStorage.Shared.Data.TutorialData)
local Types = require(ReplicatedStorage.Shared.Types)
local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)
local UI = require(script.Parent.Parent.Lib.UI)

local Tutorial = {}

local banner: Frame
local bannerText: TextLabel
local gotIt: TextButton
local currentStep = -1

local targetPart: Part
local targetAttachment: Attachment
local beam: Beam
local playerAttachment: Attachment? = nil
local npc: Model? = nil

local function myPlot(): Model?
	return ClientState.myPlot()
end

local function eggTarget(title: string): BasePart?
	local plot = myPlot()
	local eggs = plot and plot:FindFirstChild("Eggs")
	if not eggs then
		return nil
	end
	local fallback: BasePart? = nil
	for _, egg in eggs:GetChildren() do
		if egg:IsA("Model") and egg.PrimaryPart then
			if egg:GetAttribute("Title") == title then
				return egg.PrimaryPart
			end
			fallback = fallback or egg.PrimaryPart
		end
	end
	return fallback
end

local function targetPosition(step: number): Vector3?
	local info = TutorialData.STEPS[step]
	if not info then
		return nil
	end
	if info.target == "Incubator" then
		local part = eggTarget(if step == 1 then "Starter Egg" else "Gift Egg")
		return part and part.CFrame.Position
	elseif info.target == "Pad" then
		local plot = myPlot()
		local pad = plot and plot:FindFirstChild("CoinPad")
		return if pad and pad:IsA("BasePart") then pad.CFrame.Position else nil
	elseif info.target == "Shop" then
		local map = Workspace:FindFirstChild("Map")
		local hub = map and map:FindFirstChild("Hub")
		local shop = hub and hub:FindFirstChild("ShopPrompt")
		return if shop and shop:IsA("BasePart") then shop.CFrame.Position else nil
	elseif info.target == "Thief" then
		local model = npc
		return if model then model:GetPivot().Position + Vector3.new(0, 2, 0) else nil
	end
	return nil
end

local function attachToCharacter()
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local existing = root:FindFirstChild("TutorialAttachment")
	if existing and existing:IsA("Attachment") then
		playerAttachment = existing
	else
		local attachment = Instance.new("Attachment")
		attachment.Name = "TutorialAttachment"
		attachment.Parent = root
		playerAttachment = attachment
	end
	beam.Attachment0 = playerAttachment
end

-- ===== Sneaky raptor (client-only practice thief) =====

local function removeNpc()
	if npc then
		npc:Destroy()
		npc = nil
	end
end

local function spawnNpc()
	removeNpc()
	local plot = myPlot()
	if not plot then
		return
	end
	local floor = plot:FindFirstChild("Floor")
	local tray = plot:FindFirstChild("Tray")
	if not floor or not floor:IsA("BasePart") or not tray or not tray:IsA("BasePart") then
		return
	end
	local model = DinoModel.build("Raptor", 2, nil, "Static")
	model.Name = "SneakyRaptor"
	local startPosition = (floor.CFrame * CFrame.new(0, floor.Size.Y / 2, -40)).Position
	local trayPosition =
		Vector3.new(tray.CFrame.Position.X, startPosition.Y, tray.CFrame.Position.Z)
	local direction = (trayPosition - startPosition).Unit
	local start = CFrame.lookAt(startPosition, startPosition + direction)
	model:PivotTo(start)
	model.Parent = Workspace.CurrentCamera or Workspace

	local root = model.PrimaryPart :: BasePart
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(200, 40)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 6, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	UI.text({
		text = "😈 Sneaky Raptor!",
		size = UDim2.fromScale(1, 1),
		color = UI.Theme.orange,
		parent = gui,
	})
	gui.Parent = root

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Chase away!"
	prompt.ObjectText = "Thief"
	prompt.RequiresLineOfSight = false
	prompt.MaxActivationDistance = 16
	prompt.Parent = root

	-- sneak toward the egg tray
	local value = Instance.new("CFrameValue")
	value.Value = start
	value.Changed:Connect(function(cf: CFrame)
		if model.Parent then
			model:PivotTo(cf)
		end
	end)
	local goal = CFrame.lookAt(trayPosition - direction * 3, trayPosition)
	TweenService:Create(value, TweenInfo.new(10, Enum.EasingStyle.Linear), { Value = goal }):Play()

	prompt.Triggered:Connect(function()
		prompt.Enabled = false
		local away = model:GetPivot() * CFrame.Angles(0, math.pi, 0)
		value.Value = away
		TweenService:Create(value, TweenInfo.new(1.2, Enum.EasingStyle.Quad), {
			Value = away * CFrame.new(0, 0, -40),
		}):Play()
		task.delay(1.3, function()
			if npc == model then
				removeNpc()
			end
		end)
		Net.send("TutorialAction", "ChasedThief")
	end)
	npc = model
end

-- ===== Steps =====

local function setStep(step: number)
	if step == currentStep then
		return
	end
	currentStep = step
	local info = TutorialData.STEPS[step]
	banner.Visible = info ~= nil
	gotIt.Visible = step == #TutorialData.STEPS
	if info then
		bannerText.Text = info.text
		UI.pop(banner)
	end
	if step == 5 then
		spawnNpc()
	else
		removeNpc()
	end
end

local function finish()
	Net.send("TutorialAction", "Finish")
	-- Let players opt in to "your dino is grown!" style notifications.
	task.spawn(function()
		local ok, canPrompt = pcall(function()
			return ExperienceNotificationService:CanPromptOptInAsync()
		end)
		if ok and canPrompt then
			pcall(function()
				ExperienceNotificationService:PromptOptIn()
			end)
		end
	end)
end

function Tutorial.init()
	local screen = UI.screen("Tutorial", 5)
	banner = UI.new("Frame", {
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 162),
		Size = UDim2.fromOffset(640, 76),
		BackgroundColor3 = Color3.fromRGB(255, 225, 90),
		Visible = false,
		Parent = screen,
	}, { UI.corner(18), UI.stroke(UI.Theme.ink, 4) }) :: Frame
	bannerText = UI.text({
		text = "",
		size = UDim2.new(1, -24, 1, -12),
		position = UDim2.fromOffset(12, 6),
		color = UI.Theme.ink,
		stroke = false,
		maxTextSize = 28,
		parent = banner,
	})
	gotIt = UI.button({
		text = "Got it! 👍",
		size = UDim2.fromOffset(180, 54),
		position = UDim2.new(0.5, 0, 1, 10),
		anchor = Vector2.new(0.5, 0),
		color = UI.Theme.green,
		parent = banner,
		onClick = finish,
	})
	gotIt.Visible = false

	targetPart = Instance.new("Part")
	targetPart.Name = "TutorialTarget"
	targetPart.Anchored = true
	targetPart.CanCollide = false
	targetPart.CanQuery = false
	targetPart.CanTouch = false
	targetPart.Transparency = 1
	targetPart.Size = Vector3.one
	targetPart.Parent = Workspace.CurrentCamera or Workspace
	targetAttachment = Instance.new("Attachment")
	targetAttachment.Parent = targetPart
	local arrow = Instance.new("BillboardGui")
	arrow.Size = UDim2.fromOffset(80, 80)
	arrow.StudsOffsetWorldSpace = Vector3.new(0, 5, 0)
	arrow.AlwaysOnTop = true
	arrow.LightInfluence = 0
	UI.text({
		text = "⬇",
		size = UDim2.fromScale(1, 1),
		color = UI.Theme.gold,
		maxTextSize = 70,
		parent = arrow,
	})
	arrow.Parent = targetPart
	TweenService:Create(
		arrow,
		TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ StudsOffsetWorldSpace = Vector3.new(0, 7, 0) }
	):Play()

	beam = Instance.new("Beam")
	beam.Attachment1 = targetAttachment
	beam.Color = ColorSequence.new(UI.Theme.gold)
	beam.LightEmission = 1
	beam.FaceCamera = true
	beam.Width0 = 0.5
	beam.Width1 = 0.5
	beam.Segments = 12
	beam.CurveSize0 = 6
	beam.CurveSize1 = -4
	beam.Transparency = NumberSequence.new(0.2)
	beam.Enabled = false
	beam.Parent = targetPart

	ClientState.changed:connect(function(snapshot: Types.Snapshot)
		setStep(snapshot.tutorial)
	end)
	Players.LocalPlayer.CharacterAdded:Connect(function()
		task.wait(1)
		attachToCharacter()
	end)
end

function Tutorial.start()
	attachToCharacter()
	local pulse = 0
	while true do
		task.wait(0.2)
		local position = if currentStep >= 1 and currentStep <= #TutorialData.STEPS
			then targetPosition(currentStep)
			else nil
		if position then
			targetPart.CFrame = CFrame.new(position)
			beam.Enabled = playerAttachment ~= nil and playerAttachment.Parent ~= nil
			local arrow = targetPart:FindFirstChildOfClass("BillboardGui")
			if arrow then
				arrow.Enabled = true
			end
		else
			beam.Enabled = false
			local arrow = targetPart:FindFirstChildOfClass("BillboardGui")
			if arrow then
				arrow.Enabled = false
			end
		end
		pulse += 1
		if currentStep == #TutorialData.STEPS and pulse % 8 == 0 then
			local lock = Hud.buttons.Lock
			if lock then
				UI.pop(lock)
			end
		end
	end
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">WorldFx</string>
              <string name="Source"><![CDATA[--!strict
-- Client-only visuals: dinos wandering around their home spot, rainbow
-- mutation colors, egg timers and wobbles, day/night lighting, and storm
-- weather. None of this affects gameplay; it only makes the world feel alive.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Cycle = require(ReplicatedStorage.Shared.Util.Cycle)
local DinoModel = require(ReplicatedStorage.Shared.Visual.DinoModel)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Tags = require(ReplicatedStorage.Shared.Tags)

local WorldFx = {}

local EGG_TAG = "IncubatorEgg"
local WANDER_RADIUS = 7

-- ===== Dino wandering =====

local active: { [Model]: boolean } = {}

local function wander(model: Model)
	if active[model] then
		return
	end
	active[model] = true
	local root = model.PrimaryPart
	if not root then
		return
	end
	local rng = Random.new()
	task.spawn(function()
		task.wait(rng:NextNumber(0, 3))
		while active[model] and model.Parent do
			local home = model:GetAttribute("Home")
			if typeof(home) ~= "CFrame" then
				break
			end
			local angle = rng:NextNumber(0, math.pi * 2)
			local distance = rng:NextNumber(0, WANDER_RADIUS)
			local target = home.Position
				+ Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
			local current = root.CFrame.Position
			local flat = Vector3.new(target.X, current.Y, target.Z)
			local travel = (flat - current).Magnitude
			if travel > 0.5 then
				local facing = CFrame.lookAt(current, flat)
				-- turn, then walk
				local turn = TweenService:Create(root, TweenInfo.new(0.4), { CFrame = facing })
				turn:Play()
				turn.Completed:Wait()
				if not active[model] or not model.Parent then
					break
				end
				local walk = TweenService:Create(
					root,
					TweenInfo.new(travel / 5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
					{ CFrame = CFrame.lookAt(flat, flat + facing.LookVector) }
				)
				walk:Play()
				walk.Completed:Wait()
			end
			task.wait(rng:NextNumber(2, 6))
		end
		active[model] = nil
	end)
end

local function onDinoAdded(instance: Instance)
	if instance:IsA("Model") then
		wander(instance)
	end
end

-- ===== Rainbow mutation =====

local function rainbowStep()
	local hue = (os.clock() * 0.25) % 1
	for i, part in CollectionService:GetTagged(DinoModel.RAINBOW_TAG) do
		if part:IsA("BasePart") then
			part.Color = Color3.fromHSV((hue + i * 0.03) % 1, 0.65, 1)
		end
	end
end

-- ===== Incubator eggs =====

local function updateEgg(model: Instance, now: number)
	if not model:IsA("Model") then
		return
	end
	local hatchAt = model:GetAttribute("HatchAt")
	local root = model.PrimaryPart
	if typeof(hatchAt) ~= "number" or not root then
		return
	end
	local gui = root:FindFirstChild("Timer")
	local text = gui and gui:FindFirstChild("Text")
	local ready = hatchAt <= now
	if text and text:IsA("TextLabel") then
		local friendWarm = model:GetAttribute("FriendWarmAt")
		local warmedRecently = typeof(friendWarm) == "number" and now - friendWarm < 2
		if ready then
			text.Text = "🐣 Ready to hatch!"
			text.TextColor3 = Color3.fromRGB(120, 255, 120)
		else
			text.Text = (if warmedRecently then "🔥x2 " else "⏱ ") .. Format.time(hatchAt - now)
			text.TextColor3 = Color3.new(1, 1, 1)
		end
	end
	for _, descendant in root:GetDescendants() do
		if
			descendant:IsA("ProximityPrompt")
			and descendant:GetAttribute("Action") == "IncubatorTap"
		then
			descendant.ActionText = if ready then "Hatch! 🐣" else "Warm 🔥"
		end
	end
	if ready and not model:GetAttribute("Wobbling") then
		model:SetAttribute("Wobbling", true)
		local base = root.CFrame
		local wobble = TweenService:Create(
			root,
			TweenInfo.new(0.18, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ CFrame = base * CFrame.Angles(0, 0, math.rad(9)) }
		)
		wobble:Play()
		model.Destroying:Connect(function()
			wobble:Cancel()
		end)
	end
end

-- ===== Lighting =====

local colorCorrection: ColorCorrectionEffect
local stormPart: Part
local stormEmitter: ParticleEmitter
local lastNight: boolean? = nil
local lastStorm = ""

-- Bright cartoon day; a blue, readable night lit by lamps.
local DAY = {
	lighting = {
		ClockTime = 14.2,
		Brightness = 2.6,
		Ambient = Color3.fromRGB(115, 112, 128),
		OutdoorAmbient = Color3.fromRGB(148, 148, 163),
		ColorShift_Top = Color3.fromRGB(255, 242, 220),
	},
	atmosphere = {
		Density = 0.28,
		Color = Color3.fromRGB(199, 230, 255),
		Decay = Color3.fromRGB(122, 178, 242),
	},
}
local NIGHT = {
	lighting = {
		ClockTime = 0.6,
		Brightness = 1.3,
		Ambient = Color3.fromRGB(82, 86, 140),
		OutdoorAmbient = Color3.fromRGB(98, 104, 170),
		ColorShift_Top = Color3.fromRGB(150, 170, 255),
	},
	atmosphere = {
		Density = 0.32,
		Color = Color3.fromRGB(64, 74, 132),
		Decay = Color3.fromRGB(38, 44, 98),
	},
}

local function setNightLights(on: boolean)
	for _, light in CollectionService:GetTagged(Tags.NIGHT_LIGHT) do
		if light:IsA("Light") then
			light.Enabled = on
		end
	end
end

local function setLighting(isNight: boolean)
	local info = TweenInfo.new(6, Enum.EasingStyle.Sine)
	local look = if isNight then NIGHT else DAY
	TweenService:Create(Lighting, info, look.lighting):Play()
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		TweenService:Create(atmosphere, info, look.atmosphere):Play()
	end
	setNightLights(isNight)
end

local STORM_LOOKS: { [string]: { tint: Color3, particles: Color3, rate: number, speed: number } } =
	{
		Lava = {
			tint = Color3.fromRGB(255, 200, 170),
			particles = Color3.fromRGB(255, 120, 40),
			rate = 60,
			speed = 10,
		},
		Frost = {
			tint = Color3.fromRGB(200, 225, 255),
			particles = Color3.fromRGB(255, 255, 255),
			rate = 120,
			speed = 8,
		},
		Cosmic = {
			tint = Color3.fromRGB(215, 190, 255),
			particles = Color3.fromRGB(190, 140, 255),
			rate = 50,
			speed = 30,
		},
		Rainbow = {
			tint = Color3.fromRGB(255, 225, 245),
			particles = Color3.fromRGB(255, 150, 220),
			rate = 90,
			speed = 12,
		},
	}

local function setStorm(kind: string)
	if kind == "" then
		stormEmitter.Enabled = false
		TweenService:Create(colorCorrection, TweenInfo.new(3), { TintColor = Color3.new(1, 1, 1) })
			:Play()
		return
	end
	local look = STORM_LOOKS[kind]
	if not look then
		return
	end
	stormEmitter.Color = if kind == "Rainbow"
		then ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 90)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 230, 90)),
			ColorSequenceKeypoint.new(0.66, Color3.fromRGB(90, 220, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 120, 255)),
		})
		else ColorSequence.new(look.particles)
	stormEmitter.Rate = look.rate
	stormEmitter.Speed = NumberRange.new(look.speed, look.speed * 1.4)
	stormEmitter.Enabled = true
	TweenService:Create(colorCorrection, TweenInfo.new(3), { TintColor = look.tint }):Play()
end

local function weatherStep()
	local now = Clock.cycleNow()
	local isNight = Cycle.dayNight(now).isNight
	if isNight ~= lastNight then
		lastNight = isNight
		setLighting(isNight)
	end
	local storm = Cycle.storm(now)
	local kind = if not storm.active then "" elseif storm.mega then "Rainbow" else storm.kind or ""
	if kind ~= lastStorm then
		lastStorm = kind
		setStorm(kind)
	end
end

local function followCamera()
	local camera = Workspace.CurrentCamera
	if camera and stormEmitter.Enabled then
		stormPart.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, 40, 0))
	end
end

function WorldFx.init()
	colorCorrection = Instance.new("ColorCorrectionEffect")
	colorCorrection.Name = "StormTint"
	colorCorrection.Parent = Lighting

	stormPart = Instance.new("Part")
	stormPart.Name = "StormEmitter"
	stormPart.Anchored = true
	stormPart.CanCollide = false
	stormPart.CanQuery = false
	stormPart.CanTouch = false
	stormPart.Transparency = 1
	stormPart.Size = Vector3.new(160, 1, 160)
	stormPart.Parent = Workspace.CurrentCamera or Workspace
	stormEmitter = Instance.new("ParticleEmitter")
	stormEmitter.EmissionDirection = Enum.NormalId.Bottom
	stormEmitter.Lifetime = NumberRange.new(4, 6)
	stormEmitter.Size = NumberSequence.new(0.6)
	stormEmitter.LightEmission = 0.6
	stormEmitter.Enabled = false
	stormEmitter.Parent = stormPart

	for _, instance in CollectionService:GetTagged(DinoModel.TAG) do
		onDinoAdded(instance)
	end
	CollectionService:GetInstanceAddedSignal(DinoModel.TAG):Connect(onDinoAdded)
	CollectionService:GetInstanceAddedSignal(Tags.NIGHT_LIGHT):Connect(function(instance)
		if instance:IsA("Light") then
			instance.Enabled = lastNight == true
		end
	end)
	CollectionService:GetInstanceRemovedSignal(DinoModel.TAG):Connect(function(instance)
		if instance:IsA("Model") then
			active[instance] = nil
		end
	end)
end

function WorldFx.start()
	RunService.Heartbeat:Connect(function()
		rainbowStep()
		followCamera()
	end)
	while true do
		local now = Clock.now()
		for _, egg in CollectionService:GetTagged(EGG_TAG) do
			updateEgg(egg, now)
		end
		weatherStep()
		task.wait(0.25)
	end
end

return WorldFx
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="80">
          <Properties>
            <string name="Name">Lib</string>
          </Properties>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">Panels</string>
              <string name="Source"><![CDATA[--!strict
-- Pop-up windows (shop, store, dex...). One open at a time, with an open
-- animation and a close button. Tapping the dimmed background closes too.

local TweenService = game:GetService("TweenService")

local UI = require(script.Parent.UI)

local Panels = {}

type Window = {
	frame: Frame,
	content: Frame,
	scale: UIScale,
	onOpen: { () -> () },
	onClose: { () -> () },
}

local gui: ScreenGui? = nil
local dim: TextButton? = nil
local windows: { [string]: Window } = {}
local current: string? = nil

local function root(): ScreenGui
	if gui then
		return gui
	end
	local screen = UI.screen("Panels", 10)
	local background = UI.new("TextButton", {
		Name = "Dim",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		Size = UDim2.fromScale(4, 4),
		Position = UDim2.fromScale(-1.5, -1.5),
		Visible = false,
		ZIndex = 0,
		Parent = screen,
	}) :: TextButton
	background.Activated:Connect(function()
		Panels.close()
	end)
	gui = screen
	dim = background
	return screen
end

-- Creates a window and returns (window frame, content frame).
function Panels.window(name: string, title: string, size: Vector2, accent: Color3?): (Frame, Frame)
	local screen = root()
	local frame = UI.new("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundColor3 = UI.Theme.panel,
		Visible = false,
		ZIndex = 2,
		Parent = screen,
	}, {
		UI.corner(22),
		UI.stroke(UI.Theme.ink, 4),
	}) :: Frame
	local scale = UI.new("UIScale", { Parent = frame }) :: UIScale

	local titleBar = UI.new("Frame", {
		Name = "TitleBar",
		Size = UDim2.new(1, 0, 0, 58),
		BackgroundColor3 = accent or UI.Theme.orange,
		Parent = frame,
	}, { UI.corner(22) }) :: Frame
	-- square off the bottom of the title bar
	UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.new(0, 0, 1, -22),
		BackgroundColor3 = accent or UI.Theme.orange,
		BorderSizePixel = 0,
		Parent = titleBar,
	})
	UI.text({
		text = title,
		size = UDim2.new(1, -140, 0, 44),
		position = UDim2.new(0.5, 0, 0, 7),
		anchor = Vector2.new(0.5, 0),
		maxTextSize = 36,
		parent = titleBar,
	})
	UI.button({
		text = "✕",
		size = UDim2.fromOffset(46, 46),
		position = UDim2.new(1, -8, 0, 6),
		anchor = Vector2.new(1, 0),
		color = UI.Theme.red,
		parent = frame,
		onClick = function()
			Panels.close()
		end,
	})

	local content = UI.new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 68),
		Size = UDim2.new(1, -28, 1, -80),
		Parent = frame,
	}) :: Frame

	windows[name] = { frame = frame, content = content, scale = scale, onOpen = {}, onClose = {} }
	return frame, content
end

function Panels.onOpen(name: string, fn: () -> ())
	table.insert(windows[name].onOpen, fn)
end

function Panels.onClose(name: string, fn: () -> ())
	table.insert(windows[name].onClose, fn)
end

function Panels.isOpen(name: string): boolean
	return current == name
end

function Panels.current(): string?
	return current
end

function Panels.close()
	if not current then
		return
	end
	local window = windows[current]
	current = nil
	if dim then
		dim.Visible = false
	end
	if window then
		window.frame.Visible = false
		for _, fn in window.onClose do
			task.spawn(fn)
		end
	end
end

function Panels.open(name: string)
	local window = windows[name]
	if not window then
		return
	end
	if current and current ~= name then
		Panels.close()
	end
	current = name
	if dim then
		dim.Visible = true
	end
	window.frame.Visible = true
	window.scale.Scale = 0.8
	TweenService:Create(window.scale, UI.BOUNCY, { Scale = 1 }):Play()
	for _, fn in window.onOpen do
		task.spawn(fn)
	end
end

function Panels.toggle(name: string)
	if current == name then
		Panels.close()
	else
		Panels.open(name)
	end
end

return Panels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[--!strict
-- Tiny UI toolkit: one theme, a few element builders, juicy buttons, 3D
-- previews, and a responsive scale so layouts work from phones to desktops.
-- UI here is built in code; layouts use anchors + Scale positions, sizes are in
-- design pixels and a UIScale fits them to the screen.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local UI = {}

UI.Theme = {
	ink = Color3.fromRGB(35, 30, 45),
	panel = Color3.fromRGB(255, 249, 236),
	panelDark = Color3.fromRGB(240, 228, 205),
	hud = Color3.fromRGB(28, 32, 46),
	white = Color3.fromRGB(255, 255, 255),
	gold = Color3.fromRGB(255, 205, 60),
	green = Color3.fromRGB(90, 200, 90),
	blue = Color3.fromRGB(70, 150, 255),
	red = Color3.fromRGB(240, 80, 80),
	orange = Color3.fromRGB(255, 150, 50),
	purple = Color3.fromRGB(160, 100, 255),
	grey = Color3.fromRGB(160, 160, 170),
	night = Color3.fromRGB(90, 100, 200),
}

UI.Font = Enum.Font.FredokaOne
UI.BodyFont = Enum.Font.GothamBold

UI.FAST = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
UI.BOUNCY = TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
UI.SMOOTH = TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

-- Create an instance, set properties, parent children. Returns `any` so callers
-- cast to the concrete class (`:: Frame`).
function UI.new(className: string, props: { [string]: any }?, children: { any }?): any
	local instance = Instance.new(className)
	local parent: Instance? = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

-- Decorators return `any` so they can be mixed in one children list.
function UI.corner(radius: number?): any
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 14) })
end

function UI.stroke(color: Color3?, thickness: number?): any
	return UI.new("UIStroke", {
		Color = color or UI.Theme.ink,
		Thickness = thickness or 3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.padding(px: number): any
	local u = UDim.new(0, px)
	return UI.new(
		"UIPadding",
		{ PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u }
	)
end

function UI.list(
	direction: Enum.FillDirection,
	padding: number,
	horizontalAlign: Enum.HorizontalAlignment?,
	verticalAlign: Enum.VerticalAlignment?
): any
	return UI.new("UIListLayout", {
		FillDirection = direction,
		Padding = UDim.new(0, padding),
		HorizontalAlignment = horizontalAlign or Enum.HorizontalAlignment.Center,
		VerticalAlignment = verticalAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

export type TextProps = {
	text: string,
	size: UDim2,
	position: UDim2?,
	anchor: Vector2?,
	color: Color3?,
	font: Enum.Font?,
	stroke: boolean?,
	align: Enum.TextXAlignment?,
	maxTextSize: number?,
	parent: Instance?,
	order: number?,
	wrap: boolean?,
}

function UI.text(props: TextProps): TextLabel
	local label = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Text = props.text,
		Size = props.size,
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		TextColor3 = props.color or UI.Theme.white,
		Font = props.font or UI.Font,
		TextScaled = true,
		TextWrapped = props.wrap ~= false,
		TextXAlignment = props.align or Enum.TextXAlignment.Center,
		TextStrokeTransparency = if props.stroke == false then 1 else 0.4,
		LayoutOrder = props.order or 0,
	}) :: TextLabel
	UI.new(
		"UITextSizeConstraint",
		{ MaxTextSize = props.maxTextSize or 40, MinTextSize = 8, Parent = label }
	)
	if props.parent then
		label.Parent = props.parent
	end
	return label
end

export type ButtonProps = {
	text: string,
	size: UDim2,
	position: UDim2?,
	anchor: Vector2?,
	color: Color3?,
	textColor: Color3?,
	parent: Instance?,
	order: number?,
	maxTextSize: number?,
	onClick: () -> (),
}

-- Chunky button with a press pop.
function UI.button(props: ButtonProps): TextButton
	local button = UI.new("TextButton", {
		Text = props.text,
		Size = props.size,
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		BackgroundColor3 = props.color or UI.Theme.green,
		TextColor3 = props.textColor or UI.Theme.white,
		Font = UI.Font,
		TextScaled = true,
		TextStrokeTransparency = 0.5,
		AutoButtonColor = false,
		LayoutOrder = props.order or 0,
	}, {
		UI.corner(12),
		UI.stroke(UI.Theme.ink, 3),
		UI.padding(6),
	}) :: TextButton
	UI.new(
		"UITextSizeConstraint",
		{ MaxTextSize = props.maxTextSize or 30, MinTextSize = 8, Parent = button }
	)
	local scale = UI.new("UIScale", { Parent = button }) :: UIScale
	button.MouseButton1Down:Connect(function()
		TweenService:Create(scale, UI.FAST, { Scale = 0.92 }):Play()
	end)
	button.MouseButton1Up:Connect(function()
		TweenService:Create(scale, UI.BOUNCY, { Scale = 1 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scale, UI.BOUNCY, { Scale = 1 }):Play()
	end)
	button.Activated:Connect(function()
		TweenService:Create(scale, UI.BOUNCY, { Scale = 1 }):Play()
		if button:GetAttribute("Disabled") == true then
			return
		end
		props.onClick()
	end)
	if props.parent then
		button.Parent = props.parent
	end
	return button
end

function UI.setEnabled(button: TextButton, enabled: boolean, color: Color3)
	button:SetAttribute("Disabled", not enabled)
	button.BackgroundColor3 = if enabled then color else UI.Theme.grey
end

function UI.pop(gui: GuiObject)
	local scale = gui:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = UI.new("UIScale", { Parent = gui })
	end
	local s = scale :: UIScale
	s.Scale = 1.15
	TweenService:Create(s, UI.BOUNCY, { Scale = 1 }):Play()
end

-- A ScreenGui that scales its contents to the screen size.
function UI.screen(name: string, displayOrder: number): ScreenGui
	local gui = UI.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		DisplayOrder = displayOrder,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = false,
	}) :: ScreenGui
	local scale = UI.new("UIScale", { Parent = gui }) :: UIScale
	local function update()
		local camera = Workspace.CurrentCamera
		if not camera then
			return
		end
		local size = camera.ViewportSize
		scale.Scale = math.clamp(math.min(size.X / 1150, size.Y / 650), 0.62, 1.3)
	end
	update()
	local camera = Workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	end
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return gui
end

-- 3D preview of a model in the UI. The model faces -Z, so the camera sits in front.
function UI.viewport(model: Model, size: UDim2, parent: Instance?, angle: number?): ViewportFrame
	local frame = UI.new("ViewportFrame", {
		BackgroundTransparency = 1,
		Size = size,
		Ambient = Color3.fromRGB(190, 190, 200),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-0.5, -1, 0.6),
	}) :: ViewportFrame
	local camera = UI.new("Camera", { FieldOfView = 35, Parent = frame }) :: Camera
	frame.CurrentCamera = camera
	model.Parent = frame
	local cf, extents = model:GetBoundingBox()
	local radius = extents.Magnitude / 2
	local distance = radius / math.tan(math.rad(camera.FieldOfView / 2)) * 1.02
	local yaw = math.rad(angle or 35)
	local direction = Vector3.new(-math.sin(yaw), 0.35, -math.cos(yaw)).Unit
	camera.CFrame = CFrame.lookAt(cf.Position + direction * distance, cf.Position)
	if parent then
		frame.Parent = parent
	end
	return frame
end

function UI.rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

return UI
