          <Item class="ModuleScript" referent="94">
            <Properties>
              <string name="Name">RebirthUI</string>
              <string name="Source"><![CDATA[--!strict
-- Rebirth window: how many rebirths you have, your permanent coin boost, and
-- progress toward the next one. The menu button shows a badge when you can
-- afford it. Rebirthing needs a second tap, since it spends all your coins.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require(ReplicatedStorage.Shared.Util.Economy)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Net = require(ReplicatedStorage.Shared.Net)
local Types = require(ReplicatedStorage.Shared.Types)
local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)
local Panels = require(script.Parent.Parent.Lib.Panels)
local UI = require(script.Parent.Parent.Lib.UI)

local RebirthUI = {}

local countLabel: TextLabel
local boostLabel: TextLabel
local nextLabel: TextLabel
local progress: UI.Bar
local rebirthButton: UI.Button
local confirm = UI.confirm()

local function bonusPercent(rebirths: number): number
	return math.floor((Economy.rebirthMultiplier(rebirths) - 1) * 100 + 0.5)
end

function RebirthUI.ready(snapshot: Types.Snapshot): boolean
	return snapshot.coins >= Economy.rebirthCost(snapshot.rebirths)
end

local function refresh(snapshot: Types.Snapshot)
	local rebirths = snapshot.rebirths
	local cost = Economy.rebirthCost(rebirths)
	countLabel.Text = `⭐ {rebirths}`
	boostLabel.Text = if rebirths > 0
		then `Your coins: +{bonusPercent(rebirths)}% forever`
		else "No rebirths yet"
	nextLabel.Text =
		`Rebirth {rebirths + 1}: +{bonusPercent(rebirths + 1)}% coins on everything, forever`
	UI.setBar(
		progress,
		math.clamp(snapshot.coins / cost, 0, 1),
		`💰 {Format.number(snapshot.coins)} / {Format.number(cost)}`
	)
	if not RebirthUI.ready(snapshot) then
		UI.setButton(rebirthButton, {
			text = `Need 💰{Format.number(cost - snapshot.coins)} more`,
			color = UI.Theme.gold,
			enabled = false,
		})
	elseif UI.isArmed(confirm) then
		UI.setButton(
			rebirthButton,
			{ text = "Sure? All coins reset! Tap again", color = UI.Theme.red, enabled = true }
		)
	else
		UI.setButton(
			rebirthButton,
			{ text = "⭐ Rebirth!", color = UI.Theme.gold, enabled = true }
		)
	end
end

local function infoCard(
	parent: Instance,
	position: UDim2,
	title: string,
	text: string,
	color: Color3
)
	local card = UI.card({
		size = UDim2.new(0.5, -8, 0, 116),
		position = position,
		color = UI.lighten(color, 0.82),
		edge = color,
		radius = 16,
		parent = parent,
	})
	UI.body({
		text = title,
		size = UDim2.new(1, -24, 0, 28),
		position = UDim2.fromOffset(12, 8),
		font = UI.Font,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 22,
		parent = card,
	})
	UI.body({
		text = text,
		size = UDim2.new(1, -24, 0, 70),
		position = UDim2.fromOffset(12, 38),
		color = UI.Theme.inkSoft,
		align = Enum.TextXAlignment.Left,
		valign = Enum.TextYAlignment.Top,
		maxTextSize = 18,
		parent = card,
	})
end

function RebirthUI.init()
	local _, content = Panels.window("Rebirth", "⭐ Rebirth", Vector2.new(760, 500), UI.Theme.gold)

	local top = UI.card({
		name = "Current",
		size = UDim2.new(1, 0, 0, 96),
		color = UI.lighten(UI.Theme.gold, 0.75),
		edge = UI.darken(UI.Theme.gold, 0.25),
		radius = 18,
		parent = content,
	})
	countLabel = UI.text({
		text = "⭐ 0",
		size = UDim2.fromOffset(150, 70),
		position = UDim2.new(0, 14, 0.5, 0),
		anchor = Vector2.new(0, 0.5),
		color = UI.Theme.gold,
		maxTextSize = 54,
		outlineThickness = 3,
		parent = top,
	})
	boostLabel = UI.body({
		text = "",
		size = UDim2.new(1, -190, 0, 40),
		position = UDim2.new(0, 176, 0.5, 0),
		anchor = Vector2.new(0, 0.5),
		font = UI.Font,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 30,
		parent = top,
	})

	nextLabel = UI.body({
		text = "",
		size = UDim2.new(1, 0, 0, 30),
		position = UDim2.fromOffset(0, 110),
		font = UI.Font,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 22,
		parent = content,
	})
	progress = UI.bar({
		size = UDim2.new(1, 0, 0, 34),
		position = UDim2.fromOffset(0, 146),
		color = UI.Theme.gold,
		parent = content,
	})

	infoCard(
		content,
		UDim2.fromOffset(0, 196),
		"✅ You keep",
		"🦖 All your dinos  🥚 Eggs\n⬆️ Upgrades  📖 Dex  🎟 Passes",
		UI.Theme.green
	)
	infoCard(
		content,
		UDim2.new(0.5, 8, 0, 196),
		"🔄 Resets",
		"💰 All your coins, including the ones on your coin pad",
		UI.Theme.orange
	)

	rebirthButton = UI.button({
		name = "RebirthButton",
		text = "⭐ Rebirth!",
		size = UDim2.new(1, -120, 0, 64),
		position = UDim2.new(0.5, 0, 1, -6),
		anchor = Vector2.new(0.5, 1),
		color = UI.Theme.gold,
		maxTextSize = 30,
		parent = content,
		onClick = function()
			local snapshot = ClientState.get()
			if not snapshot or not RebirthUI.ready(snapshot) then
				return
			end
			if UI.confirmTap(confirm) then
				Net.send("Rebirth")
			else
				refresh(snapshot)
			end
		end,
	})

	table.insert(Hud.badgeRefreshers, function(snapshot: Types.Snapshot)
		local item = Hud.menu.Rebirth
		if item then
			item.badge.Visible = RebirthUI.ready(snapshot)
		end
	end)
	ClientState.changed:connect(function(snapshot: Types.Snapshot)
		if Panels.isOpen("Rebirth") then
			refresh(snapshot)
		end
	end)
	Panels.onOpen("Rebirth", function()
		UI.disarm(confirm)
		local snapshot = ClientState.get()
		if snapshot then
			refresh(snapshot)
		end
	end)
end

function RebirthUI.start()
	-- the "tap again" prompt times out
	while true do
		task.wait(1)
		local snapshot = ClientState.get()
		if snapshot and Panels.isOpen("Rebirth") then
			refresh(snapshot)
		end
	end
end

return RebirthUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="95">
            <Properties>
              <string name="Name">RewardsUI</string>
              <string name="Source"><![CDATA[--!strict
-- Daily rewards: the 7-day streak calendar (day 7 is a big special prize)
-- plus the Dino Club daily gift.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Config = require(ReplicatedStorage.Shared.Config)
local Cycle = require(ReplicatedStorage.Shared.Util.Cycle)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Net = require(ReplicatedStorage.Shared.Net)
local Streak = require(ReplicatedStorage.Shared.Util.Streak)
local Types = require(ReplicatedStorage.Shared.Types)
local ClientState = require(script.Parent.ClientState)
local Panels = require(script.Parent.Parent.Lib.Panels)
local UI = require(script.Parent.Parent.Lib.UI)

local RewardsUI = {}

type Tile = { frame: Frame, stroke: UIStroke, check: Frame, today: UI.Chip, big: boolean }

local tiles: { Tile } = {}
local claimButton: UI.Button
local nextLabel: TextLabel
local clubButton: UI.Button

local GOLD_TILE = Color3.fromRGB(255, 236, 170)

local function refresh(snapshot: Types.Snapshot)
	local now = Clock.now()
	local today = Cycle.dayNumber(now)
	local canClaim, day = Streak.status(snapshot.streak, today)
	local claimedThrough = if canClaim then day - 1 else day
	for index, tile in tiles do
		local claimed = index <= claimedThrough
		local isToday = canClaim and index == day
		tile.check.Visible = claimed
		tile.today.root.Visible = isToday
		if isToday then
			tile.frame.BackgroundColor3 = UI.lighten(UI.Theme.green, 0.75)
			tile.stroke.Color = UI.Theme.green
			tile.stroke.Thickness = 4
		else
			tile.frame.BackgroundColor3 = if tile.big then GOLD_TILE else UI.Theme.card
			tile.stroke.Color = if tile.big then UI.Theme.gold else UI.Theme.cardEdge
			tile.stroke.Thickness = if tile.big then 3.5 else 2.5
		end
	end
	if canClaim then
		UI.setButton(claimButton, { text = `🎁 Claim Day {day}!`, enabled = true })
		nextLabel.Text = "Come back every day! Miss a day and the streak starts over."
	else
		UI.setButton(claimButton, { text = "Claimed today ✓", enabled = false })
		local secondsToMidnight = (today + 1) * 86400 - now
		nextLabel.Text = `Next reward in {Format.time(secondsToMidnight)}`
	end
	local configured = Config.SUBSCRIPTION_ID ~= ""
	clubButton.root.Visible = configured
	if snapshot.subscribed then
		local claimed = snapshot.clubClaimDay == today
		UI.setButton(clubButton, {
			text = if claimed then "👑 Club gift claimed ✓" else "👑 Claim Dino Club gift",
			enabled = not claimed,
		})
	else
		UI.setButton(clubButton, { text = "👑 Join Dino Club for a daily gift", enabled = true })
	end
end

local function buildTile(parent: Instance, day: number, reward: Streak.Reward): Tile
	local big = day == #Streak.REWARDS
	local stroke = UI.stroke(UI.Theme.cardEdge, 2.5) :: UIStroke
	local frame = UI.new("Frame", {
		Name = "Day" .. day,
		Size = UDim2.fromOffset(if big then 170 else 98, 176),
		BackgroundColor3 = if big then GOLD_TILE else UI.Theme.card,
		LayoutOrder = day,
		Parent = parent,
	}, { UI.corner(18), stroke }) :: Frame
	UI.body({
		text = if big then "Day 7 ⭐" else `Day {day}`,
		size = UDim2.new(1, -10, 0, 26),
		position = UDim2.fromOffset(5, 8),
		font = UI.Font,
		maxTextSize = 22,
		parent = frame,
	})
	UI.text({
		text = reward.emoji,
		size = UDim2.new(1, -10, 0, if big then 70 else 56),
		position = UDim2.new(0.5, 0, 0, 38),
		anchor = Vector2.new(0.5, 0),
		maxTextSize = if big then 64 else 48,
		noOutline = true,
		parent = frame,
	})
	UI.body({
		text = reward.label,
		size = UDim2.new(1, -12, 0, 40),
		position = UDim2.new(0, 6, 1, -50),
		color = UI.Theme.inkSoft,
		font = UI.HeavyFont,
		maxTextSize = 16,
		parent = frame,
	})
	local check = UI.new("Frame", {
		Name = "Claimed",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = UI.Theme.green,
		BackgroundTransparency = 0.35,
		Visible = false,
		ZIndex = 3,
		Parent = frame,
	}, { UI.corner(18) }) :: Frame
	UI.text({
		text = "✓",
		size = UDim2.fromScale(0.6, 0.5),
		position = UDim2.fromScale(0.5, 0.5),
		anchor = Vector2.new(0.5, 0.5),
		maxTextSize = 64,
		outline = UI.darken(UI.Theme.green, 0.5),
		outlineThickness = 3,
		zIndex = 4,
		parent = check,
	})
	local todayChip = UI.chip({
		name = "Today",
		text = "TODAY",
		size = UDim2.fromOffset(84, 26),
		position = UDim2.new(0.5, 0, 0, -12),
		anchor = Vector2.new(0.5, 0),
		color = UI.Theme.green,
		maxTextSize = 16,
		parent = frame,
	})
	todayChip.root.ZIndex = 5
	todayChip.root.Visible = false
	return { frame = frame, stroke = stroke, check = check, today = todayChip, big = big }
end

function RewardsUI.init()
	local _, content =
		Panels.window("Rewards", "🎁 Daily Rewards", Vector2.new(880, 470), UI.Theme.orange)
	local row = UI.new("Frame", {
		Name = "Days",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 196),
		Parent = content,
	}, {
		UI.list(
			Enum.FillDirection.Horizontal,
			10,
			Enum.HorizontalAlignment.Center,
			Enum.VerticalAlignment.Bottom
		),
	}) :: Frame
	for day, reward in Streak.REWARDS do
		table.insert(tiles, buildTile(row, day, reward))
	end
	claimButton = UI.button({
		name = "Claim",
		text = "",
		size = UDim2.fromOffset(340, 64),
		position = UDim2.new(0.5, 0, 0, 212),
		anchor = Vector2.new(0.5, 0),
		color = UI.Theme.green,
		maxTextSize = 32,
		parent = content,
		onClick = function()
			Net.send("ClaimStreak")
		end,
	})
	nextLabel = UI.body({
		text = "",
		size = UDim2.new(1, 0, 0, 26),
		position = UDim2.fromOffset(0, 288),
		color = UI.Theme.inkSoft,
		maxTextSize = 19,
		parent = content,
	})
	clubButton = UI.button({
		name = "Club",
		text = "",
		size = UDim2.fromOffset(440, 52),
		position = UDim2.new(0.5, 0, 0, 324),
		anchor = Vector2.new(0.5, 0),
		color = UI.Theme.purple,
		maxTextSize = 24,
		parent = content,
		onClick = function()
			local snapshot = ClientState.get()
			if snapshot and snapshot.subscribed then
				Net.send("ClaimClub")
			else
				Net.send("PromptPurchase", "subscription", "DinoClub")
			end
		end,
	})

	ClientState.changed:connect(function(snapshot: Types.Snapshot)
		if Panels.isOpen("Rewards") then
			refresh(snapshot)
		end
	end)
	Panels.onOpen("Rewards", function()
		local snapshot = ClientState.get()
		if snapshot then
			refresh(snapshot)
		end
	end)
end

function RewardsUI.start()
	while true do
		task.wait(1)
		local snapshot = ClientState.get()
		if snapshot and Panels.isOpen("Rewards") then
			refresh(snapshot)
		end
	end
end

return RewardsUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="96">
            <Properties>
              <string name="Name">SettingsUI</string>
              <string name="Source"><![CDATA[--!strict
-- Settings window: music and sound effect switches (saved with your profile)
-- and a box for promo codes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local Types = require(ReplicatedStorage.Shared.Types)
local ClientState = require(script.Parent.ClientState)
local Panels = require(script.Parent.Parent.Lib.Panels)
local UI = require(script.Parent.Parent.Lib.UI)

local SettingsUI = {}

type Switch = { set: (on: boolean) -> () }

local switches: { [string]: Switch } = {}
local codeBox: TextBox

-- Local values win until the server confirms (so switches feel instant).
local pending: { [string]: boolean } = {}

-- Fired when a setting changes locally (the audio controller listens).
SettingsUI.changed = nil :: ((key: string, on: boolean) -> ())?

function SettingsUI.get(key: string): boolean
	if pending[key] ~= nil then
		return pending[key]
	end
	local snapshot = ClientState.get()
	if snapshot then
		return (snapshot.settings :: any)[key] ~= false
	end
	return true
end

local function switch(
	parent: Instance,
	order: number,
	icon: string,
	title: string,
	key: string
): Switch
	local row = UI.card({
		name = key,
		size = UDim2.new(1, -8, 0, 74),
		order = order,
		radius = 18,
		parent = parent,
	})
	UI.text({
		text = icon,
		size = UDim2.fromOffset(48, 48),
		position = UDim2.new(0, 16, 0.5, 0),
		anchor = Vector2.new(0, 0.5),
		maxTextSize = 38,
		noOutline = true,
		parent = row,
	})
	UI.body({
		text = title,
		size = UDim2.new(1, -220, 0, 32),
		position = UDim2.new(0, 76, 0.5, 0),
		anchor = Vector2.new(0, 0.5),
		font = UI.Font,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 26,
		parent = row,
	})
	local track = UI.new("TextButton", {
		Name = "Switch",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromOffset(112, 48),
		Position = UDim2.new(1, -18, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = UI.Theme.green,
		Parent = row,
	}, { UI.round(), UI.stroke(UI.Theme.ink, 3), UI.shade(0.86) }) :: TextButton
	local stateLabel = UI.text({
		text = "ON",
		size = UDim2.fromOffset(52, 30),
		position = UDim2.new(0, 14, 0.5, 0),
		anchor = Vector2.new(0, 0.5),
		maxTextSize = 22,
		zIndex = 2,
		parent = track,
	})
	local knob = UI.new("Frame", {
		Name = "Knob",
		Size = UDim2.fromOffset(38, 38),
		Position = UDim2.new(1, -5, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = UI.Theme.white,
		ZIndex = 3,
		Parent = track,
	}, { UI.round(), UI.stroke(UI.Theme.ink, 2.5) }) :: Frame
	local function set(on: boolean)
		track.BackgroundColor3 = if on then UI.Theme.green else UI.Theme.grey
		stateLabel.Text = if on then "ON" else "OFF"
		stateLabel.Position = if on then UDim2.new(0, 14, 0.5, 0) else UDim2.new(1, -66, 0.5, 0)
		TweenService:Create(knob, UI.FAST, {
			Position = if on then UDim2.new(1, -5, 0.5, 0) else UDim2.new(0, 43, 0.5, 0),
		}):Play()
	end
	track.Activated:Connect(function()
		local on = not SettingsUI.get(key)
		pending[key] = on
		set(on)
		UI.onClick()
		Net.send("SetSetting", key, on)
		local changed = SettingsUI.changed
		if changed then
			changed(key, on)
		end
	end)
	return { set = set }
end

local function refresh(snapshot: Types.Snapshot)
	for key, s in switches do
		local saved = (snapshot.settings :: any)[key] ~= false
		if pending[key] == saved then
			pending[key] = nil
		end
		s.set(SettingsUI.get(key))
	end
end

function SettingsUI.init()
	local _, content =
		Panels.window("Settings", "⚙️ Settings", Vector2.new(680, 500), UI.Theme.teal)
	local list = UI.new("Frame", {
		Name = "List",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = content,
	}, { UI.list(Enum.FillDirection.Vertical, 12) }) :: Frame
	if #Config.MUSIC_TRACKS > 0 then
		switches.music = switch(list, 1, "🎵", "Music", "music")
	end
	switches.sfx = switch(list, 2, "🔊", "Sound effects", "sfx")

	UI.body({
		name = "CodesTitle",
		text = "🎟 Have a code? Type it here!",
		size = UDim2.new(1, -8, 0, 32),
		font = UI.Font,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 24,
		order = 3,
		parent = list,
	})
	local codeRow = UI.new("Frame", {
		Name = "Codes",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 0, 62),
		LayoutOrder = 4,
		Parent = list,
	}) :: Frame
	codeBox = UI.new("TextBox", {
		Name = "CodeBox",
		Text = "",
		PlaceholderText = "Type a code...",
		ClearTextOnFocus = false,
		Size = UDim2.new(1, -180, 0, 56),
		BackgroundColor3 = UI.Theme.white,
		TextColor3 = UI.Theme.ink,
		PlaceholderColor3 = UI.Theme.grey,
		Font = UI.Font,
		TextScaled = true,
		Parent = codeRow,
	}, {
		UI.corner(16),
		UI.stroke(UI.Theme.ink, 3),
		UI.padding(16, 10),
		UI.new("UITextSizeConstraint", { MaxTextSize = 28 }),
	}) :: TextBox
	UI.button({
		name = "Redeem",
		text = "Redeem",
		size = UDim2.fromOffset(160, 56),
		position = UDim2.new(1, 0, 0, 0),
		anchor = Vector2.new(1, 0),
		color = UI.Theme.green,
		parent = codeRow,
		onClick = function()
			if codeBox.Text ~= "" then
				Net.send("RedeemCode", codeBox.Text)
				codeBox.Text = ""
			end
		end,
	})
	UI.body({
		text = "New codes are shared in the game's group and updates. Codes work once each.",
		size = UDim2.new(1, -8, 0, 40),
		color = UI.Theme.inkSoft,
		maxTextSize = 17,
		order = 5,
		parent = list,
	})

	ClientState.changed:connect(function(snapshot: Types.Snapshot)
		if Panels.isOpen("Settings") then
			refresh(snapshot)
		end
	end)
	Panels.onOpen("Settings", function()
		local snapshot = ClientState.get()
		if snapshot then
			refresh(snapshot)
		end
	end)
end

return SettingsUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="97">
            <Properties>
              <string name="Name">ShopUI</string>
              <string name="Source"><![CDATA[--!strict
-- Egg Shop: buy eggs (limited stock that restocks every 5 minutes), view each
-- egg's real odds, and buy permanent nest upgrades with coins.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Config = require(ReplicatedStorage.Shared.Config)
local Cycle = require(ReplicatedStorage.Shared.Util.Cycle)
local DinoData = require(ReplicatedStorage.Shared.Data.DinoData)
local Economy = require(ReplicatedStorage.Shared.Util.Economy)
local EggData = require(ReplicatedStorage.Shared.Data.EggData)
local EggModel = require(ReplicatedStorage.Shared.Visual.EggModel)
local EggOdds = require(ReplicatedStorage.Shared.Util.EggOdds)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local MutationData = require(ReplicatedStorage.Shared.Data.MutationData)
local Net = require(ReplicatedStorage.Shared.Net)
local Odds = require(ReplicatedStorage.Shared.Util.Odds)
local Types = require(ReplicatedStorage.Shared.Types)
local ClientState = require(script.Parent.ClientState)
local Panels = require(script.Parent.Parent.Lib.Panels)
local UI = require(script.Parent.Parent.Lib.UI)

local ShopUI = {}

type Card = {
	egg: EggData.EggType,
	stock: TextLabel,
	buy: UI.Button,
}

type UpgradeRow = { info: TextLabel, bar: UI.Bar, button: UI.Button, level: number }

local cards: { Card } = {}
local restockChip: UI.Chip
local luckLabel: TextLabel
local eggsPage: GuiObject
local upgradesPage: GuiObject
local slotRow: UpgradeRow
local incubatorRow: UpgradeRow

local oddsTitle: TextLabel
local oddsList: ScrollingFrame
local oddsEgg: string? = nil

-- ===== Odds window =====

local function rarityColor(speciesId: string): Color3
	local species = DinoData.get(speciesId)
	if not species then
		return UI.Theme.grey
	end
	return UI.rgb(DinoData.rarityInfo(species.rarity).color)
end

local function oddsRow(order: number, left: string, tag: string?, bp: number, color: Color3)
	local row =
		UI.card({ size = UDim2.new(1, -14, 0, 46), order = order, radius = 12, parent = oddsList })
	UI.new("Frame", {
		Name = "Dot",
		Size = UDim2.fromOffset(22, 22),
		Position = UDim2.new(0, 12, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = color,
		Parent = row,
	}, { UI.round(), UI.stroke(UI.darken(color, 0.4), 2) })
	UI.body({
		text = left,
		size = UDim2.new(0.42, -44, 0, 26),
		position = UDim2.new(0, 44, 0.5, 0),
		anchor = Vector2.new(0, 0.5),
		font = UI.Font,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 22,
		parent = row,
	})
	if tag then
		UI.body({
			text = tag,
			size = UDim2.new(0.16, 0, 0, 20),
			position = UDim2.new(0.42, 0, 0.5, 0),
			anchor = Vector2.new(0, 0.5),
			color = UI.darken(color, 0.25),
			font = UI.HeavyFont,
			align = Enum.TextXAlignment.Left,
			maxTextSize = 17,
			parent = row,
		})
	end
	-- share bar: how big this slice is out of 100%
	local track = UI.new("Frame", {
		Name = "Share",
		Size = UDim2.new(0.24, 0, 0, 14),
		Position = UDim2.new(0.6, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = UI.Theme.track,
		Parent = row,
	}, { UI.round() }) :: Frame
	UI.new("Frame", {
		Size = UDim2.fromScale(math.clamp(bp / Odds.TOTAL_BP, 0.02, 1), 1),
		BackgroundColor3 = color,
		Parent = track,
	}, { UI.round() })
	UI.body({
		text = Odds.format(bp),
		size = UDim2.new(0.14, -12, 0, 26),
		position = UDim2.new(1, -12, 0.5, 0),
		anchor = Vector2.new(1, 0.5),
		font = UI.Font,
		align = Enum.TextXAlignment.Right,
		maxTextSize = 22,
		parent = row,
	})
end

local function sectionLabel(text: string, order: number)
	UI.body({
		text = text,
		size = UDim2.new(1, -14, 0, 30),
		font = UI.Font,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 22,
		order = order,
		parent = oddsList,
	})
end

local shownOdds = ""

-- Rebuilds the odds list, but only when something on it changed (snapshots
-- arrive every second; the odds only move with luck and storms).
local function renderOdds()
	local eggId = oddsEgg
	local egg = eggId and EggData.get(eggId)
	if not egg then
		return
	end
	local snapshot = ClientState.get()
	local luck = snapshot ~= nil and snapshot.boosts.luckUntil > Clock.now()
	local key = `{egg.id}|{luck}`
	for _, m in EggOdds.mutations(Clock.cycleNow()) do
		key ..= `|{m.key}:{m.bp}`
	end
	if key == shownOdds then
		return
	end
	shownOdds = key
	for _, child in oddsList:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	Panels.setTitle("Odds", `📊 {egg.name} Odds`)
	oddsTitle.Text = if luck
		then "🍀 Your Luck boost is included!"
		else "Every dino this egg can hatch:"

	local order = 0
	for _, chance in EggOdds.species(egg.id, luck) do
		order += 1
		local species = DinoData.get(chance.species)
		oddsRow(
			order,
			if species then species.name else chance.species,
			if species then species.rarity else nil,
			chance.bp,
			rarityColor(chance.species)
		)
	end

	order += 1
	sectionLabel("✨ Mutation chance for each hatch right now:", order)
	local mutationTotal = 0
	for _, m in EggOdds.mutations(Clock.cycleNow()) do
		order += 1
		mutationTotal += m.bp
		local info = MutationData.get(m.key)
		local label = if info then `{info.emoji} {info.name}` else m.key
		local tag = if info then `x{info.multiplier} coins` else nil
		oddsRow(order, label, tag, m.bp, if info then UI.rgb(info.color) else UI.Theme.grey)
	end
	order += 1
	oddsRow(order, "No mutation", nil, Odds.TOTAL_BP - mutationTotal, UI.Theme.grey)
	order += 1
	UI.body({
		text = "These are the exact odds and they add up to 100%. Storms raise mutation chances!",
		size = UDim2.new(1, -14, 0, 30),
		color = UI.Theme.inkSoft,
		maxTextSize = 16,
		order = order,
		parent = oddsList,
	})
end

function ShopUI.showOdds(eggId: string)
	oddsEgg = eggId
	renderOdds()
	Panels.open("Odds")
end

-- ===== Shop window =====

local function buildCard(parent: Instance, egg: EggData.EggType): Card
	local eggColor = UI.rgb(egg.colors.main)
	local card = UI.card({
		name = egg.id,
		size = UDim2.fromOffset(188, 318),
		order = egg.order,
		radius = 20,
		parent = parent,
	})
	local showcase = UI.new("Frame", {
		Name = "Showcase",
		Size = UDim2.new(1, -16, 0, 120),
		Position = UDim2.fromOffset(8, 8),
		BackgroundColor3 = UI.lighten(eggColor, 0.55),
		Parent = card,
	}, { UI.corner(14), UI.shade(0.9) }) :: Frame
	local viewport = UI.viewport(
		EggModel.build(EggModel.lookForShopEgg(egg.id), 3, true),
		UDim2.fromOffset(118, 118),
		showcase,
		20
	)
	viewport.AnchorPoint = Vector2.new(0.5, 0.5)
	viewport.Position = UDim2.fromScale(0.5, 0.52)
	local stock = UI.chip({
		name = "Stock",
		text = "",
		size = UDim2.fromOffset(84, 26),
		position = UDim2.new(1, -6, 0, 6),
		anchor = Vector2.new(1, 0),
		color = UI.Theme.hud,
		maxTextSize = 15,
		parent = showcase,
	})
	UI.body({
		text = egg.name,
		size = UDim2.new(1, -16, 0, 30),
		position = UDim2.fromOffset(8, 134),
		font = UI.Font,
		maxTextSize = 24,
		parent = card,
	})
	UI.price({
		amount = Format.number(egg.price),
		size = UDim2.new(1, -16, 0, 26),
		position = UDim2.fromOffset(8, 166),
		parent = card,
	})
	UI.body({
		text = "⏱ Hatches in " .. Format.duration(egg.hatchSeconds),
		size = UDim2.new(1, -16, 0, 20),
		position = UDim2.fromOffset(8, 196),
		color = UI.Theme.inkSoft,
		maxTextSize = 16,
		parent = card,
	})
	local buy = UI.button({
		name = "Buy",
		text = "Buy",
		size = UDim2.new(1, -20, 0, 48),
		position = UDim2.fromOffset(10, 222),
		color = UI.Theme.green,
		parent = card,
		onClick = function()
			Net.send("BuyEgg", egg.id)
		end,
	})
	UI.button({
		name = "Odds",
		text = "📊 Odds",
		size = UDim2.new(1, -60, 0, 32),
		position = UDim2.new(0.5, 0, 0, 278),
		anchor = Vector2.new(0.5, 0),
		color = UI.Theme.blue,
		depth = 4,
		maxTextSize = 18,
		parent = card,
		onClick = function()
			ShopUI.showOdds(egg.id)
		end,
	})
	return { egg = egg, stock = stock.label, buy = buy }
end

local function upgradeCard(
	parent: Instance,
	order: number,
	icon: string,
	title: string,
	onClick: () -> ()
): UpgradeRow
	local card =
		UI.card({ size = UDim2.new(1, -8, 0, 128), order = order, radius = 20, parent = parent })
	local badge = UI.new("Frame", {
		Size = UDim2.fromOffset(92, 92),
		Position = UDim2.new(0, 18, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = UI.lighten(UI.Theme.blue, 0.6),
		Parent = card,
	}, { UI.round(), UI.stroke(UI.Theme.blue, 3) }) :: Frame
	UI.text({
		text = icon,
		size = UDim2.fromScale(0.7, 0.7),
		position = UDim2.fromScale(0.5, 0.5),
		anchor = Vector2.new(0.5, 0.5),
		maxTextSize = 56,
		noOutline = true,
		parent = badge,
	})
	UI.body({
		text = title,
		size = UDim2.new(0.5, 0, 0, 36),
		position = UDim2.fromOffset(128, 14),
		font = UI.Font,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 30,
		parent = card,
	})
	local info = UI.body({
		text = "",
		size = UDim2.new(0.5, 0, 0, 24),
		position = UDim2.fromOffset(128, 52),
		color = UI.Theme.inkSoft,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 19,
		parent = card,
	})
	local bar = UI.bar({
		size = UDim2.new(0.42, 0, 0, 22),
		position = UDim2.fromOffset(128, 86),
		color = UI.Theme.blue,
		parent = card,
	})
	local button = UI.button({
		name = "Buy",
		text = "",
		size = UDim2.fromOffset(200, 62),
		position = UDim2.new(1, -20, 0.5, -3),
		anchor = Vector2.new(1, 0.5),
		color = UI.Theme.green,
		parent = card,
		onClick = onClick,
	})
	return { info = info, bar = bar, button = button, level = 0 }
end

local function refreshUpgrade(row: UpgradeRow, costs: { number }, level: number, coins: number)
	row.level = level -- the level a tap buys (the price shown)
	local cost = Economy.nextUpgradeCost(costs, level)
	UI.setBar(row.bar, level / #costs, `Level {level} / {#costs}`)
	if cost then
		UI.setButton(row.button, { text = "💰 " .. Format.number(cost), enabled = coins >= cost })
	else
		UI.setButton(row.button, { text = "MAX ✓", enabled = false })
	end
end

local function refresh()
	local snapshot = ClientState.get()
	local restock = Cycle.restock(Clock.cycleNow())
	restockChip.label.Text = "🔄 New eggs in " .. Format.time(restock.secondsLeft)
	if not snapshot then
		return
	end
	local now = Clock.now()
	luckLabel.Text = if snapshot.boosts.luckUntil > now
		then "🍀 Luck is on: rare dinos are 2x as likely!"
		else ""
	local bought = if snapshot.shopBought.restock == restock.index
		then snapshot.shopBought.bought
		else {}
	for _, card in cards do
		local left = (restock.stock[card.egg.id] or 0) - (bought[card.egg.id] or 0)
		card.stock.Text = if left > 0 then `x{left} left` else "Sold out"
		local affordable = snapshot.coins >= card.egg.price
		UI.setButton(card.buy, {
			text = if left <= 0 then "Sold out" elseif affordable then "Buy" else "Need coins",
			enabled = left > 0 and affordable,
		})
	end
	slotRow.info.Text = `Room for {snapshot.maxSlots} dinos ({#snapshot.dinos} living here)`
	refreshUpgrade(slotRow, Config.SLOT_UPGRADE_COSTS, snapshot.upgrades.slots, snapshot.coins)
	incubatorRow.info.Text = `You have {snapshot.maxIncubators} incubators`
	refreshUpgrade(
		incubatorRow,
		Config.INCUBATOR_UPGRADE_COSTS,
		snapshot.upgrades.incubators,
		snapshot.coins
	)
end

local function updateShopBillboard()
	local map = Workspace:FindFirstChild("Map")
	local hub = map and map:FindFirstChild("Hub")
	local promptPart = hub and hub:FindFirstChild("ShopPrompt")
	local gui = promptPart and promptPart:FindFirstChild("ShopBillboard")
	local label = gui and gui:FindFirstChild("Restock")
	if label and label:IsA("TextLabel") then
		label.Text = "New eggs in " .. Format.time(Cycle.restock(Clock.cycleNow()).secondsLeft)
	end
end

function ShopUI.open()
	Panels.open("Shop")
end

function ShopUI.init()
	local _, content = Panels.window("Shop", "🥚 Egg Shop", Vector2.new(880, 500), UI.Theme.green)

	local selectTab = Panels.tabs(content, {
		{ name = "Eggs", text = "🥚 Eggs", color = UI.Theme.orange },
		{ name = "Upgrades", text = "🏗 Upgrades", color = UI.Theme.blue },
	}, function(name: string)
		eggsPage.Visible = name == "Eggs"
		upgradesPage.Visible = name == "Upgrades"
	end)
	restockChip = UI.chip({
		name = "Restock",
		text = "",
		size = UDim2.fromOffset(250, 38),
		position = UDim2.new(1, 0, 0, 2),
		anchor = Vector2.new(1, 0),
		color = UI.Theme.purple,
		maxTextSize = 20,
		parent = content,
	})

	eggsPage = UI.new("ScrollingFrame", {
		Name = "Eggs",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 58),
		Size = UDim2.new(1, 0, 1, -86),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 6,
		BorderSizePixel = 0,
		Parent = content,
	}, {
		UI.list(
			Enum.FillDirection.Horizontal,
			14,
			Enum.HorizontalAlignment.Center,
			Enum.VerticalAlignment.Center
		),
	}) :: ScrollingFrame
	for _, egg in EggData.LIST do
		table.insert(cards, buildCard(eggsPage, egg))
	end
	luckLabel = UI.body({
		text = "",
		size = UDim2.new(1, 0, 0, 24),
		position = UDim2.new(0, 0, 1, -24),
		color = UI.Theme.good,
		font = UI.Font,
		maxTextSize = 20,
		parent = content,
	})

	upgradesPage = UI.new("Frame", {
		Name = "Upgrades",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 64),
		Size = UDim2.new(1, 0, 1, -64),
		Visible = false,
		Parent = content,
	}, { UI.list(Enum.FillDirection.Vertical, 16) }) :: Frame
	slotRow = upgradeCard(upgradesPage, 1, "🦖", "+1 Dino Slot", function()
		Net.send("BuyUpgrade", "slots", slotRow.level)
	end)
	incubatorRow = upgradeCard(upgradesPage, 2, "🥚", "+1 Incubator", function()
		Net.send("BuyUpgrade", "incubators", incubatorRow.level)
	end)
	selectTab("Eggs")

	-- Odds window
	local _, oddsContent =
		Panels.window("Odds", "📊 Egg Odds", Vector2.new(680, 500), UI.Theme.blue)
	UI.button({
		name = "Back",
		text = "← Back",
		size = UDim2.fromOffset(120, 42),
		color = UI.Theme.orange,
		depth = 4,
		maxTextSize = 22,
		parent = oddsContent,
		onClick = function()
			Panels.open("Shop")
		end,
	})
	oddsTitle = UI.body({
		text = "",
		size = UDim2.new(1, -140, 0, 36),
		position = UDim2.fromOffset(136, 3),
		font = UI.Font,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 22,
		parent = oddsContent,
	})
	oddsList = UI.new("ScrollingFrame", {
		Name = "List",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 56),
		Size = UDim2.new(1, 0, 1, -56),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		BorderSizePixel = 0,
		Parent = oddsContent,
	}, { UI.list(Enum.FillDirection.Vertical, 8), UI.padding(2, 4) }) :: ScrollingFrame

	Panels.onOpen("Shop", refresh)
	ClientState.changed:connect(function(_: Types.Snapshot)
		if Panels.isOpen("Shop") then
			refresh()
		elseif Panels.isOpen("Odds") then
			renderOdds()
		end
	end)
end

function ShopUI.start()
	while true do
		task.wait(0.5)
		updateShopBillboard()
		if Panels.isOpen("Shop") then
			refresh()
		end
	end
end

return ShopUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">StoreUI</string>
              <string name="Source"><![CDATA[--!strict
-- Robux store: game passes, boosts, coin packs, the one-time Starter Pack and
-- the Dino Club subscription. Prices come live from Roblox. Items that feed
-- random egg results are hidden for players PolicyService restricts.

local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local StoreData = require(ReplicatedStorage.Shared.Data.StoreData)
local Types = require(ReplicatedStorage.Shared.Types)
local ClientState = require(script.Parent.ClientState)
local Toasts = require(script.Parent.Toasts)
local Panels = require(script.Parent.Parent.Lib.Panels)
local UI = require(script.Parent.Parent.Lib.UI)

local StoreUI = {}

type Card = {
	item: StoreData.Item,
	frame: Frame,
	button: UI.Button,
}

type Section = { frame: Frame, cards: { Card } }

local list: ScrollingFrame
local cards: { Card } = {}
local sections: { Section } = {}
local starterCard: Card
local hero: Frame
local clubCard: Frame
local clubButton: UI.Button
local prices: { [string]: number } = {}

local CARD_HEIGHT = 104
local GRID_GAP = 12

local function idFor(item: StoreData.Item): number
	if item.kind == "pass" then
		return (Config.GAME_PASS_IDS :: { [string]: number })[item.key] or 0
	end
	return (Config.PRODUCT_IDS :: { [string]: number })[item.key] or 0
end

local function fetchPrice(item: StoreData.Item)
	local id = idFor(item)
	if id == 0 or prices[item.key] then
		return
	end
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfoAsync(
				id,
				if item.kind == "pass" then Enum.InfoType.GamePass else Enum.InfoType.Product
			)
		end)
		if ok and type(info) == "table" and type(info.PriceInRobux) == "number" then
			prices[item.key] = info.PriceInRobux
			StoreUI.refresh()
		end
	end)
end

local function buy(item: StoreData.Item)
	if idFor(item) == 0 then
		Toasts.show(`🛠 Paste the {item.key} ID into Config to sell this.`, "info")
		return
	end
	Net.send("PromptPurchase", item.kind, item.key)
end

local function iconBubble(parent: Instance, emoji: string, color: Color3, size: number): Frame
	local bubble = UI.new("Frame", {
		Name = "Icon",
		Size = UDim2.fromOffset(size, size),
		Position = UDim2.new(0, 12, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = UI.lighten(color, 0.55),
		Parent = parent,
	}, { UI.round(), UI.stroke(color, 3) }) :: Frame
	UI.text({
		text = emoji,
		size = UDim2.fromScale(0.68, 0.68),
		position = UDim2.fromScale(0.5, 0.5),
		anchor = Vector2.new(0.5, 0.5),
		maxTextSize = 48,
		noOutline = true,
		parent = bubble,
	})
	return bubble
end

local function buildCard(item: StoreData.Item, parent: Instance, order: number, color: Color3): Card
	local frame = UI.card({
		name = item.key,
		size = UDim2.fromScale(1, 1),
		order = order,
		radius = 18,
		parent = parent,
	})
	iconBubble(frame, item.emoji, color, 76)
	UI.body({
		text = item.name,
		size = UDim2.new(1, -250, 0, 30),
		position = UDim2.fromOffset(100, 12),
		font = UI.Font,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 24,
		parent = frame,
	})
	UI.body({
		text = item.description,
		size = UDim2.new(1, -250, 0, 46),
		position = UDim2.fromOffset(100, 44),
		color = UI.Theme.inkSoft,
		align = Enum.TextXAlignment.Left,
		valign = Enum.TextYAlignment.Top,
		maxTextSize = 17,
		parent = frame,
	})
	local button = UI.button({
		name = "Buy",
		text = "",
		size = UDim2.fromOffset(124, 54),
		position = UDim2.new(1, -14, 0.5, -2),
		anchor = Vector2.new(1, 0.5),
		color = UI.Theme.green,
		maxTextSize = 24,
		parent = frame,
		onClick = function()
			buy(item)
		end,
	})
	return { item = item, frame = frame, button = button }
end

local function sectionTitle(text: string, order: number)
	UI.body({
		name = "Section",
		text = text,
		size = UDim2.new(1, -16, 0, 34),
		font = UI.Font,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 26,
		order = order,
		parent = list,
	})
end

local function gridSection(items: { StoreData.Item }, order: number, color: Color3): Section
	local frame = UI.new("Frame", {
		Name = "Grid",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -16, 0, 0),
		LayoutOrder = order,
		Parent = list,
	}, {
		UI.new("UIGridLayout", {
			CellSize = UDim2.new(0.5, -GRID_GAP / 2, 0, CARD_HEIGHT),
			CellPadding = UDim2.fromOffset(GRID_GAP, GRID_GAP),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	}) :: Frame
	local section: Section = { frame = frame, cards = {} }
	for i, item in items do
		local card = buildCard(item, frame, i, color)
		table.insert(section.cards, card)
		table.insert(cards, card)
	end
	table.insert(sections, section)
	return section
end

-- Grids don't size themselves; fit each one to its visible cards.
local function resizeSections()
	for _, section in sections do
		local visible = 0
		for _, card in section.cards do
			if card.frame.Visible then
				visible += 1
			end
		end
		local rows = math.ceil(visible / 2)
		section.frame.Size =
			UDim2.new(1, -16, 0, rows * CARD_HEIGHT + math.max(rows - 1, 0) * GRID_GAP)
		section.frame.Visible = visible > 0
	end
end

local function priceText(item: StoreData.Item): string
	local price = prices[item.key] or (Config.SUGGESTED_PRICES :: { [string]: number })[item.key]
	return if price then `R$ {price}` else "Buy"
end

function StoreUI.refresh()
	local snapshot = ClientState.get()
	if not snapshot then
		return
	end
	for _, card in cards do
		local item = card.item
		local id = idFor(item)
		local hiddenByPolicy = item.feedsRandom == true and snapshot.restricted
		local hiddenStarter = item.key == "StarterPack" and snapshot.starterPackBought
		local notSetUp = id == 0 and not snapshot.isDev
		card.frame.Visible = not hiddenByPolicy and not hiddenStarter and not notSetUp
		if item.kind == "pass" and snapshot.passes[item.key] then
			UI.setButton(card.button, { text = "Owned ✓", enabled = false })
		else
			UI.setButton(card.button, { text = priceText(item), enabled = true })
		end
	end
	resizeSections()
	hero.Visible = starterCard.frame.Visible
	local clubConfigured = Config.SUBSCRIPTION_ID ~= ""
	clubCard.Visible = clubConfigured or snapshot.isDev
	if snapshot.subscribed then
		UI.setButton(clubButton, { text = "Member ✓", enabled = false })
	else
		UI.setButton(clubButton, { text = "Join", enabled = true })
	end
end

function StoreUI.init()
	local _, content = Panels.window("Store", "💎 Store", Vector2.new(880, 500), UI.Theme.blue)
	list = UI.new("ScrollingFrame", {
		Name = "List",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		BorderSizePixel = 0,
		Parent = content,
	}, {
		UI.list(Enum.FillDirection.Vertical, 10),
		UI.padding(2, 16), -- room for the hero card's "BEST VALUE" ribbon
	}) :: ScrollingFrame

	-- Starter Pack hero banner
	hero = UI.new("Frame", {
		Name = "StarterHolder",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -16, 0, 112),
		LayoutOrder = 1,
		Parent = list,
	}) :: Frame
	starterCard = buildCard(StoreData.STARTER_PACK, hero, 1, UI.Theme.orange)
	starterCard.frame.BackgroundColor3 = Color3.fromRGB(255, 240, 196)
	local heroStroke = starterCard.frame:FindFirstChildOfClass("UIStroke")
	if heroStroke then
		heroStroke.Color = UI.Theme.orange
		heroStroke.Thickness = 4
	end
	UI.setButton(starterCard.button, { color = UI.Theme.orange })
	local ribbon = UI.chip({
		name = "Ribbon",
		text = "⭐ BEST VALUE",
		size = UDim2.fromOffset(150, 30),
		position = UDim2.new(1, -150, 0, -12),
		color = UI.Theme.red,
		maxTextSize = 17,
		parent = starterCard.frame,
	})
	ribbon.root.ZIndex = 3
	table.insert(cards, starterCard)

	sectionTitle("⭐ Game Passes (forever)", 2)
	gridSection(StoreData.PASSES, 3, UI.Theme.blue)

	sectionTitle("👑 Dino Club (monthly)", 4)
	clubCard = UI.card({
		name = "Club",
		size = UDim2.new(1, -16, 0, 96),
		order = 5,
		radius = 18,
		color = Color3.fromRGB(240, 230, 255),
		edge = UI.Theme.purple,
		parent = list,
	})
	iconBubble(clubCard, "👑", UI.Theme.purple, 72)
	UI.body({
		text = "Dino Club",
		size = UDim2.new(1, -260, 0, 30),
		position = UDim2.fromOffset(98, 12),
		font = UI.Font,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 24,
		parent = clubCard,
	})
	UI.body({
		text = "+10% coins on everything and a free coin gift every day.",
		size = UDim2.new(1, -260, 0, 40),
		position = UDim2.fromOffset(98, 44),
		color = UI.Theme.inkSoft,
		align = Enum.TextXAlignment.Left,
		valign = Enum.TextYAlignment.Top,
		maxTextSize = 17,
		parent = clubCard,
	})
	clubButton = UI.button({
		name = "Join",
		text = "Join",
		size = UDim2.fromOffset(124, 54),
		position = UDim2.new(1, -14, 0.5, -2),
		anchor = Vector2.new(1, 0.5),
		color = UI.Theme.purple,
		maxTextSize = 24,
		parent = clubCard,
		onClick = function()
			if Config.SUBSCRIPTION_ID == "" then
				Toasts.show("🛠 Set SUBSCRIPTION_ID in Config to sell the Dino Club.", "info")
				return
			end
			Net.send("PromptPurchase", "subscription", "DinoClub")
		end,
	})

	sectionTitle("⚡ Boosts & Coins", 6)
	gridSection(StoreData.PRODUCTS, 7, UI.Theme.orange)

	UI.body({
		text = "Purchases help us make the game. Always ask a grown-up before buying!",
		size = UDim2.new(1, -16, 0, 26),
		color = UI.Theme.inkSoft,
		maxTextSize = 16,
		order = 8,
		parent = list,
	})

	Panels.onOpen("Store", function()
		for _, card in cards do
			fetchPrice(card.item)
		end
		StoreUI.refresh()
	end)
	ClientState.changed:connect(function(_: Types.Snapshot)
		if Panels.isOpen("Store") then
			StoreUI.refresh()
		end
	end)
end

function StoreUI.open()
	Panels.open("Store")
end

return StoreUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="99">
            <Properties>
              <string name="Name">Toasts</string>
              <string name="Source"><![CDATA[--!strict
-- Little message pop-ups in the top-right corner. Server messages arrive via
-- the "Notify" remote; other controllers can call Toasts.show directly.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Net = require(ReplicatedStorage.Shared.Net)
local UI = require(script.Parent.Parent.Lib.UI)

local Toasts = {}

local MAX_TOASTS = 4
local LIFETIME = 4.5

local COLORS: { [string]: Color3 } = {
	info = Color3.fromRGB(70, 62, 102),
	good = Color3.fromRGB(56, 178, 92),
	bad = Color3.fromRGB(230, 76, 82),
	rare = Color3.fromRGB(150, 92, 240),
	event = Color3.fromRGB(245, 140, 40),
}

local container: Frame? = nil
local order = 0
-- Live toasts by name (names are unique; instance identity isn't reliable in
-- every runtime, e.g. the Lune test harness).
local live: { [string]: boolean } = {}

-- Hook for a sound per toast style (set by the audio controller).
Toasts.onShow = function(_style: string) end

function Toasts.show(text: string, style: string?)
	local holder = container
	if not holder then
		return
	end
	order += 1
	local color = COLORS[style or "info"] or COLORS.info
	local id = "Toast" .. order
	local slot = UI.new("Frame", {
		Name = id,
		Size = UDim2.fromOffset(340, 56),
		BackgroundTransparency = 1,
		LayoutOrder = -order,
		Parent = holder,
	}) :: Frame
	local card = UI.new("Frame", {
		Name = "Card",
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(60, 0),
		BackgroundColor3 = color,
		Parent = slot,
	}, { UI.corner(18), UI.stroke(UI.darken(color, 0.45), 3), UI.shade(0.86) }) :: Frame
	local label = UI.text({
		text = text,
		size = UDim2.new(1, -24, 1, -10),
		position = UDim2.fromOffset(12, 5),
		align = Enum.TextXAlignment.Left,
		maxTextSize = 21,
		outline = UI.darken(color, 0.6),
		parent = card,
	})
	live[id] = true
	TweenService:Create(card, UI.BOUNCY, { Position = UDim2.new() }):Play()
	Toasts.onShow(style or "info")

	local toasts = {}
	for _, child in holder:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i = MAX_TOASTS + 1, #toasts do
		live[toasts[i].Name] = nil
		toasts[i]:Destroy()
	end

	task.delay(LIFETIME, function()
		if live[id] then
			TweenService:Create(
				card,
				UI.SMOOTH,
				{ BackgroundTransparency = 1, Position = UDim2.fromOffset(40, 0) }
			):Play()
			TweenService:Create(label, UI.SMOOTH, { TextTransparency = 1 }):Play()
			for _, stroke in card:GetDescendants() do
				if stroke:IsA("UIStroke") then
					TweenService:Create(stroke, UI.SMOOTH, { Transparency = 1 }):Play()
				end
			end
			task.wait(0.4)
			if live[id] then
				live[id] = nil
				slot:Destroy()
			end
		end
	end)
end

function Toasts.init()
	local screen = UI.screen("Toasts", 20)
	container = UI.new("Frame", {
		Name = "Container",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 12),
		Size = UDim2.fromOffset(340, 300),
		Parent = screen,
	}, {
		UI.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right),
	})
	Net.listen("Notify", function(text: string, style: string?)
		if typeof(text) == "string" then
			Toasts.show(text, style)
		end
	end)
end

return Toasts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="100">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[--!strict
-- First-session tutorial on the client: a hint banner and a glowing beam from
-- the player to the next thing to do. The server decides the step (and logs
-- the onboarding funnel).

local ExperienceNotificationService = game:GetService("ExperienceNotificationService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Net = require(ReplicatedStorage.Shared.Net)
local TutorialData = require(ReplicatedStorage.Shared.Data.TutorialData)
local Types = require(ReplicatedStorage.Shared.Types)
local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)
local UI = require(script.Parent.Parent.Lib.UI)

local Tutorial = {}

local banner: Frame
local bannerText: TextLabel
local stepChip: UI.Chip
local gotIt: UI.Button
local currentStep = -1

local targetPart: Part
local targetAttachment: Attachment
local beam: Beam
local playerAttachment: Attachment? = nil

local function myPlot(): Model?
	return ClientState.myPlot()
end

local function eggTarget(title: string): BasePart?
	local plot = myPlot()
	local eggs = plot and plot:FindFirstChild("Eggs")
	if not eggs then
		return nil
	end
	local fallback: BasePart? = nil
	for _, egg in eggs:GetChildren() do
		if egg:IsA("Model") and egg.PrimaryPart then
			if egg:GetAttribute("Title") == title then
				return egg.PrimaryPart
			end
			fallback = fallback or egg.PrimaryPart
		end
	end
	return fallback
end

local function targetPosition(step: number): Vector3?
	local info = TutorialData.STEPS[step]
	if not info then
		return nil
	end
	if info.target == "Incubator" then
		local part = eggTarget(if step == 1 then "Starter Egg" else "Gift Egg")
		return part and part.CFrame.Position
	elseif info.target == "Pad" then
		local plot = myPlot()
		local pad = plot and plot:FindFirstChild("CoinPad")
		return if pad and pad:IsA("BasePart") then pad.CFrame.Position else nil
	elseif info.target == "Shop" then
		local map = Workspace:FindFirstChild("Map")
		local hub = map and map:FindFirstChild("Hub")
		local shop = hub and hub:FindFirstChild("ShopPrompt")
		return if shop and shop:IsA("BasePart") then shop.CFrame.Position else nil
	end
	return nil
end

local function attachToCharacter()
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local existing = root:FindFirstChild("TutorialAttachment")
	if existing and existing:IsA("Attachment") then
		playerAttachment = existing
	else
		local attachment = Instance.new("Attachment")
		attachment.Name = "TutorialAttachment"
		attachment.Parent = root
		playerAttachment = attachment
	end
	beam.Attachment0 = playerAttachment
end

-- ===== Steps =====

local function setStep(step: number)
	if step == currentStep then
		return
	end
	currentStep = step
	local info = TutorialData.STEPS[step]
	banner.Visible = info ~= nil
	gotIt.root.Visible = step == #TutorialData.STEPS
	if info then
		bannerText.Text = info.text
		stepChip.label.Text = `STEP {step} / {#TutorialData.STEPS}`
		UI.pop(banner)
	end
end

local function finish()
	Net.send("TutorialAction", "Finish")
	-- Let players opt in to "your dino is grown!" style notifications.
	task.spawn(function()
		local ok, canPrompt = pcall(function()
			return ExperienceNotificationService:CanPromptOptInAsync()
		end)
		if ok and canPrompt then
			pcall(function()
				ExperienceNotificationService:PromptOptIn()
			end)
		end
	end)
end

function Tutorial.init()
	local screen = UI.screen("Tutorial", 5)
	banner = UI.new("Frame", {
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 170),
		Size = UDim2.fromOffset(620, 84),
		BackgroundColor3 = Color3.fromRGB(255, 226, 102),
		Visible = false,
		Parent = screen,
	}, { UI.corner(22), UI.stroke(UI.Theme.ink, 4), UI.shade(0.9) }) :: Frame
	bannerText = UI.body({
		text = "",
		size = UDim2.new(1, -40, 1, -22),
		position = UDim2.fromOffset(20, 14),
		font = UI.Font,
		maxTextSize = 28,
		parent = banner,
	})
	stepChip = UI.chip({
		name = "Step",
		text = "",
		size = UDim2.fromOffset(130, 30),
		position = UDim2.new(0, 18, 0, -16),
		color = UI.Theme.purple,
		maxTextSize = 17,
		parent = banner,
	})
	gotIt = UI.button({
		name = "GotIt",
		text = "Got it! 👍",
		size = UDim2.fromOffset(190, 56),
		position = UDim2.new(0.5, 0, 1, 12),
		anchor = Vector2.new(0.5, 0),
		color = UI.Theme.green,
		parent = banner,
		onClick = finish,
	})
	gotIt.root.Visible = false

	targetPart = Instance.new("Part")
	targetPart.Name = "TutorialTarget"
	targetPart.Anchored = true
	targetPart.CanCollide = false
	targetPart.CanQuery = false
	targetPart.CanTouch = false
	targetPart.Transparency = 1
	targetPart.Size = Vector3.one
	targetPart.Parent = Workspace.CurrentCamera or Workspace
	targetAttachment = Instance.new("Attachment")
	targetAttachment.Parent = targetPart
	local arrow = Instance.new("BillboardGui")
	arrow.Size = UDim2.fromOffset(80, 80)
	arrow.StudsOffsetWorldSpace = Vector3.new(0, 5, 0)
	arrow.AlwaysOnTop = true
	arrow.LightInfluence = 0
	UI.text({
		text = "⬇",
		size = UDim2.fromScale(1, 1),
		color = UI.Theme.gold,
		maxTextSize = 70,
		outlineThickness = 4,
		parent = arrow,
	})
	arrow.Parent = targetPart
	TweenService:Create(
		arrow,
		TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ StudsOffsetWorldSpace = Vector3.new(0, 7, 0) }
	):Play()

	beam = Instance.new("Beam")
	beam.Attachment1 = targetAttachment
	beam.Color = ColorSequence.new(UI.Theme.gold)
	beam.LightEmission = 1
	beam.FaceCamera = true
	beam.Width0 = 0.5
	beam.Width1 = 0.5
	beam.Segments = 12
	beam.CurveSize0 = 6
	beam.CurveSize1 = -4
	beam.Transparency = NumberSequence.new(0.2)
	beam.Enabled = false
	beam.Parent = targetPart

	ClientState.changed:connect(function(snapshot: Types.Snapshot)
		setStep(snapshot.tutorial)
	end)
	Players.LocalPlayer.CharacterAdded:Connect(function()
		task.wait(1)
		attachToCharacter()
	end)
end

function Tutorial.start()
	attachToCharacter()
	local pulse = 0
	while true do
		task.wait(0.2)
		local position = if currentStep >= 1 and currentStep <= #TutorialData.STEPS
			then targetPosition(currentStep)
			else nil
		if position then
			targetPart.CFrame = CFrame.new(position)
			beam.Enabled = playerAttachment ~= nil and playerAttachment.Parent ~= nil
			local arrow = targetPart:FindFirstChildOfClass("BillboardGui")
			if arrow then
				arrow.Enabled = true
			end
		else
			beam.Enabled = false
			local arrow = targetPart:FindFirstChildOfClass("BillboardGui")
			if arrow then
				arrow.Enabled = false
			end
		end
		pulse += 1
		if currentStep == #TutorialData.STEPS and pulse % 8 == 0 then
			local lock = Hud.buttons.Lock
			if lock then
				UI.pop(lock.root)
			end
		end
	end
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="101">
            <Properties>
              <string name="Name">WorldFx</string>
              <string name="Source"><![CDATA[--!strict
-- Client-only visuals: dinos wandering around their home spot, rainbow
-- mutation colors, egg timers and wobbles, day/night lighting, and storm
-- weather. None of this affects gameplay; it only makes the world feel alive.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Cycle = require(ReplicatedStorage.Shared.Util.Cycle)
local DinoModel = require(ReplicatedStorage.Shared.Visual.DinoModel)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Tags = require(ReplicatedStorage.Shared.Tags)

local WorldFx = {}

local EGG_TAG = "IncubatorEgg"
local WANDER_RADIUS = 7
local WALK_DISTANCE = 16

-- ===== Dino wandering =====
-- Each dino roams its whole pen: it turns toward a random nearby spot inside
-- the fence, hops along with a little waddle, then rests and breathes before
-- the next walk.
-- Simulated per frame on the client (pure decoration), skipped when far away.

type Walker = {
	root: BasePart,
	home: Vector3,
	position: Vector3,
	facing: Vector3,
	target: Vector3?,
	waitUntil: number,
	phase: number,
	hop: number,
	speed: number,
	rng: Random,
	floor: BasePart?, -- the pen's floor; walks stay inside it
	margin: number, -- distance kept from the fence
	homeCheck: number, -- frames until we look for a new home spot
}

local walkers: { [Model]: Walker } = {}
local FAR = 150 -- dinos further from the camera than this stand still
local NEAR = 70 -- idle dinos only breathe when this close
local HOME_CHECK_FRAMES = 30

local function flatten(v: Vector3, fallback: Vector3): Vector3
	local flat = Vector3.new(v.X, 0, v.Z)
	return if flat.Magnitude > 1e-4 then flat.Unit else fallback
end

local function addWalker(model: Model, tries: number?)
	if walkers[model] or not model.Parent then
		return
	end
	local root = model.PrimaryPart
	local home = model:GetAttribute("Home")
	if not root or typeof(home) ~= "CFrame" then
		-- Its parts can arrive a moment after the model itself; try again.
		local attempt = (tries or 0) + 1
		if attempt <= 20 then
			task.delay(0.25, addWalker, model, attempt)
		end
		return
	end
	local height = model:GetAttribute("Height")
	local h = if typeof(height) == "number" then height else 4
	local rng = Random.new()
	local plot = model.Parent and model.Parent.Parent
	local floor = plot and plot:FindFirstChild("Floor")
	walkers[model] = {
		root = root,
		home = home.Position,
		position = root.CFrame.Position,
		facing = flatten(home.LookVector, Vector3.new(0, 0, -1)),
		target = nil,
		waitUntil = os.clock() + rng:NextNumber(0, 3),
		phase = rng:NextNumber(0, 10),
		hop = math.clamp(h * 0.06, 0.12, 1.2),
		speed = math.clamp(2.5 + h * 0.35, 2.5, 8),
		rng = rng,
		floor = if floor and floor:IsA("BasePart") then floor else nil,
		margin = math.clamp(h * 0.6, 4, 10),
		homeCheck = rng:NextInteger(1, HOME_CHECK_FRAMES),
	}
end

-- A random spot a short walk away, kept inside the pen (or near home if the
-- pen's floor can't be found).
local function pickTarget(w: Walker): Vector3
	local angle = w.rng:NextNumber(0, math.pi * 2)
	local floor = w.floor
	if not floor or not floor.Parent then
		local radius = w.rng:NextNumber(1, WANDER_RADIUS)
		return w.home + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
	end
	local radius = w.rng:NextNumber(4, WALK_DISTANCE)
	local goal = w.position + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
	local localGoal = floor.CFrame:PointToObjectSpace(goal)
	local halfX = math.max(floor.Size.X / 2 - w.margin, 0)
	local halfZ = math.max(floor.Size.Z / 2 - w.margin, 0)
	local inside = Vector3.new(
		math.clamp(localGoal.X, -halfX, halfX),
		0,
		math.clamp(localGoal.Z, -halfZ, halfZ)
	)
	local world = floor.CFrame:PointToWorldSpace(inside)
	return Vector3.new(world.X, w.home.Y, world.Z)
end

local function stepWalkers(dt: number)
	local camera = Workspace.CurrentCamera
	local eye = if camera then camera.CFrame.Position else Vector3.zero
	local now = os.clock()
	for model, w in walkers do
		if not model.Parent then
			walkers[model] = nil
			continue
		end
		local away = (w.position - eye).Magnitude
		if away > FAR then
			continue
		end
		-- the server moves dinos to a new home when the nest is rearranged
		w.homeCheck -= 1
		if w.homeCheck <= 0 then
			w.homeCheck = HOME_CHECK_FRAMES
			local home = model:GetAttribute("Home")
			if typeof(home) == "CFrame" and (home.Position - w.home).Magnitude > 0.1 then
				w.home = home.Position
				w.position = home.Position
				w.target = nil
			end
		end
		local moving = false
		local target = w.target
		if target then
			local flat = Vector3.new(target.X - w.position.X, 0, target.Z - w.position.Z)
			local distance = flat.Magnitude
			if distance < 0.25 then
				w.target = nil
				w.waitUntil = now + w.rng:NextNumber(2, 6)
			else
				local direction = flat.Unit
				w.facing = flatten(w.facing:Lerp(direction, math.min(1, dt * 5)), direction)
				if w.facing:Dot(direction) > 0.85 then
					w.position += direction * math.min(distance, w.speed * dt)
					moving = true
				end
			end
		elseif now >= w.waitUntil then
			w.target = pickTarget(w)
		end
		if not moving and away > NEAR then
			continue -- too far to see it breathe
		end
		w.phase += dt * (if moving then 4 + w.speed * 1.5 else 2)
		local lift = if moving
			then math.abs(math.sin(w.phase)) * w.hop
			else (math.sin(w.phase) * 0.5 + 0.5) * w.hop * 0.15
		local waddle = if moving then math.sin(w.phase) * 0.07 else 0
		local p = w.position + Vector3.new(0, lift, 0)
		w.root.CFrame = CFrame.lookAt(p, p + w.facing) * CFrame.Angles(0, 0, waddle)
	end
end

local function onDinoAdded(instance: Instance)
	if instance:IsA("Model") then
		addWalker(instance)
	end
end

-- ===== Rainbow mutation =====

-- Rainbow parts, kept up to date by tag signals (part -> hue offset).
local rainbowParts: { [BasePart]: number } = {}
local rainbowWait = 0

local function addRainbow(instance: Instance)
	if instance:IsA("BasePart") then
		rainbowParts[instance] = math.random() * 0.3
	end
end

local function rainbowStep(dt: number)
	rainbowWait -= dt
	if rainbowWait > 0 then
		return
	end
	rainbowWait = 1 / 15
	local hue = (os.clock() * 0.25) % 1
	for part, offset in rainbowParts do
		part.Color = Color3.fromHSV((hue + offset) % 1, 0.65, 1)
	end
end

-- ===== Incubator eggs =====

local function updateEgg(model: Instance, now: number)
	if not model:IsA("Model") then
		return
	end
	local hatchAt = model:GetAttribute("HatchAt")
	local root = model.PrimaryPart
	if typeof(hatchAt) ~= "number" or not root then
		return
	end
	local gui = root:FindFirstChild("Timer")
	local text = gui and gui:FindFirstChild("Text")
	local ready = hatchAt <= now
	if text and text:IsA("TextLabel") then
		local friendWarm = model:GetAttribute("FriendWarmAt")
		local warmedRecently = typeof(friendWarm) == "number" and now - friendWarm < 2
		if ready then
			text.Text = "🐣 Ready to hatch!"
			text.TextColor3 = Color3.fromRGB(120, 255, 120)
		else
			text.Text = (if warmedRecently then "🔥x2 " else "⏱ ") .. Format.time(hatchAt - now)
			text.TextColor3 = Color3.new(1, 1, 1)
		end
	end
	for _, descendant in root:GetDescendants() do
		if
			descendant:IsA("ProximityPrompt")
			and descendant:GetAttribute("Action") == "IncubatorTap"
		then
			descendant.ActionText = if ready then "Hatch! 🐣" else "Warm 🔥"
		end
	end
	if ready and not model:GetAttribute("Wobbling") then
		model:SetAttribute("Wobbling", true)
		local base = root.CFrame
		local wobble = TweenService:Create(
			root,
			TweenInfo.new(0.18, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ CFrame = base * CFrame.Angles(0, 0, math.rad(9)) }
		)
		wobble:Play()
		model.Destroying:Connect(function()
			wobble:Cancel()
		end)
	end
end

-- ===== Lighting =====

local colorCorrection: ColorCorrectionEffect
local stormAbove: Part -- falling weather, above the camera
local stormBelow: Part -- rising weather (embers), around the player
local stormEmitters: { [string]: { ParticleEmitter } } = {}
local stormActive = false
local lastNight: boolean? = nil
local lastStorm = ""

-- Bright cartoon day; a blue, readable night lit by lamps.
local DAY = {
	lighting = {
		ClockTime = 14.2,
		Brightness = 2.6,
		Ambient = Color3.fromRGB(115, 112, 128),
		OutdoorAmbient = Color3.fromRGB(148, 148, 163),
		ColorShift_Top = Color3.fromRGB(255, 242, 220),
	},
	atmosphere = {
		Density = 0.28,
		Color = Color3.fromRGB(199, 230, 255),
		Decay = Color3.fromRGB(122, 178, 242),
	},
}
local NIGHT = {
	lighting = {
		ClockTime = 0.6,
		Brightness = 1.3,
		Ambient = Color3.fromRGB(82, 86, 140),
		OutdoorAmbient = Color3.fromRGB(98, 104, 170),
		ColorShift_Top = Color3.fromRGB(150, 170, 255),
	},
	atmosphere = {
		Density = 0.32,
		Color = Color3.fromRGB(64, 74, 132),
		Decay = Color3.fromRGB(38, 44, 98),
	},
}

local function setNightLights(on: boolean)
	for _, light in CollectionService:GetTagged(Tags.NIGHT_LIGHT) do
		if light:IsA("Light") then
			light.Enabled = on
		end
	end
end

local function setLighting(isNight: boolean)
	local info = TweenInfo.new(6, Enum.EasingStyle.Sine)
	local look = if isNight then NIGHT else DAY
	TweenService:Create(Lighting, info, look.lighting):Play()
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		TweenService:Create(atmosphere, info, look.atmosphere):Play()
	end
	setNightLights(isNight)
end

-- Each storm has its own look: a sky tint plus one or two particle layers.
type EmitterLook = {
	rises: boolean?, -- emitted around the player and floating up (else falls from above)
	color: ColorSequence,
	rate: number,
	speed: NumberRange,
	size: NumberSequence,
	lifetime: NumberRange,
	acceleration: Vector3,
	spread: Vector2,
	light: number,
	transparency: NumberSequence?,
	rotSpeed: NumberRange?,
	streak: boolean?, -- stretched along its motion, like a shooting star
}

type StormLook = { tint: Color3, saturation: number, emitters: { EmitterLook } }

local function seq(...: number): NumberSequence
	local values = { ... }
	if #values == 1 then
		return NumberSequence.new(values[1])
	end
	local keys = {}
	for i, v in values do
		table.insert(keys, NumberSequenceKeypoint.new((i - 1) / (#values - 1), v))
	end
	return NumberSequence.new(keys)
end

local function colors(...: Color3): ColorSequence
	local values = { ... }
	if #values == 1 then
		return ColorSequence.new(values[1])
	end
	local keys = {}
	for i, c in values do
		table.insert(keys, ColorSequenceKeypoint.new((i - 1) / (#values - 1), c))
	end
	return ColorSequence.new(keys)
end

local STORM_LOOKS: { [string]: StormLook } = {
	-- Blizzard: thick snow blowing sideways and quick white gusts.
	Frost = {
		tint = Color3.fromRGB(205, 228, 255),
		saturation = -0.15,
		emitters = {
			{
				color = colors(Color3.new(1, 1, 1)),
				rate = 180,
				speed = NumberRange.new(6, 10),
				size = seq(0.25, 0.35, 0.3),
				lifetime = NumberRange.new(6, 9),
				acceleration = Vector3.new(9, -2, 3),
				spread = Vector2.new(35, 35),
				light = 0.3,
				rotSpeed = NumberRange.new(-90, 90),
			},
			{
				color = colors(Color3.fromRGB(220, 240, 255)),
				rate = 35,
				speed = NumberRange.new(12, 18),
				size = seq(0.7, 0),
				lifetime = NumberRange.new(3, 4),
				acceleration = Vector3.new(22, 0, 6),
				spread = Vector2.new(50, 50),
				light = 0.5,
				transparency = seq(0.3, 1),
			},
		},
	},
	-- Meteor Shower: shooting stars streaking across a purple sky, plus stardust.
	Cosmic = {
		tint = Color3.fromRGB(215, 195, 255),
		saturation = 0.1,
		emitters = {
			{
				color = colors(
					Color3.new(1, 1, 1),
					Color3.fromRGB(190, 150, 255),
					Color3.fromRGB(90, 220, 255)
				),
				rate = 7,
				speed = NumberRange.new(90, 130),
				size = seq(1.1, 0.2),
				lifetime = NumberRange.new(0.9, 1.4),
				acceleration = Vector3.new(60, 0, 25),
				spread = Vector2.new(5, 5),
				light = 1,
				streak = true,
			},
			{
				color = colors(Color3.fromRGB(200, 160, 255), Color3.fromRGB(150, 230, 255)),
				rate = 70,
				speed = NumberRange.new(3, 6),
				size = seq(0, 0.4, 0),
				lifetime = NumberRange.new(4, 6),
				acceleration = Vector3.new(0, -1, 0),
				spread = Vector2.new(60, 60),
				light = 1,
			},
		},
	},
	-- Lava Storm: glowing embers floating up around you and grey ash drifting down.
	Lava = {
		tint = Color3.fromRGB(255, 214, 185),
		saturation = 0.05,
		emitters = {
			{
				rises = true,
				color = colors(
					Color3.fromRGB(255, 220, 120),
					Color3.fromRGB(255, 110, 30),
					Color3.fromRGB(200, 40, 20)
				),
				rate = 70,
				speed = NumberRange.new(3, 7),
				size = seq(0.35, 0.05),
				lifetime = NumberRange.new(3, 5),
				acceleration = Vector3.new(2, 5, 1),
				spread = Vector2.new(40, 40),
				light = 1,
				transparency = seq(0, 0.2, 1),
			},
			{
				color = colors(Color3.fromRGB(95, 85, 85)),
				rate = 60,
				speed = NumberRange.new(4, 7),
				size = seq(0.3),
				lifetime = NumberRange.new(6, 8),
				acceleration = Vector3.new(3, -1, 2),
				spread = Vector2.new(40, 40),
				light = 0,
				rotSpeed = NumberRange.new(-60, 60),
			},
		},
	},
	-- Rainbow Mega Storm: rainbow confetti and twinkles.
	Rainbow = {
		tint = Color3.fromRGB(255, 228, 246),
		saturation = 0.25,
		emitters = {
			{
				color = colors(
					Color3.fromRGB(255, 90, 90),
					Color3.fromRGB(255, 230, 90),
					Color3.fromRGB(90, 220, 255),
					Color3.fromRGB(200, 120, 255)
				),
				rate = 110,
				speed = NumberRange.new(8, 12),
				size = seq(0.45),
				lifetime = NumberRange.new(5, 7),
				acceleration = Vector3.new(2, -2, 1),
				spread = Vector2.new(30, 30),
				light = 0.6,
				rotSpeed = NumberRange.new(-180, 180),
			},
			{
				color = colors(Color3.new(1, 1, 1), Color3.fromRGB(255, 170, 230)),
				rate = 50,
				speed = NumberRange.new(2, 4),
				size = seq(0, 0.5, 0),
				lifetime = NumberRange.new(3, 5),
				acceleration = Vector3.zero,
				spread = Vector2.new(60, 60),
				light = 1,
			},
		},
	},
}

local function hostPart(name: string, size: Vector3): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = size
	part.Parent = Workspace.CurrentCamera or Workspace
	return part
end

local function buildStormEmitters()
	stormAbove = hostPart("StormAbove", Vector3.new(160, 1, 160))
	stormBelow = hostPart("StormBelow", Vector3.new(90, 1, 90))
	for kind, look in STORM_LOOKS do
		local list = {}
		for _, e in look.emitters do
			local emitter = Instance.new("ParticleEmitter")
			emitter.Name = kind
			emitter.EmissionDirection = if e.rises then Enum.NormalId.Top else Enum.NormalId.Bottom
			emitter.Color = e.color
			emitter.Rate = e.rate
			emitter.Speed = e.speed
			emitter.Size = e.size
			emitter.Lifetime = e.lifetime
			emitter.Acceleration = e.acceleration
			emitter.SpreadAngle = e.spread
			emitter.LightEmission = e.light
			if e.transparency then
				emitter.Transparency = e.transparency
			end
			if e.rotSpeed then
				emitter.RotSpeed = e.rotSpeed
				emitter.Rotation = NumberRange.new(0, 360)
			end
			if e.streak then
				emitter.Orientation = Enum.ParticleOrientation.VelocityParallel
				emitter.Squash = NumberSequence.new(-3)
			end
			emitter.Enabled = false
			emitter.Parent = if e.rises then stormBelow else stormAbove
			table.insert(list, emitter)
		end
		stormEmitters[kind] = list
	end
end

local function setStorm(kind: string)
	for _, list in stormEmitters do
		for _, emitter in list do
			emitter.Enabled = false
		end
	end
	local look = STORM_LOOKS[kind]
	stormActive = look ~= nil
	if not look then
		TweenService:Create(colorCorrection, TweenInfo.new(3), {
			TintColor = Color3.new(1, 1, 1),
			Saturation = 0,
		}):Play()
		return
	end
	local emitters: { ParticleEmitter } = stormEmitters[kind] or {}
	for _, emitter in emitters do
		emitter.Enabled = true
	end
	TweenService:Create(colorCorrection, TweenInfo.new(3), {
		TintColor = look.tint,
		Saturation = look.saturation,
	}):Play()
end

local function weatherStep()
	local now = Clock.cycleNow()
	local isNight = Cycle.dayNight(now).isNight
	if isNight ~= lastNight then
		lastNight = isNight
		setLighting(isNight)
	end
	local storm = Cycle.storm(now)
	local kind = if not storm.active then "" elseif storm.mega then "Rainbow" else storm.kind or ""
	if kind ~= lastStorm then
		lastStorm = kind
		setStorm(kind)
	end
end

local function followCamera()
	local camera = Workspace.CurrentCamera
	if camera and stormActive then
		stormAbove.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, 40, 0))
		stormBelow.CFrame = CFrame.new(camera.Focus.Position - Vector3.new(0, 3, 0))
	end
end

-- Switch the storm look directly ("" = clear sky). Used by tests.
WorldFx.setStorm = setStorm

function WorldFx.init()
	colorCorrection = Instance.new("ColorCorrectionEffect")
	colorCorrection.Name = "StormTint"
	colorCorrection.Parent = Lighting

	buildStormEmitters()

	for _, instance in CollectionService:GetTagged(DinoModel.TAG) do
		onDinoAdded(instance)
	end
	CollectionService:GetInstanceAddedSignal(DinoModel.TAG):Connect(onDinoAdded)
	for _, part in CollectionService:GetTagged(DinoModel.RAINBOW_TAG) do
		addRainbow(part)
	end
	CollectionService:GetInstanceAddedSignal(DinoModel.RAINBOW_TAG):Connect(addRainbow)
	CollectionService:GetInstanceRemovedSignal(DinoModel.RAINBOW_TAG):Connect(function(instance)
		if instance:IsA("BasePart") then
			rainbowParts[instance] = nil
		end
	end)
	CollectionService:GetInstanceAddedSignal(Tags.NIGHT_LIGHT):Connect(function(instance)
		if instance:IsA("Light") then
			instance.Enabled = lastNight == true
		end
	end)
	CollectionService:GetInstanceRemovedSignal(DinoModel.TAG):Connect(function(instance)
		if instance:IsA("Model") then
			walkers[instance] = nil
		end
	end)
end

function WorldFx.start()
	RunService.Heartbeat:Connect(function(dt: number)
		rainbowStep(dt)
		followCamera()
		stepWalkers(dt)
	end)
	while true do
		local now = Clock.now()
		for _, egg in CollectionService:GetTagged(EGG_TAG) do
			updateEgg(egg, now)
		end
		weatherStep()
		task.wait(0.25)
	end
end

return WorldFx
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="102">
          <Properties>
            <string name="Name">Lib</string>
          </Properties>
          <Item class="ModuleScript" referent="103">
            <Properties>
              <string name="Name">Panels</string>
              <string name="Source"><![CDATA[--!strict
-- Pop-up windows (shop, store, dex...). One open at a time, with a bouncy open
-- animation, a round close button and a dimmed background that closes on tap.
-- Windows shrink to fit small screens, so nothing spills off a phone.

local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local UI = require(script.Parent.UI)

local Panels = {}

local HEADER = 66
local MARGIN = 24

type Window = {
	frame: Frame,
	content: Frame,
	scale: UIScale,
	size: Vector2,
	title: TextLabel,
	onOpen: { () -> () },
	onClose: { () -> () },
}

local gui: ScreenGui? = nil
local dim: TextButton? = nil
local windows: { [string]: Window } = {}
local current: string? = nil

-- How much a window must shrink to fit the current screen (1 = not at all).
local function fit(window: Window): number
	local canvas = UI.canvasSize()
	return math.min(
		1,
		(canvas.X - MARGIN) / window.size.X,
		(canvas.Y - MARGIN) / (window.size.Y + 8)
	)
end

local function root(): ScreenGui
	if gui then
		return gui
	end
	local screen = UI.screen("Panels", 10)
	local background = UI.new("TextButton", {
		Name = "Dim",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.fromRGB(20, 14, 34),
		BackgroundTransparency = 0.5,
		Size = UDim2.fromScale(4, 4),
		Position = UDim2.fromScale(-1.5, -1.5),
		Visible = false,
		ZIndex = 0,
		Parent = screen,
	}) :: TextButton
	background.Activated:Connect(function()
		Panels.close()
	end)
	gui = screen
	dim = background
	local camera = Workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			local name = current
			local window = name and windows[name]
			if window then
				window.scale.Scale = fit(window)
			end
		end)
	end
	return screen
end

-- Creates a window and returns (window frame, content frame). The content
-- frame sits under the header with padding already applied.
function Panels.window(name: string, title: string, size: Vector2, accent: Color3?): (Frame, Frame)
	local screen = root()
	local color = accent or UI.Theme.orange
	local frame = UI.new("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 2,
		Parent = screen,
	}) :: Frame
	local scale = UI.new("UIScale", { Parent = frame }) :: UIScale

	-- soft drop shadow
	UI.new("Frame", {
		Name = "Shadow",
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(0, 9),
		BackgroundColor3 = Color3.fromRGB(20, 14, 34),
		BackgroundTransparency = 0.6,
		Parent = frame,
	}, { UI.corner(28) })

	local body = UI.new("Frame", {
		Name = "Body",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = UI.Theme.panel,
		Parent = frame,
	}, { UI.corner(28), UI.stroke(UI.Theme.ink, 4) }) :: Frame
	UI.studs(body, 28)

	-- coloured ribbon header (rounded top, square bottom)
	local header = UI.new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, HEADER),
		BackgroundColor3 = color,
		Parent = body,
	}, { UI.corner(28), UI.shade(0.86) }) :: Frame
	UI.new("Frame", {
		Name = "Square",
		Size = UDim2.new(1, 0, 0, 28),
		Position = UDim2.new(0, 0, 1, -28),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = header,
	}, { UI.shade(0.93) })
	UI.new("Frame", {
		Name = "Edge",
		Size = UDim2.new(1, 0, 0, 4),
		Position = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = UI.darken(color, 0.3),
		BorderSizePixel = 0,
		Parent = header,
	})
	local titleLabel = UI.text({
		name = "Title",
		text = title,
		size = UDim2.new(1, -150, 0, 46),
		position = UDim2.new(0.5, 0, 0, 10),
		anchor = Vector2.new(0.5, 0),
		maxTextSize = 36,
		outlineThickness = 3,
		zIndex = 2,
		parent = header,
	})

	UI.button({
		name = "Close",
		text = "X",
		size = UDim2.fromOffset(52, 52),
		position = UDim2.new(1, -12, 0, 12),
		anchor = Vector2.new(0.5, 0.5),
		color = UI.Theme.red,
		radius = 26,
		depth = 4,
		maxTextSize = 30,
		zIndex = 4,
		parent = frame,
		onClick = function()
			Panels.close()
		end,
	})

	local content = UI.new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(18, HEADER + 14),
		Size = UDim2.new(1, -36, 1, -(HEADER + 28)),
		Parent = body,
	}) :: Frame

	windows[name] = {
		frame = frame,
		content = content,
		scale = scale,
		size = size,
		title = titleLabel,
		onOpen = {},
		onClose = {},
	}
	return frame, content
end

function Panels.setTitle(name: string, title: string)
	local window = windows[name]
	if window then
		window.title.Text = title
	end
end

function Panels.has(name: string): boolean
	return windows[name] ~= nil
end

function Panels.onOpen(name: string, fn: () -> ())
	table.insert(windows[name].onOpen, fn)
end

function Panels.onClose(name: string, fn: () -> ())
	table.insert(windows[name].onClose, fn)
end

function Panels.isOpen(name: string): boolean
	return current == name
end

function Panels.current(): string?
	return current
end

function Panels.close()
	if not current then
		return
	end
	local window = windows[current]
	current = nil
	if dim then
		dim.Visible = false
	end
	if window then
		window.frame.Visible = false
		for _, fn in window.onClose do
			task.spawn(fn)
		end
	end
end

function Panels.open(name: string)
	local window = windows[name]
	if not window then
		return
	end
	if current and current ~= name then
		Panels.close()
	end
	current = name
	if dim then
		dim.Visible = true
	end
	window.frame.Visible = true
	local target = fit(window)
	window.scale.Scale = target * 0.82
	TweenService:Create(window.scale, UI.BOUNCY, { Scale = target }):Play()
	UI.onOpen()
	for _, fn in window.onOpen do
		task.spawn(fn)
	end
end

function Panels.toggle(name: string)
	if current == name then
		Panels.close()
	else
		Panels.open(name)
	end
end

-- Segmented tab bar. `pages` maps tab name -> page frame; returns a function
-- that selects a tab by name.
function Panels.tabs(
	parent: Instance,
	tabs: { { name: string, text: string, color: Color3 } },
	onSelect: (name: string) -> ()
): (name: string) -> ()
	local bar = UI.new("Frame", {
		Name = "Tabs",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 50),
		Parent = parent,
	}, { UI.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left) }) :: Frame
	local buttons: { [string]: UI.Button } = {}
	local colors: { [string]: Color3 } = {}
	local function selectTab(name: string)
		for tabName, button in buttons do
			local active = tabName == name
			UI.setButton(button, { color = if active then colors[tabName] else UI.Theme.grey })
			button.root.Size =
				UDim2.fromOffset(button.root.Size.X.Offset, if active then 46 else 42)
		end
		onSelect(name)
	end
	for order, tab in tabs do
		colors[tab.name] = tab.color
		buttons[tab.name] = UI.button({
			name = tab.name .. "Tab",
			text = tab.text,
			size = UDim2.fromOffset(170, 44),
			color = tab.color,
			order = order,
			maxTextSize = 24,
			depth = 4,
			parent = bar,
			onClick = function()
				selectTab(tab.name)
			end,
		})
	end
	return selectTab
end

return Panels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="104">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[--!strict
-- Raise a Dino UI kit: one theme and a few building blocks so every screen
-- shares the same chunky cartoon look.
--
--   * Candy buttons: a coloured face with a top shine and a darker 3D base
--     that the face presses into.
--   * Cream panels and white cards with soft edges, ink outlines for text
--     on top of the 3D world, Fredoka One for headings and buttons.
--   * Layout in design pixels; each ScreenGui gets a UIScale that fits the
--     design canvas (about 1150 x 650) to phones, tablets and desktops.
--   * Square studs, like the world: panels, cards and buttons wear a tiled
--     see-through stud image once its ID is set (see UI.studs).

local GuiService = game:GetService("GuiService")
local MaterialService = game:GetService("MaterialService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local UI = {}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

UI.Theme = {
	ink = rgb(43, 33, 64),
	inkSoft = rgb(104, 92, 132),
	panel = rgb(255, 248, 236),
	panelDark = rgb(244, 232, 210),
	card = rgb(255, 255, 255),
	cardEdge = rgb(232, 216, 190),
	track = rgb(232, 220, 200),
	hud = rgb(43, 33, 64),
	white = rgb(255, 255, 255),
	gold = rgb(255, 201, 60),
	coin = rgb(255, 214, 77),
	green = rgb(85, 209, 110),
	blue = rgb(74, 168, 255),
	red = rgb(255, 90, 95),
	orange = rgb(255, 159, 67),
	purple = rgb(155, 107, 255),
	pink = rgb(255, 120, 190),
	teal = rgb(56, 196, 186),
	grey = rgb(184, 179, 196),
	night = rgb(98, 96, 214),
	day = rgb(74, 168, 255),
	-- readable text colours on cream/white
	good = rgb(40, 150, 72),
	bad = rgb(214, 64, 70),
	money = rgb(206, 140, 0),
}

UI.Font = Enum.Font.FredokaOne
UI.BodyFont = Enum.Font.BuilderSansBold
UI.HeavyFont = Enum.Font.BuilderSansExtraBold

-- Sound hooks (set by the audio controller): button clicks, windows opening.
UI.onClick = function() end
UI.onOpen = function() end

UI.FAST = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
UI.BOUNCY = TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
UI.SMOOTH = TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

-- Design canvas the layouts are drawn for.
UI.DESIGN = Vector2.new(1150, 650)

function UI.darken(c: Color3, amount: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), amount)
end

function UI.lighten(c: Color3, amount: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), amount)
end

function UI.rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

-- Create an instance, set properties, parent children. Returns `any` so callers
-- cast to the concrete class (`:: Frame`).
function UI.new(className: string, props: { [string]: any }?, children: { any }?): any
	local instance = Instance.new(className)
	local parent: Instance? = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

-- ===== Decorators (return `any` so they mix in one children list) =====

function UI.corner(radius: number?): any
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 14) })
end

function UI.round(): any
	return UI.new("UICorner", { CornerRadius = UDim.new(0.5, 0) })
end

function UI.stroke(color: Color3?, thickness: number?, transparency: number?): any
	return UI.new("UIStroke", {
		Color = color or UI.Theme.ink,
		Thickness = thickness or 3,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.padding(px: number, vertical: number?): any
	local h = UDim.new(0, px)
	local v = UDim.new(0, vertical or px)
	return UI.new(
		"UIPadding",
		{ PaddingTop = v, PaddingBottom = v, PaddingLeft = h, PaddingRight = h }
	)
end

function UI.list(
	direction: Enum.FillDirection,
	padding: number,
	horizontalAlign: Enum.HorizontalAlignment?,
	verticalAlign: Enum.VerticalAlignment?
): any
	return UI.new("UIListLayout", {
		FillDirection = direction,
		Padding = UDim.new(0, padding),
		HorizontalAlignment = horizontalAlign or Enum.HorizontalAlignment.Center,
		VerticalAlignment = verticalAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function UI.grid(cell: Vector2, gap: number, horizontalAlign: Enum.HorizontalAlignment?): any
	return UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(cell.X, cell.Y),
		CellPadding = UDim2.fromOffset(gap, gap),
		HorizontalAlignment = horizontalAlign or Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

-- Vertical gradient that multiplies the parent's colour: 1 at the top down to
-- `bottom` (e.g. 0.82) at the bottom.
function UI.shade(bottom: number?): any
	local b = bottom or 0.82
	return UI.new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(b, b, b)),
		Rotation = 90,
	})
end

-- ===== Text =====

export type TextProps = {
	text: string,
	size: UDim2,
	position: UDim2?,
	anchor: Vector2?,
	color: Color3?,
	font: Enum.Font?,
	-- outline colour; defaults to ink for light text, none for dark text
	outline: Color3?,
	outlineThickness: number?,
	noOutline: boolean?,
	align: Enum.TextXAlignment?,
	valign: Enum.TextYAlignment?,
	maxTextSize: number?,
	minTextSize: number?,
	order: number?,
	wrap: boolean?,
	parent: Instance?,
	name: string?,
	zIndex: number?,
}

local function isLight(c: Color3): boolean
	return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B > 0.6
end

function UI.text(props: TextProps): TextLabel
	local color = props.color or UI.Theme.white
	local label = UI.new("TextLabel", {
		Name = props.name or "Text",
		BackgroundTransparency = 1,
		Text = props.text,
		Size = props.size,
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		TextColor3 = color,
		Font = props.font or UI.Font,
		TextScaled = true,
		TextWrapped = props.wrap ~= false,
		TextXAlignment = props.align or Enum.TextXAlignment.Center,
		TextYAlignment = props.valign or Enum.TextYAlignment.Center,
		LayoutOrder = props.order or 0,
		ZIndex = props.zIndex or 1,
	}) :: TextLabel
	UI.new("UITextSizeConstraint", {
		MaxTextSize = props.maxTextSize or 40,
		MinTextSize = props.minTextSize or 8,
		Parent = label,
	})
	local outline = props.outline or (if isLight(color) then UI.Theme.ink else nil)
	if outline and not props.noOutline then
		UI.new("UIStroke", {
			Color = outline,
			Thickness = props.outlineThickness or 2,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
			Parent = label,
		})
	end
	if props.parent then
		label.Parent = props.parent
	end
	return label
end

-- Dark text for cream panels and white cards (no outline).
function UI.body(props: TextProps): TextLabel
	props.color = props.color or UI.Theme.ink
	props.font = props.font or UI.BodyFont
	props.noOutline = true
	return UI.text(props)
end

-- ===== Candy buttons =====

export type Button = {
	root: Frame,
	face: TextButton,
	base: Frame,
	label: TextLabel,
	color: Color3,
	enabled: boolean,
	faceStroke: UIStroke,
	baseStroke: UIStroke,
	labelStroke: UIStroke,
}

export type ButtonProps = {
	text: string,
	size: UDim2,
	position: UDim2?,
	anchor: Vector2?,
	color: Color3?,
	textColor: Color3?,
	font: Enum.Font?,
	radius: number?,
	depth: number?,
	parent: Instance?,
	order: number?,
	name: string?,
	maxTextSize: number?,
	zIndex: number?,
	onClick: () -> (),
}

local function paint(button: Button)
	local c = if button.enabled then button.color else UI.Theme.grey
	local edge = UI.darken(c, 0.42)
	button.face.BackgroundColor3 = c
	button.base.BackgroundColor3 = UI.darken(c, 0.3)
	button.faceStroke.Color = edge
	button.baseStroke.Color = edge
	button.labelStroke.Color = UI.darken(c, 0.55)
end

-- A button that presses into its 3D base. Layout (size, position, parent,
-- visibility) goes on `.root`; the label is `.label`.
function UI.button(props: ButtonProps): Button
	local depth = props.depth or 5
	local radius = props.radius or 14
	local z = props.zIndex or 1
	local root = UI.new("Frame", {
		Name = props.name or "Button",
		BackgroundTransparency = 1,
		Size = props.size,
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		LayoutOrder = props.order or 0,
		ZIndex = z,
	}) :: Frame
	local baseStroke = UI.stroke(UI.Theme.ink, 2.5) :: UIStroke
	local base = UI.new("Frame", {
		Name = "Base",
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(0, depth),
		ZIndex = z,
		Parent = root,
	}, { UI.corner(radius), baseStroke }) :: Frame
	local faceStroke = UI.stroke(UI.Theme.ink, 2.5) :: UIStroke
	local face = UI.new("TextButton", {
		Name = "Face",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		ZIndex = z + 1,
		Parent = root,
	}, { UI.corner(radius), faceStroke, UI.shade(0.84) }) :: TextButton
	UI.studs(face, radius, z + 1)
	UI.new("Frame", {
		Name = "Shine",
		BackgroundColor3 = UI.Theme.white,
		BackgroundTransparency = 0.8,
		Size = UDim2.new(1, -10, 0.38, 0),
		Position = UDim2.fromOffset(5, 3),
		ZIndex = z + 2,
		Parent = face,
	}, { UI.corner(math.max(radius - 4, 4)) })
	local label = UI.text({
		name = "Label",
		text = props.text,
		size = UDim2.new(1, -14, 1, -10),
		position = UDim2.fromOffset(7, 5),
		color = props.textColor or UI.Theme.white,
		font = props.font or UI.Font,
		maxTextSize = props.maxTextSize or 30,
		outlineThickness = 2,
		outline = UI.Theme.ink,
		zIndex = z + 3,
		parent = face,
	})
	local labelStroke = label:FindFirstChildOfClass("UIStroke") :: UIStroke
	local button: Button = {
		root = root,
		face = face,
		base = base,
		label = label,
		color = props.color or UI.Theme.green,
		enabled = true,
		faceStroke = faceStroke,
		baseStroke = baseStroke,
		labelStroke = labelStroke,
	}
	paint(button)

	local pressed = UDim2.fromOffset(0, depth - 1)
	local function release()
		TweenService:Create(face, UI.FAST, { Position = UDim2.new() }):Play()
	end
	face.MouseButton1Down:Connect(function()
		TweenService:Create(face, UI.FAST, { Position = pressed }):Play()
	end)
	face.MouseButton1Up:Connect(release)
	face.MouseLeave:Connect(release)
	face.Activated:Connect(function()
		release()
		if button.enabled then
			UI.onClick()
			props.onClick()
		end
	end)
	if props.parent then
		root.Parent = props.parent
	end
	return button
end

export type ButtonUpdate = { text: string?, color: Color3?, enabled: boolean? }

function UI.setButton(button: Button, update: ButtonUpdate)
	if update.text and button.label.Text ~= update.text then
		button.label.Text = update.text
	end
	if update.color then
		button.color = update.color
	end
	if update.enabled ~= nil then
		button.enabled = update.enabled
	end
	paint(button)
end

-- Square menu button: a big emoji icon with a caption underneath and an
-- optional red badge (for "something to claim").
export type MenuButton = { button: Button, badge: Frame, badgeLabel: TextLabel }

function UI.menuButton(props: {
	icon: string,
	caption: string,
	color: Color3,
	size: number?,
	order: number?,
	parent: Instance?,
	onClick: () -> (),
}): MenuButton
	local size = props.size or 70
	local button = UI.button({
		name = props.caption,
		text = props.icon,
		size = UDim2.fromOffset(size, size),
		color = props.color,
		radius = 18,
		order = props.order,
		maxTextSize = 44,
		parent = props.parent,
		onClick = props.onClick,
	})
	UI.text({
		name = "Caption",
		text = props.caption,
		size = UDim2.new(1, 24, 0, 22),
		position = UDim2.new(0.5, 0, 1, 4),
		anchor = Vector2.new(0.5, 0),
		maxTextSize = 18,
		outlineThickness = 2.5,
		parent = button.root,
	})
	local badge = UI.new("Frame", {
		Name = "Badge",
		Size = UDim2.fromOffset(26, 26),
		Position = UDim2.new(1, 6, 0, -6),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = UI.Theme.red,
		Visible = false,
		ZIndex = 6,
		Parent = button.root,
	}, { UI.round(), UI.stroke(UI.Theme.white, 2.5) }) :: Frame
	local badgeLabel = UI.text({
		text = "!",
		size = UDim2.fromScale(0.8, 0.8),
		position = UDim2.fromScale(0.5, 0.5),
		anchor = Vector2.new(0.5, 0.5),
		maxTextSize = 20,
		outlineThickness = 1.5,
		zIndex = 7,
		parent = badge,
	})
	return { button = button, badge = badge, badgeLabel = badgeLabel }
end

-- ===== Two-tap confirmation =====
-- For buttons that can't be undone (sell, fuse, rebirth). The first tap arms
-- the button (it shows a warning); a second tap confirms, but only after
-- CONFIRM_DELAY, so a quick double-tap can't skip reading the warning.

UI.CONFIRM_DELAY = 0.5
UI.CONFIRM_WINDOW = 3

export type Confirm = { armedAt: number }

function UI.confirm(): Confirm
	return { armedAt = -math.huge }
end

-- Is the warning showing?
function UI.isArmed(confirm: Confirm): boolean
	return os.clock() - confirm.armedAt < UI.CONFIRM_WINDOW
end

-- Call on tap. Returns true when this tap confirms the action.
function UI.confirmTap(confirm: Confirm): boolean
	local age = os.clock() - confirm.armedAt
	if age >= UI.CONFIRM_DELAY and age < UI.CONFIRM_WINDOW then
		confirm.armedAt = -math.huge
		return true
	end
	if age >= UI.CONFIRM_WINDOW then
		confirm.armedAt = os.clock() -- arm
	end
	return false -- armed now, or tapped again too fast
end

function UI.disarm(confirm: Confirm)
	confirm.armedAt = -math.huge
end

-- ===== Studs =====
-- One see-through stud (assets/textures/SquareStuds_UI.png) tiled over a
-- panel, card or button of any colour. Its image ID lives in the "UIStudImage"
-- attribute of MaterialService.SquareStuds, next to the world's stud maps.
-- Until it's set, the UI stays smooth; setting it updates every screen live.

UI.STUD_TILE = 26

local studLabels: { [ImageLabel]: true } = {}

local function readStudImage(): string
	local variant = MaterialService:FindFirstChild("SquareStuds")
	local value = if variant then variant:GetAttribute("UIStudImage") else nil
	local id = if type(value) == "number"
		then tostring(math.floor(value))
		elseif type(value) == "string" then string.match(value, "%d+")
		else nil
	return if id then "rbxassetid://" .. id else ""
end

local studImage = readStudImage()

do
	local variant = MaterialService:FindFirstChild("SquareStuds")
	if variant then
		variant:GetAttributeChangedSignal("UIStudImage"):Connect(function()
			studImage = readStudImage()
			for label in studLabels do
				label.Image = studImage
				label.Visible = studImage ~= ""
			end
		end)
	end
end

-- Lays studs over `target`, under its other children (zIndex 0 by default).
function UI.studs(target: GuiObject, radius: number?, zIndex: number?): ImageLabel
	local label = UI.new("ImageLabel", {
		Name = "Studs",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Image = studImage,
		Visible = studImage ~= "",
		ScaleType = Enum.ScaleType.Tile,
		TileSize = UDim2.fromOffset(UI.STUD_TILE, UI.STUD_TILE),
		ZIndex = zIndex or 0,
		Parent = target,
	}, { UI.corner(radius or 16) }) :: ImageLabel
	studLabels[label] = true
	label.Destroying:Connect(function()
		studLabels[label] = nil
	end)
	return label
end

-- ===== Cards, chips, bars =====

function UI.card(props: {
	size: UDim2,
	position: UDim2?,
	anchor: Vector2?,
	color: Color3?,
	edge: Color3?,
	radius: number?,
	order: number?,
	name: string?,
	parent: Instance?,
}): Frame
	local card = UI.new("Frame", {
		Name = props.name or "Card",
		Size = props.size,
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		BackgroundColor3 = props.color or UI.Theme.card,
		LayoutOrder = props.order or 0,
		Parent = props.parent,
	}, { UI.corner(props.radius or 16), UI.stroke(props.edge or UI.Theme.cardEdge, 2.5) }) :: Frame
	UI.studs(card, props.radius or 16)
	return card
end

-- Rounded pill with text, used for HUD timers and small tags.
export type Chip = { root: Frame, label: TextLabel, stroke: UIStroke }

function UI.chip(props: {
	text: string,
	size: UDim2,
	color: Color3?,
	transparency: number?,
	position: UDim2?,
	anchor: Vector2?,
	order: number?,
	maxTextSize: number?,
	name: string?,
	parent: Instance?,
}): Chip
	local color = props.color or UI.Theme.hud
	local stroke = UI.stroke(UI.darken(color, 0.45), 2.5) :: UIStroke
	local root = UI.new("Frame", {
		Name = props.name or "Chip",
		Size = props.size,
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		BackgroundColor3 = color,
		BackgroundTransparency = props.transparency or 0.08,
		LayoutOrder = props.order or 0,
		Parent = props.parent,
	}, { UI.round(), stroke, UI.shade(0.88) }) :: Frame
	local label = UI.text({
		text = props.text,
		size = UDim2.new(1, -18, 1, -8),
		position = UDim2.fromOffset(9, 4),
		maxTextSize = props.maxTextSize or 22,
		outlineThickness = 2,
		parent = root,
	})
	return { root = root, label = label, stroke = stroke }
end

function UI.setChipColor(chip: Chip, color: Color3)
	chip.root.BackgroundColor3 = color
	chip.stroke.Color = UI.darken(color, 0.45)
end

export type Bar = { root: Frame, fill: Frame, label: TextLabel }

function UI.bar(props: {
	size: UDim2,
	position: UDim2?,
	color: Color3?,
	order: number?,
	parent: Instance?,
}): Bar
	local root = UI.new("Frame", {
		Name = "Bar",
		Size = props.size,
		Position = props.position or UDim2.new(),
		BackgroundColor3 = UI.Theme.track,
		LayoutOrder = props.order or 0,
		Parent = props.parent,
	}, { UI.round(), UI.stroke(UI.Theme.ink, 2.5) }) :: Frame
	local fill = UI.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0.5, 1),
		BackgroundColor3 = props.color or UI.Theme.green,
		Parent = root,
	}, { UI.round(), UI.shade(0.8) }) :: Frame
	local label = UI.text({
		text = "",
		size = UDim2.new(1, -16, 1, -4),
		position = UDim2.fromOffset(8, 2),
		maxTextSize = 20,
		outlineThickness = 2,
		zIndex = 2,
		parent = root,
	})
	return { root = root, fill = fill, label = label }
end

function UI.setBar(bar: Bar, fraction: number, text: string?)
	bar.fill.Size = UDim2.fromScale(math.clamp(fraction, 0.04, 1), 1)
	bar.fill.Visible = fraction > 0.001
	if text then
		bar.label.Text = text
	end
end

-- Drawn gold coin (no image assets needed).
function UI.coin(size: number, parent: Instance?): Frame
	local coin = UI.new("Frame", {
		Name = "Coin",
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = UI.Theme.coin,
	}, {
		UI.round(),
		UI.stroke(UI.darken(UI.Theme.gold, 0.4), math.max(2, size / 16)),
		UI.shade(0.82),
	}) :: Frame
	UI.new("Frame", {
		Name = "Inner",
		Size = UDim2.fromScale(0.62, 0.62),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = UI.lighten(UI.Theme.coin, 0.35),
		Parent = coin,
	}, { UI.round(), UI.stroke(UI.darken(UI.Theme.gold, 0.15), math.max(1, size / 26)) })
	UI.text({
		text = "$",
		size = UDim2.fromScale(0.62, 0.62),
		position = UDim2.fromScale(0.5, 0.53),
		anchor = Vector2.new(0.5, 0.5),
		color = UI.darken(UI.Theme.gold, 0.35),
		noOutline = true,
		maxTextSize = 40,
		parent = coin,
	})
	if parent then
		coin.Parent = parent
	end
	return coin
end

-- A coin icon followed by an amount, laid out in a row.
function UI.price(props: {
	amount: string,
	size: UDim2,
	position: UDim2?,
	anchor: Vector2?,
	color: Color3?,
	order: number?,
	parent: Instance?,
}): (Frame, TextLabel)
	local row = UI.new("Frame", {
		Name = "Price",
		BackgroundTransparency = 1,
		Size = props.size,
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		LayoutOrder = props.order or 0,
		Parent = props.parent,
	}, {
		UI.list(
			Enum.FillDirection.Horizontal,
			6,
			Enum.HorizontalAlignment.Center,
			Enum.VerticalAlignment.Center
		),
	}) :: Frame
	local height = props.size.Y.Offset
	local coin = UI.coin(math.floor(height * 0.85), row)
	coin.LayoutOrder = 1
	local label = UI.text({
		text = props.amount,
		size = UDim2.new(0, 0, 1, 0),
		color = props.color or UI.Theme.money,
		noOutline = props.color == nil,
		maxTextSize = height,
		order = 2,
		parent = row,
	})
	label.AutomaticSize = Enum.AutomaticSize.X
	label.TextScaled = false
	label.TextWrapped = false
	label.TextSize = math.floor(height * 0.95)
	return row, label
end

-- ===== Motion =====

function UI.pop(gui: GuiObject, from: number?)
	local scale = gui:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = UI.new("UIScale", { Parent = gui })
	end
	local s = scale :: UIScale
	s.Scale = from or 1.15
	TweenService:Create(s, UI.BOUNCY, { Scale = 1 }):Play()
end

-- ===== Screens =====

function UI.topInset(): number
	local ok, topLeft = pcall(function()
		return (GuiService:GetGuiInset())
	end)
	if ok and typeof(topLeft) == "Vector2" and topLeft.Y > 0 then
		return topLeft.Y
	end
	return 58
end

-- UIScale that fits the design canvas to a viewport.
function UI.scaleFor(viewport: Vector2): number
	return math.clamp(math.min(viewport.X / UI.DESIGN.X, viewport.Y / UI.DESIGN.Y), 0.62, 1.3)
end

function UI.viewportSize(): Vector2
	local camera = Workspace.CurrentCamera
	return if camera then camera.ViewportSize else Vector2.new(1280, 720)
end

-- A ScreenGui that scales its contents to the screen size.
function UI.screen(name: string, displayOrder: number): ScreenGui
	local gui = UI.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		DisplayOrder = displayOrder,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = false,
	}) :: ScreenGui
	local scale = UI.new("UIScale", { Parent = gui }) :: UIScale
	local function update()
		scale.Scale = UI.scaleFor(UI.viewportSize())
	end
	update()
	local camera = Workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	end
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return gui
end

-- Usable design-pixel size of a screen (inside the top bar inset).
function UI.canvasSize(): Vector2
	local viewport = UI.viewportSize()
	local scale = UI.scaleFor(viewport)
	return Vector2.new(viewport.X / scale, (viewport.Y - UI.topInset()) / scale)
end

-- 3D preview of a model in the UI. The model faces -Z, so the camera sits in front.
function UI.viewport(model: Model, size: UDim2, parent: Instance?, angle: number?): ViewportFrame
	local frame = UI.new("ViewportFrame", {
		Name = "Preview",
		BackgroundTransparency = 1,
		Size = size,
		Ambient = Color3.fromRGB(200, 196, 210),
		LightColor = Color3.fromRGB(255, 248, 235),
		LightDirection = Vector3.new(-0.5, -1, 0.6),
	}) :: ViewportFrame
	local camera = UI.new("Camera", { FieldOfView = 32, Parent = frame }) :: Camera
	frame.CurrentCamera = camera
	model.Parent = frame
	local cf, extents = model:GetBoundingBox()
	local radius = extents.Magnitude / 2
	local distance = radius / math.tan(math.rad(camera.FieldOfView / 2)) * 1.0
	local yaw = math.rad(angle or 35)
	local direction = Vector3.new(-math.sin(yaw), 0.32, -math.cos(yaw)).Unit
	camera.CFrame = CFrame.lookAt(cf.Position + direction * distance, cf.Position)
	if parent then
		frame.Parent = parent
	end
	return frame
end

return UI
