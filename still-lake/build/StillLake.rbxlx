            <string name="Name">Clock</string>
            <string name="Source"><![CDATA[--!strict
-- One clock for everything: the server's Unix time (synced to clients), so the
-- sun sets at the same moment on every screen.

local Clock = {}

function Clock.now(): number
	return workspace:GetServerTimeNow()
end

return Clock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Frames</string>
            <string name="Source"><![CDATA[--!strict
-- Robust ways to orient a part along a direction. CFrame.lookAt is undefined
-- when the direction is straight up or down (it can produce NaN rotations),
-- which broke vertical legs, so every "point this along that" goes through here.

local Frames = {}

local X_AXIS = Vector3.new(1, 0, 0)
local Y_AXIS = Vector3.new(0, 1, 0)
local Z_AXIS = Vector3.new(0, 0, 1)

-- CFrame at `center` whose local X axis points along `direction`
-- (Roblox cylinders run along X).
function Frames.alongX(center: Vector3, direction: Vector3): CFrame
	local x = direction.Unit
	local reference = if math.abs(x.Y) > 0.99 then Z_AXIS else Y_AXIS
	local z = x:Cross(reference).Unit
	local y = z:Cross(x).Unit
	return CFrame.fromMatrix(center, x, y, z)
end

-- CFrame at `center` whose local Z axis points along `direction`
-- (stretched spheres and blocks use Z as their long axis).
function Frames.alongZ(center: Vector3, direction: Vector3): CFrame
	local z = direction.Unit
	local reference = if math.abs(z.Y) > 0.99 then X_AXIS else Y_AXIS
	local x = reference:Cross(z).Unit
	local y = z:Cross(x).Unit
	return CFrame.fromMatrix(center, x, y, z)
end

-- Facing a point on the horizontal plane (the usual "look at" for characters).
function Frames.facing(position: Vector3, target: Vector3): CFrame
	local flat = Vector3.new(target.X - position.X, 0, target.Z - position.Z)
	if flat.Magnitude < 1e-4 then
		return CFrame.new(position)
	end
	return CFrame.lookAt(position, position + flat)
end

return Frames
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Rng</string>
            <string name="Source"><![CDATA[--!strict
-- Deterministic pseudo-random numbers (mulberry32). Used so the scenery comes
-- out the same on every server. Pure: runs under Lune too.

local Rng = {}

local TWO_32 = 4294967296

local function imul(a: number, b: number): number
	local ah = bit32.rshift(a, 16)
	local al = bit32.band(a, 0xFFFF)
	local bh = bit32.rshift(b, 16)
	local bl = bit32.band(b, 0xFFFF)
	local high = bit32.band(ah * bl + al * bh, 0xFFFF)
	return (al * bl + high * 65536) % TWO_32
end

export type Generator = {
	next: () -> number,
	int: (min: number, max: number) -> number,
}

-- Mix two integers into a 32-bit seed.
function Rng.hash(a: number, b: number): number
	local h = (math.floor(a) % TWO_32 + imul(math.floor(b) % TWO_32, 0x9E3779B1)) % TWO_32
	h = bit32.bxor(h, bit32.rshift(h, 16))
	h = imul(h, 0x85EBCA6B)
	h = bit32.bxor(h, bit32.rshift(h, 13))
	h = imul(h, 0xC2B2AE35)
	h = bit32.bxor(h, bit32.rshift(h, 16))
	return h
end

function Rng.new(seed: number): Generator
	local state = math.floor(seed) % TWO_32

	local function nextFloat(): number
		state = (state + 0x6D2B79F5) % TWO_32
		local t = state
		t = imul(bit32.bxor(t, bit32.rshift(t, 15)), bit32.bor(t, 1))
		t = bit32.bxor(t, (t + imul(bit32.bxor(t, bit32.rshift(t, 7)), bit32.bor(t, 61))) % TWO_32)
		return bit32.bxor(t, bit32.rshift(t, 14)) / TWO_32
	end

	local function int(min: number, max: number): number
		return min + math.floor(nextFloat() * (max - min + 1))
	end

	return {
		next = nextFloat,
		int = int,
	}
end

return Rng
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
-- Minimal signal for module-to-module events (no Instances, no yielding).

export type Connection = { disconnect: () -> () }

export type Signal<T...> = {
	connect: (self: Signal<T...>, fn: (T...) -> ()) -> Connection,
	fire: (self: Signal<T...>, T...) -> (),
}

local Signal = {}

function Signal.new<T...>(): Signal<T...>
	local handlers: { (T...) -> () } = {}

	local self = {}

	function self.connect(_: any, fn: (T...) -> ()): Connection
		table.insert(handlers, fn)
		return {
			disconnect = function()
				local index = table.find(handlers, fn)
				if index then
					table.remove(handlers, index)
				end
			end,
		}
	end

	function self.fire(_: any, ...: T...)
		for _, fn in table.clone(handlers) do
			task.spawn(fn, ...)
		end
	end

	return (self :: any) :: Signal<T...>
end

return Signal
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="25">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="26">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Still Lake server entry point. Two-phase start: init() every system (in
-- name order), then start() every system in its own thread.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

-- Remotes must exist before any system registers a handler in init().
Net.serverInit()

local Systems = script:WaitForChild("Systems")

type System = {
	init: (() -> ())?,
	start: (() -> ())?,
}

local loaded: { [string]: System } = {}
local order: { string } = {}
for _, child in Systems:GetChildren() do
	if child:IsA("ModuleScript") then
		loaded[child.Name] = require(child) :: any
		table.insert(order, child.Name)
	end
end
table.sort(order)

for _, name in order do
	local system = loaded[name]
	if system.init then
		system.init()
	end
end

for _, name in order do
	local system = loaded[name]
	if system.start then
		task.spawn(system.start)
	end
end

print("[StillLake] server started")
]]></string>
      </Properties>
      <Item class="Folder" referent="27">
        <Properties>
          <string name="Name">Lib</string>
        </Properties>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Access</string>
            <string name="Source"><![CDATA[--!strict
-- Who may use the test tools: everyone in Studio, and in live games the
-- game's owner plus anyone in Config.DEV_USER_IDS.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local Access = {}

function Access.isDev(player: Player): boolean
	if RunService:IsStudio() then
		return true
	end
	if table.find(Config.DEV_USER_IDS, player.UserId) then
		return true
	end
	return game.CreatorType == Enum.CreatorType.User and game.CreatorId == player.UserId
end

return Access
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">BoardData</string>
            <string name="Source"><![CDATA[--!strict
-- The two global leaderboards beside the cabin (built by Scenery, filled in
-- by the Leaderboards system).

export type Key = "Skips" | "Distance"

export type Board = {
	key: Key,
	title: string,
	store: string, -- OrderedDataStore name
	color: Color3,
}

local BoardData = {
	ROWS = 10,
	BOARDS = {
		{
			key = "Skips",
			title = "🌊 Most Skips",
			store = "StillLake_LB_Skips_v1",
			color = Color3.fromRGB(92, 156, 222),
		},
		{
			key = "Distance",
			title = "📏 Longest Throw",
			store = "StillLake_LB_Distance_v1",
			color = Color3.fromRGB(232, 148, 76),
		},
	} :: { Board },
}

return BoardData
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Boards</string>
            <string name="Source"><![CDATA[--!strict
-- A wooden leaderboard: two posts, a cream face and a SurfaceGui with a title
-- and BoardData.ROWS rows, each with Rank / Player / Score labels for the
-- Leaderboards system to fill in.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Palette = require(ReplicatedStorage.Shared.Palette)
local BoardData = require(script.Parent.BoardData)
local Build = require(script.Parent.Build)

local Boards = {}

local INK = Color3.fromRGB(58, 44, 40)

type Column = { name: string, x: number, width: number, align: Enum.TextXAlignment }
local COLUMNS: { Column } = {
	{ name = "Rank", x = 0.02, width = 0.14, align = Enum.TextXAlignment.Center },
	{ name = "Player", x = 0.17, width = 0.5, align = Enum.TextXAlignment.Left },
	{ name = "Score", x = 0.67, width = 0.31, align = Enum.TextXAlignment.Right },
}

-- `base` stands on the ground; its -Z (front) is the readable side.
function Boards.build(
	key: string,
	title: string,
	color: Color3,
	base: CFrame,
	parent: Instance
): SurfaceGui
	local model = Build.model(key, parent)
	for _, side in { -1, 1 } do
		Build.block(
			Vector3.new(0.9, 13, 0.9),
			base * CFrame.new(side * 4.6, 6.5, 0.6),
			Palette.woodDark,
			model,
			{ name = "Post", shadow = false }
		)
	end
	local face = Build.block(
		Vector3.new(9.6, 10.5, 0.6),
		base * CFrame.new(0, 7.4, 0),
		Palette.cream,
		model,
		{ name = "Face", decor = true }
	)
	-- a little roof keeps the rain off
	Build.block(
		Vector3.new(11, 0.6, 2),
		base * CFrame.new(0, 13.1, 0.3),
		Palette.roof,
		model,
		{ name = "Cap", decor = true, shadow = false }
	)

	local gui = Instance.new("SurfaceGui")
	gui.Name = "Board"
	gui.Face = Enum.NormalId.Front
	gui.LightInfluence = 0
	gui.PixelsPerStud = 40
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.Parent = face

	local heading = Instance.new("TextLabel")
	heading.Name = "Title"
	heading.BackgroundColor3 = color
	heading.BorderSizePixel = 0
	heading.Size = UDim2.fromScale(1, 0.13)
	heading.Font = Enum.Font.FredokaOne
	heading.Text = title
	heading.TextScaled = true
	heading.TextColor3 = Color3.new(1, 1, 1)
	local stroke = Instance.new("UIStroke")
	stroke.Color = INK
	stroke.Thickness = 2
	stroke.Parent = heading
	heading.Parent = gui

	local rowHeight = 0.85 / BoardData.ROWS
	for row = 1, BoardData.ROWS do
		local frame = Instance.new("Frame")
		frame.Name = "Row" .. row
		frame.BackgroundColor3 = if row % 2 == 0
			then Color3.fromRGB(246, 236, 216)
			else Color3.fromRGB(255, 250, 240)
		frame.BorderSizePixel = 0
		frame.Position = UDim2.fromScale(0, 0.14 + (row - 1) * rowHeight)
		frame.Size = UDim2.fromScale(1, rowHeight)
		frame.Parent = gui
		for _, column in COLUMNS do
			local text = Instance.new("TextLabel")
			text.Name = column.name
			text.BackgroundTransparency = 1
			text.Position = UDim2.fromScale(column.x, 0.12)
			text.Size = UDim2.fromScale(column.width, 0.76)
			text.Font = Enum.Font.FredokaOne
			text.TextScaled = true
			text.TextXAlignment = column.align
			text.TextColor3 = INK
			text.Text = if column.name == "Rank" then tostring(row) else ""
			text.Parent = frame
		end
	end
	return gui
end

return Boards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Build</string>
            <string name="Source"><![CDATA[--!strict
-- Part-building helpers for the generated world. Every part is anchored
-- SmoothPlastic. Purely decorative parts can skip touch/query work (`decor`)
-- and small ones can skip shadows, which keeps a part-built world cheap on phones.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Frames = require(ReplicatedStorage.Shared.Util.Frames)

local Build = {}

export type Options = {
	name: string?,
	material: Enum.Material?,
	transparency: number?,
	reflectance: number?,
	collide: boolean?, -- default true
	shadow: boolean?, -- default true
	decor: boolean?, -- no Touched events or raycasts
}

local function finish(p: BasePart, color: Color3, parent: Instance, options: Options?): ()
	p.Anchored = true
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	if options then
		if options.name then
			p.Name = options.name
		end
		if options.material then
			p.Material = options.material
		end
		if options.transparency then
			p.Transparency = options.transparency
		end
		if options.reflectance then
			p.Reflectance = options.reflectance
		end
		if options.collide == false then
			p.CanCollide = false
		end
		if options.shadow == false then
			p.CastShadow = false
		end
		if options.decor then
			p.CanTouch = false
			p.CanQuery = false
		end
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
end

function Build.block(
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	parent: Instance,
	options: Options?
): Part
	local p = Instance.new("Part")
	p.Name = "Block"
	p.Size = size
	p.CFrame = cframe
	finish(p, color, parent, options)
	return p
end

-- Wedge: the slope rises toward -Z (front), full height at the back (+Z).
function Build.wedge(
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	parent: Instance,
	options: Options?
): WedgePart
	local p = Instance.new("WedgePart")
	p.Name = "Wedge"
	p.Size = size
	p.CFrame = cframe
	finish(p, color, parent, options)
	return p
end

function Build.ball(
	diameter: number,
	position: Vector3,
	color: Color3,
	parent: Instance,
	options: Options?
): Part
	local p = Instance.new("Part")
	p.Name = "Ball"
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(diameter, diameter, diameter)
	p.CFrame = CFrame.new(position)
	finish(p, color, parent, options)
	return p
end

-- Stretched sphere (a sphere mesh fills the part's box).
function Build.ellipsoid(
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	parent: Instance,
	options: Options?
): Part
	local p = Instance.new("Part")
	p.Name = "Ellipsoid"
	p.Size = size
	p.CFrame = cframe
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	finish(p, color, parent, options)
	return p
end

-- Upright cylinder centred on `cframe` (Roblox cylinders run along X, so this
-- turns X onto the frame's Y axis).
function Build.disc(
	diameter: number,
	height: number,
	cframe: CFrame,
	color: Color3,
	parent: Instance,
	options: Options?
): Part
	local p = Instance.new("Part")
	p.Name = "Disc"
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(height, diameter, diameter)
	p.CFrame = cframe * CFrame.Angles(0, 0, math.rad(90))
	finish(p, color, parent, options)
	return p
end

-- Cylinder from point a to point b.
function Build.rod(
	a: Vector3,
	b: Vector3,
	diameter: number,
	color: Color3,
	parent: Instance,
	options: Options?
): Part
	local p = Instance.new("Part")
	p.Name = "Rod"
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new((b - a).Magnitude, diameter, diameter)
	p.CFrame = Frames.alongX((a + b) / 2, b - a)
	finish(p, color, parent, options)
	return p
end

-- Flat-topped bar from a to b (its up side stays as close to world-up as it can).
function Build.beam(
	a: Vector3,
	b: Vector3,
	width: number,
	thickness: number,
	color: Color3,
	parent: Instance,
	options: Options?
): Part
	local p = Instance.new("Part")
	p.Name = "Beam"
	p.Size = Vector3.new(width, thickness, (b - a).Magnitude)
	p.CFrame = Frames.alongZ((a + b) / 2, b - a)
	finish(p, color, parent, options)
	return p
end

-- Flat ring of blocks around `center` (an upright frame), e.g. a circular path.
function Build.ring(
	center: CFrame,
	radius: number,
	width: number,
	height: number,
	segments: number,
	color: Color3,
	parent: Instance,
	options: Options?
): { Part }
	local parts = {}
	local step = 2 * math.pi / segments
	-- Segment length covering the outer edge so neighbours meet without gaps.
	local length = 2 * (radius + width / 2) * math.tan(step / 2) + 0.05
	for i = 0, segments - 1 do
		local angle = i * step
		local cf = center * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -radius)
		table.insert(
			parts,
			Build.block(Vector3.new(length, height, width), cf, color, parent, options)
		)
	end
	return parts
end

-- Ground position on a circle (angle 0 points along +Z, matching the plots).
function Build.polar(angle: number, radius: number, y: number?): Vector3
	return Vector3.new(math.sin(angle) * radius, y or 0, math.cos(angle) * radius)
end

function Build.model(name: string, parent: Instance?): Model
	local m = Instance.new("Model")
	m.Name = name
	if parent then
		m.Parent = parent
	end
	return m
end

return Build
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Notify</string>
            <string name="Source"><![CDATA[--!strict
-- Little messages that pop up on a player's screen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

export type Style = "info" | "good" | "bad" | "rare"

local Notify = {}

function Notify.send(player: Player, text: string, style: Style?)
	Net.fire(player, "Notify", text, style or "info")
end

function Notify.all(text: string, style: Style?)
	Net.fireAll("Notify", text, style or "info")
end

return Notify
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Props</string>
            <string name="Source"><![CDATA[--!strict
-- Soft, chunky props built from parts: rounded shapes, 2-3 shades per
-- material. Each builder takes a ground position, a size multiplier and a
-- random generator (so layouts are repeatable).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Frames = require(ReplicatedStorage.Shared.Util.Frames)
local Palette = require(ReplicatedStorage.Shared.Palette)
local Rng = require(ReplicatedStorage.Shared.Util.Rng)
local Build = require(script.Parent.Build)

local Props = {}

type Gen = Rng.Generator

local LEAF = { decor = true, collide = false }
local SMALL = { decor = true, collide = false, shadow = false }

local function between(gen: Gen, a: number, b: number): number
	return a + (b - a) * gen.next()
end

local function pick<T>(gen: Gen, list: { T }): T
	return list[gen.int(1, #list)]
end

local function horizontal(angle: number): Vector3
	return Vector3.new(math.sin(angle), 0, math.cos(angle))
end

-- Leafy round tree: a short trunk under a cluster of soft blobs.
function Props.tree(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Tree", parent)
	local h = between(gen, 7.5, 9.5) * s
	local lean = horizontal(gen.next() * math.pi * 2) * between(gen, 0.3, 1.2) * s
	local mid = base + Vector3.new(0, h * 0.5, 0) + lean * 0.3
	local top = base + Vector3.new(0, h, 0) + lean
	Build.ellipsoid(Vector3.new(3.4, 1.4, 3.4) * s, CFrame.new(base), Palette.woodDark, m, LEAF)
	Build.rod(base - Vector3.new(0, 0.5, 0), mid, 2.1 * s, Palette.wood, m, { name = "Trunk" })
	Build.rod(mid, top, 1.6 * s, Palette.wood, m, { name = "Trunk" })

	local yaw = CFrame.Angles(0, gen.next() * math.pi * 2, 0)
	local c = top + Vector3.new(0, 1.6 * s, 0)
	local function blob(size: Vector3, offset: Vector3, color: Color3)
		Build.ellipsoid(
			size * s,
			CFrame.new(c + yaw:VectorToWorldSpace(offset * s)),
			color,
			m,
			LEAF
		)
	end
	blob(Vector3.new(10.5, 8.5, 10.5), Vector3.zero, Palette.leaf)
	blob(Vector3.new(7, 6, 7), Vector3.new(4.2, -1.4, 1.2), Palette.leafDark)
	blob(Vector3.new(6.5, 5.5, 6.5), Vector3.new(-3.8, -1, -2), Palette.leafDark)
	blob(Vector3.new(6.5, 5.2, 6.5), Vector3.new(0.8, 3.3, -0.6), Palette.leafLight)
	if gen.next() < 0.3 then
		-- a few fruits
		for i = 1, 3 do
			local a = i * 2.1 + gen.next()
			local p = c
				+ Vector3.new(math.sin(a) * 4.6, between(gen, -2.2, 0.5), math.cos(a) * 4.6) * s
			Build.ball(
				0.9 * s,
				p,
				if gen.next() < 0.5 then Palette.red else Palette.orange,
				m,
				SMALL
			)
		end
	end
	return m
end

-- Tiered pine tree.
function Props.pine(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Pine", parent)
	Build.rod(
		base - Vector3.new(0, 0.5, 0),
		base + Vector3.new(0, 4 * s, 0),
		1.5 * s,
		Palette.woodDark,
		m
	)
	local tiers = { { 9, 5, 4.6 }, { 7.2, 4.6, 7.6 }, { 5.4, 4.2, 10.3 }, { 3.2, 3.4, 12.6 } }
	-- each tier drifts a little so no two pines look stamped
	local drift = horizontal(gen.next() * math.pi * 2) * 0.35 * s
	for i, t in tiers do
		local color = if i % 2 == 1 then Palette.pine else Palette.pineDark
		if i == #tiers then
			color = Palette.leaf
		end
		Build.ellipsoid(
			Vector3.new(t[1], t[2], t[1]) * s,
			CFrame.new(base + Vector3.new(0, t[3] * s, 0) + drift * (i - 1)),
			color,
			m,
			LEAF
		)
	end
	return m
end

-- Low fern of drooping leaves.
function Props.fern(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Fern", parent)
	local leaves = 7
	local spin = gen.next() * math.pi * 2
	for i = 1, leaves do
		local a = spin + i * (2 * math.pi / leaves)
		local rise = math.rad(between(gen, 30, 48))
		local dir = horizontal(a) * math.cos(rise) + Vector3.new(0, math.sin(rise), 0)
		Build.ellipsoid(
			Vector3.new(1.5, 0.3, 6) * s,
			Frames.alongZ(base + dir * 2.7 * s + Vector3.new(0, 0.2, 0), dir),
			if i % 2 == 0 then Palette.leafDark else Palette.leaf,
			m,
			SMALL
		)
	end
	Build.ball(1.4 * s, base + Vector3.new(0, 0.4 * s, 0), Palette.leafDark, m, SMALL)
	return m
end

-- Round bush, sometimes with berries.
function Props.bush(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Bush", parent)
	local yaw = CFrame.Angles(0, gen.next() * math.pi * 2, 0)
	local function blob(size: Vector3, offset: Vector3, color: Color3)
		Build.ellipsoid(
			size * s,
			CFrame.new(base + yaw:VectorToWorldSpace(offset * s)),
			color,
			m,
			LEAF
		)
	end
	blob(Vector3.new(5, 4, 5), Vector3.new(0, 1.5, 0), Palette.leaf)
	blob(Vector3.new(3.6, 3, 3.6), Vector3.new(2.3, 1, 0.8), Palette.leafDark)
	blob(Vector3.new(3.4, 2.8, 3.4), Vector3.new(-2.1, 0.9, -0.9), Palette.leafDark)
	blob(Vector3.new(3, 2.6, 3), Vector3.new(0.4, 2.8, -0.3), Palette.leafLight)
	if gen.next() < 0.45 then
		local berry = if gen.next() < 0.5 then Palette.pink else Palette.red
		for i = 1, 4 do
			local a = i * 1.7 + gen.next()
			local p = base
				+ yaw:VectorToWorldSpace(
					Vector3.new(math.sin(a) * 2.4, 1.6 + math.cos(a * 3) * 0.8, math.cos(a) * 2.4)
						* s
				)
			Build.ball(0.6 * s, p, berry, m, SMALL)
		end
	end
	return m
end

-- A little patch of flowers.
function Props.flowers(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Flowers", parent)
	Build.ellipsoid(Vector3.new(4.4, 0.7, 4.4) * s, CFrame.new(base), Palette.grassDark, m, SMALL)
	local color = pick(gen, Palette.FLOWERS)
	for i = 1, 5 do
		local a = i * 1.26 + gen.next() * 0.5
		local r = between(gen, 0.4, 1.7) * s
		local foot = base + Vector3.new(math.sin(a) * r, 0, math.cos(a) * r)
		local height = between(gen, 0.9, 1.5) * s
		local head = foot + Vector3.new(0, height, 0)
		Build.rod(foot, head, 0.18 * s, Palette.grassDark, m, SMALL)
		local petals = if gen.next() < 0.75 then color else pick(gen, Palette.FLOWERS)
		Build.ellipsoid(Vector3.new(1.2, 0.45, 1.2) * s, CFrame.new(head), petals, m, SMALL)
		local middle = if petals == Palette.yellow then Palette.orange else Palette.yellow
		Build.ball(0.45 * s, head + Vector3.new(0, 0.18 * s, 0), middle, m, SMALL)
	end
	return m
end

-- A mossy boulder.
function Props.rock(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Rock", parent)
	local yaw = CFrame.Angles(0, gen.next() * math.pi * 2, 0)
	Build.ellipsoid(
		Vector3.new(4.4, 2.8, 3.6) * s,
		CFrame.new(base + Vector3.new(0, 0.7 * s, 0)) * yaw,
		Palette.rock,
		m,
		{ decor = true }
	)
	Build.ellipsoid(
		Vector3.new(2.6, 2, 2.4) * s,
		CFrame.new(base + yaw:VectorToWorldSpace(Vector3.new(2, 0.4, 0.9) * s)) * yaw,
		Palette.rockDark,
		m,
		{ decor = true, collide = false }
	)
	Build.ellipsoid(
		Vector3.new(2.6, 1, 2.2) * s,
		CFrame.new(base + Vector3.new(-0.3, 1.8, -0.2) * s) * yaw,
		Palette.rockLight,
		m,
		SMALL
	)
	return m
end

-- A soft cloud.
function Props.cloud(center: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Cloud", parent)
	local options = { decor = true, collide = false, shadow = false }
	local yaw = CFrame.Angles(0, gen.next() * math.pi * 2, 0)
	local puffs = {
		{ Vector3.new(26, 13, 18), Vector3.new(0, 0, 0) },
		{ Vector3.new(18, 12, 15), Vector3.new(-12, -1.5, 2) },
		{ Vector3.new(17, 11, 14), Vector3.new(12, -2, -1) },
		{ Vector3.new(15, 12, 13), Vector3.new(3, 4.5, 1) },
		{ Vector3.new(30, 6, 20), Vector3.new(0, -4, 0) },
	}
	for _, puff in puffs do
		Build.ellipsoid(
			puff[1] * s,
			CFrame.new(center + yaw:VectorToWorldSpace(puff[2] * s)) * yaw,
			Palette.white,
			m,
			options
		)
	end
	return m
end

return Props
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Scenery</string>
            <string name="Source"><![CDATA[--!strict
-- Builds Still Lake from parts when the server starts: a round lake with
-- sandy shallows and a pebble beach, three wooden docks, a cabin, a campfire
-- with log seats, a lantern-lit path, reeds and lily pads, forest, snowy
-- mountains on the horizon and fireflies for the night. Decorations come from
-- a fixed random seed, so every server looks the same.
--
-- Heights: water surface Y = 0, beach top BEACH_TOP, grass top GRASS_TOP.
-- Angles: 0 points along +Z, like Build.polar.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Lake = require(ReplicatedStorage.Shared.Lake)
local Palette = require(ReplicatedStorage.Shared.Palette)
local Rng = require(ReplicatedStorage.Shared.Util.Rng)
local Tags = require(ReplicatedStorage.Shared.Tags)
local BoardData = require(script.Parent.BoardData)
local Boards = require(script.Parent.Boards)
local Build = require(script.Parent.Build)
local Props = require(script.Parent.Props)

local Scenery = {}

local TAU = 2 * math.pi
local R = Config.LAKE_RADIUS
local BEACH_OUT = R + Config.SHORE_WIDTH

Scenery.BEACH_TOP = 0.35
Scenery.GRASS_TOP = 0.8
Scenery.DOCK_TOP = Lake.DOCK_TOP
Scenery.DOCK_INNER = Lake.DOCK_INNER
Scenery.DOCK_OUTER = Lake.DOCK_OUTER
Scenery.DOCK_WIDTH = Lake.DOCK_WIDTH
Scenery.DOCK_ANGLES = Lake.DOCK_ANGLES
Scenery.WALL_HEIGHT = 12 -- invisible walls: taller than anyone can jump
Scenery.PATH_RADIUS = BEACH_OUT + 8
Scenery.PLAY_RADIUS = 340 -- an invisible fence keeps everyone this close
Scenery.CABIN_ANGLE = math.rad(200)
Scenery.CABIN_RADIUS = 162
Scenery.CAMPFIRE_ANGLE = math.rad(75)
Scenery.CAMPFIRE_RADIUS = 148
Scenery.SPAWN_ANGLE = math.rad(27)
Scenery.SPAWN_RADIUS = BEACH_OUT + 14
Scenery.BOARD_ANGLES = { math.rad(184), math.rad(216) }
Scenery.BOARD_RADIUS = BEACH_OUT + 16

export type Built = {
	root: Folder,
	spawn: SpawnLocation,
	boards: { [string]: SurfaceGui }, -- "Skips" / "Distance"
}

type Spot = { position: Vector3, radius: number }

local function polar(angle: number, radius: number, y: number?): Vector3
	return Build.polar(angle, radius, y)
end

-- Faces the centre of the lake from `position` (its -Z looks at the water).
local function facingLake(position: Vector3): CFrame
	return CFrame.lookAt(position, Vector3.new(0, position.Y, 0))
end

local function angleGap(a: number, b: number): number
	local d = (a - b) % TAU
	return math.min(d, TAU - d)
end

local function nearDock(angle: number, radius: number, margin: number): boolean
	for _, dockAngle in Scenery.DOCK_ANGLES do
		if angleGap(angle, dockAngle) * radius < Scenery.DOCK_WIDTH / 2 + margin then
			return true
		end
	end
	return false
end

-- ===== Ground and water =====

local function buildGround(root: Instance)
	local land = Build.model("Land", root)
	-- lakebed under everything (only the part under the water shows)
	Build.disc(2 * 480, 2, CFrame.new(0, -9, 0), Color3.fromRGB(38, 82, 110), land, {
		name = "Lakebed",
		shadow = false,
	})
	-- sandy shallows near the shore, seen through the water
	Build.ring(CFrame.new(0, -1.6, 0), R - 9, 18, 1.2, 96, Palette.sand, land, {
		name = "Shallows",
		decor = true,
		shadow = false,
	})
	Build.ring(CFrame.new(0, -3.4, 0), R - 26, 18, 1.2, 96, Palette.pebbleDark, land, {
		name = "Shelf",
		decor = true,
		shadow = false,
	})
	Build.disc(2 * (R + 1), 0.6, CFrame.new(0, -0.3, 0), Palette.water, land, {
		name = "Water",
		transparency = 0.32,
		reflectance = 0.08,
		collide = false,
		decor = true,
		shadow = false,
	})
	-- pebble beach and grass, as rings around the lake
	Build.ring(
		CFrame.new(0, Scenery.BEACH_TOP - 0.75, 0),
		R + Config.SHORE_WIDTH / 2,
		Config.SHORE_WIDTH,
		1.5,
		120,
		Palette.pebble,
		land,
		{ name = "Beach", shadow = false }
	)
	local grassY = Scenery.GRASS_TOP - 1
	Build.ring(CFrame.new(0, grassY, 0), BEACH_OUT + 27, 54, 2, 120, Palette.grass, land, {
		name = "Meadow",
		shadow = false,
	})
	Build.ring(CFrame.new(0, grassY, 0), BEACH_OUT + 94, 80, 2, 120, Palette.grass, land, {
		name = "Meadow",
		shadow = false,
	})
	local midGrass = Palette.grass:Lerp(Palette.grassDark, 0.45)
	Build.ring(CFrame.new(0, grassY - 0.05, 0), BEACH_OUT + 184, 100, 2, 140, midGrass, land, {
		name = "Meadow",
		shadow = false,
	})
	Build.ring(
		CFrame.new(0, grassY - 0.1, 0),
		BEACH_OUT + 290,
		112,
		2,
		140,
		Palette.grassDark,
		land,
		{
			name = "Foothills",
			shadow = false,
		}
	)
	-- out to the mountains, so there is never a gap at the horizon
	Build.ring(CFrame.new(0, grassY - 0.15, 0), 590, 244, 2, 160, Palette.moss, land, {
		name = "Foothills",
		shadow = false,
		decor = true,
	})
	-- the walking path around the lake
	Build.ring(
		CFrame.new(0, Scenery.GRASS_TOP - 0.45, 0),
		Scenery.PATH_RADIUS,
		4.5,
		1,
		120,
		Palette.path,
		land,
		{ name = "Path", shadow = false, decor = true }
	)
end

-- Invisible walls: one along the water's edge and around each dock so
-- nobody walks or jumps into the lake, one at the edge of the play area.
-- They ignore raycasts, so the camera never bumps into them.
local FENCE: Build.Options = { name = "Fence", transparency = 1, shadow = false }

local function wall(size: Vector3, cframe: CFrame, parent: Instance)
	local part = Build.block(size, cframe, Palette.white, parent, FENCE)
	part.CanQuery = false
	part.CanTouch = false
end

local function buildFences(root: Instance)
	local fences = Build.model("Fences", root)
	local h = Scenery.WALL_HEIGHT
	local radius = R + 1
	-- the shoreline, in short straight pieces; the docks cut gaps in it
	local segments = 180
	local step = TAU / segments
	local length = 2 * radius * math.tan(step / 2) + 0.1
	for i = 0, segments - 1 do
		local angle = i * step
		if not nearDock(angle, radius, length / 2) then
			wall(
				Vector3.new(length, h, 0.5),
				CFrame.lookAt(polar(angle, radius, h / 2 - 1), Vector3.new(0, h / 2 - 1, 0)),
				fences
			)
		end
	end
	-- each dock: walls down both sides (from the beach out) and across the end,
	-- plus short pieces along the shore that close the gap beside it
	local half = Scenery.DOCK_WIDTH / 2
	for _, angle in Scenery.DOCK_ANGLES do
		local inner, outerEnd = Scenery.DOCK_INNER, R + 3
		local frame = CFrame.lookAt(polar(angle, (inner + outerEnd) / 2), polar(angle, inner))
		local dockLength = outerEnd - inner
		for _, side in { -1, 1 } do
			wall(
				Vector3.new(0.5, h, dockLength),
				frame * CFrame.new(side * (half + 0.25), h / 2 - 1, 0),
				fences
			)
			-- along the shore from the dock's side to the next shoreline piece
			local shore = CFrame.lookAt(polar(angle, radius), Vector3.zero)
			local span = step * radius + 2.5
			wall(
				Vector3.new(span, h, 0.5),
				shore * CFrame.new(side * (half + 0.5 + span / 2), h / 2 - 1, 0),
				fences
			)
		end
		wall(
			Vector3.new(Scenery.DOCK_WIDTH + 1, h, 0.5),
			frame * CFrame.new(0, h / 2 - 1, -dockLength / 2 - 0.25),
			fences
		)
	end
	local outer = Build.ring(
		CFrame.new(0, 20, 0),
		Scenery.PLAY_RADIUS,
		1,
		44,
		120,
		Palette.white,
		fences,
		FENCE
	)
	for _, part in outer do
		part.CanQuery = false
		part.CanTouch = false
	end
end

-- ===== Mountains and sky =====

local function buildHorizon(root: Instance)
	local horizon = Build.model("Horizon", root)
	local gen = Rng.new(31)
	local options = { decor = true, collide = false, shadow = false }
	-- each mountain is a stack of soft tiers narrowing to a snowy peak
	local tiers = {
		{ w = 1, h = 0.7, y = 0.18 },
		{ w = 0.6, h = 0.56, y = 0.5 },
		{ w = 0.3, h = 0.3, y = 0.78 },
	}
	local count = 16
	for i = 0, count - 1 do
		local angle = i * (TAU / count) + (gen.next() - 0.5) * 0.25
		local width = 190 + gen.next() * 90
		local height = 95 + gen.next() * 70
		local radius = 440 + gen.next() * 50
		local base = polar(angle, radius, 0)
		local rock = if i % 2 == 0 then Palette.mountain else Palette.mountainDark
		local turn = CFrame.Angles(0, angle + gen.next(), 0)
		for t, tier in tiers do
			local snowy = t == #tiers and height > 115
			Build.ellipsoid(
				Vector3.new(width * tier.w, height * tier.h, width * tier.w * 0.85),
				CFrame.new(base + Vector3.new(0, height * tier.y, 0)) * turn,
				if snowy then Palette.snow else rock,
				horizon,
				options
			)
		end
		-- a dark green foothill in front of every other mountain
		if i % 2 == 1 then
			local hill = polar(angle + 0.1, radius - 80, 4)
			Build.ellipsoid(
				Vector3.new(120, 52, 86),
				CFrame.new(hill) * CFrame.Angles(0, angle, 0),
				Palette.pineDark,
				horizon,
				options
			)
		end
	end
	for i = 0, 9 do
		local angle = i * (TAU / 10) + gen.next() * 0.4
		Props.cloud(
			polar(angle, 180 + gen.next() * 220, 120 + gen.next() * 50),
			0.9 + gen.next() * 0.6,
			gen,
			horizon
		)
	end
end

-- ===== Docks =====

local function lantern(position: Vector3, parent: Instance, height: number?)
	local h = height or 6
	local m = Build.model("Lantern", parent)
	local dark = Palette.woodDark
	Build.block(Vector3.new(0.7, h, 0.7), CFrame.new(position + Vector3.new(0, h / 2, 0)), dark, m)
	Build.block(
		Vector3.new(1.8, 0.35, 0.7),
		CFrame.new(position + Vector3.new(0.55, h - 0.2, 0)),
		dark,
		m,
		{
			decor = true,
		}
	)
	local glass = Build.block(
		Vector3.new(0.9, 1.1, 0.9),
		CFrame.new(position + Vector3.new(1.1, h - 1, 0)),
		Palette.lantern,
		m,
		{
			name = "Glow",
			material = Enum.Material.Neon,
			decor = true,
			collide = false,
			shadow = false,
		}
	)
	Build.block(
		Vector3.new(1.1, 0.25, 1.1),
		CFrame.new(position + Vector3.new(1.1, h - 0.35, 0)),
		dark,
		m,
		{
			decor = true,
			collide = false,
		}
	)
	local light = Instance.new("PointLight")
	light.Color = Palette.lantern
	light.Range = 18
	light.Brightness = 1.4
	light.Shadows = false
	light.Enabled = false
	light.Parent = glass
	CollectionService:AddTag(light, Tags.NIGHT_LIGHT)
end

local function buildDock(angle: number, index: number, parent: Instance)
	local dock = Build.model("Dock" .. index, parent)
	local inner, outer = Scenery.DOCK_INNER, Scenery.DOCK_OUTER
	local length = outer - inner
	local deckY = Scenery.DOCK_TOP - 0.25
	-- local -Z points along the dock toward the lake
	local frame =
		CFrame.lookAt(polar(angle, (inner + outer) / 2, deckY), polar(angle, inner, deckY))
	local planks = math.floor(length / 1.25)
	for i = 0, planks - 1 do
		local z = length / 2 - 0.62 - i * 1.25
		Build.block(
			Vector3.new(Scenery.DOCK_WIDTH, 0.5, 1.12),
			frame * CFrame.new(0, 0, z),
			if i % 3 == 0 then Palette.woodLight else Palette.wood,
			dock,
			{ name = "Plank", shadow = false }
		)
	end
	for _, side in { -1, 1 } do
		Build.block(
			Vector3.new(0.5, 0.6, length),
			frame * CFrame.new(side * (Scenery.DOCK_WIDTH / 2 - 0.25), -0.5, 0),
			Palette.woodDark,
			dock,
			{ decor = true, shadow = false }
		)
		-- posts down into the lake (only where the dock is over the water)
		for z = -length / 2 + 1, length / 2, 6 do
			local top = frame * CFrame.new(side * (Scenery.DOCK_WIDTH / 2 - 0.3), 0, z)
			if (Vector3.new(top.Position.X, 0, top.Position.Z)).Magnitude < R + 2 then
				Build.rod(
					top.Position,
					top.Position - Vector3.new(0, 9, 0),
					0.8,
					Palette.woodDark,
					dock,
					{ decor = true, shadow = false }
				)
			end
		end
	end
	-- a lantern on the end and a crate of stones
	lantern(
		(frame * CFrame.new(Scenery.DOCK_WIDTH / 2 - 0.4, 0.25, -length / 2 + 1)).Position,
		dock,
		5.5
	)
	Build.block(
		Vector3.new(1.6, 1.2, 1.6),
		frame
			* CFrame.new(-Scenery.DOCK_WIDTH / 2 + 1.1, 0.85, -length / 2 + 4)
			* CFrame.Angles(0, 0.3, 0),
		Palette.woodLight,
		dock,
		{ name = "Crate", decor = true }
	)
end

-- ===== Cabin and campfire =====

local function window(cf: CFrame, parent: Instance)
	local glass =
		Build.block(Vector3.new(2.6, 2.2, 0.3), cf, Color3.fromRGB(150, 196, 220), parent, {
			name = "Window",
			decor = true,
			shadow = false,
		})
	CollectionService:AddTag(glass, Tags.WINDOW)
	Build.block(Vector3.new(3, 0.3, 0.45), cf * CFrame.new(0, -1.25, 0.05), Palette.cream, parent, {
		decor = true,
		shadow = false,
	})
end

local function buildCabin(root: Instance)
	local cabin = Build.model("Cabin", root)
	local base = polar(Scenery.CABIN_ANGLE, Scenery.CABIN_RADIUS, Scenery.GRASS_TOP)
	local f = facingLake(base) -- front faces the lake
	local w, d, h = 16, 12, 7
	Build.block(Vector3.new(w + 6, 1, d + 8), f * CFrame.new(0, 0.3, -2), Palette.woodDark, cabin, {
		name = "Floor",
	})
	-- log walls (front wall has a door gap)
	for _, side in { -1, 1 } do
		Build.block(
			Vector3.new(0.9, h, d),
			f * CFrame.new(side * w / 2, h / 2 + 0.8, 2),
			Palette.wood,
			cabin
		)
	end
	Build.block(
		Vector3.new(w, h, 0.9),
		f * CFrame.new(0, h / 2 + 0.8, 2 + d / 2),
		Palette.wood,
		cabin
	)
	for _, side in { -1, 1 } do
		Build.block(
			Vector3.new(w / 2 - 1.6, h, 0.9),
			f * CFrame.new(side * (w / 4 + 0.8), h / 2 + 0.8, 2 - d / 2),
			Palette.wood,
			cabin
		)
	end
	Build.block(
		Vector3.new(3.2, 1.6, 0.9),
		f * CFrame.new(0, h + 0.8 - 0.8, 2 - d / 2),
		Palette.wood,
		cabin
	)
	window(f * CFrame.new(-w / 4 - 0.8, 4.4, 2 - d / 2 - 0.5), cabin)
	window(f * CFrame.new(w / 4 + 0.8, 4.4, 2 - d / 2 - 0.5), cabin)
	-- dark doorway so the door gap doesn't look hollow
	Build.block(
		Vector3.new(3.2, 5.4, 0.3),
		f * CFrame.new(0, 3.5, 2 - d / 2 + 1.4),
		Palette.woodDark,
		cabin,
		{
			decor = true,
		}
	)
	-- roof: two slopes and a ridge
	local roofY = h + 0.8
	for _, side in { -1, 1 } do
		Build.wedge(
			Vector3.new(d + 3, 5, w / 2 + 1.5),
			-- the tall back of each wedge (+Z) meets the other at the ridge
			f
				* CFrame.new(side * (w / 4 + 0.75), roofY + 2.5, 2)
				* CFrame.Angles(0, -side * math.pi / 2, 0),
			Palette.roof,
			cabin,
			{ name = "Roof" }
		)
	end
	Build.block(
		Vector3.new(1, 0.8, d + 3),
		f * CFrame.new(0, roofY + 5.2, 2),
		Palette.woodDark,
		cabin,
		{
			decor = true,
		}
	)
	-- chimney with a wisp of smoke
	local chimney = Build.block(
		Vector3.new(2, 6, 2),
		f * CFrame.new(w / 4 + 1, roofY + 4, 5),
		Palette.rock,
		cabin,
		{ name = "Chimney" }
	)
	local smoke = Instance.new("ParticleEmitter")
	smoke.Color = ColorSequence.new(Color3.fromRGB(230, 230, 236))
	smoke.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.5),
		NumberSequenceKeypoint.new(1, 1),
	})
	smoke.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.2),
		NumberSequenceKeypoint.new(1, 4),
	})
	smoke.Lifetime = NumberRange.new(4, 6)
	smoke.Rate = 3
	smoke.Speed = NumberRange.new(2, 3)
	smoke.SpreadAngle = Vector2.new(12, 12)
	smoke.Acceleration = Vector3.new(1, 0.4, 0)
	smoke.EmissionDirection = Enum.NormalId.Top
	smoke.Parent = chimney
	-- porch: roof posts and two seats facing the lake
	for _, side in { -1, 1 } do
		Build.block(
			Vector3.new(0.6, h, 0.6),
			f * CFrame.new(side * (w / 2 + 2), h / 2 + 0.8, -d / 2 - 2.5),
			Palette.woodDark,
			cabin
		)
	end
	Build.block(
		Vector3.new(w + 6, 0.5, 6.6),
		f * CFrame.new(0, h + 0.6, -d / 2 - 1.75) * CFrame.Angles(math.rad(-12), 0, 0),
		Palette.roof,
		cabin,
		{ decor = true }
	)
	for _, side in { -1, 1 } do
		local seatCf = f * CFrame.new(side * 4.5, 1.9, -d / 2 - 1.4)
		Build.block(
			Vector3.new(1.8, 0.8, 1.8),
			seatCf * CFrame.new(0, -0.7, 0),
			Palette.woodDark,
			cabin
		)
		local seat = Instance.new("Seat")
		seat.Name = "PorchChair"
		seat.Anchored = true
		seat.Size = Vector3.new(2.2, 0.6, 2.2)
		seat.CFrame = seatCf
		seat.Color = Palette.woodLight
		seat.Material = Enum.Material.SmoothPlastic
		seat.TopSurface = Enum.SurfaceType.Smooth
		seat.BottomSurface = Enum.SurfaceType.Smooth
		seat.Parent = cabin
		Build.block(
			Vector3.new(2.2, 2.4, 0.4),
			seatCf * CFrame.new(0, 1.2, 1.1),
			Palette.woodLight,
			cabin,
			{
				decor = true,
			}
		)
	end
end

local function buildCampfire(root: Instance)
	local camp = Build.model("Campfire", root)
	local center = polar(Scenery.CAMPFIRE_ANGLE, Scenery.CAMPFIRE_RADIUS, Scenery.GRASS_TOP)
	for i = 0, 7 do
		local a = i * (TAU / 8)
		Build.ellipsoid(
			Vector3.new(1.6, 1, 1.4),
			CFrame.new(center + Vector3.new(math.sin(a) * 2.3, 0.3, math.cos(a) * 2.3)),
			if i % 2 == 0 then Palette.rock else Palette.rockDark,
			camp,
			{ decor = true }
		)
	end
	for i = 0, 2 do
		local a = i * (TAU / 3)
		local dir = Vector3.new(math.sin(a), 0, math.cos(a))
		Build.rod(
			center + dir * 1.6 + Vector3.new(0, 0.2, 0),
			center - dir * 0.3 + Vector3.new(0, 1.2, 0),
			0.5,
			Palette.woodDark,
			camp,
			{ decor = true, collide = false }
		)
	end
	local flame = Build.ellipsoid(
		Vector3.new(1.6, 2.4, 1.6),
		CFrame.new(center + Vector3.new(0, 1.4, 0)),
		Palette.fire,
		camp,
		{
			name = "Flame",
			material = Enum.Material.Neon,
			decor = true,
			collide = false,
			shadow = false,
		}
	)
	Build.ellipsoid(
		Vector3.new(0.9, 1.5, 0.9),
		CFrame.new(center + Vector3.new(0, 1.5, 0)),
		Palette.yellow,
		camp,
		{ material = Enum.Material.Neon, decor = true, collide = false, shadow = false }
	)
	local fire = Instance.new("Fire")
	fire.Size = 4
	fire.Heat = 6
	fire.Color = Palette.fire
	fire.SecondaryColor = Palette.yellow
	fire.Parent = flame
	local glow = Instance.new("PointLight")
	glow.Color = Palette.fire
	glow.Range = 20
	glow.Brightness = 1.8
	glow.Shadows = false
	glow.Parent = flame
	-- three log benches you can sit on, facing the fire
	for i = 0, 2 do
		local a = i * (TAU / 3) + math.rad(30)
		local spot = center + Vector3.new(math.sin(a) * 6.5, 0, math.cos(a) * 6.5)
		local cf = CFrame.lookAt(spot, center) -- -Z faces the fire
		Build.rod(
			(cf * CFrame.new(-2.2, 0.75, 0)).Position,
			(cf * CFrame.new(2.2, 0.75, 0)).Position,
			1.5,
			Palette.wood,
			camp,
			{ name = "Log" }
		)
		local seat = Instance.new("Seat")
		seat.Name = "LogSeat"
		seat.Anchored = true
		seat.Transparency = 1
		seat.Size = Vector3.new(2, 0.4, 1.4)
		seat.CFrame = cf * CFrame.new(0, 1.5, 0) -- sitters face the fire
		seat.Parent = camp
	end
end

-- ===== Shore details =====

local function reeds(base: Vector3, gen: Rng.Generator, parent: Instance)
	local m = Build.model("Reeds", parent)
	local options = { decor = true, collide = false, shadow = false }
	for i = 1, 6 do
		local a = gen.next() * TAU
		local r = gen.next() * 1.6
		local foot = base + Vector3.new(math.sin(a) * r, 0, math.cos(a) * r)
		local height = 2.4 + gen.next() * 2
		local lean = Vector3.new(gen.next() - 0.5, 0, gen.next() - 0.5) * 0.6
		local tip = foot + Vector3.new(0, height, 0) + lean
		Build.rod(foot, tip, 0.16, Palette.reed, m, options)
		if i % 2 == 0 then
			Build.ellipsoid(
				Vector3.new(0.4, 0.9, 0.4),
				CFrame.new(tip - lean * 0.15 - Vector3.new(0, 0.5, 0)),
				Palette.cattail,
				m,
				options
			)
		end
	end
end

local function lilyPads(center: Vector3, gen: Rng.Generator, parent: Instance)
	local m = Build.model("LilyPads", parent)
	local options = { decor = true, collide = false, shadow = false }
	for i = 1, 4 do
		local a = gen.next() * TAU
		local r = gen.next() * 3
		local p = center + Vector3.new(math.sin(a) * r, 0.04, math.cos(a) * r)
		local size = 1.6 + gen.next() * 1.2
		Build.disc(
			size,
			0.08,
			CFrame.new(p),
			if i % 2 == 0 then Palette.lily else Palette.leafDark,
			m,
			options
		)
		if i == 1 and gen.next() < 0.6 then
			Build.ellipsoid(
				Vector3.new(0.7, 0.45, 0.7),
				CFrame.new(p + Vector3.new(0, 0.25, 0)),
				Palette.pink,
				m,
				options
			)
		end
	end
end

local function buildShore(root: Instance)
	local shore = Build.model("Shore", root)
	local gen = Rng.new(5)
	-- pebbles scattered over the beach
	local pebbles = { Palette.pebbleLight, Palette.pebble, Palette.pebbleDark, Palette.rockLight }
	local options = { decor = true, collide = false, shadow = false }
	for _ = 1, 260 do
		local a = gen.next() * TAU
		local r = R + 1 + gen.next() * (Config.SHORE_WIDTH - 1.5)
		if not nearDock(a, r, 1) then
			local size = 0.4 + gen.next() * 0.9
			Build.ellipsoid(
				Vector3.new(size, size * 0.45, size * (0.7 + gen.next() * 0.4)),
				CFrame.new(polar(a, r, Scenery.BEACH_TOP)) * CFrame.Angles(0, gen.next() * TAU, 0),
				pebbles[gen.int(1, #pebbles)],
				shore,
				options
			)
		end
	end
	-- reeds at the water's edge and lily pads in the shallows
	for i = 0, 27 do
		local a = i * (TAU / 28) + gen.next() * 0.15
		if not nearDock(a, R, 4) and angleGap(a, Scenery.SPAWN_ANGLE) > 0.12 then
			reeds(polar(a, R + 1.5 + gen.next() * 1.5, Scenery.BEACH_TOP), gen, shore)
		end
	end
	for i = 0, 13 do
		local a = i * (TAU / 14) + 0.11 + gen.next() * 0.2
		if not nearDock(a, R, 8) then
			lilyPads(polar(a, R - 6 - gen.next() * 6, 0), gen, shore)
		end
	end
	-- lanterns along the path
	for i = 0, 11 do
		local a = i * (TAU / 12) + math.rad(7)
		if not nearDock(a, Scenery.PATH_RADIUS, 4) then
			lantern(polar(a, Scenery.PATH_RADIUS + 3, Scenery.GRASS_TOP), shore)
		end
	end
	-- fireflies hovering over the beach (switched on at night by the client)
	for i = 0, 11 do
		local a = i * (TAU / 12) + gen.next() * 0.3
		local anchor = Build.block(
			Vector3.new(14, 4, 14),
			CFrame.new(polar(a, R + 10, 3)),
			Palette.white,
			shore,
			{
				name = "Fireflies",
				transparency = 1,
				collide = false,
				decor = true,
				shadow = false,
			}
		)
		local flies = Instance.new("ParticleEmitter")
		flies.Name = "Fireflies"
		flies.Color = ColorSequence.new(Color3.fromRGB(255, 236, 140))
		flies.LightEmission = 1
		flies.Rate = 3
		flies.Lifetime = NumberRange.new(3, 6)
		flies.Speed = NumberRange.new(0.3, 1)
		flies.SpreadAngle = Vector2.new(180, 180)
		flies.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.2, 0.25),
			NumberSequenceKeypoint.new(0.8, 0.25),
			NumberSequenceKeypoint.new(1, 0),
		})
		flies.Enabled = false
		flies.Parent = anchor
		CollectionService:AddTag(flies, Tags.FIREFLIES)
	end
end

-- ===== Forest =====

local function buildForest(root: Instance)
	local forest = Build.model("Forest", root)
	local gen = Rng.new(17)
	local taken: { Spot } = {
		{ position = polar(Scenery.CABIN_ANGLE, Scenery.CABIN_RADIUS), radius = 22 },
		{ position = polar(Scenery.CAMPFIRE_ANGLE, Scenery.CAMPFIRE_RADIUS), radius = 14 },
		{ position = polar(Scenery.SPAWN_ANGLE, Scenery.SPAWN_RADIUS), radius = 12 },
	}
	for _, angle in Scenery.BOARD_ANGLES do
		table.insert(taken, { position = polar(angle, Scenery.BOARD_RADIUS), radius = 10 })
	end
	local function free(p: Vector3, radius: number): boolean
		local r = Vector3.new(p.X, 0, p.Z).Magnitude
		if r < Scenery.PATH_RADIUS + 5 + radius or r > Scenery.PLAY_RADIUS - 4 then
			return false
		end
		local a = math.atan2(p.X, p.Z)
		if nearDock(a, r, 6 + radius) and r < Scenery.DOCK_OUTER + 14 then
			return false
		end
		for _, spot in taken do
			if (spot.position - p).Magnitude < spot.radius + radius then
				return false
			end
		end
		return true
	end
	local function place(
		count: number,
		radius: number,
		minR: number,
		maxR: number,
		build: (Vector3) -> ()
	)
		local placed, tries = 0, 0
		while placed < count and tries < count * 50 do
			tries += 1
			local a = gen.next() * TAU
			-- (no square root: denser near the lake than far out)
			local r = minR + (maxR - minR) * gen.next()
			local p = polar(a, r, Scenery.GRASS_TOP)
			if free(p, radius) then
				table.insert(taken, { position = p, radius = radius })
				build(p)
				placed += 1
			end
		end
	end
	-- tall pines crowd round the lake, thinning out toward the mountains
	place(150, 6, 146, 330, function(p)
		Props.pine(p, 1.3 + gen.next() * 0.9, gen, forest)
	end)
	place(40, 7, 140, 300, function(p)
		Props.tree(p, 1.05 + gen.next() * 0.45, gen, forest)
	end)
	place(40, 3, 136, 300, function(p)
		Props.bush(p, 0.7 + gen.next() * 0.4, gen, forest)
	end)
	place(34, 2.5, 134, 260, function(p)
		Props.flowers(p, 0.9 + gen.next() * 0.3, gen, forest)
	end)
	place(26, 3, 134, 300, function(p)
		Props.fern(p, 0.8 + gen.next() * 0.4, gen, forest)
	end)
	place(18, 4, 140, 320, function(p)
		Props.rock(p, 0.8 + gen.next() * 0.8, gen, forest)
	end)
end

-- ===== Welcome sign and leaderboards =====

local function buildSign(root: Instance)
	-- just in front of the spawn, between it and the beach, facing the spawn
	local base = polar(Scenery.SPAWN_ANGLE + 0.075, BEACH_OUT + 2.5, Scenery.GRASS_TOP)
	local f = facingLake(base) * CFrame.Angles(0, math.pi, 0)
	local sign = Build.model("WelcomeSign", root)
	for _, side in { -1, 1 } do
		Build.block(
			Vector3.new(0.6, 5, 0.6),
			f * CFrame.new(side * 3.2, 2.5, 0),
			Palette.woodDark,
			sign
		)
	end
	local board = Build.block(
		Vector3.new(7.6, 3.4, 0.5),
		f * CFrame.new(0, 4.2, 0),
		Palette.woodLight,
		sign,
		{
			name = "Board",
		}
	)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.LightInfluence = 0.4
	gui.PixelsPerStud = 40
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.Parent = board
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.fromScale(0.9, 0.5)
	title.Position = UDim2.fromScale(0.05, 0.06)
	title.Font = Enum.Font.FredokaOne
	title.Text = "Still Lake"
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(70, 48, 36)
	title.Parent = gui
	local line = title:Clone()
	line.Font = Enum.Font.BuilderSansMedium
	line.Text = "Walk to the water and skip a stone"
	line.Size = UDim2.fromScale(0.9, 0.26)
	line.Position = UDim2.fromScale(0.05, 0.62)
	line.Parent = gui
end

local function buildBoards(root: Instance): { [string]: SurfaceGui }
	local guis: { [string]: SurfaceGui } = {}
	local boards = Build.model("Leaderboards", root)
	for i, board in BoardData.BOARDS do
		local base = polar(Scenery.BOARD_ANGLES[i], Scenery.BOARD_RADIUS, Scenery.GRASS_TOP)
		guis[board.key] =
			Boards.build(board.key, board.title, board.color, facingLake(base), boards)
	end
	return guis
end

-- ===== Everything =====

function Scenery.build(parent: Instance): Built
	local root = Instance.new("Folder")
	root.Name = "StillLake"
	buildGround(root)
	buildFences(root)
	buildHorizon(root)
	local docks = Build.model("Docks", root)
	for i, angle in Scenery.DOCK_ANGLES do
		buildDock(angle, i, docks)
	end
	buildCabin(root)
	buildCampfire(root)
	buildShore(root)
	buildForest(root)
	buildSign(root)
	local boards = buildBoards(root)

	local spawnPosition = polar(Scenery.SPAWN_ANGLE, Scenery.SPAWN_RADIUS, Scenery.GRASS_TOP)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(6, 1, 6)
	spawn.CFrame = facingLake(spawnPosition - Vector3.new(0, 0.4, 0))
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = root

	root.Parent = parent
	return { root = root, spawn = spawn, boards = boards }
end

-- Is `angle` (around the lake) clear of the docks at `radius`?
function Scenery.clearOfDocks(angle: number, radius: number, margin: number): boolean
	return not nearDock(angle, radius, margin)
end

return Scenery
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="35">
        <Properties>
          <string name="Name">Systems</string>
        </Properties>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Cheats</string>
            <string name="Source"><![CDATA[--!strict
-- The test panel (Studio, the game's owner and Config.DEV_USER_IDS only):
-- every stone, jump to night or day, fresh glints, start over.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local StoneData = require(ReplicatedStorage.Shared.Data.StoneData)
local Access = require(script.Parent.Parent.Lib.Access)
local Notify = require(script.Parent.Parent.Lib.Notify)
local Data = require(script.Parent.Data)
local DayNight = require(script.Parent.DayNight)
local Progress = require(script.Parent.Progress)
local Sessions = require(script.Parent.Sessions)
local State = require(script.Parent.State)
local Stones = require(script.Parent.Stones)

local Cheats = {}

export type Action = "stones" | "night" | "day" | "glints" | "reset"

local ACTIONS: { [string]: (Player) -> () } = {
	stones = function(player)
		local profile = Data.get(player)
		if not profile then
			return
		end
		for _, stone in StoneData.LIST do
			profile.stones[stone.id] = math.max(profile.stones[stone.id] or 0, 1)
		end
		Progress.check(player)
		Notify.send(player, "Every stone is in your pouch", "good")
	end,
	night = function(player)
		DayNight.setClock(22)
		Notify.send(player, "Night falls on the lake", "info")
	end,
	day = function(player)
		DayNight.setClock(9)
		Notify.send(player, "Good morning, lake", "info")
	end,
	glints = function(player)
		Stones.refreshGlints()
		Notify.send(player, "Fresh glints washed up on the beach", "info")
	end,
	reset = function(player)
		if Data.reset(player) then
			Stones.updateHeld(player)
			Progress.refresh(player)
			Notify.send(player, "Your journal is blank again", "info")
		end
	end,
}

function Cheats.run(player: Player, action: unknown): boolean
	if type(action) ~= "string" or not Access.isDev(player) or not Sessions.getReady(player) then
		return false
	end
	local run = ACTIONS[action]
	if not run then
		return false
	end
	run(player)
	State.markDirty(player)
	return true
end

function Cheats.init()
	Net.on("Dev", 2, 4, function(player: Player, action: unknown)
		Cheats.run(player, action)
	end)
end

return Cheats
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Data</string>
            <string name="Source"><![CDATA[--!strict
-- Player profiles: load, autosave, release. Follows docs/roblox-datastores:
--   * UpdateAsync only (never Get+Set), with retry + backoff
--   * session locking so two servers can never both own a profile (no dupes)
--   * save on autosave, on leave, and on server shutdown (BindToClose)
--   * a failed load kicks the player instead of handing them an empty profile
--
-- In Studio without "Enable Studio Access to API Services", DataStores are not
-- available; profiles then live in memory only and a warning is printed.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Config = require(ReplicatedStorage.Shared.Config)
local StoneData = require(ReplicatedStorage.Shared.Data.StoneData)
local Types = require(ReplicatedStorage.Shared.Types)

type Profile = Types.Profile

local Data = {}

local STORE_NAME = Config.DATASTORE_NAME
local CURRENT_VERSION = 1

type Lock = { jobId: string, time: number }
type Stored = { profile: Profile, lock: Lock? }

local store: DataStore? = nil
local mock = false

local profiles: { [Player]: Profile } = {}
-- UserIds whose final save is still being written. A rejoin to this same
-- server waits for it, so it can't load (and later save over) older data.
local releasing: { [number]: boolean } = {}
local saving: { [Player]: boolean } = {}
local nextAutosave: { [Player]: number } = {}

local function defaultProfile(now: number): Profile
	return {
		version = CURRENT_VERSION,
		stones = { [StoneData.STARTER] = 1 },
		equipped = StoneData.STARTER,
		bestSkips = 0,
		bestDistance = 0,
		nightSkips = 0,
		shore = false,
		throws = 0,
		totalSkips = 0,
		perfects = 0,
		goals = {},
		firstJoin = now,
		lastSeen = now,
	}
end

local function deepCopy<T>(value: T): T
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value :: any do
		copy[k] = deepCopy(v)
	end
	return copy :: any
end

local function isArray(t: { [any]: any }): boolean
	return #t > 0 or next(t) == nil
end

-- Fill in any fields added to the default profile since this one was saved.
local function reconcile(target: { [any]: any }, template: { [any]: any })
	for key, value in template do
		if target[key] == nil then
			target[key] = deepCopy(value)
		elseif type(value) == "table" and type(target[key]) == "table" and not isArray(value) then
			reconcile(target[key], value)
		end
	end
end

-- Version migrations: MIGRATIONS[n] upgrades a version-n profile to n+1.
local MIGRATIONS: { [number]: (any) -> any } = {}

local function migrate(profile: any): Profile
	local version = if type(profile.version) == "number" then profile.version else 1
	while version < CURRENT_VERSION do
		local step = MIGRATIONS[version]
		if not step then
			error(`missing migration from v{version}`)
		end
		profile = step(profile)
		version += 1
		profile.version = version
	end
	reconcile(profile, defaultProfile(Clock.now()))
	-- Everyone keeps their Pebble, and can only hold a stone they own.
	if
		type(profile.stones[StoneData.STARTER]) ~= "number"
		or profile.stones[StoneData.STARTER] < 1
	then
		profile.stones[StoneData.STARTER] = 1
	end
	local equipped = profile.equipped
	if
		type(equipped) ~= "string"
		or StoneData.get(equipped) == nil
		or (profile.stones[equipped] or 0) < 1
	then
		profile.equipped = StoneData.STARTER
	end
	return profile
end

local function keyFor(player: Player): string
	return `u_{player.UserId}`
end

local function withRetry(attempts: number, fn: () -> ()): (boolean, string?)
	local delaySeconds = 1
	local lastError: string? = nil
	for attempt = 1, attempts do
		local result = table.pack(pcall(fn))
		if result[1] then
			return true, nil
		end
		local err = result[2]
		lastError = tostring(err)
		warn(`[Data] attempt {attempt}/{attempts} failed: {err}`)
		if attempt < attempts then
			task.wait(delaySeconds)
			delaySeconds = math.min(delaySeconds * 2, 16)
		end
	end
	return false, lastError
end

function Data.isMock(): boolean
	return mock
end

-- Loads and session-locks a profile. Yields. Returns nil if it can't be loaded
-- safely (the caller kicks the player).
function Data.load(player: Player): Profile?
	if mock then
		local profile = defaultProfile(Clock.now())
		profiles[player] = profile
		nextAutosave[player] = os.clock() + Config.AUTOSAVE_INTERVAL
		return profile
	end
	local ds = store :: DataStore
	local key = keyFor(player)

	local waitedUntil = os.clock() + 60
	while releasing[player.UserId] and os.clock() < waitedUntil do
		task.wait(0.5)
	end

	for _ = 1, 5 do
		local loaded: Profile? = nil
		local lockedElsewhere = false
		local ok = withRetry(3, function()
			ds:UpdateAsync(key, function(stored: any): any
				loaded = nil
				lockedElsewhere = false
				local now = Clock.now()
				if type(stored) == "table" and type(stored.lock) == "table" then
					local lock = stored.lock :: Lock
					if
						lock.jobId ~= game.JobId
						and now - lock.time < Config.SESSION_LOCK_STALE_SECONDS
					then
						lockedElsewhere = true
						return nil -- abort: another server still owns this profile
					end
				end
				local profile: Profile
				if type(stored) == "table" and type(stored.profile) == "table" then
					profile = migrate(stored.profile)
				else
					profile = defaultProfile(now)
				end
				loaded = profile
				local result: Stored =
					{ profile = profile, lock = { jobId = game.JobId, time = now } }
				return result
			end)
		end)
		if not ok then
			return nil
		end
		if loaded then
			profiles[player] = loaded
			nextAutosave[player] = os.clock() + Config.AUTOSAVE_INTERVAL
			return loaded
		end
		if lockedElsewhere then
			-- The other server is probably mid-save after the player hopped servers.
			task.wait(4)
		end
		if player.Parent == nil then
			return nil
		end
	end
	return nil
end

function Data.get(player: Player): Profile?
	return profiles[player]
end

local function save(player: Player, release: boolean): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	if mock then
		return true
	end
	-- One write per key at a time.
	while saving[player] do
		task.wait(0.2)
	end
	saving[player] = true
	profile.lastSeen = Clock.now()
	local ds = store :: DataStore
	local lostLock = false
	local ok = withRetry(if release then 5 else 3, function()
		ds:UpdateAsync(keyFor(player), function(stored: any): any
			lostLock = false
			local now = Clock.now()
			if type(stored) == "table" and type(stored.lock) == "table" then
				local lock = stored.lock :: Lock
				if
					lock.jobId ~= game.JobId
					and now - lock.time < Config.SESSION_LOCK_STALE_SECONDS
				then
					lostLock = true
					return nil
				end
			end
			local result: Stored = {
				profile = profile,
				lock = if release then nil else { jobId = game.JobId, time = now },
			}
			return result
		end)
	end)
	saving[player] = nil
	if lostLock then
		warn(`[Data] {player.Name}'s profile is locked by another server; not saving`)
		return false
	end
	return ok
end

-- Final save + release the session lock, then forget the profile.
function Data.release(player: Player)
	if not profiles[player] then
		return
	end
	local userId = player.UserId
	releasing[userId] = true
	save(player, true)
	releasing[userId] = nil
	profiles[player] = nil
	nextAutosave[player] = nil
end

-- Testing: replace a profile with a brand-new one.
function Data.reset(player: Player): Profile?
	if not profiles[player] then
		return nil
	end
	local fresh = defaultProfile(Clock.now())
	profiles[player] = fresh
	return fresh
end

function Data.init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	end
	if RunService:IsStudio() then
		local usable = ok
			and pcall(function()
				(result :: DataStore):GetAsync("studio_probe")
			end)
		if not usable then
			mock = true
			warn(
				"[Data] DataStores aren't available in this Studio session, so progress won't save.\n"
					.. "To test saving: publish the game, then Game Settings > Security > "
					.. "Enable Studio Access to API Services."
			)
		end
	elseif not ok then
		error("[Data] could not open DataStore: " .. tostring(result))
	end
end

function Data.start()
	-- Autosave, staggered per player.
	task.spawn(function()
		while true do
			task.wait(5)
			local now = os.clock()
			for player, due in nextAutosave do
				if now >= due and player.Parent ~= nil then
					nextAutosave[player] = now + Config.AUTOSAVE_INTERVAL
					task.spawn(save, player, false)
				end
			end
		end
	end)

	game:BindToClose(function()
		if mock then
			return
		end
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				save(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		-- Lifecycle calls Data.release after other systems clean up; this is the
		-- safety net in case a player leaves before Lifecycle finished loading them.
		task.delay(10, function()
			if profiles[player] and player.Parent == nil then
				Data.release(player)
			end
		end)
	end)
end

return Data
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">DayNight</string>
            <string name="Source"><![CDATA[--!strict
-- Turns the sun. The server sets Lighting.ClockTime from the shared server
-- clock (so every player sees the same sky) and softens the light at night:
-- a cool blue ambient, a dimmer sun and denser haze. Lanterns, windows and
-- fireflies are switched on by each client (see the Ambience controller).

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Config = require(ReplicatedStorage.Shared.Config)
local DayCycle = require(ReplicatedStorage.Shared.DayCycle)

local DayNight = {}

DayNight.STEP = 0.25 -- seconds between updates

type Look = {
	brightness: number,
	ambient: Color3,
	outdoor: Color3,
	shiftTop: Color3,
	haze: number,
	atmosphere: Color3,
}

local DAY: Look = {
	brightness = 2.4,
	ambient = Color3.new(0.42, 0.4, 0.46),
	outdoor = Color3.new(0.56, 0.54, 0.6),
	shiftTop = Color3.new(1, 0.92, 0.8),
	haze = 1.4,
	atmosphere = Color3.new(0.86, 0.84, 0.88),
}

local NIGHT: Look = {
	brightness = 1.2,
	ambient = Color3.new(0.2, 0.22, 0.34),
	outdoor = Color3.new(0.3, 0.33, 0.5),
	shiftTop = Color3.new(0.6, 0.7, 1),
	haze = 2,
	atmosphere = Color3.new(0.36, 0.4, 0.58),
}

local offset = 0 -- seconds added to the server clock (testing)

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- The clock right now (0..24).
function DayNight.clockTime(): number
	return DayCycle.clockTime(Clock.now() + offset)
end

function DayNight.isNight(): boolean
	return DayCycle.isNightAt(DayNight.clockTime())
end

-- Testing: jump the clock to `clock` hours. Everyone sees the jump.
function DayNight.setClock(clock: number)
	local now = Clock.now()
	local wanted = DayCycle.phaseFor(clock) * Config.DAY_LENGTH
	offset = wanted - (now % Config.DAY_LENGTH)
	DayNight.apply()
end

function DayNight.apply()
	local clock = DayNight.clockTime()
	local t = DayCycle.darkness(clock)
	Lighting.ClockTime = clock
	Lighting.Brightness = lerp(DAY.brightness, NIGHT.brightness, t)
	Lighting.Ambient = DAY.ambient:Lerp(NIGHT.ambient, t)
	Lighting.OutdoorAmbient = DAY.outdoor:Lerp(NIGHT.outdoor, t)
	Lighting.ColorShift_Top = DAY.shiftTop:Lerp(NIGHT.shiftTop, t)
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		atmosphere.Haze = lerp(DAY.haze, NIGHT.haze, t)
		atmosphere.Color = DAY.atmosphere:Lerp(NIGHT.atmosphere, t)
	end
end

function DayNight.start()
	while true do
		DayNight.apply()
		task.wait(DayNight.STEP)
	end
end

return DayNight
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Leaderboards</string>
            <string name="Source"><![CDATA[--!strict
-- The two global leaderboards by the cabin: most skips in one throw and the
-- longest throw. Scores go to OrderedDataStores every few minutes
-- (and when a player leaves); the top 10 are read back and shown on the
-- boards. Without DataStore access (Studio before publishing) the boards
-- show the players in this server instead. Studio test sessions never write
-- (the dev panel's cheats would otherwise reach the real boards).

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserService = game:GetService("UserService")

local Config = require(ReplicatedStorage.Shared.Config)
local Types = require(ReplicatedStorage.Shared.Types)
local BoardData = require(script.Parent.Parent.Lib.BoardData)
local Data = require(script.Parent.Data)
local Sessions = require(script.Parent.Sessions)
local World = require(script.Parent.World)

local Leaderboards = {}

Leaderboards.REFRESH_SECONDS = Config.LEADERBOARD_REFRESH

export type Entry = { userId: number, value: number }

local MAX_VALUE = 2 ^ 53

local stores: { [string]: OrderedDataStore } = {}
local mock = false
local lastWritten: { [Player]: { [string]: number } } = {}
local names: { [number]: string } = {}

-- OrderedDataStores hold whole numbers, so distances are kept in tenths.
local function valueOf(key: string, profile: Types.Profile): number
	local value = 0
	if key == "Skips" then
		value = profile.bestSkips
	elseif key == "Distance" then
		value = math.floor(profile.bestDistance * 10 + 0.5)
	end
	return math.clamp(math.floor(value), 0, MAX_VALUE)
end

local function formatValue(key: string, value: number): string
	if key == "Distance" then
		return string.format("%.1f studs", value / 10)
	end
	return `{value} skips`
end

local function openStores()
	-- (Data starts first; without DataStores the boards show this server)
	if Data.isMock() then
		mock = true
		return
	end
	for _, board in BoardData.BOARDS do
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore(board.store)
		end)
		if not ok then
			mock = true
			return
		end
		stores[board.key] = store
	end
end

-- Saves a player's scores (only the ones that changed since last time).
local function write(player: Player, profile: Types.Profile)
	if mock or RunService:IsStudio() then
		return
	end
	local written = lastWritten[player] or {}
	lastWritten[player] = written
	for _, board in BoardData.BOARDS do
		local value = valueOf(board.key, profile)
		local store = stores[board.key]
		if store and written[board.key] ~= value and value > 0 then
			local ok = pcall(function()
				store:SetAsync(tostring(player.UserId), value)
			end)
			if ok then
				written[board.key] = value
			end
		end
	end
end

local function topEntries(key: string): { Entry }
	local entries: { Entry } = {}
	if mock then
		for _, player in Players:GetPlayers() do
			local profile = Data.get(player)
			if profile then
				table.insert(entries, { userId = player.UserId, value = valueOf(key, profile) })
				names[player.UserId] = player.DisplayName
			end
		end
		table.sort(entries, function(a, b)
			return a.value > b.value
		end)
		while #entries > BoardData.ROWS do
			table.remove(entries)
		end
		return entries
	end
	local store = stores[key]
	if not store then
		return entries
	end
	local ok, page = pcall(function()
		return store:GetSortedAsync(false, BoardData.ROWS):GetCurrentPage()
	end)
	if ok and type(page) == "table" then
		for _, item in page do
			local userId = tonumber(item.key)
			if userId and type(item.value) == "number" then
				table.insert(entries, { userId = userId, value = item.value })
			end
		end
	end
	return entries
end

-- Display names for any user ids we haven't seen yet.
local function resolveNames(entries: { Entry })
	local missing = {}
	for _, entry in entries do
		if not names[entry.userId] then
			local player = Players:GetPlayerByUserId(entry.userId)
			if player then
				names[entry.userId] = player.DisplayName
			else
				table.insert(missing, entry.userId)
			end
		end
	end
	if #missing == 0 then
		return
	end
	local ok, infos = pcall(function()
		return UserService:GetUserInfosByUserIdsAsync(missing)
	end)
	if ok and type(infos) == "table" then
		for _, info in infos do
			if type(info.Id) == "number" and type(info.DisplayName) == "string" then
				names[info.Id] = info.DisplayName
			end
		end
	end
end

local function render(key: string, entries: { Entry })
	local gui = World.get().boards[key]
	if not gui then
		return
	end
	for row = 1, BoardData.ROWS do
		local frame = gui:FindFirstChild("Row" .. row)
		local nameLabel = frame and frame:FindFirstChild("Player")
		local valueLabel = frame and frame:FindFirstChild("Score")
		local rankLabel = frame and frame:FindFirstChild("Rank")
		if
			not nameLabel
			or not nameLabel:IsA("TextLabel")
			or not valueLabel
			or not valueLabel:IsA("TextLabel")
			or not rankLabel
			or not rankLabel:IsA("TextLabel")
		then
			continue
		end
		local entry = entries[row]
		rankLabel.Text = if row == 1
			then "🥇"
			elseif row == 2 then "🥈"
			elseif row == 3 then "🥉"
			else tostring(row)
		nameLabel.Text = if entry then names[entry.userId] or "Player" else ""
		valueLabel.Text = if entry then formatValue(key, entry.value) else ""
	end
end

-- One full pass: save everyone's scores, then redraw every board.
function Leaderboards.refresh()
	for _, session in Sessions.ready() do
		-- (earlier writes yield; skip anyone who left meanwhile)
		local profile = Data.get(session.player)
		if profile and session.ready and session.player.Parent ~= nil then
			write(session.player, profile)
		end
	end
	for _, board in BoardData.BOARDS do
		local entries = topEntries(board.key)
		resolveNames(entries)
		render(board.key, entries)
	end
end

function Leaderboards.isMock(): boolean
	return mock
end

function Leaderboards.init()
	openStores()
	Sessions.Leaving:connect(function(player: Player)
		local profile = Data.get(player)
		if profile then
			task.spawn(write, player, profile)
		end
		lastWritten[player] = nil
	end)
	Players.PlayerRemoving:Connect(function(player: Player)
		task.defer(function()
			lastWritten[player] = nil
		end)
	end)
end

function Leaderboards.start()
	task.wait(if mock then 3 else 10)
	while true do
		Leaderboards.refresh()
		-- this server's own board is cheap to redraw, so it can keep up
		task.wait(if mock then 10 else Leaderboards.REFRESH_SECONDS)
	end
end

return Leaderboards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Lifecycle</string>
            <string name="Source"><![CDATA[--!strict
-- Join and leave, in the right order:
--   join:  session -> load the save -> ready (leaderstats, title, held stone)
--   leave: everyone else forgets the player -> final save + release the lock

local Players = game:GetService("Players")

local Data = require(script.Parent.Data)
local Sessions = require(script.Parent.Sessions)
local State = require(script.Parent.State)

local Lifecycle = {}

local function onJoin(player: Player)
	local session = Sessions.create(player)
	local profile = Data.load(player)
	if player.Parent == nil or Sessions.get(player) ~= session then
		-- left while loading
		Data.release(player)
		Sessions.remove(player)
		return
	end
	if not profile then
		Sessions.remove(player)
		player:Kick("We couldn't load your stones right now. Please rejoin in a moment!")
		return
	end
	session.ready = true
	Sessions.Ready:fire(player)
	State.markDirty(player)
end

local function onLeave(player: Player)
	local session = Sessions.get(player)
	if not session then
		return
	end
	local wasReady = session.ready
	session.ready = false
	if wasReady then
		Sessions.Leaving:fire(player)
	end
	Data.release(player)
	Sessions.remove(player)
end

function Lifecycle.start()
	Players.PlayerAdded:Connect(onJoin)
	Players.PlayerRemoving:Connect(onLeave)
	for _, player in Players:GetPlayers() do
		task.spawn(onJoin, player)
	end
end

return Lifecycle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Progress</string>
            <string name="Source"><![CDATA[--!strict
-- Records, journal goals and titles. Every finished throw comes through
-- recordThrow; finding a stone comes through check. A skipper's title floats
-- over their head and their best throw shows on the player list.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GoalData = require(ReplicatedStorage.Shared.Data.GoalData)
local Skip = require(ReplicatedStorage.Shared.Skip)
local Types = require(ReplicatedStorage.Shared.Types)
local Notify = require(script.Parent.Parent.Lib.Notify)
local Data = require(script.Parent.Data)
local Sessions = require(script.Parent.Sessions)
local State = require(script.Parent.State)

local Progress = {}

Progress.TITLE_NAME = "SkipperTitle"

export type Records = { newBestSkips: boolean, newBestDistance: boolean }

function Progress.stats(profile: Types.Profile): GoalData.Stats
	local kinds = 0
	for _, count in profile.stones do
		if count > 0 then
			kinds += 1
		end
	end
	return {
		bestSkips = profile.bestSkips,
		bestDistance = profile.bestDistance,
		perfects = profile.perfects,
		stones = kinds,
		shore = profile.shore,
		nightSkips = profile.nightSkips,
		throws = profile.throws,
	}
end

-- The floating title over a character's head (or none below the first title).
local function applyTitle(player: Player)
	local profile = Data.get(player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not profile or not head or not head:IsA("BasePart") then
		return
	end
	local title = GoalData.title(profile.bestSkips)
	local existing = head:FindFirstChild(Progress.TITLE_NAME)
	if not title then
		if existing then
			existing:Destroy()
		end
		return
	end
	local gui: BillboardGui
	if existing and existing:IsA("BillboardGui") then
		gui = existing
	else
		gui = Instance.new("BillboardGui")
		gui.Name = Progress.TITLE_NAME
		gui.Size = UDim2.fromOffset(220, 34)
		gui.StudsOffset = Vector3.new(0, 2.6, 0)
		gui.MaxDistance = 70
		gui.LightInfluence = 0
		local label = Instance.new("TextLabel")
		label.Name = "Text"
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(255, 240, 200)
		label.TextStrokeColor3 = Color3.fromRGB(40, 50, 70)
		label.TextStrokeTransparency = 0.2
		label.Parent = gui
		gui.Parent = head
	end
	local label = gui:FindFirstChild("Text")
	if label and label:IsA("TextLabel") then
		label.Text = `✦ {title} ✦`
	end
end

local function setLeaderstat(player: Player, bestSkips: number)
	local stats = player:FindFirstChild("leaderstats")
	local value = stats and stats:FindFirstChild("Best Skips")
	if value and value:IsA("IntValue") then
		value.Value = bestSkips
	end
end

-- Marks newly finished goals and tells the player about each one.
function Progress.check(player: Player)
	local profile = Data.get(player)
	if not profile then
		return
	end
	local stats = Progress.stats(profile)
	for _, goal in GoalData.GOALS do
		if not profile.goals[goal.id] and GoalData.isDone(goal, stats) then
			profile.goals[goal.id] = true
			Notify.send(player, `{goal.emoji} Goal complete: {goal.text}`, "good")
		end
	end
	State.markDirty(player)
end

-- Folds one finished throw into the thrower's profile.
function Progress.recordThrow(player: Player, outcome: Skip.Outcome, night: boolean): Records
	local profile = Data.get(player)
	local records: Records = { newBestSkips = false, newBestDistance = false }
	if not profile then
		return records
	end
	local oldTitle = GoalData.title(profile.bestSkips)
	if outcome.skips > 0 then
		profile.throws += 1
		profile.totalSkips += outcome.skips
	end
	if outcome.perfect then
		profile.perfects += 1
	end
	if outcome.skips > profile.bestSkips then
		profile.bestSkips = outcome.skips
		records.newBestSkips = true
	end
	local distance = math.floor(outcome.distance * 10 + 0.5) / 10
	if distance > profile.bestDistance then
		profile.bestDistance = distance
		records.newBestDistance = true
	end
	if night and outcome.skips > profile.nightSkips then
		profile.nightSkips = outcome.skips
	end
	if outcome.verdict == "shore" then
		profile.shore = true
	end
	Progress.check(player)
	if records.newBestSkips then
		setLeaderstat(player, profile.bestSkips)
		local newTitle = GoalData.title(profile.bestSkips)
		if newTitle and newTitle ~= oldTitle then
			applyTitle(player)
			Notify.send(player, `✦ New title: {newTitle} ✦`, "rare")
		end
	end
	return records
end

-- After a profile reset (testing): redraw the title and the player list.
function Progress.refresh(player: Player)
	local profile = Data.get(player)
	if profile then
		setLeaderstat(player, profile.bestSkips)
		applyTitle(player)
		State.markDirty(player)
	end
end

local function onReady(player: Player)
	local profile = Data.get(player)
	if not profile then
		return
	end
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local best = Instance.new("IntValue")
	best.Name = "Best Skips"
	best.Value = profile.bestSkips
	best.Parent = stats
	stats.Parent = player
	player.CharacterAdded:Connect(function(character)
		character:WaitForChild("Head", 10)
		if Sessions.getReady(player) then
			applyTitle(player)
		end
	end)
	if player.Character then
		task.spawn(applyTitle, player)
	end
	-- goals added in an update may already be done
	Progress.check(player)
end

function Progress.init()
	Sessions.Ready:connect(onReady)
end

return Progress
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Sessions</string>
            <string name="Source"><![CDATA[--!strict
-- Runtime (not saved) state for each player in this server. The saved
-- profile lives in Data.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Signal = require(ReplicatedStorage.Shared.Util.Signal)

export type Session = {
	player: Player,
	ready: boolean,
	chargeStart: number?, -- os.clock() when they started winding up a throw
	lastThrowAt: number, -- os.clock() of their last throw
}

local Sessions = {}

Sessions.Ready = Signal.new() :: Signal.Signal<Player>
Sessions.Leaving = Signal.new() :: Signal.Signal<Player>

local sessions: { [Player]: Session } = {}

function Sessions.create(player: Player): Session
	local session: Session = {
		player = player,
		ready = false,
		chargeStart = nil,
		lastThrowAt = -math.huge,
	}
	sessions[player] = session
	return session
end

function Sessions.get(player: Player): Session?
	return sessions[player]
end

-- The session, but only once the player has finished loading.
function Sessions.getReady(player: Player): Session?
	local session = sessions[player]
	if session and session.ready then
		return session
	end
	return nil
end

-- Every session that finished loading.
function Sessions.ready(): { Session }
	local list: { Session } = {}
	for _, s in sessions do
		if s.ready then
			table.insert(list, s)
		end
	end
	return list
end

function Sessions.remove(player: Player)
	sessions[player] = nil
end

return Sessions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!strict
-- Sends each player a snapshot of their own progress whenever it changes
-- (batched, at most 5 times a second), plus a full one when their client says
-- it's ready. Clients only draw it; the server decides everything.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GoalData = require(ReplicatedStorage.Shared.Data.GoalData)
local Net = require(ReplicatedStorage.Shared.Net)
local Types = require(ReplicatedStorage.Shared.Types)
local Access = require(script.Parent.Parent.Lib.Access)
local Data = require(script.Parent.Data)
local Sessions = require(script.Parent.Sessions)

local State = {}

local dirty: { [Player]: boolean } = {}
local clientReady: { [Player]: boolean } = {}

function State.markDirty(player: Player)
	dirty[player] = true
end

function State.snapshot(player: Player): Types.Snapshot?
	local profile = Data.get(player)
	if not profile or not Sessions.getReady(player) then
		return nil
	end
	return {
		stones = profile.stones,
		equipped = profile.equipped,
		bestSkips = profile.bestSkips,
		bestDistance = profile.bestDistance,
		nightSkips = profile.nightSkips,
		shore = profile.shore,
		throws = profile.throws,
		totalSkips = profile.totalSkips,
		perfects = profile.perfects,
		goals = profile.goals,
		title = GoalData.title(profile.bestSkips),
		isDev = Access.isDev(player),
	}
end

local function send(player: Player)
	local snapshot = State.snapshot(player)
	if snapshot then
		Net.fire(player, "State", snapshot)
	end
end

function State.init()
	Net.on("Ready", 1, 3, function(player: Player)
		clientReady[player] = true
		send(player)
	end)
	-- The client may say it's ready before its profile finishes loading.
	Sessions.Ready:connect(function(player: Player)
		if clientReady[player] then
			send(player)
		end
	end)
	local function forget(player: Player)
		dirty[player] = nil
		clientReady[player] = nil
	end
	Sessions.Leaving:connect(forget)
	-- players kicked while joining never fire Leaving
	Players.PlayerRemoving:Connect(forget)
end

function State.start()
	while true do
		task.wait(0.2)
		for player in dirty do
			dirty[player] = nil
			if clientReady[player] and player.Parent ~= nil then
				send(player)
			end
		end
	end
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Stones</string>
            <string name="Source"><![CDATA[--!strict
-- Stones: glints that wash up on the beach (walk over and pick one up to find
-- out what it is), choosing which stone to throw, and the stone you hold in
-- your hand.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Lake = require(ReplicatedStorage.Shared.Lake)
local Net = require(ReplicatedStorage.Shared.Net)
local StoneData = require(ReplicatedStorage.Shared.Data.StoneData)
local StoneModel = require(ReplicatedStorage.Shared.StoneModel)
local Notify = require(script.Parent.Parent.Lib.Notify)
local Scenery = require(script.Parent.Parent.Lib.Scenery)
local Data = require(script.Parent.Data)
local Progress = require(script.Parent.Progress)
local Sessions = require(script.Parent.Sessions)
local State = require(script.Parent.State)

local Stones = {}

Stones.HELD_NAME = "HeldStone"
Stones.PICKUP_RANGE = 10 -- a little more than the prompt's, for lag
Stones.INNER = Config.LAKE_RADIUS + 2.5 -- glints wash up between these radii
Stones.OUTER = Config.LAKE_RADIUS + Config.SHORE_WIDTH - 2
Stones.SPACING = 10 -- glints are at least this far apart

local folder: Folder? = nil
local glints: { [BasePart]: true } = {}
local random = Random.new()

-- ===== The stone in your hand =====

local function hand(character: Model): BasePart?
	local right = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if right and right:IsA("BasePart") then
		return right
	end
	return nil
end

-- Puts the equipped stone in the character's right hand (replacing the old one).
function Stones.updateHeld(player: Player)
	local profile = Data.get(player)
	local character = player.Character
	if not profile or not character then
		return
	end
	local old = character:FindFirstChild(Stones.HELD_NAME)
	if old then
		old:Destroy()
	end
	local grip = hand(character)
	if not grip then
		return
	end
	local stone = StoneModel.build(profile.equipped, 0.8)
	stone.Name = Stones.HELD_NAME
	stone.Anchored = false
	stone:SetAttribute("BaseTransparency", stone.Transparency)
	local attachment = grip:FindFirstChild("RightGripAttachment")
	local at = if attachment and attachment:IsA("Attachment")
		then attachment.WorldCFrame
		else grip.CFrame * CFrame.new(0, -grip.Size.Y / 2, 0)
	stone.CFrame = at * CFrame.new(0, -0.15, 0) * CFrame.Angles(0, 0, math.rad(90))
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = grip
	weld.Part1 = stone
	weld.Parent = stone
	stone.Parent = character
end

-- Hides the held stone while a thrown one is in the air.
function Stones.hideHeld(player: Player, seconds: number)
	local character = player.Character
	local held = character and character:FindFirstChild(Stones.HELD_NAME)
	if not held or not held:IsA("BasePart") then
		return
	end
	held.Transparency = 1
	local sparkle = held:FindFirstChild("Sparkle")
	if sparkle and sparkle:IsA("ParticleEmitter") then
		sparkle.Enabled = false
	end
	task.delay(seconds, function()
		if held.Parent == nil then
			return
		end
		local base = held:GetAttribute("BaseTransparency")
		held.Transparency = if type(base) == "number" then base else 0
		if sparkle and sparkle:IsA("ParticleEmitter") then
			sparkle.Enabled = true
		end
	end)
end

local function equip(player: Player, id: unknown)
	if type(id) ~= "string" or not Sessions.getReady(player) then
		return
	end
	local profile = Data.get(player)
	if not profile or not StoneData.get(id) or (profile.stones[id] or 0) < 1 then
		return
	end
	if profile.equipped == id then
		return
	end
	profile.equipped = id
	Stones.updateHeld(player)
	State.markDirty(player)
end

-- ===== Glints on the beach =====

-- A free spot on the beach: away from the docks, the other glints and the spawn.
local function findSpot(): Vector3?
	for _ = 1, 40 do
		local angle = random:NextNumber(0, 2 * math.pi)
		local radius = random:NextNumber(Stones.INNER, Stones.OUTER)
		local p = Vector3.new(math.sin(angle) * radius, 0, math.cos(angle) * radius)
		local clear = not Lake.underDock(p, 3)
		if clear then
			for glint in glints do
				local g = glint.CFrame.Position
				if Vector3.new(g.X - p.X, 0, g.Z - p.Z).Magnitude < Stones.SPACING then
					clear = false
					break
				end
			end
		end
		if clear then
			return Vector3.new(p.X, Scenery.BEACH_TOP + 0.25, p.Z)
		end
	end
	return nil
end

local spawnGlint: () -> ()

local function collect(glint: BasePart, player: Player)
	if not glints[glint] or not Sessions.getReady(player) then
		return
	end
	local profile = Data.get(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not profile or not root or not root:IsA("BasePart") then
		return
	end
	if (root.CFrame.Position - glint.CFrame.Position).Magnitude > Stones.PICKUP_RANGE then
		return
	end
	glints[glint] = nil
	glint:Destroy()

	local id = StoneData.roll(random:NextNumber())
	local stone = StoneData.get(id) :: StoneData.Stone
	local count = (profile.stones[id] or 0) + 1
	local isNew = count == 1
	profile.stones[id] = count
	Net.fire(player, "Found", id, isNew, count)
	if isNew and (stone.rarity == "Epic" or stone.rarity == "Legendary") then
		Notify.all(`✨ {player.DisplayName} found a {stone.name}!`, "rare")
	end
	Progress.check(player)
	State.markDirty(player)

	task.delay(random:NextNumber(Config.GLINT_RESPAWN_MIN, Config.GLINT_RESPAWN_MAX), spawnGlint)
end

function spawnGlint()
	local parent = folder
	if not parent then
		return
	end
	local spot = findSpot()
	if not spot then
		-- the beach is crowded; try again a little later
		task.delay(10, spawnGlint)
		return
	end
	local glint = Instance.new("Part")
	glint.Name = "Glint"
	glint.Shape = Enum.PartType.Ball
	glint.Size = Vector3.new(0.7, 0.7, 0.7)
	glint.CFrame = CFrame.new(spot)
	glint.Color = Color3.fromRGB(255, 250, 225)
	glint.Material = Enum.Material.Neon
	glint.Anchored = true
	glint.CanCollide = false
	glint.CanTouch = false
	glint.CastShadow = false
	glint.TopSurface = Enum.SurfaceType.Smooth
	glint.BottomSurface = Enum.SurfaceType.Smooth

	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Name = "Sparkle"
	sparkle.Color = ColorSequence.new(Color3.fromRGB(255, 246, 200))
	sparkle.LightEmission = 1
	sparkle.Rate = 6
	sparkle.Lifetime = NumberRange.new(0.6, 1.2)
	sparkle.Speed = NumberRange.new(0.5, 1.5)
	sparkle.SpreadAngle = Vector2.new(40, 40)
	sparkle.EmissionDirection = Enum.NormalId.Top
	sparkle.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.3),
		NumberSequenceKeypoint.new(1, 0),
	})
	sparkle.Parent = glint
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 240, 200)
	light.Range = 6
	light.Brightness = 0.8
	light.Shadows = false
	light.Parent = glint

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Pick up"
	prompt.ObjectText = "Glinting stone"
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.Parent = glint
	prompt.Triggered:Connect(function(player: Player)
		collect(glint, player)
	end)

	glints[glint] = true
	glint.Parent = parent
end

function Stones.glintCount(): number
	local n = 0
	for _ in glints do
		n += 1
	end
	return n
end

-- Testing: wash every glint away and bring a fresh set.
function Stones.refreshGlints()
	for glint in glints do
		glint:Destroy()
	end
	table.clear(glints)
	for _ = 1, Config.GLINT_COUNT do
		spawnGlint()
	end
end

-- Testing: pick up a glint for a player as if they had walked to it.
function Stones.collectFor(player: Player, glint: BasePart)
	collect(glint, player)
end

function Stones.list(): { BasePart }
	local list = {}
	for glint in glints do
		table.insert(list, glint)
	end
	return list
end

function Stones.init()
	local f = Instance.new("Folder")
	f.Name = "Glints"
	f.Parent = Workspace
	folder = f
	Net.on("Equip", 4, 8, equip)
	Sessions.Ready:connect(function(player: Player)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("HumanoidRootPart", 10)
			character:WaitForChild("RightHand", 3)
			if Sessions.getReady(player) and player.Character == character then
				Stones.updateHeld(player)
			end
		end)
		-- the avatar's own body parts can replace the hands once it loads
		player.CharacterAppearanceLoaded:Connect(function(character)
			if Sessions.getReady(player) and player.Character == character then
				Stones.updateHeld(player)
			end
		end)
		if player.Character then
			task.spawn(Stones.updateHeld, player)
		end
	end)
end

function Stones.start()
	for _ = 1, Config.GLINT_COUNT do
		spawnGlint()
	end
end

return Stones
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Throws</string>
            <string name="Source"><![CDATA[--!strict
-- Throwing. The client says when the player starts winding up (BeginCharge)
-- and when they let go (Release, with the way they're facing and how long
-- they held). The server checks the throw makes sense, works out every skip
-- itself, saves the result and tells everyone so all screens draw the same
-- stone.
--
-- The power comes from the client's hold time so the needle the player sees
-- is the needle that counts, but it must agree with the server's own timing
-- (CLOCK_SLACK), so nobody can claim a hold that never happened.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Lake = require(ReplicatedStorage.Shared.Lake)
local Net = require(ReplicatedStorage.Shared.Net)
local Skip = require(ReplicatedStorage.Shared.Skip)
local StoneData = require(ReplicatedStorage.Shared.Data.StoneData)
local Types = require(ReplicatedStorage.Shared.Types)
local Notify = require(script.Parent.Parent.Lib.Notify)
local Data = require(script.Parent.Data)
local DayNight = require(script.Parent.DayNight)
local Progress = require(script.Parent.Progress)
local Sessions = require(script.Parent.Sessions)
local Stones = require(script.Parent.Stones)

local Throws = {}

Throws.CLOCK_SLACK = 0.3 -- seconds the client's hold time may differ from the server's
Throws.HAND_HEIGHT = 1.2 -- the stone leaves the hand this far above the root part

export type Rejection =
	"notReady"
	| "noCharge"
	| "tooShort"
	| "tooLong"
	| "cooldown"
	| "noCharacter"
	| "tooHigh"
	| "badDirection"
	| "notFacingWater"
	| "tooFar"
	| "noRoom"

local MESSAGES: { [string]: string } = {
	notFacingWater = "Face the lake to throw",
	tooFar = "Walk a little closer to the water",
	noRoom = "Not enough open water that way",
	tooHigh = "Climb down to throw",
}

local random = Random.new()

local function rand(a: number, b: number): number
	return random:NextNumber(a, b)
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil
	end
	return root
end

local function beginCharge(player: Player)
	local session = Sessions.getReady(player)
	if session then
		session.chargeStart = os.clock()
	end
end

local function cancelCharge(player: Player)
	local session = Sessions.get(player)
	if session then
		session.chargeStart = nil
	end
end

-- Checks and performs one throw. Returns the event sent to everyone, or why
-- it was refused.
function Throws.release(
	player: Player,
	rawDirection: unknown,
	rawHeld: unknown
): (Types.ThrowEvent?, Rejection?)
	local session = Sessions.getReady(player)
	local profile = Data.get(player)
	if not session or not profile then
		return nil, "notReady"
	end
	local started = session.chargeStart
	session.chargeStart = nil
	if not started then
		return nil, "noCharge"
	end
	local now = os.clock()
	local serverHeld = now - started
	local held = serverHeld
	if type(rawHeld) == "number" and rawHeld == rawHeld then
		held = math.clamp(rawHeld, serverHeld - Throws.CLOCK_SLACK, serverHeld + Throws.CLOCK_SLACK)
	end
	if held < Config.MIN_CHARGE_SECONDS then
		return nil, "tooShort"
	end
	if held > Config.MAX_CHARGE_SECONDS then
		return nil, "tooLong"
	end
	if now - session.lastThrowAt < Config.THROW_COOLDOWN then
		return nil, "cooldown"
	end
	local root = rootOf(player)
	if not root then
		return nil, "noCharacter"
	end
	if root.CFrame.Position.Y > Config.MAX_THROW_HEIGHT then
		return nil, "tooHigh"
	end
	if typeof(rawDirection) ~= "Vector3" then
		return nil, "badDirection"
	end
	local direction = Lake.flatten(rawDirection :: Vector3)
	if not direction then
		return nil, "badDirection"
	end
	local entry, reach = Lake.entry(root.CFrame.Position, direction)
	if not entry then
		return nil, "notFacingWater"
	end
	if reach > Config.THROW_REACH then
		return nil, "tooFar"
	end
	local available = Lake.openWater(entry, direction)
	if available < Lake.MIN_OPEN_WATER then
		return nil, "noRoom"
	end

	local stone = (
		StoneData.get(profile.equipped) or StoneData.get(StoneData.STARTER)
	) :: StoneData.Stone
	local night = DayNight.isNight()
	local outcome =
		Skip.outcome(Skip.power(held), stone, rand, { night = night, available = available })
	session.lastThrowAt = now
	local records = Progress.recordThrow(player, outcome, night)

	local event: Types.ThrowEvent = {
		userId = player.UserId,
		stone = stone.id,
		origin = root.CFrame.Position + Vector3.new(0, Throws.HAND_HEIGHT, 0) + direction * 0.8,
		entry = entry,
		direction = direction,
		hops = outcome.hops,
		skips = outcome.skips,
		distance = outcome.distance,
		verdict = outcome.verdict,
		perfect = outcome.perfect,
		power = outcome.power,
		night = night,
		newBestSkips = records.newBestSkips,
		newBestDistance = records.newBestDistance,
	}
	Net.fireAll("Throw", event)
	Stones.hideHeld(player, Config.THROW_COOLDOWN)
	return event, nil
end

function Throws.init()
	Net.on("BeginCharge", 4, 6, beginCharge)
	Net.on("CancelCharge", 4, 6, cancelCharge)
	Net.on("Release", 4, 6, function(player: Player, direction: unknown, held: unknown)
		local _, rejection = Throws.release(player, direction, held)
		local message = rejection and MESSAGES[rejection]
		if message then
			Notify.send(player, message, "bad")
		end
	end)
end

return Throws
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[--!strict
-- Builds the lake when the server starts and keeps everyone on dry land: a
-- player who somehow ends up in the water or past the edge of the world is
-- put back on the beach by the spawn.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Scenery = require(script.Parent.Parent.Lib.Scenery)

local World = {}

World.LOWEST = -4 -- feet below this means they're in the lake

local built: Scenery.Built? = nil

function World.get(): Scenery.Built
	assert(built, "World not built yet")
	return built
end

function World.spawnCFrame(): CFrame
	return World.get().spawn.CFrame + Vector3.new(0, 3.5, 0)
end

-- Put a character back by the spawn if it's in the water or out of bounds.
function World.rescue(player: Player): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not root or not root:IsA("BasePart") then
		return false
	end
	local p = root.CFrame.Position
	local far = Vector3.new(p.X, 0, p.Z).Magnitude > Scenery.PLAY_RADIUS + 20
	if p.Y >= World.LOWEST and not far then
		return false
	end
	root.AssemblyLinearVelocity = Vector3.zero
	character:PivotTo(World.spawnCFrame())
	return true
end

function World.init()
	local placeholder = Workspace:FindFirstChild("PressPlay")
	if placeholder then
		placeholder:Destroy()
	end
	built = Scenery.build(Workspace)
end

function World.start()
	while true do
		task.wait(1)
		for _, player in Players:GetPlayers() do
			World.rescue(player)
		end
	end
end

return World
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="47">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">60</float>
      <float name="CharacterWalkSpeed">16</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="48">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="49">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
-- Still Lake client entry point. Same two-phase start as the server: init()
-- every controller (in name order), then start() each in its own thread.
-- One broken controller must never stop the others.

local Controllers = script:WaitForChild("Controllers")

type Controller = {
	init: (() -> ())?,
	start: (() -> ())?,
}

local loaded: { [string]: Controller } = {}
local order: { string } = {}
for _, child in Controllers:GetChildren() do
	if child:IsA("ModuleScript") then
		local ok, result = pcall(require, child)
		if ok then
			loaded[child.Name] = result :: any
			table.insert(order, child.Name)
		else
			warn(`[StillLake] {child.Name} failed to load: {result}`)
		end
	end
end
table.sort(order)

for _, name in order do
	local init = loaded[name].init
	if init then
		local ok, err = pcall(function()
			init()
		end)
		if not ok then
			warn(`[StillLake] {name}.init failed: {err}`)
		end
	end
end

for _, name in order do
	local start = loaded[name].start
	if start then
		task.spawn(function()
			local ok, err = pcall(function()
				start()
			end)
			if not ok then
				warn(`[StillLake] {name}.start failed: {err}`)
			end
		end)
	end
end

print("[StillLake] client started")
]]></string>
        </Properties>
        <Item class="Folder" referent="50">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">Ambience</string>
              <string name="Source"><![CDATA[--!strict
-- The lake's mood through the day. As dusk falls the lanterns and cabin
-- windows light up, fireflies drift over the beach and the water darkens;
-- by morning it all fades back. Now and then a fish rises somewhere on the
-- lake and leaves a ring on the water.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local DayCycle = require(ReplicatedStorage.Shared.DayCycle)
local Palette = require(ReplicatedStorage.Shared.Palette)
local Tags = require(ReplicatedStorage.Shared.Tags)
local Audio = require(script.Parent.Audio)
local StoneFx = require(script.Parent.StoneFx)

local Ambience = {}

Ambience.LIGHTS_ON = 0.45 -- darkness at which lanterns come on

local NIGHT_WATER = Color3.fromRGB(34, 62, 104)
local WINDOW_DAY = Color3.fromRGB(150, 196, 220)
local WINDOW_NIGHT = Color3.fromRGB(255, 200, 120)

local lit: boolean? = nil

local function water(): BasePart?
	local root = Workspace:FindFirstChild("StillLake")
	local land = root and root:FindFirstChild("Land")
	local part = land and land:FindFirstChild("Water")
	if part and part:IsA("BasePart") then
		return part
	end
	return nil
end

local function setLit(on: boolean)
	if lit == on then
		return
	end
	lit = on
	for _, light in CollectionService:GetTagged(Tags.NIGHT_LIGHT) do
		if light:IsA("Light") then
			light.Enabled = on
			local glass = light.Parent
			if glass and glass:IsA("BasePart") then
				glass.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
			end
		end
	end
	for _, flies in CollectionService:GetTagged(Tags.FIREFLIES) do
		if flies:IsA("ParticleEmitter") then
			flies.Enabled = on
		end
	end
	for _, window in CollectionService:GetTagged(Tags.WINDOW) do
		if window:IsA("BasePart") then
			window.Color = if on then WINDOW_NIGHT else WINDOW_DAY
			window.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
		end
	end
end

function Ambience.update()
	local darkness = DayCycle.darkness(Lighting.ClockTime)
	setLit(darkness >= Ambience.LIGHTS_ON)
	local part = water()
	if part then
		part.Color = Palette.water:Lerp(NIGHT_WATER, darkness)
	end
end

local function fishRise()
	local angle = math.random() * 2 * math.pi
	local radius = math.sqrt(math.random()) * (Config.LAKE_RADIUS - 12)
	local spot = Vector3.new(math.sin(angle) * radius, 0, math.cos(angle) * radius)
	StoneFx.ripple(spot, 4 + math.random() * 3)
	if math.random() < 0.5 then
		Audio.at(spot, "water", 2.2 + math.random() * 0.4, 0.12)
	end
end

function Ambience.start()
	-- lanterns placed later (streaming, or a slow load) are caught next pass
	CollectionService:GetInstanceAddedSignal(Tags.NIGHT_LIGHT):Connect(function()
		lit = nil
	end)
	task.spawn(function()
		while true do
			task.wait(math.random(30, 80) / 10)
			fishRise()
		end
	end)
	while true do
		Ambience.update()
		task.wait(0.5)
	end
end

return Ambience
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">Audio</string>
              <string name="Source"><![CDATA[--!strict
-- Sound. Effects use clips that ship with every Roblox client
-- (rbxasset://sounds/...), so they always load and need no uploads; pitch and
-- layering turn a few clips into soft, distinct cues. Skips and splashes play
-- out on the lake where they happen. Optional music: Config.MUSIC_TRACKS.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local UI = require(script.Parent.Parent.Lib.UI)

local Audio = {}

-- Built-in client sounds (content/sounds in the Roblox install).
local CLIPS: { [string]: string } = {
	water = "rbxasset://sounds/impact_water.mp3",
	tick = "rbxasset://sounds/volume_slider.ogg",
	whoosh = "rbxasset://sounds/action_jump.mp3",
	thud = "rbxasset://sounds/action_jump_land.mp3",
}

-- A cue is one or more notes: { clip, speed, volume, delay }.
type Note = { clip: string, speed: number, volume: number, delay: number? }

local CUES: { [string]: { Note } } = {
	click = { { clip = "tick", speed = 1.2, volume = 0.35 } },
	open = { { clip = "tick", speed = 0.9, volume = 0.3 } },
	throw = { { clip = "whoosh", speed = 1.5, volume = 0.25 } },
	good = {
		{ clip = "tick", speed = 1.3, volume = 0.35 },
		{ clip = "tick", speed = 1.65, volume = 0.35, delay = 0.09 },
	},
	bad = { { clip = "tick", speed = 0.7, volume = 0.35 } },
	rare = {
		{ clip = "tick", speed = 1.4, volume = 0.4 },
		{ clip = "tick", speed = 1.75, volume = 0.4, delay = 0.09 },
		{ clip = "tick", speed = 2.1, volume = 0.45, delay = 0.18 },
	},
	pickup = {
		{ clip = "thud", speed = 1.9, volume = 0.35 },
		{ clip = "tick", speed = 1.6, volume = 0.35, delay = 0.06 },
	},
}

local templates: { [string]: Sound } = {}
local sfx: SoundGroup? = nil
local music: SoundGroup? = nil

local function newSound(clip: string): Sound?
	local template = templates[clip]
	if not template then
		return nil
	end
	return template:Clone()
end

local function playNote(note: Note)
	local sound = newSound(note.clip)
	if not sound then
		return
	end
	sound.PlaybackSpeed = note.speed
	sound.Volume = note.volume
	sound.SoundGroup = sfx
	sound.Parent = sfx
	sound:Play()
	task.delay(4, function()
		sound:Destroy()
	end)
end

-- Plays a cue on the player's own speakers (not in the world).
function Audio.play(cue: string)
	local notes = CUES[cue]
	if not notes then
		return
	end
	for _, note in notes do
		if note.delay then
			task.delay(note.delay, playNote, note)
		else
			playNote(note)
		end
	end
end

-- Plays a clip out in the world at `position` (heard louder up close).
function Audio.at(position: Vector3, clip: string, speed: number, volume: number)
	local sound = newSound(clip)
	if not sound then
		return
	end
	-- (Terrain sits at the origin, so an attachment's Position is world space)
	local anchor = Instance.new("Attachment")
	anchor.Name = "Sound"
	anchor.Position = position
	anchor.Parent = Workspace.Terrain
	sound.PlaybackSpeed = speed
	sound.Volume = volume
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 12
	sound.RollOffMaxDistance = 220
	sound.SoundGroup = sfx
	sound.Parent = anchor
	sound:Play()
	task.delay(3, function()
		anchor:Destroy()
	end)
end

-- One skip touching the water: a "plip" that rises in pitch as the hops shorten.
function Audio.skip(position: Vector3, index: number)
	Audio.at(position, "water", math.min(1.6 + index * 0.06, 2.8), 0.32)
end

-- The stone sinking (or a dive).
function Audio.splash(position: Vector3, big: boolean)
	Audio.at(position, "water", if big then 0.8 else 1.1, if big then 0.55 else 0.4)
end

local function startMusic(group: SoundGroup)
	local tracks = Config.MUSIC_TRACKS
	if #tracks == 0 then
		return
	end
	local sound = Instance.new("Sound")
	sound.Name = "Music"
	sound.Volume = 0.35
	sound.SoundGroup = group
	sound.Parent = group
	local index = math.random(1, #tracks)
	local function playNext()
		sound.SoundId = "rbxassetid://" .. tracks[index]
		index = index % #tracks + 1
		sound:Play()
	end
	sound.Ended:Connect(playNext)
	playNext()
end

function Audio.init()
	local effects = Instance.new("SoundGroup")
	effects.Name = "Effects"
	effects.Volume = 0.9
	effects.Parent = SoundService
	sfx = effects
	local tunes = Instance.new("SoundGroup")
	tunes.Name = "Music"
	tunes.Volume = 0.7
	tunes.Parent = SoundService
	music = tunes
	for name, id in CLIPS do
		local sound = Instance.new("Sound")
		sound.Name = name
		sound.SoundId = id
		templates[name] = sound
	end
	UI.onClick = function()
		Audio.play("click")
	end
end

function Audio.start()
	if music then
		startMusic(music)
	end
end

return Audio
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">ClientState</string>
              <string name="Source"><![CDATA[--!strict
-- The latest snapshot of this player's progress from the server, and
-- signals other controllers listen to. The client never decides anything
-- that matters; it just draws this.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DayCycle = require(ReplicatedStorage.Shared.DayCycle)
local Net = require(ReplicatedStorage.Shared.Net)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Types = require(ReplicatedStorage.Shared.Types)

local ClientState = {}

ClientState.changed = Signal.new() :: Signal.Signal<Types.Snapshot>
-- One of this player's own stones has finished skipping (fired by StoneFx).
ClientState.landed = Signal.new() :: Signal.Signal<Types.ThrowEvent>

local current: Types.Snapshot? = nil

function ClientState.get(): Types.Snapshot?
	return current
end

function ClientState.isNight(): boolean
	return DayCycle.isNightAt(Lighting.ClockTime)
end

function ClientState.localPlayer(): Player
	return Players.LocalPlayer
end

function ClientState.init()
	Net.listen("State", function(snapshot: Types.Snapshot)
		current = snapshot
		ClientState.changed:fire(snapshot)
	end)
end

function ClientState.start()
	Net.send("Ready")
end

return ClientState
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">DevPanel</string>
              <string name="Source"><![CDATA[--!strict
-- The test panel (Studio, and the game's owner in live games): a small
-- button in the corner that opens a few shortcuts for trying things out.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Types = require(ReplicatedStorage.Shared.Types)
local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.Parent.Lib.UI)

local DevPanel = {}

local ACTIONS: { { action: string, label: string } } = {
	{ action = "stones", label = "🪨 Every stone" },
	{ action = "night", label = "🌙 Night" },
	{ action = "day", label = "☀️ Day" },
	{ action = "glints", label = "✨ New glints" },
	{ action = "reset", label = "🧽 Start over" },
}

local toggle: UI.Button? = nil

function DevPanel.init()
	local _, canvas = UI.screen("DevPanel", 30)
	local panel = UI.glass({
		Name = "Panel",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 58),
		Size = UDim2.fromOffset(176, 14 + #ACTIONS * 44),
		Visible = false,
		Parent = canvas,
	})
	UI.new("Frame", {
		Name = "Buttons",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = panel,
	}, { UI.list(Enum.FillDirection.Vertical, 6), UI.padding(8, 8) })
	local buttons = panel:FindFirstChild("Buttons") :: Frame
	for i, item in ACTIONS do
		UI.button({
			name = item.action,
			text = item.label,
			size = UDim2.new(1, 0, 0, 38),
			order = i,
			parent = buttons,
			onClick = function()
				Net.send("Dev", item.action)
			end,
		})
	end
	local button = UI.button({
		name = "Toggle",
		text = "🧪 Test",
		size = UDim2.fromOffset(100, 38),
		position = UDim2.new(1, -16, 0, 12),
		anchor = Vector2.new(1, 0),
		parent = canvas,
		onClick = function()
			panel.Visible = not panel.Visible
		end,
	})
	button.root.Visible = false
	toggle = button
	ClientState.changed:connect(function(snapshot: Types.Snapshot)
		local t = toggle
		if t then
			t.root.Visible = snapshot.isDev
		end
		if not snapshot.isDev then
			panel.Visible = false
		end
	end)
end

return DevPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- The heads-up display, kept small so the lake stays the star:
--   * the power meter beside your character (only near the water): a needle
--     that swings while you wind up, with the gold zone and the perfect line
--   * a hint under it saying how to throw, or what's in the way
--   * your stone (bottom left), which opens the journal
--   * your best throw and title (top)
--   * the result of each of your throws once the stone stops
--   * a big Throw button on touch screens

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local StoneData = require(ReplicatedStorage.Shared.Data.StoneData)
local Skip = require(ReplicatedStorage.Shared.Skip)
local Types = require(ReplicatedStorage.Shared.Types)
local Audio = require(script.Parent.Audio)
local ClientState = require(script.Parent.ClientState)
local Journal = require(script.Parent.Journal)
local ThrowInput = require(script.Parent.ThrowInput)
local UI = require(script.Parent.Parent.Lib.UI)

local Hud = {}

local T = UI.Theme
local METER_HEIGHT = 250
local METER_WIDTH = 30
local METER_X = 260 -- right of the screen's centre (clear of the messages)

type Refs = {
	meter: Frame,
	needle: Frame,
	fill: Frame,
	hint: TextLabel,
	stoneDot: Frame,
	stoneName: TextLabel,
	stoneRarity: TextLabel,
	best: TextLabel,
	result: Frame,
	resultTitle: TextLabel,
	resultLine: TextLabel,
	flash: TextLabel,
	throwButton: TextButton?,
}

local refs: Refs? = nil
local resultToken = 0
local flashToken = 0

-- ===== The power meter =====

-- A band of the meter from power `a` to power `b`.
local function band(
	parent: Instance,
	a: number,
	b: number,
	color: Color3,
	z: number,
	name: string
): Frame
	return UI.new("Frame", {
		Name = name,
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1 - a),
		Size = UDim2.fromScale(1, b - a),
		ZIndex = z,
		Parent = parent,
	}) :: Frame
end

local function buildMeter(canvas: Frame): (Frame, Frame, Frame)
	local meter = UI.new("Frame", {
		Name = "PowerMeter",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0.5, METER_X, 0.5, -10),
		Size = UDim2.fromOffset(METER_WIDTH + 70, METER_HEIGHT),
		Visible = false,
		Parent = canvas,
	}) :: Frame
	local track = UI.glass({
		Name = "Track",
		Size = UDim2.fromOffset(METER_WIDTH, METER_HEIGHT),
		ClipsDescendants = true,
		Parent = meter,
	})
	local inner = UI.new("Frame", {
		Name = "Bands",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = track,
	}, { UI.corner(16) }) :: Frame
	band(inner, 0, Skip.PLOP, UI.darken(T.waterDeep, 0.35), 1, "Plop")
	band(inner, Skip.PLOP, Skip.GOLD_LOW, T.waterDeep, 1, "Water")
	band(inner, Skip.GOLD_LOW, Skip.DIVE, T.gold, 1, "Gold")
	band(inner, Skip.SWEET - Skip.PERFECT, Skip.SWEET + Skip.PERFECT, T.perfect, 2, "Perfect")
	band(inner, Skip.DIVE, 1, T.coral, 1, "Dive")
	local fill = UI.new("Frame", {
		Name = "Fill",
		BackgroundColor3 = T.white,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0),
		ZIndex = 3,
		Parent = inner,
	}) :: Frame
	-- the needle sticks out to the right of the bar
	local needle = UI.new("Frame", {
		Name = "Needle",
		BackgroundColor3 = T.white,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromOffset(METER_WIDTH + 12, 4),
		ZIndex = 4,
		Parent = meter,
	}, { UI.round(), UI.stroke(T.glass, 1.5, 0.3) }) :: Frame
	-- little labels for the zones
	UI.text({
		text = "too hard",
		size = UDim2.fromOffset(64, 16),
		position = UDim2.new(0, METER_WIDTH + 8, 1 - (1 + Skip.DIVE) / 2, 0),
		anchor = Vector2.new(0, 0.5),
		color = T.coral,
		font = UI.BodyFont,
		maxTextSize = 13,
		align = Enum.TextXAlignment.Left,
		shadow = true,
		parent = meter,
	})
	UI.text({
		text = "sweet spot",
		size = UDim2.fromOffset(70, 16),
		position = UDim2.new(0, METER_WIDTH + 8, 1 - Skip.SWEET, 0),
		anchor = Vector2.new(0, 0.5),
		color = T.perfect,
		font = UI.BodyFont,
		maxTextSize = 13,
		align = Enum.TextXAlignment.Left,
		shadow = true,
		parent = meter,
	})
	return meter, needle, fill
end

-- ===== Building =====

local function build()
	local _, canvas = UI.screen("Hud", 5)
	local meter, needle, fill = buildMeter(canvas)

	local hint = UI.text({
		name = "Hint",
		text = "",
		size = UDim2.fromOffset(360, 26),
		position = UDim2.new(0.5, 0, 1, -118),
		anchor = Vector2.new(0.5, 1),
		font = UI.BodyFont,
		maxTextSize = 20,
		shadow = true,
		parent = canvas,
	})

	-- a quick word right after letting go ("Perfect!")
	local flash = UI.text({
		name = "Flash",
		text = "",
		size = UDim2.fromOffset(220, 40),
		position = UDim2.new(0.5, METER_X + METER_WIDTH / 2, 0.5, -METER_HEIGHT / 2 - 40),
		anchor = Vector2.new(0.5, 0.5),
		color = T.perfect,
		maxTextSize = 34,
		shadow = true,
		parent = canvas,
	})
	flash.TextTransparency = 1

	-- your stone, bottom left
	local card = UI.button({
		name = "StoneCard",
		text = "",
		size = UDim2.fromOffset(230, 64),
		position = UDim2.new(0, 18, 1, -18),
		anchor = Vector2.new(0, 1),
		parent = canvas,
		onClick = function()
			Journal.open("Stones")
		end,
	})
	card.label.Visible = false
	local dot = UI.new("Frame", {
		Name = "Dot",
		BackgroundColor3 = T.white,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(40, 28),
		Parent = card.root,
	}, { UI.new("UICorner", { CornerRadius = UDim.new(0.5, 0) }), UI.stroke(T.white, 2, 0.4) }) :: Frame
	local stoneName = UI.text({
		name = "StoneName",
		text = "Pebble",
		size = UDim2.new(1, -110, 0, 26),
		position = UDim2.fromOffset(62, 8),
		align = Enum.TextXAlignment.Left,
		maxTextSize = 22,
		parent = card.root,
	})
	local stoneRarity = UI.text({
		name = "Rarity",
		text = "Common",
		size = UDim2.new(1, -110, 0, 18),
		position = UDim2.fromOffset(62, 36),
		align = Enum.TextXAlignment.Left,
		font = UI.BodyFont,
		maxTextSize = 15,
		parent = card.root,
	})
	UI.text({
		text = "📖",
		size = UDim2.fromOffset(34, 34),
		position = UDim2.new(1, -10, 0.5, 0),
		anchor = Vector2.new(1, 0.5),
		maxTextSize = 26,
		parent = card.root,
	})

	-- best throw and title, top centre
	local bestPill = UI.glass({
		Name = "Best",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(300, 36),
		Parent = canvas,
	})
	local best = UI.text({
		name = "Text",
		text = "Skip your first stone",
		size = UDim2.new(1, -20, 1, -8),
		position = UDim2.fromScale(0.5, 0.5),
		anchor = Vector2.new(0.5, 0.5),
		font = UI.BodyFont,
		maxTextSize = 18,
		parent = bestPill,
	})

	-- the result of your throw, upper middle
	local result = UI.new("Frame", {
		Name = "Result",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.28),
		Size = UDim2.fromOffset(460, 90),
		Visible = false,
		Parent = canvas,
	}) :: Frame
	local resultTitle = UI.text({
		name = "Title",
		text = "",
		size = UDim2.new(1, 0, 0, 56),
		maxTextSize = 52,
		shadow = true,
		parent = result,
	})
	local resultLine = UI.text({
		name = "Line",
		text = "",
		size = UDim2.new(1, 0, 0, 28),
		position = UDim2.fromOffset(0, 60),
		font = UI.BodyFont,
		maxTextSize = 22,
		shadow = true,
		parent = result,
	})

	-- the Throw button on touch screens (hold it like the mouse button)
	local throwButton: TextButton? = nil
	if UserInputService.TouchEnabled then
		local button = UI.new("TextButton", {
			Name = "Throw",
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = T.glass,
			BackgroundTransparency = UI.GLASS,
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -150, 1, -60),
			Size = UDim2.fromOffset(110, 110),
			Visible = false,
			Parent = canvas,
		}, { UI.round(), UI.stroke(T.white, 2, 0.5) }) :: TextButton
		UI.text({
			text = "🪨\nThrow",
			size = UDim2.fromScale(0.8, 0.7),
			position = UDim2.fromScale(0.5, 0.5),
			anchor = Vector2.new(0.5, 0.5),
			maxTextSize = 24,
			parent = button,
		})
		button.InputBegan:Connect(function(input: InputObject)
			if
				input.UserInputType == Enum.UserInputType.Touch
				or input.UserInputType == Enum.UserInputType.MouseButton1
			then
				ThrowInput.press(input)
			end
		end)
		button.InputEnded:Connect(function(input: InputObject)
			if
				input.UserInputType == Enum.UserInputType.Touch
				or input.UserInputType == Enum.UserInputType.MouseButton1
			then
				ThrowInput.letGo()
			end
		end)
		throwButton = button
	end

	refs = {
		meter = meter,
		needle = needle,
		fill = fill,
		hint = hint,
		stoneDot = dot,
		stoneName = stoneName,
		stoneRarity = stoneRarity,
		best = best,
		result = result,
		resultTitle = resultTitle,
		resultLine = resultLine,
		flash = flash,
		throwButton = throwButton,
	}
end

-- ===== Updating =====

local function howToThrow(): string
	if UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
		return "Hold R2 to wind up, let go in the gold"
	elseif UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		return "Hold Throw to wind up, let go in the gold"
	end
	return "Hold click to wind up, let go in the gold"
end

local HINTS: { [string]: string } = {
	away = "Face the open water to throw",
	high = "Climb down to throw",
}

local function frame()
	local r = refs
	if not r then
		return
	end
	ThrowInput.update()
	local state = ThrowInput.state
	local near = state.charging or state.status ~= "far"
	r.meter.Visible = near
	if r.throwButton then
		r.throwButton.Visible = near
	end
	local power = ThrowInput.power()
	r.needle.Position = UDim2.new(0, -6, 1 - power, 0)
	r.fill.Size = UDim2.fromScale(1, power)
	r.needle.Visible = state.charging
	if state.charging then
		r.hint.Text = ""
	elseif state.status == "ok" then
		local snapshot = ClientState.get()
		local newcomer = not snapshot or snapshot.throws < 5
		r.hint.Text = if ThrowInput.coolingDown() then "" elseif newcomer then howToThrow() else ""
	else
		r.hint.Text = HINTS[state.status] or ""
	end
end

local function showStone(snapshot: Types.Snapshot)
	local r = refs
	if not r then
		return
	end
	local stone = StoneData.get(snapshot.equipped) or StoneData.get(StoneData.STARTER)
	if not stone then
		return
	end
	r.stoneDot.BackgroundColor3 = UI.rgb(stone.color)
	r.stoneName.Text = stone.name
	r.stoneRarity.Text = stone.rarity
	r.stoneRarity.TextColor3 = UI.rgb(StoneData.rarityInfo(stone.rarity).color)
	if snapshot.bestSkips > 0 then
		local distance = string.format("%.0f", snapshot.bestDistance)
		local title = if snapshot.title then ` · {snapshot.title}` else ""
		r.best.Text = `Best ×{snapshot.bestSkips} · {distance} studs{title}`
	else
		r.best.Text = "Skip your first stone"
	end
end

local function flashWord(text: string, color: Color3)
	local r = refs
	if not r then
		return
	end
	flashToken += 1
	local token = flashToken
	r.flash.Text = text
	r.flash.TextColor3 = color
	r.flash.TextTransparency = 0
	UI.pop(r.flash, 0.7)
	task.delay(0.9, function()
		if token == flashToken then
			UI.tween(r.flash, UI.SOFT, { TextTransparency = 1 })
		end
	end)
end

-- How a finished throw reads to the player who threw it.
function Hud.describe(event: Types.ThrowEvent): (string, string)
	local lines: { string } = {}
	local title: string
	if event.verdict == "plop" then
		title = "Plop."
		table.insert(lines, "Too gentle. Hold a little longer")
	elseif event.verdict == "dive" then
		title = "Sploosh!"
		table.insert(lines, "Too hard, it dove straight in")
	else
		title = if event.skips == 1 then "1 skip" else `{event.skips} skips!`
		if event.verdict == "shore" then
			table.insert(lines, "All the way across the lake!")
		end
		if event.perfect then
			table.insert(lines, "Perfect release")
		end
		table.insert(lines, string.format("%.0f studs", event.distance))
	end
	if event.newBestSkips and event.skips > 0 then
		table.insert(lines, 1, "New best!")
	elseif event.newBestDistance and event.skips > 0 then
		table.insert(lines, 1, "Your longest yet!")
	end
	return title, table.concat(lines, " · ")
end

local function showResult(event: Types.ThrowEvent)
	local r = refs
	if not r then
		return
	end
	local title, line = Hud.describe(event)
	resultToken += 1
	local token = resultToken
	r.resultTitle.Text = title
	r.resultLine.Text = line
	r.resultTitle.TextColor3 = if event.perfect then T.perfect else T.white
	r.resultTitle.TextTransparency = 0
	r.resultLine.TextTransparency = 0
	r.result.Visible = true
	UI.pop(r.result, 0.8)
	if event.newBestSkips and event.skips > 0 then
		Audio.play("rare")
	elseif event.skips >= 10 then
		Audio.play("good")
	end
	task.delay(2.6, function()
		if token ~= resultToken then
			return
		end
		UI.tween(r.resultTitle, UI.SOFT, { TextTransparency = 1 })
		UI.tween(r.resultLine, UI.SOFT, { TextTransparency = 1 })
		task.delay(0.4, function()
			if token == resultToken then
				r.result.Visible = false
			end
		end)
	end)
end

function Hud.init()
	build()
	ClientState.changed:connect(showStone)
	ClientState.landed:connect(showResult)
	ThrowInput.released:connect(function(power: number)
		if Skip.isPerfect(power) then
			flashWord("Perfect!", T.perfect)
		elseif power >= Skip.DIVE then
			flashWord("Too hard!", T.coral)
		end
	end)
	ThrowInput.refused:connect(function(status)
		local text = HINTS[status]
		if text then
			flashWord(text, T.white)
			Audio.play("bad")
		end
	end)
end

function Hud.start()
	RunService.RenderStepped:Connect(frame)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">Journal</string>
              <string name="Source"><![CDATA[--!strict
-- The skipper's journal (press J, or tap your stone): every kind of stone
-- (found ones can be picked to throw), the goals to aim for, and your records.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local GoalData = require(ReplicatedStorage.Shared.Data.GoalData)
local Net = require(ReplicatedStorage.Shared.Net)
local StoneData = require(ReplicatedStorage.Shared.Data.StoneData)
local Types = require(ReplicatedStorage.Shared.Types)
local Audio = require(script.Parent.Audio)
local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.Parent.Lib.UI)

local Journal = {}

export type Tab = "Stones" | "Goals" | "Records"
local TABS: { Tab } = { "Stones", "Goals", "Records" }

local T = UI.Theme
local PANEL = Vector2.new(720, 500)

local panel: Frame? = nil
local body: Frame? = nil
local tabButtons: { [Tab]: UI.Button } = {}
local current: Tab = "Stones"
local isOpen = false

-- 0..1 -> five dots, e.g. "●●●○○"
function Journal.dots(value: number): string
	local filled = math.clamp(math.floor(value * 5 + 0.5), 1, 5)
	return string.rep("●", filled) .. string.rep("○", 5 - filled)
end

local function clear(frame: Frame)
	for _, child in frame:GetChildren() do
		child:Destroy()
	end
end

-- ===== Stones =====

local function stoneCard(stone: StoneData.Stone, snapshot: Types.Snapshot, order: number): Frame
	local count = snapshot.stones[stone.id] or 0
	local owned = count > 0
	local inHand = snapshot.equipped == stone.id
	local rarityColor = UI.rgb(StoneData.rarityInfo(stone.rarity).color)
	local card = UI.new("TextButton", {
		Name = stone.id,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = if inHand then UI.lighten(T.gold, 0.7) else T.card,
		BorderSizePixel = 0,
		LayoutOrder = order,
	}, {
		UI.corner(14),
		UI.stroke(if inHand then T.gold else T.line, if inHand then 3 else 2),
	}) :: TextButton
	-- the stone itself: a soft oval in its colour, or a question mark
	local swatch = UI.new("Frame", {
		Name = "Swatch",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(54, 34),
		BackgroundColor3 = if owned then UI.rgb(stone.color) else T.paperDark,
		BorderSizePixel = 0,
		Parent = card,
	}, { UI.new("UICorner", { CornerRadius = UDim.new(0.5, 0) }) }) :: Frame
	if not owned then
		UI.body({
			text = "?",
			size = UDim2.fromScale(1, 1),
			color = T.inkSoft,
			font = UI.Font,
			maxTextSize = 24,
			parent = swatch,
		})
	end
	UI.body({
		name = "Title", -- (not "Name": card.Name is the card's own name)
		text = if owned then stone.name else "Not found yet",
		size = UDim2.new(1, -12, 0, 20),
		position = UDim2.fromOffset(6, 48),
		font = UI.Font,
		maxTextSize = 17,
		color = if owned then T.ink else T.inkSoft,
		parent = card,
	})
	UI.body({
		name = "Rarity",
		text = stone.rarity .. (if count > 1 then ` · ×{count}` else ""),
		size = UDim2.new(1, -12, 0, 16),
		position = UDim2.fromOffset(6, 69),
		color = rarityColor,
		maxTextSize = 13,
		parent = card,
	})
	local status = if inHand
		then "In hand"
		elseif owned then `Skips {Journal.dots(stone.flat)}`
		elseif stone.findWeight > 0 then "Look for glints"
		else ""
	UI.body({
		name = "Status",
		text = status,
		size = UDim2.new(1, -12, 0, 16),
		position = UDim2.fromOffset(6, 88),
		color = if inHand then T.good else T.inkSoft,
		font = UI.LightFont,
		maxTextSize = 13,
		parent = card,
	})
	if owned and not inHand then
		card.Activated:Connect(function()
			Audio.play("click")
			Net.send("Equip", stone.id)
		end)
	end
	return card :: any
end

local function showStones(frame: Frame, snapshot: Types.Snapshot)
	local grid = UI.new("Frame", {
		Name = "Grid",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, -64),
		Parent = frame,
	}, { UI.grid(Vector2.new(152, 110), 10) }) :: Frame
	for i, stone in StoneData.LIST do
		stoneCard(stone, snapshot, i).Parent = grid
	end
	local held = StoneData.get(snapshot.equipped) or StoneData.get(StoneData.STARTER)
	if held then
		local night = if held.nightBonus then " Even better at night." else ""
		UI.body({
			name = "About",
			text = `{held.name}: {held.blurb}{night}  Skips {Journal.dots(held.flat)}   Hops {Journal.dots(
				held.weight
			)}`,
			size = UDim2.new(1, -20, 0, 50),
			position = UDim2.new(0, 10, 1, -54),
			font = UI.LightFont,
			maxTextSize = 16,
			parent = frame,
		})
	end
end

-- ===== Goals =====

local function showGoals(frame: Frame, snapshot: Types.Snapshot)
	local stats: GoalData.Stats = {
		bestSkips = snapshot.bestSkips,
		bestDistance = snapshot.bestDistance,
		perfects = snapshot.perfects,
		stones = 0,
		shore = snapshot.shore,
		nightSkips = snapshot.nightSkips,
		throws = snapshot.throws,
	}
	for _, count in snapshot.stones do
		if count > 0 then
			stats.stones += 1
		end
	end
	local scroll = UI.new("ScrollingFrame", {
		Name = "List",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = T.inkSoft,
		Parent = frame,
	}, { UI.list(Enum.FillDirection.Vertical, 8), UI.padding(6, 4) }) :: ScrollingFrame
	local doneCount = 0
	for i, goal in GoalData.GOALS do
		local done = snapshot.goals[goal.id] == true
		if done then
			doneCount += 1
		end
		local progress = math.clamp(GoalData.progress(goal, stats) / goal.value, 0, 1)
		local row = UI.new("Frame", {
			Name = goal.id,
			BackgroundColor3 = if done then UI.lighten(T.sage, 0.75) else T.card,
			BorderSizePixel = 0,
			Size = UDim2.new(1, -16, 0, 46),
			LayoutOrder = if done then 100 + i else i,
			Parent = scroll,
		}, { UI.corner(12), UI.stroke(T.line, 1.5) }) :: Frame
		UI.body({
			text = goal.emoji,
			size = UDim2.fromOffset(34, 34),
			position = UDim2.fromOffset(8, 6),
			font = UI.Font,
			maxTextSize = 24,
			parent = row,
		})
		UI.body({
			text = goal.text,
			size = UDim2.new(1, -230, 0, 24),
			position = UDim2.fromOffset(50, 11),
			align = Enum.TextXAlignment.Left,
			maxTextSize = 18,
			parent = row,
		})
		local bar = UI.new("Frame", {
			Name = "Bar",
			BackgroundColor3 = T.paperDark,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -60, 0.5, 0),
			Size = UDim2.fromOffset(110, 12),
			Parent = row,
		}, { UI.round() }) :: Frame
		UI.new("Frame", {
			Name = "Fill",
			BackgroundColor3 = if done then T.good else T.water,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(progress, 1),
			Parent = bar,
		}, { UI.round() })
		UI.body({
			text = if done then "✓" else `{math.floor(progress * 100)}%`,
			size = UDim2.fromOffset(48, 24),
			position = UDim2.new(1, -54, 0.5, 0),
			anchor = Vector2.new(0, 0.5),
			color = if done then T.good else T.inkSoft,
			font = UI.Font,
			maxTextSize = 18,
			parent = row,
		})
	end
	local header = UI.body({
		text = `{doneCount} of {#GoalData.GOALS} goals done`,
		size = UDim2.new(1, -16, 0, 24),
		color = T.inkSoft,
		maxTextSize = 16,
		order = 0,
		parent = scroll,
	})
	header.LayoutOrder = -1
end

-- ===== Records =====

local function nextTitle(bestSkips: number): string?
	local best: GoalData.Title? = nil
	for _, title in GoalData.TITLES do
		if title.skips > bestSkips and (best == nil or title.skips < best.skips) then
			best = title
		end
	end
	return if best then `{best.name} at {best.skips} skips` else nil
end

local function showRecords(frame: Frame, snapshot: Types.Snapshot)
	local found = 0
	for _, count in snapshot.stones do
		if count > 0 then
			found += 1
		end
	end
	local rows: { { string } } = {
		{ "🌊", "Most skips in one throw", tostring(snapshot.bestSkips) },
		{ "📏", "Longest throw", string.format("%.1f studs", snapshot.bestDistance) },
		{ "🌙", "Most skips at night", tostring(snapshot.nightSkips) },
		{ "🎯", "Perfect releases", tostring(snapshot.perfects) },
		{ "🧺", "Stones skipped", tostring(snapshot.throws) },
		{ "💧", "Skips altogether", tostring(snapshot.totalSkips) },
		{ "🪨", "Kinds of stone found", `{found} / {#StoneData.LIST}` },
		{ "🏝️", "Across the whole lake", if snapshot.shore then "Yes!" else "Not yet" },
	}
	local list = UI.new("Frame", {
		Name = "Rows",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, -70),
		Parent = frame,
	}, { UI.list(Enum.FillDirection.Vertical, 6) }) :: Frame
	for i, row in rows do
		local line = UI.new("Frame", {
			Name = "Row" .. i,
			BackgroundColor3 = if i % 2 == 0 then T.paperDark else T.card,
			BorderSizePixel = 0,
			Size = UDim2.new(1, -20, 0, 38),
			LayoutOrder = i,
			Parent = list,
		}, { UI.corner(10) }) :: Frame
		UI.body({
			text = row[1],
			size = UDim2.fromOffset(30, 28),
			position = UDim2.fromOffset(10, 5),
			font = UI.Font,
			maxTextSize = 22,
			parent = line,
		})
		UI.body({
			text = row[2],
			size = UDim2.new(0.6, -50, 0, 24),
			position = UDim2.fromOffset(48, 7),
			align = Enum.TextXAlignment.Left,
			maxTextSize = 18,
			parent = line,
		})
		UI.body({
			name = "Value",
			text = row[3],
			size = UDim2.new(0.4, -20, 0, 26),
			position = UDim2.new(1, -12, 0.5, 0),
			anchor = Vector2.new(1, 0.5),
			align = Enum.TextXAlignment.Right,
			font = UI.Font,
			maxTextSize = 20,
			parent = line,
		})
	end
	local titleText = if snapshot.title then `Your title: {snapshot.title}` else "No title yet"
	local upcoming = nextTitle(snapshot.bestSkips)
	UI.body({
		name = "Title",
		text = if upcoming
			then `{titleText}  ·  Next: {upcoming}`
			else `{titleText}  ·  The highest there is!`,
		size = UDim2.new(1, -20, 0, 50),
		position = UDim2.new(0, 10, 1, -56),
		color = T.inkSoft,
		maxTextSize = 17,
		parent = frame,
	})
end

-- ===== Panel =====

local function render()
	local frame = body
	local snapshot = ClientState.get()
	if not frame or not snapshot or not isOpen then
		return
	end
	clear(frame)
	if current == "Stones" then
		showStones(frame, snapshot)
	elseif current == "Goals" then
		showGoals(frame, snapshot)
	else
		showRecords(frame, snapshot)
	end
	for tab, button in tabButtons do
		UI.setButton(button, {
			color = if tab == current then T.waterDeep else T.inkSoft,
		})
	end
end

function Journal.isOpen(): boolean
	return isOpen
end

function Journal.open(tab: Tab?)
	local frame = panel
	if not frame then
		return
	end
	current = tab or current
	if not isOpen then
		isOpen = true
		frame.Visible = true
		UI.pop(frame, 0.9)
		Audio.play("open")
	end
	render()
end

function Journal.close()
	local frame = panel
	if not frame or not isOpen then
		return
	end
	isOpen = false
	frame.Visible = false
end

function Journal.toggle()
	if isOpen then
		Journal.close()
	else
		Journal.open()
	end
end

local function build()
	local _, canvas = UI.screen("Journal", 10)
	local frame = UI.paper({
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(PANEL.X, PANEL.Y),
		Visible = false,
		Parent = canvas,
	})
	UI.body({
		text = "Skipper's Journal",
		size = UDim2.fromOffset(300, 36),
		position = UDim2.fromOffset(24, 14),
		align = Enum.TextXAlignment.Left,
		font = UI.Font,
		maxTextSize = 30,
		parent = frame,
	})
	local tabs = UI.new("Frame", {
		Name = "Tabs",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -70, 0, 14),
		Size = UDim2.fromOffset(330, 38),
		Parent = frame,
	}, { UI.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right) }) :: Frame
	for i, name in TABS do
		local tab: Tab = name :: Tab
		tabButtons[tab] = UI.button({
			name = tab,
			text = tab,
			size = UDim2.fromOffset(100, 38),
			color = T.inkSoft,
			order = i,
			parent = tabs,
			onClick = function()
				current = tab
				render()
			end,
		})
	end
	UI.button({
		name = "Close",
		text = "✕",
		size = UDim2.fromOffset(40, 38),
		position = UDim2.new(1, -16, 0, 14),
		anchor = Vector2.new(1, 0),
		color = T.coral,
		parent = frame,
		onClick = Journal.close,
	})
	body = UI.new("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(18, 66),
		Size = UDim2.new(1, -36, 1, -82),
		Parent = frame,
	}) :: Frame
	panel = frame
end

function Journal.init()
	build()
	ClientState.changed:connect(function()
		render()
	end)
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.J or input.KeyCode == Enum.KeyCode.ButtonY then
			Journal.toggle()
		elseif input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			Journal.close()
		end
	end)
end

return Journal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">StoneFx</string>
              <string name="Source"><![CDATA[--!strict
-- Draws every throw on the lake, the same way on every screen: the stone
-- arcs from the thrower's hand to the water, then skips hop after hop (each
-- one shorter and quicker), leaving a ripple, a little splash and a "plip"
-- that rises in pitch at every touch, until it sinks, or slides up onto the
-- far beach. Good throws leave a floating "×12" where the stone went down.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Lake = require(ReplicatedStorage.Shared.Lake)
local Net = require(ReplicatedStorage.Shared.Net)
local StoneModel = require(ReplicatedStorage.Shared.StoneModel)
local Types = require(ReplicatedStorage.Shared.Types)
local Audio = require(script.Parent.Audio)
local ClientState = require(script.Parent.ClientState)

local StoneFx = {}

StoneFx.BEACH_HEIGHT = 0.35 -- the far beach's surface (Scenery.BEACH_TOP)
StoneFx.MAX_RIPPLES = 60
StoneFx.MAX_FLIGHTS = 12 -- older stones are skipped to the end if more fly at once

type Segment = {
	from: Vector3,
	to: Vector3,
	height: number,
	duration: number,
	touch: boolean, -- a skip on the water as this segment starts
	index: number,
}

type Flight = {
	event: Types.ThrowEvent,
	stone: BasePart,
	segments: { Segment },
	current: number,
	segmentStart: number,
	spin: number,
}

local folder: Folder? = nil
local splashEmitter: ParticleEmitter? = nil
local splashAnchor: Part? = nil
local flights: { Flight } = {}
local ripples: { Part } = {}
local nextRipple = 1

local RIPPLE_GROW = TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- ===== Water effects =====

local function newRipple(parent: Instance): Part
	local part = Instance.new("Part")
	part.Name = "Ripple"
	part.Shape = Enum.PartType.Cylinder
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Material = Enum.Material.SmoothPlastic
	part.Color = Color3.fromRGB(236, 250, 255)
	part.Transparency = 1
	part.Size = Vector3.new(0.04, 0.5, 0.5)
	part.Parent = parent
	return part
end

-- A ring of water spreading out from `position` (on the surface).
function StoneFx.ripple(position: Vector3, size: number)
	local part = ripples[nextRipple]
	if not part then
		return
	end
	nextRipple = nextRipple % #ripples + 1
	part.CFrame = CFrame.new(position.X, 0.03, position.Z) * CFrame.Angles(0, 0, math.rad(90))
	part.Size = Vector3.new(0.04, 0.4, 0.4)
	part.Transparency = 0.35
	TweenService:Create(part, RIPPLE_GROW, {
		Size = Vector3.new(0.04, size, size),
		Transparency = 1,
	}):Play()
end

function StoneFx.splash(position: Vector3, amount: number)
	local anchor, emitter = splashAnchor, splashEmitter
	if not anchor or not emitter then
		return
	end
	anchor.CFrame = CFrame.new(position.X, 0.1, position.Z)
	emitter:Emit(amount)
end

-- A floating "×12" over where a good throw went down.
local function scoreTag(position: Vector3, event: Types.ThrowEvent)
	local parent = folder
	if not parent or event.skips < 5 then
		return
	end
	local anchor = Instance.new("Part")
	anchor.Name = "ScoreTag"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(position + Vector3.new(0, 2, 0))
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(140, 50)
	gui.LightInfluence = 0
	gui.MaxDistance = 260
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = `×{event.skips}`
	label.TextColor3 = if event.perfect then Color3.fromRGB(255, 226, 120) else Color3.new(1, 1, 1)
	label.TextStrokeColor3 = Color3.fromRGB(28, 40, 58)
	label.TextStrokeTransparency = 0.3
	label.Parent = gui
	anchor.Parent = parent
	local rise = TweenInfo.new(2.6, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	TweenService:Create(anchor, rise, { CFrame = anchor.CFrame + Vector3.new(0, 3, 0) }):Play()
	TweenService:Create(label, rise, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(2.8, function()
		anchor:Destroy()
	end)
end

-- ===== Planning a flight =====

local function hopDuration(length: number): number
	return math.clamp(0.08 + math.sqrt(length) * 0.085, 0.09, 0.5)
end

local function hopHeight(length: number): number
	return math.clamp(0.05 * length + 0.12, 0.15, 2.6)
end

-- Splits a throw into segments: hand -> water, then one per hop, plus a
-- slide up the far beach if it got all the way across.
function StoneFx.plan(event: Types.ThrowEvent): { Segment }
	local segments: { Segment } = {}
	local reach =
		Vector3.new(event.entry.X - event.origin.X, 0, event.entry.Z - event.origin.Z).Magnitude
	local dive = event.verdict == "dive"
	table.insert(segments, {
		from = event.origin,
		to = event.entry,
		height = if dive then 0.4 else math.clamp(reach * 0.12, 0.5, 2.5),
		duration = math.clamp(reach / 40, 0.18, 0.45),
		touch = false,
		index = 0,
	})
	local point = event.entry
	for i, length in event.hops do
		local finish = Lake.along(point, event.direction, length)
		table.insert(segments, {
			from = point,
			to = finish,
			height = hopHeight(length),
			duration = hopDuration(length),
			touch = true,
			index = i,
		})
		point = finish
	end
	if event.verdict == "shore" then
		-- skitter up onto the far beach
		local rest = Lake.along(point, event.direction, 3.5)
		table.insert(segments, {
			from = point,
			to = Vector3.new(rest.X, StoneFx.BEACH_HEIGHT + 0.15, rest.Z),
			height = 0.3,
			duration = 0.35,
			touch = true,
			index = #event.hops + 1,
		})
	end
	return segments
end

-- Where the stone is `t` (0..1) of the way through a segment.
function StoneFx.positionOn(segment: Segment, t: number): Vector3
	local base = segment.from:Lerp(segment.to, t)
	return base + Vector3.new(0, 4 * segment.height * t * (1 - t), 0)
end

-- ===== Running flights =====

local function finish(flight: Flight)
	local event = flight.event
	local last = flight.segments[#flight.segments]
	local position = last.to
	local stone = flight.stone
	if event.verdict == "shore" then
		-- it rests on the beach for a moment, then fades
		stone.CFrame = CFrame.new(position)
		TweenService:Create(
			stone,
			TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.In, 0, false, 5),
			{
				Transparency = 1,
			}
		):Play()
		task.delay(7, function()
			stone:Destroy()
		end)
	else
		local big = event.verdict == "dive"
		StoneFx.ripple(position, if big then 9 else 6)
		StoneFx.splash(position, if big then 22 else 10)
		Audio.splash(position, big)
		TweenService:Create(stone, TweenInfo.new(0.5), {
			CFrame = CFrame.new(position - Vector3.new(0, 1.2, 0)),
			Transparency = 1,
		}):Play()
		task.delay(0.6, function()
			stone:Destroy()
		end)
	end
	scoreTag(position, event)
	if event.userId == Players.LocalPlayer.UserId then
		ClientState.landed:fire(event)
	end
end

local function startSegment(flight: Flight, index: number, now: number)
	flight.current = index
	flight.segmentStart = now
	local segment = flight.segments[index]
	if segment.touch then
		local at = segment.from
		local size = math.clamp(2 + (segment.to - segment.from).Magnitude * 0.35, 2.5, 6)
		StoneFx.ripple(at, size)
		StoneFx.splash(at, 4)
		Audio.skip(at, segment.index)
	end
end

local function step(now: number)
	for i = #flights, 1, -1 do
		local flight = flights[i]
		local segment = flight.segments[flight.current]
		local t = (now - flight.segmentStart) / segment.duration
		while t >= 1 and flight.current < #flight.segments do
			local overshoot = now - (flight.segmentStart + segment.duration)
			startSegment(flight, flight.current + 1, now - overshoot)
			segment = flight.segments[flight.current]
			t = (now - flight.segmentStart) / segment.duration
		end
		if t >= 1 then
			table.remove(flights, i)
			finish(flight)
		else
			flight.spin += 0.6
			flight.stone.CFrame = CFrame.new(StoneFx.positionOn(segment, t))
				* CFrame.Angles(0, flight.spin, 0)
		end
	end
end

-- Starts drawing one throw.
function StoneFx.play(event: Types.ThrowEvent)
	local parent = folder
	if not parent then
		return
	end
	if #flights >= StoneFx.MAX_FLIGHTS then
		-- too many at once: let the oldest one sink now
		local oldest = table.remove(flights, 1)
		if oldest then
			oldest.current = #oldest.segments
			finish(oldest)
		end
	end
	local stone = StoneModel.build(event.stone, 0.8)
	stone.CFrame = CFrame.new(event.origin)
	stone.Parent = parent
	local flight: Flight = {
		event = event,
		stone = stone,
		segments = StoneFx.plan(event),
		current = 1,
		segmentStart = os.clock(),
		spin = 0,
	}
	table.insert(flights, flight)
	startSegment(flight, 1, os.clock())
end

function StoneFx.init()
	local f = Instance.new("Folder")
	f.Name = "LakeFx"
	f.Parent = Workspace
	folder = f
	for _ = 1, StoneFx.MAX_RIPPLES do
		table.insert(ripples, newRipple(f))
	end
	local anchor = Instance.new("Part")
	anchor.Name = "Splash"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.4, 0.2, 0.4)
	anchor.Parent = f
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(Color3.fromRGB(236, 250, 255))
	emitter.LightEmission = 0.3
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.35, 0.6)
	emitter.Speed = NumberRange.new(5, 9)
	emitter.SpreadAngle = Vector2.new(30, 30)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Acceleration = Vector3.new(0, -40, 0)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.28),
		NumberSequenceKeypoint.new(1, 0.08),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 0.8),
	})
	emitter.Parent = anchor
	splashAnchor = anchor
	splashEmitter = emitter
	Net.listen("Throw", function(event: Types.ThrowEvent)
		StoneFx.play(event)
	end)
end

function StoneFx.start()
	RunService.RenderStepped:Connect(function()
		step(os.clock())
	end)
end

return StoneFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">ThrowInput</string>
              <string name="Source"><![CDATA[--!strict
-- Winding up and letting go. Hold the left mouse button (or the Throw button
-- on a phone, or R2 on a gamepad) to start the power needle swinging, and let
-- go to throw where the camera is looking. The client only says when you
-- pressed and let go; the server decides how the throw goes.
--
-- Every frame it also works out whether a throw from here would work, so the
-- HUD can show the meter only by the water and say what's wrong.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Lake = require(ReplicatedStorage.Shared.Lake)
local Net = require(ReplicatedStorage.Shared.Net)
local Skip = require(ReplicatedStorage.Shared.Skip)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Audio = require(script.Parent.Audio)

local ThrowInput = {}

ThrowInput.CHARGE_WALKSPEED = 4 -- you plant your feet while winding up

-- "far": nowhere near the water (no meter). "away": by the water but facing
-- the wrong way, or with no room. "high": up on something. "ok": ready.
export type Status = "far" | "away" | "high" | "ok"

export type State = {
	status: Status,
	charging: boolean,
	startedAt: number,
	lastThrowAt: number,
}

ThrowInput.state = {
	status = "far",
	charging = false,
	startedAt = 0,
	lastThrowAt = -math.huge,
} :: State

-- Fired when a press is refused (the HUD flashes the reason).
ThrowInput.refused = Signal.new() :: Signal.Signal<Status>
-- Fired when the player lets go and the throw is sent.
ThrowInput.released = Signal.new() :: Signal.Signal<number>

local savedWalkSpeed: number? = nil
-- The finger holding the on-screen Throw button: letting it go anywhere on
-- the screen throws, even if it slid off the button first.
local holdingTouch: InputObject? = nil

local function parts(): (BasePart?, Humanoid?)
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
		return nil, nil
	end
	return root, humanoid
end

-- Where a throw would go: along the camera's view, flattened.
function ThrowInput.direction(): Vector3?
	local camera = Workspace.CurrentCamera
	local flat = camera and Lake.flatten(camera.CFrame.LookVector)
	if flat then
		return flat
	end
	local root = parts()
	return root and Lake.flatten(root.CFrame.LookVector)
end

-- Would a throw from where the player stands work right now?
function ThrowInput.check(): Status
	local root, humanoid = parts()
	if not root or not humanoid or humanoid.Sit then
		return "far"
	end
	local position = root.CFrame.Position
	if Lake.distanceFromCentre(position) > Lake.EDGE + Config.THROW_REACH then
		return "far"
	end
	if position.Y > Config.MAX_THROW_HEIGHT then
		return "high"
	end
	local direction = ThrowInput.direction()
	if not direction then
		return "away"
	end
	local entry, reach = Lake.entry(position, direction)
	if not entry or reach > Config.THROW_REACH then
		return "away"
	end
	if Lake.openWater(entry, direction) < Lake.MIN_OPEN_WATER then
		return "away"
	end
	return "ok"
end

function ThrowInput.coolingDown(): boolean
	return os.clock() - ThrowInput.state.lastThrowAt < Config.THROW_COOLDOWN
end

-- Where the needle is now (0 while not winding up).
function ThrowInput.power(): number
	local state = ThrowInput.state
	if not state.charging then
		return 0
	end
	return Skip.power(os.clock() - state.startedAt)
end

local function plantFeet(on: boolean)
	local _, humanoid = parts()
	if on then
		if humanoid and savedWalkSpeed == nil then
			savedWalkSpeed = humanoid.WalkSpeed
			humanoid.WalkSpeed = ThrowInput.CHARGE_WALKSPEED
		end
	else
		if humanoid and savedWalkSpeed then
			humanoid.WalkSpeed = savedWalkSpeed
		end
		savedWalkSpeed = nil
	end
end

local function stopCharging(tellServer: boolean)
	local state = ThrowInput.state
	if not state.charging then
		return
	end
	state.charging = false
	holdingTouch = nil
	plantFeet(false)
	if tellServer then
		Net.send("CancelCharge")
	end
end

-- Start winding up (if a throw from here would work). `touch` is the finger
-- on the Throw button, if that's what pressed.
function ThrowInput.press(touch: InputObject?)
	local state = ThrowInput.state
	if state.charging then
		return
	end
	local status: Status = ThrowInput.check() :: Status
	state.status = status
	if status ~= "ok" then
		if status ~= "far" then
			ThrowInput.refused:fire(status)
		end
		return
	end
	if ThrowInput.coolingDown() then
		return
	end
	state.charging = true
	state.startedAt = os.clock()
	holdingTouch = touch
	plantFeet(true)
	Net.send("BeginCharge")
end

-- Let go: throw (a quick tap just cancels).
function ThrowInput.letGo()
	holdingTouch = nil
	local state = ThrowInput.state
	if not state.charging then
		return
	end
	local held = os.clock() - state.startedAt
	if held < Config.MIN_CHARGE_SECONDS then
		stopCharging(true)
		return
	end
	local direction = ThrowInput.direction()
	local root = parts()
	if not direction or not root then
		stopCharging(true)
		return
	end
	stopCharging(false)
	-- face the throw
	root.CFrame = CFrame.lookAt(root.CFrame.Position, root.CFrame.Position + direction)
	Net.send("Release", direction, held)
	state.lastThrowAt = os.clock()
	Audio.play("throw")
	ThrowInput.released:fire(Skip.power(held))
end

local function isThrowInput(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.KeyCode == Enum.KeyCode.ButtonR2
end

function ThrowInput.init()
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if not processed and isThrowInput(input) then
			ThrowInput.press()
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		-- (let go even over a button, so the throw never gets stuck)
		if isThrowInput(input) or (holdingTouch ~= nil and input == holdingTouch) then
			ThrowInput.letGo()
		end
	end)
	Players.LocalPlayer.CharacterAdded:Connect(function()
		savedWalkSpeed = nil
		ThrowInput.state.charging = false
	end)
end

-- Once a frame (cheap; the HUD also calls it just before drawing, so it
-- never shows last frame's answer).
function ThrowInput.update()
	local state = ThrowInput.state
	if not state.charging then
		state.status = ThrowInput.check()
		return
	end
	-- gone (died, reset), or held so long it doesn't count
	local root = parts()
	if not root or os.clock() - state.startedAt > Config.MAX_CHARGE_SECONDS then
		stopCharging(true)
	end
end

function ThrowInput.start()
	RunService.RenderStepped:Connect(ThrowInput.update)
end

return ThrowInput
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">Toasts</string>
              <string name="Source"><![CDATA[--!strict
-- Gentle messages from the server, stacked near the top of the screen, and
-- a bigger card when you pick up a stone ("You found Slate! New!").

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local StoneData = require(ReplicatedStorage.Shared.Data.StoneData)
local Audio = require(script.Parent.Audio)
local UI = require(script.Parent.Parent.Lib.UI)

local Toasts = {}

Toasts.MAX = 3
Toasts.SECONDS = 3.2

local T = UI.Theme
local STYLE_COLORS: { [string]: Color3 } = {
	info = T.white,
	good = UI.lighten(T.sage, 0.35),
	bad = UI.lighten(T.coral, 0.35),
	rare = T.perfect,
}

-- Messages and found-stone cards share one stack above the hint line,
-- newest at the bottom.
local stack: Frame? = nil
local alive: { [Frame]: boolean } = {}
local order: { Frame } = {} -- oldest first
local count = 0

local function remove(item: Frame)
	if not alive[item] then
		return
	end
	alive[item] = nil
	local index = table.find(order, item)
	if index then
		table.remove(order, index)
	end
	item:Destroy()
end

-- Adds a pill to the stack (pushing out the oldest) and fades it later.
local function push(item: Frame, seconds: number, labels: { TextLabel })
	if #order >= Toasts.MAX then
		remove(order[1])
	end
	count += 1
	item.LayoutOrder = count
	alive[item] = true
	table.insert(order, item)
	item.Parent = stack
	UI.pop(item, 0.9)
	task.delay(seconds, function()
		if not alive[item] then
			return -- pushed out by newer messages already
		end
		UI.tween(item, UI.SOFT, { BackgroundTransparency = 1 })
		for _, label in labels do
			UI.tween(label, UI.SOFT, { TextTransparency = 1 })
		end
		task.delay(0.4, remove, item)
	end)
end

-- The newest message or card on screen (nil if none).
function Toasts.latest(): Frame?
	return order[#order]
end

function Toasts.show(text: string, style: string?)
	if not stack then
		return
	end
	local pill = UI.glass({ Name = "Toast", Size = UDim2.fromOffset(440, 38) })
	local label = UI.text({
		text = text,
		size = UDim2.new(1, -24, 1, -8),
		position = UDim2.fromScale(0.5, 0.5),
		anchor = Vector2.new(0.5, 0.5),
		color = STYLE_COLORS[style or "info"] or T.white,
		font = UI.BodyFont,
		maxTextSize = 19,
		parent = pill,
	})
	push(pill, Toasts.SECONDS, { label })
	if style == "good" or style == "rare" or style == "bad" then
		Audio.play(style)
	end
end

-- "New stone: …" card for a stone picked up off the beach.
function Toasts.found(id: string, isNew: boolean, owned: number)
	local stone = StoneData.get(id)
	if not stack or not stone then
		return
	end
	local rarityColor = UI.rgb(StoneData.rarityInfo(stone.rarity).color)
	local card = UI.glass({ Name = "Found", Size = UDim2.fromOffset(480, 84) })
	UI.new("Frame", {
		Name = "Swatch",
		BackgroundColor3 = UI.rgb(stone.color),
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.5, 0),
		Size = UDim2.fromOffset(58, 40),
		Parent = card,
	}, { UI.new("UICorner", { CornerRadius = UDim.new(0.5, 0) }), UI.stroke(T.white, 2, 0.4) })
	local title = UI.text({
		name = "Title",
		text = if isNew then `New stone: {stone.name}!` else `Another {stone.name}`,
		size = UDim2.new(1, -104, 0, 30),
		position = UDim2.fromOffset(88, 9),
		align = Enum.TextXAlignment.Left,
		maxTextSize = 26,
		parent = card,
	})
	local line = UI.text({
		name = "Line",
		text = if isNew
			then `{stone.rarity} · {stone.blurb}`
			else `{stone.rarity} · you have {owned} now`,
		size = UDim2.new(1, -104, 0, 34),
		position = UDim2.fromOffset(88, 42),
		align = Enum.TextXAlignment.Left,
		valign = Enum.TextYAlignment.Top,
		color = if isNew then UI.lighten(rarityColor, 0.25) else T.white,
		font = UI.BodyFont,
		maxTextSize = 17,
		parent = card,
	})
	push(card, if isNew then 5 else 2.5, { title, line })
	Audio.play(if isNew then "rare" else "pickup")
end

function Toasts.init()
	local _, canvas = UI.screen("Toasts", 20)
	stack = UI.new("Frame", {
		Name = "Stack",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -150),
		Size = UDim2.fromOffset(480, 260),
		Parent = canvas,
	}, {
		UI.list(
			Enum.FillDirection.Vertical,
			6,
			Enum.HorizontalAlignment.Center,
			Enum.VerticalAlignment.Bottom
		),
	}) :: Frame

	Net.listen("Notify", function(text: string, style: string)
		Toasts.show(text, style)
	end)
	Net.listen("Found", function(id: string, isNew: boolean, owned: number)
		Toasts.found(id, isNew, owned)
	end)
end

return Toasts
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="60">
          <Properties>
            <string name="Name">Lib</string>
          </Properties>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[--!strict
-- Still Lake's UI kit: one calm look shared by every screen.
--
--   * Soft slate "glass" pills float over the world (HUD); warm paper
--     panels hold the journal. Everything is rounded, nothing shouts.
--   * Fredoka One for headings and numbers, Builder Sans for body text.
--   * Layout is in design pixels; each ScreenGui gets a UIScale that fits a
--     1150 x 650 canvas to phones, tablets and desktops.

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local UI = {}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

UI.Theme = {
	ink = rgb(36, 48, 66), -- text on paper, outlines
	inkSoft = rgb(104, 116, 134),
	glass = rgb(28, 40, 58), -- HUD pills (with GLASS transparency)
	paper = rgb(250, 246, 238),
	paperDark = rgb(238, 230, 216),
	card = rgb(255, 255, 255),
	line = rgb(222, 212, 196),
	white = rgb(255, 255, 255),
	water = rgb(84, 172, 204),
	waterDeep = rgb(56, 132, 178),
	gold = rgb(246, 196, 84),
	perfect = rgb(255, 240, 160),
	coral = rgb(236, 112, 96),
	sage = rgb(120, 186, 120),
	dusk = rgb(132, 120, 206),
	good = rgb(52, 150, 92),
	bad = rgb(206, 84, 76),
}

UI.GLASS = 0.28 -- transparency of HUD pills
UI.Font = Enum.Font.FredokaOne
UI.BodyFont = Enum.Font.BuilderSansBold
UI.LightFont = Enum.Font.BuilderSansMedium

-- Sound hooks (set by the Audio controller).
UI.onClick = function() end

UI.FAST = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
UI.SOFT = TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
UI.BOUNCY = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

UI.DESIGN = Vector2.new(1150, 650)

function UI.rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

function UI.lighten(c: Color3, amount: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), amount)
end

function UI.darken(c: Color3, amount: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), amount)
end

-- Create an instance, set properties, parent children. Returns `any` so
-- callers cast to the concrete class (`:: Frame`).
function UI.new(className: string, props: { [string]: any }?, children: { any }?): any
	local instance = Instance.new(className)
	local parent: Instance? = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

-- ===== Decorators (return `any` so they mix into one children list) =====

function UI.corner(radius: number?): any
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 14) })
end

function UI.round(): any
	return UI.new("UICorner", { CornerRadius = UDim.new(0.5, 0) })
end

function UI.stroke(color: Color3?, thickness: number?, transparency: number?): any
	return UI.new("UIStroke", {
		Color = color or UI.Theme.ink,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.padding(px: number, vertical: number?): any
	local h = UDim.new(0, px)
	local v = UDim.new(0, vertical or px)
	return UI.new(
		"UIPadding",
		{ PaddingTop = v, PaddingBottom = v, PaddingLeft = h, PaddingRight = h }
	)
end

function UI.list(
	direction: Enum.FillDirection,
	padding: number,
	horizontalAlign: Enum.HorizontalAlignment?,
	verticalAlign: Enum.VerticalAlignment?
): any
	return UI.new("UIListLayout", {
		FillDirection = direction,
		Padding = UDim.new(0, padding),
		HorizontalAlignment = horizontalAlign or Enum.HorizontalAlignment.Center,
		VerticalAlignment = verticalAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function UI.grid(cell: Vector2, gap: number): any
	return UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(cell.X, cell.Y),
		CellPadding = UDim2.fromOffset(gap, gap),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

-- ===== Text =====

export type TextProps = {
	text: string,
	size: UDim2,
	position: UDim2?,
	anchor: Vector2?,
	color: Color3?,
	font: Enum.Font?,
	align: Enum.TextXAlignment?,
	valign: Enum.TextYAlignment?,
	maxTextSize: number?,
	shadow: boolean?, -- a soft dark outline, for light text over the world
	wrap: boolean?,
	order: number?,
	parent: Instance?,
	name: string?,
	zIndex: number?,
}

function UI.text(props: TextProps): TextLabel
	local label = UI.new("TextLabel", {
		Name = props.name or "Text",
		BackgroundTransparency = 1,
		Text = props.text,
		Size = props.size,
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		TextColor3 = props.color or UI.Theme.white,
		Font = props.font or UI.Font,
		TextScaled = true,
		TextWrapped = props.wrap ~= false,
		TextXAlignment = props.align or Enum.TextXAlignment.Center,
		TextYAlignment = props.valign or Enum.TextYAlignment.Center,
		LayoutOrder = props.order or 0,
		ZIndex = props.zIndex or 1,
	}) :: TextLabel
	UI.new("UITextSizeConstraint", {
		MaxTextSize = props.maxTextSize or 32,
		MinTextSize = 8,
		Parent = label,
	})
	if props.shadow then
		UI.new("UIStroke", {
			Color = UI.Theme.glass,
			Thickness = 1.6,
			Transparency = 0.35,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
			Parent = label,
		})
	end
	if props.parent then
		label.Parent = props.parent
	end
	return label
end

-- Dark body text for paper panels and cards.
function UI.body(props: TextProps): TextLabel
	props.color = props.color or UI.Theme.ink
	props.font = props.font or UI.BodyFont
	return UI.text(props)
end

-- ===== Surfaces =====

-- A translucent slate pill for the HUD.
function UI.glass(props: { [string]: any }?): Frame
	local frame = UI.new("Frame", {
		BackgroundColor3 = UI.Theme.glass,
		BackgroundTransparency = UI.GLASS,
		BorderSizePixel = 0,
	}, { UI.corner(16), UI.stroke(UI.Theme.white, 1.5, 0.82) }) :: Frame
	if props then
		for key, value in props do
			if key ~= "Parent" then
				(frame :: any)[key] = value
			end
		end
		if props.Parent then
			frame.Parent = props.Parent
		end
	end
	return frame
end

-- A warm paper panel (the journal).
function UI.paper(props: { [string]: any }?): Frame
	local frame = UI.new("Frame", {
		BackgroundColor3 = UI.Theme.paper,
		BorderSizePixel = 0,
	}, { UI.corner(22), UI.stroke(UI.Theme.line, 2) }) :: Frame
	if props then
		for key, value in props do
			if key ~= "Parent" then
				(frame :: any)[key] = value
			end
		end
		if props.Parent then
			frame.Parent = props.Parent
		end
	end
	return frame
end

-- ===== Buttons =====

export type Button = {
	root: TextButton,
	label: TextLabel,
	color: Color3,
	enabled: boolean,
}

export type ButtonProps = {
	text: string,
	size: UDim2,
	position: UDim2?,
	anchor: Vector2?,
	color: Color3?, -- face colour; defaults to the HUD glass
	textColor: Color3?,
	font: Enum.Font?,
	order: number?,
	parent: Instance?,
	name: string?,
	onClick: (() -> ())?,
}

local function paint(button: Button)
	local face = if button.enabled then button.color else UI.Theme.inkSoft
	button.root.BackgroundColor3 = face
	button.label.TextTransparency = if button.enabled then 0 else 0.35
end

-- A soft rounded button that dips a little when pressed.
function UI.button(props: ButtonProps): Button
	local color = props.color or UI.Theme.glass
	local root = UI.new("TextButton", {
		Name = props.name or "Button",
		Text = "",
		AutoButtonColor = false,
		Size = props.size,
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		BackgroundColor3 = color,
		BackgroundTransparency = if props.color then 0 else UI.GLASS,
		BorderSizePixel = 0,
		LayoutOrder = props.order or 0,
	}, { UI.corner(14), UI.stroke(UI.Theme.white, 1.5, 0.75) }) :: TextButton
	local scale = UI.new("UIScale", { Parent = root }) :: UIScale
	local label = UI.text({
		text = props.text,
		size = UDim2.new(1, -16, 1, -10),
		position = UDim2.fromScale(0.5, 0.5),
		anchor = Vector2.new(0.5, 0.5),
		color = props.textColor or UI.Theme.white,
		font = props.font,
		maxTextSize = 26,
		name = "Label",
		parent = root,
	})
	local button: Button = { root = root, label = label, color = color, enabled = true }
	root.MouseEnter:Connect(function()
		if button.enabled then
			TweenService:Create(scale, UI.FAST, { Scale = 1.04 }):Play()
		end
	end)
	root.MouseLeave:Connect(function()
		TweenService:Create(scale, UI.FAST, { Scale = 1 }):Play()
	end)
	root.MouseButton1Down:Connect(function()
		if button.enabled then
			TweenService:Create(scale, UI.FAST, { Scale = 0.95 }):Play()
		end
	end)
	root.MouseButton1Up:Connect(function()
		TweenService:Create(scale, UI.FAST, { Scale = 1 }):Play()
	end)
	root.Activated:Connect(function()
		if button.enabled and props.onClick then
			UI.onClick()
			props.onClick()
		end
	end)
	paint(button)
	if props.parent then
		root.Parent = props.parent
	end
	return button
end

function UI.setButton(button: Button, update: { text: string?, color: Color3?, enabled: boolean? })
	if update.text then
		button.label.Text = update.text
	end
	if update.color then
		button.color = update.color
	end
	if update.enabled ~= nil then
		button.enabled = update.enabled
	end
	paint(button)
end

-- ===== Motion =====

function UI.pop(gui: GuiObject, from: number?)
	local scale = gui:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = UI.new("UIScale", { Parent = gui })
	end
	local s = scale :: UIScale
	s.Scale = from or 0.85
	TweenService:Create(s, UI.BOUNCY, { Scale = 1 }):Play()
end

function UI.tween(instance: Instance, info: TweenInfo, goal: { [string]: any }): Tween
	local tween = TweenService:Create(instance, info, goal)
	tween:Play()
	return tween
end

-- ===== Screens =====

function UI.topInset(): number
	local ok, topLeft = pcall(function()
		return (GuiService:GetGuiInset())
	end)
	if ok and typeof(topLeft) == "Vector2" and topLeft.Y > 0 then
		return topLeft.Y
	end
	return 58
end

function UI.scaleFor(viewport: Vector2): number
	return math.clamp(math.min(viewport.X / UI.DESIGN.X, viewport.Y / UI.DESIGN.Y), 0.6, 1.3)
end

function UI.viewportSize(): Vector2
	local camera = Workspace.CurrentCamera
	return if camera then camera.ViewportSize else Vector2.new(1280, 720)
end

function UI.isTouch(): boolean
	local UserInputService = game:GetService("UserInputService")
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

-- A ScreenGui whose contents scale with the screen. Its "Canvas" frame is
-- the design-pixel area to lay things out in (inside the top-bar inset).
function UI.screen(name: string, displayOrder: number): (ScreenGui, Frame)
	local gui = UI.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		DisplayOrder = displayOrder,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = false,
	}) :: ScreenGui
	local canvas = UI.new("Frame", {
		Name = "Canvas",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Parent = gui,
	}) :: Frame
	local scale = UI.new("UIScale", { Parent = canvas }) :: UIScale
	local function update()
		local viewport = UI.viewportSize()
		local s = UI.scaleFor(viewport)
		scale.Scale = s
		-- (offsets are whole pixels: round up so the canvas never falls short)
		canvas.Size =
			UDim2.fromOffset(math.ceil(viewport.X / s), math.ceil((viewport.Y - UI.topInset()) / s))
	end
	update()
	local camera = Workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	end
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return gui, canvas
end

return UI
