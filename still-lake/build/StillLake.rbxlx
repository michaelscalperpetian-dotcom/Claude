      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">DayCycle</string>
          <string name="Source"><![CDATA[--!strict
-- The lake's day: a long golden day, then dusk, a starry night and dawn, every
-- Config.DAY_LENGTH seconds. Everyone sees the same time because it comes
-- from the server clock.

local Config = require(script.Parent.Config)

local DayCycle = {}

DayCycle.DAY_SHARE = 0.7 -- share of the cycle that is daytime (6:00 to 19:00)
DayCycle.NIGHT_FROM = 19.5 -- clock hours that count as night (for Moonstone, lanterns, fireflies)
DayCycle.NIGHT_UNTIL = 5.5

-- Lighting.ClockTime (0..24) at server time `now`.
function DayCycle.clockTime(now: number): number
	local phase = (now % Config.DAY_LENGTH) / Config.DAY_LENGTH
	if phase < DayCycle.DAY_SHARE then
		return 6 + phase / DayCycle.DAY_SHARE * 13
	end
	local nightPhase = (phase - DayCycle.DAY_SHARE) / (1 - DayCycle.DAY_SHARE)
	return (19 + nightPhase * 11) % 24
end

-- The inverse of clockTime: where in the cycle (0..1) the clock reads `clock`.
function DayCycle.phaseFor(clock: number): number
	local c = clock % 24
	if c >= 6 and c < 19 then
		return (c - 6) / 13 * DayCycle.DAY_SHARE
	end
	local sinceDusk = (c - 19) % 24 -- 0..11 hours into the night
	return DayCycle.DAY_SHARE + sinceDusk / 11 * (1 - DayCycle.DAY_SHARE)
end

-- How dark it is, 0 (day) .. 1 (deep night), easing through dusk and dawn.
function DayCycle.darkness(clock: number): number
	local c = clock % 24
	local function smooth(t: number): number
		local x = math.clamp(t, 0, 1)
		return x * x * (3 - 2 * x)
	end
	if c >= 17.5 then
		return smooth((c - 17.5) / 2.5) -- dusk: 17:30 -> 20:00
	elseif c < 4.5 then
		return 1
	elseif c < 6.5 then
		return 1 - smooth((c - 4.5) / 2) -- dawn: 4:30 -> 6:30
	end
	return 0
end

function DayCycle.isNightAt(clockTime: number): boolean
	return clockTime >= DayCycle.NIGHT_FROM or clockTime < DayCycle.NIGHT_UNTIL
end

function DayCycle.isNight(now: number): boolean
	return DayCycle.isNightAt(DayCycle.clockTime(now))
end

return DayCycle
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Lake</string>
          <string name="Source"><![CDATA[--!strict
-- The lake's shape, shared by server and client: a circle of LAKE_RADIUS
-- around the origin with the water surface at Y = 0. Works on the flat X/Z
-- plane; heights are ignored.

local Config = require(script.Parent.Config)

local Lake = {}

Lake.RADIUS = Config.LAKE_RADIUS
Lake.EDGE = Config.LAKE_RADIUS - 1 -- stones touch down at least this far inside the shoreline
Lake.DOCK_LEAD = 2 -- from a dock, the stone first touches at least this far in front of you
Lake.MIN_OPEN_WATER = 8 -- a throw needs at least this much water ahead of it

-- Three wooden docks reach out over the water from the beach. Each one runs
-- straight toward the centre along its angle (0 points along +Z).
Lake.DOCK_ANGLES = { math.rad(15), math.rad(140), math.rad(255) }
Lake.DOCK_INNER = 86 -- the lake end, from the centre
Lake.DOCK_OUTER = Config.LAKE_RADIUS + Config.SHORE_WIDTH + 4 -- the land end
Lake.DOCK_WIDTH = 7
Lake.DOCK_TOP = 1.2 -- height of the deck

-- Distances along a ray (px, pz) + t (dx, dz) where it crosses a circle of
-- radius r around the origin: (near, far), or nil if it misses.
local function crossings(
	px: number,
	pz: number,
	dx: number,
	dz: number,
	r: number
): (number?, number?)
	local b = px * dx + pz * dz
	local c = px * px + pz * pz - r * r
	local disc = b * b - c
	if disc < 0 then
		return nil, nil
	end
	local root = math.sqrt(disc)
	return -b - root, -b + root
end

-- The direction on the flat plane, or nil if it has no horizontal part.
function Lake.flatten(direction: Vector3): Vector3?
	local flat = Vector3.new(direction.X, 0, direction.Z)
	local length = flat.Magnitude
	if length ~= length or length < 0.1 or length == math.huge then
		return nil -- NaN, (almost) straight up, or infinite
	end
	local unit = flat.Unit
	if unit.X ~= unit.X or unit.Z ~= unit.Z then
		return nil
	end
	return unit
end

function Lake.distanceFromCentre(position: Vector3): number
	return Vector3.new(position.X, 0, position.Z).Magnitude
end

function Lake.isOverWater(position: Vector3): boolean
	return Lake.distanceFromCentre(position) < Lake.EDGE
end

-- Is this point (on the flat plane) under one of the docks, `margin` studs
-- of slack included?
function Lake.underDock(position: Vector3, margin: number?): boolean
	local slack = margin or 0
	for _, angle in Lake.DOCK_ANGLES do
		local along = position.X * math.sin(angle) + position.Z * math.cos(angle)
		local across = position.X * math.cos(angle) - position.Z * math.sin(angle)
		if
			along >= Lake.DOCK_INNER - slack
			and along <= Lake.DOCK_OUTER + slack
			and math.abs(across) <= Lake.DOCK_WIDTH / 2 + slack
		then
			return true
		end
	end
	return false
end

Lake.MAX_DOCK_CLEARANCE = 30 -- a stone flies at most this far to get clear of a dock

-- Where a stone thrown from `origin` along flat unit `direction` first touches
-- the water, and how far the thrower is from the water that way (0 when
-- already standing over it, on a dock). Nil if it never would.
--
-- The stone always lands clear of the docks: from on (or beside) a dock it
-- flies on until it is past the planks. Thrown back along a dock it never
-- gets clear, so that doesn't count.
function Lake.entry(origin: Vector3, direction: Vector3): (Vector3?, number)
	local start = Vector3.new(origin.X, 0, origin.Z)
	local reach: number
	local lead: number
	if Lake.distanceFromCentre(origin) < Lake.EDGE then
		reach = 0
		lead = Lake.DOCK_LEAD
	else
		local near, far = crossings(origin.X, origin.Z, direction.X, direction.Z, Lake.EDGE)
		if near == nil or far == nil or far <= 0 then
			return nil, math.huge
		end
		reach = math.max(near, 0)
		lead = reach
	end
	local cleared = 0
	while Lake.underDock(start + direction * lead, 0.5) do
		lead += 0.5
		cleared += 0.5
		if cleared > Lake.MAX_DOCK_CLEARANCE then
			return nil, math.huge
		end
	end
	return start + direction * lead, reach
end

-- Open water ahead of a point on the lake along flat unit `direction`.
function Lake.openWater(point: Vector3, direction: Vector3): number
	local _, far = crossings(point.X, point.Z, direction.X, direction.Z, Lake.EDGE)
	return if far then math.max(far, 0) else 0
end

-- Where a stone is after travelling `distance` from `entry` along `direction`.
function Lake.along(entry: Vector3, direction: Vector3, distance: number): Vector3
	return Vector3.new(entry.X + direction.X * distance, 0, entry.Z + direction.Z * distance)
end

return Lake
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- Every remote in the game, created by the server in one folder from one list.
-- Server handlers go through a per-player, per-remote rate limit before running.
-- Arguments from clients are hostile until validated (see server systems).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

export type ClientEvent = "Ready" | "BeginCharge" | "Release" | "CancelCharge" | "Equip" | "Dev"

export type ServerEvent = "State" | "Throw" | "Notify" | "Found"

local CLIENT_EVENTS: { ClientEvent } =
	{ "Ready", "BeginCharge", "Release", "CancelCharge", "Equip", "Dev" }

local SERVER_EVENTS: { ServerEvent } = { "State", "Throw", "Notify", "Found" }

local FOLDER_NAME = "Remotes"

local Net = {}

local remotes: { [string]: RemoteEvent } = {}

-- Token bucket per player per remote.
type Bucket = { tokens: number, last: number }
local buckets: { [Player]: { [string]: Bucket } } = {}

local function allow(player: Player, key: string, ratePerSecond: number, burst: number): boolean
	local now = os.clock()
	local playerBuckets = buckets[player]
	if not playerBuckets then
		playerBuckets = {}
		buckets[player] = playerBuckets
	end
	local b = playerBuckets[key]
	if not b then
		b = { tokens = burst, last = now }
		playerBuckets[key] = b
	end
	b.tokens = math.min(burst, b.tokens + (now - b.last) * ratePerSecond)
	b.last = now
	if b.tokens < 1 then
		return false
	end
	b.tokens -= 1
	return true
end

-- Server: create every remote. Called once by the server entry point.
function Net.serverInit()
	assert(RunService:IsServer(), "Net.serverInit is server-only")
	local folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	for _, name in CLIENT_EVENTS do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		remotes[name] = remote
	end
	for _, name in SERVER_EVENTS do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		remotes[name] = remote
	end
	folder.Parent = ReplicatedStorage
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

local function getRemote(name: string): RemoteEvent
	local cached = remotes[name]
	if cached then
		return cached
	end
	local folder = ReplicatedStorage:WaitForChild(FOLDER_NAME)
	local remote = folder:WaitForChild(name)
	assert(remote:IsA("RemoteEvent"), `{name} is not a RemoteEvent`)
	remotes[name] = remote
	return remote
end

-- Server: handle a client event. Requests over the rate limit are dropped silently.
function Net.on(
	name: ClientEvent,
	ratePerSecond: number,
	burst: number,
	handler: (Player, ...unknown) -> ()
)
	getRemote(name).OnServerEvent:Connect(function(player: Player, ...: unknown)
		if not allow(player, name, ratePerSecond, burst) then
			return
		end
		handler(player, ...)
	end)
end

function Net.fire(player: Player, name: ServerEvent, ...: any)
	getRemote(name):FireClient(player, ...)
end

function Net.fireAll(name: ServerEvent, ...: any)
	getRemote(name):FireAllClients(...)
end

-- Client: send a request to the server.
function Net.send(name: ClientEvent, ...: any)
	getRemote(name):FireServer(...)
end

-- Client: listen to a server event.
function Net.listen(name: ServerEvent, handler: (...any) -> ())
	getRemote(name).OnClientEvent:Connect(handler)
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Palette</string>
          <string name="Source"><![CDATA[--!strict
-- The colours of Still Lake, shared by the world and the UI: a calm,
-- golden-hour mountain lake with soft, slightly dusty tones.

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local Palette = {
	-- Water, from the shallows out to the deep middle
	shallows = rgb(126, 206, 214),
	water = rgb(84, 172, 204),
	deep = rgb(56, 132, 178),
	ripple = rgb(232, 250, 255),

	-- Shore and land
	pebbleLight = rgb(204, 194, 176),
	pebble = rgb(178, 166, 148),
	pebbleDark = rgb(144, 132, 118),
	sand = rgb(228, 208, 168),
	path = rgb(196, 168, 124),
	grassLight = rgb(160, 206, 112),
	grass = rgb(128, 186, 94),
	grassDark = rgb(98, 160, 80),
	moss = rgb(112, 150, 82),

	-- Plants
	leafLight = rgb(138, 196, 98),
	leaf = rgb(102, 170, 84),
	leafDark = rgb(72, 138, 76),
	pine = rgb(66, 130, 92),
	pineDark = rgb(48, 104, 80),
	reed = rgb(150, 162, 92),
	cattail = rgb(120, 82, 56),
	lily = rgb(92, 168, 96),

	-- Wood and stone
	woodLight = rgb(198, 150, 104),
	wood = rgb(166, 118, 78),
	woodDark = rgb(122, 84, 58),
	rockLight = rgb(176, 174, 182),
	rock = rgb(146, 144, 156),
	rockDark = rgb(112, 110, 124),
	mountain = rgb(132, 136, 168),
	mountainDark = rgb(104, 108, 142),
	snow = rgb(246, 248, 255),

	-- Warm accents
	lantern = rgb(255, 204, 120),
	fire = rgb(255, 150, 60),
	roof = rgb(176, 86, 72),
	cream = rgb(255, 246, 228),
	white = rgb(255, 255, 255),

	-- Flowers
	pink = rgb(246, 152, 184),
	yellow = rgb(250, 214, 92),
	purple = rgb(176, 148, 226),
	red = rgb(232, 98, 92),
	orange = rgb(246, 160, 82),
	blue = rgb(120, 170, 236),
}

Palette.FLOWERS = { Palette.pink, Palette.yellow, Palette.purple, Palette.white, Palette.orange }

return Palette
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Skip</string>
          <string name="Source"><![CDATA[--!strict
-- How a skipping stone behaves. Pure math, shared by the server (which decides
-- every throw) and the client (which draws the power meter).
--
-- Holding the throw button winds up a power needle that swings 0 -> 1 -> 0
-- every PERIOD seconds. Letting go in the gold zone (just under full power)
-- gives the most skips; the very top of the swing is too hard and the stone
-- dives straight in. The stone's flatness adds skips; its weight makes each
-- hop longer.

local Skip = {}

Skip.PERIOD = 1.5 -- seconds for one full swing of the power needle (0 -> 1 -> 0)
Skip.SWEET = 0.86 -- the best power
Skip.SWEET_WIDTH = 0.6 -- quality falls to 0 this far from SWEET
Skip.PERFECT = 0.035 -- within this of SWEET counts as a perfect release
Skip.DIVE = 0.975 -- at or above this the stone is thrown too hard and dives in
Skip.PLOP = 0.12 -- below this it just plops in
Skip.GOLD_LOW = 0.74 -- the gold zone on the meter runs from here up to DIVE
Skip.PERFECT_BONUS = 3 -- extra skips for a perfect release
Skip.MIN_HOP = 0.9 -- hops never get shorter than this (studs)

export type Verdict = "plop" | "dive" | "skips" | "shore"

export type Outcome = {
	power: number,
	skips: number, -- times it bounced off the water
	hops: { number }, -- length of each hop between touches, in studs
	distance: number, -- from the first touch to where it stopped
	perfect: boolean,
	verdict: Verdict,
}

export type StoneStats = { flat: number, weight: number, nightBonus: number? }

export type Options = {
	night: boolean?,
	available: number?, -- open water ahead of the first touch; past it the stone lands on the far shore
}

-- Where the power needle is after holding for `elapsed` seconds.
function Skip.power(elapsed: number): number
	local phase = (math.max(elapsed, 0) % Skip.PERIOD) / Skip.PERIOD
	return if phase < 0.5 then phase * 2 else 2 - phase * 2
end

-- 0..1: how good a release at this power is.
function Skip.quality(power: number): number
	return math.clamp(1 - math.abs(power - Skip.SWEET) / Skip.SWEET_WIDTH, 0, 1)
end

function Skip.isPerfect(power: number): boolean
	return math.abs(power - Skip.SWEET) <= Skip.PERFECT
end

-- The whole throw. `rand(a, b)` returns a random number in [a, b]; pass a
-- seeded one to get the same throw again.
function Skip.outcome(
	power: number,
	stone: StoneStats,
	rand: (number, number) -> number,
	options: Options?
): Outcome
	local opts: Options = options or {}
	power = math.clamp(power, 0, 1)
	if power < Skip.PLOP then
		return {
			power = power,
			skips = 0,
			hops = {},
			distance = 0,
			perfect = false,
			verdict = "plop",
		}
	end
	if power >= Skip.DIVE then
		return {
			power = power,
			skips = 0,
			hops = {},
			distance = 0,
			perfect = false,
			verdict = "dive",
		}
	end

	local perfect = Skip.isPerfect(power)
	local quality = Skip.quality(power)
	local multiplier = 0.45 + 0.65 * stone.flat
	if opts.night and stone.nightBonus then
		multiplier *= 1 + stone.nightBonus
	end
	local skips = math.floor((1 + 22 * quality ^ 1.6) * multiplier * rand(0.9, 1.1) + 0.5)
	if perfect then
		skips += Skip.PERFECT_BONUS
	end
	skips = math.max(skips, 1)

	local first = (5 + 14 * power) * (0.8 + 0.4 * stone.weight)
	local decay = 0.8 + 0.1 * stone.flat
	local available = opts.available or math.huge
	local hops: { number } = {}
	local distance = 0
	for i = 1, skips do
		local hop = math.max(first * decay ^ (i - 1) * rand(0.94, 1.06), Skip.MIN_HOP)
		if distance + hop >= available then
			-- this bounce carries it all the way onto the far shore
			table.insert(hops, math.max(available - distance, 0))
			return {
				power = power,
				skips = i,
				hops = hops,
				distance = math.max(available, distance),
				perfect = perfect,
				verdict = "shore",
			}
		end
		table.insert(hops, hop)
		distance += hop
	end
	return {
		power = power,
		skips = skips,
		hops = hops,
		distance = distance,
		perfect = perfect,
		verdict = "skips",
	}
end

return Skip
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">StoneModel</string>
          <string name="Source"><![CDATA[--!strict
-- Builds the little 3D stone for a StoneData id: a squashed sphere in the
-- stone's colour, glassy for gem stones, with a sparkle for the special ones.
-- Used for the stone in your hand, glints on the beach and stones in flight.

local StoneData = require(script.Parent.Data.StoneData)

local StoneModel = {}

local MATERIALS: { [string]: Enum.Material } = {
	SmoothPlastic = Enum.Material.SmoothPlastic,
	Glass = Enum.Material.Glass,
	Neon = Enum.Material.Neon,
}

function StoneModel.color(id: string): Color3
	local stone = (StoneData.get(id) or StoneData.get(StoneData.STARTER)) :: StoneData.Stone
	return Color3.fromRGB(stone.color[1], stone.color[2], stone.color[3])
end

-- An anchored, non-colliding part. `scale` 1 = a stone you can hold.
function StoneModel.build(id: string, scale: number?): Part
	local stone = (StoneData.get(id) or StoneData.get(StoneData.STARTER)) :: StoneData.Stone
	local s = scale or 1
	local part = Instance.new("Part")
	part.Name = "Stone"
	part.Size = Vector3.new(stone.size[1], stone.size[2], stone.size[3]) * s
	part.Color = StoneModel.color(stone.id)
	part.Material = MATERIALS[stone.material] or Enum.Material.SmoothPlastic
	part.Reflectance = if stone.material == "Glass" then 0.15 else 0.05
	part.Transparency = if stone.material == "Glass" then 0.1 else 0
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part:SetAttribute("Stone", stone.id)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = part
	if stone.sparkle then
		local sparkle = Instance.new("ParticleEmitter")
		sparkle.Name = "Sparkle"
		sparkle.Color = ColorSequence.new(Color3.new(1, 1, 1), part.Color)
		sparkle.LightEmission = 1
		sparkle.Rate = 5
		sparkle.Lifetime = NumberRange.new(0.4, 0.9)
		sparkle.Speed = NumberRange.new(0.2, 0.8)
		sparkle.SpreadAngle = Vector2.new(180, 180)
		sparkle.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.18 * s),
			NumberSequenceKeypoint.new(1, 0),
		})
		sparkle.Parent = part
	end
	return part
end

return StoneModel
]]></string>
        </Properties>
      </Item>
