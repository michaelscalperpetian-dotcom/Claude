      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">DayCycle</string>
          <string name="Source"><![CDATA[--!strict
-- The lake's day: a long golden day, then dusk, a starry night and dawn, every
-- Config.DAY_LENGTH seconds. Everyone sees the same time because it comes
-- from the server clock.

local Config = require(script.Parent.Config)

local DayCycle = {}

DayCycle.DAY_SHARE = 0.7 -- share of the cycle that is daytime (6:00 to 19:00)
DayCycle.NIGHT_FROM = 19.5 -- clock hours that count as night (for Moonstone, lanterns, fireflies)
DayCycle.NIGHT_UNTIL = 5.5

-- Lighting.ClockTime (0..24) at server time `now`.
function DayCycle.clockTime(now: number): number
	local phase = (now % Config.DAY_LENGTH) / Config.DAY_LENGTH
	if phase < DayCycle.DAY_SHARE then
		return 6 + phase / DayCycle.DAY_SHARE * 13
	end
	local nightPhase = (phase - DayCycle.DAY_SHARE) / (1 - DayCycle.DAY_SHARE)
	return (19 + nightPhase * 11) % 24
end

-- The inverse of clockTime: where in the cycle (0..1) the clock reads `clock`.
function DayCycle.phaseFor(clock: number): number
	local c = clock % 24
	if c >= 6 and c < 19 then
		return (c - 6) / 13 * DayCycle.DAY_SHARE
	end
	local sinceDusk = (c - 19) % 24 -- 0..11 hours into the night
	return DayCycle.DAY_SHARE + sinceDusk / 11 * (1 - DayCycle.DAY_SHARE)
end

-- How dark it is, 0 (day) .. 1 (deep night), easing through dusk and dawn.
function DayCycle.darkness(clock: number): number
	local c = clock % 24
	local function smooth(t: number): number
		local x = math.clamp(t, 0, 1)
		return x * x * (3 - 2 * x)
	end
	if c >= 17.5 then
		return smooth((c - 17.5) / 2.5) -- dusk: 17:30 -> 20:00
	elseif c < 4.5 then
		return 1
	elseif c < 6.5 then
		return 1 - smooth((c - 4.5) / 2) -- dawn: 4:30 -> 6:30
	end
	return 0
end

function DayCycle.isNightAt(clockTime: number): boolean
	return clockTime >= DayCycle.NIGHT_FROM or clockTime < DayCycle.NIGHT_UNTIL
end

function DayCycle.isNight(now: number): boolean
	return DayCycle.isNightAt(DayCycle.clockTime(now))
end

return DayCycle
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[--!strict
-- The simulator's numbers: how far a throw goes, what it pays, what
-- upgrades and rebirths cost. Pure maths so both sides (and the tests,
-- which check the pacing) agree.
--
--   distance = base throw x strength x rock power x rebirth power (x night, for Moonstone)
--   coins    = (distance / 10 + skips x 2) x coin multiplier (x1.25 for a perfect release)
--   coin multiplier = (1 + rebirths / 2) x (1 + island bonuses)
--
-- Strength gets dearer faster than it gets stronger, so each upgrade takes a
-- little longer than the last, until a rebirth (which resets coins and
-- strength but keeps your rocks and islands) speeds everything up again.

local IslandData = require(script.Parent.Data.IslandData)
local RockData = require(script.Parent.Data.RockData)

local Economy = {}

Economy.STRENGTH_STEP = 1.1 -- each strength level throws this much further
Economy.STRENGTH_BASE_COST = 20
Economy.STRENGTH_COST_GROWTH = 1.33
Economy.REBIRTH_BASE_COST = 40000
Economy.REBIRTH_COST_GROWTH = 7
Economy.REBIRTH_DISTANCE = 0.2 -- each rebirth: +20% distance...
Economy.REBIRTH_COINS = 0.5 -- ...and +50% coins
Economy.PERFECT_COINS = 1.25
Economy.MAX_STRENGTH = 500

-- What these formulas need to know about a player.
export type Stats = {
	strength: number,
	rebirths: number,
	equipped: string,
	islands: { [string]: boolean },
}

-- The parts of a saved profile these formulas read.
function Economy.statsOf(profile: {
	strength: number,
	rebirths: number,
	equipped: string,
	islands: { [string]: boolean },
}): Stats
	return {
		strength = profile.strength,
		rebirths = profile.rebirths,
		equipped = profile.equipped,
		islands = profile.islands,
	}
end

function Economy.strengthPower(level: number): number
	return Economy.STRENGTH_STEP ^ level
end

-- Coins to go from `level` to `level + 1`.
function Economy.strengthCost(level: number): number
	return math.floor(Economy.STRENGTH_BASE_COST * Economy.STRENGTH_COST_GROWTH ^ level)
end

-- Coins needed for the next rebirth.
function Economy.rebirthCost(rebirths: number): number
	return Economy.REBIRTH_BASE_COST * Economy.REBIRTH_COST_GROWTH ^ rebirths
end

function Economy.rebirthPower(rebirths: number): number
	return 1 + Economy.REBIRTH_DISTANCE * rebirths
end

function Economy.islandBonus(islands: { [string]: boolean }): number
	local bonus = 0
	for _, island in IslandData.LIST do
		if islands[island.id] then
			bonus += island.bonus
		end
	end
	return bonus
end

function Economy.coinMultiplier(stats: Stats): number
	return (1 + Economy.REBIRTH_COINS * stats.rebirths) * (1 + Economy.islandBonus(stats.islands))
end

function Economy.rockOf(stats: Stats): RockData.Rock
	return (RockData.get(stats.equipped) or RockData.get(RockData.STARTER)) :: RockData.Rock
end

-- Everything that multiplies a throw's base distance.
function Economy.distanceMultiplier(stats: Stats, night: boolean): number
	local rock = Economy.rockOf(stats)
	local nightBonus = if night and rock.nightBonus then 1 + rock.nightBonus else 1
	return Economy.strengthPower(stats.strength)
		* rock.power
		* Economy.rebirthPower(stats.rebirths)
		* nightBonus
end

function Economy.coinsFor(distance: number, skips: number, perfect: boolean, stats: Stats): number
	local raw = (distance / 10 + skips * 2) * Economy.coinMultiplier(stats)
	if perfect then
		raw *= Economy.PERFECT_COINS
	end
	return math.floor(raw)
end

-- Can this rock be bought with these islands reached (ignoring price)?
function Economy.rockUnlocked(rock: RockData.Rock, islands: { [string]: boolean }): boolean
	return rock.island == nil or islands[rock.island] == true
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Land</string>
          <string name="Source"><![CDATA[--!strict
-- The shape of the coast, as a height for every point near the lobby: a
-- sandy beach sloping into a bay, a flat plaza behind it for the boardwalk,
-- wooded hills rising behind that, and two rocky headlands that frame the
-- bay and run out into the sea. Beyond them the open ocean goes on forever
-- (Ground fills it with water). Also which terrain material belongs where.
-- Pure maths, so the server builds terrain from it, everything is placed on
-- it, and the tests check it.
--
-- Land is z < 0, the sea is z > 0, the water surface is Y = 0.

local Land = {}

Land.WATER_LEVEL = 0
Land.BOTTOM = -32 -- solid ground goes no deeper than this
Land.WEST, Land.EAST = -768, 768 -- the terrain written from this heightmap
Land.SOUTH, Land.NORTH = -768, 512 -- (south = inland, north = out to sea)
Land.BEACH_BACK = -40 -- the beach runs from here down to the water
Land.BANK = 3 -- the water is deep enough for terrain from here on (z)
Land.PLAZA_BACK = -110 -- the flat plaza behind the beach
Land.PLAZA_HEIGHT = 1.8
Land.BAY_HALF = 250 -- the headlands start this far either side of the middle
Land.HEADLAND_END = 290 -- and reach about this far out to sea

export type Material =
	"Water"
	| "Sand"
	| "Mud"
	| "Grass"
	| "LeafyGrass"
	| "Ground"
	| "Rock"
	| "Slate"
	| "Basalt"

local function clamp01(t: number): number
	return math.clamp(t, 0, 1)
end

local function smooth(t: number): number
	local x = clamp01(t)
	return x * x * (3 - 2 * x)
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * clamp01(t)
end

-- Layered noise, roughly -0.5..0.5.
local function fbm(x: number, z: number, scale: number, octaves: number, seed: number): number
	local total, amplitude, frequency, norm = 0, 1, 1 / scale, 0
	for i = 1, octaves do
		total += math.noise(x * frequency, z * frequency, seed + i * 17.31) * amplitude
		norm += amplitude
		amplitude *= 0.5
		frequency *= 2
	end
	return total / norm
end
Land.fbm = fbm

-- The ground without the headlands.
local function base(x: number, z: number): number
	if z > Land.BANK then
		-- the sea floor: a sandy shelf, then down into deep water
		if z < 60 then
			return lerp(-2.8, -9, (z - Land.BANK) / (60 - Land.BANK))
		end
		return lerp(-9, -22, (z - 60) / 160) + fbm(x, z, 60, 2, 2.4) * 3 * smooth((z - 60) / 100)
	elseif z > -1 then
		-- a short bank from the wet sand into the water
		return lerp(0.6, -2.8, (z + 1) / (Land.BANK + 1))
	elseif z > Land.BEACH_BACK then
		return lerp(Land.PLAZA_HEIGHT, 0.6, (z - Land.BEACH_BACK) / (-1 - Land.BEACH_BACK))
	elseif z > Land.PLAZA_BACK then
		return Land.PLAZA_HEIGHT
	end
	-- hills behind the plaza, rising into wooded ridges
	local t = smooth((Land.PLAZA_BACK - z) / 240)
	return Land.PLAZA_HEIGHT
		+ t * (55 + fbm(x, z, 120, 3, 5.5) * 50)
		+ fbm(x, z, 40, 2, 1.1) * 4 * t
end

-- How much of a headland stands at (x, z): 0 in the bay, 1 on the cliffs.
local function headland(x: number, z: number): number
	local across = smooth((math.abs(x) - Land.BAY_HALF + fbm(x, z, 70, 2, 8.8) * 50) / 110)
	local reach = Land.HEADLAND_END + fbm(x, z, 120, 2, 3.7) * 80
	local along = 1 - smooth((z - (reach - 140)) / 140)
	return across * along
end

-- Height of the ground's surface at (x, z).
function Land.height(x: number, z: number): number
	local h = base(x, z)
	local m = headland(x, z)
	if m > 0 then
		local cliff = 48 + fbm(x, z, 90, 3, 6.1) * 40 + math.max(Land.PLAZA_BACK - z, 0) * 0.12
		h = h + (math.max(cliff, 20) - h) * m
	end
	return h
end

-- How steep the ground is at (x, z) (rise over run).
function Land.slope(x: number, z: number): number
	local d = 2
	local dx = Land.height(x + d, z) - Land.height(x - d, z)
	local dz = Land.height(x, z + d) - Land.height(x, z - d)
	return math.sqrt(dx * dx + dz * dz) / (2 * d)
end

-- Which terrain material covers the ground at (x, z), given its height and slope.
function Land.material(x: number, z: number, height: number, slope: number): Material
	if slope > 1.4 then
		return if height > 30 then "Slate" else "Basalt"
	elseif slope > 0.85 then
		return "Rock"
	end
	if height < -12 then
		return "Mud"
	elseif height < 3 and z > Land.BEACH_BACK - 6 then
		return "Sand"
	end
	if height > 40 and slope > 0.5 then
		return "Ground"
	end
	return if fbm(x, z, 40, 2, 6.6) > 0.15 then "LeafyGrass" else "Grass"
end

-- A point on the ground (handy for placing things).
function Land.at(x: number, z: number, lift: number?): Vector3
	return Vector3.new(x, Land.height(x, z) + (lift or 0), z)
end

return Land
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- Every remote in the game, created by the server in one folder from one list.
-- Server handlers go through a per-player, per-remote rate limit before running.
-- Arguments from clients are hostile until validated (see server systems).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

export type ClientEvent =
	"Ready"
	| "BeginCharge"
	| "Release"
	| "CancelCharge"
	| "Equip"
	| "BuyRock"
	| "Upgrade"
	| "Rebirth"
	| "Dev"

export type ServerEvent = "State" | "Throw" | "Notify" | "Island"

local CLIENT_EVENTS: { ClientEvent } = {
	"Ready",
	"BeginCharge",
	"Release",
	"CancelCharge",
	"Equip",
	"BuyRock",
	"Upgrade",
	"Rebirth",
	"Dev",
}

local SERVER_EVENTS: { ServerEvent } = { "State", "Throw", "Notify", "Island" }

local FOLDER_NAME = "Remotes"

local Net = {}

local remotes: { [string]: RemoteEvent } = {}

-- Token bucket per player per remote.
type Bucket = { tokens: number, last: number }
local buckets: { [Player]: { [string]: Bucket } } = {}

local function allow(player: Player, key: string, ratePerSecond: number, burst: number): boolean
	local now = os.clock()
	local playerBuckets = buckets[player]
	if not playerBuckets then
		playerBuckets = {}
		buckets[player] = playerBuckets
	end
	local b = playerBuckets[key]
	if not b then
		b = { tokens = burst, last = now }
		playerBuckets[key] = b
	end
	b.tokens = math.min(burst, b.tokens + (now - b.last) * ratePerSecond)
	b.last = now
	if b.tokens < 1 then
		return false
	end
	b.tokens -= 1
	return true
end

-- Server: create every remote. Called once by the server entry point.
function Net.serverInit()
	assert(RunService:IsServer(), "Net.serverInit is server-only")
	local folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	for _, name in CLIENT_EVENTS do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		remotes[name] = remote
	end
	for _, name in SERVER_EVENTS do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		remotes[name] = remote
	end
	folder.Parent = ReplicatedStorage
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

local function getRemote(name: string): RemoteEvent
	local cached = remotes[name]
	if cached then
		return cached
	end
	local folder = ReplicatedStorage:WaitForChild(FOLDER_NAME)
	local remote = folder:WaitForChild(name)
	assert(remote:IsA("RemoteEvent"), `{name} is not a RemoteEvent`)
	remotes[name] = remote
	return remote
end

-- Server: handle a client event. Requests over the rate limit are dropped silently.
function Net.on(
	name: ClientEvent,
	ratePerSecond: number,
	burst: number,
	handler: (Player, ...unknown) -> ()
)
	getRemote(name).OnServerEvent:Connect(function(player: Player, ...: unknown)
		if not allow(player, name, ratePerSecond, burst) then
			return
		end
		handler(player, ...)
	end)
end

function Net.fire(player: Player, name: ServerEvent, ...: any)
	getRemote(name):FireClient(player, ...)
end

function Net.fireAll(name: ServerEvent, ...: any)
	getRemote(name):FireAllClients(...)
end

-- Client: send a request to the server.
function Net.send(name: ClientEvent, ...: any)
	getRemote(name):FireServer(...)
end

-- Client: listen to a server event.
function Net.listen(name: ServerEvent, handler: (...any) -> ())
	getRemote(name).OnClientEvent:Connect(handler)
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Palette</string>
          <string name="Source"><![CDATA[--!strict
-- The colours of Skip a Rock, shared by the world and the UI: a bright,
-- breezy seaside with sun-bleached wood and a deep blue ocean.

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local Palette = {
	-- Water: terrain water by day and by night, ripples
	seaDay = rgb(34, 112, 156),
	seaNight = rgb(16, 34, 64),
	ripple = rgb(232, 250, 255),

	-- Shore and land
	pebbleLight = rgb(204, 194, 176),
	pebble = rgb(178, 166, 148),
	pebbleDark = rgb(144, 132, 118),
	sand = rgb(228, 208, 168),
	path = rgb(196, 168, 124),
	grassLight = rgb(160, 206, 112),
	grass = rgb(128, 186, 94),
	grassDark = rgb(98, 160, 80),
	moss = rgb(112, 150, 82),

	-- Plants
	leafLight = rgb(138, 196, 98),
	leaf = rgb(102, 170, 84),
	leafDark = rgb(72, 138, 76),
	pine = rgb(60, 106, 70),
	pineDark = rgb(44, 84, 60),
	reed = rgb(150, 162, 92),
	reedDark = rgb(116, 132, 74),
	cattail = rgb(120, 82, 56),
	lily = rgb(92, 168, 96),

	-- Wood and stone (lighter than they look: wood textures darken them)
	woodLight = rgb(206, 164, 116),
	wood = rgb(178, 132, 90),
	woodDark = rgb(128, 92, 64),
	bark = rgb(116, 86, 64),
	logs = rgb(160, 112, 72),
	weathered = rgb(166, 150, 128),
	rope = rgb(200, 178, 132),
	iron = rgb(58, 56, 60),
	brass = rgb(214, 170, 82),
	window = rgb(164, 206, 226),
	rockLight = rgb(176, 174, 182),
	rock = rgb(146, 144, 156),
	rockDark = rgb(112, 110, 124),
	mountain = rgb(132, 136, 168),
	mountainDark = rgb(104, 108, 142),
	snow = rgb(246, 248, 255),

	-- Warm accents
	lantern = rgb(255, 204, 120),
	fire = rgb(255, 150, 60),
	ember = rgb(255, 110, 40),
	roof = rgb(150, 74, 62),
	cream = rgb(255, 246, 228),
	white = rgb(255, 255, 255),

	-- Seaside
	buoyRed = rgb(226, 72, 64),
	buoyWhite = rgb(246, 244, 238),
	canvas = rgb(244, 236, 214),
	awningBlue = rgb(70, 140, 214),
	awningRed = rgb(222, 86, 76),
	awningYellow = rgb(246, 196, 76),
	palmTrunk = rgb(150, 112, 76),
	palmLeaf = rgb(72, 150, 76),
	crystal = rgb(150, 220, 255),

	-- Flowers
	pink = rgb(246, 152, 184),
	yellow = rgb(250, 214, 92),
	purple = rgb(176, 148, 226),
	red = rgb(232, 98, 92),
	orange = rgb(246, 160, 82),
	blue = rgb(120, 170, 236),
}

Palette.FLOWERS = { Palette.pink, Palette.yellow, Palette.purple, Palette.white, Palette.orange }

return Palette
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">RockModel</string>
          <string name="Source"><![CDATA[--!strict
-- Builds the little 3D rock for a RockData id: a squashed sphere in the
-- rock's colour and material, glassy for gems, with a sparkle for the special
-- ones. Used for the rock in your hand, the shop and rocks in flight.

local RockData = require(script.Parent.Data.RockData)

local RockModel = {}

local MATERIALS: { [string]: Enum.Material } = {
	SmoothPlastic = Enum.Material.SmoothPlastic,
	Glass = Enum.Material.Glass,
	Neon = Enum.Material.Neon,
	Slate = Enum.Material.Slate,
	Marble = Enum.Material.Marble,
}

function RockModel.color(id: string): Color3
	local rock = (RockData.get(id) or RockData.get(RockData.STARTER)) :: RockData.Rock
	return Color3.fromRGB(rock.color[1], rock.color[2], rock.color[3])
end

-- An anchored, non-colliding part. `scale` 1 = a rock you can hold.
function RockModel.build(id: string, scale: number?): Part
	local rock = (RockData.get(id) or RockData.get(RockData.STARTER)) :: RockData.Rock
	local s = scale or 1
	local part = Instance.new("Part")
	part.Name = "Rock"
	part.Size = Vector3.new(rock.size[1], rock.size[2], rock.size[3]) * s
	part.Color = RockModel.color(rock.id)
	part.Material = MATERIALS[rock.material] or Enum.Material.SmoothPlastic
	part.Reflectance = if rock.material == "Glass" then 0.15 else 0.05
	part.Transparency = if rock.material == "Glass" then 0.1 else 0
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part:SetAttribute("Rock", rock.id)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = part
	if rock.sparkle then
		local sparkle = Instance.new("ParticleEmitter")
		sparkle.Name = "Sparkle"
		sparkle.Color = ColorSequence.new(Color3.new(1, 1, 1), part.Color)
		sparkle.LightEmission = 1
		sparkle.Rate = 5
		sparkle.Lifetime = NumberRange.new(0.4, 0.9)
		sparkle.Speed = NumberRange.new(0.2, 0.8)
		sparkle.SpreadAngle = Vector2.new(180, 180)
		sparkle.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.18 * s),
			NumberSequenceKeypoint.new(1, 0),
		})
		sparkle.Parent = part
	end
	return part
end

return RockModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Sea</string>
          <string name="Source"><![CDATA[--!strict
-- The coast and the ocean, shared by server and client. Land is z < 0 and
-- the open sea stretches forever toward +Z; the water surface is Y = 0.
-- Every rock flies straight out to sea from where it was thrown.
--
-- The ocean is endless but the world isn't, so distances out at sea are
-- drawn on a gently squeezed scale: true to life for the first 1,500 studs,
-- then each extra stud covers a little less of the map. Buoys and islands
-- use the same scale, so a rock that lands by the 10K buoy really did go
-- 10,000 studs.

local Config = require(script.Parent.Config)

local Sea = {}

Sea.LINEAR = 1500 -- true-to-life distances up to here...
Sea.SQUEEZE = 1600 -- ...then this sets how gently the scale squeezes
Sea.ENTRY_LEAD = 6 -- a rock first touches the water this far in front of you
Sea.FIRST_WATER = 6 -- and never closer to the beach than this
Sea.FORWARD = Vector3.new(0, 0, 1)

-- The five wooden piers, out into the bay.
Sea.PIER_XS = { -120, -60, 0, 60, 120 }
Sea.PIER_START = -14
Sea.PIER_END = 56
Sea.PIER_WIDTH = 8
Sea.PIER_TOP = 1.8 -- height of the deck

-- How far along the map (from the throw) a true distance is drawn.
function Sea.toWorld(distance: number): number
	local d = math.max(distance, 0)
	if d ~= d or d == math.huge then
		return Sea.LINEAR + Sea.SQUEEZE * 50
	end
	if d <= Sea.LINEAR then
		return d
	end
	return Sea.LINEAR + Sea.SQUEEZE * math.log(1 + (d - Sea.LINEAR) / Sea.SQUEEZE)
end

-- The inverse: the true distance drawn at `world` studs out.
function Sea.fromWorld(world: number): number
	local w = math.max(world, 0)
	if w <= Sea.LINEAR then
		return w
	end
	return Sea.LINEAR + Sea.SQUEEZE * (math.exp((w - Sea.LINEAR) / Sea.SQUEEZE) - 1)
end

-- Which pier (if any) a point is over, by its index in PIER_XS.
function Sea.pierAt(position: Vector3, margin: number?): number?
	local slack = margin or 0
	if position.Z < Sea.PIER_START - slack or position.Z > Sea.PIER_END + slack then
		return nil
	end
	for i, x in Sea.PIER_XS do
		if math.abs(position.X - x) <= Sea.PIER_WIDTH / 2 + slack then
			return i
		end
	end
	return nil
end

-- Can a rock be thrown from here? (On the beach or a pier, near the middle.)
function Sea.canThrowFrom(position: Vector3): boolean
	if position.Y > Config.MAX_THROW_HEIGHT then
		return false
	end
	if math.abs(position.X) > Config.THROW_ZONE_HALF_WIDTH then
		return false
	end
	return position.Z >= Config.THROW_ZONE_BACK
end

-- Where a rock thrown from `origin` first touches the water: straight out
-- in front, clear of the piers (it sails over one if you're behind it).
function Sea.entry(origin: Vector3): Vector3
	local z = math.max(origin.Z + Sea.ENTRY_LEAD, Sea.FIRST_WATER)
	local point = Vector3.new(origin.X, 0, z)
	if Sea.pierAt(point, 1) then
		z = math.max(z, Sea.PIER_END + 3)
	end
	return Vector3.new(origin.X, 0, z)
end

-- Where a rock is after travelling `distance` (true studs) from `entry`.
function Sea.along(entry: Vector3, distance: number): Vector3
	return Vector3.new(entry.X, 0, entry.Z + Sea.toWorld(distance))
end

return Sea
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Skip</string>
          <string name="Source"><![CDATA[--!strict
-- How a skipping rock behaves. Pure maths, shared by the server (which
-- decides every throw) and the client (which draws the power meter).
--
-- Holding the throw button winds up a power needle that swings 0 -> 1 -> 0
-- every PERIOD seconds. Letting go in the gold zone (just under full power)
-- gives the most skips; the very top of the swing is too hard and the rock
-- dives straight in. The rock's flatness adds skips; its weight makes each
-- hop longer. This gives the throw's shape in "base" studs; the economy then
-- scales it up by your strength, rock and rebirths (see Economy).

local Skip = {}

Skip.PERIOD = 1.5 -- seconds for one full swing of the power needle (0 -> 1 -> 0)
Skip.SWEET = 0.86 -- the best power
Skip.SWEET_WIDTH = 0.6 -- quality falls to 0 this far from SWEET
Skip.PERFECT = 0.035 -- within this of SWEET counts as a perfect release
Skip.DIVE = 0.975 -- at or above this the rock is thrown too hard and dives in
Skip.PLOP = 0.12 -- below this it just plops in
Skip.GOLD_LOW = 0.74 -- the gold zone on the meter runs from here up to DIVE
Skip.PERFECT_BONUS = 3 -- extra skips for a perfect release
Skip.MIN_HOP = 0.9 -- hops never get shorter than this (base studs)

export type Verdict = "plop" | "dive" | "skips"

export type Outcome = {
	power: number,
	skips: number, -- times it bounced off the water
	hops: { number }, -- length of each hop between touches, in base studs
	distance: number, -- base studs from the first touch to where it sank
	perfect: boolean,
	verdict: Verdict,
}

export type RockStats = { flat: number, weight: number }

-- Where the power needle is after holding for `elapsed` seconds.
function Skip.power(elapsed: number): number
	local phase = (math.max(elapsed, 0) % Skip.PERIOD) / Skip.PERIOD
	return if phase < 0.5 then phase * 2 else 2 - phase * 2
end

-- 0..1: how good a release at this power is.
function Skip.quality(power: number): number
	return math.clamp(1 - math.abs(power - Skip.SWEET) / Skip.SWEET_WIDTH, 0, 1)
end

function Skip.isPerfect(power: number): boolean
	return math.abs(power - Skip.SWEET) <= Skip.PERFECT
end

-- The whole throw. `rand(a, b)` returns a random number in [a, b]; pass a
-- seeded one to get the same throw again.
function Skip.outcome(power: number, rock: RockStats, rand: (number, number) -> number): Outcome
	power = math.clamp(power, 0, 1)
	if power < Skip.PLOP then
		return {
			power = power,
			skips = 0,
			hops = {},
			distance = 0,
			perfect = false,
			verdict = "plop",
		}
	end
	if power >= Skip.DIVE then
		return {
			power = power,
			skips = 0,
			hops = {},
			distance = 0,
			perfect = false,
			verdict = "dive",
		}
	end
	local perfect = Skip.isPerfect(power)
	local quality = Skip.quality(power)
	local multiplier = 0.45 + 0.65 * rock.flat
	local skips = math.floor((1 + 22 * quality ^ 1.6) * multiplier * rand(0.9, 1.1) + 0.5)
	if perfect then
		skips += Skip.PERFECT_BONUS
	end
	skips = math.max(skips, 1)

	local first = (5 + 14 * power) * (0.8 + 0.4 * rock.weight)
	local decay = 0.8 + 0.1 * rock.flat
	local hops: { number } = {}
	local distance = 0
	for i = 1, skips do
		local hop = math.max(first * decay ^ (i - 1) * rand(0.94, 1.06), Skip.MIN_HOP)
		table.insert(hops, hop)
		distance += hop
	end
	return {
		power = power,
		skips = skips,
		hops = hops,
		distance = distance,
		perfect = perfect,
		verdict = "skips",
	}
end

return Skip
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Tags</string>
          <string name="Source"><![CDATA[--!strict
-- CollectionService tags shared by the server (which tags things) and the
-- client (which brings them to life).

return {
	NIGHT_LIGHT = "NightLight", -- lights the client switches on at night
	FIREFLIES = "Fireflies", -- particle emitters that glow at night
	WINDOW = "GlowWindow", -- cabin windows that light up at night
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- Types that cross the client/server boundary, so both sides agree.

-- Saved for each player.
export type Profile = {
	version: number,
	coins: number,
	totalCoins: number, -- earned over all time (never goes down)
	strength: number, -- arm strength level (resets on rebirth)
	rocks: { [string]: boolean }, -- rocks owned (kept through rebirths)
	equipped: string,
	rebirths: number,
	islands: { [string]: boolean }, -- islands reached (kept through rebirths)
	bestDistance: number,
	bestSkips: number,
	throws: number,
	totalSkips: number,
	perfects: number,
	goals: { [string]: boolean },
	firstJoin: number,
	lastSeen: number,
}

-- What a player's own client gets (sent when it changes).
export type Snapshot = {
	coins: number,
	totalCoins: number,
	strength: number,
	rocks: { [string]: boolean },
	equipped: string,
	rebirths: number,
	islands: { [string]: boolean },
	bestDistance: number,
	bestSkips: number,
	throws: number,
	totalSkips: number,
	perfects: number,
	goals: { [string]: boolean },
	-- worked out by the server, so the client never has to
	coinMultiplier: number,
	distanceMultiplier: number,
	strengthCost: number,
	rebirthCost: number,
	title: string?,
	isDev: boolean,
}

-- Sent to everyone when someone throws, so every screen draws the same throw.
export type ThrowEvent = {
	userId: number,
	rock: string,
	origin: Vector3, -- where the rock leaves the thrower's hand
	entry: Vector3, -- its first touch on the water
	hops: { number }, -- each hop's true length in studs (draw with Sea.toWorld)
	skips: number,
	distance: number, -- true studs from the first touch
	coins: number,
	verdict: string, -- Skip.Verdict
	perfect: boolean,
	power: number, -- where the needle was when they let go (0..1)
	night: boolean,
	newBest: boolean, -- a longest throw (only matters to the thrower)
}

return nil
]]></string>
        </Properties>
      </Item>
