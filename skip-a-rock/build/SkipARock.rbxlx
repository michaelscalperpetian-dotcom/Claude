  <Item class="ServerScriptService" referent="29">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="30">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Skip a Rock server entry point. Two-phase start: init() every system (in
-- name order), then start() every system in its own thread.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

-- Remotes must exist before any system registers a handler in init().
Net.serverInit()

local Systems = script:WaitForChild("Systems")

type System = {
	init: (() -> ())?,
	start: (() -> ())?,
}

local loaded: { [string]: System } = {}
local order: { string } = {}
for _, child in Systems:GetChildren() do
	if child:IsA("ModuleScript") then
		loaded[child.Name] = require(child) :: any
		table.insert(order, child.Name)
	end
end
table.sort(order)

for _, name in order do
	local system = loaded[name]
	if system.init then
		system.init()
	end
end

for _, name in order do
	local system = loaded[name]
	if system.start then
		task.spawn(system.start)
	end
end

print("[SkipARock] server started")
]]></string>
      </Properties>
      <Item class="Folder" referent="31">
        <Properties>
          <string name="Name">Lib</string>
        </Properties>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Access</string>
            <string name="Source"><![CDATA[--!strict
-- Who may use the test tools: everyone in Studio, and in live games the
-- game's owner plus anyone in Config.DEV_USER_IDS.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local Access = {}

function Access.isDev(player: Player): boolean
	if RunService:IsStudio() then
		return true
	end
	if table.find(Config.DEV_USER_IDS, player.UserId) then
		return true
	end
	return game.CreatorType == Enum.CreatorType.User and game.CreatorId == player.UserId
end

return Access
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">BoardData</string>
            <string name="Source"><![CDATA[--!strict
-- The global leaderboards on the boardwalk (built by Scenery, filled in by
-- the Leaderboards system).

export type Key = "Distance" | "Coins" | "Rebirths"

export type Board = {
	key: Key,
	title: string,
	store: string, -- OrderedDataStore name
	color: Color3,
	logScale: boolean, -- stored as a scaled logarithm (simulator numbers outgrow integers)
}

local BoardData = {
	ROWS = 10,
	LOG_SCALE = 1e10, -- stored value = floor(log10(1 + score) x LOG_SCALE)
	BOARDS = {
		{
			key = "Distance",
			title = "📏 Longest Throw",
			store = "SkipARock_LB_Distance_v1",
			color = Color3.fromRGB(70, 150, 220),
			logScale = true,
		},
		{
			key = "Coins",
			title = "💰 Most Coins",
			store = "SkipARock_LB_Coins_v1",
			color = Color3.fromRGB(236, 172, 52),
			logScale = true,
		},
		{
			key = "Rebirths",
			title = "🔁 Most Rebirths",
			store = "SkipARock_LB_Rebirths_v1",
			color = Color3.fromRGB(160, 110, 230),
			logScale = false,
		},
	} :: { Board },
}

function BoardData.encode(board: Board, score: number): number
	local s = if score ~= score then 0 else math.max(score, 0)
	if board.logScale then
		return math.floor(math.log10(1 + math.min(s, 1e300)) * BoardData.LOG_SCALE)
	end
	return math.floor(math.min(s, 2 ^ 53))
end

function BoardData.decode(board: Board, stored: number): number
	if board.logScale then
		return 10 ^ (stored / BoardData.LOG_SCALE) - 1
	end
	return stored
end

return BoardData
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Boards</string>
            <string name="Source"><![CDATA[--!strict
-- A wooden leaderboard: two posts, a cream face and a SurfaceGui with a title
-- and BoardData.ROWS rows, each with Rank / Player / Score labels for the
-- Leaderboards system to fill in.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Palette = require(ReplicatedStorage.Shared.Palette)
local BoardData = require(script.Parent.BoardData)
local Build = require(script.Parent.Build)

local Boards = {}

local INK = Color3.fromRGB(58, 44, 40)

type Column = { name: string, x: number, width: number, align: Enum.TextXAlignment }
local COLUMNS: { Column } = {
	{ name = "Rank", x = 0.02, width = 0.14, align = Enum.TextXAlignment.Center },
	{ name = "Player", x = 0.17, width = 0.5, align = Enum.TextXAlignment.Left },
	{ name = "Score", x = 0.67, width = 0.31, align = Enum.TextXAlignment.Right },
}

-- `base` stands on the ground; its -Z (front) is the readable side.
function Boards.build(
	key: string,
	title: string,
	color: Color3,
	base: CFrame,
	parent: Instance
): SurfaceGui
	local model = Build.model(key, parent)
	for _, side in { -1, 1 } do
		Build.block(
			Vector3.new(0.9, 13, 0.9),
			base * CFrame.new(side * 4.6, 6.5, 0.6),
			Palette.woodDark,
			model,
			{ name = "Post", shadow = false, material = Enum.Material.Wood }
		)
	end
	local face = Build.block(
		Vector3.new(9.6, 10.5, 0.6),
		base * CFrame.new(0, 7.4, 0),
		Palette.cream,
		model,
		{ name = "Face", decor = true }
	)
	-- a little roof keeps the rain off
	Build.block(
		Vector3.new(11, 0.6, 2),
		base * CFrame.new(0, 13.1, 0.3),
		Palette.roof,
		model,
		{ name = "Cap", decor = true, shadow = false, material = Enum.Material.RoofShingles }
	)

	local gui = Instance.new("SurfaceGui")
	gui.Name = "Board"
	gui.Face = Enum.NormalId.Front
	gui.LightInfluence = 0
	gui.PixelsPerStud = 40
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.Parent = face

	local heading = Instance.new("TextLabel")
	heading.Name = "Title"
	heading.BackgroundColor3 = color
	heading.BorderSizePixel = 0
	heading.Size = UDim2.fromScale(1, 0.13)
	heading.Font = Enum.Font.FredokaOne
	heading.Text = title
	heading.TextScaled = true
	heading.TextColor3 = Color3.new(1, 1, 1)
	local stroke = Instance.new("UIStroke")
	stroke.Color = INK
	stroke.Thickness = 2
	stroke.Parent = heading
	heading.Parent = gui

	local rowHeight = 0.85 / BoardData.ROWS
	for row = 1, BoardData.ROWS do
		local frame = Instance.new("Frame")
		frame.Name = "Row" .. row
		frame.BackgroundColor3 = if row % 2 == 0
			then Color3.fromRGB(246, 236, 216)
			else Color3.fromRGB(255, 250, 240)
		frame.BorderSizePixel = 0
		frame.Position = UDim2.fromScale(0, 0.14 + (row - 1) * rowHeight)
		frame.Size = UDim2.fromScale(1, rowHeight)
		frame.Parent = gui
		for _, column in COLUMNS do
			local text = Instance.new("TextLabel")
			text.Name = column.name
			text.BackgroundTransparency = 1
			text.Position = UDim2.fromScale(column.x, 0.12)
			text.Size = UDim2.fromScale(column.width, 0.76)
			text.Font = Enum.Font.FredokaOne
			text.TextScaled = true
			text.TextXAlignment = column.align
			text.TextColor3 = INK
			text.Text = if column.name == "Rank" then tostring(row) else ""
			text.Parent = frame
		end
	end
	return gui
end

return Boards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Build</string>
            <string name="Source"><![CDATA[--!strict
-- Part-building helpers for the generated world. Every part is anchored
-- SmoothPlastic. Purely decorative parts can skip touch/query work (`decor`)
-- and small ones can skip shadows, which keeps a part-built world cheap on phones.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Frames = require(ReplicatedStorage.Shared.Util.Frames)

local Build = {}

export type Options = {
	name: string?,
	material: Enum.Material?,
	transparency: number?,
	reflectance: number?,
	collide: boolean?, -- default true
	shadow: boolean?, -- default true
	decor: boolean?, -- no Touched events or raycasts
}

local function finish(p: BasePart, color: Color3, parent: Instance, options: Options?): ()
	p.Anchored = true
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	if options then
		if options.name then
			p.Name = options.name
		end
		if options.material then
			p.Material = options.material
		end
		if options.transparency then
			p.Transparency = options.transparency
		end
		if options.reflectance then
			p.Reflectance = options.reflectance
		end
		if options.collide == false then
			p.CanCollide = false
		end
		if options.shadow == false then
			p.CastShadow = false
		end
		if options.decor then
			p.CanTouch = false
			p.CanQuery = false
		end
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
end

function Build.block(
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	parent: Instance,
	options: Options?
): Part
	local p = Instance.new("Part")
	p.Name = "Block"
	p.Size = size
	p.CFrame = cframe
	finish(p, color, parent, options)
	return p
end

-- Wedge: the slope rises toward -Z (front), full height at the back (+Z).
function Build.wedge(
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	parent: Instance,
	options: Options?
): WedgePart
	local p = Instance.new("WedgePart")
	p.Name = "Wedge"
	p.Size = size
	p.CFrame = cframe
	finish(p, color, parent, options)
	return p
end

function Build.ball(
	diameter: number,
	position: Vector3,
	color: Color3,
	parent: Instance,
	options: Options?
): Part
	local p = Instance.new("Part")
	p.Name = "Ball"
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(diameter, diameter, diameter)
	p.CFrame = CFrame.new(position)
	finish(p, color, parent, options)
	return p
end

-- Stretched sphere (a sphere mesh fills the part's box).
function Build.ellipsoid(
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	parent: Instance,
	options: Options?
): Part
	local p = Instance.new("Part")
	p.Name = "Ellipsoid"
	p.Size = size
	p.CFrame = cframe
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	finish(p, color, parent, options)
	return p
end

-- Upright cylinder centred on `cframe` (Roblox cylinders run along X, so this
-- turns X onto the frame's Y axis).
function Build.disc(
	diameter: number,
	height: number,
	cframe: CFrame,
	color: Color3,
	parent: Instance,
	options: Options?
): Part
	local p = Instance.new("Part")
	p.Name = "Disc"
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(height, diameter, diameter)
	p.CFrame = cframe * CFrame.Angles(0, 0, math.rad(90))
	finish(p, color, parent, options)
	return p
end

-- Cylinder from point a to point b.
function Build.rod(
	a: Vector3,
	b: Vector3,
	diameter: number,
	color: Color3,
	parent: Instance,
	options: Options?
): Part
	local p = Instance.new("Part")
	p.Name = "Rod"
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new((b - a).Magnitude, diameter, diameter)
	p.CFrame = Frames.alongX((a + b) / 2, b - a)
	finish(p, color, parent, options)
	return p
end

-- Flat-topped bar from a to b (its up side stays as close to world-up as it can).
function Build.beam(
	a: Vector3,
	b: Vector3,
	width: number,
	thickness: number,
	color: Color3,
	parent: Instance,
	options: Options?
): Part
	local p = Instance.new("Part")
	p.Name = "Beam"
	p.Size = Vector3.new(width, thickness, (b - a).Magnitude)
	p.CFrame = Frames.alongZ((a + b) / 2, b - a)
	finish(p, color, parent, options)
	return p
end

-- Flat ring of blocks around `center` (an upright frame), e.g. a circular path.
function Build.ring(
	center: CFrame,
	radius: number,
	width: number,
	height: number,
	segments: number,
	color: Color3,
	parent: Instance,
	options: Options?
): { Part }
	local parts = {}
	local step = 2 * math.pi / segments
	-- Segment length covering the outer edge so neighbours meet without gaps.
	local length = 2 * (radius + width / 2) * math.tan(step / 2) + 0.05
	for i = 0, segments - 1 do
		local angle = i * step
		local cf = center * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -radius)
		table.insert(
			parts,
			Build.block(Vector3.new(length, height, width), cf, color, parent, options)
		)
	end
	return parts
end

-- Ground position on a circle (angle 0 points along +Z, matching the plots).
function Build.polar(angle: number, radius: number, y: number?): Vector3
	return Vector3.new(math.sin(angle) * radius, y or 0, math.cos(angle) * radius)
end

function Build.model(name: string, parent: Instance?): Model
	local m = Instance.new("Model")
	m.Name = name
	if parent then
		m.Parent = parent
	end
	return m
end

return Build
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Ground</string>
            <string name="Source"><![CDATA[--!strict
-- Turns the coast in Land into real Roblox terrain: smooth voxels for the
-- beach, the bay, the hills and the headlands, and terrain water everywhere
-- below sea level (with gentle waves and reflections). Then it fills the open
-- ocean beyond, far out to the horizon. Also swaying grass, soft material
-- colours and drifting clouds. The coast is built in chunks, nearest the
-- lobby first, pausing between chunks so the server never stalls.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Land = require(ReplicatedStorage.Shared.Land)
local Palette = require(ReplicatedStorage.Shared.Palette)

local Ground = {}

Ground.VOXEL = 4
Ground.CHUNK = 64 -- studs per side of each block of terrain written at once
Ground.BUDGET = 0.025 -- seconds of work between pauses

Ground.OCEAN_HALF_WIDTH = 1536 -- the open ocean reaches this far either side...
Ground.OCEAN_END = 10240 -- ...and this far out (past it, the haze takes over)
Ground.OCEAN_DEPTH = 8 -- studs of water (two voxels: deep enough to look deep)
Ground.OCEAN_TILE = 2048 -- filled in blocks this big

local MATERIALS: { [Land.Material]: Enum.Material } = {
	Water = Enum.Material.Water,
	Sand = Enum.Material.Sand,
	Mud = Enum.Material.Mud,
	Grass = Enum.Material.Grass,
	LeafyGrass = Enum.Material.LeafyGrass,
	Ground = Enum.Material.Ground,
	Rock = Enum.Material.Rock,
	Slate = Enum.Material.Slate,
	Basalt = Enum.Material.Basalt,
}

-- Soft, slightly warm colours for each material (Roblox's defaults are harsh).
export type Tint = { material: Enum.Material, color: Color3 }
Ground.COLORS = {
	{ material = Enum.Material.Grass, color = Color3.fromRGB(108, 150, 76) },
	{ material = Enum.Material.LeafyGrass, color = Color3.fromRGB(92, 134, 66) },
	{ material = Enum.Material.Sand, color = Color3.fromRGB(226, 208, 164) },
	{ material = Enum.Material.Mud, color = Color3.fromRGB(96, 84, 66) },
	{ material = Enum.Material.Ground, color = Color3.fromRGB(142, 116, 84) },
	{ material = Enum.Material.Rock, color = Color3.fromRGB(124, 122, 128) },
	{ material = Enum.Material.Slate, color = Color3.fromRGB(100, 104, 112) },
	{ material = Enum.Material.Basalt, color = Color3.fromRGB(82, 80, 86) },
} :: { Tint }

local function floorTo(value: number, step: number): number
	return math.floor(value / step) * step
end

local function ceilTo(value: number, step: number): number
	return math.ceil(value / step) * step
end

-- The water, grass and colours (no voxels).
function Ground.style(terrain: Terrain)
	terrain.WaterColor = Palette.seaDay
	terrain.WaterTransparency = 0.4
	terrain.WaterReflectance = 0.7
	terrain.WaterWaveSize = 0.12
	terrain.WaterWaveSpeed = 8
	-- grass blades that sway in the wind (cosmetic: never let it stop the build)
	pcall(function()
		terrain.Decoration = true
	end)
	for _, tint in Ground.COLORS do
		terrain:SetMaterialColor(tint.material, tint.color)
	end
	if not terrain:FindFirstChildOfClass("Clouds") then
		local clouds = Instance.new("Clouds")
		clouds.Cover = 0.52
		clouds.Density = 0.55
		clouds.Color = Color3.fromRGB(255, 252, 246)
		clouds.Parent = terrain
	end
end

-- Every chunk's lower corner, nearest the lobby first.
function Ground.chunks(): { Vector2 }
	local list: { Vector2 } = {}
	for x = Land.WEST, Land.EAST - Ground.CHUNK, Ground.CHUNK do
		for z = Land.SOUTH, Land.NORTH - Ground.CHUNK, Ground.CHUNK do
			table.insert(list, Vector2.new(x, z))
		end
	end
	table.sort(list, function(a, b)
		local c = Ground.CHUNK / 2
		return (a + Vector2.new(c, c)).Magnitude < (b + Vector2.new(c, c)).Magnitude
	end)
	return list
end

-- The open ocean beyond the coast, as blocks of water: one big stretch out
-- to the horizon, and the sea either side of the headlands.
function Ground.oceanBlocks(): { { cframe: CFrame, size: Vector3 } }
	local blocks = {}
	local tile = Ground.OCEAN_TILE
	local depth = Ground.OCEAN_DEPTH
	local function add(x0: number, x1: number, z0: number, z1: number)
		local x = x0
		while x < x1 do
			local z = z0
			local w = math.min(tile, x1 - x)
			while z < z1 do
				local l = math.min(tile, z1 - z)
				table.insert(blocks, {
					cframe = CFrame.new(x + w / 2, -depth / 2, z + l / 2),
					size = Vector3.new(w, depth, l),
				})
				z += l
			end
			x += w
		end
	end
	local half = Ground.OCEAN_HALF_WIDTH
	add(-half, half, Land.NORTH, Ground.OCEAN_END)
	-- beside the coast, past the headlands
	add(-half, Land.WEST, 0, Land.NORTH)
	add(Land.EAST, half, 0, Land.NORTH)
	return blocks
end

export type Voxels = {
	region: Region3,
	materials: { { { Enum.Material } } },
	occupancies: { { { number } } },
}

-- The voxels for one chunk with its lower corner at (x0, z0).
function Ground.chunk(x0: number, z0: number): Voxels
	local v = Ground.VOXEL
	local columns = Ground.CHUNK // v
	local heights: { { number } } = {}
	local kinds: { { Enum.Material } } = {}
	local low, high = math.huge, -math.huge
	for i = 1, columns do
		heights[i] = {}
		kinds[i] = {}
		for k = 1, columns do
			local x = x0 + (i - 0.5) * v
			local z = z0 + (k - 0.5) * v
			local h = Land.height(x, z)
			heights[i][k] = h
			kinds[i][k] = MATERIALS[Land.material(x, z, h, Land.slope(x, z))]
			low = math.min(low, h)
			high = math.max(high, h)
		end
	end
	-- solid ground a dozen studs deep under the surface is plenty; below
	-- the lake it reaches down to the bottom
	local bottom = math.max(floorTo(low - 12, v), Land.BOTTOM)
	local top = ceilTo(math.max(high, Land.WATER_LEVEL) + v, v)
	local layers = (top - bottom) // v
	local materials: { { { Enum.Material } } } = {}
	local occupancies: { { { number } } } = {}
	for i = 1, columns do
		materials[i] = {}
		occupancies[i] = {}
		for j = 1, layers do
			local mats = {}
			local occs = {}
			local y0 = bottom + (j - 1) * v
			for k = 1, columns do
				local h = heights[i][k]
				local fill = math.clamp((h - y0) / v, 0, 1)
				if y0 + v <= Land.WATER_LEVEL and fill < 0.5 then
					-- under the lake's surface: water fills what the ground doesn't
					mats[k] = Enum.Material.Water
					occs[k] = 1
				elseif fill > 0 then
					mats[k] = kinds[i][k]
					occs[k] = fill
				else
					mats[k] = Enum.Material.Air
					occs[k] = 0
				end
			end
			materials[i][j] = mats
			occupancies[i][j] = occs
		end
	end
	local region = Region3.new(
		Vector3.new(x0, bottom, z0),
		Vector3.new(x0 + Ground.CHUNK, top, z0 + Ground.CHUNK)
	)
	return { region = region:ExpandToGrid(v), materials = materials, occupancies = occupancies }
end

-- Builds all of it. Yields (call from its own thread).
function Ground.build(terrain: Terrain)
	Ground.style(terrain)
	local started = os.clock()
	for _, block in Ground.oceanBlocks() do
		terrain:FillBlock(block.cframe, block.size, Enum.Material.Water)
		task.wait()
	end
	for _, corner in Ground.chunks() do
		local voxels = Ground.chunk(corner.X, corner.Y)
		terrain:WriteVoxels(voxels.region, Ground.VOXEL, voxels.materials, voxels.occupancies)
		if os.clock() - started > Ground.BUDGET then
			task.wait()
			started = os.clock()
		end
	end
end

return Ground
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Notify</string>
            <string name="Source"><![CDATA[--!strict
-- Little messages that pop up on a player's screen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

export type Style = "info" | "good" | "bad" | "rare"

local Notify = {}

function Notify.send(player: Player, text: string, style: Style?)
	Net.fire(player, "Notify", text, style or "info")
end

function Notify.all(text: string, style: Style?)
	Net.fireAll("Notify", text, style or "info")
end

return Notify
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Props</string>
            <string name="Source"><![CDATA[--!strict
-- Natural props built from parts: trees, bushes, ferns, flowers and rocks.
-- Real materials (bark, leaves, rock) instead of plain plastic, two or three
-- shades each, and a little randomness so nothing looks stamped. Each
-- builder takes a ground position, a size multiplier and a random generator
-- (so layouts are repeatable).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Frames = require(ReplicatedStorage.Shared.Util.Frames)
local Palette = require(ReplicatedStorage.Shared.Palette)
local Rng = require(ReplicatedStorage.Shared.Util.Rng)
local Build = require(script.Parent.Build)

local Props = {}

type Gen = Rng.Generator

local BARK: Build.Options = { name = "Trunk", material = Enum.Material.Wood }
local LEAF: Build.Options = { decor = true, collide = false, material = Enum.Material.LeafyGrass }
local SMALL: Build.Options = { decor = true, collide = false, shadow = false }
local ROCK: Build.Options = { decor = true, material = Enum.Material.Rock }

local function between(gen: Gen, a: number, b: number): number
	return a + (b - a) * gen.next()
end

local function pick<T>(gen: Gen, list: { T }): T
	return list[gen.int(1, #list)]
end

local function horizontal(angle: number): Vector3
	return Vector3.new(math.sin(angle), 0, math.cos(angle))
end

-- A colour nudged a little lighter or darker.
local function vary(gen: Gen, c: Color3, amount: number): Color3
	local t = (gen.next() - 0.5) * 2 * amount
	return if t > 0 then c:Lerp(Color3.new(1, 1, 1), t) else c:Lerp(Color3.new(0, 0, 0), -t)
end

-- Leafy round tree: a short trunk under a cluster of soft blobs.
function Props.tree(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Tree", parent)
	local h = between(gen, 7.5, 9.5) * s
	local lean = horizontal(gen.next() * math.pi * 2) * between(gen, 0.3, 1.2) * s
	local mid = base + Vector3.new(0, h * 0.5, 0) + lean * 0.3
	local top = base + Vector3.new(0, h, 0) + lean
	Build.rod(base - Vector3.new(0, 1, 0), mid, 2 * s, Palette.bark, m, BARK)
	Build.rod(mid, top, 1.5 * s, Palette.bark, m, BARK)

	local yaw = CFrame.Angles(0, gen.next() * math.pi * 2, 0)
	local c = top + Vector3.new(0, 1.6 * s, 0)
	local function blob(size: Vector3, offset: Vector3, color: Color3)
		Build.ellipsoid(
			size * s,
			CFrame.new(c + yaw:VectorToWorldSpace(offset * s)),
			color,
			m,
			LEAF
		)
	end
	local leaf = vary(gen, Palette.leaf, 0.12)
	blob(Vector3.new(10.5, 8, 10.5), Vector3.zero, leaf)
	blob(Vector3.new(7, 5.6, 7), Vector3.new(4.2, -1.4, 1.2), vary(gen, Palette.leafDark, 0.1))
	blob(Vector3.new(6.5, 5.2, 6.5), Vector3.new(-3.8, -1, -2), vary(gen, Palette.leafDark, 0.1))
	blob(Vector3.new(6.5, 5, 6.5), Vector3.new(0.8, 3.1, -0.6), vary(gen, Palette.leafLight, 0.1))
	return m
end

-- A tall pine: a slim trunk through five drooping tiers of needles,
-- narrowing to a point.
function Props.pine(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Pine", parent)
	local height = 17 * s
	Build.rod(
		base - Vector3.new(0, 1, 0),
		base + Vector3.new(0, height * 0.8, 0),
		1.1 * s,
		Palette.bark,
		m,
		BARK
	)
	local lean = horizontal(gen.next() * math.pi * 2) * 0.25 * s
	local shade = vary(gen, Palette.pine, 0.12)
	local dark = vary(gen, Palette.pineDark, 0.1)
	local tiers = 5
	for i = 1, tiers do
		local t = (i - 1) / (tiers - 1) -- 0 at the bottom tier, 1 at the top
		local width = (8.6 - 6.4 * t) * s
		local tall = (3.6 - 0.9 * t) * s
		local y = (3.2 + t * 11.2) * s
		Build.ellipsoid(
			Vector3.new(width, tall, width * between(gen, 0.9, 1)),
			CFrame.new(base + Vector3.new(0, y, 0) + lean * t)
				* CFrame.Angles(0, gen.next() * math.pi, 0),
			if i % 2 == 1 then shade else dark,
			m,
			LEAF
		)
	end
	-- the pointed tip
	Build.ellipsoid(
		Vector3.new(1.4, 3.2, 1.4) * s,
		CFrame.new(base + Vector3.new(0, 16 * s, 0) + lean),
		shade,
		m,
		LEAF
	)
	return m
end

-- Low fern of drooping leaves.
function Props.fern(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Fern", parent)
	local leaves = 7
	local spin = gen.next() * math.pi * 2
	for i = 1, leaves do
		local a = spin + i * (2 * math.pi / leaves)
		local rise = math.rad(between(gen, 30, 48))
		local dir = horizontal(a) * math.cos(rise) + Vector3.new(0, math.sin(rise), 0)
		Build.ellipsoid(
			Vector3.new(1.5, 0.3, 6) * s,
			Frames.alongZ(base + dir * 2.7 * s + Vector3.new(0, 0.2, 0), dir),
			if i % 2 == 0 then Palette.leafDark else Palette.leaf,
			m,
			SMALL
		)
	end
	Build.ball(1.4 * s, base + Vector3.new(0, 0.4 * s, 0), Palette.leafDark, m, SMALL)
	return m
end

-- Round bush, sometimes with berries.
function Props.bush(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Bush", parent)
	local yaw = CFrame.Angles(0, gen.next() * math.pi * 2, 0)
	local function blob(size: Vector3, offset: Vector3, color: Color3)
		Build.ellipsoid(
			size * s,
			CFrame.new(base + yaw:VectorToWorldSpace(offset * s)),
			color,
			m,
			LEAF
		)
	end
	blob(Vector3.new(5, 3.6, 5), Vector3.new(0, 1.3, 0), vary(gen, Palette.leaf, 0.12))
	blob(Vector3.new(3.6, 2.8, 3.6), Vector3.new(2.3, 0.9, 0.8), Palette.leafDark)
	blob(Vector3.new(3.4, 2.6, 3.4), Vector3.new(-2.1, 0.8, -0.9), Palette.leafDark)
	blob(Vector3.new(3, 2.4, 3), Vector3.new(0.4, 2.4, -0.3), Palette.leafLight)
	if gen.next() < 0.45 then
		local berry = if gen.next() < 0.5 then Palette.pink else Palette.red
		for i = 1, 4 do
			local a = i * 1.7 + gen.next()
			local p = base
				+ yaw:VectorToWorldSpace(
					Vector3.new(math.sin(a) * 2.4, 1.6 + math.cos(a * 3) * 0.8, math.cos(a) * 2.4)
						* s
				)
			Build.ball(0.6 * s, p, berry, m, SMALL)
		end
	end
	return m
end

-- A little patch of flowers.
function Props.flowers(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Flowers", parent)
	local color = pick(gen, Palette.FLOWERS)
	for i = 1, 5 do
		local a = i * 1.26 + gen.next() * 0.5
		local r = between(gen, 0.4, 1.7) * s
		local foot = base + Vector3.new(math.sin(a) * r, 0, math.cos(a) * r)
		local height = between(gen, 0.9, 1.5) * s
		local head = foot + Vector3.new(0, height, 0)
		Build.rod(foot, head, 0.18 * s, Palette.grassDark, m, SMALL)
		local petals = if gen.next() < 0.75 then color else pick(gen, Palette.FLOWERS)
		Build.ellipsoid(Vector3.new(1.2, 0.45, 1.2) * s, CFrame.new(head), petals, m, SMALL)
		local middle = if petals == Palette.yellow then Palette.orange else Palette.yellow
		Build.ball(0.45 * s, head + Vector3.new(0, 0.18 * s, 0), middle, m, SMALL)
	end
	return m
end

-- A weathered boulder, half sunk in the ground, sometimes with moss on top.
function Props.rock(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Rock", parent)
	local yaw = CFrame.Angles(gen.next() * 0.3, gen.next() * math.pi * 2, gen.next() * 0.3)
	local stone = vary(gen, Palette.rock, 0.1)
	Build.ellipsoid(
		Vector3.new(5, 3.2, 4) * s,
		CFrame.new(base + Vector3.new(0, 0.5 * s, 0)) * yaw,
		stone,
		m,
		ROCK
	)
	Build.ellipsoid(
		Vector3.new(2.8, 2, 2.6) * s,
		CFrame.new(base + yaw:VectorToWorldSpace(Vector3.new(2.2, 0, 1) * s)) * yaw,
		Palette.rockDark,
		m,
		ROCK
	)
	if gen.next() < 0.5 then
		Build.ellipsoid(
			Vector3.new(3, 0.8, 2.4) * s,
			CFrame.new(base + Vector3.new(-0.2, 1.95, -0.1) * s) * yaw,
			Palette.moss,
			m,
			{ decor = true, collide = false, shadow = false, material = Enum.Material.LeafyGrass }
		)
	end
	return m
end

-- A palm: a gently curving, ringed trunk under a crown of drooping fronds,
-- with a few coconuts.
function Props.palm(base: Vector3, s: number, gen: Gen, parent: Instance): Model
	local m = Build.model("Palm", parent)
	local height = between(gen, 13, 17) * s
	local lean = horizontal(gen.next() * math.pi * 2) * between(gen, 2, 4.5) * s
	local segments = 6
	local last = base - Vector3.new(0, 0.6, 0)
	for i = 1, segments do
		local t = i / segments
		-- the trunk bends more toward the top
		local point = base + Vector3.new(0, height * t, 0) + lean * t * t
		Build.rod(
			last,
			point,
			(1.25 - 0.35 * t) * s,
			if i % 2 == 0 then Palette.palmTrunk else Palette.bark,
			m,
			BARK
		)
		last = point
	end
	local top = last
	local fronds = 8
	local spin = gen.next() * math.pi * 2
	for i = 1, fronds do
		local a = spin + i * (2 * math.pi / fronds)
		local droop = math.rad(between(gen, 10, 35))
		local dir = horizontal(a) * math.cos(droop) - Vector3.new(0, math.sin(droop), 0)
		Build.ellipsoid(
			Vector3.new(1.8, 0.35, 8.5) * s,
			Frames.alongZ(top + dir * 3.8 * s, dir),
			vary(gen, Palette.palmLeaf, 0.12),
			m,
			LEAF
		)
	end
	for i = 1, 3 do
		local a = i * 2.1 + gen.next()
		Build.ball(
			0.9 * s,
			top + Vector3.new(math.sin(a) * 0.7, -0.7, math.cos(a) * 0.7) * s,
			Palette.woodDark,
			m,
			SMALL
		)
	end
	return m
end

return Props
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Scenery</string>
            <string name="Source"><![CDATA[--!strict
-- Everything built from parts on top of the terrain (see Ground for the
-- coast itself): five wooden piers out into the bay, a sandy beach with
-- umbrellas and palms, a boardwalk plaza with the Rock Shop, the Strength
-- Gym, the Rebirth Shrine and the leaderboards, a lighthouse on the
-- headland, distance buoys and islands far out at sea, and the invisible
-- walls that keep everyone out of the water. Decorations come from fixed
-- random seeds, so every server looks the same.
--
-- Land is z < 0, the sea is z > 0; everything stands on Land.height(x, z).

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local IslandData = require(ReplicatedStorage.Shared.Data.IslandData)
local Land = require(ReplicatedStorage.Shared.Land)
local Palette = require(ReplicatedStorage.Shared.Palette)
local Sea = require(ReplicatedStorage.Shared.Sea)
local Tags = require(ReplicatedStorage.Shared.Tags)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Rng = require(ReplicatedStorage.Shared.Util.Rng)
local BoardData = require(script.Parent.BoardData)
local Boards = require(script.Parent.Boards)
local Build = require(script.Parent.Build)
local Props = require(script.Parent.Props)

local Scenery = {}

local TAU = 2 * math.pi

Scenery.WALL_HEIGHT = 12 -- invisible walls: taller than anyone can jump
Scenery.SHORE_WALL = 0.5 -- the wall along the water's edge (z)
Scenery.PLAY_HALF_WIDTH = 300 -- players stay within this far of the middle...
Scenery.PLAY_BACK = -260 -- ...and in front of this (z)
Scenery.DECK_TOP = Land.PLAZA_HEIGHT + 0.5 -- the boardwalk's surface
Scenery.DECK_FRONT, Scenery.DECK_BACK = -44, -106
Scenery.DECK_HALF_WIDTH = 172
Scenery.SPAWN = Vector3.new(0, Scenery.DECK_TOP, -82)
Scenery.SHOP_SPOTS = {
	Rocks = Vector3.new(-96, Scenery.DECK_TOP, -72),
	Upgrades = Vector3.new(96, Scenery.DECK_TOP, -72),
	Rebirth = Vector3.new(0, Scenery.DECK_TOP, -98),
}
Scenery.BOARD_XS = { 118, 133, 148 }
Scenery.BOARD_Z = -100
Scenery.LIGHTHOUSE = Vector2.new(372, 70)
Scenery.MARKERS = { 100, 250, 500, 1000, 2500, 5000, 10000, 25000, 50000, 100000 }
Scenery.MARKER_HALF_WIDTH = 200
Scenery.FARTHEST_MODEL = 9000 -- islands further out than this (map studs) aren't built

export type Built = {
	root: Folder,
	spawn: SpawnLocation,
	boards: { [string]: SurfaceGui }, -- by BoardData key
}

local WOOD: Build.Options = { material = Enum.Material.Wood }
local PLANKS: Build.Options = { material = Enum.Material.WoodPlanks }

local function with(options: Build.Options, extra: Build.Options): Build.Options
	local merged: Build.Options = table.clone(options)
	for key, value in extra :: any do
		(merged :: any)[key] = value
	end
	return merged
end

local function ground(x: number, z: number, lift: number?): Vector3
	return Land.at(x, z, lift)
end

local function seaward(position: Vector3): CFrame
	return CFrame.lookAt(position, position + Sea.FORWARD)
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = Color3.new(1, 1, 1)
	for key, value in props do
		(label :: any)[key] = value
	end
	label.Parent = parent
	return label
end

local function surface(part: BasePart, face: Enum.NormalId): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.LightInfluence = 0.4
	gui.PixelsPerStud = 30
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.Parent = part
	return gui
end

-- ===== Invisible walls =====

local FENCE: Build.Options = { name = "Fence", transparency = 1, shadow = false }

local function wall(size: Vector3, cframe: CFrame, parent: Instance)
	local part = Build.block(size, cframe, Palette.white, parent, FENCE)
	part.CanQuery = false
	part.CanTouch = false
end

local function buildFences(root: Instance)
	local fences = Build.model("Fences", root)
	local h = Scenery.WALL_HEIGHT
	local y = h / 2 - 1
	local half = Scenery.PLAY_HALF_WIDTH
	-- along the water's edge, with a gap onto each pier
	local gaps = {}
	for _, x in Sea.PIER_XS do
		table.insert(gaps, { x - Sea.PIER_WIDTH / 2, x + Sea.PIER_WIDTH / 2 })
	end
	local from = -half
	for _, gap in gaps do
		wall(
			Vector3.new(gap[1] - from, h, 0.5),
			CFrame.new((from + gap[1]) / 2, y, Scenery.SHORE_WALL),
			fences
		)
		from = gap[2]
	end
	wall(
		Vector3.new(half - from, h, 0.5),
		CFrame.new((from + half) / 2, y, Scenery.SHORE_WALL),
		fences
	)
	-- each pier: both sides out from the shore, and across the end
	for _, x in Sea.PIER_XS do
		local length = Sea.PIER_END - Scenery.SHORE_WALL
		for _, side in { -1, 1 } do
			wall(
				Vector3.new(0.5, h, length),
				CFrame.new(
					x + side * (Sea.PIER_WIDTH / 2 + 0.25),
					y + 1,
					Scenery.SHORE_WALL + length / 2
				),
				fences
			)
		end
		wall(
			Vector3.new(Sea.PIER_WIDTH + 1, h, 0.5),
			CFrame.new(x, y + 1, Sea.PIER_END + 0.25),
			fences
		)
	end
	-- the sides and back of the play area (tall: the ground climbs there)
	local depth = Scenery.SHORE_WALL - Scenery.PLAY_BACK
	for _, side in { -1, 1 } do
		wall(
			Vector3.new(1, 160, depth),
			CFrame.new(side * half, 60, Scenery.PLAY_BACK + depth / 2),
			fences
		)
	end
	wall(Vector3.new(2 * half, 220, 1), CFrame.new(0, 90, Scenery.PLAY_BACK), fences)
end

-- ===== Lanterns and lamps =====

local function lantern(position: Vector3, parent: Instance, height: number?)
	local h = height or 6
	local m = Build.model("Lantern", parent)
	local dark = Palette.woodDark
	Build.block(
		Vector3.new(0.6, h + 1, 0.6),
		CFrame.new(position + Vector3.new(0, (h - 1) / 2, 0)),
		dark,
		m,
		with(WOOD, { name = "Post" })
	)
	Build.block(
		Vector3.new(1.7, 0.3, 0.5),
		CFrame.new(position + Vector3.new(0.55, h - 0.2, 0)),
		dark,
		m,
		with(WOOD, {
			decor = true,
		})
	)
	local glass = Build.block(
		Vector3.new(0.8, 1, 0.8),
		CFrame.new(position + Vector3.new(1.1, h - 0.95, 0)),
		Palette.lantern,
		m,
		{
			name = "Glow",
			material = Enum.Material.Neon,
			decor = true,
			collide = false,
			shadow = false,
		}
	)
	for _, y in { h - 0.38, h - 1.52 } do
		Build.block(
			Vector3.new(1.05, 0.18, 1.05),
			CFrame.new(position + Vector3.new(1.1, y, 0)),
			Palette.iron,
			m,
			{ decor = true, collide = false, material = Enum.Material.Metal }
		)
	end
	local light = Instance.new("PointLight")
	light.Color = Palette.lantern
	light.Range = 20
	light.Brightness = 1.6
	light.Shadows = true
	light.Enabled = false
	light.Parent = glass
	CollectionService:AddTag(light, Tags.NIGHT_LIGHT)
end

-- ===== Piers =====

local function buildPier(x: number, index: number, parent: Instance)
	local pier = Build.model("Pier" .. index, parent)
	local gen = Rng.new(60 + index)
	local length = Sea.PIER_END - Sea.PIER_START
	local deckY = Sea.PIER_TOP - 0.25
	local center = (Sea.PIER_START + Sea.PIER_END) / 2
	local planks = math.floor(length / 1.25)
	for i = 0, planks - 1 do
		local z = Sea.PIER_START + 0.62 + i * 1.25
		Build.block(
			Vector3.new(Sea.PIER_WIDTH, 0.5, 1.14),
			CFrame.new(x, deckY + (gen.next() - 0.5) * 0.04, z),
			if i % 3 == 0
				then Palette.woodLight
				elseif i % 3 == 1 then Palette.wood
				else Palette.weathered,
			pier,
			with(PLANKS, { name = "Plank", shadow = false })
		)
	end
	for _, side in { -1, 1 } do
		local edgeX = x + side * (Sea.PIER_WIDTH / 2 - 0.25)
		Build.block(
			Vector3.new(0.5, 0.7, length),
			CFrame.new(edgeX, deckY - 0.55, center),
			Palette.woodDark,
			pier,
			with(WOOD, {
				decor = true,
				shadow = false,
			})
		)
		-- posts down into the sea bed, and a low rail to lean on
		for z = Sea.PIER_START + 2, Sea.PIER_END, 6 do
			local floor = Land.height(edgeX, z)
			local top = Vector3.new(edgeX, Sea.PIER_TOP + 1.6, z)
			Build.rod(
				top,
				Vector3.new(edgeX, floor - 1.5, z),
				0.8,
				Palette.woodDark,
				pier,
				with(WOOD, { shadow = false })
			)
		end
		Build.block(
			Vector3.new(0.35, 0.3, length - 2),
			CFrame.new(edgeX, Sea.PIER_TOP + 1.45, center + 1),
			Palette.wood,
			pier,
			with(WOOD, { decor = true, shadow = false })
		)
	end
	-- a lantern at the end, and a ring painted where the best throws start
	lantern(Vector3.new(x + Sea.PIER_WIDTH / 2 - 0.5, Sea.PIER_TOP, Sea.PIER_END - 1), pier, 5.5)
	Build.disc(
		4.2,
		0.05,
		CFrame.new(x, Sea.PIER_TOP + 0.03, Sea.PIER_END - 5),
		Palette.canvas,
		pier,
		{
			name = "ThrowSpot",
			decor = true,
			collide = false,
			shadow = false,
		}
	)
	Build.disc(
		3.4,
		0.06,
		CFrame.new(x, Sea.PIER_TOP + 0.04, Sea.PIER_END - 5),
		Palette.wood,
		pier,
		{
			decor = true,
			collide = false,
			shadow = false,
			material = Enum.Material.WoodPlanks,
		}
	)
end

-- ===== The beach =====

local function umbrella(base: Vector3, color: Color3, parent: Instance, gen: Rng.Generator)
	local m = Build.model("Umbrella", parent)
	local tilt =
		CFrame.Angles((gen.next() - 0.5) * 0.25, gen.next() * TAU, (gen.next() - 0.5) * 0.25)
	local top = base + tilt.UpVector * 7
	Build.rod(
		base - Vector3.new(0, 0.5, 0),
		top,
		0.3,
		Palette.white,
		m,
		{ decor = true, material = Enum.Material.Metal }
	)
	-- a soft striped canopy: a dome with a band of colour and a white cap
	Build.ellipsoid(
		Vector3.new(8, 2.2, 8),
		CFrame.new(top - Vector3.new(0, 0.4, 0)) * tilt.Rotation,
		color,
		m,
		{
			decor = true,
			collide = false,
			material = Enum.Material.Fabric,
		}
	)
	Build.ellipsoid(
		Vector3.new(4.2, 1.5, 4.2),
		CFrame.new(top + tilt.UpVector * 0.25) * tilt.Rotation,
		Palette.white,
		m,
		{
			decor = true,
			collide = false,
			material = Enum.Material.Fabric,
		}
	)
	-- a towel beside it
	local towel = CFrame.new(base + Vector3.new(2.5, 0.05, 1.5))
		* CFrame.Angles(0, gen.next() * TAU, 0)
	Build.block(
		Vector3.new(2.4, 0.1, 4.6),
		towel,
		color,
		m,
		{ decor = true, collide = false, material = Enum.Material.Fabric }
	)
	Build.block(Vector3.new(2.4, 0.11, 0.6), towel * CFrame.new(0, 0, 1.2), Palette.white, m, {
		decor = true,
		collide = false,
		material = Enum.Material.Fabric,
	})
end

local function lifeguardTower(base: Vector3, parent: Instance)
	local m = Build.model("LifeguardTower", parent)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Build.rod(
				base + Vector3.new(sx * 2.4, -0.5, sz * 2.4),
				base + Vector3.new(sx * 2, 7, sz * 2),
				0.6,
				Palette.white,
				m,
				WOOD
			)
		end
	end
	local floor = CFrame.new(base + Vector3.new(0, 7, 0))
	Build.block(Vector3.new(5.6, 0.4, 5.6), floor, Palette.wood, m, PLANKS)
	Build.block(Vector3.new(5.2, 3.2, 4.4), floor * CFrame.new(0, 1.8, 0.4), Palette.buoyRed, m, {
		material = Enum.Material.WoodPlanks,
	})
	Build.block(
		Vector3.new(6.6, 0.5, 6.2),
		floor * CFrame.new(0, 3.65, 0.3),
		Palette.white,
		m,
		PLANKS
	)
	-- a ramp up the back
	Build.beam(
		base + Vector3.new(0, 0.2, -9),
		base + Vector3.new(0, 7, -2.8),
		2,
		0.4,
		Palette.wood,
		m,
		PLANKS
	)
end

local function buildBeach(root: Instance)
	local beach = Build.model("Beach", root)
	local gen = Rng.new(5)
	-- shells and pebbles
	local pebbles = { Palette.pebbleLight, Palette.pebble, Palette.pebbleDark, Palette.cream }
	for _ = 1, 220 do
		local x = (gen.next() - 0.5) * 2 * (Scenery.PLAY_HALF_WIDTH - 60)
		local z = Land.BEACH_BACK + 2 + gen.next() * (-2 - Land.BEACH_BACK - 2)
		local p = Vector3.new(x, 0, z)
		if not Sea.pierAt(p, 0.5) then
			local size = 0.3 + gen.next() * 0.7
			Build.ellipsoid(
				Vector3.new(size, size * 0.45, size * (0.7 + gen.next() * 0.4)),
				CFrame.new(ground(x, z, size * 0.1)) * CFrame.Angles(0, gen.next() * TAU, 0),
				pebbles[gen.int(1, #pebbles)],
				beach,
				{ decor = true, collide = false, shadow = false, material = Enum.Material.Slate }
			)
		end
	end
	-- umbrellas between the piers
	local colors = { Palette.awningBlue, Palette.awningRed, Palette.awningYellow }
	for i, x in { -150, -90, -30, 30, 90, 150 } do
		local z = -26 + gen.next() * 6
		umbrella(ground(x + (gen.next() - 0.5) * 10, z), colors[(i - 1) % #colors + 1], beach, gen)
	end
	lifeguardTower(ground(-185, -18), beach)
	-- palms along the back of the beach
	for i = 0, 15 do
		local x = -200 + i * 26.6 + (gen.next() - 0.5) * 8
		if math.abs(x) > 14 then -- keep the walkway to the arch clear
			Props.palm(
				ground(x, Land.BEACH_BACK + 1 + gen.next() * 3, -0.3),
				0.85 + gen.next() * 0.35,
				gen,
				beach
			)
		end
	end
	-- fireflies over the sand at night
	for i = 0, 9 do
		local anchor = Build.block(
			Vector3.new(16, 4, 10),
			CFrame.new(ground(-180 + i * 40, -18, 3)),
			Palette.white,
			beach,
			{ name = "Fireflies", transparency = 1, collide = false, decor = true, shadow = false }
		)
		local flies = Instance.new("ParticleEmitter")
		flies.Name = "Fireflies"
		flies.Color = ColorSequence.new(Color3.fromRGB(255, 236, 140))
		flies.LightEmission = 1
		flies.Rate = 3
		flies.Lifetime = NumberRange.new(3, 6)
		flies.Speed = NumberRange.new(0.3, 1)
		flies.SpreadAngle = Vector2.new(180, 180)
		flies.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.2, 0.25),
			NumberSequenceKeypoint.new(0.8, 0.25),
			NumberSequenceKeypoint.new(1, 0),
		})
		flies.Enabled = false
		flies.Parent = anchor
		CollectionService:AddTag(flies, Tags.FIREFLIES)
	end
end

-- ===== The boardwalk =====

local function stall(
	name: string,
	title: string,
	color: Color3,
	spot: Vector3,
	menu: string,
	parent: Instance
)
	local m = Build.model(name, parent)
	local f = seaward(spot)
	local w, d = 16, 8
	-- counter, back wall and posts
	Build.block(
		Vector3.new(w, 3, 2),
		f * CFrame.new(0, 1.5, -d / 2 + 1),
		Palette.wood,
		m,
		with(PLANKS, { name = "Counter" })
	)
	Build.block(
		Vector3.new(w, 0.4, 2.4),
		f * CFrame.new(0, 3.2, -d / 2 + 1),
		Palette.woodLight,
		m,
		PLANKS
	)
	Build.block(Vector3.new(w, 9, 0.8), f * CFrame.new(0, 4.5, d / 2), Palette.canvas, m, PLANKS)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Build.block(
				Vector3.new(0.7, 9, 0.7),
				f * CFrame.new(sx * (w / 2 - 0.35), 4.5, sz * (d / 2 - 0.35)),
				Palette.woodDark,
				m,
				WOOD
			)
		end
	end
	-- a striped awning, sloping down toward the front
	local stripes = 8
	for i = 0, stripes - 1 do
		Build.block(
			Vector3.new(w / stripes, 0.3, d + 3),
			f
				* CFrame.new(-w / 2 + (i + 0.5) * w / stripes, 9.4, -1)
				* CFrame.Angles(math.rad(14), 0, 0),
			if i % 2 == 0 then color else Palette.white,
			m,
			{ decor = true, material = Enum.Material.Fabric }
		)
	end
	-- the sign on top
	local sign =
		Build.block(Vector3.new(w - 2, 2.6, 0.5), f * CFrame.new(0, 11.6, -d / 2 + 0.6), color, m, {
			name = "Sign",
			material = Enum.Material.WoodPlanks,
		})
	local gui = surface(sign, Enum.NormalId.Front)
	text(gui, {
		Text = title,
		Size = UDim2.fromScale(0.92, 0.8),
		Position = UDim2.fromScale(0.04, 0.1),
		TextStrokeTransparency = 0.4,
	})
	-- walk up to the counter to open the menu (the client listens for this)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Open"
	prompt.ObjectText = title
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("Menu", menu)
	prompt.Parent = sign
	return m
end

local function shrine(spot: Vector3, parent: Instance)
	local m = Build.model("RebirthShrine", parent)
	for i = 0, 7 do
		local a = i * (TAU / 8)
		Build.block(
			Vector3.new(1.4, 6 + (i % 2) * 2, 1.4),
			CFrame.new(spot + Vector3.new(math.sin(a) * 8, 3 + (i % 2), math.cos(a) * 8))
				* CFrame.Angles(0, a, 0),
			Palette.rockLight,
			m,
			{ material = Enum.Material.Marble }
		)
	end
	Build.disc(
		9,
		1,
		CFrame.new(spot + Vector3.new(0, 0.5, 0)),
		Palette.rockLight,
		m,
		{ material = Enum.Material.Marble }
	)
	Build.disc(
		5,
		1.2,
		CFrame.new(spot + Vector3.new(0, 1.1, 0)),
		Palette.rock,
		m,
		{ material = Enum.Material.Marble }
	)
	local crystal = Build.ellipsoid(
		Vector3.new(2.6, 5.5, 2.6),
		CFrame.new(spot + Vector3.new(0, 5.2, 0)),
		Palette.crystal,
		m,
		{ name = "Crystal", material = Enum.Material.Neon, collide = false, shadow = false }
	)
	local glow = Instance.new("PointLight")
	glow.Color = Palette.crystal
	glow.Range = 16
	glow.Brightness = 1.5
	glow.Parent = crystal
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Color = ColorSequence.new(Palette.crystal, Color3.new(1, 1, 1))
	sparkle.LightEmission = 1
	sparkle.Rate = 6
	sparkle.Lifetime = NumberRange.new(1, 2)
	sparkle.Speed = NumberRange.new(1, 2)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.Size =
		NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
	sparkle.Parent = crystal
	local board = Build.block(
		Vector3.new(10, 2.2, 0.4),
		CFrame.lookAt(spot + Vector3.new(0, 9.6, 0), spot + Vector3.new(0, 9.6, 0) + Sea.FORWARD),
		Palette.woodDark,
		m,
		{
			name = "Sign",
			decor = true,
			material = Enum.Material.WoodPlanks,
		}
	)
	text(surface(board, Enum.NormalId.Front), {
		Text = "🔁 Rebirth",
		Size = UDim2.fromScale(0.92, 0.8),
		Position = UDim2.fromScale(0.04, 0.1),
	})
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Rebirth"
	prompt.ObjectText = "Rebirth Shrine"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("Menu", "Rebirth")
	prompt.Parent = crystal
end

local function arch(parent: Instance)
	local m = Build.model("WelcomeArch", parent)
	local z = Scenery.DECK_FRONT + 1
	for _, side in { -1, 1 } do
		Build.block(
			Vector3.new(2, 16, 2),
			CFrame.new(side * 11, Scenery.DECK_TOP + 8, z),
			Palette.woodDark,
			m,
			WOOD
		)
	end
	local board = Build.block(
		Vector3.new(26, 5, 1),
		CFrame.new(0, Scenery.DECK_TOP + 15, z),
		Palette.awningBlue,
		m,
		{
			name = "Sign",
			material = Enum.Material.WoodPlanks,
		}
	)
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		text(surface(board, face), {
			Text = "🪨 SKIP A ROCK 🌊",
			Size = UDim2.fromScale(0.94, 0.8),
			Position = UDim2.fromScale(0.03, 0.1),
			TextStrokeTransparency = 0.3,
		})
	end
end

local function buildBoardwalk(root: Instance): { [string]: SurfaceGui }
	local walk = Build.model("Boardwalk", root)
	local gen = Rng.new(9)
	-- the deck: long boards running across, on a stone edge
	local depth = Scenery.DECK_FRONT - Scenery.DECK_BACK
	local boards = math.floor(depth / 2)
	for i = 0, boards - 1 do
		local z = Scenery.DECK_BACK + 1 + i * 2
		Build.block(
			Vector3.new(2 * Scenery.DECK_HALF_WIDTH, 0.6, 1.9),
			CFrame.new(0, Scenery.DECK_TOP - 0.3, z),
			if i % 4 == 0
				then Palette.woodLight
				elseif i % 4 == 2 then Palette.weathered
				else Palette.wood,
			walk,
			with(PLANKS, { name = "Board", shadow = false })
		)
	end
	-- steps down from the front edge onto the sand
	Build.block(
		Vector3.new(2 * Scenery.DECK_HALF_WIDTH, 0.6, 2),
		CFrame.new(0, Scenery.DECK_TOP - 0.7, Scenery.DECK_FRONT + 1),
		Palette.woodDark,
		walk,
		with(PLANKS, { name = "Step" })
	)
	-- lamps along the front and back
	for x = -160, 160, 40 do
		lantern(Vector3.new(x + 2, Scenery.DECK_TOP, Scenery.DECK_FRONT + 3), walk, 6)
		lantern(Vector3.new(x - 2, Scenery.DECK_TOP, Scenery.DECK_BACK + 2), walk, 6)
	end
	-- benches facing the sea
	for _, x in { -150, -40, 40, 150 } do
		local f = seaward(Vector3.new(x, Scenery.DECK_TOP, Scenery.DECK_FRONT + 7))
		Build.block(Vector3.new(6, 0.4, 1.6), f * CFrame.new(0, 1.2, 0), Palette.wood, walk, PLANKS)
		Build.block(Vector3.new(6, 1.6, 0.3), f * CFrame.new(0, 2, 0.8), Palette.wood, walk, PLANKS)
		for _, sx in { -2.6, 2.6 } do
			Build.block(
				Vector3.new(0.3, 1.2, 1.4),
				f * CFrame.new(sx, 0.6, 0),
				Palette.iron,
				walk,
				{
					material = Enum.Material.Metal,
				}
			)
		end
	end
	-- flower boxes
	for _, x in { -60, -20, 20, 60 } do
		local box = CFrame.new(x, Scenery.DECK_TOP + 0.6, Scenery.DECK_BACK + 6)
		Build.block(Vector3.new(6, 1.2, 2), box, Palette.woodDark, walk, PLANKS)
		Props.flowers(box.Position + Vector3.new(0, 0.6, 0), 0.8, gen, walk)
	end
	stall("RockShop", "🪨 Rock Shop", Palette.awningBlue, Scenery.SHOP_SPOTS.Rocks, "Rocks", walk)
	stall(
		"StrengthGym",
		"💪 Strength Gym",
		Palette.awningRed,
		Scenery.SHOP_SPOTS.Upgrades,
		"Upgrades",
		walk
	)
	shrine(Scenery.SHOP_SPOTS.Rebirth, walk)
	arch(walk)
	local guis: { [string]: SurfaceGui } = {}
	local boardsModel = Build.model("Leaderboards", walk)
	for i, board in BoardData.BOARDS do
		local base = Vector3.new(Scenery.BOARD_XS[i], Scenery.DECK_TOP, Scenery.BOARD_Z)
		guis[board.key] =
			Boards.build(board.key, board.title, board.color, seaward(base), boardsModel)
	end
	return guis
end

-- ===== Lighthouse =====

local function buildLighthouse(root: Instance)
	local m = Build.model("Lighthouse", root)
	local base = ground(Scenery.LIGHTHOUSE.X, Scenery.LIGHTHOUSE.Y, -1)
	local rings = 6
	local h = 0
	for i = 1, rings do
		local width = 9 - i * 0.7
		Build.disc(
			width,
			5,
			CFrame.new(base + Vector3.new(0, h + 2.5, 0)),
			if i % 2 == 0 then Palette.buoyRed else Palette.buoyWhite,
			m,
			{
				material = Enum.Material.Concrete,
			}
		)
		h += 5
	end
	Build.disc(
		7,
		0.6,
		CFrame.new(base + Vector3.new(0, h + 0.3, 0)),
		Palette.iron,
		m,
		{ material = Enum.Material.Metal }
	)
	local lamp =
		Build.disc(3.4, 3, CFrame.new(base + Vector3.new(0, h + 2, 0)), Palette.lantern, m, {
			name = "Lamp",
			material = Enum.Material.Neon,
			collide = false,
		})
	Build.ellipsoid(
		Vector3.new(4.4, 2.6, 4.4),
		CFrame.new(base + Vector3.new(0, h + 4, 0)),
		Palette.buoyRed,
		m,
		{
			material = Enum.Material.Metal,
		}
	)
	local light = Instance.new("PointLight")
	light.Color = Palette.lantern
	light.Range = 40
	light.Brightness = 2
	light.Enabled = false
	light.Parent = lamp
	CollectionService:AddTag(light, Tags.NIGHT_LIGHT)
end

-- ===== Forest on the hills =====

local function buildHills(root: Instance)
	local forest = Build.model("Forest", root)
	local gen = Rng.new(17)
	local placed = 0
	local tries = 0
	while placed < 260 and tries < 6000 do
		tries += 1
		local x = (gen.next() - 0.5) * 2 * (Land.EAST - 40)
		local z = Land.SOUTH + 40 + gen.next() * (Scenery.DECK_BACK - 14 - Land.SOUTH - 40)
		-- also some on the headlands, toward the sea
		if gen.next() < 0.25 then
			z = Scenery.DECK_BACK - 10 + gen.next() * 260
			x = (if gen.next() < 0.5 then -1 else 1) * (Land.BAY_HALF + 60 + gen.next() * 300)
		end
		local h = Land.height(x, z)
		if h > 3 and Land.slope(x, z) < 0.6 and math.abs(x) > 6 then
			if gen.next() < 0.8 then
				Props.pine(ground(x, z, -0.3), 1.3 + gen.next() * 1, gen, forest)
			else
				Props.tree(ground(x, z, -0.3), 1 + gen.next() * 0.5, gen, forest)
			end
			placed += 1
		end
	end
	for _ = 1, 40 do
		local x = (gen.next() - 0.5) * 2 * 600
		local z = -40 + gen.next() * 260
		if math.abs(x) > Land.BAY_HALF then
			Props.rock(ground(x, z, -0.5), 2 + gen.next() * 2.5, gen, forest)
		end
	end
end

-- ===== Out at sea: distance buoys and islands =====

local function buoy(position: Vector3, color: Color3, parent: Instance, tall: number?)
	local m = Build.model("Buoy", parent)
	Build.ellipsoid(
		Vector3.new(2.2, 2.2, 2.2),
		CFrame.new(position + Vector3.new(0, 0.4, 0)),
		color,
		m,
		{
			decor = true,
			material = Enum.Material.Plastic,
		}
	)
	Build.rod(
		position + Vector3.new(0, 1, 0),
		position + Vector3.new(0, 1 + (tall or 2.5), 0),
		0.25,
		Palette.iron,
		m,
		{
			decor = true,
			material = Enum.Material.Metal,
		}
	)
	return m
end

local function buildMarkers(root: Instance)
	local sea = Build.model("DistanceMarkers", root)
	local entryZ = Sea.FIRST_WATER
	for i, distance in Scenery.MARKERS do
		local z = entryZ + Sea.toWorld(distance)
		local line = Build.model(Format.short(distance), sea)
		for x = -Scenery.MARKER_HALF_WIDTH, Scenery.MARKER_HALF_WIDTH, 40 do
			buoy(
				Vector3.new(x, 0, z),
				if (x // 40) % 2 == 0 then Palette.buoyRed else Palette.buoyWhite,
				line
			)
		end
		-- a floating sign with the distance, readable from the shore
		Build.block(Vector3.new(10, 1, 4), CFrame.new(0, 0.4, z), Palette.buoyWhite, line, {
			decor = true,
			material = Enum.Material.Plastic,
		})
		local board =
			Build.block(Vector3.new(12, 5, 0.5), CFrame.new(0, 4.5, z), Palette.awningBlue, line, {
				name = "Sign",
				decor = true,
				material = Enum.Material.WoodPlanks,
			})
		local gui = surface(board, Enum.NormalId.Back) -- faces the shore (-Z)
		text(gui, {
			Text = Format.short(distance),
			Size = UDim2.fromScale(0.9, 0.8),
			Position = UDim2.fromScale(0.05, 0.1),
			TextStrokeTransparency = 0.3,
		})
		-- far-off signs stay readable as a floating label
		if i >= 4 then
			local tag = Instance.new("BillboardGui")
			tag.Size = UDim2.fromOffset(110, 40)
			tag.StudsOffset = Vector3.new(0, 6, 0)
			tag.MaxDistance = 6000
			tag.LightInfluence = 0
			tag.Parent = board
			text(tag, {
				Text = Format.short(distance),
				Size = UDim2.fromScale(1, 1),
				TextStrokeTransparency = 0.2,
			})
		end
	end
end

local function island(def: IslandData.Island, parent: Instance, gen: Rng.Generator)
	local z = Sea.FIRST_WATER + Sea.toWorld(def.distance)
	if z > Scenery.FARTHEST_MODEL or not def.model then
		return
	end
	local m = Build.model(def.id, parent)
	-- off to one side of the throwing lanes, so rocks fly past
	local side = if gen.next() < 0.5 then -1 else 1
	local center = Vector3.new(side * (Scenery.MARKER_HALF_WIDTH + 90 + gen.next() * 80), 0, z)
	local kind = def.model
	if kind == "buoys" then
		for i = 0, 6 do
			local a = i * (TAU / 7)
			buoy(
				center + Vector3.new(math.sin(a) * 12, 0, math.cos(a) * 12),
				if i % 2 == 0 then Palette.awningYellow else Palette.buoyRed,
				m,
				4
			)
		end
		Build.block(
			Vector3.new(12, 1, 12),
			CFrame.new(center + Vector3.new(0, 0.3, 0)),
			Palette.wood,
			m,
			PLANKS
		)
	elseif kind == "rock" then
		for i = 0, 4 do
			local offset = Vector3.new((gen.next() - 0.5) * 30, 0, (gen.next() - 0.5) * 20)
			Build.ellipsoid(
				Vector3.new(18, 30 + gen.next() * 25, 16) * (1 - i * 0.12),
				CFrame.new(center + offset) * CFrame.Angles(0, gen.next() * TAU, 0),
				if i % 2 == 0 then Palette.rock else Palette.rockDark,
				m,
				{ decor = true, material = Enum.Material.Rock }
			)
		end
	else
		-- a sandy island with palms (bigger and further each time)
		local size = if kind == "palm" then 70 elseif kind == "atoll" then 140 else 110
		Build.ellipsoid(Vector3.new(size, 10, size * 0.7), CFrame.new(center), Palette.sand, m, {
			decor = true,
			material = Enum.Material.Sand,
		})
		Build.ellipsoid(
			Vector3.new(size * 0.6, 14, size * 0.4),
			CFrame.new(center + Vector3.new(0, 2, 0)),
			Palette.grass,
			m,
			{
				decor = true,
				material = Enum.Material.Grass,
			}
		)
		for _ = 1, 6 do
			local p = center
				+ Vector3.new(
					(gen.next() - 0.5) * size * 0.45,
					7.5,
					(gen.next() - 0.5) * size * 0.3
				)
			Props.palm(p, 1.6 + gen.next() * 0.6, gen, m)
		end
	end
	-- the island's name, floating above it
	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.fromOffset(180, 46)
	tag.StudsOffset = Vector3.new(0, 30, 0)
	tag.MaxDistance = 10000
	tag.LightInfluence = 0
	local anchor = Build.block(Vector3.new(1, 1, 1), CFrame.new(center), Palette.white, m, {
		name = "NameAnchor",
		transparency = 1,
		collide = false,
		decor = true,
		shadow = false,
	})
	tag.Parent = anchor
	text(tag, {
		Text = `🏝️ {def.name}`,
		Size = UDim2.fromScale(1, 1),
		TextStrokeTransparency = 0.2,
	})
end

local function buildIslands(root: Instance)
	local islands = Build.model("Islands", root)
	local gen = Rng.new(23)
	for _, def in IslandData.LIST do
		island(def, islands, gen)
	end
end

-- ===== Everything =====

function Scenery.build(parent: Instance): Built
	local root = Instance.new("Folder")
	root.Name = "SkipARock"
	buildFences(root)
	local piers = Build.model("Piers", root)
	for i, x in Sea.PIER_XS do
		buildPier(x, i, piers)
	end
	buildBeach(root)
	local boards = buildBoardwalk(root)
	buildLighthouse(root)
	buildHills(root)
	buildMarkers(root)
	buildIslands(root)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(6, 1, 6)
	spawn.CFrame = seaward(Scenery.SPAWN - Vector3.new(0, 0.5, 0))
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = root

	root.Parent = parent
	return { root = root, spawn = spawn, boards = boards }
end

return Scenery
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="40">
        <Properties>
          <string name="Name">Systems</string>
        </Properties>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Cheats</string>
            <string name="Source"><![CDATA[--!strict
-- The test panel (Studio, the game's owner and Config.DEV_USER_IDS only):
-- coins, strength, every rock and island, night or day, fresh treasure,
-- start over.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require(ReplicatedStorage.Shared.Economy)
local IslandData = require(ReplicatedStorage.Shared.Data.IslandData)
local Net = require(ReplicatedStorage.Shared.Net)
local RockData = require(ReplicatedStorage.Shared.Data.RockData)
local Access = require(script.Parent.Parent.Lib.Access)
local Notify = require(script.Parent.Parent.Lib.Notify)
local Data = require(script.Parent.Data)
local DayNight = require(script.Parent.DayNight)
local Progress = require(script.Parent.Progress)
local Sessions = require(script.Parent.Sessions)
local Shop = require(script.Parent.Shop)
local State = require(script.Parent.State)
local Treasure = require(script.Parent.Treasure)

local Cheats = {}

local ACTIONS: { [string]: (Player) -> () } = {
	coins = function(player)
		local profile = Data.get(player)
		if profile then
			-- enough for the next rebirth, or a big handful early on
			local amount = math.max(Economy.rebirthCost(profile.rebirths), 100000)
			profile.coins += amount
			profile.totalCoins += amount
			Progress.check(player)
			Notify.send(player, "💰 Coins added", "good")
		end
	end,
	strength = function(player)
		local profile = Data.get(player)
		if profile then
			profile.strength = math.min(profile.strength + 10, Economy.MAX_STRENGTH)
			Notify.send(player, "💪 +10 strength", "good")
		end
	end,
	everything = function(player)
		local profile = Data.get(player)
		if not profile then
			return
		end
		for _, rock in RockData.LIST do
			profile.rocks[rock.id] = true
		end
		for _, island in IslandData.LIST do
			profile.islands[island.id] = true
		end
		Progress.check(player)
		Notify.send(player, "Every rock and island unlocked", "good")
	end,
	night = function(player)
		DayNight.setClock(22)
		Notify.send(player, "Night falls over the sea", "info")
	end,
	day = function(player)
		DayNight.setClock(10)
		Notify.send(player, "Good morning, sea", "info")
	end,
	treasure = function(player)
		Treasure.refresh()
		Notify.send(player, "Fresh treasure washed up", "info")
	end,
	reset = function(player)
		if Data.reset(player) then
			Shop.updateHeld(player)
			Progress.refresh(player)
			Notify.send(player, "Back to a single Pebble", "info")
		end
	end,
}

function Cheats.run(player: Player, action: unknown): boolean
	if type(action) ~= "string" or not Access.isDev(player) or not Sessions.getReady(player) then
		return false
	end
	local run = ACTIONS[action]
	if not run then
		return false
	end
	run(player)
	State.markDirty(player)
	return true
end

function Cheats.init()
	Net.on("Dev", 2, 4, function(player: Player, action: unknown)
		Cheats.run(player, action)
	end)
end

return Cheats
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Data</string>
            <string name="Source"><![CDATA[--!strict
-- Player profiles: load, autosave, release. Follows docs/roblox-datastores:
--   * UpdateAsync only (never Get+Set), with retry + backoff
--   * session locking so two servers can never both own a profile (no dupes)
--   * save on autosave, on leave, and on server shutdown (BindToClose)
--   * a failed load kicks the player instead of handing them an empty profile
--
-- In Studio without "Enable Studio Access to API Services", DataStores are not
-- available; profiles then live in memory only and a warning is printed.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Config = require(ReplicatedStorage.Shared.Config)
local RockData = require(ReplicatedStorage.Shared.Data.RockData)
local Types = require(ReplicatedStorage.Shared.Types)

type Profile = Types.Profile

local Data = {}

local STORE_NAME = Config.DATASTORE_NAME
local CURRENT_VERSION = 1

type Lock = { jobId: string, time: number }
type Stored = { profile: Profile, lock: Lock? }

local store: DataStore? = nil
local mock = false

local profiles: { [Player]: Profile } = {}
-- UserIds whose final save is still being written. A rejoin to this same
-- server waits for it, so it can't load (and later save over) older data.
local releasing: { [number]: boolean } = {}
local saving: { [Player]: boolean } = {}
local nextAutosave: { [Player]: number } = {}

local function defaultProfile(now: number): Profile
	return {
		version = CURRENT_VERSION,
		coins = 0,
		totalCoins = 0,
		strength = 0,
		rocks = { [RockData.STARTER] = true },
		equipped = RockData.STARTER,
		rebirths = 0,
		islands = {},
		bestDistance = 0,
		bestSkips = 0,
		throws = 0,
		totalSkips = 0,
		perfects = 0,
		goals = {},
		firstJoin = now,
		lastSeen = now,
	}
end

-- Numbers that must be finite and never negative (a corrupt save can't
-- leave anyone with NaN coins).
local COUNTERS = {
	"coins",
	"totalCoins",
	"strength",
	"rebirths",
	"bestDistance",
	"bestSkips",
	"throws",
	"totalSkips",
	"perfects",
}

local function deepCopy<T>(value: T): T
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value :: any do
		copy[k] = deepCopy(v)
	end
	return copy :: any
end

local function isArray(t: { [any]: any }): boolean
	return #t > 0 or next(t) == nil
end

-- Fill in any fields added to the default profile since this one was saved.
local function reconcile(target: { [any]: any }, template: { [any]: any })
	for key, value in template do
		if target[key] == nil then
			target[key] = deepCopy(value)
		elseif type(value) == "table" and type(target[key]) == "table" and not isArray(value) then
			reconcile(target[key], value)
		end
	end
end

-- Version migrations: MIGRATIONS[n] upgrades a version-n profile to n+1.
local MIGRATIONS: { [number]: (any) -> any } = {}

local function migrate(profile: any): Profile
	local version = if type(profile.version) == "number" then profile.version else 1
	while version < CURRENT_VERSION do
		local step = MIGRATIONS[version]
		if not step then
			error(`missing migration from v{version}`)
		end
		profile = step(profile)
		version += 1
		profile.version = version
	end
	reconcile(profile, defaultProfile(Clock.now()))
	for _, key in COUNTERS do
		local value = profile[key]
		if type(value) ~= "number" or value ~= value or value < 0 or value == math.huge then
			profile[key] = 0
		end
	end
	-- Everyone keeps their Pebble, and can only hold a rock they own.
	profile.rocks[RockData.STARTER] = true
	local equipped = profile.equipped
	if
		type(equipped) ~= "string"
		or RockData.get(equipped) == nil
		or profile.rocks[equipped] ~= true
	then
		profile.equipped = RockData.STARTER
	end
	return profile
end

local function keyFor(player: Player): string
	return `u_{player.UserId}`
end

local function withRetry(attempts: number, fn: () -> ()): (boolean, string?)
	local delaySeconds = 1
	local lastError: string? = nil
	for attempt = 1, attempts do
		local result = table.pack(pcall(fn))
		if result[1] then
			return true, nil
		end
		local err = result[2]
		lastError = tostring(err)
		warn(`[Data] attempt {attempt}/{attempts} failed: {err}`)
		if attempt < attempts then
			task.wait(delaySeconds)
			delaySeconds = math.min(delaySeconds * 2, 16)
		end
	end
	return false, lastError
end

function Data.isMock(): boolean
	return mock
end

-- Loads and session-locks a profile. Yields. Returns nil if it can't be loaded
-- safely (the caller kicks the player).
function Data.load(player: Player): Profile?
	if mock then
		local profile = defaultProfile(Clock.now())
		profiles[player] = profile
		nextAutosave[player] = os.clock() + Config.AUTOSAVE_INTERVAL
		return profile
	end
	local ds = store :: DataStore
	local key = keyFor(player)

	local waitedUntil = os.clock() + 60
	while releasing[player.UserId] and os.clock() < waitedUntil do
		task.wait(0.5)
	end

	for _ = 1, 5 do
		local loaded: Profile? = nil
		local lockedElsewhere = false
		local ok = withRetry(3, function()
			ds:UpdateAsync(key, function(stored: any): any
				loaded = nil
				lockedElsewhere = false
				local now = Clock.now()
				if type(stored) == "table" and type(stored.lock) == "table" then
					local lock = stored.lock :: Lock
					if
						lock.jobId ~= game.JobId
						and now - lock.time < Config.SESSION_LOCK_STALE_SECONDS
					then
						lockedElsewhere = true
						return nil -- abort: another server still owns this profile
					end
				end
				local profile: Profile
				if type(stored) == "table" and type(stored.profile) == "table" then
					profile = migrate(stored.profile)
				else
					profile = defaultProfile(now)
				end
				loaded = profile
				local result: Stored =
					{ profile = profile, lock = { jobId = game.JobId, time = now } }
				return result
			end)
		end)
		if not ok then
			return nil
		end
		if loaded then
			profiles[player] = loaded
			nextAutosave[player] = os.clock() + Config.AUTOSAVE_INTERVAL
			return loaded
		end
		if lockedElsewhere then
			-- The other server is probably mid-save after the player hopped servers.
			task.wait(4)
		end
		if player.Parent == nil then
			return nil
		end
	end
	return nil
end

function Data.get(player: Player): Profile?
	return profiles[player]
end

local function save(player: Player, release: boolean): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	if mock then
		return true
	end
	-- One write per key at a time.
	while saving[player] do
		task.wait(0.2)
	end
	saving[player] = true
	profile.lastSeen = Clock.now()
	local ds = store :: DataStore
	local lostLock = false
	local ok = withRetry(if release then 5 else 3, function()
		ds:UpdateAsync(keyFor(player), function(stored: any): any
			lostLock = false
			local now = Clock.now()
			if type(stored) == "table" and type(stored.lock) == "table" then
				local lock = stored.lock :: Lock
				if
					lock.jobId ~= game.JobId
					and now - lock.time < Config.SESSION_LOCK_STALE_SECONDS
				then
					lostLock = true
					return nil
				end
			end
			local result: Stored = {
				profile = profile,
				lock = if release then nil else { jobId = game.JobId, time = now },
			}
			return result
		end)
	end)
	saving[player] = nil
	if lostLock then
		warn(`[Data] {player.Name}'s profile is locked by another server; not saving`)
		return false
	end
	return ok
end

-- Final save + release the session lock, then forget the profile.
function Data.release(player: Player)
	if not profiles[player] then
		return
	end
	local userId = player.UserId
	releasing[userId] = true
	save(player, true)
	releasing[userId] = nil
	profiles[player] = nil
	nextAutosave[player] = nil
end

-- Testing: replace a profile with a brand-new one.
function Data.reset(player: Player): Profile?
	if not profiles[player] then
		return nil
	end
	local fresh = defaultProfile(Clock.now())
	profiles[player] = fresh
	return fresh
end

function Data.init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	end
	if RunService:IsStudio() then
		local usable = ok
			and pcall(function()
				(result :: DataStore):GetAsync("studio_probe")
			end)
		if not usable then
			mock = true
			warn(
				"[Data] DataStores aren't available in this Studio session, so progress won't save.\n"
					.. "To test saving: publish the game, then Game Settings > Security > "
					.. "Enable Studio Access to API Services."
			)
		end
	elseif not ok then
		error("[Data] could not open DataStore: " .. tostring(result))
	end
end

function Data.start()
	-- Autosave, staggered per player.
	task.spawn(function()
		while true do
			task.wait(5)
			local now = os.clock()
			for player, due in nextAutosave do
				if now >= due and player.Parent ~= nil then
					nextAutosave[player] = now + Config.AUTOSAVE_INTERVAL
					task.spawn(save, player, false)
				end
			end
		end
	end)

	game:BindToClose(function()
		if mock then
			return
		end
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				save(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		-- Lifecycle calls Data.release after other systems clean up; this is the
		-- safety net in case a player leaves before Lifecycle finished loading them.
		task.delay(10, function()
			if profiles[player] and player.Parent == nil then
				Data.release(player)
			end
		end)
	end)
end

return Data
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">DayNight</string>
            <string name="Source"><![CDATA[--!strict
-- Turns the sun over the sea. The server sets Lighting.ClockTime from the shared server
-- clock (so every player sees the same sky) and softens the light at night:
-- a cool blue ambient, a dimmer sun and denser haze. Lanterns, windows and
-- fireflies are switched on by each client (see the Ambience controller).

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Clock = require(ReplicatedStorage.Shared.Util.Clock)
local Config = require(ReplicatedStorage.Shared.Config)
local DayCycle = require(ReplicatedStorage.Shared.DayCycle)

local DayNight = {}

DayNight.STEP = 0.25 -- seconds between updates

type Look = {
	brightness: number,
	ambient: Color3,
	outdoor: Color3,
	shiftTop: Color3,
	haze: number,
	atmosphere: Color3,
}

-- (keep DAY in step with Lighting in default.project.json)
local DAY: Look = {
	brightness = 2.8,
	ambient = Color3.new(0.4, 0.42, 0.48),
	outdoor = Color3.new(0.55, 0.57, 0.62),
	shiftTop = Color3.new(1, 0.94, 0.84),
	haze = 2.2,
	atmosphere = Color3.new(0.78, 0.86, 0.95),
}

local NIGHT: Look = {
	brightness = 1.1,
	ambient = Color3.new(0.16, 0.18, 0.3),
	outdoor = Color3.new(0.26, 0.3, 0.48),
	shiftTop = Color3.new(0.55, 0.65, 1),
	haze = 2.2,
	atmosphere = Color3.new(0.3, 0.34, 0.52),
}

local offset = 0 -- seconds added to the server clock (testing)

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- The clock right now (0..24).
function DayNight.clockTime(): number
	return DayCycle.clockTime(Clock.now() + offset)
end

function DayNight.isNight(): boolean
	return DayCycle.isNightAt(DayNight.clockTime())
end

-- Testing: jump the clock to `clock` hours. Everyone sees the jump.
function DayNight.setClock(clock: number)
	local now = Clock.now()
	local wanted = DayCycle.phaseFor(clock) * Config.DAY_LENGTH
	offset = wanted - (now % Config.DAY_LENGTH)
	DayNight.apply()
end

function DayNight.apply()
	local clock = DayNight.clockTime()
	local t = DayCycle.darkness(clock)
	Lighting.ClockTime = clock
	Lighting.Brightness = lerp(DAY.brightness, NIGHT.brightness, t)
	Lighting.Ambient = DAY.ambient:Lerp(NIGHT.ambient, t)
	Lighting.OutdoorAmbient = DAY.outdoor:Lerp(NIGHT.outdoor, t)
	Lighting.ColorShift_Top = DAY.shiftTop:Lerp(NIGHT.shiftTop, t)
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		atmosphere.Haze = lerp(DAY.haze, NIGHT.haze, t)
		atmosphere.Color = DAY.atmosphere:Lerp(NIGHT.atmosphere, t)
	end
end

function DayNight.start()
	while true do
		DayNight.apply()
		task.wait(DayNight.STEP)
	end
end

return DayNight
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Leaderboards</string>
            <string name="Source"><![CDATA[--!strict
-- The global leaderboards on the boardwalk: longest throw, most coins
-- earned and most rebirths. Scores go to OrderedDataStores every few minutes
-- (and when a player leaves); the top 10 are read back and shown on the
-- boards. Without DataStore access (Studio before publishing) the boards
-- show the players in this server instead. Studio test sessions never write
-- (the test panel's cheats would otherwise reach the real boards).

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserService = game:GetService("UserService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Types = require(ReplicatedStorage.Shared.Types)
local BoardData = require(script.Parent.Parent.Lib.BoardData)
local Data = require(script.Parent.Data)
local Sessions = require(script.Parent.Sessions)
local World = require(script.Parent.World)

local Leaderboards = {}

Leaderboards.REFRESH_SECONDS = Config.LEADERBOARD_REFRESH

export type Entry = { userId: number, value: number }

local stores: { [string]: OrderedDataStore } = {}
local mock = false
local lastWritten: { [Player]: { [string]: number } } = {}
local names: { [number]: string } = {}

local function boardOf(key: string): BoardData.Board?
	for _, board in BoardData.BOARDS do
		if board.key == key then
			return board
		end
	end
	return nil
end

-- A player's score for a board, as stored (see BoardData.encode).
local function valueOf(key: string, profile: Types.Profile): number
	local board = boardOf(key)
	if not board then
		return 0
	end
	local score = 0
	if key == "Distance" then
		score = profile.bestDistance
	elseif key == "Coins" then
		score = profile.totalCoins
	elseif key == "Rebirths" then
		score = profile.rebirths
	end
	return BoardData.encode(board, score)
end

local function formatValue(key: string, value: number): string
	local board = boardOf(key)
	local score = if board then BoardData.decode(board, value) else value
	if key == "Distance" then
		return Format.distance(score)
	elseif key == "Coins" then
		return Format.short(score)
	end
	return Format.commas(score)
end

local function openStores()
	-- (Data starts first; without DataStores the boards show this server)
	if Data.isMock() then
		mock = true
		return
	end
	for _, board in BoardData.BOARDS do
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore(board.store)
		end)
		if not ok then
			mock = true
			return
		end
		stores[board.key] = store
	end
end

-- Saves a player's scores (only the ones that changed since last time).
local function write(player: Player, profile: Types.Profile)
	if mock or RunService:IsStudio() then
		return
	end
	local written = lastWritten[player] or {}
	lastWritten[player] = written
	for _, board in BoardData.BOARDS do
		local value = valueOf(board.key, profile)
		local store = stores[board.key]
		if store and written[board.key] ~= value and value > 0 then
			local ok = pcall(function()
				store:SetAsync(tostring(player.UserId), value)
			end)
			if ok then
				written[board.key] = value
			end
		end
	end
end

local function topEntries(key: string): { Entry }
	local entries: { Entry } = {}
	if mock then
		for _, player in Players:GetPlayers() do
			local profile = Data.get(player)
			if profile then
				table.insert(entries, { userId = player.UserId, value = valueOf(key, profile) })
				names[player.UserId] = player.DisplayName
			end
		end
		table.sort(entries, function(a, b)
			return a.value > b.value
		end)
		while #entries > BoardData.ROWS do
			table.remove(entries)
		end
		return entries
	end
	local store = stores[key]
	if not store then
		return entries
	end
	local ok, page = pcall(function()
		return store:GetSortedAsync(false, BoardData.ROWS):GetCurrentPage()
	end)
	if ok and type(page) == "table" then
		for _, item in page do
			local userId = tonumber(item.key)
			if userId and type(item.value) == "number" then
				table.insert(entries, { userId = userId, value = item.value })
			end
		end
	end
	return entries
end

-- Display names for any user ids we haven't seen yet.
local function resolveNames(entries: { Entry })
	local missing = {}
	for _, entry in entries do
		if not names[entry.userId] then
			local player = Players:GetPlayerByUserId(entry.userId)
			if player then
				names[entry.userId] = player.DisplayName
			else
				table.insert(missing, entry.userId)
			end
		end
	end
	if #missing == 0 then
		return
	end
	local ok, infos = pcall(function()
		return UserService:GetUserInfosByUserIdsAsync(missing)
	end)
	if ok and type(infos) == "table" then
		for _, info in infos do
			if type(info.Id) == "number" and type(info.DisplayName) == "string" then
				names[info.Id] = info.DisplayName
			end
		end
	end
end

local function render(key: string, entries: { Entry })
	local gui = World.get().boards[key]
	if not gui then
		return
	end
	for row = 1, BoardData.ROWS do
		local frame = gui:FindFirstChild("Row" .. row)
		local nameLabel = frame and frame:FindFirstChild("Player")
		local valueLabel = frame and frame:FindFirstChild("Score")
		local rankLabel = frame and frame:FindFirstChild("Rank")
		if
			not nameLabel
			or not nameLabel:IsA("TextLabel")
			or not valueLabel
			or not valueLabel:IsA("TextLabel")
			or not rankLabel
			or not rankLabel:IsA("TextLabel")
		then
			continue
		end
		local entry = entries[row]
		rankLabel.Text = if row == 1
			then "🥇"
			elseif row == 2 then "🥈"
			elseif row == 3 then "🥉"
			else tostring(row)
		nameLabel.Text = if entry then names[entry.userId] or "Player" else ""
		valueLabel.Text = if entry then formatValue(key, entry.value) else ""
	end
end

-- One full pass: save everyone's scores, then redraw every board.
function Leaderboards.refresh()
	for _, session in Sessions.ready() do
		-- (earlier writes yield; skip anyone who left meanwhile)
		local profile = Data.get(session.player)
		if profile and session.ready and session.player.Parent ~= nil then
			write(session.player, profile)
		end
	end
	for _, board in BoardData.BOARDS do
		local entries = topEntries(board.key)
		resolveNames(entries)
		render(board.key, entries)
	end
end

function Leaderboards.isMock(): boolean
	return mock
end

function Leaderboards.init()
	openStores()
	Sessions.Leaving:connect(function(player: Player)
		local profile = Data.get(player)
		if profile then
			task.spawn(write, player, profile)
		end
		lastWritten[player] = nil
	end)
	Players.PlayerRemoving:Connect(function(player: Player)
		task.defer(function()
			lastWritten[player] = nil
		end)
	end)
end

function Leaderboards.start()
	task.wait(if mock then 3 else 10)
	while true do
		Leaderboards.refresh()
		-- this server's own board is cheap to redraw, so it can keep up
		task.wait(if mock then 10 else Leaderboards.REFRESH_SECONDS)
	end
end

return Leaderboards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Lifecycle</string>
            <string name="Source"><![CDATA[--!strict
-- Join and leave, in the right order:
--   join:  session -> load the save -> wait for the terrain -> spawn ->
--          ready (leaderstats, title, held stone)
--   leave: everyone else forgets the player -> final save + release the lock
-- Characters are spawned here (not automatically), so nobody drops into the
-- valley before its ground exists, and respawned a moment after falling.

local Players = game:GetService("Players")

local Data = require(script.Parent.Data)
local Sessions = require(script.Parent.Sessions)
local State = require(script.Parent.State)
local World = require(script.Parent.World)

local Lifecycle = {}

Lifecycle.RESPAWN_SECONDS = 3

local function spawn(player: Player)
	local ok, err = pcall(function()
		player:LoadCharacterAsync()
	end)
	if not ok then
		warn(`[Lifecycle] couldn't spawn {player.Name}: {err}`)
	end
end

local function onCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid or not humanoid:IsA("Humanoid") then
		return
	end
	humanoid.Died:Connect(function()
		task.delay(Lifecycle.RESPAWN_SECONDS, function()
			if player.Parent ~= nil and Sessions.get(player) and player.Character == character then
				spawn(player)
			end
		end)
	end)
end

local function onJoin(player: Player)
	local session = Sessions.create(player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	local profile = Data.load(player)
	local function left(): boolean
		return player.Parent == nil or Sessions.get(player) ~= session
	end
	if left() then
		Data.release(player)
		Sessions.remove(player)
		return
	end
	if not profile then
		Sessions.remove(player)
		player:Kick("We couldn't load your stones right now. Please rejoin in a moment!")
		return
	end
	while not World.isReady() and not left() do
		task.wait(0.2)
	end
	if left() then
		return
	end
	spawn(player)
	if left() then
		return
	end
	session.ready = true
	Sessions.Ready:fire(player)
	State.markDirty(player)
end

local function onLeave(player: Player)
	local session = Sessions.get(player)
	if not session then
		return
	end
	local wasReady = session.ready
	session.ready = false
	if wasReady then
		Sessions.Leaving:fire(player)
	end
	Data.release(player)
	Sessions.remove(player)
end

function Lifecycle.init()
	Players.CharacterAutoLoads = false
end

function Lifecycle.start()
	Players.PlayerAdded:Connect(onJoin)
	Players.PlayerRemoving:Connect(onLeave)
	for _, player in Players:GetPlayers() do
		task.spawn(onJoin, player)
	end
end

return Lifecycle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Progress</string>
            <string name="Source"><![CDATA[--!strict
-- Records, islands, goals and titles. Every finished throw comes through
-- recordThrow; anything else that changes progress calls check. A skipper's
-- title floats over their head, and their coins, longest throw and rebirths
-- show on the player list.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GoalData = require(ReplicatedStorage.Shared.Data.GoalData)
local IslandData = require(ReplicatedStorage.Shared.Data.IslandData)
local Net = require(ReplicatedStorage.Shared.Net)
local Types = require(ReplicatedStorage.Shared.Types)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Notify = require(script.Parent.Parent.Lib.Notify)
local Data = require(script.Parent.Data)
local Sessions = require(script.Parent.Sessions)
local State = require(script.Parent.State)

local Progress = {}

Progress.TITLE_NAME = "SkipperTitle"

-- One finished throw, as far as records are concerned.
export type Throw = {
	distance: number,
	skips: number,
	perfect: boolean,
	coins: number,
}

function Progress.stats(profile: Types.Profile): GoalData.Stats
	local rocks = 0
	for _, owned in profile.rocks do
		if owned then
			rocks += 1
		end
	end
	return {
		bestSkips = profile.bestSkips,
		bestDistance = profile.bestDistance,
		perfects = profile.perfects,
		rocks = rocks,
		rebirths = profile.rebirths,
		throws = profile.throws,
		totalCoins = profile.totalCoins,
	}
end

-- The floating title over a character's head (or none below the first title).
local function applyTitle(player: Player)
	local profile = Data.get(player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not profile or not head or not head:IsA("BasePart") then
		return
	end
	local title = GoalData.title(profile.bestDistance)
	local existing = head:FindFirstChild(Progress.TITLE_NAME)
	if not title then
		if existing then
			existing:Destroy()
		end
		return
	end
	local gui: BillboardGui
	if existing and existing:IsA("BillboardGui") then
		gui = existing
	else
		gui = Instance.new("BillboardGui")
		gui.Name = Progress.TITLE_NAME
		gui.Size = UDim2.fromOffset(220, 34)
		gui.StudsOffset = Vector3.new(0, 2.6, 0)
		gui.MaxDistance = 80
		gui.LightInfluence = 0
		local label = Instance.new("TextLabel")
		label.Name = "Text"
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(255, 236, 170)
		label.TextStrokeColor3 = Color3.fromRGB(24, 40, 70)
		label.TextStrokeTransparency = 0.2
		label.Parent = gui
		gui.Parent = head
	end
	local label = gui:FindFirstChild("Text")
	if label and label:IsA("TextLabel") then
		label.Text = `✦ {title} ✦`
	end
end

local function stat(player: Player, name: string, value: string | number)
	local stats = player:FindFirstChild("leaderstats")
	local holder = stats and stats:FindFirstChild(name)
	local fits = holder
		and (
			(holder:IsA("StringValue") and type(value) == "string")
			or (holder:IsA("IntValue") and type(value) == "number")
		)
	if fits then
		(holder :: any).Value = value
	end
end

local function updateLeaderstats(player: Player)
	local profile = Data.get(player)
	if not profile then
		return
	end
	stat(player, "Coins", Format.short(profile.coins))
	stat(player, "Longest", Format.short(profile.bestDistance))
	stat(player, "Rebirths", profile.rebirths)
end

-- Marks newly finished goals and newly reached islands, and tells the player.
function Progress.check(player: Player)
	local profile = Data.get(player)
	if not profile then
		return
	end
	for _, island in IslandData.LIST do
		if not profile.islands[island.id] and profile.bestDistance >= island.distance then
			profile.islands[island.id] = true
			Net.fire(player, "Island", island.id) -- the client shows a banner
		end
	end
	local stats = Progress.stats(profile)
	for _, goal in GoalData.GOALS do
		if not profile.goals[goal.id] and GoalData.isDone(goal, stats) then
			profile.goals[goal.id] = true
			Notify.send(player, `{goal.emoji} Goal complete: {goal.text}`, "good")
		end
	end
	updateLeaderstats(player)
	applyTitle(player)
	State.markDirty(player)
end

-- Folds one finished throw into the thrower's profile. Returns whether it
-- was their longest yet.
function Progress.recordThrow(player: Player, throw: Throw): boolean
	local profile = Data.get(player)
	if not profile then
		return false
	end
	local oldTitle = GoalData.title(profile.bestDistance)
	profile.coins += throw.coins
	profile.totalCoins += throw.coins
	if throw.skips > 0 then
		profile.throws += 1
		profile.totalSkips += throw.skips
	end
	if throw.perfect then
		profile.perfects += 1
	end
	profile.bestSkips = math.max(profile.bestSkips, throw.skips)
	local newBest = throw.distance > profile.bestDistance
	if newBest then
		profile.bestDistance = throw.distance
	end
	Progress.check(player)
	local newTitle = GoalData.title(profile.bestDistance)
	if newTitle and newTitle ~= oldTitle then
		Notify.send(player, `✦ New title: {newTitle} ✦`, "rare")
	end
	return newBest
end

-- After a rebirth or a reset: redraw the title and the player list.
function Progress.refresh(player: Player)
	if Data.get(player) then
		updateLeaderstats(player)
		applyTitle(player)
		State.markDirty(player)
	end
end

local function onReady(player: Player)
	local profile = Data.get(player)
	if not profile then
		return
	end
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in { "Coins", "Longest" } do
		local value = Instance.new("StringValue")
		value.Name = name
		value.Parent = stats
	end
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = stats
	stats.Parent = player
	player.CharacterAdded:Connect(function(character)
		character:WaitForChild("Head", 10)
		if Sessions.getReady(player) then
			applyTitle(player)
		end
	end)
	if player.Character then
		task.spawn(applyTitle, player)
	end
	-- goals and islands added in an update may already be done
	Progress.check(player)
end

function Progress.init()
	Sessions.Ready:connect(onReady)
end

return Progress
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Sessions</string>
            <string name="Source"><![CDATA[--!strict
-- Runtime (not saved) state for each player in this server. The saved
-- profile lives in Data.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Signal = require(ReplicatedStorage.Shared.Util.Signal)

export type Session = {
	player: Player,
	ready: boolean,
	chargeStart: number?, -- os.clock() when they started winding up a throw
	lastThrowAt: number, -- os.clock() of their last throw
}

local Sessions = {}

Sessions.Ready = Signal.new() :: Signal.Signal<Player>
Sessions.Leaving = Signal.new() :: Signal.Signal<Player>

local sessions: { [Player]: Session } = {}

function Sessions.create(player: Player): Session
	local session: Session = {
		player = player,
		ready = false,
		chargeStart = nil,
		lastThrowAt = -math.huge,
	}
	sessions[player] = session
	return session
end

function Sessions.get(player: Player): Session?
	return sessions[player]
end

-- The session, but only once the player has finished loading.
function Sessions.getReady(player: Player): Session?
	local session = sessions[player]
	if session and session.ready then
		return session
	end
	return nil
end

-- Every session that finished loading.
function Sessions.ready(): { Session }
	local list: { Session } = {}
	for _, s in sessions do
		if s.ready then
			table.insert(list, s)
		end
	end
	return list
end

function Sessions.remove(player: Player)
	sessions[player] = nil
end

return Sessions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Shop</string>
            <string name="Source"><![CDATA[--!strict
-- Spending coins: buying and choosing rocks, arm-strength upgrades and
-- rebirths. Also the rock in each player's hand. Every request is checked
-- here: the client only asks.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require(ReplicatedStorage.Shared.Economy)
local Net = require(ReplicatedStorage.Shared.Net)
local RockData = require(ReplicatedStorage.Shared.Data.RockData)
local RockModel = require(ReplicatedStorage.Shared.RockModel)
local Types = require(ReplicatedStorage.Shared.Types)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Notify = require(script.Parent.Parent.Lib.Notify)
local Data = require(script.Parent.Data)
local Progress = require(script.Parent.Progress)
local Sessions = require(script.Parent.Sessions)
local State = require(script.Parent.State)

local Shop = {}

Shop.HELD_NAME = "HeldRock"

-- Why a request was refused: "notReady" | "unknown" | "owned" | "locked" |
-- "poor" | "notOwned" | "maxed" (plain strings: the type checker widens them).
export type Refusal = string

-- ===== The rock in your hand =====

local function hand(character: Model): BasePart?
	local right = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if right and right:IsA("BasePart") then
		return right
	end
	return nil
end

-- Puts the equipped rock in the character's right hand (replacing the old one).
function Shop.updateHeld(player: Player)
	local profile = Data.get(player)
	local character = player.Character
	if not profile or not character then
		return
	end
	local old = character:FindFirstChild(Shop.HELD_NAME)
	if old then
		old:Destroy()
	end
	local grip = hand(character)
	if not grip then
		return
	end
	local rock = RockModel.build(profile.equipped, 0.8)
	rock.Name = Shop.HELD_NAME
	rock.Anchored = false
	rock:SetAttribute("BaseTransparency", rock.Transparency)
	local attachment = grip:FindFirstChild("RightGripAttachment")
	local at = if attachment and attachment:IsA("Attachment")
		then attachment.WorldCFrame
		else grip.CFrame * CFrame.new(0, -grip.Size.Y / 2, 0)
	rock.CFrame = at * CFrame.new(0, -0.15, 0) * CFrame.Angles(0, 0, math.rad(90))
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = grip
	weld.Part1 = rock
	weld.Parent = rock
	rock.Parent = character
end

-- Hides the held rock while a thrown one is in the air.
function Shop.hideHeld(player: Player, seconds: number)
	local character = player.Character
	local held = character and character:FindFirstChild(Shop.HELD_NAME)
	if not held or not held:IsA("BasePart") then
		return
	end
	held.Transparency = 1
	local sparkle = held:FindFirstChild("Sparkle")
	if sparkle and sparkle:IsA("ParticleEmitter") then
		sparkle.Enabled = false
	end
	task.delay(seconds, function()
		if held.Parent == nil then
			return
		end
		local base = held:GetAttribute("BaseTransparency")
		held.Transparency = if type(base) == "number" then base else 0
		if sparkle and sparkle:IsA("ParticleEmitter") then
			sparkle.Enabled = true
		end
	end)
end

-- ===== Buying =====

local function ready(player: Player): Types.Profile?
	if not Sessions.getReady(player) then
		return nil
	end
	return Data.get(player)
end

function Shop.equip(player: Player, id: unknown): Refusal?
	local profile = ready(player)
	if not profile then
		return "notReady"
	end
	if type(id) ~= "string" or not RockData.get(id) then
		return "unknown"
	end
	if not profile.rocks[id] then
		return "notOwned"
	end
	if profile.equipped ~= id then
		profile.equipped = id
		Shop.updateHeld(player)
		State.markDirty(player)
	end
	return nil
end

function Shop.buyRock(player: Player, id: unknown): Refusal?
	local profile = ready(player)
	if not profile then
		return "notReady"
	end
	local rock = if type(id) == "string" then RockData.get(id) else nil
	if not rock then
		return "unknown"
	end
	if profile.rocks[rock.id] then
		return "owned"
	end
	if not Economy.rockUnlocked(rock, profile.islands) then
		return "locked"
	end
	if profile.coins < rock.price then
		return "poor"
	end
	profile.coins -= rock.price
	profile.rocks[rock.id] = true
	-- a new rock goes straight into your hand if it's better than the one you hold
	local held = Economy.rockOf(Economy.statsOf(profile))
	if rock.power > held.power then
		profile.equipped = rock.id
		Shop.updateHeld(player)
	end
	Notify.send(player, `🪨 You bought {rock.name}!`, "good")
	Progress.check(player)
	State.markDirty(player)
	return nil
end

-- Buys `count` strength levels (or as many as you can afford, if fewer).
-- Returns how many it bought.
function Shop.upgrade(player: Player, count: unknown): (number, Refusal?)
	local profile = ready(player)
	if not profile then
		return 0, "notReady"
	end
	local wanted = if type(count) == "number" and count == count
		then math.clamp(math.floor(count), 1, 100)
		else 1
	local bought = 0
	while bought < wanted do
		if profile.strength >= Economy.MAX_STRENGTH then
			break
		end
		local cost = Economy.strengthCost(profile.strength)
		if profile.coins < cost then
			break
		end
		profile.coins -= cost
		profile.strength += 1
		bought += 1
	end
	if bought == 0 then
		return 0, if profile.strength >= Economy.MAX_STRENGTH then "maxed" else "poor"
	end
	State.markDirty(player)
	return bought, nil
end

function Shop.rebirth(player: Player): Refusal?
	local profile = ready(player)
	if not profile then
		return "notReady"
	end
	local cost = Economy.rebirthCost(profile.rebirths)
	if profile.coins < cost then
		return "poor"
	end
	profile.rebirths += 1
	profile.coins = 0
	profile.strength = 0
	local multiplier = Economy.coinMultiplier(Economy.statsOf(profile))
	Notify.send(
		player,
		`🔁 Rebirth {profile.rebirths}! Every throw now pays {Format.times(multiplier)} coins`,
		"rare"
	)
	Progress.check(player)
	Progress.refresh(player)
	State.markDirty(player)
	return nil
end

local MESSAGES: { [string]: string } = {
	poor = "Not enough coins yet",
	locked = "Skip a rock past the island to unlock this one",
	maxed = "Your arm can't get any stronger",
}

local function tell(player: Player, refusal: Refusal?)
	local message = refusal and MESSAGES[refusal]
	if message then
		Notify.send(player, message, "bad")
	end
end

function Shop.init()
	Net.on("Equip", 4, 8, function(player: Player, id: unknown)
		Shop.equip(player, id)
	end)
	Net.on("BuyRock", 3, 6, function(player: Player, id: unknown)
		tell(player, Shop.buyRock(player, id))
	end)
	Net.on("Upgrade", 6, 12, function(player: Player, count: unknown)
		local _, refusal = Shop.upgrade(player, count)
		tell(player, refusal)
	end)
	Net.on("Rebirth", 1, 2, function(player: Player)
		tell(player, Shop.rebirth(player))
	end)
	Sessions.Ready:connect(function(player: Player)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("HumanoidRootPart", 10)
			character:WaitForChild("RightHand", 3)
			if Sessions.getReady(player) and player.Character == character then
				Shop.updateHeld(player)
			end
		end)
		-- the avatar's own body parts can replace the hands once it loads
		player.CharacterAppearanceLoaded:Connect(function(character)
			if Sessions.getReady(player) and player.Character == character then
				Shop.updateHeld(player)
			end
		end)
		if player.Character then
			task.spawn(Shop.updateHeld, player)
		end
	end)
end

return Shop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!strict
-- Sends each player a snapshot of their own progress whenever it changes
-- (batched, at most 5 times a second), plus a full one when their client says
-- it's ready. Clients only draw it; the server decides everything.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GoalData = require(ReplicatedStorage.Shared.Data.GoalData)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Net = require(ReplicatedStorage.Shared.Net)
local Types = require(ReplicatedStorage.Shared.Types)
local Access = require(script.Parent.Parent.Lib.Access)
local Data = require(script.Parent.Data)
local Sessions = require(script.Parent.Sessions)

local State = {}

local dirty: { [Player]: boolean } = {}
local clientReady: { [Player]: boolean } = {}

function State.markDirty(player: Player)
	dirty[player] = true
end

function State.snapshot(player: Player): Types.Snapshot?
	local profile = Data.get(player)
	if not profile or not Sessions.getReady(player) then
		return nil
	end
	local stats = Economy.statsOf(profile)
	return {
		coins = profile.coins,
		totalCoins = profile.totalCoins,
		strength = profile.strength,
		rocks = profile.rocks,
		equipped = profile.equipped,
		rebirths = profile.rebirths,
		islands = profile.islands,
		bestDistance = profile.bestDistance,
		bestSkips = profile.bestSkips,
		throws = profile.throws,
		totalSkips = profile.totalSkips,
		perfects = profile.perfects,
		goals = profile.goals,
		coinMultiplier = Economy.coinMultiplier(stats),
		distanceMultiplier = Economy.distanceMultiplier(stats, false),
		strengthCost = Economy.strengthCost(profile.strength),
		rebirthCost = Economy.rebirthCost(profile.rebirths),
		title = GoalData.title(profile.bestDistance),
		isDev = Access.isDev(player),
	}
end

local function send(player: Player)
	local snapshot = State.snapshot(player)
	if snapshot then
		Net.fire(player, "State", snapshot)
	end
end

function State.init()
	Net.on("Ready", 1, 3, function(player: Player)
		clientReady[player] = true
		send(player)
	end)
	-- The client may say it's ready before its profile finishes loading.
	Sessions.Ready:connect(function(player: Player)
		if clientReady[player] then
			send(player)
		end
	end)
	local function forget(player: Player)
		dirty[player] = nil
		clientReady[player] = nil
	end
	Sessions.Leaving:connect(forget)
	-- players kicked while joining never fire Leaving
	Players.PlayerRemoving:Connect(forget)
end

function State.start()
	while true do
		task.wait(0.2)
		for player in dirty do
			dirty[player] = nil
			if clientReady[player] and player.Parent ~= nil then
				send(player)
			end
		end
	end
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Throws</string>
            <string name="Source"><![CDATA[--!strict
-- Throwing. The client says when the player starts winding up (BeginCharge)
-- and when they let go (Release, with how long they held). The server checks
-- the throw makes sense, works out every skip itself, scales it by the
-- player's strength, rock and rebirths, pays out, and tells everyone so all
-- screens draw the same rock flying out to sea.
--
-- The power comes from the client's hold time so the needle the player sees
-- is the needle that counts, but it must agree with the server's own timing
-- (CLOCK_SLACK), so nobody can claim a hold that never happened.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Net = require(ReplicatedStorage.Shared.Net)
local Sea = require(ReplicatedStorage.Shared.Sea)
local Skip = require(ReplicatedStorage.Shared.Skip)
local Types = require(ReplicatedStorage.Shared.Types)
local Notify = require(script.Parent.Parent.Lib.Notify)
local Data = require(script.Parent.Data)
local DayNight = require(script.Parent.DayNight)
local Progress = require(script.Parent.Progress)
local Sessions = require(script.Parent.Sessions)
local Shop = require(script.Parent.Shop)

local Throws = {}

Throws.CLOCK_SLACK = 0.3 -- seconds the client's hold time may differ from the server's
Throws.HAND_HEIGHT = 1.2 -- the rock leaves the hand this far above the root part

export type Rejection =
	"notReady"
	| "noCharge"
	| "tooShort"
	| "tooLong"
	| "cooldown"
	| "noCharacter"
	| "notHere"

local MESSAGES: { [string]: string } = {
	notHere = "Walk down to the beach or onto a pier to throw",
}

local random = Random.new()

local function rand(a: number, b: number): number
	return random:NextNumber(a, b)
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil
	end
	return root
end

local function beginCharge(player: Player)
	local session = Sessions.getReady(player)
	if session then
		session.chargeStart = os.clock()
	end
end

local function cancelCharge(player: Player)
	local session = Sessions.get(player)
	if session then
		session.chargeStart = nil
	end
end

-- Checks and performs one throw. Returns the event sent to everyone, or why
-- it was refused.
function Throws.release(player: Player, rawHeld: unknown): (Types.ThrowEvent?, Rejection?)
	local session = Sessions.getReady(player)
	local profile = Data.get(player)
	if not session or not profile then
		return nil, "notReady"
	end
	local started = session.chargeStart
	session.chargeStart = nil
	if not started then
		return nil, "noCharge"
	end
	local now = os.clock()
	local serverHeld = now - started
	local held = serverHeld
	if type(rawHeld) == "number" and rawHeld == rawHeld then
		held = math.clamp(rawHeld, serverHeld - Throws.CLOCK_SLACK, serverHeld + Throws.CLOCK_SLACK)
	end
	if held < Config.MIN_CHARGE_SECONDS then
		return nil, "tooShort"
	end
	if held > Config.MAX_CHARGE_SECONDS then
		return nil, "tooLong"
	end
	if now - session.lastThrowAt < Config.THROW_COOLDOWN then
		return nil, "cooldown"
	end
	local root = rootOf(player)
	if not root then
		return nil, "noCharacter"
	end
	local position = root.CFrame.Position
	if not Sea.canThrowFrom(position) then
		return nil, "notHere"
	end

	local stats = Economy.statsOf(profile)
	local rock = Economy.rockOf(stats)
	local night = DayNight.isNight()
	local outcome = Skip.outcome(Skip.power(held), rock, rand)
	local scale = Economy.distanceMultiplier(stats, night)
	local hops: { number } = {}
	for i, hop in outcome.hops do
		hops[i] = hop * scale
	end
	local distance = outcome.distance * scale
	local coins = Economy.coinsFor(distance, outcome.skips, outcome.perfect, stats)
	session.lastThrowAt = now
	local newBest = Progress.recordThrow(player, {
		distance = distance,
		skips = outcome.skips,
		perfect = outcome.perfect,
		coins = coins,
	})

	local origin = position + Vector3.new(0, Throws.HAND_HEIGHT, 0.8)
	local event: Types.ThrowEvent = {
		userId = player.UserId,
		rock = rock.id,
		origin = origin,
		entry = Sea.entry(position),
		hops = hops,
		skips = outcome.skips,
		distance = distance,
		coins = coins,
		verdict = outcome.verdict,
		perfect = outcome.perfect,
		power = outcome.power,
		night = night,
		newBest = newBest,
	}
	Net.fireAll("Throw", event)
	Shop.hideHeld(player, Config.THROW_COOLDOWN)
	return event, nil
end

function Throws.init()
	Net.on("BeginCharge", 4, 6, beginCharge)
	Net.on("CancelCharge", 4, 6, cancelCharge)
	Net.on("Release", 4, 6, function(player: Player, held: unknown)
		local _, rejection = Throws.release(player, held)
		local message = rejection and MESSAGES[rejection]
		if message then
			Notify.send(player, message, "bad")
		end
	end)
end

return Throws
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Treasure</string>
            <string name="Source"><![CDATA[--!strict
-- Treasure that washes up on the beach now and then: glinting shells and
-- little chests. Walk over and pick one up for a handful of coins (more the
-- further along you are).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Land = require(ReplicatedStorage.Shared.Land)
local Sea = require(ReplicatedStorage.Shared.Sea)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Notify = require(script.Parent.Parent.Lib.Notify)
local Data = require(script.Parent.Data)
local Progress = require(script.Parent.Progress)
local Sessions = require(script.Parent.Sessions)
local State = require(script.Parent.State)

local Treasure = {}

Treasure.PICKUP_RANGE = 10 -- a little more than the prompt's, for lag
Treasure.BACK = Land.BEACH_BACK + 4 -- treasure washes up between here...
Treasure.FRONT = -3 -- ...and the water's edge
Treasure.HALF_WIDTH = Config.THROW_ZONE_HALF_WIDTH - 10
Treasure.SPACING = 14
Treasure.THROWS_WORTH = 3 -- a find pays about this many decent throws

local folder: Folder? = nil
local pieces: { [BasePart]: true } = {}
local random = Random.new()

-- Coins a find is worth to this player right now.
function Treasure.reward(profile: Economy.Stats): number
	-- about what a ~150-stud base throw pays, a few times over
	local distance = 150 * Economy.distanceMultiplier(profile, false)
	return math.max(10, Economy.coinsFor(distance, 10, false, profile) * Treasure.THROWS_WORTH)
end

local function findSpot(): Vector3?
	for _ = 1, 40 do
		local x = random:NextNumber(-Treasure.HALF_WIDTH, Treasure.HALF_WIDTH)
		local z = random:NextNumber(Treasure.BACK, Treasure.FRONT)
		local p = Vector3.new(x, 0, z)
		local clear = not Sea.pierAt(p, 3)
		if clear then
			for piece in pieces do
				local q = piece.CFrame.Position
				if Vector3.new(q.X - x, 0, q.Z - z).Magnitude < Treasure.SPACING then
					clear = false
					break
				end
			end
		end
		if clear then
			return Land.at(x, z, 0.35)
		end
	end
	return nil
end

local spawnPiece: () -> ()

local function collect(piece: BasePart, player: Player)
	if not pieces[piece] or not Sessions.getReady(player) then
		return
	end
	local profile = Data.get(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not profile or not root or not root:IsA("BasePart") then
		return
	end
	if (root.CFrame.Position - piece.CFrame.Position).Magnitude > Treasure.PICKUP_RANGE then
		return
	end
	pieces[piece] = nil
	piece:Destroy()
	local coins = Treasure.reward(Economy.statsOf(profile))
	profile.coins += coins
	profile.totalCoins += coins
	Notify.send(player, `✨ Treasure! +{Format.short(coins)} coins`, "good")
	Progress.check(player)
	State.markDirty(player)
	task.delay(
		random:NextNumber(Config.TREASURE_RESPAWN_MIN, Config.TREASURE_RESPAWN_MAX),
		spawnPiece
	)
end

function spawnPiece()
	local parent = folder
	if not parent then
		return
	end
	local spot = findSpot()
	if not spot then
		task.delay(10, spawnPiece)
		return
	end
	local chest = random:NextNumber() < 0.3
	local piece = Instance.new("Part")
	piece.Name = "Treasure"
	piece.Size = if chest then Vector3.new(1.6, 1.1, 1.1) else Vector3.new(1, 0.4, 0.9)
	piece.CFrame = CFrame.new(spot) * CFrame.Angles(0, random:NextNumber(0, 2 * math.pi), 0)
	piece.Color = if chest then Color3.fromRGB(176, 120, 64) else Color3.fromRGB(255, 226, 210)
	piece.Material = if chest then Enum.Material.WoodPlanks else Enum.Material.Marble
	piece.Anchored = true
	piece.CanCollide = false
	piece.CanTouch = false
	piece.CastShadow = false
	piece.TopSurface = Enum.SurfaceType.Smooth
	piece.BottomSurface = Enum.SurfaceType.Smooth
	if not chest then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = piece
	end
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Name = "Sparkle"
	sparkle.Color = ColorSequence.new(Color3.fromRGB(255, 240, 180))
	sparkle.LightEmission = 1
	sparkle.Rate = 5
	sparkle.Lifetime = NumberRange.new(0.6, 1.2)
	sparkle.Speed = NumberRange.new(0.5, 1.5)
	sparkle.SpreadAngle = Vector2.new(40, 40)
	sparkle.EmissionDirection = Enum.NormalId.Top
	sparkle.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.3),
		NumberSequenceKeypoint.new(1, 0),
	})
	sparkle.Parent = piece
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Pick up"
	prompt.ObjectText = if chest then "Little chest" else "Glinting shell"
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.Parent = piece
	prompt.Triggered:Connect(function(player: Player)
		collect(piece, player)
	end)
	pieces[piece] = true
	piece.Parent = parent
end

function Treasure.count(): number
	local n = 0
	for _ in pieces do
		n += 1
	end
	return n
end

function Treasure.list(): { BasePart }
	local list = {}
	for piece in pieces do
		table.insert(list, piece)
	end
	return list
end

-- Testing: wash it all away and bring a fresh lot.
function Treasure.refresh()
	for piece in pieces do
		piece:Destroy()
	end
	table.clear(pieces)
	for _ = 1, Config.TREASURE_COUNT do
		spawnPiece()
	end
end

function Treasure.init()
	local f = Instance.new("Folder")
	f.Name = "Treasure"
	f.Parent = Workspace
	folder = f
end

function Treasure.start()
	for _ = 1, Config.TREASURE_COUNT do
		spawnPiece()
	end
end

return Treasure
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[--!strict
-- Builds the coast when the server starts: the parts first (instantly), then
-- the terrain and the ocean in the background, nearest the lobby first.
-- Players spawn once it's ready (see Lifecycle). It also keeps everyone on
-- dry land: a player who somehow ends up in the sea or past the edge of the
-- world is put back by the spawn.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Land = require(ReplicatedStorage.Shared.Land)
local Sea = require(ReplicatedStorage.Shared.Sea)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Ground = require(script.Parent.Parent.Lib.Ground)
local Scenery = require(script.Parent.Parent.Lib.Scenery)

local World = {}

World.Ready = Signal.new() :: Signal.Signal<()>
World.IN_WATER_BELOW = 1.6 -- a root part this low out past the shore wall is swimming

local built: Scenery.Built? = nil
local ready = false

function World.get(): Scenery.Built
	assert(built, "World not built yet")
	return built
end

function World.isReady(): boolean
	return ready
end

function World.spawnCFrame(): CFrame
	return World.get().spawn.CFrame + Vector3.new(0, 3.5, 0)
end

-- Is a character's root part at `p` in the lake (not on a dock)?
function World.inWater(p: Vector3): boolean
	return p.Z > Scenery.SHORE_WALL and p.Y < World.IN_WATER_BELOW and not Sea.pierAt(p, 1)
end

-- Put a character back by the spawn if it's in the water or out of bounds.
function World.rescue(player: Player): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not root or not root:IsA("BasePart") then
		return false
	end
	local p = root.CFrame.Position
	local far = math.abs(p.X) > Scenery.PLAY_HALF_WIDTH + 20
		or p.Z < Land.SOUTH
		or p.Z > Sea.PIER_END + 40
		or p.Y < -30
	if not far and not World.inWater(p) then
		return false
	end
	root.AssemblyLinearVelocity = Vector3.zero
	character:PivotTo(World.spawnCFrame())
	return true
end

-- Writes the terrain. Yields until done, then lets players in.
function World.buildTerrain()
	Ground.build(Workspace.Terrain)
	ready = true
	World.Ready:fire()
end

function World.init()
	local placeholder = Workspace:FindFirstChild("PressPlay")
	if placeholder then
		placeholder:Destroy()
	end
	built = Scenery.build(Workspace)
end

function World.start()
	task.spawn(World.buildTerrain)
	while true do
		task.wait(1)
		if ready then
			for _, player in Players:GetPlayers() do
				World.rescue(player)
			end
		end
	end
end

return World
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="53">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">60</float>
      <float name="CharacterWalkSpeed">16</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="54">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="55">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
-- Skip a Rock client entry point. Same two-phase start as the server: init()
-- every controller (in name order), then start() each in its own thread.
-- One broken controller must never stop the others.

local Controllers = script:WaitForChild("Controllers")

type Controller = {
	init: (() -> ())?,
	start: (() -> ())?,
}

local loaded: { [string]: Controller } = {}
local order: { string } = {}
for _, child in Controllers:GetChildren() do
	if child:IsA("ModuleScript") then
		local ok, result = pcall(require, child)
		if ok then
			loaded[child.Name] = result :: any
			table.insert(order, child.Name)
		else
			warn(`[SkipARock] {child.Name} failed to load: {result}`)
		end
	end
end
table.sort(order)

for _, name in order do
	local init = loaded[name].init
	if init then
		local ok, err = pcall(function()
			init()
		end)
		if not ok then
			warn(`[SkipARock] {name}.init failed: {err}`)
		end
	end
end

for _, name in order do
	local start = loaded[name].start
	if start then
		task.spawn(function()
			local ok, err = pcall(function()
				start()
			end)
			if not ok then
				warn(`[SkipARock] {name}.start failed: {err}`)
			end
		end)
	end
end

print("[SkipARock] client started")
]]></string>
        </Properties>
        <Item class="Folder" referent="56">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">Ambience</string>
              <string name="Source"><![CDATA[--!strict
-- The seaside's mood through the day. As dusk falls the lanterns and the
-- lighthouse light up, fireflies drift over the beach and the sea darkens;
-- by morning it all fades back. Now and then a fish jumps somewhere in the
-- bay and leaves a ring on the water.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local DayCycle = require(ReplicatedStorage.Shared.DayCycle)
local Palette = require(ReplicatedStorage.Shared.Palette)
local Tags = require(ReplicatedStorage.Shared.Tags)
local Audio = require(script.Parent.Audio)
local RockFx = require(script.Parent.RockFx)

local Ambience = {}

Ambience.LIGHTS_ON = 0.45 -- darkness at which lanterns come on

local WINDOW_NIGHT = Color3.fromRGB(255, 200, 120)

local lit: boolean? = nil

local function setLit(on: boolean)
	if lit == on then
		return
	end
	lit = on
	for _, light in CollectionService:GetTagged(Tags.NIGHT_LIGHT) do
		if light:IsA("Light") then
			light.Enabled = on
			local glass = light.Parent
			if glass and glass:IsA("BasePart") then
				glass.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
			end
		end
	end
	for _, flies in CollectionService:GetTagged(Tags.FIREFLIES) do
		if flies:IsA("ParticleEmitter") then
			flies.Enabled = on
		end
	end
	for _, window in CollectionService:GetTagged(Tags.WINDOW) do
		if window:IsA("BasePart") then
			window.Color = if on then WINDOW_NIGHT else Palette.window
			window.Material = if on then Enum.Material.Neon else Enum.Material.Glass
		end
	end
end

function Ambience.update()
	local darkness = DayCycle.darkness(Lighting.ClockTime)
	setLit(darkness >= Ambience.LIGHTS_ON)
	-- (each client tints its own view of the water)
	Workspace.Terrain.WaterColor = Palette.seaDay:Lerp(Palette.seaNight, darkness)
end

local function fishRise()
	local spot = Vector3.new((math.random() - 0.5) * 400, 0, 70 + math.random() * 250)
	RockFx.ripple(spot, 4 + math.random() * 3)
	if math.random() < 0.5 then
		Audio.at(spot, "water", 2.2 + math.random() * 0.4, 0.12)
	end
end

function Ambience.start()
	-- lanterns placed later (streaming, or a slow load) are caught next pass
	CollectionService:GetInstanceAddedSignal(Tags.NIGHT_LIGHT):Connect(function()
		lit = nil
	end)
	task.spawn(function()
		while true do
			task.wait(math.random(30, 80) / 10)
			fishRise()
		end
	end)
	while true do
		Ambience.update()
		task.wait(0.5)
	end
end

return Ambience
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">Audio</string>
              <string name="Source"><![CDATA[--!strict
-- Sound. Effects use clips that ship with every Roblox client
-- (rbxasset://sounds/...), so they always load and need no uploads; pitch and
-- layering turn a few clips into soft, distinct cues. Skips and splashes play
-- out on the lake where they happen. Optional music: Config.MUSIC_TRACKS.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local UI = require(script.Parent.Parent.Lib.UI)

local Audio = {}

-- Built-in client sounds (content/sounds in the Roblox install).
local CLIPS: { [string]: string } = {
	water = "rbxasset://sounds/impact_water.mp3",
	tick = "rbxasset://sounds/volume_slider.ogg",
	whoosh = "rbxasset://sounds/action_jump.mp3",
	thud = "rbxasset://sounds/action_jump_land.mp3",
}

-- A cue is one or more notes: { clip, speed, volume, delay }.
type Note = { clip: string, speed: number, volume: number, delay: number? }

local CUES: { [string]: { Note } } = {
	click = { { clip = "tick", speed = 1.2, volume = 0.35 } },
	open = { { clip = "tick", speed = 0.9, volume = 0.3 } },
	throw = { { clip = "whoosh", speed = 1.5, volume = 0.25 } },
	good = {
		{ clip = "tick", speed = 1.3, volume = 0.35 },
		{ clip = "tick", speed = 1.65, volume = 0.35, delay = 0.09 },
	},
	bad = { { clip = "tick", speed = 0.7, volume = 0.35 } },
	rare = {
		{ clip = "tick", speed = 1.4, volume = 0.4 },
		{ clip = "tick", speed = 1.75, volume = 0.4, delay = 0.09 },
		{ clip = "tick", speed = 2.1, volume = 0.45, delay = 0.18 },
	},
	pickup = {
		{ clip = "thud", speed = 1.9, volume = 0.35 },
		{ clip = "tick", speed = 1.6, volume = 0.35, delay = 0.06 },
	},
}

local templates: { [string]: Sound } = {}
local sfx: SoundGroup? = nil
local music: SoundGroup? = nil

local function newSound(clip: string): Sound?
	local template = templates[clip]
	if not template then
		return nil
	end
	return template:Clone()
end

local function playNote(note: Note)
	local sound = newSound(note.clip)
	if not sound then
		return
	end
	sound.PlaybackSpeed = note.speed
	sound.Volume = note.volume
	sound.SoundGroup = sfx
	sound.Parent = sfx
	sound:Play()
	task.delay(4, function()
		sound:Destroy()
	end)
end

-- Plays a cue on the player's own speakers (not in the world).
function Audio.play(cue: string)
	local notes = CUES[cue]
	if not notes then
		return
	end
	for _, note in notes do
		if note.delay then
			task.delay(note.delay, playNote, note)
		else
			playNote(note)
		end
	end
end

-- Plays a clip out in the world at `position` (heard louder up close).
function Audio.at(position: Vector3, clip: string, speed: number, volume: number)
	local sound = newSound(clip)
	if not sound then
		return
	end
	-- (Terrain sits at the origin, so an attachment's Position is world space)
	local anchor = Instance.new("Attachment")
	anchor.Name = "Sound"
	anchor.Position = position
	anchor.Parent = Workspace.Terrain
	sound.PlaybackSpeed = speed
	sound.Volume = volume
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 12
	sound.RollOffMaxDistance = 220
	sound.SoundGroup = sfx
	sound.Parent = anchor
	sound:Play()
	task.delay(3, function()
		anchor:Destroy()
	end)
end

-- One skip touching the water: a "plip" that rises in pitch as the hops shorten.
function Audio.skip(position: Vector3, index: number)
	Audio.at(position, "water", math.min(1.6 + index * 0.06, 2.8), 0.32)
end

-- The stone sinking (or a dive).
function Audio.splash(position: Vector3, big: boolean)
	Audio.at(position, "water", if big then 0.8 else 1.1, if big then 0.55 else 0.4)
end

local function startMusic(group: SoundGroup)
	local tracks = Config.MUSIC_TRACKS
	if #tracks == 0 then
		return
	end
	local sound = Instance.new("Sound")
	sound.Name = "Music"
	sound.Volume = 0.35
	sound.SoundGroup = group
	sound.Parent = group
	local index = math.random(1, #tracks)
	local function playNext()
		sound.SoundId = "rbxassetid://" .. tracks[index]
		index = index % #tracks + 1
		sound:Play()
	end
	sound.Ended:Connect(playNext)
	playNext()
end

function Audio.init()
	local effects = Instance.new("SoundGroup")
	effects.Name = "Effects"
	effects.Volume = 0.9
	effects.Parent = SoundService
	sfx = effects
	local tunes = Instance.new("SoundGroup")
	tunes.Name = "Music"
	tunes.Volume = 0.7
	tunes.Parent = SoundService
	music = tunes
	for name, id in CLIPS do
		local sound = Instance.new("Sound")
		sound.Name = name
		sound.SoundId = id
		templates[name] = sound
	end
	UI.onClick = function()
		Audio.play("click")
	end
end

function Audio.start()
	if music then
		startMusic(music)
	end
end

return Audio
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">ClientState</string>
              <string name="Source"><![CDATA[--!strict
-- The latest snapshot of this player's progress from the server, and
-- signals other controllers listen to. The client never decides anything
-- that matters; it just draws this.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DayCycle = require(ReplicatedStorage.Shared.DayCycle)
local Net = require(ReplicatedStorage.Shared.Net)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Types = require(ReplicatedStorage.Shared.Types)

local ClientState = {}

ClientState.changed = Signal.new() :: Signal.Signal<Types.Snapshot>
-- One of this player's own stones has finished skipping (fired by StoneFx).
ClientState.landed = Signal.new() :: Signal.Signal<Types.ThrowEvent>

local current: Types.Snapshot? = nil

function ClientState.get(): Types.Snapshot?
	return current
end

function ClientState.isNight(): boolean
	return DayCycle.isNightAt(Lighting.ClockTime)
end

function ClientState.localPlayer(): Player
	return Players.LocalPlayer
end

function ClientState.init()
	Net.listen("State", function(snapshot: Types.Snapshot)
		current = snapshot
		ClientState.changed:fire(snapshot)
	end)
end

function ClientState.start()
	Net.send("Ready")
end

return ClientState
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">DevPanel</string>
              <string name="Source"><![CDATA[--!strict
-- The test panel (Studio, and the game's owner in live games): a small
-- button in the corner that opens a few shortcuts for trying things out.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Types = require(ReplicatedStorage.Shared.Types)
local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.Parent.Lib.UI)

local DevPanel = {}

local ACTIONS: { { action: string, label: string } } = {
	{ action = "coins", label = "💰 Coins" },
	{ action = "strength", label = "💪 +10 strength" },
	{ action = "everything", label = "🪨 All rocks & isles" },
	{ action = "night", label = "🌙 Night" },
	{ action = "day", label = "☀️ Day" },
	{ action = "treasure", label = "✨ New treasure" },
	{ action = "reset", label = "🧽 Start over" },
}

local toggle: UI.Button? = nil

function DevPanel.init()
	local _, canvas = UI.screen("DevPanel", 30)
	local panel = UI.glass({
		Name = "Panel",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 58),
		Size = UDim2.fromOffset(196, 14 + #ACTIONS * 44),
		Visible = false,
		Parent = canvas,
	})
	UI.new("Frame", {
		Name = "Buttons",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = panel,
	}, { UI.list(Enum.FillDirection.Vertical, 6), UI.padding(8, 8) })
	local buttons = panel:FindFirstChild("Buttons") :: Frame
	for i, item in ACTIONS do
		UI.button({
			name = item.action,
			text = item.label,
			size = UDim2.new(1, 0, 0, 38),
			order = i,
			parent = buttons,
			onClick = function()
				Net.send("Dev", item.action)
			end,
		})
	end
	local button = UI.button({
		name = "Toggle",
		text = "🧪 Test",
		size = UDim2.fromOffset(100, 38),
		position = UDim2.new(1, -16, 0, 12),
		anchor = Vector2.new(1, 0),
		parent = canvas,
		onClick = function()
			panel.Visible = not panel.Visible
		end,
	})
	button.root.Visible = false
	toggle = button
	ClientState.changed:connect(function(snapshot: Types.Snapshot)
		local t = toggle
		if t then
			t.root.Visible = snapshot.isDev
		end
		if not snapshot.isDev then
			panel.Visible = false
		end
	end)
end

return DevPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- The heads-up display:
--   * coins, big at the top, with your coin multiplier and longest throw
--   * buttons down the left: Rocks, Upgrade (one tap buys a level), Rebirth
--     (glows when you can afford one) and the chase camera
--   * the power meter beside your character (on the beach and the piers):
--     a needle that swings while you wind up, with the gold zone and the
--     perfect line, and a hint under it
--   * the result of each throw once the rock sinks: coins and distance
--   * a big Throw button on touch screens

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Net = require(ReplicatedStorage.Shared.Net)
local RockData = require(ReplicatedStorage.Shared.Data.RockData)
local Skip = require(ReplicatedStorage.Shared.Skip)
local Types = require(ReplicatedStorage.Shared.Types)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Audio = require(script.Parent.Audio)
local ClientState = require(script.Parent.ClientState)
local Menu = require(script.Parent.Menu)
local RockFx = require(script.Parent.RockFx)
local ThrowInput = require(script.Parent.ThrowInput)
local UI = require(script.Parent.Parent.Lib.UI)

local Hud = {}

local T = UI.Theme
local METER_HEIGHT = 250
local METER_WIDTH = 30
local METER_X = 260 -- right of the screen's centre (clear of the messages)
local COIN_GOLD = Color3.fromRGB(255, 214, 92)

type Refs = {
	meter: Frame,
	needle: Frame,
	fill: Frame,
	hint: TextLabel,
	coins: TextLabel,
	details: TextLabel,
	upgrade: UI.Button,
	upgradeCost: TextLabel,
	rebirth: UI.Button,
	rocks: UI.Button,
	rockDot: Frame,
	camera: UI.Button,
	result: Frame,
	resultTitle: TextLabel,
	resultLine: TextLabel,
	flash: TextLabel,
	waking: Frame,
	throwButton: TextButton?,
}

local refs: Refs? = nil
local resultToken = 0
local flashToken = 0
local shownCoins = 0 -- the counter rolls up to the real number

-- ===== The power meter =====

local function band(
	parent: Instance,
	a: number,
	b: number,
	color: Color3,
	z: number,
	name: string
): Frame
	return UI.new("Frame", {
		Name = name,
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1 - a),
		Size = UDim2.fromScale(1, b - a),
		ZIndex = z,
		Parent = parent,
	}) :: Frame
end

local function buildMeter(canvas: Frame): (Frame, Frame, Frame)
	local meter = UI.new("Frame", {
		Name = "PowerMeter",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0.5, METER_X, 0.5, -10),
		Size = UDim2.fromOffset(METER_WIDTH + 70, METER_HEIGHT),
		Visible = false,
		Parent = canvas,
	}) :: Frame
	local track = UI.glass({
		Name = "Track",
		Size = UDim2.fromOffset(METER_WIDTH, METER_HEIGHT),
		ClipsDescendants = true,
		Parent = meter,
	})
	local inner = UI.new("Frame", {
		Name = "Bands",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = track,
	}, { UI.corner(16) }) :: Frame
	band(inner, 0, Skip.PLOP, UI.darken(T.waterDeep, 0.35), 1, "Plop")
	band(inner, Skip.PLOP, Skip.GOLD_LOW, T.waterDeep, 1, "Water")
	band(inner, Skip.GOLD_LOW, Skip.DIVE, T.gold, 1, "Gold")
	band(inner, Skip.SWEET - Skip.PERFECT, Skip.SWEET + Skip.PERFECT, T.perfect, 2, "Perfect")
	band(inner, Skip.DIVE, 1, T.coral, 1, "Dive")
	local fill = UI.new("Frame", {
		Name = "Fill",
		BackgroundColor3 = T.white,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0),
		ZIndex = 3,
		Parent = inner,
	}) :: Frame
	-- the needle sticks out to the right of the bar
	local needle = UI.new("Frame", {
		Name = "Needle",
		BackgroundColor3 = T.white,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromOffset(METER_WIDTH + 12, 4),
		ZIndex = 4,
		Parent = meter,
	}, { UI.round(), UI.stroke(T.glass, 1.5, 0.3) }) :: Frame
	-- little labels for the zones
	UI.text({
		text = "too hard",
		size = UDim2.fromOffset(64, 16),
		position = UDim2.new(0, METER_WIDTH + 8, 1 - (1 + Skip.DIVE) / 2, 0),
		anchor = Vector2.new(0, 0.5),
		color = T.coral,
		font = UI.BodyFont,
		maxTextSize = 13,
		align = Enum.TextXAlignment.Left,
		shadow = true,
		parent = meter,
	})
	UI.text({
		text = "sweet spot",
		size = UDim2.fromOffset(70, 16),
		position = UDim2.new(0, METER_WIDTH + 8, 1 - Skip.SWEET, 0),
		anchor = Vector2.new(0, 0.5),
		color = T.perfect,
		font = UI.BodyFont,
		maxTextSize = 13,
		align = Enum.TextXAlignment.Left,
		shadow = true,
		parent = meter,
	})
	return meter, needle, fill
end

-- A square button down the left side: an emoji over a caption.
local function sideButton(
	canvas: Frame,
	name: string,
	emoji: string,
	caption: string,
	order: number,
	onClick: () -> ()
): UI.Button
	local button = UI.button({
		name = name,
		text = "",
		size = UDim2.fromOffset(88, 76),
		position = UDim2.new(0, 16, 0, 64 + (order - 1) * 84),
		parent = canvas,
		onClick = onClick,
	})
	button.label.Visible = false
	UI.text({
		name = "Icon",
		text = emoji,
		size = UDim2.new(1, -10, 0, 34),
		position = UDim2.fromOffset(5, 6),
		maxTextSize = 30,
		parent = button.root,
	})
	UI.text({
		name = "Caption",
		text = caption,
		size = UDim2.new(1, -8, 0, 22),
		position = UDim2.fromOffset(4, 44),
		font = UI.BodyFont,
		maxTextSize = 16,
		parent = button.root,
	})
	return button
end

local function build()
	local _, canvas = UI.screen("Hud", 5)
	local meter, needle, fill = buildMeter(canvas)

	-- coins, top centre
	local coinPill = UI.glass({
		Name = "CoinPill",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(320, 76),
		Parent = canvas,
	})
	local coins = UI.text({
		name = "Coins",
		text = "🪙 0",
		size = UDim2.new(1, -20, 0, 44),
		position = UDim2.fromOffset(10, 4),
		color = COIN_GOLD,
		maxTextSize = 40,
		shadow = true,
		parent = coinPill,
	})
	local details = UI.text({
		name = "Details",
		text = "",
		size = UDim2.new(1, -20, 0, 22),
		position = UDim2.fromOffset(10, 48),
		font = UI.BodyFont,
		maxTextSize = 16,
		parent = coinPill,
	})

	-- buttons down the left
	local rocks = sideButton(canvas, "Rocks", "🪨", "Rocks", 1, function()
		Menu.open("Rocks")
	end)
	local rockDot = UI.new("Frame", {
		Name = "Dot",
		BackgroundColor3 = T.white,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -6, 0, 6),
		Size = UDim2.fromOffset(18, 13),
		Parent = rocks.root,
	}, { UI.new("UICorner", { CornerRadius = UDim.new(0.5, 0) }), UI.stroke(T.white, 1.5, 0.3) }) :: Frame
	local upgrade = sideButton(canvas, "Upgrade", "💪", "Upgrade", 2, function()
		Net.send("Upgrade", 1)
	end)
	local upgradeCost = UI.text({
		name = "Cost",
		text = "",
		size = UDim2.fromOffset(110, 22),
		position = UDim2.new(1, 8, 0.5, 0),
		anchor = Vector2.new(0, 0.5),
		color = COIN_GOLD,
		font = UI.BodyFont,
		align = Enum.TextXAlignment.Left,
		maxTextSize = 17,
		shadow = true,
		parent = upgrade.root,
	})
	local rebirth = sideButton(canvas, "Rebirth", "🔁", "Rebirth", 3, function()
		Menu.open("Rebirth")
	end)
	local camera = sideButton(canvas, "Camera", "🎥", "Chase cam", 4, function()
		RockFx.chaseEnabled = not RockFx.chaseEnabled
		if not RockFx.chaseEnabled then
			RockFx.stopChase()
		end
	end)

	local hint = UI.text({
		name = "Hint",
		text = "",
		size = UDim2.fromOffset(420, 26),
		position = UDim2.new(0.5, 0, 1, -118),
		anchor = Vector2.new(0.5, 1),
		font = UI.BodyFont,
		maxTextSize = 20,
		shadow = true,
		parent = canvas,
	})

	-- a quick word right after letting go ("Perfect!")
	local flash = UI.text({
		name = "Flash",
		text = "",
		size = UDim2.fromOffset(240, 40),
		position = UDim2.new(0.5, METER_X + METER_WIDTH / 2, 0.5, -METER_HEIGHT / 2 - 40),
		anchor = Vector2.new(0.5, 0.5),
		color = T.perfect,
		maxTextSize = 34,
		shadow = true,
		parent = canvas,
	})
	flash.TextTransparency = 1

	-- the result of your throw, upper middle
	local result = UI.new("Frame", {
		Name = "Result",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(520, 90),
		Visible = false,
		Parent = canvas,
	}) :: Frame
	local resultTitle = UI.text({
		name = "Title",
		text = "",
		size = UDim2.new(1, 0, 0, 56),
		color = COIN_GOLD,
		maxTextSize = 52,
		shadow = true,
		parent = result,
	})
	local resultLine = UI.text({
		name = "Line",
		text = "",
		size = UDim2.new(1, 0, 0, 28),
		position = UDim2.fromOffset(0, 60),
		font = UI.BodyFont,
		maxTextSize = 22,
		shadow = true,
		parent = result,
	})

	local waking = UI.glass({
		Name = "Waking",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(380, 56),
		Parent = canvas,
	})
	UI.text({
		text = "The tide is coming in…",
		size = UDim2.new(1, -24, 1, -14),
		position = UDim2.fromScale(0.5, 0.5),
		anchor = Vector2.new(0.5, 0.5),
		maxTextSize = 26,
		parent = waking,
	})

	-- the Throw button on touch screens (hold it like the mouse button)
	local throwButton: TextButton? = nil
	if UserInputService.TouchEnabled then
		local button = UI.new("TextButton", {
			Name = "Throw",
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = T.glass,
			BackgroundTransparency = UI.GLASS,
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -150, 1, -60),
			Size = UDim2.fromOffset(110, 110),
			Visible = false,
			Parent = canvas,
		}, { UI.round(), UI.stroke(T.white, 2, 0.5) }) :: TextButton
		UI.text({
			text = "🪨\nThrow",
			size = UDim2.fromScale(0.8, 0.7),
			position = UDim2.fromScale(0.5, 0.5),
			anchor = Vector2.new(0.5, 0.5),
			maxTextSize = 24,
			parent = button,
		})
		button.InputBegan:Connect(function(input: InputObject)
			if
				input.UserInputType == Enum.UserInputType.Touch
				or input.UserInputType == Enum.UserInputType.MouseButton1
			then
				ThrowInput.press(input)
			end
		end)
		button.InputEnded:Connect(function(input: InputObject)
			if
				input.UserInputType == Enum.UserInputType.Touch
				or input.UserInputType == Enum.UserInputType.MouseButton1
			then
				ThrowInput.letGo()
			end
		end)
		throwButton = button
	end

	refs = {
		meter = meter,
		needle = needle,
		fill = fill,
		hint = hint,
		coins = coins,
		details = details,
		upgrade = upgrade,
		upgradeCost = upgradeCost,
		rebirth = rebirth,
		rocks = rocks,
		rockDot = rockDot,
		camera = camera,
		result = result,
		resultTitle = resultTitle,
		resultLine = resultLine,
		flash = flash,
		waking = waking,
		throwButton = throwButton,
	}
end

-- ===== Updating =====

local function howToThrow(): string
	if UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
		return "Hold R2 to wind up, let go in the gold"
	elseif UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		return "Hold Throw to wind up, let go in the gold"
	end
	return "Hold click to wind up, let go in the gold"
end

local function frame(dt: number)
	local r = refs
	if not r then
		return
	end
	ThrowInput.update()
	local state = ThrowInput.state
	r.waking.Visible = Players.LocalPlayer.Character == nil
	local near = state.charging or state.status ~= "far"
	r.meter.Visible = near
	if r.throwButton then
		r.throwButton.Visible = near
	end
	local power = ThrowInput.power()
	r.needle.Position = UDim2.new(0, -6, 1 - power, 0)
	r.fill.Size = UDim2.fromScale(1, power)
	r.needle.Visible = state.charging
	local snapshot = ClientState.get()
	if state.charging then
		r.hint.Text = ""
	elseif state.status == "ok" then
		local newcomer = not snapshot or snapshot.throws < 5
		r.hint.Text = if ThrowInput.coolingDown() or not newcomer then "" else howToThrow()
	elseif state.status == "high" then
		r.hint.Text = "Climb down to throw"
	else
		local newcomer = not snapshot or snapshot.throws < 1
		r.hint.Text = if newcomer and Players.LocalPlayer.Character
			then "Walk down to the beach to skip a rock"
			else ""
	end
	-- the coin counter rolls up smoothly to the real number
	local target = if snapshot then snapshot.coins else 0
	if shownCoins ~= target then
		local step = (target - shownCoins) * math.min(dt * 8, 1)
		shownCoins = if math.abs(target - shownCoins) < 1 then target else shownCoins + step
		r.coins.Text = "🪙 " .. Format.short(shownCoins)
	end
	r.camera.root.BackgroundTransparency = if RockFx.chaseEnabled then UI.GLASS else 0.65
end

local function showState(snapshot: Types.Snapshot)
	local r = refs
	if not r then
		return
	end
	local rock = RockData.get(snapshot.equipped) or RockData.get(RockData.STARTER)
	if rock then
		r.rockDot.BackgroundColor3 = UI.rgb(rock.color)
	end
	local multiplier = Format.times(snapshot.coinMultiplier)
	local best = if snapshot.bestDistance > 0
		then ` · Longest {Format.distance(snapshot.bestDistance)}`
		else ""
	r.details.Text = `{multiplier} coins{best}`
	r.upgradeCost.Text = "🪙 " .. Format.short(snapshot.strengthCost)
	local canUpgrade = snapshot.coins >= snapshot.strengthCost
	UI.setButton(r.upgrade, { color = if canUpgrade then T.good else T.glass })
	r.upgrade.root.BackgroundTransparency = if canUpgrade then 0.1 else UI.GLASS
	local canRebirth = snapshot.coins >= snapshot.rebirthCost
	UI.setButton(r.rebirth, { color = if canRebirth then T.dusk else T.glass })
	r.rebirth.root.BackgroundTransparency = if canRebirth then 0.05 else UI.GLASS
end

local function flashWord(text: string, color: Color3)
	local r = refs
	if not r then
		return
	end
	flashToken += 1
	local token = flashToken
	r.flash.Text = text
	r.flash.TextColor3 = color
	r.flash.TextTransparency = 0
	UI.pop(r.flash, 0.7)
	task.delay(0.9, function()
		if token == flashToken then
			UI.tween(r.flash, UI.SOFT, { TextTransparency = 1 })
		end
	end)
end

-- How a finished throw reads to the player who threw it.
function Hud.describe(event: Types.ThrowEvent): (string, string)
	if event.verdict == "plop" then
		return "Plop.", "Too gentle. Hold a little longer"
	elseif event.verdict == "dive" then
		return "Sploosh!", "Too hard, it dove straight in"
	end
	local lines: { string } = {}
	if event.newBest then
		table.insert(lines, "New record!")
	end
	table.insert(lines, Format.distance(event.distance))
	table.insert(lines, if event.skips == 1 then "1 skip" else `{event.skips} skips`)
	if event.perfect then
		table.insert(lines, "Perfect!")
	end
	return `+{Format.short(event.coins)} 🪙`, table.concat(lines, " · ")
end

local function showResult(event: Types.ThrowEvent)
	local r = refs
	if not r then
		return
	end
	local title, line = Hud.describe(event)
	resultToken += 1
	local token = resultToken
	r.resultTitle.Text = title
	r.resultLine.Text = line
	r.resultTitle.TextColor3 = if event.verdict == "skips" then COIN_GOLD else T.white
	r.resultTitle.TextTransparency = 0
	r.resultLine.TextTransparency = 0
	r.result.Visible = true
	UI.pop(r.result, 0.8)
	if event.newBest and event.skips > 0 then
		Audio.play("rare")
	elseif event.skips >= 10 then
		Audio.play("good")
	end
	task.delay(2.6, function()
		if token ~= resultToken then
			return
		end
		UI.tween(r.resultTitle, UI.SOFT, { TextTransparency = 1 })
		UI.tween(r.resultLine, UI.SOFT, { TextTransparency = 1 })
		task.delay(0.4, function()
			if token == resultToken then
				r.result.Visible = false
			end
		end)
	end)
end

function Hud.init()
	build()
	ClientState.changed:connect(showState)
	ClientState.landed:connect(showResult)
	ThrowInput.released:connect(function(power: number)
		if Skip.isPerfect(power) then
			flashWord("Perfect!", T.perfect)
		elseif power >= Skip.DIVE then
			flashWord("Too hard!", T.coral)
		end
	end)
end

function Hud.start()
	RunService.RenderStepped:Connect(frame)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">Menu</string>
              <string name="Source"><![CDATA[--!strict
-- The menu (press M, tap a button on the left, or walk up to a shop):
--   Rocks     buy rocks and pick which one to throw
--   Upgrades  arm strength: +1, +10 or as many as you can afford
--   Rebirth   start over stronger (what you keep, what resets)
--   Islands   how far each island is and the bonus it gives
--   Goals     little things to aim for

local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Economy = require(ReplicatedStorage.Shared.Economy)
local GoalData = require(ReplicatedStorage.Shared.Data.GoalData)
local IslandData = require(ReplicatedStorage.Shared.Data.IslandData)
local Net = require(ReplicatedStorage.Shared.Net)
local RockData = require(ReplicatedStorage.Shared.Data.RockData)
local Types = require(ReplicatedStorage.Shared.Types)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Audio = require(script.Parent.Audio)
local ClientState = require(script.Parent.ClientState)
local UI = require(script.Parent.Parent.Lib.UI)

local Menu = {}

export type Tab = "Rocks" | "Upgrades" | "Rebirth" | "Islands" | "Goals"
local TABS: { Tab } = { "Rocks", "Upgrades", "Rebirth", "Islands", "Goals" }

local T = UI.Theme
local PANEL = Vector2.new(800, 510)
local COIN = Color3.fromRGB(206, 150, 20)

local panel: Frame? = nil
local body: Frame? = nil
local tabButtons: { [Tab]: UI.Button } = {}
local current: Tab = "Rocks"
local isOpen = false
local rebirthArmedAt = -math.huge

local function clear(frame: Frame)
	for _, child in frame:GetChildren() do
		child:Destroy()
	end
end

local function statsOf(snapshot: Types.Snapshot): Economy.Stats
	return {
		strength = snapshot.strength,
		rebirths = snapshot.rebirths,
		equipped = snapshot.equipped,
		islands = snapshot.islands,
	}
end

-- A progress bar (0..1) in `parent`.
local function bar(
	parent: Instance,
	progress: number,
	color: Color3,
	size: UDim2,
	position: UDim2
): Frame
	local track = UI.new("Frame", {
		Name = "Bar",
		BackgroundColor3 = T.paperDark,
		BorderSizePixel = 0,
		Size = size,
		Position = position,
		Parent = parent,
	}, { UI.round() }) :: Frame
	UI.new("Frame", {
		Name = "Fill",
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(math.clamp(progress, 0, 1), 1),
		Parent = track,
	}, { UI.round() })
	return track
end

-- ===== Rocks =====

local function rockCard(rock: RockData.Rock, snapshot: Types.Snapshot, order: number): Frame
	local owned = snapshot.rocks[rock.id] == true
	local inHand = snapshot.equipped == rock.id
	local unlocked = Economy.rockUnlocked(rock, snapshot.islands)
	local affordable = snapshot.coins >= rock.price
	local rarityColor = UI.rgb(RockData.rarityInfo(rock.rarity).color)
	local card = UI.new("Frame", {
		Name = rock.id,
		BackgroundColor3 = if inHand then UI.lighten(T.gold, 0.7) else T.card,
		BorderSizePixel = 0,
		LayoutOrder = order,
	}, {
		UI.corner(14),
		UI.stroke(if inHand then T.gold else T.line, if inHand then 3 else 2),
	}) :: Frame
	local swatch = UI.new("Frame", {
		Name = "Swatch",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(52, 30),
		BackgroundColor3 = if unlocked then UI.rgb(rock.color) else T.paperDark,
		BorderSizePixel = 0,
		Parent = card,
	}, { UI.new("UICorner", { CornerRadius = UDim.new(0.5, 0) }) }) :: Frame
	if not unlocked then
		UI.body({ text = "🔒", size = UDim2.fromScale(1, 1), maxTextSize = 20, parent = swatch })
	end
	UI.body({
		name = "Title",
		text = rock.name,
		size = UDim2.new(1, -10, 0, 18),
		position = UDim2.fromOffset(5, 40),
		font = UI.Font,
		maxTextSize = 16,
		parent = card,
	})
	UI.body({
		name = "Power",
		text = `{rock.rarity} · {Format.times(rock.power)} distance`,
		size = UDim2.new(1, -10, 0, 15),
		position = UDim2.fromOffset(5, 58),
		color = rarityColor,
		maxTextSize = 12,
		parent = card,
	})
	local label: string
	local color: Color3
	local enabled = true
	if inHand then
		label, color, enabled = "In hand", T.good, false
	elseif owned then
		label, color = "Equip", T.water
	elseif not unlocked then
		local island = if rock.island then IslandData.get(rock.island) else nil
		label, color, enabled = `Reach {if island then island.name else "?"}`, T.inkSoft, false
	else
		label = "🪙 " .. Format.short(rock.price)
		color = if affordable then T.good else T.inkSoft
		enabled = affordable
	end
	local button = UI.button({
		name = "Action",
		text = label,
		size = UDim2.new(1, -16, 0, 26),
		position = UDim2.new(0, 8, 1, -32),
		color = color,
		parent = card,
		onClick = function()
			if owned then
				Net.send("Equip", rock.id)
			else
				Net.send("BuyRock", rock.id)
			end
		end,
	})
	UI.setButton(button, { enabled = enabled })
	return card
end

local function showRocks(frame: Frame, snapshot: Types.Snapshot)
	local grid = UI.new("Frame", {
		Name = "Grid",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, -40),
		Parent = frame,
	}, { UI.grid(Vector2.new(178, 108), 10) }) :: Frame
	for i, rock in RockData.LIST do
		rockCard(rock, snapshot, i).Parent = grid
	end
	local held = Economy.rockOf(statsOf(snapshot))
	UI.body({
		name = "About",
		text = `{held.name}: {held.blurb}`,
		size = UDim2.new(1, -20, 0, 32),
		position = UDim2.new(0, 10, 1, -34),
		font = UI.LightFont,
		maxTextSize = 15,
		parent = frame,
	})
end

-- ===== Upgrades =====

local function costOf(level: number, count: number): number
	local total = 0
	for i = 0, count - 1 do
		total += Economy.strengthCost(level + i)
	end
	return total
end

local function showUpgrades(frame: Frame, snapshot: Types.Snapshot)
	local level = snapshot.strength
	UI.body({
		text = "💪 Arm Strength",
		size = UDim2.new(1, 0, 0, 40),
		position = UDim2.fromOffset(0, 10),
		font = UI.Font,
		maxTextSize = 34,
		parent = frame,
	})
	UI.body({
		name = "Level",
		text = `Level {level} · throws {Format.times(Economy.strengthPower(level))} as far`,
		size = UDim2.new(1, 0, 0, 26),
		position = UDim2.fromOffset(0, 56),
		color = T.inkSoft,
		maxTextSize = 20,
		parent = frame,
	})
	UI.body({
		text = `Each level throws {math.floor((Economy.STRENGTH_STEP - 1) * 100 + 0.5)}% further. Strength resets when you rebirth.`,
		size = UDim2.new(1, -60, 0, 22),
		position = UDim2.fromOffset(30, 88),
		font = UI.LightFont,
		maxTextSize = 16,
		parent = frame,
	})
	local row = UI.new("Frame", {
		Name = "Buttons",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 140),
		Size = UDim2.fromOffset(660, 150),
		Parent = frame,
	}, { UI.list(Enum.FillDirection.Horizontal, 20) }) :: Frame
	local options: { { label: string, count: number } } = {
		{ label = "+1 level", count = 1 },
		{ label = "+10 levels", count = 10 },
		{ label = "Max", count = 100 },
	}
	for i, option in options do
		local count = option.count
		local cost = costOf(level, count)
		local affordable = snapshot.coins >= Economy.strengthCost(level)
		local card = UI.new("Frame", {
			Name = "Option" .. i,
			BackgroundColor3 = T.card,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(200, 150),
			LayoutOrder = i,
			Parent = row,
		}, { UI.corner(16), UI.stroke(T.line, 2) }) :: Frame
		UI.body({
			text = option.label,
			size = UDim2.new(1, -16, 0, 34),
			position = UDim2.fromOffset(8, 12),
			font = UI.Font,
			maxTextSize = 26,
			parent = card,
		})
		UI.body({
			name = "Cost",
			text = if count >= 100
				then "as many as you can afford"
				else "🪙 " .. Format.short(cost),
			size = UDim2.new(1, -16, 0, 24),
			position = UDim2.fromOffset(8, 52),
			color = if count >= 100 then T.inkSoft else COIN,
			maxTextSize = if count >= 100 then 15 else 22,
			parent = card,
		})
		local button = UI.button({
			name = "Buy",
			text = "Buy",
			size = UDim2.new(1, -24, 0, 40),
			position = UDim2.new(0, 12, 1, -52),
			color = if affordable then T.good else T.inkSoft,
			parent = card,
			onClick = function()
				Net.send("Upgrade", count)
			end,
		})
		UI.setButton(button, { enabled = affordable })
	end
	UI.body({
		text = `You have 🪙 {Format.short(snapshot.coins)} · next level 🪙 {Format.short(
			snapshot.strengthCost
		)}`,
		size = UDim2.new(1, 0, 0, 26),
		position = UDim2.new(0, 0, 1, -40),
		color = COIN,
		maxTextSize = 20,
		parent = frame,
	})
end

-- ===== Rebirth =====

local function showRebirth(frame: Frame, snapshot: Types.Snapshot)
	local cost = snapshot.rebirthCost
	local ready = snapshot.coins >= cost
	UI.body({
		text = `🔁 Rebirth {snapshot.rebirths + 1}`,
		size = UDim2.new(1, 0, 0, 44),
		position = UDim2.fromOffset(0, 8),
		font = UI.Font,
		maxTextSize = 36,
		parent = frame,
	})
	local now = statsOf(snapshot)
	local after = table.clone(now)
	after.rebirths += 1
	local lines = {
		`✅ Every throw pays {Format.times(Economy.coinMultiplier(after))} coins (now {Format.times(
			Economy.coinMultiplier(now)
		)})`,
		`✅ Rocks fly {Format.times(Economy.rebirthPower(after.rebirths))} as far`,
		"✅ You keep every rock and island",
		"↩️ Your coins and arm strength go back to zero",
	}
	for i, line in lines do
		UI.body({
			text = line,
			size = UDim2.new(1, -80, 0, 30),
			position = UDim2.fromOffset(40, 60 + (i - 1) * 34),
			align = Enum.TextXAlignment.Left,
			maxTextSize = 20,
			color = if i == 4 then T.inkSoft else T.ink,
			parent = frame,
		})
	end
	bar(
		frame,
		snapshot.coins / cost,
		if ready then T.good else T.gold,
		UDim2.new(1, -80, 0, 18),
		UDim2.fromOffset(40, 210)
	)
	UI.body({
		name = "Progress",
		text = `🪙 {Format.short(snapshot.coins)} / {Format.short(cost)}`,
		size = UDim2.new(1, 0, 0, 24),
		position = UDim2.fromOffset(0, 234),
		color = COIN,
		maxTextSize = 20,
		parent = frame,
	})
	local armed = os.clock() - rebirthArmedAt < 3
	local button = UI.button({
		name = "RebirthButton",
		text = if not ready
			then "Not enough coins yet"
			elseif armed then "Tap again to rebirth"
			else "Rebirth",
		size = UDim2.fromOffset(300, 54),
		position = UDim2.new(0.5, 0, 0, 280),
		anchor = Vector2.new(0.5, 0),
		color = if armed then T.coral else T.dusk,
		parent = frame,
		onClick = function()
			-- two taps, so nobody rebirths by accident
			if os.clock() - rebirthArmedAt < 3 and os.clock() - rebirthArmedAt > 0.4 then
				rebirthArmedAt = -math.huge
				Net.send("Rebirth")
			else
				rebirthArmedAt = os.clock()
			end
			Menu.render()
		end,
	})
	UI.setButton(button, { enabled = ready })
end

-- ===== Islands =====

local function showIslands(frame: Frame, snapshot: Types.Snapshot)
	local scroll = UI.new("ScrollingFrame", {
		Name = "List",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = T.inkSoft,
		Parent = frame,
	}, { UI.list(Enum.FillDirection.Vertical, 8), UI.padding(6, 4) }) :: ScrollingFrame
	for i, island in IslandData.LIST do
		local reached = snapshot.islands[island.id] == true
		local row = UI.new("Frame", {
			Name = island.id,
			BackgroundColor3 = if reached then UI.lighten(T.sage, 0.75) else T.card,
			BorderSizePixel = 0,
			Size = UDim2.new(1, -16, 0, 50),
			LayoutOrder = i,
			Parent = scroll,
		}, { UI.corner(12), UI.stroke(T.line, 1.5) }) :: Frame
		UI.body({
			text = (if reached then "🏝️ " else "🌊 ") .. island.name,
			size = UDim2.new(0.42, 0, 0, 24),
			position = UDim2.fromOffset(14, 13),
			align = Enum.TextXAlignment.Left,
			maxTextSize = 19,
			parent = row,
		})
		UI.body({
			text = `{Format.distance(island.distance)} · +{math.floor(island.bonus * 100 + 0.5)}% coins`,
			size = UDim2.new(0.3, 0, 0, 20),
			position = UDim2.new(0.42, 0, 0, 15),
			color = T.inkSoft,
			maxTextSize = 16,
			parent = row,
		})
		if reached then
			UI.body({
				text = "✓",
				size = UDim2.fromOffset(40, 30),
				position = UDim2.new(1, -50, 0, 10),
				color = T.good,
				font = UI.Font,
				maxTextSize = 26,
				parent = row,
			})
		else
			-- progress on a log scale, so far-off islands still show movement
			local progress = math.log10(1 + snapshot.bestDistance) / math.log10(1 + island.distance)
			bar(row, progress, T.water, UDim2.new(0.22, 0, 0, 12), UDim2.new(0.75, 0, 0, 19))
		end
	end
end

-- ===== Goals =====

local function showGoals(frame: Frame, snapshot: Types.Snapshot)
	local rocks = 0
	for _, owned in snapshot.rocks do
		if owned then
			rocks += 1
		end
	end
	local stats: GoalData.Stats = {
		bestSkips = snapshot.bestSkips,
		bestDistance = snapshot.bestDistance,
		perfects = snapshot.perfects,
		rocks = rocks,
		rebirths = snapshot.rebirths,
		throws = snapshot.throws,
		totalCoins = snapshot.totalCoins,
	}
	local scroll = UI.new("ScrollingFrame", {
		Name = "List",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = T.inkSoft,
		Parent = frame,
	}, { UI.list(Enum.FillDirection.Vertical, 8), UI.padding(6, 4) }) :: ScrollingFrame
	local done = 0
	for i, goal in GoalData.GOALS do
		local finished = snapshot.goals[goal.id] == true
		if finished then
			done += 1
		end
		local value = GoalData.progress(goal, stats)
		local progress = if goal.kind == "distance" or goal.kind == "coins"
			then math.log10(1 + value) / math.log10(1 + goal.value)
			else value / goal.value
		local row = UI.new("Frame", {
			Name = goal.id,
			BackgroundColor3 = if finished then UI.lighten(T.sage, 0.75) else T.card,
			BorderSizePixel = 0,
			Size = UDim2.new(1, -16, 0, 44),
			LayoutOrder = if finished then 100 + i else i,
			Parent = scroll,
		}, { UI.corner(12), UI.stroke(T.line, 1.5) }) :: Frame
		UI.body({
			text = goal.emoji,
			size = UDim2.fromOffset(32, 32),
			position = UDim2.fromOffset(8, 6),
			font = UI.Font,
			maxTextSize = 22,
			parent = row,
		})
		UI.body({
			text = goal.text,
			size = UDim2.new(1, -230, 0, 24),
			position = UDim2.fromOffset(48, 10),
			align = Enum.TextXAlignment.Left,
			maxTextSize = 18,
			parent = row,
		})
		bar(
			row,
			if finished then 1 else progress,
			if finished then T.good else T.water,
			UDim2.fromOffset(110, 12),
			UDim2.new(1, -170, 0.5, -6)
		)
		UI.body({
			text = if finished then "✓" else `{math.floor(math.clamp(progress, 0, 1) * 100)}%`,
			size = UDim2.fromOffset(48, 24),
			position = UDim2.new(1, -54, 0.5, -12),
			color = if finished then T.good else T.inkSoft,
			font = UI.Font,
			maxTextSize = 18,
			parent = row,
		})
	end
	local header = UI.body({
		text = `{done} of {#GoalData.GOALS} goals done · {Format.commas(snapshot.throws)} rocks skipped`,
		size = UDim2.new(1, -16, 0, 24),
		color = T.inkSoft,
		maxTextSize = 16,
		parent = scroll,
	})
	header.LayoutOrder = -1
end

-- ===== Panel =====

function Menu.render()
	local frame = body
	local snapshot = ClientState.get()
	if not frame or not snapshot or not isOpen then
		return
	end
	clear(frame)
	if current == "Rocks" then
		showRocks(frame, snapshot)
	elseif current == "Upgrades" then
		showUpgrades(frame, snapshot)
	elseif current == "Rebirth" then
		showRebirth(frame, snapshot)
	elseif current == "Islands" then
		showIslands(frame, snapshot)
	else
		showGoals(frame, snapshot)
	end
	for tab, button in tabButtons do
		UI.setButton(button, { color = if tab == current then T.waterDeep else T.inkSoft })
	end
end

function Menu.isOpen(): boolean
	return isOpen
end

function Menu.current(): Tab
	return current
end

function Menu.open(tab: Tab?)
	local frame = panel
	if not frame then
		return
	end
	current = tab or current
	if not isOpen then
		isOpen = true
		frame.Visible = true
		UI.pop(frame, 0.9)
		Audio.play("open")
	end
	Menu.render()
end

function Menu.close()
	local frame = panel
	if not frame or not isOpen then
		return
	end
	isOpen = false
	frame.Visible = false
end

function Menu.toggle()
	if isOpen then
		Menu.close()
	else
		Menu.open()
	end
end

local function build()
	local _, canvas = UI.screen("Menu", 10)
	local frame = UI.paper({
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(PANEL.X, PANEL.Y),
		Visible = false,
		Parent = canvas,
	})
	local tabs = UI.new("Frame", {
		Name = "Tabs",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(18, 14),
		Size = UDim2.new(1, -90, 0, 38),
		Parent = frame,
	}, { UI.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left) }) :: Frame
	for i, name in TABS do
		local tab: Tab = name :: Tab
		tabButtons[tab] = UI.button({
			name = tab,
			text = tab,
			size = UDim2.fromOffset(126, 38),
			color = T.inkSoft,
			order = i,
			parent = tabs,
			onClick = function()
				current = tab
				Menu.render()
			end,
		})
	end
	UI.button({
		name = "Close",
		text = "✕",
		size = UDim2.fromOffset(40, 38),
		position = UDim2.new(1, -16, 0, 14),
		anchor = Vector2.new(1, 0),
		color = T.coral,
		parent = frame,
		onClick = Menu.close,
	})
	body = UI.new("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(18, 64),
		Size = UDim2.new(1, -36, 1, -80),
		Parent = frame,
	}) :: Frame
	panel = frame
end

function Menu.init()
	build()
	ClientState.changed:connect(function()
		Menu.render()
	end)
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.M or input.KeyCode == Enum.KeyCode.ButtonY then
			Menu.toggle()
		elseif input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			Menu.close()
		end
	end)
	-- the shops on the boardwalk open their tab
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt)
		local tab = prompt:GetAttribute("Menu")
		if type(tab) == "string" and table.find(TABS, tab :: any) then
			Menu.open(tab :: Tab)
		end
	end)
end

return Menu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">RockFx</string>
              <string name="Source"><![CDATA[--!strict
-- Draws every throw out at sea, the same way on every screen: the rock arcs
-- from the thrower's hand to the water, then skips hop after hop (each one
-- shorter and quicker), leaving a ring on the water, a little splash and a
-- "plip" that rises in pitch at every touch, until it sinks far out at sea.
-- Distances use the sea's squeezed scale (see Sea), so huge throws still
-- land on the map, and long flights are sped up to finish in a few seconds.
--
-- For your own throws a chase camera follows the rock out to sea (it stops
-- following once the rock is very far out, and watches it go). Click or
-- press throw to skip it; the 🎥 button turns it off.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Net = require(ReplicatedStorage.Shared.Net)
local RockModel = require(ReplicatedStorage.Shared.RockModel)
local Sea = require(ReplicatedStorage.Shared.Sea)
local Types = require(ReplicatedStorage.Shared.Types)
local Format = require(ReplicatedStorage.Shared.Util.Format)
local Audio = require(script.Parent.Audio)
local ClientState = require(script.Parent.ClientState)

local RockFx = {}

RockFx.MAX_RIPPLES = 60
RockFx.MAX_FLIGHTS = 12 -- older rocks sink at once if more fly together
RockFx.MAX_FLIGHT_SECONDS = 6.5 -- long throws are sped up to fit
RockFx.CHASE_MIN = 60 -- map studs: shorter throws aren't worth chasing
RockFx.CHASE_MAX = 2600 -- the camera stops following this far out from the thrower
RockFx.CHASE_LINGER = 1.4 -- seconds to watch the splash before coming back
RockFx.chaseEnabled = true

type Segment = {
	from: Vector3,
	to: Vector3,
	height: number,
	duration: number,
	touch: boolean, -- a skip on the water as this segment starts
	index: number,
}

type Flight = {
	event: Types.ThrowEvent,
	rock: BasePart,
	segments: { Segment },
	current: number,
	segmentStart: number,
	spin: number,
	chase: boolean,
}

local folder: Folder? = nil
local splashEmitter: ParticleEmitter? = nil
local splashAnchor: Part? = nil
local flights: { Flight } = {}
local ripples: { Part } = {}
local nextRipple = 1
local chasing: Flight? = nil
local chaseEndsAt = math.huge
local chaseHold: Vector3? = nil -- where the camera stopped following

local RIPPLE_GROW = TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- ===== Water effects =====

local RIPPLE_PIXELS = 24 -- per stud
local RIPPLE_LINE = 4 -- pixels

local function newRipple(parent: Instance): Part
	local part = Instance.new("Part")
	part.Name = "Ripple"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(0.5, 0.05, 0.5)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Ring"
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = RIPPLE_PIXELS
	gui.LightInfluence = 0.7
	gui.Parent = part
	local ring = Instance.new("Frame")
	ring.Name = "Circle"
	ring.BackgroundTransparency = 1
	ring.Size = UDim2.fromScale(1, 1)
	ring.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = ring
	local line = Instance.new("UIStroke")
	line.Name = "Line"
	line.Color = Color3.fromRGB(236, 250, 255)
	line.Thickness = RIPPLE_LINE
	line.Transparency = 1
	line.Parent = ring
	part.Parent = parent
	return part
end

-- A ring of water spreading out from `position` (on the surface).
function RockFx.ripple(position: Vector3, size: number)
	local part = ripples[nextRipple]
	if not part then
		return
	end
	nextRipple = nextRipple % #ripples + 1
	local gui = part:FindFirstChild("Ring")
	local circle = gui and gui:FindFirstChild("Circle")
	local line = circle and circle:FindFirstChild("Line")
	if not line or not line:IsA("UIStroke") then
		return
	end
	part.CFrame = CFrame.new(position.X, 0.08, position.Z)
	part.Size = Vector3.new(0.5, 0.05, 0.5)
	line.Transparency = 0.15
	TweenService:Create(part, RIPPLE_GROW, { Size = Vector3.new(size, 0.05, size) }):Play()
	TweenService:Create(line, RIPPLE_GROW, { Transparency = 1 }):Play()
end

function RockFx.splash(position: Vector3, amount: number)
	local anchor, emitter = splashAnchor, splashEmitter
	if not anchor or not emitter then
		return
	end
	anchor.CFrame = CFrame.new(position.X, 0.1, position.Z)
	emitter:Emit(amount)
end

-- A floating "1.2K studs" (and coins, for good throws) where a rock went down.
local function scoreTag(position: Vector3, event: Types.ThrowEvent)
	local parent = folder
	if not parent or event.skips < 1 then
		return
	end
	local anchor = Instance.new("Part")
	anchor.Name = "ScoreTag"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(180, 54)
	gui.LightInfluence = 0
	gui.MaxDistance = 4000
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = Format.distance(event.distance)
	label.TextColor3 = if event.perfect then Color3.fromRGB(255, 226, 120) else Color3.new(1, 1, 1)
	label.TextStrokeColor3 = Color3.fromRGB(20, 36, 64)
	label.TextStrokeTransparency = 0.3
	label.Parent = gui
	anchor.Parent = parent
	local rise = TweenInfo.new(3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	TweenService:Create(anchor, rise, { CFrame = anchor.CFrame + Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(label, rise, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(3.2, function()
		anchor:Destroy()
	end)
end

-- ===== Planning a flight =====

local function hopHeight(length: number): number
	return math.clamp(0.05 * length + 0.12, 0.15, 18)
end

local function hopDuration(length: number): number
	return math.clamp(0.08 + math.sqrt(length) * 0.085, 0.06, 2.5)
end

-- Splits a throw into segments: hand -> water, then one per hop.
function RockFx.plan(event: Types.ThrowEvent): { Segment }
	local segments: { Segment } = {}
	local reach = (Vector3.new(event.entry.X, event.origin.Y, event.entry.Z) - event.origin).Magnitude
	local dive = event.verdict == "dive"
	table.insert(segments, {
		from = event.origin,
		to = event.entry,
		height = if dive then 0.4 else math.clamp(reach * 0.12, 0.6, 6),
		duration = math.clamp(reach / 40, 0.2, 0.6),
		touch = false,
		index = 0,
	})
	local travelled = 0
	local point = event.entry
	local hopTime = 0
	for i, length in event.hops do
		travelled += length
		local finish = Sea.along(event.entry, travelled)
		local world = (finish - point).Magnitude
		local segment: Segment = {
			from = point,
			to = finish,
			height = hopHeight(world),
			duration = hopDuration(world),
			touch = true,
			index = i,
		}
		hopTime += segment.duration
		table.insert(segments, segment)
		point = finish
	end
	-- long throws are sped up so a flight never drags on
	if hopTime > RockFx.MAX_FLIGHT_SECONDS then
		local scale = RockFx.MAX_FLIGHT_SECONDS / hopTime
		for i = 2, #segments do
			segments[i].duration = math.max(segments[i].duration * scale, 0.04)
		end
	end
	return segments
end

-- Where the rock is `t` (0..1) of the way through a segment.
function RockFx.positionOn(segment: Segment, t: number): Vector3
	local base = segment.from:Lerp(segment.to, t)
	return base + Vector3.new(0, 4 * segment.height * t * (1 - t), 0)
end

-- How long a planned flight lasts, in seconds.
function RockFx.duration(segments: { Segment }): number
	local total = 0
	for _, segment in segments do
		total += segment.duration
	end
	return total
end

-- ===== The chase camera =====

local function restoreCamera()
	chasing = nil
	chaseHold = nil
	chaseEndsAt = math.huge
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	camera.CameraType = Enum.CameraType.Custom
	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

-- Stops following a rock (and puts the camera back on the player).
function RockFx.stopChase()
	if chasing or chaseEndsAt < math.huge then
		restoreCamera()
	end
end

function RockFx.isChasing(): boolean
	return chasing ~= nil or chaseEndsAt < math.huge
end

local function updateChase(now: number)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	if now >= chaseEndsAt then
		restoreCamera()
		return
	end
	local flight = chasing
	local target: Vector3
	if flight and flight.rock.Parent then
		target = flight.rock.CFrame.Position
	else
		target = chaseHold or camera.Focus.Position
	end
	local thrower = if flight then flight.event.origin else target
	local out = target.Z - thrower.Z
	local follow: Vector3
	if out > RockFx.CHASE_MAX then
		-- too far to follow: stay put and watch it go
		chaseHold = chaseHold or camera.CFrame.Position
		follow = chaseHold :: Vector3
	else
		follow = target + Vector3.new(0, 7 + out * 0.004, -18 - out * 0.01)
	end
	local wanted = CFrame.lookAt(follow, target + Vector3.new(0, 0, 10))
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = camera.CFrame:Lerp(wanted, 0.18)
end

-- ===== Running flights =====

local function finish(flight: Flight)
	local event = flight.event
	local last = flight.segments[#flight.segments]
	local position = last.to
	local rock = flight.rock
	local big = event.verdict == "dive"
	RockFx.ripple(position, if big then 9 else 7)
	RockFx.splash(position, if big then 22 else 12)
	Audio.splash(position, big)
	TweenService:Create(rock, TweenInfo.new(0.5), {
		CFrame = CFrame.new(position - Vector3.new(0, 1.2, 0)),
		Transparency = 1,
	}):Play()
	task.delay(0.6, function()
		rock:Destroy()
	end)
	scoreTag(position, event)
	if chasing == flight then
		chasing = nil
		chaseHold = chaseHold or position
		chaseEndsAt = os.clock() + RockFx.CHASE_LINGER
	end
	if event.userId == Players.LocalPlayer.UserId then
		ClientState.landed:fire(event)
	end
end

local function startSegment(flight: Flight, index: number, now: number)
	flight.current = index
	flight.segmentStart = now
	local segment = flight.segments[index]
	if segment.touch then
		local at = segment.from
		local size = math.clamp(2 + (segment.to - segment.from).Magnitude * 0.35, 2.5, 10)
		RockFx.ripple(at, size)
		RockFx.splash(at, 4)
		Audio.skip(at, segment.index)
	end
end

local function step(now: number)
	for i = #flights, 1, -1 do
		local flight = flights[i]
		local segment = flight.segments[flight.current]
		local t = (now - flight.segmentStart) / segment.duration
		while t >= 1 and flight.current < #flight.segments do
			local overshoot = now - (flight.segmentStart + segment.duration)
			startSegment(flight, flight.current + 1, now - overshoot)
			segment = flight.segments[flight.current]
			t = (now - flight.segmentStart) / segment.duration
		end
		if t >= 1 then
			table.remove(flights, i)
			finish(flight)
		else
			flight.spin += 0.6
			flight.rock.CFrame = CFrame.new(RockFx.positionOn(segment, t))
				* CFrame.Angles(0, flight.spin, 0)
		end
	end
	if chasing or chaseEndsAt < math.huge then
		updateChase(now)
	end
end

-- Starts drawing one throw.
function RockFx.play(event: Types.ThrowEvent)
	local parent = folder
	if not parent then
		return
	end
	if #flights >= RockFx.MAX_FLIGHTS then
		local oldest = table.remove(flights, 1)
		if oldest then
			oldest.current = #oldest.segments
			finish(oldest)
		end
	end
	local rock = RockModel.build(event.rock, 0.8)
	rock.CFrame = CFrame.new(event.origin)
	-- a faint streak behind the rock as it flies
	local top = Instance.new("Attachment")
	top.Position = Vector3.new(0, 0.12, 0)
	top.Parent = rock
	local bottom = Instance.new("Attachment")
	bottom.Position = Vector3.new(0, -0.12, 0)
	bottom.Parent = rock
	local trail = Instance.new("Trail")
	trail.Attachment0 = top
	trail.Attachment1 = bottom
	trail.Lifetime = 0.25
	trail.FaceCamera = true
	trail.Color = ColorSequence.new(Color3.new(1, 1, 1))
	trail.Transparency = NumberSequence.new(0.5, 1)
	trail.Parent = rock
	rock.Parent = parent
	local segments = RockFx.plan(event)
	local mine = event.userId == Players.LocalPlayer.UserId
	local reach = segments[#segments].to.Z - event.entry.Z
	local flight: Flight = {
		event = event,
		rock = rock,
		segments = segments,
		current = 1,
		segmentStart = os.clock(),
		spin = 0,
		chase = mine and RockFx.chaseEnabled and reach >= RockFx.CHASE_MIN,
	}
	table.insert(flights, flight)
	if flight.chase then
		chasing = flight
		chaseHold = nil
		chaseEndsAt = math.huge
	end
	startSegment(flight, 1, os.clock())
end

function RockFx.init()
	local f = Instance.new("Folder")
	f.Name = "SeaFx"
	f.Parent = Workspace
	folder = f
	for _ = 1, RockFx.MAX_RIPPLES do
		table.insert(ripples, newRipple(f))
	end
	local anchor = Instance.new("Part")
	anchor.Name = "Splash"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.4, 0.2, 0.4)
	anchor.Parent = f
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(Color3.fromRGB(236, 250, 255))
	emitter.LightEmission = 0.3
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.35, 0.6)
	emitter.Speed = NumberRange.new(5, 9)
	emitter.SpreadAngle = Vector2.new(30, 30)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Acceleration = Vector3.new(0, -40, 0)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.28),
		NumberSequenceKeypoint.new(1, 0.08),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 0.8),
	})
	emitter.Parent = anchor
	splashAnchor = anchor
	splashEmitter = emitter
	Net.listen("Throw", function(event: Types.ThrowEvent)
		RockFx.play(event)
	end)
end

function RockFx.start()
	RunService.RenderStepped:Connect(function()
		step(os.clock())
	end)
	-- a respawn always gets the normal camera back
	Players.LocalPlayer.CharacterAdded:Connect(function()
		RockFx.stopChase()
	end)
end

return RockFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">ThrowInput</string>
              <string name="Source"><![CDATA[--!strict
-- Winding up and letting go. Hold the left mouse button (or the Throw button
-- on a phone, or R2 on a gamepad) to start the power needle swinging, and let
-- go to throw. Rocks always fly straight out to sea. The client only says
-- when you pressed and let go; the server decides how the throw goes.
--
-- Every frame it also works out whether a throw from here would work, so the
-- HUD can show the meter only on the beach and the piers.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Sea = require(ReplicatedStorage.Shared.Sea)
local Net = require(ReplicatedStorage.Shared.Net)
local Skip = require(ReplicatedStorage.Shared.Skip)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Audio = require(script.Parent.Audio)
local RockFx = require(script.Parent.RockFx)

local ThrowInput = {}

ThrowInput.CHARGE_WALKSPEED = 4 -- you plant your feet while winding up

-- "far": not on the beach or a pier (no meter). "high": up on something.
-- "ok": ready.
export type Status = "far" | "high" | "ok"

export type State = {
	status: Status,
	charging: boolean,
	startedAt: number,
	lastThrowAt: number,
}

ThrowInput.state = {
	status = "far",
	charging = false,
	startedAt = 0,
	lastThrowAt = -math.huge,
} :: State

-- Fired when a press is refused (the HUD flashes the reason).
ThrowInput.refused = Signal.new() :: Signal.Signal<Status>
-- Fired when the player lets go and the throw is sent.
ThrowInput.released = Signal.new() :: Signal.Signal<number>

local savedWalkSpeed: number? = nil
-- The finger holding the on-screen Throw button: letting it go anywhere on
-- the screen throws, even if it slid off the button first.
local holdingTouch: InputObject? = nil

local function parts(): (BasePart?, Humanoid?)
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
		return nil, nil
	end
	return root, humanoid
end

-- Would a throw from where the player stands work right now?
function ThrowInput.check(): Status
	local root, humanoid = parts()
	if not root or not humanoid or humanoid.Sit then
		return "far"
	end
	local position = root.CFrame.Position
	if position.Y > Config.MAX_THROW_HEIGHT and position.Z >= Config.THROW_ZONE_BACK then
		return "high"
	end
	if not Sea.canThrowFrom(position) then
		return "far"
	end
	return "ok"
end

function ThrowInput.coolingDown(): boolean
	return os.clock() - ThrowInput.state.lastThrowAt < Config.THROW_COOLDOWN
end

-- Where the needle is now (0 while not winding up).
function ThrowInput.power(): number
	local state = ThrowInput.state
	if not state.charging then
		return 0
	end
	return Skip.power(os.clock() - state.startedAt)
end

local function plantFeet(on: boolean)
	local _, humanoid = parts()
	if on then
		if humanoid and savedWalkSpeed == nil then
			savedWalkSpeed = humanoid.WalkSpeed
			humanoid.WalkSpeed = ThrowInput.CHARGE_WALKSPEED
		end
	else
		if humanoid and savedWalkSpeed then
			humanoid.WalkSpeed = savedWalkSpeed
		end
		savedWalkSpeed = nil
	end
end

local function stopCharging(tellServer: boolean)
	local state = ThrowInput.state
	if not state.charging then
		return
	end
	state.charging = false
	holdingTouch = nil
	plantFeet(false)
	if tellServer then
		Net.send("CancelCharge")
	end
end

-- Start winding up (if a throw from here would work). `touch` is the finger
-- on the Throw button, if that's what pressed.
function ThrowInput.press(touch: InputObject?)
	local state = ThrowInput.state
	if state.charging then
		return
	end
	-- pressing throw while the camera chases a rock brings it straight back
	RockFx.stopChase()
	local status: Status = ThrowInput.check() :: Status
	state.status = status
	if status ~= "ok" then
		if status ~= "far" then
			ThrowInput.refused:fire(status)
		end
		return
	end
	if ThrowInput.coolingDown() then
		return
	end
	state.charging = true
	state.startedAt = os.clock()
	holdingTouch = touch
	plantFeet(true)
	Net.send("BeginCharge")
end

-- Let go: throw (a quick tap just cancels).
function ThrowInput.letGo()
	holdingTouch = nil
	local state = ThrowInput.state
	if not state.charging then
		return
	end
	local held = os.clock() - state.startedAt
	if held < Config.MIN_CHARGE_SECONDS then
		stopCharging(true)
		return
	end
	local root = parts()
	if not root then
		stopCharging(true)
		return
	end
	stopCharging(false)
	-- face the sea for the throw
	local p = root.CFrame.Position
	root.CFrame = CFrame.lookAt(p, p + Sea.FORWARD)
	Net.send("Release", held)
	state.lastThrowAt = os.clock()
	Audio.play("throw")
	ThrowInput.released:fire(Skip.power(held))
end

local function isThrowInput(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.KeyCode == Enum.KeyCode.ButtonR2
end

function ThrowInput.init()
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if not processed and isThrowInput(input) then
			ThrowInput.press()
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		-- (let go even over a button, so the throw never gets stuck)
		if isThrowInput(input) or (holdingTouch ~= nil and input == holdingTouch) then
			ThrowInput.letGo()
		end
	end)
	Players.LocalPlayer.CharacterAdded:Connect(function()
		savedWalkSpeed = nil
		ThrowInput.state.charging = false
	end)
end

-- Once a frame (cheap; the HUD also calls it just before drawing, so it
-- never shows last frame's answer).
function ThrowInput.update()
	local state = ThrowInput.state
	if not state.charging then
		state.status = ThrowInput.check()
		return
	end
	-- gone (died, reset), or held so long it doesn't count
	local root = parts()
	if not root or os.clock() - state.startedAt > Config.MAX_CHARGE_SECONDS then
		stopCharging(true)
	end
end

function ThrowInput.start()
	RunService.RenderStepped:Connect(ThrowInput.update)
end

return ThrowInput
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">Toasts</string>
              <string name="Source"><![CDATA[--!strict
-- Gentle messages from the server, stacked near the top of the screen, and
-- a bigger banner when you reach an island far out at sea.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local IslandData = require(ReplicatedStorage.Shared.Data.IslandData)
local Audio = require(script.Parent.Audio)
local UI = require(script.Parent.Parent.Lib.UI)

local Toasts = {}

Toasts.MAX = 3
Toasts.SECONDS = 3.2

local T = UI.Theme
local STYLE_COLORS: { [string]: Color3 } = {
	info = T.white,
	good = UI.lighten(T.sage, 0.35),
	bad = UI.lighten(T.coral, 0.35),
	rare = T.perfect,
}

-- Messages and island banners share one stack above the hint line,
-- newest at the bottom.
local stack: Frame? = nil
local alive: { [Frame]: boolean } = {}
local order: { Frame } = {} -- oldest first
local count = 0

local function remove(item: Frame)
	if not alive[item] then
		return
	end
	alive[item] = nil
	local index = table.find(order, item)
	if index then
		table.remove(order, index)
	end
	item:Destroy()
end

-- Adds a pill to the stack (pushing out the oldest) and fades it later.
local function push(item: Frame, seconds: number, labels: { TextLabel })
	if #order >= Toasts.MAX then
		remove(order[1])
	end
	count += 1
	item.LayoutOrder = count
	alive[item] = true
	table.insert(order, item)
	item.Parent = stack
	UI.pop(item, 0.9)
	task.delay(seconds, function()
		if not alive[item] then
			return -- pushed out by newer messages already
		end
		UI.tween(item, UI.SOFT, { BackgroundTransparency = 1 })
		for _, label in labels do
			UI.tween(label, UI.SOFT, { TextTransparency = 1 })
		end
		task.delay(0.4, remove, item)
	end)
end

-- The newest message or card on screen (nil if none).
function Toasts.latest(): Frame?
	return order[#order]
end

function Toasts.show(text: string, style: string?)
	if not stack then
		return
	end
	local pill = UI.glass({ Name = "Toast", Size = UDim2.fromOffset(440, 38) })
	local label = UI.text({
		text = text,
		size = UDim2.new(1, -24, 1, -8),
		position = UDim2.fromScale(0.5, 0.5),
		anchor = Vector2.new(0.5, 0.5),
		color = STYLE_COLORS[style or "info"] or T.white,
		font = UI.BodyFont,
		maxTextSize = 19,
		parent = pill,
	})
	push(pill, Toasts.SECONDS, { label })
	if style == "good" or style == "rare" or style == "bad" then
		Audio.play(style)
	end
end

-- A big banner: an island reached.
function Toasts.island(id: string)
	local island = IslandData.get(id)
	if not stack or not island then
		return
	end
	local card = UI.glass({ Name = "Island", Size = UDim2.fromOffset(480, 84) })
	card.BackgroundColor3 = T.waterDeep
	local title = UI.text({
		name = "Title",
		text = `🏝️ You reached {island.name}!`,
		size = UDim2.new(1, -24, 0, 34),
		position = UDim2.fromOffset(12, 8),
		maxTextSize = 28,
		parent = card,
	})
	local line = UI.text({
		name = "Line",
		text = `+{math.floor(island.bonus * 100 + 0.5)}% coins from every throw, forever`,
		size = UDim2.new(1, -24, 0, 26),
		position = UDim2.fromOffset(12, 46),
		color = T.perfect,
		font = UI.BodyFont,
		maxTextSize = 18,
		parent = card,
	})
	push(card, 5, { title, line })
	Audio.play("rare")
end

function Toasts.init()
	local _, canvas = UI.screen("Toasts", 20)
	stack = UI.new("Frame", {
		Name = "Stack",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -150),
		Size = UDim2.fromOffset(480, 260),
		Parent = canvas,
	}, {
		UI.list(
			Enum.FillDirection.Vertical,
			6,
			Enum.HorizontalAlignment.Center,
			Enum.VerticalAlignment.Bottom
		),
	}) :: Frame

	Net.listen("Notify", function(text: string, style: string)
		Toasts.show(text, style)
	end)
	Net.listen("Island", function(id: string)
		Toasts.island(id)
	end)
end

return Toasts
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="66">
          <Properties>
            <string name="Name">Lib</string>
          </Properties>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[--!strict
-- Skip a Rock's UI kit: one calm look shared by every screen.
--
--   * Soft slate "glass" pills float over the world (HUD); warm paper
--     panels hold the journal. Everything is rounded, nothing shouts.
--   * Fredoka One for headings and numbers, Builder Sans for body text.
--   * Layout is in design pixels; each ScreenGui gets a UIScale that fits a
--     1150 x 650 canvas to phones, tablets and desktops.

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local UI = {}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

UI.Theme = {
	ink = rgb(36, 48, 66), -- text on paper, outlines
	inkSoft = rgb(104, 116, 134),
	glass = rgb(28, 40, 58), -- HUD pills (with GLASS transparency)
	paper = rgb(250, 246, 238),
	paperDark = rgb(238, 230, 216),
	card = rgb(255, 255, 255),
	line = rgb(222, 212, 196),
	white = rgb(255, 255, 255),
	water = rgb(84, 172, 204),
	waterDeep = rgb(56, 132, 178),
	gold = rgb(246, 196, 84),
	perfect = rgb(255, 240, 160),
	coral = rgb(236, 112, 96),
	sage = rgb(120, 186, 120),
	dusk = rgb(132, 120, 206),
	good = rgb(52, 150, 92),
	bad = rgb(206, 84, 76),
}

UI.GLASS = 0.28 -- transparency of HUD pills
UI.Font = Enum.Font.FredokaOne
UI.BodyFont = Enum.Font.BuilderSansBold
UI.LightFont = Enum.Font.BuilderSansMedium

-- Sound hooks (set by the Audio controller).
UI.onClick = function() end

UI.FAST = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
UI.SOFT = TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
UI.BOUNCY = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

UI.DESIGN = Vector2.new(1150, 650)

function UI.rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

function UI.lighten(c: Color3, amount: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), amount)
end

function UI.darken(c: Color3, amount: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), amount)
end

-- Create an instance, set properties, parent children. Returns `any` so
-- callers cast to the concrete class (`:: Frame`).
function UI.new(className: string, props: { [string]: any }?, children: { any }?): any
	local instance = Instance.new(className)
	local parent: Instance? = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

-- ===== Decorators (return `any` so they mix into one children list) =====

function UI.corner(radius: number?): any
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 14) })
end

function UI.round(): any
	return UI.new("UICorner", { CornerRadius = UDim.new(0.5, 0) })
end

function UI.stroke(color: Color3?, thickness: number?, transparency: number?): any
	return UI.new("UIStroke", {
		Color = color or UI.Theme.ink,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.padding(px: number, vertical: number?): any
	local h = UDim.new(0, px)
	local v = UDim.new(0, vertical or px)
	return UI.new(
		"UIPadding",
		{ PaddingTop = v, PaddingBottom = v, PaddingLeft = h, PaddingRight = h }
	)
end

function UI.list(
	direction: Enum.FillDirection,
	padding: number,
	horizontalAlign: Enum.HorizontalAlignment?,
	verticalAlign: Enum.VerticalAlignment?
): any
	return UI.new("UIListLayout", {
		FillDirection = direction,
		Padding = UDim.new(0, padding),
		HorizontalAlignment = horizontalAlign or Enum.HorizontalAlignment.Center,
		VerticalAlignment = verticalAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function UI.grid(cell: Vector2, gap: number): any
	return UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(cell.X, cell.Y),
		CellPadding = UDim2.fromOffset(gap, gap),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

-- ===== Text =====

export type TextProps = {
	text: string,
	size: UDim2,
	position: UDim2?,
	anchor: Vector2?,
	color: Color3?,
	font: Enum.Font?,
	align: Enum.TextXAlignment?,
	valign: Enum.TextYAlignment?,
	maxTextSize: number?,
	shadow: boolean?, -- a soft dark outline, for light text over the world
	wrap: boolean?,
	order: number?,
	parent: Instance?,
	name: string?,
	zIndex: number?,
}

function UI.text(props: TextProps): TextLabel
	local label = UI.new("TextLabel", {
		Name = props.name or "Text",
		BackgroundTransparency = 1,
		Text = props.text,
		Size = props.size,
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		TextColor3 = props.color or UI.Theme.white,
		Font = props.font or UI.Font,
		TextScaled = true,
		TextWrapped = props.wrap ~= false,
		TextXAlignment = props.align or Enum.TextXAlignment.Center,
		TextYAlignment = props.valign or Enum.TextYAlignment.Center,
		LayoutOrder = props.order or 0,
		ZIndex = props.zIndex or 1,
	}) :: TextLabel
	UI.new("UITextSizeConstraint", {
		MaxTextSize = props.maxTextSize or 32,
		MinTextSize = 8,
		Parent = label,
	})
	if props.shadow then
		UI.new("UIStroke", {
			Color = UI.Theme.glass,
			Thickness = 1.6,
			Transparency = 0.35,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
			Parent = label,
		})
	end
	if props.parent then
		label.Parent = props.parent
	end
	return label
end

-- Dark body text for paper panels and cards.
function UI.body(props: TextProps): TextLabel
	props.color = props.color or UI.Theme.ink
	props.font = props.font or UI.BodyFont
	return UI.text(props)
end

-- ===== Surfaces =====

-- A translucent slate pill for the HUD.
function UI.glass(props: { [string]: any }?): Frame
	local frame = UI.new("Frame", {
		BackgroundColor3 = UI.Theme.glass,
		BackgroundTransparency = UI.GLASS,
		BorderSizePixel = 0,
	}, { UI.corner(16), UI.stroke(UI.Theme.white, 1.5, 0.82) }) :: Frame
	if props then
		for key, value in props do
			if key ~= "Parent" then
				(frame :: any)[key] = value
			end
		end
		if props.Parent then
			frame.Parent = props.Parent
		end
	end
	return frame
end

-- A warm paper panel (the journal).
function UI.paper(props: { [string]: any }?): Frame
	local frame = UI.new("Frame", {
		BackgroundColor3 = UI.Theme.paper,
		BorderSizePixel = 0,
	}, { UI.corner(22), UI.stroke(UI.Theme.line, 2) }) :: Frame
	if props then
		for key, value in props do
			if key ~= "Parent" then
				(frame :: any)[key] = value
			end
		end
		if props.Parent then
			frame.Parent = props.Parent
		end
	end
	return frame
end

-- ===== Buttons =====

export type Button = {
	root: TextButton,
	label: TextLabel,
	color: Color3,
	enabled: boolean,
}

export type ButtonProps = {
	text: string,
	size: UDim2,
	position: UDim2?,
	anchor: Vector2?,
	color: Color3?, -- face colour; defaults to the HUD glass
	textColor: Color3?,
	font: Enum.Font?,
	order: number?,
	parent: Instance?,
	name: string?,
	onClick: (() -> ())?,
}

local function paint(button: Button)
	local face = if button.enabled then button.color else UI.Theme.inkSoft
	button.root.BackgroundColor3 = face
	button.label.TextTransparency = if button.enabled then 0 else 0.35
end

-- A soft rounded button that dips a little when pressed.
function UI.button(props: ButtonProps): Button
	local color = props.color or UI.Theme.glass
	local root = UI.new("TextButton", {
		Name = props.name or "Button",
		Text = "",
		AutoButtonColor = false,
		Size = props.size,
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		BackgroundColor3 = color,
		BackgroundTransparency = if props.color then 0 else UI.GLASS,
		BorderSizePixel = 0,
		LayoutOrder = props.order or 0,
	}, { UI.corner(14), UI.stroke(UI.Theme.white, 1.5, 0.75) }) :: TextButton
	local scale = UI.new("UIScale", { Parent = root }) :: UIScale
	local label = UI.text({
		text = props.text,
		size = UDim2.new(1, -16, 1, -10),
		position = UDim2.fromScale(0.5, 0.5),
		anchor = Vector2.new(0.5, 0.5),
		color = props.textColor or UI.Theme.white,
		font = props.font,
		maxTextSize = 26,
		name = "Label",
		parent = root,
	})
	local button: Button = { root = root, label = label, color = color, enabled = true }
	root.MouseEnter:Connect(function()
		if button.enabled then
			TweenService:Create(scale, UI.FAST, { Scale = 1.04 }):Play()
		end
	end)
	root.MouseLeave:Connect(function()
		TweenService:Create(scale, UI.FAST, { Scale = 1 }):Play()
	end)
	root.MouseButton1Down:Connect(function()
		if button.enabled then
			TweenService:Create(scale, UI.FAST, { Scale = 0.95 }):Play()
		end
	end)
	root.MouseButton1Up:Connect(function()
		TweenService:Create(scale, UI.FAST, { Scale = 1 }):Play()
	end)
	root.Activated:Connect(function()
		if button.enabled and props.onClick then
			UI.onClick()
			props.onClick()
		end
	end)
	paint(button)
	if props.parent then
		root.Parent = props.parent
	end
	return button
end

function UI.setButton(button: Button, update: { text: string?, color: Color3?, enabled: boolean? })
	if update.text then
		button.label.Text = update.text
	end
	if update.color then
		button.color = update.color
	end
	if update.enabled ~= nil then
		button.enabled = update.enabled
	end
	paint(button)
end

-- ===== Motion =====

function UI.pop(gui: GuiObject, from: number?)
	local scale = gui:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = UI.new("UIScale", { Parent = gui })
	end
	local s = scale :: UIScale
	s.Scale = from or 0.85
	TweenService:Create(s, UI.BOUNCY, { Scale = 1 }):Play()
end

function UI.tween(instance: Instance, info: TweenInfo, goal: { [string]: any }): Tween
	local tween = TweenService:Create(instance, info, goal)
	tween:Play()
	return tween
end

-- ===== Screens =====

function UI.topInset(): number
	local ok, topLeft = pcall(function()
		return (GuiService:GetGuiInset())
	end)
	if ok and typeof(topLeft) == "Vector2" and topLeft.Y > 0 then
		return topLeft.Y
	end
	return 58
end

function UI.scaleFor(viewport: Vector2): number
	return math.clamp(math.min(viewport.X / UI.DESIGN.X, viewport.Y / UI.DESIGN.Y), 0.6, 1.3)
end

function UI.viewportSize(): Vector2
	local camera = Workspace.CurrentCamera
	return if camera then camera.ViewportSize else Vector2.new(1280, 720)
end

function UI.isTouch(): boolean
	local UserInputService = game:GetService("UserInputService")
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

-- A ScreenGui whose contents scale with the screen. Its "Canvas" frame is
-- the design-pixel area to lay things out in (inside the top-bar inset).
function UI.screen(name: string, displayOrder: number): (ScreenGui, Frame)
	local gui = UI.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		DisplayOrder = displayOrder,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = false,
	}) :: ScreenGui
	local canvas = UI.new("Frame", {
		Name = "Canvas",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Parent = gui,
	}) :: Frame
	local scale = UI.new("UIScale", { Parent = canvas }) :: UIScale
	local function update()
		local viewport = UI.viewportSize()
		local s = UI.scaleFor(viewport)
		scale.Scale = s
		-- (offsets are whole pixels: round up so the canvas never falls short)
		canvas.Size =
			UDim2.fromOffset(math.ceil(viewport.X / s), math.ceil((viewport.Y - UI.topInset()) / s))
	end
	update()
	local camera = Workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	end
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return gui, canvas
end

return UI
